msgstr "우리 하야테도 제법 그럴듯해졌지.\\n뭐, 미라쥬와는 매일 싸우기만 하지만\\n나름 잘 해나가는 것 같아."

msgid "message_0300_txt"
msgstr "메서는 성실하지만, 그게 조금 걱정이군.\\n서로 고민은 끝이 없는 법이지."

msgid "message_0301_txt"
msgstr "한 번 갑판 위에서\\n술 마시며 이야기라도 하죠."

msgid "message_0302_txt"
msgstr "그거 좋겠군.\\n이야기가 잘 풀릴 것 같아."

msgid "message_0303_txt"
msgstr "란카 짱, 셰릴 씨\\n안녕하세요!"

msgid "message_0304_txt"
msgstr "민메이 씨!"

msgid "message_0305_txt"
msgstr "그쪽 상황은 어때?\\n나는 방금 라이브가 끝난 참이야."

msgid "message_0306_txt"
msgstr "…기억을 전부 되찾으려면\\n아직 시간이 꽤 걸릴 것 같네."

msgid "message_0307_txt"
msgstr "뭐, 쉬운 일은 아니겠죠."

msgid "message_0308_txt"
msgstr "…우리들의 노래로, 조금이라도 더 많은 사람들의\\n기억이 돌아왔으면 좋겠는데."

msgid "message_0309_txt"
msgstr "그러게…\\n나도 노래하면서 같은 생각을 하고 있어."

msgid "message_0310_txt"
msgstr "불안한 것도, 모르는 것도 많지만"

msgid "message_0311_txt"
msgstr "노래가 끝난 뒤 냥냥에 가서\\n모두의 얼굴을 보면,\\n왠지 힘이 나거든."

msgid "message_0312_txt"
msgstr "알아요!\\n저도 나나 짱이나 알토 군들과 이야기하면\\n다시 힘내야겠다고 생각하게 돼요."

msgid "message_0313_txt"
msgstr "그런 마음마저\\n잊어버린다면 슬프겠네요…"

msgid "message_0314_txt"
msgstr "그래서 더더욱 그렇게 되지 않도록\\n우리는 노래하는 거야."

msgid "message_0315_txt"
msgstr "맞아요!"

msgid "message_0316_txt"
msgstr "두 사람 모두, 앞으로도 힘내자."

msgid "message_0317_txt"
msgstr "알토 씨, 미하엘 씨.\\n전황은 어떤가요?"

msgid "message_0318_txt"
msgstr "지금으로서는 큰 문제는 없어."

msgid "message_0319_txt"
msgstr "그렇군요, 다행이에요."

msgid "message_0320_txt"
msgstr "혹시 미라쥬 짱,\\n무슨 일이라도 있었어?"

msgid "message_0321_txt"
msgstr "아뇨, 특별한 일은 없습니다만…"

msgid "message_0322_txt"
msgstr "…그러고 보니 미라쥬가\\n연락해 오는 건 드문 일이군."

msgid "message_0323_txt"
msgstr "알겠다.\\n하야테와 싸우기라도 한 건가?"

msgid "message_0324_txt"
msgstr "싸운 게 아닙니다!\\n하야테가 위험한 일만 하는 게 문제인 겁니다!"

msgid "message_0325_txt"
msgstr "아…"

msgid "message_0326_txt"
msgstr "그렇군…그렇다면 알토.\\n화해하는 방법이라도 조언해 주는 게 어때?"

msgid "message_0327_txt"
msgstr "나보고 뭘 조언하라는 거냐."

msgid "message_0328_txt"
msgstr "항상 누군가와 다투고 있잖아?"

msgid "message_0329_txt"
msgstr "별로 다투는 거 아니다."

msgid "message_0330_txt"
msgstr "…알토 씨도 미하엘 씨도\\n호흡이 정말 잘 맞아서 조금 부러워요."

msgid "message_0331_txt"
msgstr "하야테와 미라쥬 짱도\\n그렇잖아?"

msgid "message_0332_txt"
msgstr "그렇지 않습니다!\\n…하지만 두 분의 대화를 보고 있으니,\\n조금 진정됐습니다."

msgid "message_0333_txt"
msgstr "하야테와 제대로 이야기를 해보려고 합니다."

msgid "message_0334_txt"
msgstr "도움이 됐다면 다행이군.\\n힘내."

msgid "message_0335_txt"
msgstr "이제 와서 하는 말이지만,\\n이 초시공 SNS 정말 편하네~"

msgid "message_0336_txt"
msgstr "왜냐하면 정말 다양한 사람들과\\n이야기를 나눌 수 있으니까!"

msgid "message_0337_txt"
msgstr "역시 레이나 씨답네요(*^皿^*)"

msgid "message_0338_txt"
msgstr "그러게…나도 레이나에게 처음\\nSNS 이야기를 들었을 때\\n정말 감동했어."

msgid "message_0339_txt"
msgstr "설마 시공의 뒤틀림을 이용해서\\n이런 대단한 걸 만들다니…"

msgid "message_0340_txt"
msgstr "정말 잘됐어!\\n덕분에 이렇게 프레이아나 카나메와도\\n이야기할 수 있게 됐잖아!"

msgid "message_0341_txt"
msgstr "저도 밀레느 씨와 몇 번을 이야기해도\\n계속 감동하게 돼요!"

msgid "message_0342_txt"
msgstr "그런데도 바사라는 SNS를 봐도\\n전혀 놀라지 않고."

msgid "message_0343_txt"
msgstr "…답장도 늦고."

msgid "message_0344_txt"
msgstr "바사라 씨와 싸우기라도 했나요?"

msgid "message_0345_txt"
msgstr "싸운 게 아니야!\\n그냥 어이가 없을 뿐이야."

msgid "message_0346_txt"
msgstr "저희라도 괜찮다면,\\n얼마든지 이야기를 들어드릴게요^^"

msgid "message_0347_txt"
msgstr "…괜찮아?"

msgid "message_0348_txt"
msgstr "물론이에요!\\n그 정도밖에 못 해드리지만…"

msgid "message_0349_txt"
msgstr "밀레느 씨 이야기,\\n잔뜩 들려주세요(*´∀｀*)"

msgid "message_0350_txt"
msgstr "두 사람 모두 상냥하네…\\n고마워!"

msgid "message_0351_txt"
msgstr "오늘 임무 중에 공중기사단 녀석들과\\n마주쳤는데 말이야…"

msgid "message_0352_txt"
msgstr "그 녀석들, 뭔가 조사하고 있는 것\\n같더라고."

msgid "message_0353_txt"
msgstr "공중기사단이?\\n으음~ 뭔가 좀 수상한데."

msgid "message_0354_txt"
msgstr "너무 수상해."

msgid "message_0355_txt"
msgstr "그렇지? 대장과 메서도\\n같은 말을 했어."

msgid "message_0356_txt"
msgstr "그 공중기사단…이라는 사람들은 어떤 사람들이야?\\n이름부터 꽤 옛날식이네."

msgid "message_0357_txt"
msgstr "셰리셰리다~!(´∀｀*)"

msgid "message_0358_txt"
msgstr "윈더미어라는 나라의\\n무슨 생각을 하는지 알 수 없는 녀석들이야."

msgid "message_0359_txt"
msgstr "하야테, 너무 대충 말했어."

msgid "message_0360_txt"
msgstr "어쩔 수 없잖아, 사실이니까."

msgid "message_0361_txt"
msgstr "그 사람들…\\n아군은 아닌 것 같지만,\\n서로 협력할 수는 없는 거야?"

msgid "message_0362_txt"
msgstr "가능했으면 이렇게 고생하지도 않았겠지.\\n말이 통하는 녀석들 같지도 않고 말이야."

msgid "message_0363_txt"
msgstr "여러 행성에서 기억이 사라지고 있는 상황이니\\n공중기사단도 알아차리는 게 당연하겠지…"

msgid "message_0364_txt"
msgstr "뭔가 대책을 생각하는 것도 당연하고…"

msgid "message_0365_txt"
msgstr "…그쪽도 힘든 일이구나."

msgid "message_0366_txt"
msgstr "무슨 일이 있으면 도와줄 테니까\\n꼭 연락하는 거야?"

msgid "message_0367_txt"
msgstr "셰리셰리, 고마워~( *>ω< *)\\n뭔가 알아내면 다시 연락할게!"

msgid "message_0368_txt"
msgstr "기억을 잃은 뒤의 모습은,\\n몇 번을 봐도 익숙해지지 않네…"

msgid "message_0369_txt"
msgstr "원래 있어야 할 것이\\n사라진다니…"

msgid "message_0370_txt"
msgstr "그렇네요. 우리만\\n기억하고 있다는 것도 괴로운 일이에요."

msgid "message_0371_txt"
msgstr "우리는 노래에 담긴\\n생체 폴드파 덕분에\\n기억을 잃지 않을 수 있었지만"

msgid "message_0372_txt"
msgstr "다른 사람들은 자신이 기억을\\n잃었다는 사실조차 모르고 있고…"

msgid "message_0373_txt"
msgstr "저기, 카나메 씨!"

msgid "message_0374_txt"
msgstr "…파일럿 여러분도\\n기억을 잃을 가능성이 있는 건가요?"

msgid "message_0375_txt"
msgstr "그건 확실히…"

msgid "message_0376_txt"
msgstr "괜찮아요, 걱정하지 마세요^^\\n파일럿 여러분은\\n항상 저희 곁에 있으니까요."

msgid "message_0377_txt"
msgstr "생체 폴드파의 힘으로\\n기억을 잃지 않고 있습니다."

msgid "message_0378_txt"
msgstr "하지만 앞으로\\n멸망의 노래의 힘이 강해진다면…"

msgid "message_0379_txt"
msgstr "…그때는 어떻게 될지 모릅니다.\\n멸망의 노래에 대해서는 아직 모르는 점도 많으니까요."

msgid "message_0380_txt"
msgstr "뭐!? 그럴 수가…"

msgid "message_0381_txt"
msgstr "기억을 잃은 알토 군이나 오빠는\\n보고 싶지 않아…"

msgid "message_0382_txt"
msgstr "그렇게 되기 전에 어떻게든 해봅시다!"

msgid "message_0383_txt"
msgstr "항상 우리를 지켜주는 사람들이니까,\\n적어도 그들의 기억만큼은\\n지켜주고 싶어."

msgid "message_0384_txt"
msgstr "네! 우리가 할 수 있는 일부터\\n조금씩 해나가요."

msgid "message_0385_txt"
msgstr "…약한 소리 하고 있을 때가 아니네요.\\n저도 힘낼게요!"

msgid "message_0386_txt"
msgstr "그러고 보니…우리가\\n처음 서로의 존재를 알게 됐을 때,\\n묘하게 긴장감이 감돌았지."

msgid "message_0387_txt"
msgstr "현실에서는 있을 수 없는 일이었으니까요.\\n확실히 경계했던 부분도 있었습니다."

msgid "message_0388_txt"
msgstr "하지만 밀레느 씨들과\\n이렇게 이야기할 수 있는 날이 오다니\\n정말 기뻐요!"

msgid "message_0389_txt"
msgstr "그렇네요. 멸망의 노래가 시공과 차원에\\n영향을 준 것이 원인인 것 같지만요."

msgid "message_0390_txt"
msgstr "그 영향 덕분에 우리는 서로의 존재를\\n알아차릴 수 있었습니다."

msgid "message_0391_txt"
msgstr "그 후 케이오스와 S.M.S,\\n각 부대의 대장과 함장들이 여러 번 통신하며\\n함께 맞서기로 결의를 다졌다고 해요."

msgid "message_0392_txt"
msgstr "뭔가 엄청난 이야기를\\n나눴던 거네요…Σ(ﾟ□ﾟ)"

msgid "message_0393_txt"
msgstr "프레이아, 너에게는\\n전에 설명했던 것 같은데…"

msgid "message_0394_txt"
msgstr "그러고 보니 레이도 그런 말을\\n했던 것 같아.\\n나도 자세히는 몰랐지만."

msgid "message_0395_txt"
msgstr "숙모님까지…"

msgid "message_0396_txt"
msgstr "알겠어요?\\n임무를 수행하려면 정보가 중요해요!\\n그러니까…"

msgid "message_0397_txt"
msgstr "여러 가지를 알고 있어서 의지가 되는\\n조카를 두다니,\\n미래의 내가 부럽네."

msgid "message_0398_txt"
msgstr ""

msgid "message_0399_txt"
msgstr "…? 미안, 나\\n이상한 말 했어?"

msgid "message_0400_txt"
msgstr "아, 아니요…그게, 아무것도 아닙니다.\\n앞으로도 제가 아는 범위의 일은\\n설명해 드릴 테니 들어주세요."

msgid "message_0401_txt"
msgstr "정말? 고마워!"

msgid "message_0402_txt"
msgstr "잘됐네요,\\n밀레느 씨(*^皿^*)"

msgid "message_0403_txt"
msgstr "저기, 바사라.\\n너에게 묻고 싶은 게 있는데."

msgid "message_0404_txt"
msgstr "바사라는 자신이 한 명 더 있다면\\n어떻게 생각해?"

msgid "message_0405_txt"
msgstr "무슨 소리야? 나 같은 녀석이\\n한 명 더 있을 리 없잖아."

msgid "message_0406_txt"
msgstr "뭐, 너라면 그렇게 말할 것 같았어."

msgid "message_0407_txt"
msgstr "오늘 척이들이랑\\n그 얘기로 한창 떠들고 있었거든."

msgid "message_0408_txt"
msgstr "실제로 그런 일이 있을 리는 없겠지."

msgid "message_0409_txt"
msgstr "어머, 모르는 일이야."

msgid "message_0410_txt"
msgstr "미쿠모?"

msgid "message_0411_txt"
msgstr "지금의 우리도\\n원래라면 있을 수 없는 상황이잖아."

msgid "message_0412_txt"
msgstr "은하는 이렇게나 넓은걸.\\n우리와 같은 세계가 있어도 이상하지 않아."

msgid "message_0413_txt"
msgstr "평행세계라는 건가…\\n네가 말하니까 묘하게 설득력이 있네."

msgid "message_0414_txt"
msgstr "같은 세계, 같은 사람.\\n하지만 일어나는 사건과\\n역사는 조금씩 다르고…"

msgid "message_0415_txt"
msgstr "하지만 내가 어느 세계의 나든\\n나에게는 상관없어.\\n노래할 수 있다면 그걸로 충분하니까."

msgid "message_0416_txt"
msgstr "잘 알고 있잖아.\\n우리는 그저 우리의 사운드를\\n울려 퍼뜨리면 되는 거야!"

msgid "message_0417_txt"
msgstr "…그래, 맞는 말이야."

msgid "message_0418_txt"
msgstr "…잘 모르겠지만, 의기투합한 건가?"

msgid "message_0419_txt"
msgstr "뭔가 어딘가 닮은 느낌이 드네,\\n이 두 사람…"

msgid "message_0420_txt"
msgstr "조금 물어봐도 될까?"

msgid "message_0421_txt"
msgstr "전에 하야테와 바사라와\\n평행세계에 대해 이야기했는데"

msgid "message_0422_txt"
msgstr "…무슨 상황이었던 거지, 그건."

msgid "message_0423_txt"
msgstr "평행세계…재미있을 것 같은 이야기잖아!\\n비슷한 세계가 많이 있다는 거지?"

msgid "message_0424_txt"
msgstr "은하는 이렇게나 넓으니까.\\n그런 게 하나나 둘쯤 있어도\\n전혀 이상하지 않아."

msgid "message_0425_txt"
msgstr "나도 같은 생각이야."

msgid "message_0426_txt"
msgstr "어머, 마음이 잘 맞네.\\n그래서 미쿠가 궁금한 건 뭐야?"

msgid "message_0427_txt"
msgstr "생각해 봤어. 지금 멸망의 노래의 영향으로\\n이 은하에서는 기억 상실이 시작되고 있어."

msgid "message_0428_txt"
msgstr "만약 평행세계가 있다면,\\n그 은하에서도 똑같이 기억 상실이\\n일어나고 있을지도 모른다고."

msgid "message_0429_txt"
msgstr "기억이 뒤섞이고 경계가 흐려진 지금이라면…\\n혹시 평행세계의 기억을\\n찾아내는 것도 가능하지 않을까?"

msgid "message_0430_txt"
msgstr "내가 아닌 나의 기억…"

msgid "message_0431_txt"
msgstr ""

msgid "message_0432_txt"
msgstr "셰릴?"

msgid "message_0433_txt"
msgstr "좋은 구절이 떠올랐어!\\n미안하지만, 나중에 다시!"

msgid "message_0434_txt"
msgstr "뭐라고!?"

msgid "message_0435_txt"
msgstr "야…"

msgid "message_0436_txt"
msgstr "…미안하군, 미쿠.\\n당분간 질문에 답해주기는 어려울 것 같아."

msgid "message_0437_txt"
msgstr "상관없어.\\n은하의 요정…소문 그대로네."

msgid "message_0438_txt"
msgstr "초시공 SNS 유지보수 완료"

msgid "message_0439_txt"
msgstr "오오~!"

msgid "message_0440_txt"
msgstr "수고했어, 레이레이!\\n나중에 같이 과자 먹자( *>ω< *)"

msgid "message_0441_txt"
msgstr "레이나 짱, 대단하네…\\n그런데 유지보수는\\n어떤 걸 한 거야?"

msgid "message_0442_txt"
msgstr "보안을 더욱 강화"

msgid "message_0443_txt"
msgstr "이제 어떤 해킹에도 끄떡없어."

msgid "message_0444_txt"
msgstr "역시 레이나 씨네요!\\n그런데 지금까지 보안도\\n충분히 대단했던 것 같은데…?"

msgid "message_0445_txt"
msgstr "레이나 씨?"

msgid "message_0446_txt"
msgstr "사실 말이야, 최근에 누군가가\\n초시공 SNS에 억지로 접속하려고 한\\n흔적이 있었거든."

msgid "message_0447_txt"
msgstr "그랬구나…\\n왠지 무섭네."

msgid "message_0448_txt"
msgstr "걱정하지 마, 민민!\\n레이레이가 확실히 막았으니까.\\n다만 누가 그랬는지는 아직 모르고…"

msgid "message_0449_txt"
msgstr "최근 공중기사단의 움직임도 신경 쓰이고 해서\\n혹시 모르니 강화해 두자고 한 것뿐이야!"

msgid "message_0450_txt"
msgstr "돌다리도 두드려 보고 건너기."

msgid "message_0451_txt"
msgstr "레이나 짱, 정말 믿음직하네!\\n항상 고마워!"

msgid "message_0452_txt"
msgstr "…별거 아니야."

msgid "message_0453_txt"
msgstr "칭찬받고 부끄러워하는 레이레이,\\n귀여워~!"

msgid "message_0454_txt"
msgstr "앞으로도 이 SNS에서\\n여러 가지 이야기 나누자!"

msgid "message_0455_txt"
msgstr "…물론."

msgid "message_0456_txt"
msgstr "밀레느 숙모님, 클랑 대위,\\n들어주세요!"

msgid "message_0457_txt"
msgstr "또 하야테 임멜만이 에어쇼 중에\\n멋대로 비행했어요!"

msgid "message_0458_txt"
msgstr "또냐.\\n…미라쥬도 고생이 많군."

msgid "message_0459_txt"
msgstr "바사라도 제멋대로 행동하는 것뿐이야.\\n오늘도 라이브가 시작하는데\\n어디론가 가버렸다고!"

msgid "message_0460_txt"
msgstr "아빠와 엄마도 제멋대로고…\\n파일럿들은 다 그런 걸까?"

msgid "message_0461_txt"
msgstr "픽시 소대는 그렇지 않다!\\n모두 우수하고 지휘 체계도 잘 잡혀 있으니까."

msgid "message_0462_txt"
msgstr "역시 클랑 대위님이세요.\\n다음에 꼭 여러 가지를 알려주세요."

msgid "message_0463_txt"
msgstr "아아, 괜찮다!\\n언제든 의지하도록 해."

msgid "message_0464_txt"
msgstr "뭐, 초시공 SNS로…라고 하면\\n제대로 전부 전달할 수 있을지는 모르겠지만…"

msgid "message_0465_txt"
msgstr "맞아…항상 생각하지만,\\n언젠가 제대로 만나서 이야기할 수 있게 되면\\n좋겠다!"

msgid "message_0466_txt"
msgstr "그렇네요…이야기할 수 있게 된다면\\n두 분의 귀중한 이야기를 더 많이\\n들을 수 있다는 거네요."

msgid "message_0467_txt"
msgstr "왠지 꿈만 같아요…\\n물론, 그렇게 될 수 있다면\\n이라는 이야기지만요."

msgid "message_0468_txt"
msgstr "이렇게 초시공 SNS로 대화할 수 있는 것조차\\n기적 같은 일이니까."

msgid "message_0469_txt"
msgstr "있잖아! 레이나에게 어떻게든 안 되는지\\n부탁해 보자!"

msgid "message_0470_txt"
msgstr "그렇네요…레이나 씨라면\\n방법을 생각해 줄지도 몰라요."

msgid "message_0471_txt"
msgstr "미라쥬, 레이나에게 이야기해 봐!"

msgid "message_0472_txt"
msgstr "알겠습니다, 숙모님!\\n레이나 씨를 찾으면 다시 연락드릴게요."

msgid "message_0473_txt"
msgstr "그래, 기다리고 있을게!\\n아, 그리고 이제 숙모님이라고 부르는 건 그만둬!"

msgid "message_0474_txt"
msgstr "레이나!\\n미라쥬에게 이야기는 들었어?"

msgid "message_0475_txt"
msgstr "어느 정도."

msgid "message_0476_txt"
msgstr "있잖아, 어떻게 안 될까?\\n초시공 SNS를 만든 레이나라면\\n가능할 것 같아!"

msgid "message_0477_txt"
msgstr "무슨 이야기를 하는 거야?"

msgid "message_0478_txt"
msgstr "전에 미라쥬에게 들었는데,\\n직접 만나서 이야기할 수 있는 걸\\n만들어 달라는 이야기인 것 같더군."

msgid "message_0479_txt"
msgstr "…확실히 지금보다 편리해지는 건\\n나쁠 것 없지."

msgid "message_0480_txt"
msgstr "하지만 그런 게 가능해?"

msgid "message_0481_txt"
msgstr "해보지 않으면 몰라."

msgid "message_0482_txt"
msgstr "뭐, 그런 거겠지."

msgid "message_0483_txt"
msgstr "무리한 부탁을 하면 안 된다는 건\\n알지만, 기대하게 되네~"

msgid "message_0484_txt"
msgstr "아, 그보다 하야테!\\n너무 제멋대로 행동해서\\n미라쥬를 곤란하게 하면 안 돼!"

msgid "message_0485_txt"
msgstr "…젠장, 어떻게 알고 있는 거야."

msgid "message_0486_txt"
msgstr "그야 자주 상담해 주고 있으니까!"

msgid "message_0487_txt"
msgstr "하야테, 너도 고생이 많구나."

msgid "message_0488_txt"
msgstr "알토나 미셸 이야기도\\n클랑에게 듣고 있어.\\n전부 다 알고 있다고!"

msgid "message_0489_txt"
msgstr "…이거 직접 만날 수 있게 되면\\n더 많은 게 다 알려진다는 거잖아."

msgid "message_0490_txt"
msgstr "아아…생각해 볼 문제군."

msgid "message_0491_txt"
msgstr "잠깐 괜찮을까?\\n상담하고 싶은 게 있는데…"

msgid "message_0492_txt"
msgstr "셰릴 씨!"

msgid "message_0493_txt"
msgstr "무슨 일이에요?\\n셰릴 씨가 상담이라니, 드문 일이네요."

msgid "message_0494_txt"
msgstr "사실 최근 들어 멸망의 노래의 영향이\\n강해지고 있는 것처럼 느껴지는데\\n너희 세계는 그렇지 않아?"

msgid "message_0495_txt"
msgstr "그런가요…\\n적이 강해졌다고 느끼기는 하지만…\\n그렇게 뚜렷하게 느끼지는 못했어요!"

msgid "message_0496_txt"
msgstr "그렇네요…\\n지금으로서는 큰 변화는 없는 것 같아요."

msgid "message_0497_txt"
msgstr "그래…"

msgid "message_0498_txt"
msgstr "무슨 일이 있었는지\\n물어봐도 될까요?"

msgid "message_0499_txt"
msgstr "글쎄…예를 들면, 자신의 기억에\\n없는 기억이 머릿속으로 흘러 들어오거나…"

msgid "message_0500_txt"
msgstr "아, 그거! 나도 있을지도 몰라!"

msgid "message_0501_txt"
msgstr "정말!?"

msgid "message_0502_txt"
msgstr "그 기억 속에는 분명 내가 있는데\\n전혀 기억에 없는 영상이라고 해야 하나."

msgid "message_0503_txt"
msgstr "음…잘 설명하기는 어렵지만\\n나긴 나인데, 내 기억은 아닌 것 같아…"

msgid "message_0504_txt"
msgstr "…평행세계."

msgid "message_0505_txt"
msgstr "응?"

msgid "message_0506_txt"
msgstr "전에 미쿠가 그런 이야기를 했어요.\\n혹시 멸망의 노래의 영향으로 뒤틀린 시공이\\n더 크게 일그러진 게 아닐까 하고…"

msgid "message_0507_txt"
msgstr "점점 어려운 이야기가 되어 가네…"

msgid "message_0508_txt"
msgstr "아무튼 이쪽에서도 여러 가지로 조사해 볼게요!"

msgid "message_0509_txt"
msgstr "그래, 부탁할게."

msgid "message_0510_txt"
msgstr "있잖아, 가끔은 파일럿끼리만\\n이야기해 보지 않을래?"

msgid "message_0511_txt"
msgstr "이렇게 함께 싸우는 사이끼리\\n서로 이해해서 나쁠 건 없잖아!"

msgid "message_0512_txt"
msgstr "멸망의 노래의 영향이 강해진 지금,\\n고민하는 것이라든지, 궁금한 것…\\n그래, 연애 고민도 좋아!"

msgid "message_0513_txt"
msgstr "궁금한 것…그러고 보니,\\n처음 발키리에 탔을 때의 일이라든가?"

msgid "message_0514_txt"
msgstr "아~…그립네.\\n타지 않으면 위험한 상황이었다고 해야 하나,\\n프레이아를 구하는 생각밖에 없었지."

msgid "message_0515_txt"
msgstr "나도 비슷한 상황이었다.\\n란카를 구하기 위해, 운에 맡기고 탔지.\\n살아 있다는 느낌도 안 들었어."

msgid "message_0516_txt"
msgstr "헤에…다들 각자 힘든 일이 있었구나."

msgid "message_0517_txt"
msgstr "그런 카나메는 어땠어?"

msgid "message_0518_txt"
msgstr "음…처음 탔을 때,\\n여러 가지 일이 있어서\\n민메이의 방을 부순 정도려나."

msgid "message_0519_txt"
msgstr "진짜냐."

msgid "message_0520_txt"
msgstr "그 여러 가지 일이 뭔지 궁금한데…"

msgid "message_0521_txt"
msgstr "갑자기 변형했으니까,\\n그야 놀랄 수밖에 없었지."

msgid "message_0522_txt"
msgstr "지금은 물론,\\n그런 일로 놀라지는 않지만 말이야."

msgid "message_0523_txt"
msgstr "뭐, 처음 발키리에 탈 때는\\n그런 놀라움도 있겠지~"

msgid "message_0524_txt"
msgstr "그럼 조금 이야기를 바꿔서…\\n신입 파일럿에게\\n조언을 한다면 뭐라고 하겠어?"

msgid "message_0525_txt"
msgstr "멋지게 나는 게 중요하지."

msgid "message_0526_txt"
msgstr "머리로 생각하지 마라,\\n그 정도 아닐까."

msgid "message_0527_txt"
msgstr "일단 익숙해질 때까지 힘내라는 느낌이려나."

msgid "message_0528_txt"
msgstr "…뭐랄까."

msgid "message_0529_txt"
msgstr "하나같이 답이 두루뭉술하네…"

msgid "message_0530_txt"
msgstr "카나메에게 받은 보고서를 읽어봤는데…\\n멸망의 노래의 영향이\\n이렇게 강해졌다니."

msgid "message_0531_txt"
msgstr "네. 자신의 것이 아닌 기억이\\n흘러들어온다는 것은…"

msgid "message_0532_txt"
msgstr "우리가 인식하고 있는 것보다 더,\\n다른 시공의 기억까지\\n뒤틀리고 있다는 뜻입니다."

msgid "message_0533_txt"
msgstr "멸망의 노래…\\n정말 골치 아픈 존재군."

msgid "message_0534_txt"
msgstr "아직 멸망의 노래를 막을 방법이라는 것에는\\n도달하지 못했으니까."

msgid "message_0535_txt"
msgstr "게다가 초시공 SNS는 그 멸망의 노래의 영향으로\\n생겨난 왜곡을 이용해 만들어졌습니다."

msgid "message_0536_txt"
msgstr "그렇군…그 왜곡을 바로잡아 버리면\\n초시공 SNS는 사용할 수 없게 된다."

msgid "message_0537_txt"
msgstr "즉, 우리가 계속 연결되어 있으려면\\n시공과 차원이 계속 뒤틀려 있어야 한다는 건가."

msgid "message_0538_txt"
msgstr "야, 미셸!"

msgid "message_0539_txt"
msgstr "그냥 사실을 말했을 뿐이잖아."

msgid "message_0540_txt"
msgstr "머리로는 알고 있었지만\\n조금 복잡하네요."

msgid "message_0541_txt"
msgstr "…하지만 우리가 할 수 있는 건\\n임무를 수행하는 것뿐이다."

msgid "message_0542_txt"
msgstr "네! 물론입니다!"

msgid "message_0543_txt"
msgstr "역시 메서, 쿨하네.\\n같은 동료로서는 그 냉정함이\\n든든해."

msgid "message_0544_txt"
msgstr "…아닙니다."

msgid "message_0545_txt"
msgstr "파일럿끼리,\\n앞으로도 잘 부탁한다."

msgid "message_0546_txt"
msgstr "…네."

msgid "message_0547_txt"
msgstr "…정말 쿨하군."

msgid "message_0548_txt"
msgstr "여러분! 윈더미어와 공중기사단에\\n관한 보고서가 올라왔어요."

msgid "message_0549_txt"
msgstr "윈더미어 사람들의 상황은\\n어떤가요!?"

msgid "message_0550_txt"
msgstr "그게…역시 우리와 마찬가지로\\n기억 상실이 일어나고 있는 것 같아."

msgid "message_0551_txt"
msgstr "그럴 수가…"

msgid "message_0552_txt"
msgstr "그 기억을 노래로 되찾을 수 있다는 것도\\n알고 있는 것 같아."

msgid "message_0553_txt"
msgstr "하지만…이 현상이 여러 시공에서\\n일어나고 있다는 사실은 모르는 것 같아."

msgid "message_0554_txt"
msgstr "멸망의 노래에 대해서도…\\n어느 정도 알고 있는지는 모르겠어."

msgid "message_0555_txt"
msgstr "최근 초시공 SNS 해킹…\\n혹시."

msgid "message_0556_txt"
msgstr "응, 공중기사단이 정보를 모으려고\\n시도하고 있는 것 같아."

msgid "message_0557_txt"
msgstr "…불쾌해."

msgid "message_0558_txt"
msgstr "…하지만 지금은 은하 모두의 위기잖아.\\n협력할 수는 없는 걸까?"

msgid "message_0559_txt"
msgstr "그건 그들에게 달린 일이 아닐까?"

msgid "message_0560_txt"
msgstr "…그렇지.\\n확실히 협력해서 새 인간에게 맞서는 게 최선이지만\\n그들이 동의해 줄지는 모르겠어."

msgid "message_0561_txt"
msgstr "아무튼 지금은 더 많은 정보가 필요해 보여.\\n레이나, 협력해 줄 수 있을까?"

msgid "message_0562_txt"
msgstr "물론."

msgid "message_0563_txt"
msgstr "당하면 되갚는다."

msgid "message_0564_txt"
msgstr "레이레이, 나도\\n도와줄게~(*´∀｀*)"

msgid "message_0565_txt"
msgstr "<size=30>철저하게 해주겠어</size>"

msgid "message_0566_txt"
msgstr "어…잠깐, 레이나!\\n정보를 모으기만 하는 거야!"

msgid "message_0567_txt"
msgstr "있잖아, 레이레이!\\n요즘 즐거워 보이네!"

msgid "message_0568_txt"
msgstr "뭔가 좋은 일이라도 있었어~?"

msgid "message_0569_txt"
msgstr "좋은 일이라고 할 건 아니지만"

msgid "message_0570_txt"
msgstr "…색다른 일이 있긴 했다"

msgid "message_0571_txt"
msgstr "뭔데 뭔데~?(*´▽｀*)"

msgid "message_0572_txt"
msgstr "내가 해킹을 걸어서,\\n브레라의 보안을 돌파하는"

msgid "message_0573_txt"
msgstr "…그런 놀이를 시작했다"

msgid "message_0574_txt"
msgstr "놀이는 아니다.\\n양쪽의 기술 향상이 목적이다"

msgid "message_0575_txt"
msgstr "브레라는 유희가 부족하다"

msgid "message_0576_txt"
msgstr "유희라고?"

msgid "message_0577_txt"
msgstr "레이나 프라우러.\\n목적을 다시 한번 확인해라"

msgid "message_0578_txt"
msgstr "…진지해"

msgid "message_0579_txt"
msgstr "자자, 둘 다!\\n하지만 레이레이와 브레브레가\\n협력하면 뭐든 할 수 있을 것 같네!"

msgid "message_0580_txt"
msgstr "서로의 기술 향상에는 도움이 되지만\\n협력할 수 있을지는 미지수다"

msgid "message_0581_txt"
msgstr "확실히"

msgid "message_0582_txt"
msgstr "그래도 란란도 같은 말을\\n하지 않을까?"

msgid "message_0583_txt"
msgstr "란카가?"

msgid "message_0584_txt"
msgstr "맞아 맞아!"

msgid "message_0585_txt"
msgstr "…그런가"

msgid "message_0586_txt"
msgstr "…단순하네"

msgid "message_0587_txt"
msgstr "미라쥬, 상담할 게 있다고\\n했는데…그쪽에서\\n무슨 문제라도 있었어?"

msgid "message_0588_txt"
msgstr "아닙니다! 그런 건 아니에요.\\n조금 말하기 어려운 일이지만…"

msgid "message_0589_txt"
msgstr "호오~ 말하기 어렵다는 건\\n하야테 일이라든가?"

msgid "message_0590_txt"
msgstr "어떻게 아셨어요!?"

msgid "message_0591_txt"
msgstr "미라쥬의 상담이라면\\n그런 경우는 대부분 하야테 이야기니까."

msgid "message_0592_txt"
msgstr "눈치채지 못했습니다…"

msgid "message_0593_txt"
msgstr "하지만 그만큼 하야테의\\n너무 자유로운 행동 때문에\\n고민하고 있다고 해야 할까…"

msgid "message_0594_txt"
msgstr "뭐, 파일럿이라는 건\\n자유로운 녀석이 많은 법이지."

msgid "message_0595_txt"
msgstr "레이 씨!"

msgid "message_0596_txt"
msgstr "Fire Bomber라면\\n확실히 바사라는 자유로운 사람이라는\\n느낌이 들죠."

msgid "message_0597_txt"
