msgid "message_12534_txt"
msgstr "저기…\\n밀레느 씨, 왠지 죄송해요…＾＾；"

msgid "message_12535_txt"
msgstr "어이, 대장이 슬슬\\n라그나로 돌아갈 준비하래"

msgid "message_12536_txt"
msgstr "라이브 후 중화거리 관광은\\n실컷 즐겼어?"

msgid "message_12537_txt"
msgstr "그려!\\n정말 정말\\n꿈같은 기분이었어~!(>▽<)"

msgid "message_12538_txt"
msgstr "정통 중화요리\\n솔직히 말해서 최고"

msgid "message_12539_txt"
msgstr "「나구키냥냥」, 위기"

msgid "message_12540_txt"
msgstr "뭐라고!?"

msgid "message_12541_txt"
msgstr "가게 음식도 그렇지만\\n들고 다니면서 먹은 딤섬도\\n맛있었지~!"

msgid "message_12542_txt"
msgstr "마키나는 판다 얼굴 모양의\\n호빵을 끝내 먹지 못했지＾＾"

msgid "message_12543_txt"
msgstr "그치만 그치만, 그렇게 귀여운 얼굴로\\n쳐다보면 먹을 수가 없잖아~\\n。゜゜(>□<｡)°゜。"

msgid "message_12544_txt"
msgstr "미쿠모는 아무렇지도 않게 베어 물었어"

msgid "message_12545_txt"
msgstr "Σ(ﾟ□ﾟ)충격"

msgid "message_12546_txt"
msgstr "가게 안에서 먹고 난 뒤에 또 먹거리 투어라니…\\n정말 배고팠나 보네"

msgid "message_12547_txt"
msgstr "중화거리뿐만 아니라\\n다른 곳도 여기저기 다녀왔어!"

msgid "message_12548_txt"
msgstr "운하에 비치는 야경을\\n다 같이 바라봤어"

msgid "message_12549_txt"
msgstr "그 근처 바다에서\\n해파리가 떠다니는 것도 발견했지"

msgid "message_12550_txt"
msgstr "그걸 본 미쿠모가\\n바다로 뛰어들려고 했을 때는\\n아무리 그래도 당황했지만"

msgid "message_12551_txt"
msgstr "뭐 하는 거야…"

msgid "message_12552_txt"
msgstr "라이브라…\\n정말 정말 즐거웠지"

msgid "message_12553_txt"
msgstr "순식간에 지나간 시간이었어"

msgid "message_12554_txt"
msgstr "우리 노래에 맞춰\\n모두의 환호성이 들리고…"

msgid "message_12555_txt"
msgstr "모두가 분위기를 띄워줬으니까\\n최고의 라이브가 된 거야…"

msgid "message_12556_txt"
msgstr "으으응!\\n한 번 더 같은 곳에서 라이브 하고 싶어ー!!"

msgid "message_12557_txt"
msgstr "마키나의 마음 이해해.\\n이번 라이브는 정말 좋았어"

msgid "message_12558_txt"
msgstr "뜨거운 시간이었어"

msgid "message_12559_txt"
msgstr "프레이아와 미쿠모는?"

msgid "message_12560_txt"
msgstr "끝나버려서\\n조금 아쉽다고 해야 할까"

msgid "message_12561_txt"
msgstr "나는… 글쎄"

msgid "message_12562_txt"
msgstr "룬이 반짝반짝 빛나고\\n행복한 기분에 둥실둥실 떠오르고\\n하늘도 날 수 있을 것 같은 기분이 들고…"

msgid "message_12563_txt"
msgstr "이 행성 사람들이 정말 우리를\\n좋아해주고 있구나 하고\\n진심으로 느꼈어!"

msgid "message_12564_txt"
msgstr "나도 다시 한 번 이곳에서\\n모두와 함께 라이브를 하고 싶어요!"

msgid "message_12565_txt"
msgstr "그러게＾＾"

msgid "message_12566_txt"
msgstr "여러분!\\n라이브, 정말 수고 많으셨어요!"

msgid "message_12567_txt"
msgstr "조심해서 라그나로 돌아가요!"

msgid "message_12568_txt"
msgstr "셰릴 씨, 란카 씨!\\n서프라이즈 게스트 출연\\n정말 감사합니다!"

msgid "message_12569_txt"
msgstr "두 분까지 출연한다는 건\\n듣지 못해서 놀랐어"

msgid "message_12570_txt"
msgstr "극비였으니까"

msgid "message_12571_txt"
msgstr "같이 노래할 수 있어서 좋았어.\\n셰릴"

msgid "message_12572_txt"
msgstr "나도 그래, 미쿠모"

msgid "message_12573_txt"
msgstr "나도 란카 씨와 함께\\n포즈를 맞출 수 있어서\\n정말 기뻤어요!"

msgid "message_12574_txt"
msgstr "다음에도 함께 무대에 서자.\\n프레이아 쨩!"

msgid "message_12575_txt"
msgstr "뒷이야기에 따르면\\n그 밖에도 서프라이즈 게스트가 있었던 모양"

msgid "message_12576_txt"
msgstr "회장에서 바사라 목격 정보 있음"

msgid "message_12577_txt"
msgstr "바사라 씨는 정말 어디서 나타날지 모르네~"

msgid "message_12578_txt"
msgstr "자, 그럼 이 이틀을 밑거름 삼아\\n내일부터의 활동도\\n전력을 다해 임하도록 하죠!"

msgid "message_12579_txt"
msgstr "안녕, 알토.\\n설마 학원 라이브에 게스트 출연을 하다니"

msgid "message_12580_txt"
msgstr "셰릴과 란카가 부탁했어.\\n어쩔 수 없잖아"

msgid "message_12581_txt"
msgstr "게다가 대장의 허락도 받았으니까\\n아무 문제 없을 거야"

msgid "message_12582_txt"
msgstr "멋졌어, 알토!"

msgid "message_12583_txt"
msgstr "고마워, 알토 군!"

msgid "message_12584_txt"
msgstr "역시 그 거리에서\\n발키리가 날아다니니까 박력 있네!"

msgid "message_12585_txt"
msgstr "와준 관객들도\\n놀란 것 같고, 대성공이야!"

msgid "message_12586_txt"
msgstr "잘됐네"

msgid "message_12587_txt"
msgstr "물론 처음 계획대로 했어도\\n놀랐을 거라고 생각하지만"

msgid "message_12588_txt"
msgstr "처음 계획…?"

msgid "message_12589_txt"
msgstr "그래. 하지만 알토가\\n아무래도 싫다고 해서"

msgid "message_12590_txt"
msgstr "애초에 라이브 본방까지\\n시간도 얼마 없었잖아!"

msgid "message_12591_txt"
msgstr "알토, 처음 계획이라는 게\\n어떤 계획이었어?"

msgid "message_12592_txt"
msgstr "하야테처럼, 곡에 맞춰서\\n춤추라는 거였어"

msgid "message_12593_txt"
msgstr "좋은 생각이라고 생각했는데…"

msgid "message_12594_txt"
msgstr "그건 쉽게 할 수 있는 일이 아니라고 생각해"

msgid "message_12595_txt"
msgstr "곡에 맞춰야 하고\\n셰릴과 란카의 춤에도\\n맞춰야 하고…"

msgid "message_12596_txt"
msgstr "이번에 하야테에게 요령을\\n물어보는 건 어때?"

msgid "message_12597_txt"
msgstr "이미 물어봤어"

msgid "message_12598_txt"
msgstr "하지만 별로 참고가 되지는 않았달까,\\n결국 감각…이라는 느낌이겠지"

msgid "message_12599_txt"
msgstr "하야테 군은 대단하구나!"

msgid "message_12600_txt"
msgstr "그럼 알토.\\n보답은 뭘로 할래?"

msgid "message_12601_txt"
msgstr "보답?"

msgid "message_12602_txt"
msgstr "부탁했을 때 말했잖아.\\n분위기를 띄워주면 보답하겠다고"

msgid "message_12603_txt"
msgstr "그러고 보니 말했던 것 같기도…"

msgid "message_12604_txt"
msgstr "이번에 알토 덕분에\\n분위기가 올라간 건 사실이고…"

msgid "message_12605_txt"
msgstr "뭐든 괜찮아!"

msgid "message_12606_txt"
msgstr "그렇게 말해도 말이지…"

msgid "message_12607_txt"
msgstr "부럽네, 알토.\\n노래하는 두 사람에게 보답을 받다니"

msgid "message_12608_txt"
msgstr "놀리지 마"

msgid "message_12609_txt"
msgstr "잠깐, 알토!\\n뭐라도 없어?"

msgid "message_12610_txt"
msgstr "딱히 떠오르는 게 없는데"

msgid "message_12611_txt"
msgstr "그러니까 보답은 필요 없어"

msgid "message_12612_txt"
msgstr "그럴 수는 없어!\\n나는 한 번 말한 건\\n절대 바꿀 생각 없으니까"

msgid "message_12613_txt"
msgstr "뭐야, 그게…"

msgid "message_12614_txt"
msgstr "음, 예를 들면…\\n나와 셰릴 씨가\\n케이크를 만들어서 선물한다든가?"

msgid "message_12615_txt"
msgstr "어딘가에 놀러 간다…\\n같은 것도 괜찮겠네!"

msgid "message_12616_txt"
msgstr "알았어, 알았어.\\n그럼 너희끼리 정해줘"

msgid "message_12617_txt"
msgstr "괜찮아…??"

msgid "message_12618_txt"
msgstr "알겠어!"

msgid "message_12619_txt"
msgstr "저기, 란카 쨩!\\n나 좋은 생각이 있는데…"

msgid "message_12620_txt"
msgstr "이따가 잠깐\\n시간 내줄 수 있을까!"

msgid "message_12621_txt"
msgstr "알토, 기대하고 있어!"

msgid "message_12622_txt"
msgstr "마음대로 해"

msgid "message_12623_txt"
msgstr "…어떻게 될지 모르겠네"

msgid "message_12624_txt"
msgstr "오늘은! 민민이랑 방과 후 데이트하는 날이야!"

msgid "message_12625_txt"
msgstr "방과 후 데이트?"

msgid "message_12626_txt"
msgstr "응! 민민의 동경이었대!"

msgid "message_12627_txt"
msgstr "학교 이야기를 들으러 갔더니\\n알려줘서…"

msgid "message_12628_txt"
msgstr "기왕이면 같이 체험해 보자고\\n이야기가 됐어!"

msgid "message_12629_txt"
msgstr "그래서 오늘 레슨 중에도\\n계속 들떠 있었던 거구나"

msgid "message_12630_txt"
msgstr "그야 엄청 멋진 울림이잖아!"

msgid "message_12631_txt"
msgstr "그래서, 그 방과 후 데이트라는 건\\n뭘 하는 건데?"

msgid "message_12632_txt"
msgstr "같이 하교하거나, 맛있는 걸\\n먹으러 가거나…"

msgid "message_12633_txt"
msgstr "오오~!"

msgid "message_12634_txt"
msgstr "아, 맞다. 마키나.\\n레이나한테는 제대로 말했어?"

msgid "message_12635_txt"
msgstr "분명 서운해할걸?"

msgid "message_12636_txt"
msgstr "물론이지, 제대로 이야기했어!"

msgid "message_12637_txt"
msgstr "마키나, 즐겁게 다녀와"

msgid "message_12638_txt"
msgstr "고마워, 레이레이!"

msgid "message_12639_txt"
msgstr "민민, 오늘 고마워!"

msgid "message_12640_txt"
msgstr "이쪽이야말로, 고마웠어요!"

msgid "message_12641_txt"
msgstr "민메이 씨, 마키나 씨\\n어서 오세요!"

msgid "message_12642_txt"
msgstr "마키나, 방과 후 데이트는 어땠어?"

msgid "message_12643_txt"
msgstr "정말 즐거웠어!"

msgid "message_12644_txt"
msgstr "오늘은 말이지, 민민과 다른 학교 학생\\n이라는 설정으로 만나기로 했어!"

msgid "message_12645_txt"
msgstr "민민의 학교에 가서,\\n같이 하교하고…"

msgid "message_12646_txt"
msgstr "그리고 내가 추천하는 찻집에\\n갔었지"

msgid "message_12647_txt"
msgstr "거기서 마키나 쨩 이야기를\\n잔뜩 들었어"

msgid "message_12648_txt"
msgstr "아이돌이 되기까지의 이야기라든가,\\n어릴 적 이야기라든가!"

msgid "message_12649_txt"
msgstr "나도 민민이 데뷔하기까지의\\n이야기를 차분히 들었어!"

msgid "message_12650_txt"
msgstr "서로에 대해 잘 알 수 있었던\\n정말 좋은 시간이었네"

msgid "message_12651_txt"
msgstr "그게 데이트야?"

msgid "message_12652_txt"
msgstr "확실히 친한 친구랑\\n놀고 있었던 것 같기도…"

msgid "message_12653_txt"
msgstr "음~ 그렇게 듣고 보니 확실히 그런가??"

msgid "message_12654_txt"
msgstr "그래도 멋진 방과 후였어!"

msgid "message_12655_txt"
msgstr "그러니까 다음 의상 아이디어랑\\n프로모션 영상 아이디어가\\n완벽하게 떠올랐어!"

msgid "message_12656_txt"
msgstr "오오~! 어떤 느낌인데!?"

msgid "message_12657_txt"
msgstr "다들한테 들은 학교 이미지를 바탕으로\\n엄청 귀여운 느낌이 될 것 같아!"

msgid "message_12658_txt"
msgstr "민민, 정말 고마워!"

msgid "message_12659_txt"
msgstr "감사 인사는 필요 없어!\\n나도 정말 즐거웠으니까"

msgid "message_12660_txt"
msgstr "의상이 완성되면 나한테도 보여줘"

msgid "message_12661_txt"
msgstr "물론이지!"

msgid "message_12662_txt"
msgstr "아, 맞다! 오늘 찍은 사진 데이터\\n나중에 민민한테도 보낼게!"

msgid "message_12663_txt"
msgstr "귀여운 민민이 잔뜩 찍혔어!"

msgid "message_12664_txt"
msgstr "기뻐! 고마워!"

msgid "message_12665_txt"
msgstr "그럼 바로 의상 이미지를\\n구체화하고 올게!"

msgid "message_12666_txt"
msgstr "마키나 쨩, 힘내"

msgid "message_12667_txt"
msgstr "레이나, 오늘 라이브에\\n초대해 줘서 고마워!"

msgid "message_12668_txt"
msgstr "밀레느, 와줘서 고마워"

msgid "message_12669_txt"
msgstr "아직 시작 전이지만\\n어떤 라이브가 될지 두근거려!"

msgid "message_12670_txt"
msgstr "오늘 라이브는 조금 자극적이야"

msgid "message_12671_txt"
msgstr "자극적?"

msgid "message_12672_txt"
msgstr "무슨 뜻이야??"

msgid "message_12673_txt"
msgstr "레이나 씨!\\n밀레느 씨를 발견했습니다!"

msgid "message_12674_txt"
msgstr "좋아, 확보"

msgid "message_12675_txt"
msgstr "어? 프레이아?"

msgid "message_12676_txt"
msgstr "오늘 라이브의\\n시크릿 게스트는 밀레느"

msgid "message_12677_txt"
msgstr "불러줬으면 하는 곡도 정해뒀어"

msgid "message_12678_txt"
msgstr "그러니까 무대, 잘 부탁해"

msgid "message_12679_txt"
msgstr "밀레느 씨,\\n갑자기 죄송합니다!"

msgid "message_12680_txt"
msgstr "레이나가 미리\\n설명해 줬을 거라고 생각했는데…"

msgid "message_12681_txt"
msgstr "신경 쓰지 마, 카나메!"

msgid "message_12682_txt"
msgstr "프레이아가 무대 뒤로\\n데려갔을 때는\\n깜짝 놀랐지만 정말 즐거웠어!"

msgid "message_12683_txt"
msgstr "게다가 항상 바사라에게\\n휘둘리고 있으니까, 이 정도는 여유야!"

msgid "message_12684_txt"
msgstr "그렇게 말씀해 주셔서 다행입니다…"

msgid "message_12685_txt"
msgstr "게스트로 노래해 주셔서\\n정말 감사했습니다!"

msgid "message_12686_txt"
msgstr "밀레느에게 자극을 선물하는 작전"

msgid "message_12687_txt"
msgstr "정말, 레이나도 참…\\n다음에는 우리 라이브에도 와서\\n노래해 줘야 해!"

msgid "message_12688_txt"
msgstr "기꺼이"

msgid "message_12689_txt"
msgstr "그러고 보니, 이번에 시크릿으로\\n부른 곡, 레이나가 고른 거지?"

msgid "message_12690_txt"
msgstr "왜 그 곡이었어?"

msgid "message_12691_txt"
msgstr "이유는 간단해"

msgid "message_12692_txt"
msgstr "내가 좋아하는 곡이니까"

msgid "message_12693_txt"
msgstr "모처럼 시크릿 게스트로\\n와줬으니까"

msgid "message_12694_txt"
msgstr "밀레느의 매력을 모두에게\\n알리고 싶었어"

msgid "message_12695_txt"
msgstr "그 곡은 밀레느다움으로 가득해서\\n정말 찌릿찌릿해"

msgid "message_12696_txt"
msgstr "그래서 좋아"

msgid "message_12697_txt"
msgstr "그렇구나… 고마워, 레이나!"

msgid "message_12698_txt"
msgstr "그럼 이제 객석으로 돌아가 볼까?"

msgid "message_12699_txt"
msgstr "알겠다고 하고 싶은데\\n아직 안 돼"

msgid "message_12700_txt"
msgstr "다음에는 발키리와 함께\\n노래해 줬으면 해"

msgid "message_12701_txt"
msgstr "좋아! 같이 노래하자!"

msgid "message_12702_txt"
msgstr "그럼 다음에는 내가\\n곡을 골라도 돼?"

msgid "message_12703_txt"
msgstr "좋아하는 곡이 잔뜩 있어!"

msgid "message_12704_txt"
msgstr "물론"

msgid "message_12705_txt"
msgstr "마음껏 즐기자"

msgid "message_12706_txt"
msgstr "프레이아. 연습은 계속하고 있어?"

msgid "message_12707_txt"
msgstr "밀레느 씨! 물론입니다!"

msgid "message_12708_txt"
msgstr "매일매일 빠짐없이\\n연습하고 있습니더!"

msgid "message_12709_txt"
msgstr "기특하네!"

msgid "message_12710_txt"
msgstr "연습이라니, 무슨 연습인데?"

msgid "message_12711_txt"
msgstr "그렇구나.\\n하야테 군은 모르겠네"

msgid "message_12712_txt"
msgstr "프레이아는 지금\\n바이올린 특훈 중이야!"

msgid "message_12713_txt"
msgstr "바이올린!?\\n그 프레이아가?"

msgid "message_12714_txt"
msgstr "뭐야, 하야테!\\n나도 이래 봬도 간단한 곡 정도는\\n연주할 수 있게 됐다니까!"

msgid "message_12715_txt"
msgstr "확실히 요즘은 바이올린다운 연주가\\n들려오기 시작했네요…"

msgid "message_12716_txt"
msgstr "지난주까지만 해도 여자 기숙사 가득\\n끼익끼익 소리가 울려 퍼져서\\n조금 문제가 됐었지…＾＾；"

msgid "message_12717_txt"
msgstr "아차, 죄송했습니다!!\\n。゜゜(>□<｡)°゜。"

msgid "message_12718_txt"
msgstr "괜찮아. 시간대만 조심해서\\n계속 열심히 해 줘"

msgid "message_12719_txt"
msgstr "고맙습니더!"

msgid "message_12720_txt"
msgstr "그래서… 왜 또 바이올린이야?"

msgid "message_12721_txt"
msgstr "여러 가지 이유가 있지?"

msgid "message_12722_txt"
msgstr "란카 씨가\\n피아노로 연습하던 그 곡…"

msgid "message_12723_txt"
msgstr "그 곡에\\n바이올린 소리가 겹쳐지면 좋겠다고\\n그렇게 생각했어요!"

msgid "message_12724_txt"
msgstr "바이올린 소리는\\n하늘처럼 맑고 투명한 색을 하고 있으니까…"

msgid "message_12725_txt"
msgstr "란카 씨의 산들바람 같은\\n피아노 음색 위에 얹어 보면\\n분명 멋질 거라고 생각했어요!"

msgid "message_12726_txt"
msgstr "그동안 저랑 프레이아 쨩 둘이서\\n음악회를 여는 게 목표였잖아!"

msgid "message_12727_txt"
msgstr "헤에, 피아노와 바이올린으로\\n음악회라…"

msgid "message_12728_txt"
msgstr "조금 들어보고 싶어졌는데"

msgid "message_12729_txt"
msgstr "하야테가 깜짝 놀라서\\n의자에서 떨어질 정도의 연주를 해줄 테니까\\n각오하고 있어~!"

msgid "message_12730_txt"
msgstr "좋은 걸로 부탁한다고?"

msgid "message_12731_txt"
msgstr "저기. 그 음악회\\n나도 들으러 가도 될까?"

msgid "message_12732_txt"
msgstr "란카 쨩의 피아노와\\n프레이아 쨩의 바이올린…"

msgid "message_12733_txt"
msgstr "멋진 음악회가 될 것 같네!"

msgid "message_12734_txt"
msgstr "셰릴 씨가\\n그렇게 말해 주시니 정말 기뻐요…!"

msgid "message_12735_txt"
msgstr "아직 연습이 많이 부족하니까\\n더 열심히 할게요!"

msgid "message_12736_txt"
msgstr "저도 더 열심히 연습할게요!"

msgid "message_12737_txt"
msgstr "힘내, 프레이아"

msgid "message_12738_txt"
msgstr "음악회, 발키리 전원이\\n들으러 갈 테니까＾＾"

msgid "message_12739_txt"
msgstr "점점\\n큰일이 되어 가네…"

msgid "message_12740_txt"
msgstr "뭔가, 괜찮을까…"

msgid "message_12741_txt"
msgstr "안심해, 프레이아!\\n나중에 연습 보러 가줄게!"

msgid "message_12742_txt"
msgstr "부탁드립니다, 밀레느 선생님~~!!\\n。゜゜(>□<｡)°゜。"

msgid "message_12743_txt"
msgstr "다들 와준다니\\n정말 기쁘다!"

msgid "message_12744_txt"
msgstr "멋진 음악회가 되도록 힘내자!"

msgid "message_12745_txt"
msgstr "셰리셰리! 지금 시간 있어?"

msgid "message_12746_txt"
msgstr "괜찮아"

msgid "message_12747_txt"
msgstr "지난번 의상 말인데…"

msgid "message_12748_txt"
msgstr "나, 역시 어느 쪽도 고를 수 없어!"

msgid "message_12749_txt"
msgstr "역시 그렇게 되는구나"

msgid "message_12750_txt"
msgstr "알겠어.\\n생각해 줘서 고마워, 마키나"

msgid "message_12751_txt"
msgstr "저기, 셰리셰리!\\n내가 잘못 생각한 거라면\\n미안한데…"

msgid "message_12752_txt"
msgstr "셰리셰리도\\n사실은 두 의상 모두 입고 싶다고\\n생각하고 있는 거 아니야?"

msgid "message_12753_txt"
msgstr "…왜 그렇게 생각해?"

msgid "message_12754_txt"
msgstr "다음 라이브에서\\n셰리셰리가 부를 예정인 곡이 있잖아?"

msgid "message_12755_txt"
msgstr "그걸 들으면서\\n디자인을 보고 있을 때\\n혹시나 싶었어"

msgid "message_12756_txt"
msgstr "역시 마키나네"

msgid "message_12757_txt"
msgstr "그래. 이 곡을 부를 때는\\n두 의상을 번갈아 입고 노래하고 싶다고\\n생각했었어…"

msgid "message_12758_txt"
msgstr "예전까지는 말이야"

msgid "message_12759_txt"
msgstr "셰리셰리가 생각을 바꾼 데에는\\n뭔가 사정이 있었던 거야?"

msgid "message_12760_txt"
msgstr "이 싸움이 시작되고 나서\\n우리, 다른 시공의 기억을 보는 일이\\n늘어났잖아?"

msgid "message_12761_txt"
msgstr "응, 그렇지…"

msgid "message_12762_txt"
msgstr "마키나는 그 기억 속에서\\n기억 속의 자신에게\\n놀란 적은 없었어?"

msgid "message_12763_txt"
msgstr "기억 속의 자신에게\\n놀란다고?"

msgid "message_12764_txt"
msgstr "나한테는 그런 일이 있었어"

msgid "message_12765_txt"
msgstr "어떤 기억이었는지는\\n확실히 기억나지 않지만…"

msgid "message_12766_txt"
msgstr "그 기억 속의 나는\\n지금의 나보다 훨씬 강하게 빛나고 있었어"

msgid "message_12767_txt"
msgstr "나 자신조차\\n이게 정말 나 맞을까? 하고\\n의심할 정도로"

msgid "message_12768_txt"
msgstr "…응. 그런 기억\\n나한테도 있었을지도 몰라"

msgid "message_12769_txt"
msgstr "나는, 『그 셰릴』을 뛰어넘고 싶은 거야"

msgid "message_12770_txt"
msgstr "지금, 여기 있는 내가\\n가장 빛나고 싶어"

msgid "message_12771_txt"
msgstr "나 자신에게 지고 싶지 않아.\\n그렇게 생각하니까…"

msgid "message_12772_txt"
