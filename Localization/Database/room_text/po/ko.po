msgstr "괜찮아, 카나카나!\\n아라드 대장님에게도 확실히 허락\\n받았으니까!"

msgid "message_2558_txt"
msgstr "실력이 솟구친다"

msgid "message_2559_txt"
msgstr "정말 아라드 대장님이\\n괜찮다고 하신 거야?"

msgid "message_2560_txt"
msgstr "응!\\n뭐…대장님, 조금 취해 있었지만!"

msgid "message_2561_txt"
msgstr "그거 정말 괜찮은 걸까…"

msgid "message_2562_txt"
msgstr "괜찮잖아, 카나메"

msgid "message_2563_txt"
msgstr "생일은 특별한 날이잖아?\\n조금 정도는 마음대로 하게 해줘도 되지 않을까?"

msgid "message_2564_txt"
msgstr "하지만…"

msgid "message_2565_txt"
msgstr "미쿠모 말이 맞아.\\n위험한 일은 하지 않을 거야, 아마"

msgid "message_2566_txt"
msgstr "시작하자, 마키나"

msgid "message_2567_txt"
msgstr "네ー!"

msgid "message_2568_txt"
msgstr "미라쥬 씨!\\n생일 축하드립니다!"

msgid "message_2569_txt"
msgstr "감사합니다.\\n기억하고 계셨나요?"

msgid "message_2570_txt"
msgstr "뭐, 그렇지. 선물도\\n제대로 준비해 뒀다고"

msgid "message_2571_txt"
msgstr "어, 하야테가요!?"

msgid "message_2572_txt"
msgstr "…거기서 놀랄 건 아니잖아.\\n뭐, 내가 준비했다기보단\\n모두가 준비한 선물이지만"

msgid "message_2573_txt"
msgstr "다 같이 발키리 모형을 만들었어.\\n도색은 내가 했고!"

msgid "message_2574_txt"
msgstr "미라쥬 씨가 기뻐하도록\\n엄청 열심히 했답니다(*^皿^*)"

msgid "message_2575_txt"
msgstr "맞아!\\n모형은 내가 감수했으니까\\n세세한 부분까지 완벽 재현이야!"

msgid "message_2576_txt"
msgstr "여전히 메서는\\n아무것도 안 했지만 말이지"

msgid "message_2577_txt"
msgstr "하야하야는 정말 둔하다니까~\\n메사메사도 제대로 생각하고 있는 거야!"

msgid "message_2578_txt"
msgstr "그렇네^^"

msgid "message_2579_txt"
msgstr "미라쥬, 메서 군이 전하는 말이야.\\n오늘은 자신이 대신 일할 테니까\\n휴가를 내라고 하네"

msgid "message_2580_txt"
msgstr "그렇게 갑자기!?"

msgid "message_2581_txt"
msgstr "아마 메서 군 나름의\\n축하 방식이라고 생각해"

msgid "message_2582_txt"
msgstr "메서 중위…"

msgid "message_2583_txt"
msgstr "아라드 대장님도 함장님도\\n미라쥬의 생일을 축하할 생각으로 가득해!"

msgid "message_2584_txt"
msgstr "…정말 감사합니다!\\n앞으로도 열심히 하겠습니다,\\n잘 부탁드립니다!"

msgid "message_2585_txt"
msgstr "좋아, 그럼 다 같이\\n귀여운 케이크 먹자ー( *>ω< *)"

msgid "message_2586_txt"
msgstr "척.\\n레이나 씨가 입수한 영상은 봤나"

msgid "message_2587_txt"
msgstr "응, 봤는데 말이지…"

msgid "message_2588_txt"
msgstr "영상이라니, 무슨 영상인데?"

msgid "message_2589_txt"
msgstr "오, 하야테!\\n사실 레이나가 해킹해서\\n공중기사단의 영상을 입수했대"

msgid "message_2590_txt"
msgstr "그런데, 조금 의외인 게\\n찍혀 있었거든"

msgid "message_2591_txt"
msgstr "…의외인 것?"

msgid "message_2592_txt"
msgstr "그래, 오늘은 백기사의 생일이었던 모양이라\\n백기사와 하인츠 2세가 찍혀 있었어"

msgid "message_2593_txt"
msgstr "그리고 하인츠 2세를 안아주면서\\n둘이 사이좋게 사과 열매를 따고 있더라고"

msgid "message_2594_txt"
msgstr "뭔가 조금 의외였달까.\\n지금까지의 백기사 이미지와는 다르잖아?"

msgid "message_2595_txt"
msgstr "물론 적이라는 건 알고 있지만,\\n그래도 백기사도 형 같은 표정을 지을 때가\\n있구나 싶었어"

msgid "message_2596_txt"
msgstr "헤에ー, 그 백기사가 말이지…"

msgid "message_2597_txt"
msgstr "뭐야, 안 믿는 거냐?\\n나도 형제가 있으니까,\\n그런 건 알 수 있다고"

msgid "message_2598_txt"
msgstr "딱히 의심하는 건 아니야.\\n뭐, 백기사도 생일 정도는\\n형제와 함께 있고 싶다고 생각한 거 아닐까?"

msgid "message_2599_txt"
msgstr "이봐, 메서?"

msgid "message_2600_txt"
msgstr "관심 없다.\\n그보다 대장님께 보고하는 걸 우선해라"

msgid "message_2601_txt"
msgstr "하지만 새로 알아낸 게\\n별로 없으니까,\\n대장님께 어떻게 보고해야 할지…"

msgid "message_2602_txt"
msgstr "맞다, 메서!\\n내 대신 보고를…라고"

msgid "message_2603_txt"
msgstr "어이, 메서!"

msgid "message_2604_txt"
msgstr "메서, 이미 임무로 돌아간 거 아냐?"

msgid "message_2605_txt"
msgstr "…정말 그 녀석답다니까"

msgid "message_2606_txt"
msgstr "미사 씨, 오늘 생일이시죠?\\n축하드립니다!"

msgid "message_2607_txt"
msgstr "뭐…민메이 씨, 고마워!"

msgid "message_2608_txt"
msgstr "오늘 냥냥에도 초대받을 예정이고…\\n왠지 조금 미안해지네"

msgid "message_2609_txt"
msgstr "그런데 말인데요…\\n약속 시간을 조금만\\n늦춰도 괜찮을까요…?"

msgid "message_2610_txt"
msgstr "무슨 일이라도 있어?"

msgid "message_2611_txt"
msgstr "히카리가 생일 선물을 준비하는 걸\\n깜빡해서 급하게 사러\\n가고 있어요!"

msgid "message_2612_txt"
msgstr "뭐야, 민메이도\\n케이크가 아직 안 됐다고\\n말했잖아?"

msgid "message_2613_txt"
msgstr "정말…히카리! 왜 말해버린 거야!"

msgid "message_2614_txt"
msgstr "케이크 얘기는\\n비밀로 하고 싶었는데…"

msgid "message_2615_txt"
msgstr "아차…"

msgid "message_2616_txt"
msgstr "케이크?"

msgid "message_2617_txt"
msgstr "…미사 씨에게 만드는 법을 배워서,\\n준비해 두고 놀라게 해주려고 했어요"

msgid "message_2618_txt"
msgstr "하지만 생각보다 잘 안 돼서…\\n파티가 시작하기 전에는 어떻게든 할게요!"

msgid "message_2619_txt"
msgstr "후후, 있잖아 민메이 씨.\\n나도 같이 만들어도 될까?"

msgid "message_2620_txt"
msgstr "네!? 하지만 생일인데…"

msgid "message_2621_txt"
msgstr "같이 만드는 편이 더 즐겁잖아,\\n추억이 되고 특별한 생일이 될 것 같아!"

msgid "message_2622_txt"
msgstr "정말인가요!? 감사합니다!"

msgid "message_2623_txt"
msgstr "그럼 미사 씨의 앞치마를\\n준비해 두고 기다릴게요!"

msgid "message_2624_txt"
msgstr "응, 바로 갈게!"

msgid "message_2625_txt"
msgstr "윈더미어의 정보를\\n해킹해서 알아냈다"

msgid "message_2626_txt"
msgstr "오늘은 공중기사단의\\n보그 콘파르트의 생일"

msgid "message_2627_txt"
msgstr "헤에ー, 그랬구나ー!"

msgid "message_2628_txt"
msgstr "그래서 바이러스를\\n보내봤다"

msgid "message_2629_txt"
msgstr "바이러스…?\\n뭔지는 잘 모르겠지만, 역시 레이나 씨네!"

msgid "message_2630_txt"
msgstr "경사스러운 날에는 누구나 방심한다"

msgid "message_2631_txt"
msgstr "그러니까! 방심한 적에게서\\n정보를 얻자는 거구나(*´∀｀*)"

msgid "message_2632_txt"
msgstr "있잖아, 레이레이!\\n어떤 정보를 얻었어?"

msgid "message_2633_txt"
msgstr "…다 같이 사과 케이크를 먹고 있는\\n공중기사단의 영상"

msgid "message_2634_txt"
msgstr "백기사에게 축하받고\\n기뻐하는 보그 콘파르트"

msgid "message_2635_txt"
msgstr "엄청 훈훈한 영상이네!"

msgid "message_2636_txt"
msgstr "너무 평화로워"

msgid "message_2637_txt"
msgstr "<size=24>전혀 따끔하지 않아</size>"

msgid "message_2638_txt"
msgstr "<size=30>불만</size>"

msgid "message_2639_txt"
msgstr "그래서, 따끔한 선물을\\n보내기로 했다"

msgid "message_2640_txt"
msgstr "따끔한 선물?\\n어떤 선물인데??"

msgid "message_2641_txt"
msgstr "해킹으로 공중기사단의\\n몇 가지 데이터를\\n나와 마키나의 알콩달콩한 사진으로 덮어쓰기"

msgid "message_2642_txt"
msgstr "귀여운 사진을\\n잔뜩 골랐어!( *>ω< *)"

msgid "message_2643_txt"
msgstr "<size=24>엄청난데!?Σ(ﾟ□ﾟ)</size>"

msgid "message_2644_txt"
msgstr "그건 분명\\n보그 씨도 깜짝 놀라겠네…"

msgid "message_2645_txt"
msgstr "해피 버스데이, 알토 공주님"

msgid "message_2646_txt"
msgstr "공주라고 부르지 마!"

msgid "message_2647_txt"
msgstr "자자, 아무튼\\n오늘은 네 생일이잖아.\\n파티 장소까지 안내해 주려고 했지"

msgid "message_2648_txt"
msgstr "알토, 해피 버스데이!\\n생일 파티 준비는 끝났으니까\\n어서 와!"

msgid "message_2649_txt"
msgstr "해피 버스데이, 알토 군!\\n셰릴 씨와 같이 만든\\n케이크도 있어!"

msgid "message_2650_txt"
msgstr "…그렇군.\\n하지만 지금부터 개인 용무로 외출이라니…\\n대장님이 분명 화낼 텐데"

msgid "message_2651_txt"
msgstr "이번만큼은 특별히 허가해 주지"

msgid "message_2652_txt"
msgstr "란카가 부탁했으니까.\\n어쩔 수 없이 말이다"

msgid "message_2653_txt"
msgstr "고마워, 오빠!( *´▽｀*)"

msgid "message_2654_txt"
msgstr "알토! 란카들이 정성껏 만든 케이크다,\\n제대로 맛보고 먹어라"

msgid "message_2655_txt"
msgstr "케이크, 란카 짱의 집에서\\n같이 만들었어!"

msgid "message_2656_txt"
msgstr "서로 앞치마를 고르기도 하고,\\n과일을 장식하기도 하고…\\n정말 즐거웠어요!"

msgid "message_2657_txt"
msgstr "이런 서비스는 좀처럼 안 해주니까,\\n감사하도록 해?"

msgid "message_2658_txt"
msgstr "그래, 고맙다"

msgid "message_2659_txt"
msgstr "…순순히 고맙다고 하니까\\n왠지 내가 이상해지는 기분이네"

msgid "message_2660_txt"
msgstr "무슨 뜻이야.\\n…그래서, 장소는 어디지?"

msgid "message_2661_txt"
msgstr "내 집이야!\\n이제 미셸 군이 발키리로\\n알토 군을 데려와 준대!"

msgid "message_2662_txt"
msgstr "가장 빠르게 데려와 달라고\\n부탁했어"

msgid "message_2663_txt"
msgstr "대장님의 허가도 받았으니,\\n명령대로 하겠다는 거지"

msgid "message_2664_txt"
msgstr "그런 의미에서 알토.\\n빨리 격납고로 집합!"

msgid "message_2665_txt"
msgstr "여러모로 이상하잖아!\\n…정말 자유로운 녀석들이군"

msgid "message_2666_txt"
msgstr "바사라, 잠깐 괜찮을까?"

msgid "message_2667_txt"
msgstr "밀레느 짱에게 오늘이\\n네 생일이라고 들었는데…"

msgid "message_2668_txt"
msgstr "그래서 일부러 연락한 건가?"

msgid "message_2669_txt"
msgstr "일부러라니…\\n그런데 밀레느 짱은?"

msgid "message_2670_txt"
msgstr "밀레느라면 아침부터 신나서\\n주방에서 케이크를 만들고 있어"

msgid "message_2671_txt"
msgstr "레이와 비히다와 함께 말이지"

msgid "message_2672_txt"
msgstr "생일 같은 건, 그렇게\\n특별한 것도 아니라고 생각하는데"

msgid "message_2673_txt"
msgstr "어머, 그렇지 않아!"

msgid "message_2674_txt"
msgstr "1년에 한 번뿐이잖아.\\n성대하게 축하받으면 되지!"

msgid "message_2675_txt"
msgstr "맞아, 바사라.\\n모처럼 밀레느 씨가\\n직접 케이크를 만들어 준다잖아"

msgid "message_2676_txt"
msgstr "축하받는 입장으로서 조금은\\n기뻐해도 되지 않겠나?"

msgid "message_2677_txt"
msgstr "그런 건가?\\n그래서 그 케이크가 완성되려면\\n얼마나 더 걸리는데?"

msgid "message_2678_txt"
msgstr "조금만 더 걸린다고 들었는데…"

msgid "message_2679_txt"
msgstr "그럼 노래하고 올까"

msgid "message_2680_txt"
msgstr "…이봐, 바사라!\\n적어도 완성될 때까지 밀레느 씨에게\\n고맙다는 말 정도는 생각해 두라고…"

msgid "message_2681_txt"
msgstr "노래라…그거 좋은 생각이네!\\n이왕이면 초시공 유닛 라이브로\\n노래하는 건 어때?"

msgid "message_2682_txt"
msgstr "나쁘지 않겠어!"

msgid "message_2683_txt"
msgstr "미쿠모! 너도 갈 수 있겠어?"

msgid "message_2684_txt"
msgstr "그래, 기꺼이"

msgid "message_2685_txt"
msgstr "셰릴 씨에 미쿠모 씨까지…\\n또 멋대로 초시공 유닛 라이브를…"

msgid "message_2686_txt"
msgstr "어머? 좋잖아!"

msgid "message_2687_txt"
msgstr "그래. 생일이라는 건\\n특별한 날이라고 들었어"

msgid "message_2688_txt"
msgstr "이런 특별함도\\n나쁘지 않다고 생각하는데"

msgid "message_2689_txt"
msgstr "미쿠모 말이 맞아, 감린.\\n그럼 가자!"

msgid "message_2690_txt"
msgstr "해피 버스데이, 미쿠모!"

msgid "message_2691_txt"
msgstr "그래서 바로, 우리들의\\n선물인데…"

msgid "message_2692_txt"
msgstr "마키나, 부탁해!"

msgid "message_2693_txt"
msgstr "네ー네ー!\\n그럼 쿠모쿠모의\\n오늘 스케줄을 발표할게요!"

msgid "message_2694_txt"
msgstr "스케줄?"

msgid "message_2695_txt"
msgstr "우선 같이 점심을 먹습니다!!"

msgid "message_2696_txt"
msgstr "메뉴는 전부\\n척 씨가 고안한 거야!"

msgid "message_2697_txt"
msgstr "해거미 요리 풀코스"

msgid "message_2698_txt"
msgstr "해거미…"

msgid "message_2699_txt"
msgstr "그리고 점심 식사 후에는\\n다 같이 쇼핑하러 가요!"

msgid "message_2700_txt"
msgstr "쿠모쿠모에게 딱 맞는\\n귀엽고 귀여운 옷을\\n골라줄 테니까!"

msgid "message_2701_txt"
msgstr "쇼핑 다음에는 다 같이\\n케이크 먹는 거야!!"

msgid "message_2702_txt"
msgstr "다 같이 먹으면 분명 케이크도\\n평소보다 맛있게 느껴질 거야^^"

msgid "message_2703_txt"
msgstr "밤에는 라쿠키 냥냥에서 파티"

msgid "message_2704_txt"
msgstr "…상당히 열심이네"

msgid "message_2705_txt"
msgstr "모처럼 맞는 생일이잖아.\\n즐겁고, 맛있고…그리고 기쁘다는 감정도"

msgid "message_2706_txt"
msgstr "오늘은 미쿠모가 그런 기분을\\n마음껏 느꼈으면 해"

msgid "message_2707_txt"
msgstr "딱히, 그런 감정이라면…"

msgid "message_2708_txt"
msgstr "항상 너희에게\\n배우고 있어"

msgid "message_2709_txt"
msgstr "감사도…하고 있다고\\n생각해"

msgid "message_2710_txt"
msgstr "…쿠모쿠모가 츤데레가 됐다!!!"

msgid "message_2711_txt"
msgstr "초레어"

msgid "message_2712_txt"
msgstr "미쿠모 씨이이이!!!!\\n。゜゜(>□<｡)°゜。"

msgid "message_2713_txt"
msgstr "그래도 우리는 축하해 주고 싶은걸!\\n그러니까 미쿠모, 함께해 줄래?"

msgid "message_2714_txt"
msgstr "…정말 못 말리는 사람들이네"

msgid "message_2715_txt"
msgstr "척 씨,\\n생일 축하드립니다!"

msgid "message_2716_txt"
msgstr "엣!? 민메이 짱!?"

msgid "message_2717_txt"
msgstr "나중에 특별 레시피를 보내드릴게요!\\n제 선물이에요!"

msgid "message_2718_txt"
msgstr "특별 레시피라니…"

msgid "message_2719_txt"
msgstr "아저씨와 아주머니께서\\n생일에 딱 맞는 특별 레시피를\\n생각해 주셨어요!"

msgid "message_2720_txt"
msgstr "척 씨는 요리를 좋아하시는 것 같고,\\n분명 좋아해 주실 거라고 생각해서…"

msgid "message_2721_txt"
msgstr "냥냥의 특별 레시피라고…진짜야!?"

msgid "message_2722_txt"
msgstr "척 소위,\\n오늘은 저희도 도와드리게 해주세요!"

msgid "message_2723_txt"
msgstr "사실 오늘을 위해\\n맞춤 앞치마를 준비했어요!"

msgid "message_2724_txt"
msgstr "물론 아라드 대장님과\\n메서 중위님의 것도 있습니다"

msgid "message_2725_txt"
msgstr "잠깐만, 미라쥬.\\n…맞춤이라는 게 진짜냐"

msgid "message_2726_txt"
msgstr "메서 같은 녀석은 절대 안 어울리잖아!"

msgid "message_2727_txt"
msgstr "그렇지 않습니다!\\n메서 중위님도\\n흔쾌히 허락해 주셨고…"

msgid "message_2728_txt"
msgstr "<size=26>뭐!?</size>"

msgid "message_2729_txt"
msgstr "…나는 대장님의 결정을 따랐을 뿐이다"

msgid "message_2730_txt"
msgstr "파일럿들이 모두\\n맞춤 앞치마라니…"

msgid "message_2731_txt"
msgstr "좋겠다~!\\n왠지 재밌을 것 같아!"

