msgid "message_6827_txt"
msgstr "…크리스마스 라이브 뒤에도 결국 다 같이\\n계속 노래만 해서…정말 즐겁긴 했지만\\n크리스마스다운 일은 못 했어"

msgid "message_6828_txt"
