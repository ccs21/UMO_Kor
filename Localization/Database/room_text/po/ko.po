msgid "message_11766_txt"
msgstr "이 사진 속 발키리가 맞나요?"

msgid "message_11767_txt"
msgstr "응, 아마 이거일 거야!"

msgid "message_11768_txt"
msgstr "너무 낡은 사진이군…\\n게다가 흐릿해서 확실히 알 수 없어"

msgid "message_11769_txt"
msgstr "그렇죠…"

msgid "message_11770_txt"
msgstr "그런데, 뭐가?"

msgid "message_11771_txt"
msgstr "이 기체가\\n마크로스 프론티어 상공을\\n날고 있었다고 보기는 어렵습니다"

msgid "message_11772_txt"
msgstr "날고 있었다고 보기 어렵다니…\\n루카, 무슨 뜻이야?"

msgid "message_11773_txt"
msgstr "나는 분명 봤어.\\n틀림없다고!"

msgid "message_11774_txt"
msgstr "음…\\n그렇게 말씀하셔도…"

msgid "message_11775_txt"
msgstr "프론티어 상공을 비행하는 기체는\\n당연히 파악하고 있습니다"

msgid "message_11776_txt"
msgstr "…하지만 어떤 데이터에도 감시 카메라에도\\n없었습니다"

msgid "message_11777_txt"
msgstr "셰릴 씨가 봤던 시간에 이 기체가\\n비행하고 있었다는 사실이…"

msgid "message_11778_txt"
msgstr "갑자기 오컬트 같은 이야기가 되어버렸군…"

msgid "message_11779_txt"
msgstr "역시 착각이었던 거 아닐까?"

msgid "message_11780_txt"
msgstr "아니면 인간들의 제멋대로인 판단으로 폐기된\\n발키리의 원한이 쌓인 유령…\\n같은 거라든가?"

msgid "message_11781_txt"
msgstr "에에!? \\n무서운 말 하지 마, 미셸 군…!"

msgid "message_11782_txt"
msgstr "발키리의 유령이라…"

msgid "message_11783_txt"
msgstr "꽤 흥미로운 이야기네"

msgid "message_11784_txt"
msgstr "유령 같은 게 아니야.\\n왜냐하면 이 눈으로 똑똑히 봤으니까!"

msgid "message_11785_txt"
msgstr "알고 있어"

msgid "message_11786_txt"
msgstr "왜냐하면 나도 봤으니까"

msgid "message_11787_txt"
msgstr "정말이야? 미쿠모"

msgid "message_11788_txt"
msgstr "응. 라그나의 아주 높은 상공을\\n천천히 날아갔어"

msgid "message_11789_txt"
msgstr "커다란 날개를 펼치고…\\n마치 새처럼"

msgid "message_11790_txt"
msgstr "미쿠모 씨 일행의 시공에서도\\n목격되다니…"

msgid "message_11791_txt"
msgstr "우연이라고 하기엔 너무 절묘하잖아\\n아무리 생각해도 부자연스러워"

msgid "message_11792_txt"
msgstr "미쿠모. 너, 노래는 들었어?"

msgid "message_11793_txt"
msgstr "나는 그 기체를 보기 전에\\n들어본 적 없는 노래를 들었는데…"

msgid "message_11794_txt"
msgstr "들었어"

msgid "message_11795_txt"
msgstr "아주 아름다운 노래.\\n꿈과, 바람과… 누군가의 이름을 부르는 목소리"

msgid "message_11796_txt"
msgstr "이스마, 갈드…"

msgid "message_11797_txt"
msgstr "이스마?"

msgid "message_11798_txt"
msgstr "루카, 무슨 일이야?"

msgid "message_11799_txt"
msgstr "아, 아닙니다. 어디선가 들어본 적 있는\\n이름이라고 생각해서요"

msgid "message_11800_txt"
msgstr "루카?"

msgid "message_11801_txt"
msgstr "셰릴 씨와 미쿠모 씨가 본 것은,\\n기억이 보여준 환영일지도 모르겠네요"

msgid "message_11802_txt"
msgstr "기억이 보여준 환영…"

msgid "message_11803_txt"
msgstr "그렇군.\\n흥미로운 해석이네"

msgid "message_11804_txt"
msgstr "그래.\\n미셸이 말한 유령설보다는\\n신빙성이 있어 보여!"

msgid "message_11805_txt"
msgstr "신빙성이 없어서 미안하군"

msgid "message_11806_txt"
msgstr "어쨌든, 기억에 대해서는\\n저도 계속 조사해 보겠습니다"

msgid "message_11807_txt"
msgstr "저기, 파일럿 여러분.\\n잠깐 괜찮으세요?"

msgid "message_11808_txt"
msgstr "무슨 일이신가요, 란카 씨"

msgid "message_11809_txt"
msgstr "저와 민메이 씨가\\n조금 물어보고 싶은 게 있어요!"

msgid "message_11810_txt"
msgstr "발키리를 타고 우주 공간을 나는 게\\n어떤 느낌인지\\n알려주세요!"

msgid "message_11811_txt"
msgstr "우주 공간을 나는 감각…인가요"

msgid "message_11812_txt"
msgstr "직접 날아보면 알겠지"

msgid "message_11813_txt"
msgstr "정말, 바사라라니까!\\n두 사람은 그걸 할 수 없으니까\\n우리에게 물어보는 거잖아?"

msgid "message_11814_txt"
msgstr "음, 그러게…\\n나한테는 상쾌하다!\\n라는 느낌이려나?"

msgid "message_11815_txt"
msgstr "발키리를 타고 우주로 나가면\\n왠지 모르게 두근두근해지는걸!"

msgid "message_11816_txt"
msgstr "역시 숙모님이시네요!"

msgid "message_11817_txt"
msgstr "미라쥬는 어때?"

msgid "message_11818_txt"
msgstr "저요? 저는 항상\\n눈앞의 적에게 집중할 뿐이라서…"

msgid "message_11819_txt"
msgstr "…그게 파일럿으로서의 일이니까"

msgid "message_11820_txt"
msgstr "눈앞의 적 이외에\\n신경을 쓸 필요 따위는 없어"

msgid "message_11821_txt"
msgstr "그렇지. 애초에 우주 공간에서의 전투는\\n한시도 긴장을 풀 수 없는 일뿐이니까"

msgid "message_11822_txt"
msgstr "방심하면\\n순식간에 격추되고 끝이야"

msgid "message_11823_txt"
msgstr "헤에. 제법 잘난 척하는 말을 하게 됐네,\\n알토 공주님"

msgid "message_11824_txt"
msgstr "입대했을 무렵에는\\n하루에도 몇백 번씩 격추당했으면서.\\n시뮬레이터에서 말이야"

msgid "message_11825_txt"
msgstr "뭐…!"

msgid "message_11826_txt"
msgstr "몇백 번은 과장이다!\\n취소해, 미셸!"

msgid "message_11827_txt"
msgstr "그럴까?\\n손가락으로 세어가며 떠올려 보라고"

msgid "message_11828_txt"
msgstr "네가 추락할 때마다\\n목에 「나는 죽었습니다」라고 적힌\\n팻말을 걸어줬던 것 같은데"

msgid "message_11829_txt"
msgstr "미셸…!!"

msgid "message_11830_txt"
msgstr "뭐, 처음에는\\n다들 그런 거겠지.\\n나도 실제로 추락할 뻔했고"

msgid "message_11831_txt"
msgstr "그때 일,\\n제대로 반성하고 있는 겁니까?"

msgid "message_11832_txt"
msgstr "네네. 하고 있다니까"

msgid "message_11833_txt"
msgstr "절대 안 하고 있잖아요!"

msgid "message_11834_txt"
msgstr "그래서, 무슨 얘기였지.\\n발키리로 우주를 나는 감각에\\n대한 이야기였나?"

msgid "message_11835_txt"
msgstr "나는 메서나 미라쥬와는 다르게\\n항상 제대로 느끼고 있어"

msgid "message_11836_txt"
msgstr "바람을 말이지"

msgid "message_11837_txt"
msgstr "바람…?"

msgid "message_11838_txt"
msgstr "재미있지?\\n공기도 없는 진공의 우주에서도\\n그걸 느낀다고!"

msgid "message_11839_txt"
msgstr "착각이다"

msgid "message_11840_txt"
msgstr "그럴 리 없잖아.\\n메서도 가끔 느끼잖아?"

msgid "message_11841_txt"
msgstr "엔진을 이렇게\\n꾹 밀어붙일 때마다\\n바람이 휙 불어오는 느낌이 들어"

msgid "message_11842_txt"
msgstr "그러다 보면 어느 순간\\n기체와 함께 내 몸도 가벼워져서"

msgid "message_11843_txt"
msgstr "거기에 프레이야의 노래까지 들려오면…\\n자연스럽게 몸이 춤추기 시작하는 거야"

msgid "message_11844_txt"
msgstr "봐. 메서도\\n그런 느낌으로 날고 있는 거잖아?"

msgid "message_11845_txt"
msgstr "그거 분명\\n인멜만 댄스라는 거였지?"

msgid "message_11846_txt"
msgstr "하야테는 대단하네.\\n발키리로 춤을 춘다니\\n상상도 못 하겠어"

msgid "message_11847_txt"
msgstr "정신 차리고 보면\\n항상 그렇게 되어 있을 뿐이지만"

msgid "message_11848_txt"
msgstr "정말이지…그것 때문에\\n이쪽은 몇 번이나 간담이 서늘했는지"

msgid "message_11849_txt"
msgstr "위험해지면\\n미라쥬가 도와주니까\\n문제없다고"

msgid "message_11850_txt"
msgstr "헤에, 그래?\\n잘했네, 미라쥬!"

msgid "message_11851_txt"
msgstr "아닙니다!\\n이 남자가 너무 제멋대로라서\\n저희가 항상 고생하는 겁니다!"

msgid "message_11852_txt"
msgstr "서로 손이 많이 가는\\n전우를 둔 모양이군, 미라쥬"

msgid "message_11853_txt"
msgstr "그거 내 얘기야?\\n그렇다면 서로 돕고 사는 거지, 미리아"

msgid "message_11854_txt"
msgstr "그나저나 바람이라.\\n하야테 군이 말하는 그것과\\n내 감각이 같은지는 모르겠지만…"

msgid "message_11855_txt"
msgstr "나도 가끔 느껴.\\n기체와 내 몸이 하나가 되어\\n바람을 타고 날아갈 만큼 가벼워지는 듯한 감각을"

msgid "message_11856_txt"
msgstr "바람을 타고 날아갈 만큼 가벼워진다, 라…"

msgid "message_11857_txt"
msgstr "그 감각을\\n혹시 무중력 상태에서\\n재현할 수 있지 않을까?"

msgid "message_11858_txt"
msgstr "무중력 말인가요?"

msgid "message_11859_txt"
msgstr "응!\\n무중력 스테이지라니\\n정말 우주다운 느낌이라 좋지 않을까?"

msgid "message_11860_txt"
msgstr "와아, 그거 정말 멋져요!\\n좋다고 생각해요"

msgid "message_11861_txt"
msgstr "그럼 그 이미지로 진행해 볼까요!"

msgid "message_11862_txt"
msgstr "파일럿 여러분 덕분에\\n그 밖에도 떠오른 게 있었고…"

msgid "message_11863_txt"
msgstr "떠오른 것?\\n그게 뭐지?"

msgid "message_11864_txt"
msgstr "그건 스테이지에서 기대해 주세요!"

msgid "message_11865_txt"
msgstr "여러분, 고마워요 투어에\\n참가해 주셔서 감사합니다!"

msgid "message_11866_txt"
msgstr "초시공 네트워크와\\n초시공 유닛 라이브를 활용해서"

msgid "message_11867_txt"
msgstr "여러 시공의 모두에게\\n감사를 전하는 투어라니…\\n정말 멋진 일이라고 생각해"

msgid "message_11868_txt"
msgstr "저도, 본 적 없는\\n행성의 여러분께\\n노래를 전할 수 있어서 기뻐요!"

msgid "message_11869_txt"
msgstr "그러고 보니 첫 번째 주자는\\n발키리 여러분이시죠?"

msgid "message_11870_txt"
msgstr "네! 그럴 예정인데요…\\n이번에는 프레이야에게 선곡을 부탁했어요"

msgid "message_11871_txt"
msgstr "그래서…무슨 일이라도 있나요?"

msgid "message_11872_txt"
msgstr "아직 곡을 정하지 못했다고 해요"

msgid "message_11873_txt"
msgstr "그런가요??"

msgid "message_11874_txt"
msgstr "뭐, 이렇게나 대규모 라이브의\\n시작을 장식할 곡이니까요"

msgid "message_11875_txt"
msgstr "고민하는 것도 당연하죠"

msgid "message_11876_txt"
msgstr "프레이야 괜찮을까…?"

msgid "message_11877_txt"
msgstr "가끔은 프레이야가 직접 정해보는 것도\\n좋은 경험이 될 거라고\\n생각했는데"

msgid "message_11878_txt"
msgstr "역시 걱정되네요"

msgid "message_11879_txt"
msgstr "지금 마키나와 레이나가 프레이야의 모습을\\n보러 가줬는데…"

msgid "message_11880_txt"
msgstr "카나카나! 프레프레를 발견했어!"

msgid "message_11881_txt"
msgstr "최속 정보 입수"

msgid "message_11882_txt"
msgstr "정말!?"

msgid "message_11883_txt"
msgstr "프레프레는 지금 자기 방에\\n있는 것 같아!"

msgid "message_11884_txt"
msgstr "누군가와 비밀 통신을 하고 있는 모양"

msgid "message_11885_txt"
msgstr "누군가라니…?"

msgid "message_11886_txt"
msgstr "조금만 있으면 분석이 끝난다"

msgid "message_11887_txt"
msgstr "이 정도는 나에게 너무 쉽다"

msgid "message_11888_txt"
msgstr "역시 레이레이네!"

msgid "message_11889_txt"
msgstr "…완료"

msgid "message_11890_txt"
msgstr "이제 대화 내용도 완벽하게…"

msgid "message_11891_txt"
msgstr "들으면 안 돼ーー!!"

msgid "message_11892_txt"
msgstr "여러분, 안심하세요!\\n프레이야의 통신 상대는 저니까요!"

msgid "message_11893_txt"
msgstr "뭐야, 미레미레였구나"

msgid "message_11894_txt"
msgstr "고마워 투어에 대해서\\n프레이야의 상담을 해주고 있었어"

msgid "message_11895_txt"
msgstr "그랬군요!"

msgid "message_11896_txt"
msgstr "미레이느 씨에게 여러 가지 상담을 하고\\n드디어 곡이 정해졌어요!"

msgid "message_11897_txt"
msgstr "정말!? 다행이다!"

msgid "message_11898_txt"
msgstr "항상 응원해주는 사람들에게\\n어떤 곡을 들려줄까\\n정말 많이 고민했는데"

msgid "message_11899_txt"
msgstr "역시 저는 좋아한다는 마음을\\n전하고 싶다고 생각했어요!"

msgid "message_11900_txt"
msgstr "좋아한다…??"

msgid "message_11901_txt"
msgstr "라그나에 와서, 하야테와 미라쥬 씨…\\n그리고 발키리 모두를 만나고…"

msgid "message_11902_txt"
msgstr "발키리에 들어온 뒤에도 계속\\n저는 좋아하는 사람들에게 둘러싸여 있었어요"

msgid "message_11903_txt"
msgstr "그래서 고맙다는 마음과\\n좋아한다는 마음을 전하고 싶다고\\n생각했어요!"

msgid "message_11904_txt"
msgstr "그래서…좋아, 보냈어요!"

msgid "message_11905_txt"
msgstr "이 곡, 어떨까요!?"

msgid "message_11906_txt"
msgstr "응, 좋네!"

msgid "message_11907_txt"
msgstr "응응! 딱 어울려!"

msgid "message_11908_txt"
msgstr "그런데…궁금한 게 있어"

msgid "message_11909_txt"
msgstr "프레이야와 밀레느의 통신.\\n왜 들으면 안 된다고 한 건지"

msgid "message_11910_txt"
msgstr "그냥 상담이라면 들어도 문제없을 텐데"

msgid "message_11911_txt"
msgstr "별로…수상한 대화 같은 건\\n하지 않았어!"

msgid "message_11912_txt"
msgstr "더구나 밀레느 씨와 연애 이야기 같은 건!!"

msgid "message_11913_txt"
msgstr "프레이야! 말해버렸잖아!!"

msgid "message_11914_txt"
msgstr ""

msgid "message_11915_txt"
msgstr "미레미레와 프레프레의 연애 이야기!?\\n에ーー! 듣고 싶어!!"

msgid "message_11916_txt"
msgstr "절대 안 돼!!"

msgid "message_11917_txt"
msgstr "안 됩니다!!!"

msgid "message_11918_txt"
msgstr "에ーー!!!"

msgid "message_11919_txt"
msgstr "밀레느 씨!\\n라이브 수고하셨어요!"

msgid "message_11920_txt"
msgstr "수고하셨어요!\\n팬 여러분의 반응은 어떤가요?"

msgid "message_11921_txt"
msgstr "대성황이야! 하지만…"

msgid "message_11922_txt"
msgstr "비가 그칠 기미가 전혀 없고\\n오히려 점점 더 강해지고 있어"

msgid "message_11923_txt"
msgstr "모두 흠뻑 젖고 있어서…\\n이대로라면 너무 안쓰러워"

msgid "message_11924_txt"
msgstr "신경 쓰지 말랬잖아,\\n밀레느"

msgid "message_11925_txt"
msgstr "관객들은 우리 노래를 듣고 싶어서\\n거기에 있는 거야"

msgid "message_11926_txt"
msgstr "신경 쓰지 않는 건 무리야!\\n다들한테 미안하잖아!"

msgid "message_11927_txt"
msgstr "됐으니까 너는 네 노래에 집중해.\\n전혀 집중이 안 돼 있잖아"

msgid "message_11928_txt"
msgstr "바사라!"

msgid "message_11929_txt"
msgstr "혼자 노래하러 가버렸어…\\n정말이지!"

msgid "message_11930_txt"
msgstr "밀레느 쨩.\\n지금은 노래하는 것에만 집중해도 돼"

msgid "message_11931_txt"
msgstr "셰릴까지…"

msgid "message_11932_txt"
msgstr "바사라의 생각에 대해서는 말해줬잖아?\\n괜찮아, 분명 곧 맑아질 거야"

msgid "message_11933_txt"
msgstr "음…하지만 아무리 생각해도\\n날씨가 갤 것 같지는 않은데"

msgid "message_11934_txt"
msgstr "이대로라면 관객들뿐만 아니라\\n바사라까지 감기에 걸리잖아!"

msgid "message_11935_txt"
msgstr "그렇구나.\\n밀레느 쨩이 걱정하는 진짜 이유는 그거구나?"

msgid "message_11936_txt"
msgstr "괜찮아, 밀레느 쨩"

msgid "message_11937_txt"
msgstr "폭우 속에서 노래하는 바사라의 모습을 보면…\\n비구름도 결국 포기하고 떠날 것 같다는\\n생각이 들지 않아?"

msgid "message_11938_txt"
msgstr "그럴까아?"

msgid "message_11939_txt"
msgstr "바사라는 분명 괜찮아.\\n감기 같은 건 안 걸려"

msgid "message_11940_txt"
msgstr "그보다, 너도\\n해야 할 일이 있잖아"

msgid "message_11941_txt"
msgstr "그것도 그렇네!\\n해야 할 일은 제대로 해야지"

msgid "message_11942_txt"
msgstr "나도 Fire Bomber니까!"

msgid "message_11943_txt"
msgstr "다녀와!"

msgid "message_11944_txt"
msgstr "…저기, 셰릴.\\n정말 그칠 거라고 생각해?"

msgid "message_11945_txt"
msgstr "응.\\n그야 저 넥키 바사라가 말했잖아"

msgid "message_11946_txt"
msgstr "『이 행성의 비는\\n내 노래로 멈춰 보이겠다』라고"

msgid "message_11947_txt"
msgstr "그렇게 말하면 믿어보고 싶어지잖아"

