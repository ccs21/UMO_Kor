msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "message_0001_txt"
msgstr "아, 프레프레가..."

msgid "message_0002_txt"
msgstr "아, 프레프레가 온 것 같아!(^^)!"

msgid "message_0003_txt"
msgstr "늦었네"

msgid "message_0004_txt"
msgstr "이제 모두 모였다"

msgid "message_0005_txt"
msgstr "와우! 여기서 왈큐레\\n모두와 대화할 수 있구나!"

msgid "message_0006_txt"
msgstr "왈큐레 멤버들만\\n있는 게 아니야"

msgid "message_0007_txt"
msgstr "안녕, 프레이아"

msgid "message_0008_txt"
msgstr "미, 민메이 씨!?\\n진짜!?"

msgid "message_0009_txt"
msgstr "우리도 있어!\\n같이 힘내보자!"

msgid "message_0010_txt"
msgstr "이 내가 있으니까,\\n아무것도 걱정할 필요 없어"

msgid "message_0011_txt"
msgstr "뭐!?\\n란카 씨에, 셰릴 씨!?"

msgid "message_0012_txt"
msgstr "어쨌든 노래하면 되잖아?\\n그럼 나한테 맡겨둬!"

msgid "message_0013_txt"
msgstr "이럴 때일수록 우리\\nFire Bomber가 나설 차례잖아"

msgid "message_0014_txt"
msgstr "바사라 씨랑 밀레느 씨!?\\n왠지 너무 신기해서 머리가 쫓아가질 못하겠어!"

msgid "message_0015_txt"
msgstr "프레이아의 반응, 만족"

msgid "message_0016_txt"
msgstr "역대 가희들이 다 모였네요.\\n아직도 조금 이상한 기분이야"

msgid "message_0017_txt"
msgstr "꽤나 즐겁게 해줄 것 같네"

msgid "message_0018_txt"
msgstr "그런데,"

msgid "message_0019_txt"
msgstr "공명하는 멸망의 노래라는 건\\n정말 피해야 할 것 같네"

msgid "message_0020_txt"
msgstr "무슨 일 있었나?"

msgid "message_0021_txt"
msgstr "이전 전투 중에,\\n갑자기 눈앞의 건물이 사라져 버렸어"

msgid "message_0022_txt"
msgstr "멸망의 노래가<color=red>「기억의 시공」</color>에\\n영향을 끼친 탓에 사라져 버렸다고 해"

msgid "message_0023_txt"
msgstr "정말이지 간단히 믿기 어려운 이야기네"

msgid "message_0024_txt"
msgstr "시간이라든가 공간이라든가\\n어려운 얘기는 잘 모르겠지만"

msgid "message_0025_txt"
msgstr "사실, 대부분의 사람들은 이 비정상적인 사태를\\n알아차리지도 못하고 있어"

msgid "message_0026_txt"
msgstr "언제부턴가 무언가를 잊어버리거나 잃어버렸어도,\\n그것이 무엇인지 기억해내지 못해…"

msgid "message_0027_txt"
msgstr "이유를 알 수 없는 강한 상실감만 남는다고 해"

msgid "message_0028_txt"
msgstr "우리만 그걸 알아차린다는 게\\n왠지 이상한 기분이 들긴 하지만"

msgid "message_0029_txt"
msgstr "생체 폴드파에 의해 보호받고 있다는 거지?"

msgid "message_0030_txt"
msgstr "그게 아니면,\\n노래가 지켜주고 있다고 말하는게 더 이해하기 쉬우려나"

msgid "message_0031_txt"
msgstr "노래가 지켜주고 있다...라"

msgid "message_0032_txt"
msgstr "확실히 그렇게 느껴질 때도 있네"

msgid "message_0033_txt"
msgstr "원리는 잘 모르겠지만, 그런 것 같아"

msgid "message_0034_txt"
msgstr "그래서 가희들을 지키는 것이\\n이 세계를 지키는 것이기도 하다는 거야"

msgid "message_0035_txt"
msgstr "만약 모두가 노래를 부를 수 없게 되면\\n우리도 무사하지 못할 테니까"

msgid "message_0036_txt"
msgstr "하지만 아무리 위험한 싸움이라고 해도,"

msgid "message_0037_txt"
msgstr "누군가를 지킨다는 목적이 있는 만큼,\\n빼앗고 빼앗기는 싸움보다\\n훨씬 더 보람을 느낄 수 있을 것 같아"

msgid "message_0038_txt"
msgstr "그렇네"

msgid "message_0039_txt"
msgstr "틀림없어"

msgid "message_0040_txt"
msgstr "오…"

msgid "message_0041_txt"
msgstr "혹시 방금 말한 거,\\n선배같아서 멋있었으려나?"

msgid "message_0042_txt"
msgstr "좋아, 공격해 온 녀석들은 격퇴했어"

msgid "message_0043_txt"
msgstr "민메이, 그쪽은 어때?"

msgid "message_0044_txt"
msgstr "히카루 덕분에 끝까지 노래할 수 있었어.\\n고마워!"

msgid "message_0045_txt"
msgstr "민메이 씨! 민메이 씨의 노래,\\n여기에서도 잘 들렸어요!\\n저, 솔직히 말해서 감동했습니다!"

msgid "message_0046_txt"
msgstr "역시...전설의 가희"

msgid "message_0047_txt"
msgstr "아냐, 전설이라니…"

msgid "message_0048_txt"
msgstr "하지만 내 노래가 힘이 되어주고 있다면\\n기뻐"

msgid "message_0049_txt"
msgstr "왠지 모르겠지만, 싸울 때\\n민메이의 노래가 응원하는\\n느낌이 들었어"

msgid "message_0050_txt"
msgstr "나도 모두의 노래와 마음이 전해지는\\n것 같아서 평소보다 더 힘차게\\n노래할 수 있었던 것 같아"

msgid "message_0051_txt"
msgstr "어떤 적이 와도 민민의 노래가 있으면\\n일당백이네~(*^ω^)人(^ω^*)"

msgid "message_0052_txt"
msgstr "하하, 그렇구나. 함께 힘내자,\\n「민민」!"

msgid "message_0053_txt"
msgstr "정말, 히카루도 참!"

msgid "message_0054_txt"
msgstr "이렇게 된 이상 나도 질 수 없어! 민메이 씨\\n처럼, 데카르차한 노래를 전할 수\\n있도록 열심히 하겠습니다!"

msgid "message_0055_txt"
msgstr "이거야말로 마치 민메이가 「선배」고,\\n프레이아가 「후배」인 느낌이네."

msgid "message_0056_txt"
msgstr "그러게. 이런 때지만 왠지\\n학교 같은 느낌이라 즐거워지기 시작했어."

msgid "message_0057_txt"
msgstr "정말이지, 대체 무슨 일이야!"

msgid "message_0058_txt"
msgstr "갑자기 습격해 온 녀석들,\\n내 노래를 끝까지 듣지도 않고\\n가버리다니!"

msgid "message_0059_txt"
msgstr "뭐 어때,\\n전투는 끝났잖아."

msgid "message_0060_txt"
msgstr "바사라 씨의 노래, 엄청난 힘이었어요!\\n새 인간도 놀라고 있지 않을까요?"

msgid "message_0061_txt"
msgstr "새인지 뭔지는 모르겠지만,\\n내 노래를 방해하게 두지 않아!"

msgid "message_0062_txt"
msgstr "아니, 오히려 그 새의 인간이라는 녀석에게도\\n내 노래를 들려주겠어!"

msgid "message_0063_txt"
msgstr "상대는 생물이 아니라\\n병기잖아. 아무리 그래도 노래를\\n들려준다는 건 무리가 아닐까?"

msgid "message_0064_txt"
msgstr "새의 인간이라는 건 멸망의 노래라는 걸\\n부르는 거잖아? 부를 수 있다면 들을 수도 있는 거야.\\n당연한 이야기 아니냐!"

msgid "message_0065_txt"
msgstr "잠깐! 다들 보고 있으니까 이상한 거\\n올리지 마!"

msgid "message_0066_txt"
msgstr "뭐든 상관없어! 아무튼,\\n계속 당하고만 있는 건 마음에 안 든다고!"

msgid "message_0067_txt"
msgstr "그러게."

msgid "message_0068_txt"
msgstr "어머, 미쿠모."

msgid "message_0069_txt"
msgstr "당하고만 있는 건 분하니까."

msgid "message_0070_txt"
msgstr "당하고만 있는 건가…"

msgid "message_0071_txt"
msgstr "응, 그건 나도 같은 생각이야!\\n이대로 질 수는 없잖아."

msgid "message_0072_txt"
msgstr "그래. 다음은 우리 차례야."

msgid "message_0073_txt"
msgstr "습격해 온 바쥬라들,\\n평소와는 상태가 달랐던 것 같은데…"

msgid "message_0074_txt"
msgstr "왠지 괴로워 보였어."

msgid "message_0075_txt"
msgstr "멸망의 노래가 바쥬라를 조종하고 있는 거야.\\n네가 걱정한다고 해서 달라질 건 없잖아."

msgid "message_0076_txt"
msgstr "그럴지도 모르지만…"

msgid "message_0077_txt"
msgstr "볼 때마다 불쌍해져서…"

msgid "message_0078_txt"
msgstr "란카 씨…"

msgid "message_0079_txt"
msgstr "그렇게 해서는 안 돼, 란카."

msgid "message_0080_txt"
msgstr "셰릴 씨?"

msgid "message_0081_txt"
msgstr "우리들의 노래는\\n멸망의 노래에 맞설 수 있는 힘을 가지고 있어."

msgid "message_0082_txt"
msgstr "그런 힘을 가진 인간이\\n풀이 죽어서 아무것도 하지 않는 건\\n용납될 리 없어."

msgid "message_0083_txt"
msgstr "노래하는 거야, 란카."

msgid "message_0084_txt"
msgstr "나와 함께!"

msgid "message_0085_txt"
msgstr "셰릴 씨…\\n그렇네요, 죄송해요."

msgid "message_0086_txt"
msgstr "너도 가끔은 좋은 말 하네."

msgid "message_0087_txt"
msgstr "<size=40>「가끔은」</size>"

msgid "message_0088_txt"
msgstr "이라는 말은 빼!"

msgid "message_0089_txt"
msgstr "이 싸움이 끝나면\\n「은하의 요정 명언집」을 만들자."

msgid "message_0090_txt"
msgstr "분명 많이 팔릴 거야."

msgid "message_0091_txt"
msgstr "잠깐,\\n그런 제목은 싸구려 같아서 안 돼."

msgid "message_0092_txt"
msgstr "「은하의 요정에게 배우는 최고의 삶의 방식」"

msgid "message_0093_txt"
msgstr "같은 걸로 해."

msgid "message_0094_txt"
msgstr "여전하네, 장사 수완은…"

msgid "message_0095_txt"
msgstr "민메이 씨, 민메이 씨."

msgid "message_0096_txt"
msgstr "프레이아, 무슨 일이야?"

msgid "message_0097_txt"
msgstr "민메이 씨는 전장에 서서 노래하는 것…\\n「무섭다」고 생각한 적은 없나요?"

msgid "message_0098_txt"
msgstr "왜 그렇게 생각해?"

msgid "message_0099_txt"
msgstr "민메이에게는 우리 델타 소대처럼\\n전속 호위가 붙어 있는 것도 아니잖아."

msgid "message_0100_txt"
msgstr "그런 상황에서 전장에서\\n노래할 수 있다는 게\\n대단하다고 감탄하고 있는 거야."

msgid "message_0101_txt"
msgstr "그렇네. 솔직히 말하면… 무섭다고\\n느낀 적도 많아."

msgid "message_0102_txt"
msgstr "하지만 노래해 달라는 말을 들으면,\\n노래가 필요하다는 말을 들으면, 노래하고\\n싶다는 마음이 더 커져."

msgid "message_0103_txt"
msgstr "하아~ 역시 민메이 씨는\\n대단하네요."

msgid "message_0104_txt"
msgstr "그렇게 대단한 일은 아니야. 그냥 노래하는 걸\\n좋아할 뿐이야."

msgid "message_0105_txt"
msgstr "나는 내 노래에 아무런 힘이 없다고 해도,\\n아마 이렇게 계속 노래하고 있었을 거야."

msgid "message_0106_txt"
msgstr "뭐야, 프레이아랑 똑같은 말을\\n하고 있잖아."

msgid "message_0107_txt"
msgstr "똑같다고?"

msgid "message_0108_txt"
msgstr "너, 알 샤하르에서 말했잖아.\\n「노래가 좋으니까!」라고."

msgid "message_0109_txt"
msgstr "분명 그렇게 말했지만…. 민메이 씨와 같다\\n고 들으니까 왠지 부끄럽네요\\n(*^皿^*)"

msgid "message_0110_txt"
msgstr "그 표정 문자, 네 이상한 웃음소리랑\\n똑같네."

msgid "message_0111_txt"
msgstr "어, 그래? 프레이아의 미소,\\n사진으로라도 한번 보고 싶다~"

msgid "message_0112_txt"
msgstr "뭐, 무슨 말 하는 거예요 하야테!\\n민메이 씨 앞에서 「이상하다」 같은 말 하지 마요!!"

msgid "message_0113_txt"
msgstr "이봐, 셰릴! 네 노래 꽤 뜨겁잖아.\\n봄버!"

msgid "message_0114_txt"
msgstr "어머, 그 넥키 바사라에게 칭찬받다니\\n영광이네."

msgid "message_0115_txt"
msgstr "그런데, 조금 신경 쓰이는 게 있는데."

msgid "message_0116_txt"
msgstr "뭔데?"

msgid "message_0117_txt"
msgstr "너, 노래하기 전에 자주\\n「내 노래를 들어!」\\n라고 말한다던데."

msgid "message_0118_txt"
msgstr "그게 뭔가 누군가와\\n닮은 것 같아서 말이야…"

msgid "message_0119_txt"
msgstr "아아, 그건 말이지. 위대한 보컬리스트에 대한\\n존경의 표현이야."

msgid "message_0120_txt"
msgstr "뭐라고!? 위대한 보컬리스트라니,\\n설마 설마\\n바사라 말이야!?"

msgid "message_0121_txt"
msgstr "나는 노래를 좋아해. 이 세상에는\\n노래로 바꿀 수 있는 것들이 많다고\\n믿고 있어."

msgid "message_0122_txt"
msgstr "그렇기에 Fire Bomber… 특히\\n보컬리스트 넥키 바사라에게는\\n최대한의 존경을 가지고 있어."

msgid "message_0123_txt"
msgstr "헤헤, 그거 고맙구만.\\n네 시대에서 우리가 어떻게\\n되어 있는지는 모르겠지만,"

msgid "message_0124_txt"
msgstr "적어도 지금처럼 계속 앞으로\\n나아가고 싶다는 생각은 들었어."

msgid "message_0125_txt"
msgstr "하지만 그게 전부는 아니야. 이 대사에는\\n또 하나의 의미가 있어."

msgid "message_0126_txt"
msgstr "또 하나의 의미?"

msgid "message_0127_txt"
msgstr "언젠가 이 대사를\\n내 것으로 만들겠다는 마음이야."

msgid "message_0128_txt"
msgstr "뭐야, 이 나를 뛰어넘겠다는 거야?\\n재미있는데! 네 그런 배고픈 마음가짐,\\n싫지 않다고!"

msgid "message_0129_txt"
msgstr "존경하는 사람을 뛰어넘지 못한다면,\\n내 노래가 무언가를 바꾸는 건\\n불가능하니까."

msgid "message_0130_txt"
msgstr "그렇다면 나는 영원히 불릴 명곡을\\n만들어 줄 뿐이다!\\n우오오, 불타오르는데!!"

msgid "message_0131_txt"
msgstr "밀레느 짱, 지금 괜찮아요?"

msgid "message_0132_txt"
msgstr "뭐야, 란카?"

msgid "message_0133_txt"
msgstr "혹시 괜찮다면… 말인데…"

msgid "message_0134_txt"
msgstr "응."

msgid "message_0135_txt"
msgstr "저기…. 밀레느 짱의 사인,\\n한 장 부탁해도 될까요!?"

msgid "message_0136_txt"
msgstr "어, 사인? 내 거? 괜찮긴 한데,\\n왜 내 사인을 갖고 싶은 거야?"

msgid "message_0137_txt"
msgstr "사실은 오빠가\\nFire Bomber의 열성 팬이라서요."

msgid "message_0138_txt"
msgstr "아, 그렇구나! 그러면…\\n우리들, 미래에서도 잘하고 있는 거구나.\\n기쁘다!"

msgid "message_0139_txt"
msgstr "잘하고 있는 정도가 아니라,\\n은하 전체에 팬이 있고 모르는 사람이\\n더 적을 정도예요!"

msgid "message_0140_txt"
msgstr "거짓말!? 믿기 어렵지만… 란카가\\n말한다면 진짜겠지!\\n우리도 꽤 대단하잖아!"

msgid "message_0141_txt"
msgstr "오빠는 작전명에도\\nFire Bomber의 곡 제목을\\n사용하고 있어요!"

msgid "message_0142_txt"
msgstr "그게 더 힘이 난다고 해서요."

msgid "message_0143_txt"
msgstr "기쁘다~ 그렇다면 다른 멤버들의\\n사인도 같이 받아와 줄게.\\n오빠, 분명 기뻐하겠지?"

msgid "message_0144_txt"
msgstr "정말!? 오빠, 너무 기뻐서\\n기절할지도 몰라…!"

msgid "message_0145_txt"
msgstr "고마워요! 밀레느 짱!"

msgid "message_0146_txt"
msgstr "다들 노래하고 있을 때 습격해 오는 녀석들,"

msgid "message_0147_txt"
msgstr "저 녀석들은\\n멸망의 노래 때문에 제정신을 잃은 거지?"

msgid "message_0148_txt"
msgstr "맞아."

msgid "message_0149_txt"
msgstr "그리고 그들은 더 강한 생체 폴드파의\\n발생원을 향해 다가오고 있어."

msgid "message_0150_txt"
