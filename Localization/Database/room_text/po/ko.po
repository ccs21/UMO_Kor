msgstr "어때? 정말 멋지고\\n완벽한 휴일이라고 생각하지 않아?"

msgid "message_1641_txt"
msgstr "네가 즐거워 보여서 다행이다"

msgid "message_1642_txt"
msgstr "모처럼 받은 휴일인걸.\\n마음껏 즐겨야지!"

msgid "message_1643_txt"
msgstr "그러니까 알토도\\n저녁 식사에 함께 가"

msgid "message_1644_txt"
msgstr "뭐?"

msgid "message_1645_txt"
msgstr "란카 짱과 나중에 데리러 갈게!"

msgid "message_1646_txt"
msgstr "어이! 멋대로 정하지 마!"

msgid "message_1647_txt"
msgstr "…정말이지"

msgid "message_1648_txt"
msgstr "저기, 프레이야 짱!\\n잠깐 괜찮아?"

msgid "message_1649_txt"
msgstr "민메이 씨!\\n무슨 일이신가요?"

msgid "message_1650_txt"
msgstr "지금부터 놀러 가지 않을래?"

msgid "message_1651_txt"
msgstr "다음 일이 있기 전까지\\n조금 시간이 생겼거든"

msgid "message_1652_txt"
msgstr "오~!!"

msgid "message_1653_txt"
msgstr "물론이에요!"

msgid "message_1654_txt"
msgstr "다행이다~!"

msgid "message_1655_txt"
msgstr "최근 마크로스 시티에 생긴\\n새로운 카페에 가보고 싶다고\\n생각했거든"

msgid "message_1656_txt"
msgstr "카페, 갈 수 있는 건가요!?"

msgid "message_1657_txt"
msgstr "마크로스 시티에는 모르는 게\\n많아서 룬룬한 기분이 들어!"

msgid "message_1658_txt"
msgstr "그렇게 말해주니 기뻐!"

msgid "message_1659_txt"
msgstr "아, 맞다"

msgid "message_1660_txt"
msgstr "히카루 일행에게는 말하지 않고 갈 생각이니까\\n프레이야 짱도 비밀로 해줄래?"

msgid "message_1661_txt"
msgstr "아, 네! 그런데… 괜찮은 건가요!?"

msgid "message_1662_txt"
msgstr "물론이지! 가끔은\\n이런 자극도 필요한 법이야"

msgid "message_1663_txt"
msgstr "저, 저기요!"

msgid "message_1664_txt"
msgstr "알토, 하야테.\\n상담하고 싶은 게 있는데…"

msgid "message_1665_txt"
msgstr "무슨 일인데?"

msgid "message_1666_txt"
msgstr "상담?"

msgid "message_1667_txt"
msgstr "아니, 그게… 민메이를\\n화나게 한 것 같은데"

msgid "message_1668_txt"
msgstr "무엇 때문에 화난 건지\\n나는 모르겠어"

msgid "message_1669_txt"
msgstr "그런 건 민메이 본인에게\\n이유를 물어봐야 하는 거 아냐"

msgid "message_1670_txt"
msgstr "그게 물어볼 분위기가 아니야"

msgid "message_1671_txt"
msgstr "뭔가 짚이는 건 없어?"

msgid "message_1672_txt"
msgstr "민메이가 아껴두던\\n디저트를 먹어버렸다든가"

msgid "message_1673_txt"
msgstr "그건 아닌 것 같은데…"

msgid "message_1674_txt"
msgstr "…다만 민메이와 만나기로 한 약속을\\n깜빡하고 말았지만"

msgid "message_1675_txt"
msgstr "분명 그거잖아"

msgid "message_1676_txt"
msgstr "역시 그런가?"

msgid "message_1677_txt"
msgstr "그건 솔직하게\\n사과하는 수밖에 없을 것 같네"

msgid "message_1678_txt"
msgstr "그렇겠지"

msgid "message_1679_txt"
msgstr "…용서해 줄까, 민메이"

msgid "message_1680_txt"
msgstr "후레후레의 노래, 요즘 점점\\n더 좋아지고 있지~(*ﾟωﾟ*)"

msgid "message_1681_txt"
msgstr "뭐랄까,\\n실전 속에서 강해지고 있는…그런 느낌?"

msgid "message_1682_txt"
msgstr "프레이야가 노래할 때마다\\n가슴이 찌릿찌릿, 기분 좋아"

msgid "message_1683_txt"
msgstr "에헤헤~"

msgid "message_1684_txt"
msgstr "칭찬받으면,\\n왠지 부끄럽네(*ﾉﾉ*)"

msgid "message_1685_txt"
msgstr "아직 과제는 많지만 말이야"

msgid "message_1686_txt"
msgstr "후레후레의 과제?\\n…그게 뭘까?(@_@)"

msgid "message_1687_txt"
msgstr "내가 보기에는 프레이야는 지구력이 부족해"

msgid "message_1688_txt"
msgstr "확실히 프레이야는 노래하는 시간이 길어질수록\\n폴드 리셉터 수치가\\n불안정해지는 경향이 있어"

msgid "message_1689_txt"
msgstr "으에에…\\n역시 체력 문제일까요? 지치면\\n목소리가 잘 안 나오는 것 같기도 하고…"

msgid "message_1690_txt"
msgstr "알고 있었구나\\n그렇다면 이야기는 간단해, 맞서기만 하면 돼"

msgid "message_1691_txt"
msgstr "프레이야,\\n우리 발키리는 전술 음악 유닛이야"

msgid "message_1692_txt"
msgstr "우리가 전장에서 1초라도 더 오래 노래할 수 있다면,\\n그만큼 더 많은 사람을 구할 수 있어"

msgid "message_1693_txt"
msgstr "그걸 잊지 마"

msgid "message_1694_txt"
msgstr "…네!\\n저, 열심히 할게요!"

msgid "message_1695_txt"
msgstr "좋아! 그럼 내일부터\\n매일 아이테르 갑판을 100바퀴!"

msgid "message_1696_txt"
msgstr "<size=30>오오ー!</size>"

msgid "message_1697_txt"
msgstr "…어, 어어!?"

msgid "message_1698_txt"
msgstr "아니, 해내겠습니데이!\\n<size=30>윈더미어의 혼～～～!</size>"

msgid "message_1699_txt"
msgstr "아~ 적과 싸우는 건 힘들지만,\\n여러 여자아이들의 노래를\\n마음껏 들을 수 있다는 것도 행운이지"

msgid "message_1700_txt"
msgstr "행운이라고?"

msgid "message_1701_txt"
msgstr "그렇잖아?"

msgid "message_1702_txt"
msgstr "미쿠모와 셰릴의 어른스러운 노랫소리도"

msgid "message_1703_txt"
msgstr "란카 짱과 프레이야 짱의,\\n조금 풋풋함이 남은 노랫소리!"

msgid "message_1704_txt"
msgstr "마키나 짱의 그 귀여운 목소리도 좋아!"

msgid "message_1705_txt"
msgstr "카나메와 레이나 짱의\\n쿨한 노랫소리도 빼놓을 수 없고,"

msgid "message_1706_txt"
msgstr "민메이 짱과 밀레느 짱의\\n신비롭고 달콤한 노랫소리…"

msgid "message_1707_txt"
msgstr "음악에 둘러싸이는 행복이라는 걸 느끼고 있어"

msgid "message_1708_txt"
msgstr "아니, 틀렸어"

msgid "message_1709_txt"
msgstr "바사라…?"

msgid "message_1710_txt"
msgstr "틀린 건가?"

msgid "message_1711_txt"
msgstr "미셸,\\n네가 말하는 그건 음악의 행복이 아니야"

msgid "message_1712_txt"
msgstr "보컬의 차이를\\n분석하면서 고개를 끄덕이고 있을 뿐이라면"

msgid "message_1713_txt"
msgstr "사운드에 몸을 맡길 수 없어"

msgid "message_1714_txt"
msgstr "내가 너에게 진정한 음악을 가르쳐 주지"

msgid "message_1715_txt"
msgstr "우선은…내일 아침부터다!"

msgid "message_1716_txt"
msgstr "아침?!"

msgid "message_1717_txt"
msgstr "매일 아침, 내 노래로 네 마음의\\n스위치를 켜주겠어!"

msgid "message_1718_txt"
msgstr "시공을 넘어, 전설의 가희들이 한자리에 모이다니…"

msgid "message_1719_txt"
msgstr "이 상황, 엄청나지 않냐"

msgid "message_1720_txt"
msgstr "그러게\\n전투에 정신이 팔려서 자꾸 잊고 있었지만…"

msgid "message_1721_txt"
msgstr "이렇게 여러 사람의 노래를 가까이서 들어보면 말이야,\\n누구의 노래를 제일 좋아할까…같은 걸\\n나도 모르게 생각하게 된다니까"

msgid "message_1722_txt"
msgstr "얼마 전에도 미하엘 브란이\\n비슷한 말을 했었다"

msgid "message_1723_txt"
msgstr "그만큼 모두가 신경 쓰고 있다는 거지"

msgid "message_1724_txt"
msgstr "미라쥬는 어때?\\n누구의 노래가 마음에 든다든가, 있잖아?"

msgid "message_1725_txt"
msgstr "그렇네요…"

msgid "message_1726_txt"
msgstr "역시 밀레느 숙모님의 노랫소리에는\\n저도 모르게 귀를 기울이게 됩니다"

msgid "message_1727_txt"
msgstr "아무래도 친이모가\\n자신보다 어린 모습으로 노래하고 있으니까 말이지"

msgid "message_1728_txt"
msgstr "가족이라서…라는 점을 떠나서,\\n마음이 끌립니다"

msgid "message_1729_txt"
msgstr "숙모님의 노랫소리에는\\n사람의 마음을 움직이는 힘이 있다고 생각합니다"

msgid "message_1730_txt"
msgstr "그렇군, 그렇군"

msgid "message_1731_txt"
msgstr "메서에게는 어때?\\n역시 너는 발키리파인가?"

msgid "message_1732_txt"
msgstr "노래에 우열을 매기는 취미는 없다\\n시시한 질문이군"

msgid "message_1733_txt"
msgstr "아, 발키리 이야기가 나와서 말인데요"

msgid "message_1734_txt"
msgstr "이번 신곡은 카나메 씨가\\n메인 보컬을 맡는 것 같네요"

msgid "message_1735_txt"
msgstr "진짜? 좋네~"

msgid "message_1736_txt"
msgstr "나, 카나메 씨의\\n곧은 노랫소리도 좋아하거든~"

msgid "message_1737_txt"
msgstr "신곡인가…\\n그렇다면 당장이라도 포메이션\\n훈련이 필요하겠군"

msgid "message_1738_txt"
msgstr "아, 그렇다면 이미 아라드 대장님이\\n내일 이후 일정은…"

msgid "message_1739_txt"
msgstr "아니, 그전까지 간단하게라도\\n이미지를 만들어 두고 싶다"

msgid "message_1740_txt"
msgstr "지금 바로 음원을 받아오겠다"

msgid "message_1741_txt"
msgstr "발키리의 노래는 신비한 매력이 있죠\\n미래적이라고 해야 할까요? 그런 느낌이에요"

msgid "message_1742_txt"
msgstr "뭐, 실제로 우리보다 미래에 살고 있는 아이들이\\n부르는 노래니까 말이지"

msgid "message_1743_txt"
msgstr "그렇긴 하지만요"

msgid "message_1744_txt"
msgstr "하지만 단순히 새롭다는 것뿐만 아니라…\\n뭐랄까"

msgid "message_1745_txt"
msgstr "알겠어\\n새로운데도 어딘가 우리 시대와도\\n통하는 부분이 있어"

msgid "message_1746_txt"
msgstr "그런 점도 매력인 거지"

msgid "message_1747_txt"
msgstr "선배, 의외로 제대로 노래를 듣고 있었네요\\n뭔가 의외인데요"

msgid "message_1748_txt"
msgstr "바보야!\\n상관에게 말하는 태도가 그게 뭐냐, 너는"

msgid "message_1749_txt"
msgstr "아니, 어차피 선배라면\\n발키리 중 누가 제일 취향인지…같은 것만\\n생각하고 있을 줄 알았거든요"

msgid "message_1750_txt"
msgstr "너 말이야, 도대체 날 어떻게 생각하는 거냐?"

msgid "message_1751_txt"
msgstr "시공을 넘어 세계에 위기가 닥친 상황에서\\n그런 생각이나 하고 있을 리가 없잖아!"

msgid "message_1752_txt"
msgstr "그런가요?\\n뭔가 선배답지 않은데,\\n조금 다시 보게 됐어요!"

msgid "message_1753_txt"
msgstr "아, 히카히카와 포커 씨가 있다~!"

msgid "message_1754_txt"
msgstr "꽤 긴 로그가 남아 있는데,\\n무슨 이야기 중이야~?+.(･∀･).+"

msgid "message_1755_txt"
msgstr "오오 마키나 짱!"

msgid "message_1756_txt"
msgstr "아니 아니, 히카루와의 이야기는 완전 상관없으니까\\n신경 쓰지 마, 신경 쓰지 마!"

msgid "message_1757_txt"
msgstr "그보다 나랑 둘이서 이야기하지 않을래?\\n둘만 편하게 말이야"

msgid "message_1758_txt"
msgstr "뭐…"

msgid "message_1759_txt"
msgstr "아아, 역시 선배는 선배네요!\\n다시 봤다고 생각한 게 손해였어요!"

msgid "message_1760_txt"
msgstr "바보야! 지금은 작전 중이 아니니까 괜찮잖아!\\n이런 식으로 구분이 없으면\\n인생이 재미없다고!"

msgid "message_1761_txt"
msgstr "모두가 내 곡을 부르는 걸 들어버렸어"

msgid "message_1762_txt"
msgstr "에…!!"

msgid "message_1763_txt"
msgstr "저, 어떻게 들으셨어요?!"

msgid "message_1764_txt"
msgstr "왠지 안심했어"

msgid "message_1765_txt"
msgstr "안심…이요?"

msgid "message_1766_txt"
msgstr "노래는 부르는 사람에 따라\\n해석이 달라진다고 하잖아?"

msgid "message_1767_txt"
msgstr "미래의 사람들이 부르는 내 노래는,\\n전혀 이해할 수 없는 것이 되어 있을 거라고 생각했어"

msgid "message_1768_txt"
msgstr "하지만 그렇지 않았어"

msgid "message_1769_txt"
msgstr "시대가 바뀌고,\\n은하에 사는 사람들의 가치관이 변해도"

msgid "message_1770_txt"
msgstr "변하지 않는 것도 있구나"

msgid "message_1771_txt"
msgstr "맥스 씨의 전투 데이터, 굉장하네요…\\n뭐랄까, 움직임이 너무 기발해서\\n노림수를 전혀 읽을 수 없습니다"

msgid "message_1772_txt"
msgstr "기발하다라\\n감각으로 조종해 버리는 경우가 있어서 그런가?"

msgid "message_1773_txt"
msgstr "특히 주목할 점은\\n배틀로이드 변형 운용의 다양성입니다!"

msgid "message_1774_txt"
msgstr "모범답안 같은 정확한 기동은 물론이고,\\n허를 찌르는 변형 후의 일격…"

msgid "message_1775_txt"
msgstr "전술 연구가 발전한 우리 시대에도,\\n이 정도 기술을 가진 사람은 좀처럼 없습니다!"

msgid "message_1776_txt"
msgstr "음ー, 아무래도 나는 천재인 모양이라서 말이지\\n스스로는 그다지 의식해 본 적은\\n없지만"

msgid "message_1777_txt"
msgstr "그 말투!\\n좋아, 소문대로 재미있는 사람인 것 같군"

msgid "message_1778_txt"
msgstr "언젠가 내 저격과 어느 쪽이 위인지,\\n승부해 보지 않겠습니까?"

msgid "message_1779_txt"
msgstr "미셸 군의 전적은\\n이쪽에서도 화제가 되고 있어"

msgid "message_1780_txt"
msgstr "좋은 승부가 될 것 같군"

msgid "message_1781_txt"
msgstr "전설의 천재 파일럿과\\n미셸 선배의 일대일 승부?!"

msgid "message_1782_txt"
msgstr "도대체 어떤 대결이 될까…"

msgid "message_1783_txt"
msgstr "그러니까 말인데, 루카,\\n빨리 네 집 회사에서\\n시공을 뛰어넘을 수 있는 장치를 개발해 줘"

msgid "message_1784_txt"
msgstr "나도 꼭 부탁하고 싶군"

msgid "message_1785_txt"
msgstr "미쿠모 씨, 미쿠모 씨!"

msgid "message_1786_txt"
msgstr "무슨 일이야?"

msgid "message_1787_txt"
msgstr "저기, 어제 네이키드 걸 냥냥에서 먹은\\n해파리 요리 신메뉴가\\n진짜 맛있었어요!"

msgid "message_1788_txt"
msgstr "미쿠모 씨도 다음에 같이 어떠세요?!"

msgid "message_1789_txt"
msgstr "사양할게"

msgid "message_1790_txt"
msgstr "그, 그렇군요…"

msgid "message_1791_txt"
msgstr "아, 그럼…\\n브레라 씨!"

msgid "message_1792_txt"
msgstr "뭐지"

msgid "message_1793_txt"
msgstr "저기,\\n사실 지금 란카 씨의 노래를 연습하고 있는데요,"

msgid "message_1794_txt"
msgstr "다음에 브레라 씨에게 들어봐 주시고,\\n감상 같은 것도 들을 수 있으면 해서요…!"

msgid "message_1795_txt"
msgstr "왜 나지?\\n다른 사람에게 부탁해라"

msgid "message_1796_txt"
msgstr "아, 네…\\n죄송합니다…"

msgid "message_1797_txt"
msgstr "으, 으으～～～～\\n두 분 다 윈더미어의 눈보다도\\n차가워요…"

msgid "message_1798_txt"
msgstr "지면 안 돼!\\n기죽으면 안 된다구!!ヽ(≧Д≦)ノ"

msgid "message_1799_txt"
msgstr "그러고 보니 전부터 생각했던 건데"

msgid "message_1800_txt"
msgstr ""

msgid "message_1801_txt"
msgstr "하야테는 발키리로 춤추는 게 특기잖아?"

msgid "message_1802_txt"
msgstr "뭐, 그렇지"

msgid "message_1803_txt"
msgstr "그리고 바사라는 발키리에 타면서\\n노래하는 게 특기잖아?"

msgid "message_1804_txt"
msgstr "특기라기보다는,\\n나는 어디에 있든 노래할 뿐이지만"

msgid "message_1805_txt"
msgstr "그럼 말이야,\\n만약 그 두 사람이 함께하게 된다면…"

msgid "message_1806_txt"
msgstr "이건 확실히,\\n발키리만으로 노래하고 춤추는 라이브를\\n열 수 있다는 거잖아?!"

msgid "message_1807_txt"
msgstr "오오, 확실히!"

msgid "message_1808_txt"
msgstr "발키리 라이브라, 좋잖아!"

msgid "message_1809_txt"
msgstr "우리 Fire Bomber가,\\n발키리에 타면서 노래하고 연주하는 거야!"

msgid "message_1810_txt"
msgstr "그리고 하야테가,\\n발키리를 타고 뜨거운 춤을 추는 거지!\\n최고로 달아오르는 장면이 떠오른다고!"

msgid "message_1811_txt"
msgstr "하늘만 있으면 어디든 공연장이 되는 거잖아…\\n좋네, 두근거리기 시작하는데!"

msgid "message_1812_txt"
msgstr "그렇지!?"

msgid "message_1813_txt"
msgstr "그렇게 큰 라이브를 성공시키면,\\n관객은 계속해서 몰려들 게 틀림없어!"

msgid "message_1814_txt"
msgstr "거기에 우리가 네이키드 걸 냥냥 매점을 열어서\\n돈까지 벌면…모두가 행복해질 거야!!"

msgid "message_1815_txt"
msgstr "라고, 그게 본심이었냐?!"

msgid "message_1816_txt"
msgstr "부하를 돌보는 것도 쉬운 일이 아니군…"

msgid "message_1817_txt"
msgstr "그 마음, 뼈저리게 이해합니다"

msgid "message_1818_txt"
msgstr "동감입니다"

msgid "message_1819_txt"
msgstr "그 녀석들은 말이지, 상관이 전장에서\\n얼마나 긴장하고 있는지도 모르면서 무리만 하고…"

msgid "message_1820_txt"
msgstr "맞아!"

msgid "message_1821_txt"
msgstr "선배는 여자 문제라든가,\\n시시한 장난만 걸어온다고"

msgid "message_1822_txt"
msgstr "존경받고 있다는 증거입니다"

msgid "message_1823_txt"
msgstr "팽팽하게 긴장된 전장에서는,\\n농담을 던지는 부하가\\n구원이 되는 경우도 많지 않습니까?"

msgid "message_1824_txt"
msgstr "그렇다고 해도,\\n잡아야 할 부분은 확실히 잡아야겠지요"

msgid "message_1825_txt"
msgstr "상관을 얕보는 사람은 전장에서 오래 살아남지 못합니다"

msgid "message_1826_txt"
msgstr "…부하를 살리고 죽이는 것도 결국 자신의 언행에 달린 것"

msgid "message_1827_txt"
msgstr "적절한 거리를 유지하면서, 신뢰 관계도 쌓아가며…\\n꽤 어려운 일이군"

msgid "message_1828_txt"
msgstr "그 점에서는 여기 있는 세 사람은 입장이 같으니\\n부담 없이 이야기할 수 있다는 건\\n고마운 일이 아닐까요?"

msgid "message_1829_txt"
msgstr "언젠가 실제로 만날 날이 온다면\\n셋이서 천천히 이런 이야기를 나누고 싶군"

msgid "message_1830_txt"
msgstr "찬성입니다"

msgid "message_1831_txt"
msgstr "당신들은 든든한 동료다\\n전투가 끝난 뒤에도 부디 좋은 친구로서\\n계속 지내고 싶군"

msgid "message_1832_txt"
msgstr "그렇다면 그때는 최고의\\n라그나 명물을 가져가도록 하죠"

msgid "message_1833_txt"
msgstr "우정의 증표로,\\n현지에서도 좀처럼 구하기 힘든 최고급품을 말입니다"

msgid "message_1834_txt"
msgstr "좋은데"

msgid "message_1835_txt"
msgstr "맛있는 걸 먹으면서\\n귀여운 여동생 이야기도\\n이것저것 들려줘, 오즈마"

msgid "message_1836_txt"
msgstr "?!\\n라, 란카 이야기는 안 돼!"

msgid "message_1837_txt"
msgstr "하하하\\n즐거운 자리가 될 것 같군요"

msgid "message_1838_txt"
msgstr "밀리아, 잠깐 물어봐도 될까~?"

msgid "message_1839_txt"
msgstr "밀리아는 지구 태생이 아니지?"

msgid "message_1840_txt"
msgstr "옷 디자인이라든지, 어떤 패션이\\n유행했는지라든지~ 궁금해서 말이야♪"

msgid "message_1841_txt"
msgstr "패션…이라는 건 잘 모르겠다\\n내 종족은 전투만을 알아왔으니까\\n스펙 비교를 한 적은 있지만…"

msgid "message_1842_txt"
msgstr "?!Σ(ﾟДﾟ;;)\\n옷의 스펙?!\\n움직이기 편한지 같은 건가?!"

msgid "message_1843_txt"
msgstr "그래\\n그래서 디자인이 어떻다 하는 이야기는\\n아직도 이해하기 어렵다"

msgid "message_1844_txt"
msgstr "안 돼, 그러면!"

msgid "message_1845_txt"
msgstr "뭐, 뭐가?\\n뭐가 안 된다는 거지?"

msgid "message_1846_txt"
msgstr "여자가 자신을 꾸미는 방법도 모른다니…\\n그런 건 종족이 어떻든 상관없어!"

msgid "message_1847_txt"
msgstr "그렇지~!\\n특히 밀리아는 정말 예쁘고\\n귀엽잖아!"

msgid "message_1848_txt"
msgstr "패션의 즐거움,\\n모른다면 꼭 알아줬으면 해!!(>ω<)"

msgid "message_1849_txt"
msgstr "예쁘다, 귀엽다…내가?"

msgid "message_1850_txt"
msgstr "예전에,\\n맥스에게도 같은 말을 들은 적이 있지만…"

msgid "message_1851_txt"
msgstr "전투가 끝나고 언젠가 만날 날이 오면\\n셋이서 쇼핑하러 가자!"

msgid "message_1852_txt"
msgstr "물론이지!\\n이 내가 밀리아의 매력을 끌어내 줄게"

msgid "message_1853_txt"
msgstr "쇼핑이라…\\n그래, 나쁘지 않을 것 같군"

msgid "message_1854_txt"
msgstr "무조건, 절대~로 약속이야(*'ω'*)"

msgid "message_1855_txt"
msgstr "바사라 씨. 잠깐 상담해도 될까요?"

msgid "message_1856_txt"
msgstr "응? 뭔데?"

msgid "message_1857_txt"
msgstr "그게…어떻게 하면 바사라 씨처럼,\\n마음이 담긴 노래를 부를 수\\n있을까요!?"

msgid "message_1858_txt"
msgstr "어렵게 생각할 것 없어. 그냥 솔직하게,\\n마음 가는 대로 노래하면 돼"

msgid "message_1859_txt"
msgstr "으ーーー음(>_<)"

msgid "message_1860_txt"
msgstr "전력을 다하고 있다고 생각하는데,\\n바사라 씨처럼 뻗어나가려면 아직\\n부족한 게 있는 것 같아서…"

msgid "message_1861_txt"
msgstr "뻗어나간다라…"

msgid "message_1862_txt"
msgstr "그럼. 프레이야, 이제부터 노래하기 전에\\n필살 대사를 말해봐!"

msgid "message_1863_txt"
msgstr "필살 대사?"

msgid "message_1864_txt"
msgstr "말하고 나면 이렇게 배 속 깊은 곳까지 울리는\\n말이 있잖아? 노래하기 전에 그걸 외치는 거야!"

msgid "message_1865_txt"
msgstr "그러면 자연스럽게 마음도 실리게 돼"

msgid "message_1866_txt"
msgstr "그렇군요!"

msgid "message_1867_txt"
msgstr "감사합니데이!\\n바로 다음부터 시험해 볼게요!"

msgid "message_1868_txt"
msgstr "어때. 할 말은 정했냐?"

msgid "message_1869_txt"
msgstr "좋아, 그럼 지금 여기서 연습이다!"

msgid "message_1870_txt"
msgstr "내 노래를 들어라!"

msgid "message_1871_txt"
msgstr "준비됐나!"

msgid "message_1872_txt"
msgstr "더 크게다!\\n내 노래를 들어라아아아!!!"

msgid "message_1873_txt"
msgstr "네!\\n준비됐나아아아!!!!"

msgid "message_1874_txt"
msgstr "너희들 시끄럽다!"

msgid "message_1875_txt"
msgstr "저기, 발키리가 사용하는\\n특수 화장품이 갖고 싶은데.\\n그거 독자 생산품이야?"

msgid "message_1876_txt"
msgstr "어, 어떻게 그걸? 그 정보,\\n케이오스 사원 전용 프로그램에서만\\n접속할 수 있는데"

msgid "message_1877_txt"
msgstr "입수 경로는 비밀로 해둘게"

msgid "message_1878_txt"
msgstr "특히 충격 흡수용 젤과 립글로스가\\n궁금해"

msgid "message_1879_txt"
msgstr "고열에서 녹아 퍼지는 특성을 활용하면,\\n새로운 콘서트 연출에 사용할 수 있을 것\\n같지 않아?"

msgid "message_1880_txt"
msgstr "연출에요!\\n피해 흡수라는 관점에서 개발된 것이라\\n그런 발상까지는 전혀 하지 못했습니다"

msgid "message_1881_txt"
msgstr "발상의 전환이라는 거지. 반대로,\\n너희 무대 의상이 홀로그램인 것도 전략상의\\n이유 때문이지?"

msgid "message_1882_txt"
msgstr "네. 의상 교체라는 무방비한 순간을\\n노리지 못하게 하기 위해서입니다"

msgid "message_1883_txt"
msgstr "…이렇게 생각해 보면 서로의 무대 연출이나\\n의상에 대해서 조금 더 의견을 교환해\\n봐도 좋을지도 모르겠네요"

msgid "message_1884_txt"
msgstr "우리가 장비로만 보고 있는 것도,\\n셰릴 씨와 여러분의 발상을 빌리면\\n새로운 연출 방법이 될 수 있을 테고요"

msgid "message_1885_txt"
msgstr "반대로 내가 연출 장치로만 보고 있던\\n것이 너희를 지키는 새로운 장비를\\n만드는 계기가 될 수도 있다는 거네"

msgid "message_1886_txt"
msgstr "좋지 않아? 나도 콘서트에서는\\n항상 새로운 걸 해보고 싶으니까"

msgid "message_1887_txt"
msgstr "우선 우리가 사용하고 있는 화장품이\\n그쪽 시대에서 재현 가능한지 확인해 보겠습니다"

msgid "message_1888_txt"
msgstr "고마워. 만약 이 시대에서\\n특수 화장품을 이용한 연출에 성공한다면,\\n정보는 제대로 공유할게"

msgid "message_1889_txt"
msgstr "이거…혹시 우주 역사상 최초,\\n과거와 미래가 공동으로 만드는 무대 연출\\n기획 아닌가요…?"

msgid "message_1890_txt"
msgstr "그래.\\n모처럼 시공간 폴드 통신이\\n있으니까"

msgid "message_1891_txt"
msgstr "전투 데이터나 전자 기술뿐만 아니라,\\n엔터테인먼트 교류도\\n해나가자!"

msgid "message_1892_txt"
msgstr "좋겠다~ 좋겠다~"

msgid "message_1893_txt"
msgstr "발키리 여러분의 의상이야!"

msgid "message_1894_txt"
msgstr "부러워어어어!\\n나도 너희처럼\\n귀엽고 멋진 의상을 입어보고 싶어!"

msgid "message_1895_txt"
msgstr "발키리 의상을 입은 밀레밀레!?\\n그거 엄청 귀여울 것 같은\\n예감이야!(*'▽'*)"

msgid "message_1896_txt"
msgstr "빌려주고 싶기는 한데~.\\n시공간 물질 전송은 아직\\n잘 안 되는 것 같아~(ﾉ_;)"

msgid "message_1897_txt"
msgstr "아, 맞다! 우리 의상 데이터라면\\n보내줄 수 있을지도 몰라!"

msgid "message_1898_txt"
msgstr "그렇구나, 데이터만 있으면 홀로그램으로\\n재현한다는 거야!?\\n신난다! 마키나 역시 천재야~!"

msgid "message_1899_txt"
msgstr "지금 바로 보낼 수 있는 건 내 의상 데이터일 것 같아.\\n데이터는 마음대로 어레인지해도\\n괜찮으니까~(っ*´∀｀*)っ"

msgid "message_1900_txt"
msgstr "고마워, 마키나! 으음, 어떤 의상으로\\n해달라고 할지 고민되네"

msgid "message_1901_txt"
msgstr "아쉽지만, 그 작전에는 한 가지 문제가 있어"

msgid "message_1902_txt"
msgstr "문제점??(ﾟωﾟ)"

msgid "message_1903_txt"
msgstr "마키나와 밀레느의 신체 수치에는\\n가슴 부분에 큰 차이가 있어"

msgid "message_1904_txt"
msgstr "뭐야, 그 정도야! 홀로그램이잖아,\\n데이터를 조금만 만져서 맞추면\\n문제(ヾﾉ･∀･`)없어 없어"

msgid "message_1905_txt"
msgstr "마, 마키나…그건 그것대로,\\n뭔가 복잡한 기분이야…"

msgid "message_1906_txt"
msgstr "시공간 폴드 통신을 이용하다가, 우연히"

msgid "message_1907_txt"
msgstr "정말 정말 우연히,\\n브레라의 전뇌 단자에 접속해 버렸다"

msgid "message_1908_txt"
msgstr "브레라의 적나라한 사생활을\\n알아버린 이 흥분.\\n란카에게 전하고 싶다"

msgid "message_1909_txt"
msgstr "브레라 씨의…!?\\n조, 조금 궁금할지도…"

msgid "message_1910_txt"
msgstr "악취미군. 레이나 프라울러"

msgid "message_1911_txt"
msgstr "쳇. 브레라가 로그인하지 않은 걸\\n노리고 말을 걸었는데"

msgid "message_1912_txt"
msgstr "와아아, 죄송해요, 브레라 씨!"

msgid "message_1913_txt"
msgstr "그, 그렇지. 다른 사람에게 들은 정보로\\n브레라 씨의 마음을 알려고 하는 건,\\n그런 건 안 되는 거지…!"

msgid "message_1914_txt"
msgstr "내가 꾸짖은 건 침입에 대한 이야기다.\\n얻은 정보 공개에 대한 게 아니야, 란카"

msgid "message_1915_txt"
msgstr "…화난 게 아니라는 거야?"

msgid "message_1916_txt"
msgstr "화나지는 않았다.\\n침입당한 곳은 내 의식 영역의\\n아주 얕은 층이다"

msgid "message_1917_txt"
msgstr "그다지 흥미로운 것은 아니지만,\\n네가 알고 싶다고 한다면"

msgid "message_1918_txt"
msgstr "저기…그럼, 부, 부탁드릴게요!"

msgid "message_1919_txt"
msgstr "브레라의 머릿속에는 멜로디가 울리고 있었다.\\n달콤하고 포근하며 따뜻한 목소리…"

msgid "message_1920_txt"
msgstr "그건 아마 란카의 노래"

msgid "message_1921_txt"
msgstr "란카의 노래는 제대로 브레라에게 닿고 있어.\\n브레라는 좀 더, 말로 전해야 해"

msgid "message_1922_txt"
msgstr "브레라 씨…"

msgid "message_1923_txt"
msgstr "미쿠모 씨는 정말 미스터리한\\n매력이 있네요"

msgid "message_1924_txt"
msgstr "그렇지.\\n무슨 생각을 하는지 모르겠달까,\\n닿으면 화상을 입을 것 같달까…"

msgid "message_1925_txt"
msgstr "하지만 그게 매력적인 거겠죠.\\n여자인 제가 봐도 멋지다고\\n생각하는걸요"

msgid "message_1926_txt"
msgstr "영광이네"

msgid "message_1927_txt"
msgstr "미쿠모 씨! 죄송해요, 제가 그만.\\n포커 소령님과 둘이서 이야기하고 있는\\n기분이 되어버렸어요"

msgid "message_1928_txt"
msgstr "모두가 보는 곳에서 자기 이야기를 듣는 건\\n싫었어…?"

msgid "message_1929_txt"
msgstr "아니요, 별로.\\n하지만 제가 방해한 건 아닐까요?"

msgid "message_1930_txt"
msgstr "설마! 오히려 이 기회에 식사 약속이라도\\n어때, 미쿠모 짱"

msgid "message_1931_txt"
