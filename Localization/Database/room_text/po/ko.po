msgid "message_11472_txt"
msgstr "저, 절대 아닙니다!\\n저는 결코 그런 생각을…!"

msgid "message_11473_txt"
msgstr "나 봤어"

msgid "message_11474_txt"
msgstr "미라쥬가\\n새 연미복을 기쁜 듯이 바라보고 있던 모습"

msgid "message_11475_txt"
msgstr "미쿠모 씨!? 보고 계셨나요!?"

msgid "message_11476_txt"
msgstr "응. 그렇지, 레이나?"

msgid "message_11477_txt"
msgstr "미쿠모\\n이쪽으로 넘기는 건 위험하다"

msgid "message_11478_txt"
msgstr "레이레이, 쿠모쿠모~?(ﾟωﾟ)"

msgid "message_11479_txt"
msgstr "뜨끔"

msgid "message_11480_txt"
msgstr "최근 두 사람 모두 뭔가 수상한 움직임을\\n보인다고 생각했는데…"

msgid "message_11481_txt"
msgstr "혹시 미라미라를\\n미행하고 있었던 거야?(ﾟωﾟ)"

msgid "message_11482_txt"
msgstr "들켜버렸네, 레이나"

msgid "message_11483_txt"
msgstr "미쿠모, 숨길 생각이 너무 없어…"

msgid "message_11484_txt"
msgstr "안 되는 건가?"

msgid "message_11485_txt"
msgstr "아라드는 미행해도\\n금방 따돌려졌다"

msgid "message_11486_txt"
msgstr "미라쥬는 쉬웠지"

msgid "message_11487_txt"
msgstr "그, 그럴 수가…"

msgid "message_11488_txt"
msgstr "수련이 부족하군, 미라쥬 교관?"

msgid "message_11489_txt"
msgstr ""

msgid "message_11490_txt"
msgstr "정말이지,\\n레이나도 미쿠모도 어쩔 수 없다니까…"

msgid "message_11491_txt"
msgstr "하지만 서프라이즈가 실패하지 않도록\\n모두에게는 제대로 비밀로 했어"

msgid "message_11492_txt"
msgstr "역시 레이레이ーー!!"

msgid "message_11493_txt"
msgstr "마키나, 레이나한테 너무 관대하잖아"

msgid "message_11494_txt"
msgstr "그야 귀여운걸"

msgid "message_11495_txt"
msgstr "뭐, 어쨌든\\n좋은 화이트데이가 돼서 다행이네"

msgid "message_11496_txt"
msgstr "네, 그렇네요!"

msgid "message_11497_txt"
msgstr "마키나!\\n프레이야의 의상을 준비해줘서\\n고마워!"

msgid "message_11498_txt"
msgstr "미안해.\\n갑작스러운 부탁이었는데"

msgid "message_11499_txt"
msgstr "전혀 괜찮아~!\\n지금 한창 디자인 제작 중이야(*´∀｀*)"

msgid "message_11500_txt"
msgstr "마키나 씨!\\n정말 고마워요!"

msgid "message_11501_txt"
msgstr "별말을 다 해!\\n나도 귀여운 의상을 만들 수 있어서\\n기뻐~!"

msgid "message_11502_txt"
msgstr "천사 같은 느낌으로!라고 했으니까\\n그걸 이미지로 해서 진행해볼게ー!"

msgid "message_11503_txt"
msgstr "내 힘으로 프레프레를\\n귀여운( *>ω< *)\\n천사님으로 만들어줄게!"

msgid "message_11504_txt"
msgstr "고마워요ー!\\n。゜゜(>□<｡)°゜。"

msgid "message_11505_txt"
msgstr "천사라…"

msgid "message_11506_txt"
msgstr "왜 그래? 하야테!"

msgid "message_11507_txt"
msgstr "뭐, 프레이야답다면 프레이야답나?"

msgid "message_11508_txt"
msgstr "뭔가 그거랑 비슷하잖아"

msgid "message_11509_txt"
msgstr "있잖아, 그거.\\n뭐라고 하더라?"

msgid "message_11510_txt"
msgstr "교회 같은 데서 자주 보는…\\n아이들이 날개 달고 활을 들고 있는 거"

msgid "message_11511_txt"
msgstr "나는 큐피드가 아니야ー!\\nヽ(#`Д´)ﾉ"

msgid "message_11512_txt"
msgstr "그런 게 아니라니까!\\n나는 좀 더\\n신비로운 천사가 되고 싶은 거야~"

msgid "message_11513_txt"
msgstr "아~… 그런 느낌?"

msgid "message_11514_txt"
msgstr "아차… 그런 거라면\\n의상 디자인을 지금부터\\n다시 구상해야겠는데…!"

msgid "message_11515_txt"
msgstr "혹시\\n큐피드 이미지로\\n디자인하고 제작하고 있었던 거야?"

msgid "message_11516_txt"
msgstr "왜냐하면 왜냐하면, 나도 하야하야와 똑같이…"

msgid "message_11517_txt"
msgstr "프레프레라고 하면\\n천진난만하고 귀여운 큐피드 천사일까?\\n하고 생각했거든!"

msgid "message_11518_txt"
msgstr "거봐? \\n역시 네 이미지가 그렇다니까"

msgid "message_11519_txt"
msgstr "미안해 프레프레, 민민!\\n디자인 다시 짤 테니까\\n조금만 더 시간 줘!"

msgid "message_11520_txt"
msgstr "나는 괜찮아.\\n고마워"

msgid "message_11521_txt"
msgstr "마키나 씨 죄송해요!\\n감사합니다…!"

msgid "message_11522_txt"
msgstr "음, 그래도…"

msgid "message_11523_txt"
msgstr "프레프레는\\n사람의 손이 닿지 않는 듯한\\n신비로운 천사라기보다는"

msgid "message_11524_txt"
msgstr "항상 모두의 주변을 날아다니며\\n힘을 나눠주는 천사라는\\n느낌이지!"

msgid "message_11525_txt"
msgstr "오, 그거다 그거!"

msgid "message_11526_txt"
msgstr "같이 있으면 이유는 잘 모르겠는데\\n힘이 나잖아!"

msgid "message_11527_txt"
msgstr "그, 그런가아…?"

msgid "message_11528_txt"
msgstr "뭐, 하야테 군은\\n여자아이를 솔직하게 칭찬해 주는구나.\\n멋진걸!"

msgid "message_11529_txt"
msgstr "방금 게 칭찬한 게 되는 건가?\\n그냥 생각한 걸 말했을 뿐이라고"

msgid "message_11530_txt"
msgstr "아무튼.\\n역시 그런 이미지가\\n너답지 않겠어?"

msgid "message_11531_txt"
msgstr "음, 음.\\n하지만 그러면 미쿠모 씨가 해준 말이…!"

msgid "message_11532_txt"
msgstr "발버둥 치고 있구나.\\n프레이야"

msgid "message_11533_txt"
msgstr "신비를 추구하려는 그 마음\\n꽤 나쁘지 않아"

msgid "message_11534_txt"
msgstr "하지만… 역시 아직 너에게는\\n너무 이른 일이었을지도 모르겠네"

msgid "message_11535_txt"
msgstr "∑(´□｀；)그, 그럴 수가…!"

msgid "message_11536_txt"
msgstr "있잖아, 미쿠모.\\n프레이야에게 무슨 말을 한 거야?"

msgid "message_11537_txt"
msgstr "그 몸에 더욱\\n신비를 걸치라고 말했어"

msgid "message_11538_txt"
msgstr "신비는 사람을 강하게 끌어당기는 법…"

msgid "message_11539_txt"
msgstr "하지만 필요 없었던 모양이네"

msgid "message_11540_txt"
msgstr "…프레이야"

msgid "message_11541_txt"
msgstr "네!?"

msgid "message_11542_txt"
msgstr "내가 했던 말은 잊어.\\n촬영은 네다운 천사의 모습으로\\n임하도록 해"

msgid "message_11543_txt"
msgstr "슬픔의 색으로 물든 마음조차\\n자유롭게 다시 칠하는 천진난만한 천사…"

msgid "message_11544_txt"
msgstr "그쪽이\\n훨씬 너다운 것 같으니까"

msgid "message_11545_txt"
msgstr "오오ー! ( *>ω< *)\\n좋은 이미지가 떠올랐어ー!"

msgid "message_11546_txt"
msgstr "호왓!? 마키나 씨!?"

msgid "message_11547_txt"
msgstr "다들 이야기해준 덕분에\\n정말 좋은 이미지가 떠올랐어ー!\\n。.:*゜(n´∀｀)n゜*:.。"

msgid "message_11548_txt"
msgstr "프레프레!\\n천사 의상 완성\\n기대하고 있어줘!"

msgid "message_11549_txt"
msgstr "…!\\n네! 기대하고 있을게요!!"

msgid "message_11550_txt"
msgstr "란카, 셰릴!\\n러블리 봄버 라이브 봤어ー!\\n수고했어!"

msgid "message_11551_txt"
msgstr "와아, 밀레느 짱!\\n감사합니다(*´∀｀*)"

msgid "message_11552_txt"
msgstr "밀레느, 라이브에 와 있었어!?"

msgid "message_11553_txt"
msgstr "저기, 바사라 씨와 함께\\n계속 무대 뒤에 있었어요.\\n초시공 유닛 라이브를 이용해서…"

msgid "message_11554_txt"
msgstr "그랬으면 진작 말해줬어야지!"

msgid "message_11555_txt"
msgstr "본인 앞에서 밀레느 같은 모습으로\\n있는다니\\n부끄러운 것도 정도가 있지ー!"

msgid "message_11556_txt"
msgstr "죄송해요 클랑 씨!\\n미셸 군이 입 다물라고 해서…"

msgid "message_11557_txt"
msgstr "미ー셸ー?"

msgid "message_11558_txt"
msgstr "화내지 마 클랑.\\n그 모습을 본인에게 들킨 건\\n나도 마찬가지니까"

msgid "message_11559_txt"
msgstr "그렇지?\\n바사라"

msgid "message_11560_txt"
msgstr "내 흉내라고 하기엔\\n조금 부족하군"

msgid "message_11561_txt"
msgstr "불타는 영혼을 전력으로\\n스테이지에서 보여준다면 인정해 주지"

msgid "message_11562_txt"
msgstr "아니, 그렇게 진지하게 안 해도…"

msgid "message_11563_txt"
msgstr "그러고 보니\\n이번에는 알토가 없었네"

msgid "message_11564_txt"
msgstr "그 이야기는 그만해 줘…"

msgid "message_11565_txt"
msgstr "알토에게도 부탁했는데\\n이번에는 완전히 거절당했어"

msgid "message_11566_txt"
msgstr "뭐가 그렇게 싫은 거야?"

msgid "message_11567_txt"
msgstr "당연하잖아"

msgid "message_11568_txt"
msgstr "학교 신입생들 앞에서\\n그런 모습을 보여준다고 생각해 봐"

msgid "message_11569_txt"
msgstr "졸업할 때까지 몇 년 동안\\n신입생들에게 어떤 눈으로 보일지\\n알 수 없잖아"

msgid "message_11570_txt"
msgstr "뭐, 알토의 정체를 알고\\n실망하는 신입생도 있겠지만"

msgid "message_11571_txt"
msgstr "알토 공주는 힘들겠네.\\n나처럼 잘생긴 남자로\\n태어났으면 좋았을 텐데 말이야"

msgid "message_11572_txt"
msgstr "이 자식…!"

msgid "message_11573_txt"
msgstr "알토 군, 진정해…!"

msgid "message_11574_txt"
msgstr "그러고 보니 미셸의 기타 솔로 때\\n여자아이들의 환호성이 엄청났지…"

msgid "message_11575_txt"
msgstr "흥.\\n꺄아꺄아 하는 것도\\n지금뿐이다"

msgid "message_11576_txt"
msgstr "이 녀석에게\\n품격이라고는 조금도 없다는 걸 깨닫고\\n정신 차릴 게 뻔해!"

msgid "message_11577_txt"
msgstr "뭐야 클랑.\\n질투하는 거야?"

msgid "message_11578_txt"
msgstr "그럴 리가 있겠냐!!"

msgid "message_11579_txt"
msgstr "그나저나\\n이번 라이브 연출은 정말 대단했어ー!"

msgid "message_11580_txt"
msgstr "최신식 홀로그램 영상이라든가\\n수많은 백댄서라든가…"

msgid "message_11581_txt"
msgstr "그 정도로 대규모 준비를 하는 건\\n힘들지 않았어?"

msgid "message_11582_txt"
msgstr "후훗.\\n그게 그렇지도 않아"

msgid "message_11583_txt"
msgstr "이번 라이브 연출은\\n미호시 학원의 재학생들이 전면 협력해 줬어"

msgid "message_11584_txt"
msgstr "란카와 내가\\n많이 비춰지는 홀로그램 영상도\\n전문 학과 학생들이 만들어준 거야"

msgid "message_11585_txt"
msgstr "백댄서도 재학생들에게\\n협력을 받았어!"

msgid "message_11586_txt"
msgstr "다들 직접\\n같이 무대에 서고 싶다고\\n말해줬거든!"

msgid "message_11587_txt"
msgstr "헤에, 그게 전부\\n학원 학생들이었던 거구나!"

msgid "message_11588_txt"
msgstr "홀로그램 영상까지 만들 수 있다니\\n미호시 학원 학생들은 대단하네!"

msgid "message_11589_txt"
msgstr "정말, 나도 그렇게 생각해"

msgid "message_11590_txt"
msgstr "재학생들의 힘을 빌리자는 건\\n내 아이디어였지만…"

msgid "message_11591_txt"
msgstr "모두 내가 생각했던 것 이상으로\\n큰 활약을 해줘서\\n계속 놀랐는걸!"

msgid "message_11592_txt"
msgstr "이러면 더욱\\n미호시 학원에 입학하고 싶어지네…!"

msgid "message_11593_txt"
msgstr "셰릴 씨가 입학…"

msgid "message_11594_txt"
msgstr "우리 학교\\n드디어 은하 최강의 학원이\\n되는 거 아냐?"

msgid "message_11595_txt"
msgstr "그래도 정말 즐거워 보이네!"

msgid "message_11596_txt"
msgstr "즐겁다기보다는 시끌벅적한 거 아닌가?"

msgid "message_11597_txt"
msgstr "신입생 여러분도\\n즐거운 학교생활을 보내면 좋겠네"

msgid "message_11598_txt"
msgstr "분명 전해졌을 거야.\\n오늘 라이브로 말이야!"

msgid "message_11599_txt"
msgstr "프레이야.\\n투어 라이브 3일째, 수고했어"

msgid "message_11600_txt"
msgstr "고마워!\\n하야테도 수고 많았어!"

msgid "message_11601_txt"
msgstr "투어, 처음에는 힘들겠다고 생각했는데\\n어찌 됐든 구상성단을 돌아다니는 것도 나쁘지 않네"

msgid "message_11602_txt"
msgstr "이 기세로\\n내일도 분위기 띄워 보자고"

msgid "message_11603_txt"
msgstr "좋아ー!(>▽<)"

msgid "message_11604_txt"
msgstr "있잖아 레이나!\\n오늘 그거, 업데이트 아직이야?"

msgid "message_11605_txt"
msgstr "잠시 기다려라"

msgid "message_11606_txt"
msgstr "업로드 완료"

msgid "message_11607_txt"
msgstr "오, 고마워!"

msgid "message_11608_txt"
msgstr "이거 오늘 프레이야인가.\\n또 엄청 녹초가 됐네"

msgid "message_11609_txt"
msgstr "레이나 씨!?Σ(ﾟ□ﾟ)"

msgid "message_11610_txt"
msgstr "설마 방금 그 사진인가!?"

msgid "message_11611_txt"
msgstr "그, 그러지 마요~!"

msgid "message_11612_txt"
msgstr "뭐야 뭐야? 무슨 이야기야~?"

msgid "message_11613_txt"
msgstr "프레이야 짱 사진이야.\\n지금 밀레느 짱에게도 보낼게!"

msgid "message_11614_txt"
msgstr "뭐야 이거! 프레이야 귀여워ー!"

msgid "message_11615_txt"
msgstr "우우, 시공을 넘어 퍼지고 있어…!"

msgid "message_11616_txt"
msgstr "지금 이런 발키리의 비공개 사진을\\n레이나가 실시간으로 인터넷에 올려서\\n팬들에게 퍼뜨리고 있어"

msgid "message_11617_txt"
msgstr "헤에, 그래!? \\n왜 또 그런 걸?"

msgid "message_11618_txt"
msgstr "그건 말이지~…"

msgid "message_11619_txt"
msgstr "지금 진행 중인 구상성단 투어 라이브에 맞춰서\\n발키리의 새로운 매력을\\n알리고 싶다고 생각했거든!"

msgid "message_11620_txt"
msgstr "거의 실시간으로 업데이트하고 있어서\\n투어가 끝난 행성의 사람들도\\n즐길 수 있다고 엄청 좋은 반응이야~!"

msgid "message_11621_txt"
msgstr "꽤 재미있는 시도네!\\n나도 실시간으로 보고 싶어"

msgid "message_11622_txt"
msgstr "초시공 네트워크의 모두에게도\\n실시간 전송한다"

msgid "message_11623_txt"
msgstr "고마워, 레이나!"

msgid "message_11624_txt"
msgstr ""

msgid "message_11625_txt"
msgstr "포기해, 프레이야"

msgid "message_11626_txt"
msgstr "나뿐만 아니라 다른 사람들의 사진도\\n정말 희귀하다고!"

msgid "message_11627_txt"
msgstr "쉬는 시간에 졸고 있는 레이나 씨라든가\\n기합을 넣고 있는 카나메 씨라든가…"

msgid "message_11628_txt"
msgstr "몰래 촬영하고 있는 마키나 씨를\\n반대로 내가 몰래 촬영한 사진이라든가!"

msgid "message_11629_txt"
msgstr "에에!?Σ(ﾟ□ﾟ)\\n프레프레 언제부터~!?"

msgid "message_11630_txt"
