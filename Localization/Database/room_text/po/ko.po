msgid "message_3450_txt"
msgstr "밀레느!?\\n그건 비밀로 해달라고 했잖아!"

msgid "message_3451_txt"
msgstr "괜찮잖아! 이런 건\\n제대로 전해야 한다고!"

msgid "message_3452_txt"
msgstr "란카………"

msgid "message_3453_txt"
msgstr "아무튼! 즐겨줘, 오빠!"

msgid "message_3454_txt"
msgstr "아라드 대장!\\n확실히 오늘은 대장님 생일이죠?"

msgid "message_3455_txt"
msgstr "그래, 맞다"

msgid "message_3456_txt"
msgstr "축하드립니다"

msgid "message_3457_txt"
msgstr "고맙다, 메서"

msgid "message_3458_txt"
msgstr "그러니 가끔은 남자끼리\\n맛있는 음식이라도 먹으러 가지 않겠습니까?"

msgid "message_3459_txt"
msgstr "좋은 생각이군!\\n기분 전환도 되고,\\n오랜만에 느긋하게 보낼 수 있겠어"

msgid "message_3460_txt"
msgstr "멤버는 누가 좋을까요?\\n저랑 메서랑…그리고 하야테인가"

msgid "message_3461_txt"
msgstr "메서가 있는 게 조금 걸리긴 하지만…\\n뭐, 모처럼 생일이니까"

msgid "message_3462_txt"
msgstr "미라쥬?"

msgid "message_3463_txt"
msgstr "치사하지 않습니까!"

msgid "message_3464_txt"
msgstr "엥?"

msgid "message_3465_txt"
msgstr "저도 대장님의 생일을 함께 축하하고 싶습니다!!"

msgid "message_3466_txt"
msgstr "하야테! 가기 싫으면 대신 가세요!"

msgid "message_3467_txt"
msgstr "가기 싫다고 한 적 없어!"

msgid "message_3468_txt"
msgstr "진정해, 미라쥬"

msgid "message_3469_txt"
msgstr "그렇군…그럼 델타 소대원 모두 함께 가자!\\n사람이 많을수록 더 시끌벅적할 테니까"

msgid "message_3470_txt"
msgstr "감사합니다!\\n바로 준비하고 오겠습니다!"

msgid "message_3471_txt"
msgstr "시간은 충분하니 서두르지 않아도 된다.\\n…올해도 즐거운 생일이 될 것 같군"

msgid "message_3472_txt"
msgstr "가무린 씨!\\n생일 축하해ー!!"

msgid "message_3473_txt"
msgstr "오늘은 말이지, 미라쥬에게도 협력받아서\\n성대한 생일 파티로 만들 거야"

msgid "message_3474_txt"
msgstr "기대하고 있어!"

msgid "message_3475_txt"
msgstr "미라쥬 씨도요?"

msgid "message_3476_txt"
msgstr "응! 연출이나 요리 메뉴 같은 것도,\\n같이 생각해 줬어!"

msgid "message_3477_txt"
msgstr "오늘 내 의상도\\n미라쥬가 골라줬거든!"

msgid "message_3478_txt"
msgstr "물론 마키나 씨에게도 많은\\n조언을 받았지만"

msgid "message_3479_txt"
msgstr "숙모님께서 정말 열심히 준비하고 계셔서\\n저도 도울 수 있는 일이\\n있으면 좋겠다고 생각해서…"

msgid "message_3480_txt"
msgstr "역시 미라쥬!\\n귀엽고, 바로 마음에 들었어!"

msgid "message_3481_txt"
msgstr "정말인가요!? 다행이에요…"

msgid "message_3482_txt"
msgstr "제가 고른 의상을 숙모님께서\\n입어주시다니…\\n정말 뿌듯한 기분이에요!"

msgid "message_3483_txt"
msgstr "밀레느 씨와 미라쥬 씨는 사이가 좋아서\\n정말 보기 좋네요"

msgid "message_3484_txt"
msgstr "밀레느 씨의 의상, 저도\\n기대하고 있습니다!"

msgid "message_3485_txt"
msgstr "고마워요, 가무린 씨!"

msgid "message_3486_txt"
msgstr "그리고…\\n생일 축하드립니다!"

msgid "message_3487_txt"
msgstr "앞으로도 숙모님과 함께\\n잘 부탁드립니다!"

msgid "message_3488_txt"
msgstr "그럼 이제 슬슬 파티를\\n시작해 볼까ー!"

msgid "message_3489_txt"
msgstr "네! 숙모님!"

msgid "message_3490_txt"
msgstr "네! 밀레느 씨!"

msgid "message_3491_txt"
msgstr "숙모님, 생일\\n축하드립니다!"

msgid "message_3492_txt"
msgstr "고마워ー!! 미라쥬!"

msgid "message_3493_txt"
msgstr "오늘은 그… 소중한 숙모님의\\n생일이니까요"

msgid "message_3494_txt"
msgstr "어떻게 축하해 드리면 좋을지\\n제 나름대로 정말 많이 생각했어요!"

msgid "message_3495_txt"
msgstr "그래서 그…\\n지너스 가문 모두가\\n함께 축하하는 건 어떨까요?"

msgid "message_3496_txt"
msgstr "지너스 가문에서??"

msgid "message_3497_txt"
msgstr "네!! 할머니와 할아버지도 모시고\\n성대한 파티를 열어요!"

msgid "message_3498_txt"
msgstr "뭐!? 아빠랑 엄마도!?"

msgid "message_3499_txt"
msgstr "미래의 딸 생일이니까"

msgid "message_3500_txt"
msgstr "맞아. 우리가 할 수 있는 건\\n최선을 다해서 해볼 생각이야"

msgid "message_3501_txt"
msgstr "어떡하지… 정말 기뻐!!"

msgid "message_3502_txt"
msgstr "레이 씨와 아키코 씨에게 도움을 받아서\\n오늘을 위한 특별한 드레스도\\n준비했어요!"

msgid "message_3503_txt"
msgstr "숙모님께 분명\\n아주 잘 어울릴 거예요!"

msgid "message_3504_txt"
msgstr "초시공 유닛 라이브에서는\\n같은 공간만 공유할 수 있지만…"

msgid "message_3505_txt"
msgstr "오늘은 숙모님 이야기를\\n잔뜩 들려주세요!"

msgid "message_3506_txt"
msgstr "정말 고마워…\\n정말 멋진 생일이 될 것 같아!"

msgid "message_3507_txt"
msgstr "미라쥬"

msgid "message_3508_txt"
msgstr "미쿠모 씨? 무슨 일 있으신가요?"

msgid "message_3509_txt"
msgstr "오늘은 네 생일이지"

msgid "message_3510_txt"
msgstr "네! 사실 조금 전에 숙모님께도\\n축하를 받았어요!"

msgid "message_3511_txt"
msgstr "바쁘신데도 시간을 내주셔서…\\n정말 기쁘고…!\\n특별한 생일이 되었어요!"

msgid "message_3512_txt"
msgstr "하지만 아직 기뻐하기엔 이르지 않을까?"

msgid "message_3513_txt"
msgstr "프레이아와 하야테 일행이\\n뭔가 준비하고 있었어"

msgid "message_3514_txt"
msgstr "뭐!? 정말인가요?"

msgid "message_3515_txt"
msgstr "야, 미쿠모! 아직 말하지 말라고!"

msgid "message_3516_txt"
msgstr "프레이아 때문에\\n여러 가지로 시간이 걸리고 있다고"

msgid "message_3517_txt"
msgstr "내 탓이 아니거든!ヽ(#`Д´)ﾉ\\n하야테가 진지하게 안 하는 게 나쁜 거야!"

msgid "message_3518_txt"
msgstr "잠깐, 두 사람 다…!\\n싸우지 말아 주세요!"

msgid "message_3519_txt"
msgstr "여전하네, 시끌벅적한 게"

msgid "message_3520_txt"
msgstr "미라쥬 씨!\\n엄청나게 멋진 생일 파티로\\n만들 테니까 조금만 기다려 주세요!"

msgid "message_3521_txt"
msgstr "미라쥬! 기대하고 있어!"

msgid "message_3522_txt"
msgstr "…정말이지"

msgid "message_3523_txt"
msgstr "네, 감사합니다!"

msgid "message_3524_txt"
msgstr "오늘은… 키스 님의 생일이네!"

msgid "message_3525_txt"
msgstr "키스의? 그런가"

msgid "message_3526_txt"
msgstr "윈더미어에 있을 때는\\n마을 사람 모두가 함께 축하했어"

msgid "message_3527_txt"
msgstr "올해는 어떤 생일을\\n보내고 있을까…?"

msgid "message_3528_txt"
msgstr "알고 싶어?"

msgid "message_3529_txt"
msgstr "너, 또 멋대로 해킹할 생각이지"

msgid "message_3530_txt"
msgstr "걱정 불필요"

msgid "message_3531_txt"
msgstr "이미 해킹 완료"

msgid "message_3532_txt"
msgstr "자랑스럽게 말하지 마.\\n혼나도 난 모른다"

msgid "message_3533_txt"
msgstr "그것도 걱정 불필요.\\n적의 정보를 입수하는 것도 훌륭한 업무"

msgid "message_3534_txt"
msgstr "레이나 씨!\\n그래서 키스 님은 어떤 생일을\\n보내고 있어?"

msgid "message_3535_txt"
msgstr "…올해는 로이드와 함께\\n사과 주스를 마시고 있었어"

msgid "message_3536_txt"
msgstr "음성까지는 입수하지 못했지만\\n키스의 표정은 평소보다 부드러웠을지도?"

msgid "message_3537_txt"
msgstr "오오ー!!"

msgid "message_3538_txt"
msgstr "키스 님도 생일은 소중한 사람들과\\n함께 보내고 있구나"

msgid "message_3539_txt"
msgstr "왠지 조금은\\n안심이 되네(*´▽｀*)"

msgid "message_3540_txt"
msgstr "…뭐, 그런 날이 있어도 좋겠지"

msgid "message_3541_txt"
msgstr "미사 씨! 생일 축하드립니다!\\n오늘 생일 파티,\\n기대해 주세요!"

msgid "message_3542_txt"
msgstr "민메이, 엄청 의욕 넘치네…"

msgid "message_3543_txt"
msgstr "올해 생일은 평소와 조금 다를 거야!"

msgid "message_3544_txt"
msgstr "평소와 다르다고…?"

msgid "message_3545_txt"
msgstr "응! 여자아이들만의 생일 파티로 만들 거야!"

msgid "message_3546_txt"
msgstr "미사 씨, 전에 발키리 멤버들이\\n파자마 파티를 한다고 들으시고"

msgid "message_3547_txt"
msgstr "저도 참가해 보고 싶다고 하셨잖아요!\\n그래서 프레이아와 셰릴 씨들에게도\\n협력받았어요!"

msgid "message_3548_txt"
msgstr "기억해 줬구나! 기뻐!"

msgid "message_3549_txt"
msgstr "민메이, 이쪽 준비는 OK야!"

msgid "message_3550_txt"
msgstr "이쪽도 준비 완료라구!"

msgid "message_3551_txt"
msgstr "이렇게 설레는 생일은 오랜만이네…!"

msgid "message_3552_txt"
msgstr "저도 미사 씨가 기뻐해 주셔서\\n정말 기뻐요!\\n나중에 냥냥으로 와 주세요!"

msgid "message_3553_txt"
msgstr "응! 기대하고 있을게!"

msgid "message_3554_txt"
msgstr "그러고 보니 오늘 보그 생일이지?"

msgid "message_3555_txt"
msgstr "레이나, 올해는 아무것도 안 하는 거야?\\n매년 보그에게 뭔가 보내던 것 같은데"

msgid "message_3556_txt"
msgstr "올해는 조금 고민 중"

msgid "message_3557_txt"
msgstr "…고민할 만한 일이야?"

msgid "message_3558_txt"
msgstr "나는 자극을 사랑하는 여자"

msgid "message_3559_txt"
msgstr "매번 같은 건 재미없어.\\n좋은 아이디어가 없는지 찾는 중"

msgid "message_3560_txt"
msgstr "기왕이면 엄청 놀라게 해주고 싶잖아…"

msgid "message_3561_txt"
msgstr "…그래"

msgid "message_3562_txt"
msgstr "뭐, 뭐야!?"

msgid "message_3563_txt"
msgstr "차라리 하야테 이미지 데이터 모음을 보내자"

msgid "message_3564_txt"
msgstr "하야하야의??"

msgid "message_3565_txt"
msgstr "잠깐만! 그게 무슨 소리야!?"

msgid "message_3566_txt"
msgstr "보그 콤파르트는\\n마키나와 내 러브러브 이미지 데이터를\\n기대하고 있을 거야"

msgid "message_3567_txt"
msgstr "그러니까 일부러 하야테 이미지를 보내서\\n그 기대를 배신하는 방식"

