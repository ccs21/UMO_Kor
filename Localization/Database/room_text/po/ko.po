msgid "message_12313_txt"
msgstr "직원 모집 중"

msgid "message_12314_txt"
msgstr "나와 미쿠모의 도전도\\n곧 일단락될 테니까\\n끝나면 그쪽을 도와줄까"

msgid "message_12315_txt"
msgstr "그것도 좋겠네"

msgid "message_12316_txt"
msgstr "정말!? 두 사람이 와주면\\n팬 여러분이 기뻐할 거야!"

msgid "message_12317_txt"
msgstr "귀여운 의상을 준비해서\\n기다리고 있을게!( *>ω< *)"

msgid "message_12318_txt"
msgstr "응! 마지막은 발키리 전원이\\n분위기를 띄워보자!"

msgid "message_12319_txt"
msgstr "카나메!\\n저번에는 고마웠어"

msgid "message_12320_txt"
msgstr "카나메가 준 아이디어 덕분에\\n이제 곧 의상이 완성될 것 같아"

msgid "message_12321_txt"
msgstr "정말인가요!?\\n그거 다행이에요!＾＾"

msgid "message_12322_txt"
msgstr "완성되면\\n가장 먼저 카나메에게 보여줄게"

msgid "message_12323_txt"
msgstr "기대하고 있어 줘"

msgid "message_12324_txt"
msgstr "셰릴.\\n이번에는 카나메 씨에게 협력받은 건가?"

msgid "message_12325_txt"
