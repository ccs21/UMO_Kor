msgstr "<size=30>귀여워~!</size>"

msgid "message_6981_txt"
msgstr "민민에게 직접 전수받은 안무도 완벽하고\\n레이레이라면 분명 괜찮을 거야!"

msgid "message_6982_txt"
msgstr "고리 고리~!\\n레이나 씨, 힘내세요!"

msgid "message_6983_txt"
msgstr "저도 응원하는 것밖에 못 하지만\\n힘내세요!"

msgid "message_6984_txt"
msgstr "모두, 고마워"

msgid "message_6985_txt"
msgstr "…다녀올게"

msgid "message_6986_txt"
msgstr "도쿄 스카이트리라는 곳,\\n진짜 엄청 크네…\\n정말 여기서 라이브를 하는 건가?"

msgid "message_6987_txt"
msgstr "응. 이번 우리의 임무는\\n도쿄 스카이트리에서 라이브를 하고,\\n모두의 기억을 지키는 거야^^"

msgid "message_6988_txt"
msgstr "저기저기, 카나카나!"

msgid "message_6989_txt"
msgstr "천망회랑이라는 곳에\\n우리 일러스트가\\n엄청 많이 장식되어 있다면서?"

msgid "message_6990_txt"
msgstr "라이브가 끝나면 조금만\\n다 같이 놀다 가지 않을래?( *>ω< *)"

msgid "message_6991_txt"
msgstr "콜라보 메뉴"

msgid "message_6992_txt"
msgstr "맞아 맞아!\\n카페에는 특별한 메뉴도 있다고\\n들었는데…"

msgid "message_6993_txt"
msgstr "척 씨가\\n엄청 고민해서 만든 거였지!"

msgid "message_6994_txt"
msgstr "정말…어쩔 수 없네.\\n하지만 소풍 온 게 아니니까\\n너무 들뜨면 안 돼?"

msgid "message_6995_txt"
msgstr "와아!(*´∀｀*)"

msgid "message_6996_txt"
msgstr "도쿄 스카이트리…"

msgid "message_6997_txt"
msgstr "아! 쿠모쿠모도 관심 생겼어?"

msgid "message_6998_txt"
msgstr "글쎄"

msgid "message_6999_txt"
msgstr "우리는 발키리.\\n그저 노래할 뿐이야"

msgid "message_7000_txt"
msgstr "…그래도 그렇네.\\n조금 정도는 즐겨도 괜찮겠어"

msgid "message_7001_txt"
msgstr "좋아, 결정!\\n모두 좋은 추억으로 만들자~!"

msgid "message_7002_txt"
msgstr "응!\\n도쿄 스카이트리, 두근두근 기대된다!"

msgid "message_7003_txt"
msgstr "셰릴 씨, 도쿄 스카이트리에서\\n내려다보는 풍경 정말 아름답네요!"

msgid "message_7004_txt"
msgstr "야경도 추천한다더라!\\n그보다 란카 쨩, 곧\\n한정 공개 영상이 상영된대"

msgid "message_7005_txt"
msgstr "와아! 대단하네요!\\n기대된다…"

msgid "message_7006_txt"
msgstr "우리 일러스트도 천천히 보고 싶고…\\n즐길 게 정말 많네"

msgid "message_7007_txt"
msgstr "맞다!\\n차라리 층 전체를 빌려버릴까요?"

msgid "message_7008_txt"
msgstr "…너희는 대체 뭐 하러 온 거냐"

msgid "message_7009_txt"
msgstr "어머 알토.\\n뭐 불만이라도 있어?"

msgid "message_7010_txt"
msgstr "그런 건 아니지만…\\n아무리 그래도 너무 들떠 있잖아"

msgid "message_7011_txt"
msgstr "걱정하지 않아도 제대로 알고 있어.\\n이번에는 도쿄 스카이트리에서 라이브를\\n하면 되는 거잖아?"

msgid "message_7012_txt"
msgstr "하지만 모처럼 영감을 자극하는 것들이\\n잔뜩 있는데.\\n즐기지 않으면 아깝잖아!"

msgid "message_7013_txt"
msgstr "부탁이야, 알토 군!\\n조금만…"

msgid "message_7014_txt"
msgstr "…정말이지, 어쩔 수 없네.\\n길 잃지 마라"

msgid "message_7015_txt"
msgstr "그러고 보니 알토.\\n저쪽에 발키리 장난감도\\n전시되어 있다던데?"

msgid "message_7016_txt"
msgstr "헤에, 그래?"

msgid "message_7017_txt"
msgstr "그러니까 조금 어울려줘!\\n나랑 란카 쨩 중 누구와 데이트할지\\n고르게 해줄게!"

msgid "message_7018_txt"
msgstr "천망 데크에서 만나자?\\n빨리 와, 늦으면 용서 안 할 거니까!"

msgid "message_7019_txt"
msgstr "있잖아, 바사라!\\n아까 엄청난 광경을 봤어!"

msgid "message_7020_txt"
msgstr "저쪽에 우리 일러스트가\\n잔뜩 전시되어 있더라!"

msgid "message_7021_txt"
msgstr "그래서 어쩌라고"

msgid "message_7022_txt"
msgstr "조금은 감동하라고!\\n바사라는 아무 느낌도 없어?"

msgid "message_7023_txt"
msgstr "진정해, 밀레느.\\n바사라는 지금 그럴 상황이 아니다"

msgid "message_7024_txt"
msgstr "그럴 상황이 아니라니…?"

msgid "message_7025_txt"
msgstr "그게 말이지…"

msgid "message_7026_txt"
msgstr "내 노래로 도쿄 스카이트리를\\n움직여 보이겠다"

msgid "message_7027_txt"
msgstr "…혹시 아까부터\\n계속 그것만 생각하고 있었던 거야?"

msgid "message_7028_txt"
msgstr "어이가 없네…\\n그런 게 될 리 없잖아!"

msgid "message_7029_txt"
msgstr "모르는군.\\n노래의 힘은 대단해"

msgid "message_7030_txt"
msgstr "우리 사운드를 도쿄 스카이트리에\\n실컷 들려주자고!"

msgid "message_7031_txt"
msgstr "레이도 비히다도 준비됐지.\\n가자, 밀레느!"

msgid "message_7032_txt"
msgstr "잠깐, 바사라! 기다리라니까!\\n…정말!"

msgid "message_7033_txt"
msgstr "도쿄 스카이트리에서 라이브를 한다는 게\\n왠지 꿈만 같다고 생각했는데…"

msgid "message_7034_txt"
msgstr "내 일러스트와 굿즈를 보고\\n이제야 실감이 났어!"

msgid "message_7035_txt"
msgstr "다행이네, 민메이"

msgid "message_7036_txt"
msgstr "있잖아, 히카루!\\n나중에 카페에도 가보자!"

msgid "message_7037_txt"
msgstr "어, 괜찮겠어?\\n민메이인 게 주변에 들키면\\n큰일 나는 거 아니야…?"

msgid "message_7038_txt"
msgstr "괜찮아!\\n나 열심히 변장할 거니까"

msgid "message_7039_txt"
msgstr "다녀와라, 히카루"

msgid "message_7040_txt"
msgstr "어차피 라이브까지는\\n아직 시간이 있잖아?"

msgid "message_7041_txt"
msgstr "아니면 나랑 같이\\n발키리 전시라도 보러 갈래?"

msgid "message_7042_txt"
msgstr "그건 좀…"

msgid "message_7043_txt"
msgstr "솔직한 녀석이군"

msgid "message_7044_txt"
msgstr "그럼 결정이네!"

msgid "message_7045_txt"
msgstr "지금만 있는 특별 메뉴도\\n있는 것 같으니까 즐기자!"

msgid "message_7046_txt"
msgstr "있잖아, 미쿠모. 오늘 보낸 내 영상,\\n봐줬어?"

msgid "message_7047_txt"
msgstr "응, 의상도 연출도 정말 매력적이었어"

msgid "message_7048_txt"
msgstr "역시 은하의 요정이네"

msgid "message_7049_txt"
msgstr "고마워.\\n미쿠모가 보내준 영상도\\n꽤 좋았어"

msgid "message_7050_txt"
msgstr "…미쿠모와 이야기하고 있으면\\n영감이 자극돼서\\n좋은 걸 만들 수 있을 것 같아"

msgid "message_7051_txt"
msgstr "자극을 받는 건 이쪽도 마찬가지야.\\n셀프 프로듀스에 대해 공부가 되었어"

msgid "message_7052_txt"
msgstr "자기 자신을 표현한다는 것…\\n꽤 깊이가 있네"

msgid "message_7053_txt"
msgstr "미라쥬도 셰릴의 영상에\\n넋을 잃고 바라보고 있었어"

msgid "message_7054_txt"
msgstr "정말? 그건 기쁘네"

msgid "message_7055_txt"
msgstr "셰릴 씨! 그런 저는…"

msgid "message_7056_txt"
msgstr "긴장하고 있는 걸까?"

msgid "message_7057_txt"
msgstr "당연하죠…미쿠모 씨와 셰릴 씨의\\n대화에 끼어드는 건 용기가 필요해요"

msgid "message_7058_txt"
msgstr "두 분 다 정말 대단해요…\\n그런 의상을 소화하다니"

msgid "message_7059_txt"
msgstr "미라쥬도 잘 어울릴 것 같은데?\\n재료는 좋으니까…"

msgid "message_7060_txt"
msgstr "그러게…입어보는 건 어때?"

msgid "message_7061_txt"
msgstr "네!?\\n제가, 그 의상을…말인가요!?"

msgid "message_7062_txt"
msgstr "무리입니다!"

msgid "message_7063_txt"
msgstr "그럴까?"

msgid "message_7064_txt"
msgstr "미라쥬, 처음부터 안 된다고\\n단정 지으면 안 돼"

msgid "message_7065_txt"
msgstr "하지만 자신이 되고 싶은 이미지를 확립하는 건\\n정말 중요하다고 생각해"

msgid "message_7066_txt"
msgstr "나도 데뷔했을 때는\\n프로듀스를 남에게 맡겼으니까"

msgid "message_7067_txt"
msgstr "셰릴 놈은 이런 게 아니야라고\\n몇 번이나 생각했었어"

msgid "message_7068_txt"
msgstr "그랬던 건가요…?\\n지금의 셰릴 씨에게서는 상상도 안 돼요"

msgid "message_7069_txt"
msgstr "그렇지?\\n하지만 지금의 나는 달라. 나는\\n내가 그리는 셰릴 놈을 표현할 수 있어"

msgid "message_7070_txt"
msgstr "…이번 촬영에서 데뷔곡을 고른 건\\n정답이었어"

msgid "message_7071_txt"
msgstr "여러 가지를 실감했거든!"

msgid "message_7072_txt"
msgstr "실감…"

msgid "message_7073_txt"
msgstr "…나에게 특별한 헤어스타일로,\\n나다운 의상을 입고 노래하는 것"

msgid "message_7074_txt"
msgstr "물론 노래하는 방식도 나답게!"

msgid "message_7075_txt"
msgstr "다른 사람이 보기엔 사소한 일일 수도 있지만\\n좋은 노래를 부르기 위해서는 역시 중요하다는 걸\\n실감했어"

msgid "message_7076_txt"
msgstr "확실히 그럴지도 모르겠네"

msgid "message_7077_txt"
msgstr "그러니까 미라쥬.\\n너에게도 기회일지도 몰라?"

msgid "message_7078_txt"
msgstr "셀프 프로듀스를 한다는 건\\n자신에게 무엇이 흔들리지 않는 것인지\\n알 수 있게 해주는 일이니까"

msgid "message_7079_txt"
msgstr "셀프 프로듀스…"

msgid "message_7080_txt"
msgstr "참고로, 지금의 저는\\n어떤 이미지인가요…?"

msgid "message_7081_txt"
msgstr "모범생 같은 느낌"

msgid "message_7082_txt"
msgstr "그래, 성실한 느낌"

msgid "message_7083_txt"
msgstr "…저도 스스로 그렇게 생각하는 부분은 있습니다"

msgid "message_7084_txt"
msgstr "작은 부분부터 바꿔보는 것도\\n괜찮지 않을까?"

msgid "message_7085_txt"
msgstr "헤어스타일이라든가"

msgid "message_7086_txt"
msgstr "머리 말인가요…하지만 저는\\n셰릴 씨만큼 패션 감각이 있는 것도 아니고…"

msgid "message_7087_txt"
msgstr "쉬운 것부터 하면 돼!\\n…예를 들면 앞머리를 헤어핀으로 고정해보는 거야!\\n그 정도면 간단하잖아?"

msgid "message_7088_txt"
msgstr "그렇네요!\\n그러면 머리가 방해되지도 않고,\\n기능성도 뛰어나니 찬성입니다"

msgid "message_7089_txt"
msgstr "…그런데 커플이네, 그 사람과"

msgid "message_7090_txt"
msgstr "그 사람과…?"

msgid "message_7091_txt"
msgstr "하, 하야테와\\n맞추고 싶은 게 아닙니다!"

msgid "message_7092_txt"
msgstr "어머, 좋은 거 아니야?\\n파일럿끼리 사이가 좋은 건 좋은 일이잖아?"

msgid "message_7093_txt"
msgstr "좋지 않습니다!\\n역시 이미지 바꾸는 건 그만둘래요!"

msgid "message_7094_txt"
msgstr "…미라쥬는 재미있네"

msgid "message_7095_txt"
msgstr "놀리기 좋겠지?"

msgid "message_7096_txt"
msgstr "…당신들에게는 도저히 이길 수 없을 것 같습니다"

msgid "message_7097_txt"
msgstr "숙모님, 생신 축하드립니다!"

msgid "message_7098_txt"
msgstr "얘들아, 고마워~!\\n축하받아서 정말 기뻐~!"

msgid "message_7099_txt"
msgstr "아빠라고 불리는 건 아직 익숙하지 않지만,\\n딸에게 고맙다는 말을 듣는 건 기쁘네"

msgid "message_7100_txt"
msgstr "저도 기뻐요"

msgid "message_7101_txt"
msgstr "숙모님께서 기뻐해 주시는 것뿐만 아니라\\n할아버님, 할머님과\\n함께 축하할 수 있다니"

msgid "message_7102_txt"
msgstr "그, 할아버님이라고 불리는 것도\\n아직 익숙하지 않구나…"

msgid "message_7103_txt"
msgstr "그러고 보니 밀레느.\\n오늘은 어떤 생일을 보냈니?"

msgid "message_7104_txt"
msgstr "평소 신세 지던 사람들과\\nFire Bomber 멤버 모두에게 축하받았어!"

msgid "message_7105_txt"
msgstr "맛있는 음식도 먹고, 케이크도 먹고…\\n정말 즐거운 생일 파티였다고!"

msgid "message_7106_txt"
msgstr "그리고 바사라와 가무린 씨에게\\n생일 선물도 받았어!"

msgid "message_7107_txt"
msgstr "바사라 씨에게도요?\\n그건 대단하네요…"

msgid "message_7108_txt"
msgstr "그렇지~! 나도 깜짝 놀랐어.\\n의외였다고 해야 하나,\\n분명 관심 없을 거라고 생각했거든"

msgid "message_7109_txt"
msgstr "어떤 선물을 받았나요?"

msgid "message_7110_txt"
msgstr "그게 말이지…"

msgid "message_7111_txt"
msgstr "바사라가 새 곡을 줬는데,\\n그걸 그날 바로 연주했어!? \\n아직 연습도 하나도 안 했는데!"

msgid "message_7112_txt"
msgstr "…물론,\\n선물 자체는 정말 기뻤고\\n제대로 노래했지만!"

msgid "message_7113_txt"
msgstr "그러니까 말했잖아.\\n무언가를 전하려면 노래라고"

msgid "message_7114_txt"
msgstr "그런 문제가 아니잖아!"

msgid "message_7115_txt"
msgstr "하지만 받은 지 얼마 안 된 곡을\\n완벽하게 소화하다니, 역시 숙모님이에요!"

msgid "message_7116_txt"
msgstr "어, 그런가?…에헤헤"

msgid "message_7117_txt"
msgstr "밀레느의 노래라…\\n언젠가 눈앞에서 들어보고 싶네"

msgid "message_7118_txt"
msgstr "그럼 다음에 영상으로 보내줄게!\\n아빠랑 엄마에게도 들려주고 싶고…"

msgid "message_7119_txt"
msgstr "내 노래로 두 사람이 더 사이좋아진다면,\\n분명 지금의 아빠와 엄마도…"

msgid "message_7120_txt"
msgstr "…미래의 우리가 무슨 일이라도 있나?"

msgid "message_7121_txt"
msgstr "아무것도 아니야! 신경 쓰지 마!"

msgid "message_7122_txt"
msgstr "그나저나 축하의 말을 건네거나,\\n물건을 선물하거나…\\n생일이라는 건 정말 특별한 날이구나"

msgid "message_7123_txt"
msgstr "네, 마음껏 축하하는 날이니까요.\\n저도 숙모님께 선물을 드리고 싶었어요"

msgid "message_7124_txt"
msgstr "…그러고 보니 바사라에게 받은 악보,\\n어째서인지 선물용 리본이\\n묶여 있었어"

msgid "message_7125_txt"
msgstr "리본? 그러고 보니 가무린이\\n행사장에 가는 길에 묶고 있었지"

msgid "message_7126_txt"
msgstr "죄송합니다, 밀레느 씨.\\n바사라의 선물이 너무나\\n그대로라서 그만"

msgid "message_7127_txt"
msgstr "그렇구나, 그런 일이었네!"

msgid "message_7128_txt"
