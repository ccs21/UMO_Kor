msgstr "그나저나 신기하군.\\n우리 시공 말고도\\n비슷한 시공이 있다니"

msgid "message_7605_txt"
msgstr "평행세계인가…그런데 그만큼 새 인간의 영향을\\n받고 있다는 뜻이야?"

msgid "message_7606_txt"
msgstr "여러 가지 기억이 뒤섞여 있다는 건,\\n그런 의미가 되겠지"

msgid "message_7607_txt"
msgstr "보통이라면 믿기 힘든 이야기지"

msgid "message_7608_txt"
msgstr "음…그래도 나는 조금은\\n멋지다고 생각해버렸어"

msgid "message_7609_txt"
msgstr "멋지다고? 뭐가?"

msgid "message_7610_txt"
msgstr "물론 좋은 일이 아니라는 건\\n잘 알고 있어!\\n하지만…"

msgid "message_7611_txt"
msgstr "여러 시공의 알토 군이나\\n셰릴 씨를 만날 수 있잖아!"

msgid "message_7612_txt"
msgstr "소중한 사람이 다른 시공에서도\\n잘 살아 있다는 게\\n왠지 안심되고, 멋지다고 생각해서…"

msgid "message_7613_txt"
msgstr "…란카 쨩은 정말 좋은 아이구나"

msgid "message_7614_txt"
msgstr "네!?"

msgid "message_7615_txt"
msgstr "지켜주고 싶어진다고 해야 하나…\\n그렇지, 알토?"

msgid "message_7616_txt"
msgstr "노 코멘트"

msgid "message_7617_txt"
msgstr "그래, 란카는 예전부터 착한 아이였어"

msgid "message_7618_txt"
msgstr "아까도 열심히\\n뭔가를 쓰고 있길래…"

msgid "message_7619_txt"
msgstr "잠깐, 오빠!"

msgid "message_7620_txt"
msgstr "있잖아, 란카 쨩!\\n뭘 쓰고 있었어?"

msgid "message_7621_txt"
msgstr "다른 시공의 모두에게\\n편지를 쓰고 있었어요"

msgid "message_7622_txt"
msgstr "편지?"

msgid "message_7623_txt"
msgstr "편지가 도착하지 않을 거라는 건 알고 있지만\\n그래도 역시\\n전하고 싶은 말이 너무 많아서…"

msgid "message_7624_txt"
msgstr "헤에, 멋지네.\\n무슨 내용을 썼어?"

msgid "message_7625_txt"
msgstr "내 편지에는 다치지 말라고\\n써 있었지"

msgid "message_7626_txt"
msgstr "설마 읽은 거야!?"

msgid "message_7627_txt"
msgstr "일부러 그런 건 아니야!\\n거실에 놓여 있으면\\n누구라도 신경 쓰이잖아!"

msgid "message_7628_txt"
msgstr "<size=30>오빠 바보ーー!</size>"

msgid "message_7629_txt"
msgstr "뭐!?"

msgid "message_7630_txt"
msgstr "…남매 싸움이라는 건\\n꽤 재밌네"

msgid "message_7631_txt"
msgstr "그럴 때가 아니야!"

msgid "message_7632_txt"
msgstr "…일단 진정해, 란카"

msgid "message_7633_txt"
msgstr "응!\\n미안해, 알토 군!"

msgid "message_7634_txt"
msgstr "그래서, 쓴 뒤의 편지는\\n어떻게 할 거야?"

msgid "message_7635_txt"
msgstr "맞다!\\n그래서 알토 군과 셰릴 씨에게\\n부탁하고 싶은 게 있었어요!"

msgid "message_7636_txt"
msgstr "우리에게?"

msgid "message_7637_txt"
msgstr "네! 저기…"

msgid "message_7638_txt"
msgstr "쓴 편지를 접어서\\n종이비행기를 만들고 싶어요!\\n그걸 도와주시겠어요?"

msgid "message_7639_txt"
msgstr "접은 다음에는 그리피스 공원의 언덕에서\\n날려 보낼 생각이에요!"

msgid "message_7640_txt"
msgstr "좋네! 재밌을 것 같아!\\n나도 편지를 써보고 싶어"

msgid "message_7641_txt"
msgstr "나도 다른 시공의 란카 쨩에게\\n전하고 싶은 말이 많이 있으니까"

msgid "message_7642_txt"
msgstr "게다가 누군가에게 편지를 쓸 기회 같은 건\\n좀처럼 없잖아"

msgid "message_7643_txt"
msgstr "물론 알토도 말이야"

msgid "message_7644_txt"
msgstr "잠깐만! 나도 쓰는 거야?"

msgid "message_7645_txt"
msgstr "당연하지!\\n제대로 쓰도록 해?"

msgid "message_7646_txt"
msgstr "알토 군도 써주는 거야!?\\n와ー! 기대된다!( *´▽｀*)"

msgid "message_7647_txt"
msgstr "아니 그게…"

msgid "message_7648_txt"
msgstr "헤에…뭔가 재밌어 보이는 이야기를 하고 있네"

msgid "message_7649_txt"
msgstr "전하고 싶은 걸 쓴다…인가\\n란카, 나도 참가해도 될까?"

msgid "message_7650_txt"
msgstr "그래서 알토는 나한테\\n뭐라고 써줄 건데?"

msgid "message_7651_txt"
msgstr "왜 미셸한테!?"

msgid "message_7652_txt"
msgstr "미셸!\\n특별히 내가 써줘도 된다?"

msgid "message_7653_txt"
msgstr "꼬맹이는 편지에 쓰기도 전에\\n전부 말해버리는 거 아니야?"

msgid "message_7654_txt"
msgstr "<size=30>미셸ーー!!</size>"

msgid "message_7655_txt"
msgstr "왠지 즐거워지기 시작했네요,\\n셰릴 씨!"

msgid "message_7656_txt"
msgstr "초시공 유닛 라이브, 성공"

msgid "message_7657_txt"
msgstr "셰릴 씨와 란카 씨의 무대를\\n눈앞에서 볼 수 있다니,\\n정말 대단해요!"

msgid "message_7658_txt"
msgstr "정말이야! 정말 감동했어!\\n조금 너무 들떴던 것 같기도 하지만…"

msgid "message_7659_txt"
msgstr "카나카나의 눈이 정말\\n반짝반짝했잖아( *>ω< *)"

msgid "message_7660_txt"
msgstr "왠지 부끄러워졌어…"

msgid "message_7661_txt"
msgstr "카나메, 즐겨줘서 고마워!\\n우리도 좋은 무대를 만들 수 있었어"

msgid "message_7662_txt"
msgstr "나도 홀로그램이지만\\n라이브를 하고, 모두와 이야기할 수 있어서\\n정말 기뻤어요!"

msgid "message_7663_txt"
msgstr "저야말로 감사합니다,\\n란카 씨, 셰릴 씨"

msgid "message_7664_txt"
msgstr "초시공 유닛 라이브…"

msgid "message_7665_txt"
msgstr "좋은 라이브였어"

msgid "message_7666_txt"
msgstr "이걸로 더 많은 사람들의 기억을\\n되찾을 수 있어"

msgid "message_7667_txt"
msgstr "그래, 그렇지"

msgid "message_7668_txt"
msgstr "우리도 질 수 없겠네!"

msgid "message_7669_txt"
msgstr "홀로그램의 두 사람을\\n몇 번이나 만지려고 했던 프레프레,\\n정말 귀여웠어!"

msgid "message_7670_txt"
msgstr "마키나 씨, 알고 있었어요!?\\nΣ(ﾟ□ﾟ)"

msgid "message_7671_txt"
msgstr "당연하지( *>ω< *)"

msgid "message_7672_txt"
msgstr "그런데 정말,\\n이렇게 대단한 걸 개발하다니!"

msgid "message_7673_txt"
msgstr "나는 불가능을 가능하게 만드는 여자"

msgid "message_7674_txt"
msgstr "하지만 이번 성공은\\n나 혼자만의 힘이 아니야"

msgid "message_7675_txt"
msgstr "실패와 개선의 반복이었지만\\n많은 사람들의 도움을 받았어"

msgid "message_7676_txt"
msgstr "역시 개발한다는 건 힘든 일이군요…\\n그런데 누구에게 도움을 받은 건가요?"

msgid "message_7677_txt"
msgstr "그거 나도 궁금해ー!"

msgid "message_7678_txt"
msgstr "예를 들면…바사라라든가"

msgid "message_7679_txt"
msgstr "에에에!?"

msgid "message_7680_txt"
msgstr "바사라가 협력했다고?\\n제일 협조적이지 않을 것 같은데ー!?"

msgid "message_7681_txt"
msgstr "그러고 보니 레이나가 부탁해서 몇 번인가 노래했지.\\n옆에 미쿠모가 있는 것처럼 보였던 건,\\n그런 이유였던 건가"

msgid "message_7682_txt"
msgstr "눈치 못 챈 거야!?"

msgid "message_7683_txt"
msgstr "노래하는 것에 비하면 작은 일이잖아?"

msgid "message_7684_txt"
msgstr "그보다 꽤 괜찮은\\n무대였어, 미쿠모"

msgid "message_7685_txt"
msgstr "그래, 나도 흥미로운 무대였어"

msgid "message_7686_txt"
msgstr "바사라와 미쿠모의 무대…\\n실험 중이라고는 생각되지 않을 만큼 매력적이네"

msgid "message_7687_txt"
msgstr "홀로그램화 실험 단계에서는\\n강력한 생체 폴드파가 필요했기 때문에\\n두 사람에게 협력받았어"

msgid "message_7688_txt"
msgstr "하지만 바사라 씨도 쿠모쿠모도\\n힘 조절이라는 걸 못 해서 말이지ー(^_^;)"

msgid "message_7689_txt"
msgstr "…두 사람에게 설명하는 게 제일 힘들었어"

msgid "message_7690_txt"
msgstr "왠지 미안해지기 시작했어…"

msgid "message_7691_txt"
msgstr "그렇구나…그래서 완성 후 첫 기동이\\n우리들의 라이브였던 거구나"

msgid "message_7692_txt"
msgstr "그런데 왜 우리가 한 거야?"

msgid "message_7693_txt"
msgstr "그러고 보니 그 이유는\\n나도 듣지 못했네"

msgid "message_7694_txt"
msgstr "그건…협력받았으니까"

msgid "message_7695_txt"
msgstr "군사 기업 L.A.I에"

msgid "message_7696_txt"
msgstr "그건…"

msgid "message_7697_txt"
msgstr "제 부모님의 기업입니다!"

msgid "message_7698_txt"
msgstr "사실 레이나 씨가 L.A.I의\\n네트워크에 침입해버렸어요"

msgid "message_7699_txt"
msgstr "저도 대체 누가 침입해온 건지\\n자세히 조사해버렸고…"

msgid "message_7700_txt"
msgstr "서로 알려져선 안 되는 일을\\n알아버렸기 때문에, 서로 협력하기로 했습니다"

msgid "message_7701_txt"
msgstr "그때는 아직 초시공 유닛 라이브에 대한 건\\n극비 취급이었으니까요"

msgid "message_7702_txt"
msgstr "저희가 완벽하게 지원할 수 있는 상태에서\\n기동하기 위해 셰릴 씨와 란카 씨에게\\n노래를 불러달라고 하게 된 겁니다!"

msgid "message_7703_txt"
msgstr "레이나, 그렇게 위험한 짓은 하지 말라고\\n말했잖아…"

msgid "message_7704_txt"
msgstr "자자, 카나카나!\\n이번에는 봐주자(*´∀｀*)\\n초시공 유닛 라이브도 성공했잖아!"

msgid "message_7705_txt"
msgstr "확실히 나도 셰릴 씨와 란카 씨의\\n라이브를 즐길 수 있었지만…"

msgid "message_7706_txt"
msgstr "맞다, 카나메!\\n오늘 나랑 란카 쨩이 부른 곡,\\n나중에 같이 불러보지 않을래?"

msgid "message_7707_txt"
msgstr "카나메는 항상 조금 사양하는 편이니까\\n이걸 계기로\\n조금 더 가까워지면 좋겠는데, 그렇지?"

msgid "message_7708_txt"
msgstr "셰릴 씨도 란카 씨도\\n존경하는 분들이니까…\\n역시 조금 긴장되는 걸까요?"

msgid "message_7709_txt"
msgstr "셰리셰리와 카나카나의 무대…\\n엄청난 일이 될 것 같네( *>ω< *)"

msgid "message_7710_txt"
msgstr "녹화 준비"

msgid "message_7711_txt"
msgstr "좋겠다!\\n나도 누군가와 함께 노래하고 싶어!"

msgid "message_7712_txt"
msgstr "그렇다면 미레이느 쨩!\\n나와 함께 노래해요!"

msgid "message_7713_txt"
msgstr "정말!?\\n고마워, 란카!"

msgid "message_7714_txt"
msgstr "다들 기뻐해줘서 다행이야"

msgid "message_7715_txt"
msgstr "마키나도…고마워"

msgid "message_7716_txt"
msgstr "지지해줘서 기뻤어"

msgid "message_7717_txt"
msgstr "레이레이!!\\n그런 건 당연하지ーー!!"

msgid "message_7718_txt"
msgstr "새로운 힘, 새로운 무대…"

msgid "message_7719_txt"
msgstr "앞으로 재밌어질 것 같네"

msgid "message_7720_txt"
msgstr "저기, 바사라 씨.\\n조금 여쭤보고 싶은 게 있는데요…"

msgid "message_7721_txt"
msgstr "미라쥬?\\n별일이군, 뭔데?"

msgid "message_7722_txt"
msgstr "최근에 신경 쓰이는 일이라든지\\n있으신가요?"

msgid "message_7723_txt"
msgstr "신경 쓰이는 일? 딱히 없는데"

msgid "message_7724_txt"
msgstr "그럼 그…\\n최근 자주 가는 장소라든지…"

msgid "message_7725_txt"
msgstr "대체 무슨 소리야?"

msgid "message_7726_txt"
msgstr "미라쥬.\\n이런 건 확실하게 물어보는 게 빠르다"

msgid "message_7727_txt"
msgstr "할머님!"

msgid "message_7728_txt"
msgstr "바사라.\\n너는 최근 미레이느에게 말하지 않고\\n어디에 가고 있는 거냐?"

msgid "message_7729_txt"
msgstr "그게, 바사라 씨가 최근 라이브 후에\\n어딘가로 간다는 이야기를\\n숙모님께 들어서요…"

msgid "message_7730_txt"
msgstr "아, 그 얘기인가"

msgid "message_7731_txt"
msgstr "미레이느가 신경 쓰고 있었구나"

msgid "message_7732_txt"
msgstr "별거 아니야.\\n그냥 노래하러 가는 것뿐이다"

msgid "message_7733_txt"
msgstr "그걸로는 납득할 수 없다.\\n자세히 설명해라"

msgid "message_7734_txt"
msgstr "나도 미래의 딸이 걱정하는 모습은\\n보고 싶지 않으니까"

msgid "message_7735_txt"
msgstr "자세히 말하라면, 그렇군…"

msgid "message_7736_txt"
msgstr "얼마 전에 숲에서 만난 녀석이 있어.\\n그 녀석이 깨어나길 바라며 노래하고 있다"

msgid "message_7737_txt"
msgstr "깨어나길 바란다…?\\n그분은 잠들어 있는 건가요?"

msgid "message_7738_txt"
msgstr "자세한 건 모르지만, 내가 숲에 갔을 때\\n우연히 빛에 둘러싸여 잠들어 있는 녀석을\\n발견했어"

msgid "message_7739_txt"
msgstr "그래서 그 녀석을 향해 노래했더니,\\n본 적 없는 기억이 흘러들어 왔다"

msgid "message_7740_txt"
msgstr "…기억 속의 나도 그 녀석을 향해\\n똑같이 노래하고 있었어"

msgid "message_7741_txt"
msgstr "일어나, 시빌…이라고 말이지"

msgid "message_7742_txt"
msgstr "시빌…\\n그게 그분의 이름인가요?"

msgid "message_7743_txt"
msgstr "글쎄.\\n하지만 보였던 기억 속의 나는\\n그 녀석을 알고 있는 것 같았어"

msgid "message_7744_txt"
msgstr "하지만 지금 우리와 이야기하고 있는 바사라는\\n그 시빌이라는 존재를 모른다"

msgid "message_7745_txt"
msgstr "그런 일이었군요…"

msgid "message_7746_txt"
msgstr "숙모님!"

msgid "message_7747_txt"
msgstr "미라쥬도 엄마도 걱정하게 만들어서\\n미안해!"

msgid "message_7748_txt"
msgstr "하지만 내 대신 이것저것 물어봐줘서\\n고마워!"

msgid "message_7749_txt"
msgstr "바사라는 말이지, 나를 애 취급해서\\n말해주지 않는 게 많거든"

msgid "message_7750_txt"
msgstr "사실이잖아"

msgid "message_7751_txt"
msgstr "<size=24>아니거든!!!</size>"

msgid "message_7752_txt"
msgstr "…그러고 보니 감린도\\n비슷한 걸 물어봤었지"

msgid "message_7753_txt"
msgstr "그러고 보니 감린 씨에게도\\n조금 상담했던 것 같기도…"

msgid "message_7754_txt"
msgstr "모두가 걱정하고 있어요.\\n저도 숙모님이 언제나 웃고\\n계셨으면 좋겠으니까요"

msgid "message_7755_txt"
msgstr "미라쥬…미래의 나는\\n정말 귀여운 조카를 두게 되는구나!"

msgid "message_7756_txt"
msgstr "맞아!\\n그리고 미쿠모에게도 감사 인사를 해야겠어!"

msgid "message_7757_txt"
msgstr "미쿠모 씨에게…요?"

msgid "message_7758_txt"
msgstr "응, 바사라를 미행할 때\\n필요한 변장의 요령을 알려줬어!"

msgid "message_7759_txt"
