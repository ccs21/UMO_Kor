msgid "message_0919_txt"
msgstr "저도 보내드릴게요!!!"

msgid "message_0920_txt"
msgstr "고마워, 기대하고 있을게!^^"

msgid "message_0921_txt"
msgstr "저기, 하야테!\\n마키나를 데려와 줄래?"

msgid "message_0922_txt"
msgstr "새 의상에 대한\\n의견을 좀 듣고 싶은데."

msgid "message_0923_txt"
msgstr "…왜 나인데."

msgid "message_0924_txt"
msgstr "마키나에게 몇 번이나 연락했는데도\\n답장이 없거든."

msgid "message_0925_txt"
msgstr "레슨이라도 하고 있는 거 아니야?\\n조금 더 기다리면 알겠지."

msgid "message_0926_txt"
msgstr "지금 당장 듣고 싶어!\\n그러지 않으면 겨우 떠오른 영감이\\n아깝잖아!"

msgid "message_0927_txt"
msgstr "그렇게 말해도 말이지…"

msgid "message_0928_txt"
msgstr "저기, 하야테 군!"

msgid "message_0929_txt"
msgstr "란카?"

msgid "message_0930_txt"
msgstr "사실 나도 프레이아 짱에게\\n답장이 안 와서…"

msgid "message_0931_txt"
msgstr "…알았다고 알았어.\\n둘 다 모아서 데려와 줄게."

msgid "message_0932_txt"
msgstr "헤에."

msgid "message_0933_txt"
msgstr "하야테는 의외로 상냥하네."

msgid "message_0934_txt"
msgstr "무슨 의미야, 그거."

msgid "message_0935_txt"
msgstr "저도 그렇게 생각해요!"

msgid "message_0936_txt"
msgstr "프레이아 짱에게 듣는 하야테 군은\\n조금 심술궂은 느낌이거든요!"

msgid "message_0937_txt"
msgstr "…프레이아는 대체 무슨 얘기를 하는 거야."

msgid "message_0938_txt"
msgstr "뭐, 아무튼 이 내가 칭찬해주는 거니까,\\n고맙게 받아들이도록 해?"

msgid "message_0939_txt"
msgstr "…네네."

msgid "message_0940_txt"
msgstr "드디어 실현됐네요…\\n이 날을 계속 기다리고 있었어요!"

msgid "message_0941_txt"
msgstr "큐루루도 정말 기뻐 보였고,\\n저도 즐거웠어요!"

msgid "message_0942_txt"
msgstr "큐루루라니… 무슨 이야기야?"

msgid "message_0943_txt"
msgstr "하야테!"

msgid "message_0944_txt"
msgstr "우리는 계속 말했었거든…\\n큐루루와 구바바와 아이 군을\\n만나게 해주고 싶다고!"

msgid "message_0945_txt"
msgstr "그래서 방금 드디어\\n만나게 해줄 수 있었던 거야!\\n초시공 유닛 라이브는 정말 편리해!"

msgid "message_0946_txt"
msgstr "큐루루뿐만 아니라 저도\\n정말 기뻤어요."

msgid "message_0947_txt"
msgstr "설마 숙모님께 소중한 구바바 씨를\\n만날 수 있다니…"

msgid "message_0948_txt"
msgstr "구바바 씨라니… 씨까지 붙이는 거냐."

msgid "message_0949_txt"
msgstr "당연하죠!"

msgid "message_0950_txt"
msgstr "아이 군도 큐루루도\\n정말 귀여웠죠~!\\n보고 있으면 힐링되는 느낌이고!"

msgid "message_0951_txt"
msgstr "저도 아이 군에게 친구가 늘어서\\n정말 기뻐요!"

msgid "message_0952_txt"
msgstr "그런데 만나게 해주면 뭐 하자는 거야?\\n서로 대화할 수 있는 것도 아니잖아."

msgid "message_0953_txt"
msgstr "하야테는 정말 아무것도\\n모르는구나(´・ω・`)"

msgid "message_0954_txt"
msgstr "그 이모티콘, 짜증 나는데…"

msgid "message_0955_txt"
msgstr "구바바 씨도 아이 군도 큐루루도\\n우리와 함께 싸우는 동료예요!"

msgid "message_0956_txt"
msgstr "어쩌면 우리가 모르는 곳에서\\n협력해주는 날이 올지도 모르고!"

msgid "message_0957_txt"
msgstr "맞아!\\n작다고 얕보지 말라고~!"

msgid "message_0958_txt"
msgstr "얕볼 생각은 없는데…"

msgid "message_0959_txt"
msgstr "그렇군."

msgid "message_0960_txt"
msgstr "작은 자들의 모임, 나쁘지 않네."

msgid "message_0961_txt"
msgstr "그렇지~! 역시 미쿠모!\\n알아주는구나!"

msgid "message_0962_txt"
msgstr "…그게 뭐야."

msgid "message_0963_txt"
msgstr "란카."

msgid "message_0964_txt"
msgstr "미쿠모 씨!\\n무슨 일인가요?"

msgid "message_0965_txt"
msgstr "네가 알려준\\n이모티콘을 사용해봤어."

msgid "message_0966_txt"
msgstr "정말요!\\n(・∀・) 말이죠?"

msgid "message_0967_txt"
msgstr "그래(・∀・)"

msgid "message_0968_txt"
msgstr "발키리 여러분,\\n분명 놀랐겠죠…"

msgid "message_0969_txt"
msgstr "그래, 아주."

msgid "message_0970_txt"
msgstr "미쿠모 씨가 그 이모티콘을 쓴다고\\n했을 때는,\\n어떻게 될까 싶었는데…"

msgid "message_0971_txt"
msgstr "이모티콘은 자신의 마음을 전달하는 데\\n효과적이라는 건 확실한 것 같네."

msgid "message_0972_txt"
msgstr "그 정도 일뿐인데도,\\n모두 기뻐했어.\\n그건 분명 마음이 전해졌다는 뜻이겠지."

msgid "message_0973_txt"
msgstr "도움이 되었다니 다행이에요!(*´▽｀*)"

msgid "message_0974_txt"
msgstr "그래서 말인데, 란카.\\n다른 이모티콘도 알려주지 않겠니?"

msgid "message_0975_txt"
msgstr "와아~! .:*゜(n´∀｀)n゜*:.\\n미쿠모 씨도 이모티콘을 좋아하게 된 거군요!"

msgid "message_0976_txt"
msgstr "아니야."

msgid "message_0977_txt"
msgstr "추천해주려고 하는 거야, 바사라에게."

msgid "message_0978_txt"
msgstr "네!?Σ(ﾟ□ﾟ)"

msgid "message_0979_txt"
msgstr "좋다고 생각한 건 알려주는 게 좋다고\\n카나메가 말했어."

msgid "message_0980_txt"
msgstr "하지만 바사라 씨는 이모티콘 같은 건\\n쓰지 않을 것 같은 느낌이죠…"

msgid "message_0981_txt"
msgstr "그렇다면 셰릴에게\\n추천해볼까?"

msgid "message_0982_txt"
msgstr "셰릴 씨에게!?"

msgid "message_0983_txt"
msgstr "…어라? 미쿠모 씨!?"

msgid "message_0984_txt"
msgstr "그러니까… 그러니까…"

msgid "message_0985_txt"
msgstr "일단 셰릴 씨에게\\n딱 맞는 이모티콘을 찾아올게요!"

msgid "message_0986_txt"
msgstr "있잖아 레이나!\\n그 이미지 뭐야!?"

msgid "message_0987_txt"
msgstr "정말 음식 이미지 맞아!?"

msgid "message_0988_txt"
msgstr "레이나, 너 무슨 이미지를 보낸 거야?"

msgid "message_0989_txt"
msgstr "바다거미 이미지."

msgid "message_0990_txt"
msgstr "아… 그렇구나.\\n그건 확실히 놀랄 수도 있겠네."

msgid "message_0991_txt"
msgstr "하지만 아주 맛있어."

msgid "message_0992_txt"
msgstr "헤에~ 의외다!\\n먹기에는 용기가 필요한 생김새인데 말이야!"

msgid "message_0993_txt"
msgstr "그래도 해파리는 맛있어 보였어!\\n언젠가 먹어보고 싶다~!"

msgid "message_0994_txt"
msgstr "해파리… 말인가요?"

msgid "message_0995_txt"
msgstr "가무린 씨!"

msgid "message_0996_txt"
msgstr "해파리는 라그나의 명물이야."

msgid "message_0997_txt"
msgstr "그러고 보니 그런 이야기를\\n미라쥬 씨에게 들었던 것 같군…"

msgid "message_0998_txt"
msgstr "추천은 생으로 통째로 삼키기."

msgid "message_0999_txt"
msgstr "통째로 삼키라고요!?\\n레이나 씨, 잘 씹지 않으면\\n몸에 안 좋아요!"

msgid "message_1000_txt"
msgstr "나는 위험을 사랑하는 여자.\\n그런 건 신경 쓰지 않아."

msgid "message_1001_txt"
msgstr "납득하는 거냐고."

msgid "message_1002_txt"
msgstr "아~ 초시공 네트워크를 이용해서\\n음식을 서로 주고받을 수 있으면 좋겠다~"

msgid "message_1003_txt"
msgstr "그건 아무래도 어렵다."

msgid "message_1004_txt"
msgstr "그렇겠지…"

msgid "message_1005_txt"
msgstr "저기, 밀레느 씨!"

msgid "message_1006_txt"
msgstr "제가 해파리를 먹을 수 있는 가게를\\n찾아둘 테니까,\\n부디 기운 내세요."

msgid "message_1007_txt"
msgstr "정말인가요!?\\n고마워요, 가무린 씨!"

msgid "message_1008_txt"
msgstr "맡겨주세요!"

msgid "message_1009_txt"
msgstr "힘내라, 가무린."

msgid "message_1010_txt"
msgstr "그래."

msgid "message_1011_txt"
msgstr "왠지 요즘 프레프레의 상태가\\n이상한 것 같은데…"

msgid "message_1012_txt"
msgstr "수상해."

msgid "message_1013_txt"
msgstr "또 하야테가 뭔가 한 거죠?"

msgid "message_1014_txt"
msgstr "왜 항상 나인 건데."

msgid "message_1015_txt"
msgstr "어머? 하야테와 프레이아 짱은\\n항상 싸움만 한다고\\n란카 짱이 그러던데."

msgid "message_1016_txt"
msgstr "이번에는 내가 아니야."

msgid "message_1017_txt"
msgstr "이번에는…이라는 건,\\n하야하야, 그래도 자각은 있구나(ﾟ∇ﾟ ;)"

msgid "message_1018_txt"
msgstr "그래서… 프레이아 짱,\\n어디가 이상한 거야?"

msgid "message_1019_txt"
msgstr "뜨거운 하트를 내던지는 것! 그게 노래야!라고\\n외친다거나…"

msgid "message_1020_txt"
msgstr "이게 내 사운드야!라고 외친다거나."

msgid "message_1021_txt"
msgstr "…그건 확실히\\n평소와 조금 다른 것 같네."

msgid "message_1022_txt"
msgstr "그보다, 그 대사\\n어디선가 들어본 것 같은데."

msgid "message_1023_txt"
msgstr "…바사라네."

msgid "message_1024_txt"
msgstr "그러고 보니 요즘\\n둘이서 자주 노래하고 있지."

msgid "message_1025_txt"
msgstr "미안해, 카나메!"

msgid "message_1026_txt"
msgstr "프레이아까지 바사라처럼\\n제멋대로 굴게 되면 어떡하지…"

msgid "message_1027_txt"
msgstr "바사라 씨 같은 프레프레라~!\\n그것도 나름 괜찮을지도!(´▽｀*)"

msgid "message_1028_txt"
msgstr "더더욱 가슴이 따끔거릴 것 같아."

msgid "message_1029_txt"
msgstr "처음부터 조금 닮은 것 같긴 한데."

msgid "message_1030_txt"
msgstr "밀레느 씨, 걱정해주셔서\\n고마워요!"

msgid "message_1031_txt"
msgstr "하지만 바사라 씨의 노래는 분명\\n프레이아의 성장으로 이어질 거예요."

msgid "message_1032_txt"
msgstr "그럴까?\\n그렇다면 좋겠지만… 고마워, 카나메!"

msgid "message_1033_txt"
msgstr "아뇨, 신경 쓰지 마세요^^"

msgid "message_1034_txt"
msgstr "호기 도래."

msgid "message_1035_txt"
msgstr "레이나?\\n호기라니… 무슨 일이야?"

msgid "message_1036_txt"
msgstr "카나메가 졸고 있다."

msgid "message_1037_txt"
msgstr "오오~!\\n.:*゜(n´∀｀)n゜*:."

msgid "message_1038_txt"
msgstr "장난칠 기회."

msgid "message_1039_txt"
msgstr "이봐 이봐! 그런 짓 하면\\n카나메가 불쌍하잖아~!"

msgid "message_1040_txt"
msgstr "분명 너희를 돌보느라\\n피곤한 거 아닐까??\\n그냥 내버려 둬~"

msgid "message_1041_txt"
msgstr "나는 위험을 사랑하는 여자."

msgid "message_1042_txt"
msgstr "피곤할 때야말로\\n피로를 날려버릴 자극이 필요해."

msgid "message_1043_txt"
msgstr "어?? 무슨 뜻이야??"

msgid "message_1044_txt"
msgstr "레이나 짱! 준비됐어!"

msgid "message_1045_txt"
msgstr "민메이 씨??"

msgid "message_1046_txt"
msgstr "눈을 떴더니 옆에서 민메이가\\n노래하고 있는 깜짝 이벤트."

msgid "message_1047_txt"
msgstr "에에!?"

msgid "message_1048_txt"
msgstr "초시공 유닛 라이브에서만 가능한\\n특별한 놀라움이지!( *>ω< *)"

msgid "message_1049_txt"
msgstr "왠지 나까지\\n두근두근해지기 시작했어!"

msgid "message_1050_txt"
msgstr "카나메 씨, 놀라줄까?"

msgid "message_1051_txt"
msgstr "준비는 완벽."

msgid "message_1052_txt"
msgstr "이제 실행할 뿐."

msgid "message_1053_txt"
msgstr "그럼 가보자~!!\\n(*´∀｀*)"

msgid "message_1054_txt"
msgstr "네~!"

msgid "message_1055_txt"
msgstr "잠깐!"

msgid "message_1056_txt"
msgstr "…카나메도 고생이네."

msgid "message_1057_txt"
msgstr "있잖아, 란카.\\n좀 물어보고 싶은 게 있는데."

msgid "message_1058_txt"
msgstr "내가 대답할 수 있는 거면 좋겠는데…\\n뭐야??"

msgid "message_1059_txt"
msgstr "란카의 펫 말이야,\\n아이 군… 맞지?"

msgid "message_1060_txt"
msgstr "정말… 하야테 군!\\n아이 군은 내 친구야!"

msgid "message_1061_txt"
msgstr "아아… 미안. 친구 말이지."

msgid "message_1062_txt"
msgstr "아이 군이 무슨 일인데?"

msgid "message_1063_txt"
msgstr "사실 오늘 미라쥬에게\\n큐루루를 맡게 됐는데."

msgid "message_1064_txt"
msgstr "잘 돌볼 수 있는 요령 같은 게\\n있으면 물어보고 싶어서."

msgid "message_1065_txt"
msgstr "그렇구나… 음…"

msgid "message_1066_txt"
msgstr "처음에는 역시\\n친구가 되는 게 아닐까?"

msgid "message_1067_txt"
msgstr "그러면 큐루루 짱이\\n원하는 걸 알 수 있을지도 몰라!"

msgid "message_1068_txt"
msgstr "친구가 된다고 해도 말이지…"

msgid "message_1069_txt"
msgstr "하야테 군은 상냥하니까,\\n그런 점이 큐루루 짱에게도\\n전해진다면 더 친해질 수 있지 않을까?"

msgid "message_1070_txt"
msgstr "…역시 란카다운 대답이네."

msgid "message_1071_txt"
msgstr "어? 그런가…??\\n밀레느 짱이라면 좀 더 정확하게\\n조언해줄 수 있을지도 모르지만…"

msgid "message_1072_txt"
msgstr "밀레느에게 상담하면 어차피\\n미라쥬에게 폐 끼치지 말라고\\n할 테니까."

msgid "message_1073_txt"
msgstr "물어본다면 란카가 맞을 것 같아서."

msgid "message_1074_txt"
msgstr "밀레느 짱이랑 미라쥬 씨는\\n사이가 좋으니까 말이지(*´▽｀*)"

msgid "message_1075_txt"
msgstr "또 곤란한 일이 생기면 언제든 연락해!\\n내가 괜찮다면 힘이 되어줄게!"

msgid "message_1076_txt"
msgstr "그래, 고마워."

msgid "message_1077_txt"
msgstr "있잖아, 란카!"

msgid "message_1078_txt"
msgstr "왜?? 밀레느 짱!"

msgid "message_1079_txt"
msgstr "미쿠모가 말이야, 란카한테 이모티콘을\\n배웠다고 하던데…"

msgid "message_1080_txt"
msgstr "나한테도 뭔가 알려줬으면 해서!"

msgid "message_1081_txt"
msgstr "물론이지, 밀레느 짱!"

msgid "message_1082_txt"
msgstr "그런데 미쿠모 씨가\\n많이 써줘서 기쁜걸!"

msgid "message_1083_txt"
msgstr "밀레느 짱에게 어울릴 것 같은 이모티콘,\\n나중에 잔뜩 보내줄게!"

msgid "message_1084_txt"
msgstr "고마워!!"

msgid "message_1085_txt"
msgstr "아, 맞다!"

msgid "message_1086_txt"
msgstr "저기, 가무린 씨!"

msgid "message_1087_txt"
msgstr "네, 밀레느 씨!"

msgid "message_1088_txt"
msgstr "가무린 씨도\\n란카에게 이모티콘을 골라달라고 해봐요!"

msgid "message_1089_txt"
msgstr "저도… 말입니까?"

msgid "message_1090_txt"
