msgid "message_12936_txt"
msgstr "나, 생각난 게 있어!"

msgid "message_12937_txt"
msgstr "리허설 한다고\\n말했잖아"

msgid "message_12938_txt"
msgstr "그러니까 그 전에\\n이것만큼은 지금 말하고 싶은 거야!"

msgid "message_12939_txt"
msgstr "밀레느 쨩이 생각한 거\\n나도 듣고 싶어"

msgid "message_12940_txt"
msgstr "세트리스트는\\n내 마음대로 하게\\n해줬으니까"

msgid "message_12941_txt"
msgstr "말하게 해 줘, 바사라"

msgid "message_12942_txt"
msgstr "그래서, 뭘 생각해 낸 거야?\\n밀레느"

msgid "message_12943_txt"
msgstr "라이브의 마무리에\\n어울리는 연출이야!"

msgid "message_12944_txt"
msgstr "두 사람이 듀엣곡을 부를 때\\n뒤쪽 모니터에 우리들의\\n추억 사진을 띄우는 건 어때?"

msgid "message_12945_txt"
msgstr "추억 사진?\\n설마 그거…!"

msgid "message_12946_txt"
msgstr "맞아요!\\n초시공 SNS의 모두가 만든\\n추억의 앨범!"

msgid "message_12947_txt"
msgstr "시공을 넘어 모인\\n우리들의 소중한 추억…"

msgid "message_12948_txt"
msgstr "벌써 정말 많은\\n사진이 모였잖아!"

msgid "message_12949_txt"
msgstr "그러니까 이제 슬슬\\n팬 여러분에게도\\n보여주고 싶다고 생각했어!"

msgid "message_12950_txt"
msgstr "정말 멋져!\\n나도 그렇게 하고 싶어"

msgid "message_12951_txt"
msgstr "하지만 조금 걱정되는 게 있어…"

msgid "message_12952_txt"
msgstr "걱정이요?"

msgid "message_12953_txt"
msgstr "앨범에 바사라 씨가 제대로\\n찍힌 사진이 별로 없어요…"

msgid "message_12954_txt"
msgstr "밀레느 쨩, 한번 생각해 봐"

msgid "message_12955_txt"
msgstr "앨범용으로 사진 찍자고 하면\\n바사라 씨, 항상 어딘가로\\n가버렸잖아?"

msgid "message_12956_txt"
msgstr "그러고 보니…!"

msgid "message_12957_txt"
msgstr "음. 바사라 사진도\\n제대로 있는 게 좋겠지…"

msgid "message_12958_txt"
msgstr "바사라. 지금 당장 한 장 찍자"

msgid "message_12959_txt"
msgstr "바사라 씨, 부탁드릴게요!"

msgid "message_12960_txt"
msgstr "역시 앨범을 다시 봤을 때\\n바사라 씨 모습이 보이지 않는 건\\n쓸쓸하니까…"

msgid "message_12961_txt"
msgstr "바사라 씨와도\\n함께 노력해서 여기까지 왔다고\\n앨범을 볼 때마다 느끼고 싶어요"

msgid "message_12962_txt"
msgstr "…어쩔 수 없네"

msgid "message_12963_txt"
msgstr "이번에는 너희들 고집에\\n끝까지 어울려 줄까"

msgid "message_12964_txt"
msgstr "감사합니다!\\n바사라 씨!"

msgid "message_12965_txt"
msgstr "란카 씨!"

msgid "message_12966_txt"
msgstr "오늘 란카 씨와 셰릴 씨,\\n바다에 있는 거죠?"

msgid "message_12967_txt"
msgstr "아, 프레이아 쨩!\\n바다, 정말 즐거워!"

msgid "message_12968_txt"
msgstr "일 때문에 왔지만\\n차갑고 기분도 좋고,\\n여름다운 기분도 들고…"

msgid "message_12969_txt"
msgstr "괜히 놀고 싶어지네!"

msgid "message_12970_txt"
msgstr "오오~!\\n셰릴 씨도 즐기고 있는 거야?"

msgid "message_12971_txt"
msgstr "지금 미쿠모 씨와 해중 릴랙세이션을\\n하고 있는 것 같아!"

msgid "message_12972_txt"
msgstr "왠지 셰릴 씨,\\n기운이 없어 보이는 것 같은데…"

msgid "message_12973_txt"
msgstr "내 착각이면 좋겠지만"

msgid "message_12974_txt"
msgstr "무슨 일 있었던 걸까…?"

msgid "message_12975_txt"
msgstr "음, 나도 잘 모르겠어.\\n뭔가 고민하는 것처럼 보이긴 하는데…"

msgid "message_12976_txt"
msgstr "걱정이네…"

msgid "message_12977_txt"
msgstr "걱정 끼친 것 같네,\\n란카 쨩에게"

msgid "message_12978_txt"
msgstr "해중 릴랙세이션은 어땠어요?"

msgid "message_12979_txt"
msgstr "좋았어!\\n기분도 상쾌해졌어!"

msgid "message_12980_txt"
msgstr "…미쿠모에게 여러 가지\\n이야기도 들어줬고"

msgid "message_12981_txt"
msgstr "별거 아니었어"

msgid "message_12982_txt"
msgstr "그렇지 않아, 고마워"

msgid "message_12983_txt"
msgstr "파도에 흔들리면서\\n이야기하다 보니 정말 편안해졌어"

msgid "message_12984_txt"
msgstr "셰릴 씨, 역시 뭔가\\n고민이 있었던 건가요?"

msgid "message_12985_txt"
msgstr "고민이라고 할 정도는 아니지만…"

msgid "message_12986_txt"
msgstr "어제 라이브에서 말이야, 다시\\n이 세계와는 다른 시공의 기억을 봤어"

msgid "message_12987_txt"
msgstr "그 시공의 나는,\\n「나에게는 이제 노래밖에 없어」라고\\n알토에게 매달려 울고 있었어"

msgid "message_12988_txt"
msgstr "그리고 자신의 몸을 깎아가면서\\n정말 필사적으로 노래하고 있었어…"

msgid "message_12989_txt"
msgstr "그 모습이 계속 머릿속에서 떠나지 않았어"

msgid "message_12990_txt"
msgstr "하지만 말이야, 미쿠모가 말해줬어"

msgid "message_12991_txt"
msgstr "「여기에 있는 너라면 어떻게 할 거야」라고"

msgid "message_12992_txt"
msgstr "나도 말이야,\\n역시 마지막까지 노래할 거라고 생각했어"

msgid "message_12993_txt"
msgstr "노래하지 않아도 된다고 해도,\\n싫어!라고 대답할 것 같다고"

msgid "message_12994_txt"
msgstr "어떤 시공에 있더라도 셰릴 노므는\\n분명 노래를 향한 마음은 변하지 않아"

msgid "message_12995_txt"
msgstr "정말 괴로워 보였지만\\n그 시공의 나도\\n셰릴 노므라는 것을 관철한 거구나 싶었어"

msgid "message_12996_txt"
msgstr "그렇게 생각하니까 조금씩\\n마음도 진정됐어"

msgid "message_12997_txt"
msgstr "다행이에요…"

msgid "message_12998_txt"
msgstr "기분 전환에는 바다가 최고야"

msgid "message_12999_txt"
msgstr "응, 정말"

msgid "message_13000_txt"
msgstr "그럼 바다를 즐겨볼까!\\n모처럼 왔으니까"

msgid "message_13001_txt"
msgstr "프레이아 쨩!\\n발키리 멤버들도 불러와 줄래?"

msgid "message_13002_txt"
msgstr "기왕이면 모두 함께 즐기자!"

msgid "message_13003_txt"
msgstr "알겠어~!"

msgid "message_13004_txt"
msgstr "그러네요!\\n즐거운 추억이 많이 생길 것 같아요!"

msgid "message_13005_txt"
msgstr "그럼, 불러올게요!"

msgid "message_13006_txt"
msgstr "응! 부탁해!"

msgid "message_13007_txt"
msgstr "라이브를 향해 연습 열심히 하자~!"

msgid "message_13008_txt"
msgstr "오~!(^皿^*)"

msgid "message_13009_txt"
msgstr "의욕이 넘치네, 마키나"

msgid "message_13010_txt"
msgstr "그야 치어리딩이잖아!\\n의상도 미니스커트로\\n귀여운 느낌으로 했고"

msgid "message_13011_txt"
msgstr "분명 엄청 분위기가 달아오를 거야!"

msgid "message_13012_txt"
msgstr "하지만 댄스에 넣어보니까\\n의외로 어렵네, 치어리딩이라는 게"

msgid "message_13013_txt"
msgstr "평소보다 더\\n호흡을 딱 맞춰야 해"

msgid "message_13014_txt"
msgstr "포즈 맞추는 것도 정말 어렵습니다!"

msgid "message_13015_txt"
msgstr "응응, 발키리에게도\\n도전이라는 느낌이지"

msgid "message_13016_txt"
msgstr "하지만 성공하면 분위기가 달아오를 거야"

msgid "message_13017_txt"
msgstr "그래요, 기합 넣고 갑시다!"

msgid "message_13018_txt"
msgstr "그러고 보니, 이번 테마는\\n응원과 도전이지?"

msgid "message_13019_txt"
msgstr "프레프레는 응원하고 싶은 사람이 있어?"

msgid "message_13020_txt"
msgstr "음~ 열심히 하는 사람은\\n역시 응원하고 싶어지지~"

msgid "message_13021_txt"
msgstr "하야하야라든가?( *>ω< *)"

msgid "message_13022_txt"
msgstr "하야테는 별로…\\n조금 정도라는 느낌이에요!"

msgid "message_13023_txt"
msgstr "미안, 미안( *>ω< *)"

msgid "message_13024_txt"
msgstr "제가 윈더미어에 있었을 때,\\n많은 노래에게 용기를 받았어요"

msgid "message_13025_txt"
msgstr "그래서 앞으로 나아가자! 라고\\n생각할 수 있었죠"

msgid "message_13026_txt"
msgstr "그러니까 저도 힘내고 싶은 사람이나\\n힘내고 있는 사람에게 응원하는 마음이\\n닿았으면 좋겠다고 생각합니더!"

msgid "message_13027_txt"
msgstr "그렇구나… 카나카나는?"

msgid "message_13028_txt"
msgstr "나는… 그렇네.\\n버티고 싶은 사람들이려나?"

msgid "message_13029_txt"
msgstr "버티고 싶은 사람?"

msgid "message_13030_txt"
msgstr "응, 발키리가 막 만들어졌을\\n무렵에는 버텨야 하는\\n상황이 많았잖아?"

msgid "message_13031_txt"
msgstr "도와주는 사람들의 힘도 있었지만\\n노래 덕분에\\n버틸 수 있었던 것 같아"

msgid "message_13032_txt"
msgstr "그래서 힘내고 있는 사람이나 버티고 있는 사람에게\\n닿았으면 좋겠다고 생각해"

msgid "message_13033_txt"
msgstr "그렇구나…"

msgid "message_13034_txt"
msgstr "노래란 정말 대단하네.\\n사람의 마음을 바꾸는 힘이라든가…"

msgid "message_13035_txt"
msgstr "용기를 주는 힘이 있으니까"

msgid "message_13036_txt"
msgstr "예전부터 알고 있던 사실이지만\\n다시 한번 그렇게 느끼게 되네"

msgid "message_13037_txt"
msgstr "노래를 전하고 싶은 사람들을 위해\\n힘내야겠다고 생각합니더!"

msgid "message_13038_txt"
msgstr "…발키리도 더욱더\\n진화해 나가야겠지"

msgid "message_13039_txt"
msgstr "우리라면 분명 괜찮아!"

msgid "message_13040_txt"
msgstr "좋아, 그럼 슬슬\\n휴식은 끝내도록 할까!"

msgid "message_13041_txt"
msgstr "마키나, 레이나!\\n레슨 룸으로 돌아와 줘!"

msgid "message_13042_txt"
msgstr "네네~!( *´∀｀*)"

msgid "message_13043_txt"
msgstr "그럼 제가 미쿠모 씨를 찾아올게요!"

msgid "message_13044_txt"
msgstr "응, 부탁해^^"

msgid "message_13045_txt"
msgstr "본 공연까지 얼마 안 남았어!\\n기합 넣고 가자!"

msgid "message_13046_txt"
msgstr "그래서 이모님의\\n의상 디자인을\\n같이 생각하게 되었는데요…"

msgid "message_13047_txt"
msgstr "부디 여러분께도\\n협력해 주셨으면 합니다!"

msgid "message_13048_txt"
msgstr "물론이지~!\\n미라미라! 밀레밀레!"

msgid "message_13049_txt"
msgstr "그런데 왜 나한테도 부탁한 거야?"

msgid "message_13050_txt"
msgstr "의상 같은 건 잘 모른다고"

msgid "message_13051_txt"
msgstr "역시 여러 가지 관점에서\\n의견을 듣고 싶었기 때문에요"

msgid "message_13052_txt"
msgstr "다들 고마워~! 정말 큰 도움이 돼!"

msgid "message_13053_txt"
msgstr "맡겨 주세요, 이모님!"

msgid "message_13054_txt"
msgstr "미라쥬, 평소보다 의욕이 넘치네"

msgid "message_13055_txt"
msgstr "의욕이 넘치는 것도 당연해요!\\n이모님을 위해서니까요"

msgid "message_13056_txt"
msgstr "저도 있는 힘껏 협력하겠습니다!"

msgid "message_13057_txt"
msgstr "우선은… 이모님이 입고 싶다고 생각하는\\n의상에 대해 알려주세요"

msgid "message_13058_txt"
msgstr "입고 싶은 의상??"

msgid "message_13059_txt"
msgstr "대략적인 이미지라도 괜찮으니\\n이런 게 좋겠다고 생각하는 의상이 있나요?"

msgid "message_13060_txt"
msgstr "글쎄…\\n별로 입어본 적 없는 의상이라든가?"

msgid "message_13061_txt"
msgstr "모처럼 발키리와 합동 라이브에서\\n입는 거니까…"

msgid "message_13062_txt"
msgstr "새로운 기분이 들 수 있는 의상이 좋겠어"

msgid "message_13063_txt"
msgstr "그래도 Fire Bomber다운 느낌도\\n소중히 하고 싶달까…\\n정말 막연해서 미안해!"

msgid "message_13064_txt"
msgstr "천만에요!"

msgid "message_13065_txt"
msgstr "밀레밀레가 별로 입어보지 않은 의상이라…\\n폭신폭신 러블리하고 귀여운 느낌이라든가?"

msgid "message_13066_txt"
msgstr "섹시하고 자극적인 느낌?"

msgid "message_13067_txt"
msgstr "음… 다 좋은 느낌이긴 한데\\n나한테 어울리지 않을 것 같기도 하네…"

msgid "message_13068_txt"
msgstr "라이브까지 시간이 없고\\n빨리 정해야 한다고 생각하면 할수록\\n더 고민하게 돼…"

msgid "message_13069_txt"
msgstr "그렇게 서두를 필요 있냐?"

msgid "message_13070_txt"
msgstr "시간이 안 맞으면 그때는\\n발키리 의상을 입으면 되잖아"

msgid "message_13071_txt"
msgstr "발키리 의상을 입는다고?"

msgid "message_13072_txt"
msgstr "그래. 레이나에게 의상 데이터를 받아오면\\n가능하지 않겠어?"

msgid "message_13073_txt"
msgstr "그렇구나… 그거야!!"

msgid "message_13074_txt"
msgstr "이모님, 좋은 아이디어가 떠오르셨나요?"

msgid "message_13075_txt"
msgstr "응! 하야테 덕분에!"

msgid "message_13076_txt"
msgstr "나?\\n설마 진짜로 발키리 의상을 입을 생각이야?"

msgid "message_13077_txt"
msgstr "있잖아! 레이나!"

msgid "message_13078_txt"
msgstr "발키리의\\n의상 데이터를 받아도 돼!?"

msgid "message_13079_txt"
msgstr "확인, 즉시 준비"

msgid "message_13080_txt"
msgstr "의상 데이터 전송 완료"

msgid "message_13081_txt"
msgstr "역시 일 처리가 빠르네! 고마워!"

msgid "message_13082_txt"
msgstr "저기 마키나!\\n발키리 의상을 조금만\\n나답게 어레인지해도 될까!?"

msgid "message_13083_txt"
msgstr "물론이지!"

msgid "message_13084_txt"
msgstr "고마워!\\n그리고 다음은, 미라쥬!"

msgid "message_13085_txt"
msgstr "나다운 어레인지를 하기 위해\\n조금 의견을 줘!"

msgid "message_13086_txt"
msgstr "모두 덕분에 좋은 의상을 만들 수 있을 것 같아!"

msgid "message_13087_txt"
msgstr "좋아, 힘내자~!!"

msgid "message_13088_txt"
msgstr "그런 이유로, 지금부터 란란을 위해\\n함께 케이오스 견학 투어를 하겠습니다!"

msgid "message_13089_txt"
msgstr "잘 부탁드립니다!(*´▽｀*)"

msgid "message_13090_txt"
msgstr "견학 투어? 그게 뭐야"

msgid "message_13091_txt"
msgstr "발키리의 매력을\\n알아줬으면 해서"

msgid "message_13092_txt"
msgstr "하야하야 일행의 훈련이나\\n정비 모습을 보여주려고!"

msgid "message_13093_txt"
msgstr "그렇구나~"

msgid "message_13094_txt"
msgstr "아라드 대장님과 카나카나에게도\\n제대로 허락받았어!"

msgid "message_13095_txt"
msgstr "그 투어, 나도 가고 싶었는데"

msgid "message_13096_txt"
msgstr "그렇지, 루카?"

msgid "message_13097_txt"
msgstr "그러네요… 정말 흥미가 있습니다"

msgid "message_13098_txt"
msgstr "그러고 보니, 란카"

msgid "message_13099_txt"
