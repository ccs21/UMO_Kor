msgid "message_2810_txt"
msgstr "솔직하지 못하네"

msgid "message_2811_txt"
msgstr "시끄럽네"

msgid "message_2812_txt"
msgstr "모두의 선물이\\n정말 기뻐…(´;ω;｀)\\n이렇게 행복해도 되는 걸까…"

