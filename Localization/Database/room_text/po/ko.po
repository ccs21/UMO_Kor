msgid "message_3418_txt"
msgstr "마음껏 해킹할 수 있는 날"

msgid "message_3419_txt"
msgstr "그렇구나…그래서 그랬던 거구나^^；"

msgid "message_3420_txt"
msgstr "레이레이!\\n이번에는 어떤 이미지 데이터를 보내는 거야??"

msgid "message_3421_txt"
