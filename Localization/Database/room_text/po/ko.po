msgstr "이쪽도 준비 완료"

msgid "message_12371_txt"
msgstr "방도 완전 귀엽게 꾸몄고,\\n이제 파티가 시작되길 기다리기만 하면 돼!"

msgid "message_12372_txt"
msgstr "아까 프레이아 쨩에게\\n사진을 보여달라고 했는데…"

msgid "message_12373_txt"
msgstr "발키리 여러분의 케이크,\\n정말 맛있어 보이네요!"

msgid "message_12374_txt"
msgstr "척 특제"

msgid "message_12375_txt"
msgstr "란란 일행의 케이크도 귀엽네!"

msgid "message_12376_txt"
msgstr "셰릴 씨와 함께 만들었어요!\\n정성을 많이 들였어요!"

msgid "message_12377_txt"
msgstr "란카! 이쪽도 준비됐어!"

msgid "message_12378_txt"
msgstr "그러고 보니, 서프라이즈 쪽은 어때??"

msgid "message_12379_txt"
msgstr "서프라이즈?"

msgid "message_12380_txt"
msgstr "사실 밀레느 쨩에게\\n오빠에게 서프라이즈로 줄\\n크리스마스 선물 상담을 했어요"

msgid "message_12381_txt"
msgstr "뭘 고를지 몰라서…"

msgid "message_12382_txt"
msgstr "나도 Fire Bomber 멤버들에게 줄\\n선물을 고민하고 있어서… 란카에게 상담했어"

msgid "message_12383_txt"
msgstr "그래서 두 사람은 뭘 골랐어?"

msgid "message_12384_txt"
msgstr "나는 커플 목도리!"

msgid "message_12385_txt"
msgstr "저는 직접 만든 부적이에요!"

msgid "message_12386_txt"
msgstr "조금 어린애 같을까\\n생각하기도 했는데…"

msgid "message_12387_txt"
msgstr "그렇지 않아.\\n분명 기뻐할 거야!"

msgid "message_12388_txt"
msgstr "확실히 울면서 좋아할 것 같아!"

msgid "message_12389_txt"
msgstr "두 사람이 그렇게 말해주니까\\n정말 안심돼요!"

msgid "message_12390_txt"
msgstr "초대장, 요리, 케이크, 선물…\\n대부분 준비는 됐지만…"

msgid "message_12391_txt"
msgstr "남은 건… 바사라네"

msgid "message_12392_txt"
msgstr "남은 건 바사라가 와줄지,겠지"

msgid "message_12393_txt"
msgstr "초대장은 제대로 보냈어요!"

msgid "message_12394_txt"
msgstr "그리고 마음이 내키면 와주겠다고\\n말해줬어요!"

msgid "message_12395_txt"
msgstr "그러고 보니… 미쿠모도 안 보이네"

msgid "message_12396_txt"
msgstr "미쿠모는 걱정할 필요 없어"

msgid "message_12397_txt"
msgstr "같이 노래하기로 약속했으니까.\\n분명 와줄 거야"

msgid "message_12398_txt"
msgstr "그렇구나!\\n그럼 바사라는 나한테 맡겨!"

msgid "message_12399_txt"
msgstr "조금 찾아보고 올게!"

msgid "message_12400_txt"
msgstr "내가 꼭 데리고 올 테니까\\n두 사람은 안심하고 있어"

msgid "message_12401_txt"
msgstr "고마워.\\n믿고 맡길게, 밀레느 쨩"

msgid "message_12402_txt"
msgstr "고마워, 밀레느 쨩!"

msgid "message_12403_txt"
msgstr "자… 오늘은 먹고 노래하고 최고로\\n즐거운 파티로 만들어볼까?"

msgid "message_12404_txt"
msgstr "준비됐어?"

msgid "message_12405_txt"
msgstr "그럼 크리스마스 파티를\\n시작하자!"

msgid "message_12406_txt"
msgstr "라이브 분위기가 달아올랐네!"

msgid "message_12407_txt"
msgstr "네! 관객분들도 즐겨주셔서\\n정말 다행이에요!"

msgid "message_12408_txt"
msgstr "아직이야, 이제부터 더 달아오를 거야ー!\\n이 다음에는 민메이 씨 일행이 노래할 테니까!"

msgid "message_12409_txt"
msgstr "힘내세요, 민메이 씨!"

msgid "message_12410_txt"
msgstr "오늘 송년 라이브는\\n모두가 더 즐길 수 있는\\n댄스 넘버를 준비했어"

msgid "message_12411_txt"
msgstr "마키나 쨩, 연습에 함께해줘서\\n정말 고마워요!"

msgid "message_12412_txt"
msgstr "그래도 민민은 금방 춤을 춰버리잖아!\\n가르칠 게 전혀 없었어!"

msgid "message_12413_txt"
msgstr "역시"

msgid "message_12414_txt"
msgstr "그렇게 말해주면 기뻐!"

msgid "message_12415_txt"
msgstr "이제 본 무대에서 실수하지 않도록\\n열심히 해야겠다!"

msgid "message_12416_txt"
msgstr "그런데 이번 라이브의 테마,\\n정말 멋지네"

msgid "message_12417_txt"
msgstr "그렇지ー! 민민이 힌트를 줬거든!"

msgid "message_12418_txt"
msgstr "민민이 『발키리의 댄스곡을\\n부르고 싶어!』라고 말해줬으니까"

msgid "message_12419_txt"
msgstr "이번 라이브의 테마가 정해졌어!"

msgid "message_12420_txt"
msgstr "이번 테마는"

msgid "message_12421_txt"
msgstr "모두가 하고 싶은 걸\\n전부 하는 라이브…인 거네!"

msgid "message_12422_txt"
msgstr "처음 들었을 때는 깜짝 놀랐지만\\n성공해서 다행이야＾＾"

msgid "message_12423_txt"
msgstr "카나메가 하고 싶었던 건\\n무대에서 새해를 맞이하는 거였지"

msgid "message_12424_txt"
msgstr "응! 모두 함께\\n새해를 맞이하고 싶어서!"

msgid "message_12425_txt"
msgstr "나도 무대 연출에서\\n하고 싶은 걸 전부 하게 해줬어"

msgid "message_12426_txt"
msgstr "압도적이었다"

msgid "message_12427_txt"
msgstr "나도 란카 씨와 함께 노래할 수 있어서\\n진짜 기뻤어!"

msgid "message_12428_txt"
msgstr "응! 나도 즐거웠어!"

msgid "message_12429_txt"
msgstr "그러고 보니… 왜 민메이 씨는\\n발키리의 댄스곡을 부르고 싶다고\\n생각한 거예요?"

msgid "message_12430_txt"
msgstr "그러게… 잘 설명하기는 어렵지만"

msgid "message_12431_txt"
msgstr "좀 더 발키리 여러분을\\n알고 싶다고 생각해서…일까?"

msgid "message_12432_txt"
msgstr "더 알고 싶다…?"

msgid "message_12433_txt"
msgstr "무엇을 생각하고 어떤 마음으로 노래하는지\\n그 마음에 더 깊이 다가가고 싶다고\\n생각했어"

msgid "message_12434_txt"
msgstr "물론 셰릴 씨의 곡도,\\n란카 쨩의 곡도, Fire Bomber의 곡도\\n해보고 싶어"

msgid "message_12435_txt"
msgstr "여러분을 더 알고,\\n더 친해지고 싶으니까!"

msgid "message_12436_txt"
msgstr "좋아, 그럼 해보자!"

msgid "message_12437_txt"
msgstr "오늘 라이브 테마는\\n하고 싶은 걸 전부 하는 라이브"

msgid "message_12438_txt"
msgstr "하지만 제대로 할 수 있을까…?"

msgid "message_12439_txt"
msgstr "즐거운 마음을 관객들에게 전할 수 있다면\\n그게 제일 중요한 거야!"

msgid "message_12440_txt"
msgstr "그 전에"

msgid "message_12441_txt"
msgstr "슬슬 해가 바뀌겠어"

msgid "message_12442_txt"
msgstr "정말이다! 카운트다운 해야 해!"

msgid "message_12443_txt"
msgstr ""

msgid "message_12444_txt"
msgstr ""

msgid "message_12445_txt"
msgstr ""

msgid "message_12446_txt"
msgstr "새해 복 많이 받으세요!!"

msgid "message_12447_txt"
msgstr "란카 씨.\\n잠깐 괜찮으세요?"

msgid "message_12448_txt"
msgstr "루카 군, 무슨 일이야?"

msgid "message_12449_txt"
msgstr "그게… 어떻게 물어봐야 할지\\n고민되는데요…"

msgid "message_12450_txt"
msgstr "란카 씨,\\n최근에 무슨 일이 있었나요?"

msgid "message_12451_txt"
msgstr "그 나나세 씨가 말인데요…"

msgid "message_12452_txt"
msgstr "오늘 란카 씨가\\n평소와 달라 보였다고\\n걱정하고 있어서요"

msgid "message_12453_txt"
msgstr "란카, 무슨 일 있었어?"

msgid "message_12454_txt"
msgstr "음.\\n특별히 무슨 일이 있었던 건 아닌데…\\n왜 그럴까?"

msgid "message_12455_txt"
msgstr "일단 나,\\n나나 쨩에게 걱정하지 말라고\\n전하고 올게!"

msgid "message_12456_txt"
msgstr "네, 그렇게 해주세요"

msgid "message_12457_txt"
msgstr "루카도 고생이 많네"

msgid "message_12458_txt"
msgstr "어?"

msgid "message_12459_txt"
msgstr "그런데 란카 쨩,\\n대체 무슨 일이 있었던 걸까?"

msgid "message_12460_txt"
msgstr "그거, 어쩌면\\n내 탓일지도 몰라"

msgid "message_12461_txt"
msgstr "셰릴이?"

msgid "message_12462_txt"
msgstr "내가 이미지 캐릭터를 맡고 있는\\n화장품 브랜드, 알고 있지?"

msgid "message_12463_txt"
msgstr "아… 요즘 광고에서 자주 보이는 그거?"

msgid "message_12464_txt"
msgstr "세련된 어른의 매력이 넘치는 느낌의\\n브랜드잖아.\\n그게 무슨 일이야?"

msgid "message_12465_txt"
msgstr "사실 이번에 그 브랜드와 제휴해서\\n스페셜 라이브를 하게 됐는데"

msgid "message_12466_txt"
msgstr "그 라이브에 란카 쨩도\\n같이 나오지 않겠냐고 권했어"

msgid "message_12467_txt"
msgstr "란카 쨩은 요즘\\n『어른의 매력』을 끌어내기 위해\\n나와 특훈 중이거든"

msgid "message_12468_txt"
msgstr "어른의…!?"

msgid "message_12469_txt"
msgstr "매력…!?"

msgid "message_12470_txt"
msgstr "혹시 억지로 어른스럽고 쿨해지려고\\n너무 긴장하고 있었던 걸까…?"

msgid "message_12471_txt"
msgstr "나나 쨩에게 사과하고 왔어요!"

msgid "message_12472_txt"
msgstr "어서 와, 란카 쨩"

msgid "message_12473_txt"
msgstr "아, 셰릴 씨!"

msgid "message_12474_txt"
msgstr "저기, 들어주세요!"

msgid "message_12475_txt"
msgstr "나나 쨩은 내가 평소와 달라 보여서\\n걱정해줬던 것 같은데…"

msgid "message_12476_txt"
msgstr "『말 걸기 어렵다』고 느낀 건,\\n그때의 내가…"

msgid "message_12477_txt"
msgstr "평소와 다르게 정말 정말\\n멋져 보였기 때문이래요!\\n(*´∀｀*)"

msgid "message_12478_txt"
msgstr "란카가, 멋져 보였다고…?"

msgid "message_12479_txt"
msgstr "그랬던 건가요…?"

msgid "message_12480_txt"
msgstr "나는 잘 모르겠지만…\\n신비로웠다든가, 오라가 있었다든가\\n말해줬어요!"

msgid "message_12481_txt"
msgstr "분명 셰릴 씨에게\\n배운 게\\n도움이 된 것 같아요!"

msgid "message_12482_txt"
msgstr "셰릴 씨.\\n정말 감사합니다!"

msgid "message_12483_txt"
msgstr "다행이야.\\n그런 일이었던 거구나"

msgid "message_12484_txt"
msgstr "나나 쨩도 타이업 라이브에\\n와준다고 했어요!"

msgid "message_12485_txt"
msgstr "정말? 그럼\\n맨 앞자리 티켓을 준비해줘야겠네"

msgid "message_12486_txt"
msgstr "우리도 미호시 학원의 멤버로\\n응원하러 갈게!"

msgid "message_12487_txt"
msgstr "라고 하네, 란카 쨩.\\n이건 열심히 하지 않을 수 없겠네!"

msgid "message_12488_txt"
msgstr "네! 열심히 할게요!"

msgid "message_12489_txt"
msgstr "여러분. 내가 없는 동안\\n곤란한 일은 없었을까?"

msgid "message_12490_txt"
msgstr "내일이면 라그나로 돌아가.\\n선물 기대하고 있어줘!"

msgid "message_12491_txt"
msgstr "와ー이!。.:*゜(n´∀｀)n゜*:.。\\n카나카나, 기다리고 있을게~!"

msgid "message_12492_txt"
msgstr "이쪽은 평온무사"

msgid "message_12493_txt"
msgstr "카나메 씨가 돌아오길\\n기대하며 기다리고 있어요!"

msgid "message_12494_txt"
msgstr "조심해서\\n돌아오세요!(>▽<)"

msgid "message_12495_txt"
msgstr "고마워!\\n나도 3일 만에 모두를 만날 생각에\\n기대하고 있어"

msgid "message_12496_txt"
msgstr "저기저기 카나카나.\\n여행은 어땠어?"

msgid "message_12497_txt"
msgstr "분명 그곳은 바다와 산 레저로\\n유명한 행성이었지!"

msgid "message_12498_txt"
msgstr "최근에는 은하 최대급 쇼핑몰도\\n생겨서 조금 화제가 됐으니까\\n나도 궁금했는데~( *>ω< *)"

msgid "message_12499_txt"
msgstr "헤에, 그랬구나…"

msgid "message_12500_txt"
msgstr "사실 나는 아무런 사전 조사도 없이\\n이 행성에 와봤어"

msgid "message_12501_txt"
msgstr "그래서 쇼핑몰이 있다는 것도\\n처음 알았어＾＾；"

msgid "message_12502_txt"
msgstr "에에ー!?Σ(ﾟ□ﾟ)"

msgid "message_12503_txt"
msgstr "그 카나메가\\n즉흥적으로…!?"

msgid "message_12504_txt"
msgstr "카나메.\\n너 지금 그 행성의\\n어느 쪽에 있어?"

msgid "message_12505_txt"
msgstr "음. 어느 쪽이라고\\n해야 할지 모르겠지만…"

msgid "message_12506_txt"
msgstr "이 근처는 변경 지역인 것 같아"

msgid "message_12507_txt"
msgstr "손대지 않은 자연이 많고\\n공기도 물도 맛있어!"

msgid "message_12508_txt"
msgstr "사람들도 왠지 따뜻하고…\\n소박한 다정함을 느꼈다고\\n해야 할까"

msgid "message_12509_txt"
msgstr "고리고리~!"

msgid "message_12510_txt"
msgstr "카나메 씨가 그렇게까지 말할 정도라면\\n분명 멋진 곳이겠네요…!"

msgid "message_12511_txt"
msgstr "즉흥적인 여행이라고\\n들었을 때는 놀랐지만…!"

msgid "message_12512_txt"
msgstr "멋진 곳에서\\n휴가를 보낼 수 있었다니\\n정말 다행이에요!(*´∀｀*)"

msgid "message_12513_txt"
msgstr "당신답지 않게\\n과감한 행동을 했네"

msgid "message_12514_txt"
msgstr "혹시 바사라의 영향?"

msgid "message_12515_txt"
msgstr "미쿠모는 정말 날카롭네…＾＾；"

msgid "message_12516_txt"
msgstr "바사라 씨가\\n무슨 일이라도 있었나요?"

msgid "message_12517_txt"
msgstr "나는 말이야. 여행을 간다면\\n제대로 계획을 세운 뒤 가야 한다고\\n생각했어"

msgid "message_12518_txt"
msgstr "하지만 바사라 씨가 『일단\\n아무 생각도 하지 말고 나가봐』\\n라고 해서…"

msgid "message_12519_txt"
msgstr "그 말이 없었다면\\n나는 언제까지고\\n떠나지 못했을 것 같아"

msgid "message_12520_txt"
msgstr "카나메!\\n여행, 즐거웠던 것 같아서 다행이야!"

msgid "message_12521_txt"
msgstr "여행이 아니라, 여정이다"

msgid "message_12522_txt"
msgstr "후훗. 그렇네요!\\n여행, 즐거웠어요!"

msgid "message_12523_txt"
msgstr "바사라 씨.\\n조언해 주셔서\\n정말 감사합니다!"

msgid "message_12524_txt"
msgstr "감사 인사는 필요 없어.\\n마지막에는 네가 스스로 결정한 거니까"

