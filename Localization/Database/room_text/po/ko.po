msgid "message_2870_txt"
msgstr "초시공 네트워크 조정이라니…\\n루카와 브레라는 그런 일도 하고 있구나"

msgid "message_2871_txt"
msgstr "한가해 보여서 부탁했어"

msgid "message_2872_txt"
