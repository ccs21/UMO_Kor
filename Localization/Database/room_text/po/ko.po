msgid "message_11738_txt"
msgstr ""

msgid "message_11739_txt"
msgstr "그 노래 때문인지는 모르겠지만\\n고래가 갑자기 흥분해서…"

msgid "message_11740_txt"
msgstr "갑자기 점프하는 바람에\\n갑판에 있던 사람 모두가\\n흠뻑 젖어버렸지!"

msgid "message_11741_txt"
msgstr "에에!?Σ(ﾟ□ﾟ)\\n괘, 괜찮았어!?"

msgid "message_11742_txt"
msgstr "고래에게 노래가 닿았던 거야"

msgid "message_11743_txt"
msgstr "흠뻑 젖게 만들어서\\n오히려 나도 불타올랐지"

msgid "message_11744_txt"
msgstr "잘하는데! 라고 생각했어"

msgid "message_11745_txt"
msgstr "정말이지!\\n우리는 완전 민폐였다고!"

msgid "message_11746_txt"
msgstr "…뭐 그래도 덕분에 배에 실려 있던\\n민족 의상을 빌려 입을 수 있었다는\\n희귀한 경험을 하긴 했지만!"

msgid "message_11747_txt"
msgstr "민족 의상?"

msgid "message_11748_txt"
msgstr "방금 사진을 보냈어.\\n이 행성의 선원들이 입는\\n옷이래!"

msgid "message_11749_txt"
msgstr "봐! 바사라 같은 경우는\\n꽤 잘 어울린다고 생각하지 않아?"

msgid "message_11750_txt"
msgstr "와아, 정말이네요!\\n정말 바다의 남자라는 느낌이에요"

msgid "message_11751_txt"
msgstr "마키나, 무슨 일이야?"

msgid "message_11752_txt"
msgstr "미레미레!\\n그 행성에 있는 동안 이 복장의 사진을\\n잔뜩 찍어서 보내주지 않을래!?"

msgid "message_11753_txt"
msgstr "다음 발키리 의상은 이걸로 하고 싶어!\\n좋지? 카나카나!"

msgid "message_11754_txt"
msgstr "후훗. 생각하는 건 같았네.\\n물론 좋아!"

msgid "message_11755_txt"
msgstr "해냈다ー!。.:*゜(n´∀｀)n゜*:.。"

msgid "message_11756_txt"
msgstr "미레미레, 좋은 아이디어 고마워!\\n정말 큰 도움이 됐어!"

msgid "message_11757_txt"
msgstr "도움이 됐다니 다행이야!\\n마키나, 힘내!"

msgid "message_11758_txt"
msgstr "셰릴 씨.\\n지금 괜찮으세요?"

msgid "message_11759_txt"
msgstr "루카! 기다리고 있었어!"

msgid "message_11760_txt"
msgstr "그 발키리 말이지, 알아낸 거야!?"

msgid "message_11761_txt"
msgstr "저기…"

msgid "message_11762_txt"
msgstr "그 발키리라는 게\\n전에 셰릴 씨가 봤다는…"

msgid "message_11763_txt"
msgstr "그래. 프론티어 상공의 우주를\\n천천히 비행하고 있었다고 하더군"

msgid "message_11764_txt"
msgstr "그래서 루카.\\n어땠어?"

msgid "message_11765_txt"
