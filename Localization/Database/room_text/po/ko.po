msgid "message_0774_txt"
msgstr "그렇군."

msgid "message_0775_txt"
msgstr "여자의 마음이라… 그러고 보니\\n나도 가끔 그런 말을 듣는 것 같네."

msgid "message_0776_txt"
msgstr "알토와 히카루라면,\\n감상을 물어봤을 때\\n뭐라고 대답할 거야?"

msgid "message_0777_txt"
