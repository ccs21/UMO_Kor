msgid "message_0782_txt"
msgstr "아니."

msgid "message_0783_txt"
msgstr "그렇지."

msgid "message_0784_txt"
msgstr "뭐, 지금부터라도 이것저것 배워두자.\\n매번 화내는 것도 싫고 말이야."

msgid "message_0785_txt"
