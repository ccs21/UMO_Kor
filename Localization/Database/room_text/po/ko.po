msgid "message_12300_txt"
msgstr "프레이아, 계속 룬피카 상태였다"

msgid "message_12301_txt"
msgstr "그러게"

msgid "message_12302_txt"
msgstr "하야테!?"

msgid "message_12303_txt"
msgstr "어머? 하야테 군, 혹시\\n발키리 카페에 갔어?"

msgid "message_12304_txt"
msgstr "휴식하는 김에 갔는데…\\n프레이아, 엄청 정신없이 움직이더라"

