msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "talk_time_01"
msgstr "수고하셨습니다!...후후,\n이 인사말, 아이돌 같지 않아?"

msgid "talk_time_02"
msgstr "내가 아이돌이라니,\n지금도 꿈만 같아"

msgid "talk_time_03"
msgstr "헉! 머리가 뻗쳤어~!\n…이걸로 괜찮아졌으려나?"

msgid "talk_time_04"
msgstr "레슨은 힘들지만\n그만큼 재미있어!"

msgid "talk_time_05"
msgstr "나, 젠트라디랑\n섞인 쿼터야"

msgid "talk_time_06"
msgstr "어라?\n어디로 간 걸까...?"

msgid "talk_time_07"
msgstr ""

msgid "talk_time_08"
msgstr "셰릴 씨의 라이브,\n또 가고 싶다…"

msgid "talk_login_01"
msgstr "좋은 아침!\n오늘도 힘내자!"

msgid "talk_login_02"
msgstr "자 여기, 냥냥 명물 참치 만두!\n맛있어요!"

msgid "talk_login_03"
msgstr "아, TV에 셰릴 씨가\n나오고 있어! 아름답다…"

msgid "talk_login_04"
msgstr "오늘도 수고했어!\n느긋하게 쉬다 가"

msgid "talk_login_05"
msgstr "네가 안 자고 있으면,\n나도 좀 더 깨어 있을까"

msgid "talk_comeback_01"
msgstr "오랜만이야!\n다시 만나서 기뻐"

msgid "talk_comeback_02"
msgstr "오늘도 같이 힘내자!"

msgid "talk_birthday_01"
msgstr "와, 내 생일,\n축하해주는 거야?\n기뻐, 고마워!"

msgid "talk_event_01"
msgstr "오빠가 세뱃돈을 줬어.\n나, 이제 어린애 아닌데…"

msgid "talk_event_02"
msgstr "으음… 알토 군은,\n어떤 초콜릿을 좋아하려나…"

msgid "talk_event_03"
msgstr "오늘은 세쓰분이래!\n왈큐레 모두는\n콩 뿌리기를 했다나 봐!"

msgid "talk_event_04"
msgstr "오늘은 히나마쓰리네!\n에헤헤, 나나와 함께\n히나 인형을 장식할 거야"

msgid "talk_event_05"
msgstr "화이트데이는 왠지\n두근두근하지…"

msgid "talk_event_06"
msgstr "만우절은 거짓말을 해도\n되는 날이래!\n어떤 거짓말이 좋을까?"

msgid "talk_event_07"
msgstr "쉬는 동안에도,\n노래 레슨은 빠뜨리지 않아!"

msgid "talk_event_08"
msgstr "웨딩드레스,\n한 번만이라도 입어보고 싶다…"

msgid "talk_event_09"
msgstr "탄자쿠에 소원을 적고 왔어.\n알토 군과 셰릴 씨와,\n계속 함께 있을 수 있기를 바란다고!"

msgid "talk_event_10"
msgstr "덥다… 오빠한테 아이스크림이라도\n사다 달라고 할까"

msgid "talk_event_11"
msgstr "셰릴 씨의 유카타 차림…\n정말 멋졌어"

msgid "talk_event_12"
msgstr "달이 잘 보이는 곳,\n알려줄까?"

msgid "talk_event_13"
msgstr "브레라 씨한테 할로윈에 대해\n알려줬어!\n그랬더니,\n올해는 과자를 준비해준대!"

msgid "talk_event_14"
msgstr "일루미네이션,\n정말 아름답다!"

msgid "talk_event_15"
msgstr "나한테는 매년 산타가\n찾아와. 산타의\n정체는 이미 알고 있지만!"

msgid "talk_event_16"
msgstr "해가 바뀌는 순간은,\n왠지 두근두근하지?"

msgid "talk_event_17"
msgstr "내 노래가 이렇게 많은 사람에게\n전해지고 있다니…\n나, 더 열심히 할게!"

msgid "talk_event_18"
msgstr "배, 백, 백만!?\n우와, 대단해~!\n모두, 고마워!"

msgid "talk_event_19"
msgstr "200만 다운로드 달성!\n대단해~!"

msgid "talk_event_20"
msgstr "1주년이네. 내 노래를\n많이 들어줘서 고마워"

msgid "touch_reaction_01"
msgstr "에헤헤. 왜?"

msgid "touch_reaction_02"
msgstr "정말~,\n너무 빤히 쳐다보지 마"

msgid "touch_reaction_03"
msgstr "꺅!\n어, 어디 만지는 거야!?"

msgid "touch_reaction_04"
msgstr "수고하셨어요! …후훗,\n이 인사, 아이돌 같으려나?"

msgid "touch_reaction_05"
msgstr "내가 아이돌이라니,\n지금도 꿈만 같아"

msgid "touch_reaction_06"
msgstr "아와와! 머리가 뻗쳤어~!\n…이제 괜찮아졌나?"

msgid "touch_reaction_07"
msgstr "너, 너무 놀리지 마!"

msgid "touch_reaction_08"
msgstr "에헤헤… 쓰다듬어지는 건\n왠지 부끄럽네"

msgid "login_reaction_01"
msgstr "자, 이거 받아!"

msgid "login_reaction_02"
msgstr "기뻐해주면 좋겠어!"

msgid "simulation_result_01"
msgstr "시뮬레이션인데도\n엄청 긴장해버렸어.\n제대로 노래했지…?"

msgid "go_diva_result_01"
msgstr "더 잘 노래할 수 있도록,\n레슨 열심히 해야겠어!"

msgid "go_diva_result_02"
msgstr "…나, 조금은 변했을까?"

msgid "go_diva_result_03"
msgstr "다음 라이브, 꼭 보러 와줘!　\n약속이야?"

msgid "intimacy_pointup_01"
msgstr "해냈다!"

msgid "intimacy_pointup_02"
msgstr "와아!"

msgid "intimacy_pointup_03"
msgstr "에헤헤"

msgid "present_01"
msgstr "고마워!"

msgid "present_02"
msgstr "배고프다…\n다 같이 뭐라도 먹으러 가고 싶어!"

msgid "present_03"
msgstr "맛있어 보이는 걸 보면,\n나도 모르게 먹고 싶어지지!"

msgid "present_04"
msgstr "너무 많이 먹으면 살찌려나…\n그래도 시간이 시간이니까…"

msgid "present_05"
msgstr "왠지 기분이 안 나네…\n재미있는 일, 없을까?"

msgid "present_06"
msgstr "레슨도 끝났고,\n뭔가 재미있는 걸 하고 싶어!"

msgid "present_07"
msgstr "으음…\n조금만 기분 전환하고 싶다"

msgid "present_08"
msgstr "그냥 귀엽기만 한 것보다,\n조금 독특한 걸 좋아하는 것 같아"

msgid "present_09"
msgstr "내 취향은 가끔\n이해받지 못하기도 해…"

msgid "present_10"
msgstr "주변 물건을 바꾸면,\n기분도 꽤 달라지지"

msgid "present_11"
msgstr "해냈다!"

msgid "cs_touch_reaction_01"
msgstr "네~! 왜?"

msgid "cs_touch_reaction_02"
msgstr "…정말, 오빠도 참…"

msgid "cs_touch_reaction_03"
msgstr "앗, 왜 그래?"

msgid "cs_touch_reaction_04"
msgstr "있잖아, 잘 지내?"

msgid "cs_touch_reaction_05"
msgstr "마음껏 노래하고 싶다.\n라이브가 기대돼!"

msgid "cs_touch_reaction_06"
msgstr "의상, 잘 어울리려나?\n이상한 데는 없어?"

msgid "cs_touch_reaction_07"
msgstr "헤어스타일 정하는 건 어렵네…\n어떤 게 어울릴 것 같아?"

msgid "cs_touch_reaction_08"
msgstr "짜잔!\n냥냥 특제, 참치만두야!"

msgid "cs_touch_reaction_09"
msgstr "있잖아, 같이 이야기하자!"

msgid "cs_touch_reaction_10"
msgstr "있잖아, 너는 어떤 노래를 좋아해?"

msgid "talk_event_21"
msgstr "프레이아, 하야테 군한테 받\n은 생일 선물이 정말 기뻤대.\n뭘 받았을까?"

msgid "talk_event_22"
msgstr "미쿠모 씨가 생일 케이크를\n먹는 모습이라든가…\n후훗, 조금 보고 싶네"

msgid "talk_event_23"
msgstr "카나메 씨, 생일 축하\n드립니다! 저도 카나메 씨 같은\n멋진 어른이 되도록 노력할게요!"

msgid "talk_event_24"
msgstr "마키나 씨, 생일 축하\n드립니다! 항상 상담해\n주셔서 감사해요!"

msgid "talk_event_25"
msgstr "레이나 씨 생일 파티\n사진이 왜인지\n루카 군한테 잔뜩\n도착한 모양이야. 왜지?"

msgid "talk_event_26"
msgstr "란카"

msgid "talk_event_27"
msgstr "셰릴 씨와 함께 노래할 때가,\n가장 행복해… 앞으로도,\n계속 함께 노래하고 싶어"

msgid "talk_event_28"
msgstr "바사라 씨가 선물은 어떻게\n고르는 거냐고 상담해왔는데,\n혹시 밀레느에게 주려는 건가?"

msgid "talk_event_29"
msgstr "『생일을 축하해주고 싶은데 바사라가\n도무지 잡히질 않아!』라면서,\n밀레느가 화내고 있었어요"

msgid "talk_event_30"
msgstr "민메이 씨, 오늘은 생일\n이라서,\n히카루 씨와 외출할\n예정이래!"

msgid "talk_event_31"
msgstr "하야테 군, 생일 축하해!　\n프레이아한테 늘 이야기\n듣고 있어. 앞으로도 사이좋게 지내!"

msgid "talk_event_32"
msgstr "미라쥬"

msgid "talk_event_33"
msgstr "메서"

msgid "talk_event_34"
msgstr "아라드"

msgid "talk_event_35"
msgstr "척"

msgid "talk_event_36"
msgstr "해피 버스데이, 알토 군!"

msgid "talk_event_37"
msgstr "오빠 생일 파티에,\nS.M.S 사람들이 많이 와줬어.\n오빠, 정말 사랑받고 있구나… 후훗"

msgid "talk_event_38"
msgstr "레이"

msgid "talk_event_39"
msgstr "히카루"

msgid "talk_event_40"
msgstr "감린"

msgid "talk_event_41"
msgstr "미사"

msgid "talk_event_42"
msgstr "우리 영화가 시작한대!\n와~ 두근두근해!"

msgid "talk_event_43"
msgstr "오랫동안 곁에서 받쳐줘서 정말\n고마워… 있잖아, 네가 보기엔\n나, 조금은 성장했을까?"

msgid "talk_event_44"
msgstr "알토 군이나 미셸 군도 대단하지만,\n너도 대단했어! 네가 있어\n줬으니까 나도 안심하고 노래할 수 있었어"

msgid "talk_event_45"
msgstr "언젠가 다시 모두와 노래할 날을 위해\n나, 더더욱\n노래랑 일에 힘써야겠어!"

msgid "talk_event_46"
msgstr "오빠와 함께 들어\n본 적은 있었지만, 역시\nFire Bomber는 대단했어!"

msgid "talk_event_47"
msgstr "나도 셰릴 씨와 민메이 씨를\n본받아, 은하에 이름을 떨칠 수 있는\n가희를 목표로 열심히 해야겠어!"
