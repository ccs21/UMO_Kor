msgstr "찬성~!"

msgid "adv_102701_0034_msg"
msgstr "후훗. 그러네, 가볼까!"

msgid "adv_102701_0036_msg"
msgstr "찬성"

msgid "adv_102701_0038_msg"
msgstr "하야테. 잠깐 괜찮을까?"

msgid "adv_102701_0039_msg"
msgstr "응? 뭔데?"

msgid "adv_102701_0040_msg"
msgstr "이거 맡겨둘게. 잘 부탁해"

msgid "adv_102701_0041_msg"
