msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "adv_000001_0002_msg"
msgstr "프레이아, 하야테 군.\\n출격할 준비 됐어?"

msgid "adv_000001_0003_msg"
msgstr "호이나!\\n오늘도 고리고리하게 힘낼게!"

msgid "adv_000001_0004_msg"
msgstr "그런데, 이번 적은 뭐지?\\n공중기사단과는 많이 달랐었는데"

msgid "adv_000001_0005_msg"
msgstr "역시 닮은 듯 안 닮았지?"

msgid "adv_000001_0006_msg"
msgstr "...저게, 초고대 시스템 「새인간」.\\n우리가 싸울 상대야"

msgid "adv_000001_0007_msg"
msgstr "두 사람 모두 조금 전에 설명한 건 기억하고 있어?"

msgid "adv_000001_0008_msg"
msgstr "아, 그 새인간이라는 녀석 때문에\\n여러 사람의 기억을 잃어 버렸다고 했었지"

msgid "adv_000001_0009_msg"
msgstr "그리고... 그 새인간과 맞설 수\\n있는게, 생체 폴드파를 가진\\n우리들 왈큐레란 거죠"

msgid "adv_000001_0010_msg"
msgstr "그래, 맞아. 하지만 이렇게 싸우는 건 처음이니까\\n어쨌든 조심하자"

msgid "adv_000001_0011_msg"
msgstr "호이나!\\n그래도 우리가 하는 일은 안 바뀌잖아요!"

msgid "adv_000001_0012_msg"
msgstr "뭐, 그런 거지"

msgid "adv_000001_0013_msg"
msgstr "두 사람 모두 든든하네.\\n그럼 준비하자"

msgid "adv_000002_0002_msg"
msgstr "프레이아, 하야테 군, 괜찮아?"

msgid "adv_000002_0003_msg"
msgstr "아, 문제 없어.\\n이제 곧 다 쓰러뜨릴 수 있을 것 같아"

msgid "adv_000002_0004_msg"
msgstr "하지만 하야테, 평소보다 더 고전하는 것 같네…"

msgid "adv_000002_0005_msg"
msgstr "우리의 노래와 하야테 군과의 호흡이 잘 맞으면\\n잘 될 텐데…"

msgid "adv_000002_0006_msg"
msgstr "역시 우리들의 노래의 힘을\\n좀 더 키워야 할 것 같네"

msgid "adv_000002_0007_msg"
msgstr "무슨 말이야?"

msgid "adv_000002_0008_msg"
msgstr "즉, 생체 폴드파를 증폭시켜서\\n하야테 군에게 더 많이 노래를 전할 수 있다는 뜻이야"

msgid "adv_000002_0009_msg"
msgstr "그런데 어떻게 해야 증폭시킬 수 있으려나.\\n아까도 제대로 평소처럼 노래를 불렀잖아?"

msgid "adv_000002_0010_msg"
msgstr "한 가지 생각이 있어.\\n에피소드 플레이트를 사용해 보자"

msgid "adv_000002_0011_msg"
msgstr "에피소드 플레이트... 처음 들어보는 말이네?"

msgid "adv_000002_0012_msg"
msgstr "괜찮아, 지금부터 자세히 설명할게.\\n프레이아, 따라와"

msgid "adv_000003_0002_msg"
msgstr "기다렸지, 이걸로 출격 전 준비는 끝났어"

msgid "adv_000003_0003_msg"
msgstr "그럼, 프레이아.\\n좋은 느낌으로 부탁할게"

msgid "adv_000003_0004_msg"
msgstr "맡겨줘, 하야테!"

msgid "adv_000003_0005_msg"
msgstr "어떤 적이 나와도 내가\\n노래로 고리고리하게 응원해줄게!"

msgid "adv_000003_0006_msg"
msgstr "그래, 한 번에 정리할게!"

msgid "adv_000003_0007_msg"
msgstr "둘 다, 그럼 가자!"

msgid "adv_000004_0002_msg"
msgstr "프레이아, 고마워.\\n네 노래, 잘 들렸어"

msgid "adv_000004_0003_msg"
msgstr "정말!? 에피소드 플레이트 덕분이네!"

msgid "adv_000004_0004_msg"
msgstr "아...그러고 보니 카나메 씨.\\n아까 노래할 때 머릿속에 영상이\\n흘러나오는 느낌이 들었어요"

msgid "adv_000004_0005_msg"
msgstr "처음 노래할 때는\\n그런 느낌 없었는데"

msgid "adv_000004_0006_msg"
msgstr "혹시 그게 잃어버린 기억이었던 걸까...?\\n아무튼, 작전이 성공해서 다행이네"

msgid "adv_000004_0007_msg"
msgstr "델타 소대원들과 왈큐레가 힘을 합치면\\n분명 세상도 금방 원래대로 돌아갈 수 있을 것 같네요!"

msgid "adv_000004_0008_msg"
msgstr "그렇겠네. 하지만 더 굉장한 협력자도 있는데?"

msgid "adv_000004_0009_msg"
msgstr "협력자라니, 우리 말고도?"

msgid "adv_000004_0010_msg"
msgstr "응, 레이나가 개발한 초시공 SNS에 말야"

msgid "adv_000004_0011_msg"
msgstr "초시공...SNS?"

msgid "adv_000004_0012_msg"
msgstr "맞아.\\n단말기를 지급할 테니 설명을 잘 들어둬"

msgid "adv_000004_0015_msg"
msgstr "오오!\\n초시공 SNS 정말 대단하네!"

msgid "adv_000004_0016_msg"
msgstr "이걸 사용하여 모두가 힘을 합치면\\n기억을 지켜낼 수 있을 거야"

msgid "adv_000004_0017_msg"
msgstr "이것은 은하와 우리의 기억을 지키는 싸움이야.\\n프레이아, 하야테 군, 같이 힘내보자!"

msgid "adv_000004_0018_msg"
msgstr "아, 물론이지!"

msgid "adv_000004_0019_msg"
msgstr "넵! 맡겨주세요!"

msgid "adv_000004_0020_msg"
msgstr "그러고 보니 오늘 케이오스 라그나 지부에\\n우리와 함께 일할 새로운 동료가 합류한다고 하네"

msgid "adv_000004_0021_msg"
msgstr "그러고 보니 미라쥬가 그런 얘길 했었지"

msgid "adv_000004_0022_msg"
msgstr "새로운 동료... 어떤 사람일까?"

msgid "adv_000005_0002_msg"
msgstr "기다리고 있었습니다.\\n당신이 저희에게 협력해주신다고 한 분이시죠?"

msgid "adv_000005_0003_msg"
msgstr "처음 뵙겠습니다.\\n저는 케이오스 라그나 지부 델타 소대 소속\\n미라쥬 파리나 지너스입니다"

msgid "adv_000005_0004_msg"
msgstr "당신을 지원하라는 지시를 받고 왔습니다.\\n잘 부탁드립니다"

msgid "adv_000005_0005_msg"
msgstr "우선 입대 절차를 진행할 테니,\\n이 서류에 서명해 주십시오"

msgid "adv_000005_0007_msg"
msgstr "그럼 다음으로 함께 싸우게 될 가희 여러분을 소개하겠습니다"

msgid "adv_000006_0002_msg"
msgstr "이걸로 준비는 완료되었습니다"

msgid "adv_000006_0003_msg"
msgstr "앞으로의 전투에서는 하야테 소위가\\n당신을 지원해 줄 겁니다"

msgid "adv_000006_0005_msg"
msgstr "이제부터 새의 인간과의 싸움이 시작되겠지만,\\n당신과 가희 여러분의 힘이 있다면,\\n분명 잘 해낼 수 있을 겁니다"

msgid "adv_000006_0006_msg"
msgstr "그럼 저는 이만 실례하겠습니다"

msgid "adv_000006_0007_msg"
msgstr "머지않아 전장에서\\n다시 만나게 될 것 같습니다만…"

msgid "adv_000006_0008_msg"
msgstr "그날까지 부디 무사하시길"

msgid "adv_100101_0002_msg"
msgstr "이번에는 알 샤할에서 라이브인가"

msgid "adv_100101_0003_msg"
msgstr "…여기 오면 처음 진짜 왈큐레를\\n만났을 때의 두근거림이 생각나네"

msgid "adv_100101_0004_msg"
msgstr "노래가 들려오고, 미쿠모 씨가\\n엄청 멋있었고…"

msgid "adv_100101_0006_msg"
msgstr ""

msgid "adv_100101_0007_msg"
msgstr "들려줄게, 여신의 노래를"

msgid "adv_100101_0009_msg"
msgstr "초시공 비너스, 왈큐레!"

msgid "adv_100101_0011_msg"
msgstr "내가 뭐 어쨌는데?"

msgid "adv_100101_0012_msg"
msgstr "미, 미쿠모 씨!"

msgid "adv_100101_0013_msg"
msgstr "처음 봤을 때 네가 멋있었다더라고"

msgid "adv_100101_0014_msg"
msgstr "하야테! 왜 그걸 말해버리는 거야!"

msgid "adv_100101_0015_msg"
msgstr "하지만 지금의 당신은 우리와 같잖아"

msgid "adv_100101_0016_msg"
msgstr "어?"

msgid "adv_100101_0017_msg"
msgstr "…그러네. 지금은 나도 왈큐레지"

msgid "adv_100101_0018_msg"
msgstr "아직 좀 위태위태하지만 말이지"

msgid "adv_100101_0019_msg"
msgstr "하야테!"

msgid "adv_100101_0020_msg"
msgstr "…그나저나 생각했던 것보다 훨씬 많은 사람들의\\n기억이 사라진 것 같네"

msgid "adv_100101_0021_msg"
msgstr "그래, 어떻게든 해야지"

msgid "adv_100101_0022_msg"
msgstr "프레이아, 슬슬 준비됐니?"

msgid "adv_100101_0023_msg"
msgstr "네엣!　기운 팍팍 내서 노래할게요!"

msgid "adv_100102_0002_msg"
msgstr "아까까지 넋이 나가 있던 녀석들도,\\n표정이 돌아왔네"

msgid "adv_100102_0003_msg"
msgstr "그래, 아무래도 기억을 되찾은 것 같네"

msgid "adv_100102_0005_msg"
msgstr "아, 여기 있었네!"

msgid "adv_100102_0006_msg"
msgstr "프레이아?"

msgid "adv_100102_0007_msg"
msgstr "하야테, 메서 씨가 부르고 있어!\\n뭔가 할 말이 있대"

msgid "adv_100102_0008_msg"
msgstr "…헉"

msgid "adv_100102_0009_msg"
msgstr "이번엔 또 뭘 한 거야?"

msgid "adv_100102_0010_msg"
msgstr "시끄러워.\\n…쳇, 어쩔 수 없지. 먼저 돌아가 있을게"

msgid "adv_100102_0011_msg"
msgstr "으히히…"

msgid "adv_100102_0013_msg"
msgstr "…있잖아, 프레이아.\\n너한테 가장 소중한 기억은 뭐니?"

msgid "adv_100102_0014_msg"
msgstr "음… 갑자기 물어보면\\n하나만 고르긴 어렵네…"

msgid "adv_100102_0015_msg"
msgstr "그래도 왈큐레 모두를 만난 기억은\\n정말 소중한 기억이에요!"

msgid "adv_100102_0016_msg"
msgstr "그래"

msgid "adv_100102_0017_msg"
msgstr "미쿠모 씨에게 소중한 기억은 뭔가요?"

msgid "adv_100102_0018_msg"
msgstr "알고 싶어?"

msgid "adv_100102_0019_msg"
msgstr "네, 네! 엄청 알고 싶어요!"

msgid "adv_100102_0020_msg"
msgstr "안 가르쳐 줄 거야"

msgid "adv_100102_0021_msg"
msgstr "미, 미스터리해…"

msgid "adv_100102_0022_msg"
msgstr "후훗"

msgid "adv_100102_0023_msg"
msgstr "…앞으로도 분명 여러 전장에서\\n노래하게 되겠지"

msgid "adv_100102_0024_msg"
msgstr "네… 모두를 위해서라도\\n힘 팍팍 내서 열심히 해요!"

msgid "adv_100102_0025_msg"
msgstr "그래"

msgid "adv_200101_0009_msg"
msgstr "…이 도시, 상당히 많은 기억이 사라졌네"

msgid "adv_200101_0010_msg"
msgstr "네. 노래의 효과는 나타나고 있지만,\\n아직도 도시 곳곳에서 소실이 확인되고 있습니다"

msgid "adv_200101_0011_msg"
msgstr "…이번에는 여기서 앞으로 몇 번 더\\n라이브를 하게 되는 거죠?"

msgid "adv_200101_0012_msg"
msgstr "그래. 조사도 겸하고 있으니 도시와\\n사람들의 상태도 자세히 보고해야 하는데…"

msgid "adv_200101_0013_msg"
msgstr "새의 인간이 끼치는 영향이 설마\\n이렇게까지 심할 줄은…\\n역시 직접 보니 괴롭네"

msgid "adv_200101_0014_msg"
msgstr ""

msgid "adv_200101_0015_msg"
msgstr "메서 군?"

msgid "adv_200101_0016_msg"
msgstr "…우리 말고도 여기를 조사하러 온\\n녀석들이 있는 것 같군요"

msgid "adv_200101_0017_msg"
msgstr "…! 저건 공중기사단!?"

msgid "adv_200101_0018_msg"
msgstr "왜 이런 곳에?"

msgid "adv_200101_0019_msg"
msgstr "아직 녀석들의 목적은 알 수 없지만,\\n이대로 둘 수도 없습니다"

msgid "adv_200101_0020_msg"
msgstr "출격하겠습니다!"

msgid "adv_200101_0021_msg"
msgstr "기다려, 위험해! 일단 물러나서,\\n척 군과 하야테 군의 지원을 기다리자!"

msgid "adv_200101_0022_msg"
msgstr "기다리는 동안 되찾은 기억이\\n또 사라질지도 모릅니다"

msgid "adv_200101_0023_msg"
msgstr "그건…"

msgid "adv_200101_0024_msg"
msgstr "제 임무는 왈큐레의 호위입니다"

msgid "adv_200101_0025_msg"
msgstr "반드시 지키겠습니다.\\n그러니 마음껏 노래해 주세요, 카나메 씨"

msgid "adv_200101_0026_msg"
msgstr ""

msgid "adv_200101_0027_msg"
msgstr "…알겠어, 메서 군!"

msgid "adv_200102_0007_msg"
msgstr "메서 군!"

msgid "adv_200102_0008_msg"
msgstr "카나메 씨…"

msgid "adv_200102_0009_msg"
msgstr "괜찮아!? 다친 데는 없어!?"

msgid "adv_200102_0010_msg"
msgstr "저는 문제없습니다.\\n결국 녀석들의 목적은 알아내지 못했지만요"

msgid "adv_200102_0011_msg"
msgstr "…대체 뭐였던 걸까"

msgid "adv_200102_0012_msg"
msgstr "우선 아라드 대장에게 연락하죠.\\n녀석들에게도 뭔가 속셈이 있는 것 같습니다"

msgid "adv_200102_0013_msg"
msgstr "그러자. 앞으로 다른 별에서 마주칠 가능성도\\n있으니까…"

msgid "adv_200102_0014_msg"
msgstr ""

msgid "adv_200102_0015_msg"
msgstr "메서 군?"

msgid "adv_200102_0016_msg"
msgstr "…여기 있으니 그 행성이 떠오르네요"

msgid "adv_200102_0017_msg"
msgstr "…알브헤임"

msgid "adv_200102_0018_msg"
msgstr ""

msgid "adv_200102_0019_msg"
msgstr "바르 때문에 전멸한 별입니다.\\n…저는 살아남았지만요"

msgid "adv_200102_0020_msg"
msgstr "…그래. 메서 군과 만났던 별"

msgid "adv_200102_0021_msg"
msgstr "이 행성이 이대로 사라지면\\n지구도 똑같이 멸망할 것입니다"

msgid "adv_200102_0022_msg"
msgstr "…그러니까 더더욱, 그런 일을 막기 위해\\n우리가 열심히 해야겠지"

msgid "adv_200102_0023_msg"
msgstr "네"

msgid "adv_200102_0024_msg"
msgstr "그나저나 오늘도 위험할 때마다\\n여러 번 도움을 받았네"

msgid "adv_200102_0025_msg"
msgstr "항상 고마워, 메서 군"

msgid "adv_200102_0026_msg"
msgstr "…임무니까요"

msgid "adv_100201_0006_msg"
msgstr "여름이다~! 바다다~!"

msgid "adv_100201_0007_msg"
msgstr "기운 팍팍~!"

msgid "adv_100201_0008_msg"
msgstr "다 같이 놀러 올 기회는\\n별로 없었으니까 왠지 새롭네!"

msgid "adv_100201_0009_msg"
msgstr "라그나의 바다가 평소보다도\\n더 반짝반짝해 보여~"

msgid "adv_100201_0010_msg"
msgstr "네엣! 미라쥬 씨도 와줬고,\\n엄청 즐거운 휴일이 될 것 같네!"

msgid "adv_100201_0011_msg"
msgstr "그러게! 그나저나…"

msgid "adv_100201_0012_msg"
msgstr "수영복 입은 프레프레, 너무 귀여워~!"

msgid "adv_100201_0013_msg"
msgstr "마, 마키나 씨!?"

msgid "adv_100201_0014_msg"
msgstr "그 수영복, 프레프레 이미지랑 딱 맞아서,\\n정말 잘 어울려!"

msgid "adv_100201_0015_msg"
msgstr "그, 그런가…?"

msgid "adv_100201_0016_msg"
msgstr "수영복은 익숙하지 않아서 왠지 어색하고…\\n게다가 하야테가 애 같다고 했어!"

msgid "adv_100201_0017_msg"
msgstr "하야하야는 여전하네…"

msgid "adv_100201_0018_msg"
msgstr "…뭔가 한 방 먹일 방법은 없을까?"

msgid "adv_100201_0019_msg"
msgstr "모처럼 초시공 SNS도 있으니, 어른스럽게\\n입는 요령을 물어보면 되지 않을까?"

msgid "adv_100201_0020_msg"
msgstr "…어른스럽다고 하면, 그 사람이라든가!"

msgid "adv_100201_0021_msg"
msgstr "그 사람…?"

msgid "adv_100201_0022_msg"
msgstr "이걸로 됐어!\\n바로 셰리셰리한테 메시지를 보내봤어"

msgid "adv_100201_0023_msg"
msgstr "셰리셰리라니… 셰릴 씨!?\\n왠지 일이 엄청 커진 것 같은데…"

msgid "adv_100201_0025_msg"
msgstr "잠깐, 알토… 아니,\\n어머? 마키나한테 메시지가 왔네"

msgid "adv_100201_0026_msg"
msgstr "헤에… 그 애들도 바다에 와 있었구나!\\n저쪽 바다는 분명 라그나…였던가?"

msgid "adv_100201_0027_msg"
msgstr "…마침 촬영 쉬는 시간이기도 하고, 어쩔 수 없네.\\n프레이아를 위해 내가 한 번 나서주지"

msgid "adv_100201_0028_msg"
msgstr "이 셰릴 놈이\\n끝내주는 본보기를 보여줄게!"

msgid "adv_100202_0003_msg"
msgstr "이 정도의 요령만 마스터한다면\\n분명 하야테도 깜짝 놀랄 거야"

msgid "adv_100202_0004_msg"
msgstr "이제 프레이아한테 제대로 전해지기만 하면 좋겠는데"

msgid "adv_100202_0005_msg"
msgstr "…그럼 슬슬 나도 촬영으로 돌아갈까"

msgid "adv_100202_0006_msg"
msgstr "있잖아, 알토! 비치볼이랑 선글라스 좀 가져다줄래?"

msgid "adv_100202_0008_msg"
msgstr "역시 셰릴 씨라니까!\\n엄청 제대로 된 요령을 알려줬어"

msgid "adv_100202_0009_msg"
msgstr "셰리셰리도 바다에서 촬영 중이었구나~,\\n『멋진 추억을 만들렴』이래!"

msgid "adv_100202_0010_msg"
msgstr "정말 좋은 사람이네…"

msgid "adv_100202_0011_msg"
msgstr "나도 공부가 된 것 같아!\\n역시 은하의 요정답다니까~"

msgid "adv_100202_0012_msg"
msgstr "이히히히…이제 하야테한테도 애 같다는\\n말은 못 하게 할 거야!"

msgid "adv_100202_0013_msg"
msgstr "…그런데 다른 사람들은 어디 간 걸까?"

msgid "adv_100202_0014_msg"
msgstr "카나카나는 저쪽 파라솔 아래에서 쉬고 있어~"

msgid "adv_100202_0015_msg"
msgstr "그리고 쿠모쿠모는 바닷속에서 릴랙스 중!"

msgid "adv_100202_0016_msg"
msgstr "레이나 씨는 그늘에서 해파리를 먹는 것 같고,\\n다들 각자 즐기고 있네"

msgid "adv_100202_0017_msg"
msgstr "그러고 보니 미라미라도 왔다고\\n했는데…어디에도 안 보이네?"

msgid "adv_100202_0018_msg"
msgstr "그러게…어디 간 걸까?"

msgid "adv_100202_0019_msg"
msgstr "미라미라라면 수영복 차림이\\n부끄러워서 못 나오고 있는 걸지도?"

msgid "adv_100202_0020_msg"
msgstr "그러고 보니 오기 전에도 부끄러워했던 것 같은데…"

msgid "adv_100202_0021_msg"
msgstr "…아, 미라미라 온 것 같아! 마중 나가볼까!"

msgid "adv_100202_0022_msg"
msgstr "네엣! 미라쥬 씨~ 같이 놀아요!"

msgid "adv_200201_0007_msg"
msgstr "…마키나한테서 뭔가 데이터가 온 것 같네"

msgid "adv_200201_0008_msg"
msgstr "마키나랑 같이 찍힌 생물…괭이갈매기라고 하는구나.\\n프론티어나 갤럭시에서는 본 적이 없어"

msgid "adv_200201_0009_msg"
msgstr "후훗, 나중에 란카랑 알토한테도\\n보여줄까?"

msgid "adv_200201_0010_msg"
msgstr "…그나저나 역시 마키나는 자기를 어떻게 보여줘야 하는지\\n잘 알고 있네. 꽤 잘 나왔잖아"

msgid "adv_200201_0012_msg"
msgstr "…셰리셰리, 봐줬으려나~?"

msgid "adv_200201_0013_msg"
msgstr "아, 프레프레!"

msgid "adv_200201_0014_msg"
msgstr ""

msgid "adv_200201_0015_msg"
msgstr "…왜 그래? 얼굴이 새빨간데…"

msgid "adv_200201_0016_msg"
msgstr "…마키나 씨는 역시 대단하네"

msgid "adv_200201_0017_msg"
msgstr "어?"

msgid "adv_200201_0018_msg"
msgstr "셰릴 씨한테 수영복을 멋지게 입는 요령은 배웠지만,\\n그걸 써도 난 마키나 씨한텐 못 당하겠네!"

msgid "adv_200201_0019_msg"
msgstr "내 가슴에 손을 얹어보니까 더더욱\\n그걸 알겠달까…차이를 실감하게 된달까"

msgid "adv_200201_0020_msg"
msgstr "자~ 프레프레, 기쁘긴 하지만 너무 빤히 보잖아~!"

msgid "adv_200201_0021_msg"
msgstr "죄, 죄송해요! 아까까지 마키나 씨의 이미지 데이터를\\n보고 있었더니, 진짜 모습을 보고 그만 감동해서…"

msgid "adv_200201_0022_msg"
msgstr "이미지 데이터?…앗, 맞다!\\n미안해, 갑자기 촬영이 잡혀버려서"

msgid "adv_200201_0023_msg"
msgstr "혹시 모를 때를 대비해서, 또 작전의 위장용으로\\n쓸 수 있는 콘텐츠를 찍어두고 싶다고\\n하더라고~"

msgid "adv_200201_0024_msg"
msgstr "아직 시간이 좀 더 걸릴 것 같으니까,\\n프레프레는 먼저 다들 있는 곳으로…"

msgid "adv_200201_0025_msg"
msgstr "저기! 마키나 씨 촬영, 조금만 더\\n구경해도 될까요?"

msgid "adv_200201_0026_msg"
msgstr "그럼 물론이지, 대환영이야~!\\n프레프레만 괜찮다면 마음껏 보고 가"

msgid "adv_200201_0027_msg"
msgstr "감사합니다! 많이 배울게요!"

msgid "adv_200201_0028_msg"
msgstr "후훗…좋~아, 그럼 나도 제대로 일해야지!"

msgid "adv_200201_0029_msg"
msgstr "여름과 바다와 수영복을 살린, 마키마키만의\\n특별한 연출을 보여줄게?"

msgid "adv_200202_0007_msg"
msgstr "음…이런 느낌인가?\\n근데 뭔가 아닌 것 같은데…"

msgid "adv_200202_0008_msg"
msgstr "프레프레, 뭐 하고 있어?"

msgid "adv_200202_0009_msg"
msgstr "우와앗! 마, 마키나 씨!"

msgid "adv_200202_0010_msg"
msgstr "…아, 아무것도 아니에요! 그냥 조금\\n마키나 씨 포즈를 따라 해보고 있었을 뿐이라…"

msgid "adv_200202_0011_msg"
msgstr ""

msgid "adv_200202_0012_msg"
msgstr "따라 하는 프레프레, 너무 귀여워~!"

msgid "adv_200202_0013_msg"
msgstr "와앗…!"

msgid "adv_200202_0014_msg"
msgstr "미안해, 레이레이한테 하듯이\\n나도 모르게 안아버렸네…"

msgid "adv_200202_0015_msg"
msgstr "괘, 괜찮아요…그나저나,\\n마키나 씨는 정말 수영복이 잘 어울리네요"

msgid "adv_200202_0016_msg"
msgstr "셰릴 씨와는 또 다른 반짝임이랄까,\\n엄청나다랄까…아무튼 진짜 대단해요!"

msgid "adv_200202_0017_msg"
msgstr "그런가? 고마워!"

msgid "adv_200202_0018_msg"
msgstr "…자, 촬영도 끝났고 이제 마음껏\\n여름을 즐기기만 하면 되겠네!"

msgid "adv_200202_0019_msg"
msgstr "이히히~ 그럼 나한테 맡겨주지 않을래?"

msgid "adv_200202_0020_msg"
msgstr "프레프레, 뭔가 좋은 생각 있어?"

msgid "adv_200202_0021_msg"
msgstr "짜자잔~! 이걸 준비했어!"

msgid "adv_200202_0022_msg"
msgstr "그건… 물총?"

msgid "adv_200202_0023_msg"
msgstr "척 씨한테 빌렸어,\\n이걸로 하야테랑 미라쥬 씨를 깜짝 놀라게 해줄 거야!"

msgid "adv_200202_0024_msg"
msgstr "우히히히히…"

msgid "adv_200202_0025_msg"
msgstr "프레프레의 룬, 반짝반짝 빛나고 있어…"

msgid "adv_200202_0026_msg"
msgstr "아직 여름은 안 끝났어!\\n추억을 잔뜩 만들어야지!"

msgid "adv_200202_0027_msg"
msgstr "그것도 그렇네.\\n그럼 미라미라네한테 출바~알!"

msgid "adv_200202_0028_msg"
msgstr "기운 팍팍~!"

msgid "adv_300101_0012_msg"
msgstr "잠깐 바사라, 지금까지 어디 갔던 거야!"

msgid "adv_300101_0013_msg"
msgstr "기다렸지"

msgid "adv_300101_0014_msg"
msgstr "기다렸지가 아니잖아!\\n라이브 전에 사라지지 말라고 몇 번이나 말했잖아!"

msgid "adv_300101_0015_msg"
msgstr "잘 들어? 왈큐레 애들이랑\\n셰릴에 란카, 그리고 민메이 씨까지…"

msgid "adv_300101_0016_msg"
msgstr "다들 기억을 지키려고 열심히 하고 있어!\\n그런데 우리가 뒤처져서 어쩌자는 거야?"

msgid "adv_300101_0017_msg"
msgstr "이대로 가면 은하가 큰일 나게\\n생겼단 말이야! 알아들었어?"

msgid "adv_300101_0018_msg"
msgstr "뭐, 바사라도 아무 생각이 없는 건 아니니까"

msgid "adv_300101_0019_msg"
msgstr "…정말? 난 그렇게 안 보이는데.\\n레이는 바사라한테 너무 관대해"

msgid "adv_300101_0020_msg"
msgstr "그렇진 않은 것 같은데… 일단,\\n바사라에게 지금 상황부터 설명해줘"

msgid "adv_300101_0021_msg"
msgstr "맞다… 있잖아, 바사라!\\n이 근처에서도 사람들의 기억이 사라지고 있어!"

msgid "adv_300101_0022_msg"
msgstr "빨리 어떻게든 하지 않으면..."

msgid "adv_300101_0023_msg"
msgstr "조급해한다고 달라질 건 없잖아.\\n어떤 상황이든 우리가 할 일은 변하지 않아!"

msgid "adv_300101_0024_msg"
msgstr "비히다, 준비됐어?"

msgid "adv_300101_0026_msg"
msgstr ""

msgid "adv_300101_0027_msg"
msgstr "좋아, 그럼 슬슬 라이브를 시작하자!\\n밀레느, 빨리 와"

msgid "adv_300101_0028_msg"
msgstr "빨리라니… 난 바사라가 오기를\\n기다리고 있었단 말이야!"

msgid "adv_300101_0029_msg"
msgstr "끝내주게 뜨거운 라이브로 만들어주지!"

msgid "adv_300101_0030_msg"
msgstr "말 좀 들으란 말이야!"

msgid "adv_300101_0032_msg"
msgstr "하하, 진정해 밀레느. 늘 있는 일이잖아"

msgid "adv_300101_0033_msg"
msgstr "정말, 제멋대로라니까…"

msgid "adv_300101_0034_msg"
msgstr "전투 따윈 시시해! 내 노래를 들어!"

msgid "adv_300102_0009_msg"
msgstr "다들 기억을 제대로 되찾은 것 같네"

msgid "adv_300102_0010_msg"
msgstr "그러게. 밀레느, 네 노래도 제대로 들렸다고!"

msgid "adv_300102_0011_msg"
msgstr "후훗, 당연하지!"

msgid "adv_300102_0012_msg"
msgstr "…하지만 상황이 점점 나빠지고 있다는 것도\\n실감했어"

msgid "adv_300102_0013_msg"
msgstr "그러니까 더더욱 우리 노래를 들려주고\\n뜨거운 하트를 제대로 내리꽂는 거야!"

msgid "adv_300102_0014_msg"
msgstr ""

msgid "adv_300102_0015_msg"
msgstr "…? 왜 그래?"

msgid "adv_300102_0016_msg"
msgstr "아니, 아무것도 아니야!\\n그냥 바사라는 언제나 바사라구나 싶어서…"

msgid "adv_300102_0017_msg"
msgstr "…그래, 열심히 우리 노래를 전해야지!"

msgid "adv_300102_0018_msg"
msgstr "있잖아, 바사라.\\n그런데 알토랑 하야테 일행하고 언제 그렇게 친해졌어?"

msgid "adv_300102_0019_msg"
msgstr "걔들이 초시공 SNS에서 이것저것 알려줬거든.\\n뜨겁고 좋은 녀석들이야!"

msgid "adv_300102_0020_msg"
msgstr "헤에~ 의외로 제법 잘 쓰고 있네"

msgid "adv_300102_0021_msg"
msgstr "네가 시시한 일로 계속 연락해대니까\\n익숙해진 거 아니냐?"

msgid "adv_300102_0022_msg"
msgstr "시시하다니 뭐야!?\\n애초에 내가 연락해도 제대로 답장 안 하잖아!"

msgid "adv_300102_0023_msg"
msgstr "그랬나?"

msgid "adv_300102_0024_msg"
msgstr "그랬어! 읽다가 중간에 그만둘 때도 있잖아!"

msgid "adv_300102_0026_msg"
msgstr "밀레느, 바사라. 이제 됐나?\\n맥스 함장님이 자세한 이야기를 듣고 싶다는군"

msgid "adv_300102_0027_msg"
msgstr "아빠가?"

msgid "adv_300102_0028_msg"
msgstr "…아니, 바사라! 어디 가는 거야?"

msgid "adv_300102_0029_msg"
msgstr "아직 노래가 부족하거든! 한 곡 더 부르고 갈 거야"

msgid "adv_300102_0030_msg"
msgstr "정말 제멋대로라니까… 뭐, 좋아.\\n나도 아직 노래가 부족하니까 딱 한 곡만 같이 해줄게!"

msgid "adv_300102_0031_msg"
msgstr "있잖아… 레이, 조금 늦어도 괜찮지?\\n아빠한테는 내가 말해둘게!"

msgid "adv_300102_0032_msg"
msgstr "그래, 괜찮지 않겠어?\\n노래하고 싶을 때 노래하는 게 우리 사운드니까"

msgid "adv_300102_0033_msg"
msgstr "좋았어! 그럼 간다!"

msgid "adv_100301_0011_msg"
msgstr ""

msgid "adv_100301_0012_msg"
msgstr "…기억을 잃은 사람들을 모아서 여기서 대규모 라이브라.\\n제법 머리를 썼군"

msgid "adv_100301_0013_msg"
msgstr "프론티어에서도 기억 소실이 계속되고 있어.\\n더는 그냥 두고 볼 수 없잖아"

msgid "adv_100301_0014_msg"
msgstr "사라진 기억은 내가 반드시 되찾아주겠어"

msgid "adv_100301_0015_msg"
msgstr "…그런데 알토, 무슨 일로 왔어?\\n다들 전투 준비를 시작했는데"

msgid "adv_100301_0016_msg"
msgstr "그래, 알고 있어"

msgid "adv_100301_0017_msg"
msgstr "혹시 날 걱정해서,\\n라이브 전에 얼굴 보러 와준 거야?"

msgid "adv_100301_0018_msg"
msgstr "그런 말은 한마디도 안 했잖아"

msgid "adv_100301_0019_msg"
msgstr "글쎄?"

msgid "adv_100301_0020_msg"
msgstr "별건 아니야. 발키리에 타기 전에\\n라이브 회장 상태를 봐두려고 했을 뿐이야"

msgid "adv_100301_0021_msg"
msgstr "무슨 일이 생긴 다음엔 늦으니까.\\n이 라이브 회장도 언제 사라질지 모르는 일이야"

msgid "adv_100301_0022_msg"
msgstr "그 정도는 나도 알아"

msgid "adv_100301_0023_msg"
msgstr "…여긴 나한테 소중한 추억이 있는 곳이야"

msgid "adv_100301_0024_msg"
msgstr "추억…"

msgid "adv_100301_0025_msg"
msgstr "뭐, 프론티어에 막 왔을 때\\n라이브를 했던 곳이니까.\\n기억에 남아 있는 것도 이해는 하지만…"

msgid "adv_100301_0026_msg"
msgstr ""

msgid "adv_100301_0027_msg"
msgstr "…왜?"

msgid "adv_100301_0028_msg"
msgstr "이래서 알토는… 정말 둔하다니까"

msgid "adv_100301_0029_msg"
msgstr "뭐…"

msgid "adv_100301_0030_msg"
msgstr "어머… 벌써 라이브 시간이네.\\n이렇게 된 이상 이야기는 나중에 실컷 들어줘야겠어?"

msgid "adv_100301_0031_msg"
msgstr "야, 셰릴!"

msgid "adv_100301_0032_msg"
msgstr "다치기라도 하면 가만 안 둘 거야"

msgid "adv_100301_0033_msg"
msgstr "당연하지. 너나 조심해"

msgid "adv_100301_0034_msg"
msgstr "어머, 알토. 내가 누군지 잊은 거야?"

msgid "adv_100301_0035_msg"
msgstr "나는 셰릴. 셰릴 놈이야"

msgid "adv_100301_0036_msg"
msgstr "질릴 만큼 잘 알고 있어"

msgid "adv_100301_0037_msg"
msgstr "여기서부턴 프로의 일이야,\\n끝내주게 뜨거운 라이브를 보여줄게"

msgid "adv_100301_0038_msg"
msgstr "다들! 내 노래를 들어!"

msgid "adv_100302_0009_msg"
msgstr "라이브에 왔던 사람들 기억이 돌아온 것 같아.\\n작전은 잘 된 모양이네"

msgid "adv_100302_0010_msg"
msgstr "이 내가 노래했는걸, 당연하지?"

msgid "adv_100302_0011_msg"
msgstr "그래, 네 노래 제대로 들었어"

msgid "adv_100302_0012_msg"
msgstr "…그리고 노래를 들으면서 나도 떠올린 게 있어.\\n너와 마찬가지로 나한테도 여긴 특별한 곳이야"

msgid "adv_100302_0013_msg"
msgstr "알토…"

msgid "adv_100302_0014_msg"
msgstr "…? 왜 그래?"

msgid "adv_100302_0015_msg"
msgstr "아니, 아무것도 아니야"

msgid "adv_100302_0016_msg"
msgstr "…그때 나는 아직 S.M.S에 들어가지 않았었지.\\n그날 바쥬라와 마주치지 않았다면,\\n입대하는 일도 없었겠지"

msgid "adv_100302_0017_msg"
msgstr "나랑 이런 사이가 될 거라고는\\n상상도 못 했겠지?"

msgid "adv_100302_0018_msg"
msgstr "무슨 사이야!"

msgid "adv_100302_0019_msg"
msgstr "후훗… 농담이야"

msgid "adv_100302_0020_msg"
msgstr "…정말, 앞으로도 넌 변함없을 것 같네"

msgid "adv_100302_0021_msg"
msgstr "그렇겠지. 난 나니까"

msgid "adv_100302_0022_msg"
msgstr "앞으로 설령 노래하기 힘든 상황이 오더라도\\n이제 미련은 없어, 남은 건 완전히 불태우는 것뿐이라는 마음으로\\n분명 노래할 거야!"

msgid "adv_100302_0023_msg"
msgstr "대체 무슨 상황인데, 그게"

msgid "adv_100302_0024_msg"
msgstr "만약의 이야기야. 노래할 수 없게 된 나는 내가 아니라는 뜻이지"

msgid "adv_100302_0025_msg"
msgstr "그런 미래가 올 거라고는 도저히 생각되지 않지만"

msgid "adv_100302_0026_msg"
msgstr "그러게. 지금은 어쨌든 기억을 되찾는 데\\n집중해야지"

msgid "adv_100302_0027_msg"
msgstr "더는 프론티어 사람들의 기억을\\n빼앗기게 두지 않을 거야"

msgid "adv_100302_0028_msg"
msgstr "그래"

msgid "adv_100302_0029_msg"
msgstr "그렇게 정했으면 다음 라이브 준비를 해야지!"

msgid "adv_100302_0030_msg"
msgstr "아, 야 셰릴… 정말, 제멋대로라니까"

msgid "adv_100302_0031_msg"
msgstr "자, 알토! 가자!"

msgid "adv_100302_0032_msg"
msgstr "…그래"

msgid "adv_200301_0007_msg"
msgstr "오늘은 민메이 생일인가.\\n…민메이 같은 애는 어떤 선물을 좋아하려나"

msgid "adv_200301_0008_msg"
msgstr "일단 선배한테도 이것저것 물어봤는데\\n도무지 어렵단 말이지…"

msgid "adv_200301_0010_msg"
msgstr "히카루! 이런 데 있었구나"

msgid "adv_200301_0011_msg"
msgstr "미, 민메이!"

msgid "adv_200301_0012_msg"
msgstr "…? 왜 그래?"

msgid "adv_200301_0013_msg"
msgstr "아니, 아무것도 아니야"

msgid "adv_200301_0014_msg"
msgstr "그보다 오늘은 네 생일 라이브잖아?\\n의상 분위기도 평소랑 뭔가 다르네"

msgid "adv_200301_0015_msg"
msgstr "후훗, 고마워.\\n하지만 히카루는 라이브 보러 못 오지?"

msgid "adv_200301_0016_msg"
msgstr "가능하면 보고 싶긴 한데"

msgid "adv_200301_0017_msg"
msgstr "알고 있어. 히카루는 싸워야 하니까"

msgid "adv_200301_0018_msg"
msgstr "항상 지켜줘서 고마워"

msgid "adv_200301_0019_msg"
msgstr "천만에"

msgid "adv_200301_0020_msg"
msgstr "…이런 상황만 아니었으면 중간에 빠져나와서\\n라이브를 즐길 수도 있었을 텐데"

msgid "adv_200301_0021_msg"
msgstr "그나저나 기억을 잃은 사람들을 모아서\\n생일 라이브를 하다니, 잘도 생각했네"

msgid "adv_200301_0022_msg"
msgstr "셰릴 씨가 기억을 잃은 사람들 앞에서\\n라이브를 열었다는 얘기를 초시공 SNS에서 알려줬거든"

msgid "adv_200301_0023_msg"
msgstr "셰릴 씨 이야기를 듣고, 모두를 위해\\n나도 해보고 싶다고 생각했어"

msgid "adv_200301_0024_msg"
msgstr "그랬구나…"

msgid "adv_200301_0025_msg"
msgstr "후훗, 이것저것 상담도 받고 있거든?"

msgid "adv_200301_0026_msg"
msgstr "그래서 라이브를 할 거면 생일도 가까우니까\\n내 생일 라이브가 좋지 않겠냐고 하더라"

msgid "adv_200301_0027_msg"
msgstr ""

msgid "adv_200301_0028_msg"
msgstr "왜 그래, 히카루? 무슨 일 있어?"

msgid "adv_200301_0029_msg"
msgstr "아니, 처음 만났을 때 민메이를 떠올리고 있었어"

msgid "adv_200301_0030_msg"
msgstr "처음 만났을 때… 왠지 그립네.\\n목숨이랑 머리카락 중 뭐가 더 중요하냐고 혼났었지"

msgid "adv_200301_0031_msg"
msgstr "그리고 히카루가 발키리로 내 방을\\n부숴버린 적도 있었지!"

msgid "adv_200301_0032_msg"
msgstr "그건 갑자기 변형해서 놀랐단 말이야!\\n아직 발키리 조종에 익숙하지 않았으니까"

msgid "adv_200301_0033_msg"
msgstr "그래도 민메이, 그때랑 비교하면\\n뭔가 훨씬 씩씩해졌네"

msgid "adv_200301_0034_msg"
msgstr "은하 전체가 이런 상황이잖아.\\n나도 내가 할 수 있는 일로\\n모두의 기억을 되찾아주고 싶다고 생각했어"

msgid "adv_200301_0035_msg"
msgstr "민메이라면 분명 할 수 있어"

msgid "adv_200301_0036_msg"
msgstr "고마워, 히카루! 오늘도 최선을 다해 노래할게"

msgid "adv_200302_0007_msg"
msgstr "민메이! 라이브 수고했어.\\n다들 기억도 제대로 돌아온 것 같네…"

msgid "adv_200302_0008_msg"
msgstr "고마워, 조금 긴장하긴 했지만\\n잘돼서 다행이야!"

msgid "adv_200302_0009_msg"
msgstr "왠지 평소보다 더 기뻐 보이네"

msgid "adv_200302_0010_msg"
msgstr "응, 내 노래가\\n제대로 전해진 것도 기쁘지만…"

msgid "adv_200302_0011_msg"
msgstr "다들 축하해줘서\\n정말 멋진 생일이 된 게 기뻐"

msgid "adv_200302_0012_msg"
msgstr "평소 라이브보다 훨씬 특별한 라이브가 됐어"

msgid "adv_200302_0013_msg"
msgstr "그거 잘됐네. 그나저나 민메이의 노래 힘은 정말 대단해"

msgid "adv_200302_0014_msg"
msgstr "뭐… 초시공 SNS 사람들한테 전설의 가희라고\\n불리고 있으니까. 당연한 걸지도 모르지만"

msgid "adv_200302_0015_msg"
msgstr "그렇지 않아!\\n나 말고도 멋진 노래를 부르는 사람은 많다고?"

msgid "adv_200302_0016_msg"
msgstr "하지만…"

msgid "adv_200302_0017_msg"
msgstr "앞으로 어쩌면\\n민메이의 노래가 여러 싸움을 끝내는\\n계기가 될지도 몰라"

msgid "adv_200302_0018_msg"
msgstr "그러면 전설이지?"

msgid "adv_200302_0019_msg"
msgstr "히카루도 참… 과장이야.\\n그래도 언젠가는 그런 노래를 부를 수 있으면 좋겠어"

msgid "adv_200302_0020_msg"
msgstr "그러려면 더더욱 열심히 해야겠네!"

msgid "adv_200302_0021_msg"
msgstr "난 응원할게"

msgid "adv_200302_0022_msg"
msgstr "고마워, 히카루. …마크로스에 막 탔을 때는\\n불안하기도 했지만, 히카루 같은 친구를 만나서 정말 다행이야"

msgid "adv_200302_0023_msg"
msgstr "친구라…"

msgid "adv_200302_0024_msg"
msgstr "왜 그래?"

msgid "adv_200302_0025_msg"
msgstr "아니, 아무것도 아니야"

msgid "adv_200302_0026_msg"
msgstr "그보다 민메이. 아직 못 한 말이 있는데…"

msgid "adv_200302_0027_msg"
msgstr "못 한 말이라니… 뭔데?"

msgid "adv_200302_0028_msg"
msgstr "…생일 축하해, 민메이"

msgid "adv_200302_0029_msg"
msgstr "…! 고마워, 히카루!"

msgid "adv_300201_0007_msg"
msgstr ""

msgid "adv_300201_0008_msg"
msgstr "후훗… 완벽해. 이제 남은 건…"

msgid "adv_300201_0009_msg"
msgstr "어이, 레이나! 프레이아가 찾던데.\\n슬슬 라이브 시작할 때 아니야?"

msgid "adv_300201_0010_msg"
msgstr "…아"

msgid "adv_300201_0011_msg"
msgstr "뭐야? 무슨 일 있어?"

msgid "adv_300201_0012_msg"
msgstr "하야테가 말을 걸어서,\\n실수로 다른 네트워크에 접속했어"

msgid "adv_300201_0013_msg"
msgstr "…또 해킹하고 있었냐"

msgid "adv_300201_0014_msg"
msgstr "이건 그냥 해킹이 아니야.\\n할로윈 라이브를 준비하기 위한 중요한 행위"

msgid "adv_300201_0015_msg"
msgstr "그게 뭔데? 할로윈은 과자 받는 날 아니야?\\n해킹이랑 무슨 상관인데"

msgid "adv_300201_0016_msg"
msgstr "전혀 모르고 있어"

msgid "adv_300201_0017_msg"
msgstr "할로윈의 본질은 장난을 치는 데 있어.\\n장난을 치면 가슴이 찌릿찌릿해서 기분 좋은 이벤트,\\n그게 바로 할로윈"

msgid "adv_300201_0018_msg"
msgstr "아니, 뭔가 잘못 알고 있잖아"

msgid "adv_300201_0019_msg"
msgstr "아니 그보다… 네가 보고 있는 데이터,\\n지금부터 라이브에서 쓸 홀로그램 데이터잖아"

msgid "adv_300201_0020_msg"
msgstr "멋대로 건드려도 괜찮은 거야?"

msgid "adv_300201_0021_msg"
msgstr "문제없어"

msgid "adv_300201_0022_msg"
msgstr "…아마도"

msgid "adv_300201_0023_msg"
msgstr "아마도라니…"

msgid "adv_300201_0024_msg"
msgstr "목적 달성을 위해서는 어느 정도의 리스크가 필수적"

msgid "adv_300201_0025_msg"
msgstr "설령 카나메한테 혼나더라도"

msgid "adv_300201_0026_msg"
msgstr "…대체 뭘 하려는 거야?"

msgid "adv_300201_0027_msg"
msgstr "…아직은 안 알려줄 거야"

msgid "adv_300201_0028_msg"
msgstr "나는 위험을 사랑하는 여자.\\n오늘의 나는 아무도 막을 수 없어"

msgid "adv_300201_0029_msg"
msgstr "내 기술로 오늘 할로윈 라이브를\\n반드시 성공시킬 거야"

msgid "adv_300201_0030_msg"
msgstr "…마키나를 위해서"

msgid "adv_300202_0008_msg"
msgstr "할로윈 라이브, 즐거웠다!"

msgid "adv_300202_0009_msg"
msgstr "그러고 보니 왈큐레 여러분도 라이브를 했다고\\n들었는데… 어떤 라이브였을까?"

msgid "adv_300202_0010_msg"
msgstr "…어라, 셰릴 씨한테 연락이 왔네"

msgid "adv_300202_0011_msg"
msgstr "어디 보자… 지금부터 S.M.S 사람들과 할로윈 파티?"

msgid "adv_300202_0012_msg"
msgstr "『란카를 위해 특별한 장난을 준비하고 기다릴게』라니…\\n후훗, 셰릴 씨도 참"

msgid "adv_300202_0013_msg"
msgstr "아, 알토 군! 지금부터 같이 다들 있는 데로 가자!"

msgid "adv_300202_0015_msg"
msgstr "…조금 예상 밖의 일도 있었지만\\n할로윈 라이브, 대성공"

msgid "adv_300202_0016_msg"
msgstr "나도 성공했어.\\n라이브 중에 예정에 없던 퍼포먼스를 넣었더니\\n관객들도 신나 했거든"

msgid "adv_300202_0017_msg"
msgstr "…뭐, 너무 제멋대로 날아다녀서\\n미라쥬한테 엄청 혼났지만"

msgid "adv_300202_0018_msg"
msgstr "다들 즐거워했으니까 문제없어"

msgid "adv_300202_0019_msg"
msgstr ""

msgid "adv_300202_0020_msg"
msgstr "…마키나도 놀라줬어"

msgid "adv_300202_0021_msg"
msgstr "헤에…"

msgid "adv_300202_0022_msg"
msgstr "뭐"

msgid "adv_300202_0023_msg"
msgstr "아니, 너희 정말 사이가 좋구나 싶어서"

msgid "adv_300202_0024_msg"
msgstr "당연하지. 하야테도 좀 더 친해지는 게 좋아… 프레이아랑"

msgid "adv_300202_0025_msg"
msgstr "프레이아? 맨날 티격태격하긴 하지만,\\n그렇다고 그렇게 사이가 나쁜 건 아닌 것 같은데"

msgid "adv_300202_0026_msg"
msgstr "…둔탱이"

msgid "adv_300202_0027_msg"
msgstr "뭐라고?"

msgid "adv_300202_0028_msg"
msgstr "…아무것도 아니야"

msgid "adv_300202_0029_msg"
msgstr "…뭐, 할로윈이기도 하니까 프레이아한테\\n사탕 하나쯤 가져다줄까!"

msgid "adv_300202_0030_msg"
msgstr "사과를 더 좋아할 것 같은데"

msgid "adv_300202_0031_msg"
msgstr "그러네. 그럼 잠깐 다녀올게!"

msgid "adv_300202_0032_msg"
msgstr ""

msgid "adv_300202_0033_msg"
msgstr "…할로윈 최고. 만족"

msgid "adv_100401_0010_msg"
msgstr "하야테, 슬슬 라이브가 시작될 거야.\\n출격 준비는 됐어?"

msgid "adv_100401_0011_msg"
msgstr "그래, 문제없어!"

msgid "adv_100401_0012_msg"
msgstr "…이 근처에서도 기억 상실이 계속되고 있어.\\n기억을 되찾기 위해 라이브를 하는 왈큐레를 지키는 것,\\n그게 이번 우리 임무다"

msgid "adv_100401_0013_msg"
msgstr "멸망의 노래 영향은 점점 강해지고 있어.\\n좋아, 방심하지 마라"

msgid "adv_100401_0014_msg"
msgstr "예이예이, 알고 있다니까"

msgid "adv_100401_0015_msg"
msgstr "그나저나 또 여기 오게 될 줄은 몰랐네"

msgid "adv_100401_0016_msg"
msgstr "행성 란돌"

msgid "adv_100401_0017_msg"
msgstr "…여기서 했던 백신 라이브는,\\n하야테에게도 프레이아에게도 꽤나\\n충격적인 데뷔 무대였지"

msgid "adv_100401_0018_msg"
msgstr "그래, 나도 그 녀석도 델타 소대의 일원으로\\n처음 싸웠으니까. 잊을 리가 없지"

msgid "adv_100401_0019_msg"
msgstr "물론 여기서 윈더미어의 선전포고를 들었던 것도"

msgid "adv_100401_0020_msg"
msgstr "…그래, 그렇지"

msgid "adv_100401_0021_msg"
msgstr "…어, 저기 있는 거 프레이아 아니야?"

msgid "adv_100401_0022_msg"
msgstr "꽤 긴장한 것 같군"

msgid "adv_100401_0023_msg"
msgstr "…정말, 어쩔 수 없네. 내가 말 좀 걸고 올게"

msgid "adv_100401_0024_msg"
msgstr "어이, 프레이아!"

msgid "adv_100401_0025_msg"
msgstr ""

msgid "adv_100401_0026_msg"
msgstr "어이~ 들려~?"

msgid "adv_100401_0027_msg"
msgstr "우왓, 하야테!"

msgid "adv_100401_0028_msg"
msgstr "뭐야? 첫 무대 때처럼\\n겁먹은 거야?"

msgid "adv_100401_0029_msg"
msgstr "그, 그런 거 아니야!"

msgid "adv_100401_0030_msg"
msgstr "그냥 모두의 기억을 제대로 되찾아야 한다든가,\\n…그리고 윈더미어 일도 생각하고 있었어"

msgid "adv_100401_0031_msg"
msgstr "너답지 않네, 프레이아.\\n이것저것 너무 어렵게 생각하는 거야"

msgid "adv_100401_0032_msg"
msgstr "목숨 걸고 날면 날 수 있는 거잖아?\\n지금은 라이브 성공만 생각해"

msgid "adv_100401_0033_msg"
msgstr ""

msgid "adv_100401_0034_msg"
msgstr "그러고 보니 데뷔 라이브 때도,\\n비슷한 얘기를 했던 것 같네. 왠지 그립다…"

msgid "adv_100401_0035_msg"
msgstr "그러고 보니 그랬었지"

msgid "adv_100401_0036_msg"
msgstr "고마워, 하야테!\\n…왠지 기운이 나는 것 같아"

msgid "adv_100401_0037_msg"
msgstr "목숨 걸고 날면 날 수 있어!\\n인생 30년! 고민할 시간 있으면 계속 날아야지!"

msgid "adv_100401_0038_msg"
msgstr "프레이아 비온. 목숨 걸고 노래하겠습니다!"

msgid "adv_100402_0008_msg"
msgstr "아라드 대장님, 수고하셨습니다.\\n이번에도 무사히 기억이 돌아온 것 같네요"

msgid "adv_100402_0009_msg"
