msgstr "전처럼 당장이라도 울고 싶어지는 기분은\\n들지 않았어요"

msgid "adv_104102_0016_msg"
msgstr "물론 슬픈 건 슬프지만…\\n뭐라고 해야 할까"

msgid "adv_104102_0017_msg"
msgstr "슬픈 마음을 받아들이고,\\n그걸 노랫소리로 바꿀 수 있게 된 것 같은.\\n…그런 기분이 들어요"

msgid "adv_104102_0018_msg"
msgstr "그렇구나. 이 노래는 정말 애절하고, 슬픈 마음을\\n노래하는 곡이니까"

msgid "adv_104102_0019_msg"
msgstr "조금쯤 슬프지 않으면\\n듣는 사람의 마음을 흔들 수 없으니까.\\n분명 그걸로 된 거야!"

msgid "adv_104102_0020_msg"
msgstr "후훗. 그러네요!"

msgid "adv_104102_0021_msg"
msgstr "밀레느와 이야기하고 있으면,\\n무슨 일이든 긍정적으로 생각할 수 있을 것 같아요"

msgid "adv_104102_0022_msg"
msgstr "그렇지~?"

msgid "adv_104102_0024_msg"
msgstr "란카"

msgid "adv_104102_0025_msg"
msgstr "브레라 씨! 라이브 보러 와주셨군요"

msgid "adv_104102_0026_msg"
msgstr "지난번에는 정말 감사했어요.\\n그… 울고 있는 저를 위로해주셔서"

msgid "adv_104102_0027_msg"
msgstr "오늘 제 노래는 어땠어요?"

msgid "adv_104102_0028_msg"
msgstr "…좋았다"

msgid "adv_104102_0029_msg"
msgstr "감사합니다!"

msgid "adv_104102_0030_msg"
msgstr "란카.\\n오늘 네 노래, 정말 좋았어!"

msgid "adv_104102_0031_msg"
msgstr "다른 시공에서 계속 슬퍼하고 있는\\n란카한테도 들려주고 싶을 정도로!"

msgid "adv_104102_0032_msg"
msgstr "밀레느…"

msgid "adv_104102_0033_msg"
msgstr "…저도 그렇게 생각해요"

msgid "adv_104102_0034_msg"
msgstr "지금 여기 있는 제가\\n이런 마음으로 그 노래를 부를 수 있다는 걸…\\n다른 시공의 저한테도 알려주고 싶어요"

msgid "adv_104102_0035_msg"
msgstr "…밀레느. 그리고 브레라 씨.\\n그런 소원을 담아서, 딱 한 번만 더 불러봐도\\n될까요?"

msgid "adv_104102_0036_msg"
msgstr "물론이지!"

msgid "adv_104102_0037_msg"
msgstr "그래"

msgid "adv_104102_0038_msg"
msgstr "다른 시공에서 울고 있는 란카가\\n언젠가 웃을 수 있기를 바라며…"

msgid "adv_100356501_0004_msg"
msgstr "반짝!"

msgid "adv_100356501_0005_msg"
msgstr "맞아, 맞아! 프레이아, 『성간비행』 안무\\n완벽하네!"

msgid "adv_100356501_0006_msg"
msgstr "감사합니다!\\r\\n이것도 저것도 전부 란카 씨 덕분이에요!"

msgid "adv_100356501_0007_msg"
msgstr "동경하던 란카 씨한테 직접 안무를\\r\\n배울 수 있다니… 헉!? 설마 이거 꿈인가!?\\r\\n저, 꿈꾸고 있는 건가요!?"

msgid "adv_100356501_0008_msg"
msgstr "꿈 아니야! 나도 정말 즐거웠어!"

msgid "adv_100356501_0009_msg"
msgstr "그럼 이거 끝나면,\\r\\n다음엔 프레이아 노래 안무도 가르쳐줘!\\r\\n나도 기운 팍팍 어택~! 해보고 싶어"

msgid "adv_100356501_0010_msg"
msgstr "네엣~!\\r\\n이히히, 란카 씨의 기운 팍팍 어택, 기대돼요!"

msgid "adv_100356502_0004_msg"
msgstr "미쿠모 씨, 봐주세요! 이게 냥냥 명물 참치만두예요!"

msgid "adv_100356502_0005_msg"
msgstr "참치만두… 그게 왜?"

msgid "adv_100356502_0006_msg"
msgstr "그게… 전에 마키나 씨랑 레이나 씨한테 소개했을 때,\\r\\n미쿠모 씨한테도 참치만두의 매력을 알려주고 싶다고 했거든요…"

msgid "adv_100356502_0007_msg"
msgstr "그렇구나.\\r\\n그래서 그 참치만두는 어떤 맛이야?"

msgid "adv_100356502_0008_msg"
msgstr "네!\\r\\n뜨거울 때 한입 가득 베어 물면 참치 향이 확 퍼져서…\\r\\n홀로그램으로밖에 보여드릴 수 없는 게 아쉬워요"

msgid "adv_100356502_0009_msg"
msgstr "…그럼 내 대신 맛있게 먹어줄래?\\r\\n여기서 천천히 관찰해줄게"

msgid "adv_100356502_0010_msg"
msgstr "에엣!? 그, 그렇게 쳐다보시면 부끄러운데…\\r\\n그래도 미쿠모 씨한테 맛을 전해드리도록 열심히 먹을게요!"

msgid "adv_303601_0009_msg"
msgstr "프레이아, 트릭 오어 트리트!"

msgid "adv_303601_0010_msg"
msgstr "민메이 씨!"

msgid "adv_303601_0011_msg"
msgstr "과자를 안 주면 장난칠 거야? 농담이야"

msgid "adv_303601_0012_msg"
msgstr "에!? 과자!? 장난!?"

msgid "adv_303601_0013_msg"
msgstr "후훗, 놀라게 해서 미안해!\\n오늘은 할로윈이라 나도 모르게…"

msgid "adv_303601_0014_msg"
msgstr "아, 오늘 할로윈이었군요!\\n완전히 잊고 있었어요!"

msgid "adv_303601_0015_msg"
msgstr "그러고 보니 레이나 씨도 그런 얘기를 했던 것 같고…"

msgid "adv_303601_0016_msg"
msgstr "그나저나 민메이 씨 의상,\\n진짜 귀여워요!"

msgid "adv_303601_0017_msg"
msgstr "후훗, 고마워!"

msgid "adv_303601_0018_msg"
msgstr "할로윈에는 분장도 하잖아?\\n그래서 조금 특별한 의상으로 하고 싶어서…"

msgid "adv_303601_0019_msg"
msgstr "이번에는 신데렐라를 모티브로 해봤어"

msgid "adv_303601_0020_msg"
msgstr "오오! 저도 그런 의상 입어보고 싶어요!"

msgid "adv_303601_0021_msg"
msgstr "프레이아라면 분명 잘 어울릴 거야!"

msgid "adv_303601_0022_msg"
msgstr "왈큐레 모두도\\n할로윈 라이브를 해보는 게 어때?"

msgid "adv_303601_0023_msg"
msgstr "분명 평소와 다른 모두의 모습을 볼 수 있을 거야"

msgid "adv_303601_0024_msg"
msgstr "좋네요! 명안이에요!"

msgid "adv_303601_0025_msg"
msgstr "그렇게 정했으면 카나메 씨 일행한테 상의해봐요!"

msgid "adv_303601_0026_msg"
msgstr "에!?"

msgid "adv_303601_0027_msg"
msgstr "이런 이벤트는 다 같이\\n즐기는 게 좋다고 생각해!"

msgid "adv_303601_0028_msg"
msgstr "아, 맞다!"

msgid "adv_303601_0029_msg"
msgstr "프레이아 의상은 내가 골라줄게!"

msgid "adv_303601_0030_msg"
msgstr "네, 네엣!"

msgid "adv_303601_0031_msg"
msgstr "민메이 씨, 오늘은 평소보다 진짜 활기차네요…?"

msgid "adv_303602_0009_msg"
msgstr "미라쥬 씨!"

msgid "adv_303602_0010_msg"
msgstr "할로윈 파티 라이브, 어땠어요?"

msgid "adv_303602_0011_msg"
msgstr "정말 멋졌습니다! …가 아니라,\\r\\n프레이아!"

msgid "adv_303602_0012_msg"
msgstr "분장을 제안한 게 프레이아입니까!?"

msgid "adv_303602_0013_msg"
msgstr "아까부터 마키나 씨랑 레이나 씨한테\\r\\n쫓겨 다니느라 힘들다고요!"

msgid "adv_303602_0014_msg"
msgstr "네엣! 마키나 씨랑 레이나 씨가\\r\\n의상을 잔뜩 준비해주셨어요!"

msgid "adv_303602_0015_msg"
msgstr "미라쥬 씨는\\r\\n어떤 분장이 좋아요?"

msgid "adv_303602_0016_msg"
msgstr "으음, 민메이 씨 같은 드레스도 좋지만…\\r\\n저랑 같은 마녀도 잘 어울릴 것 같아요!"

msgid "adv_303602_0017_msg"
msgstr "어떤 거라니… 아, 안 할 겁니다!"

msgid "adv_303602_0018_msg"
msgstr "하지만 저, 미라쥬 씨도 같이\\r\\n트릭 오어 트리트 하고 싶어요!"

msgid "adv_303602_0019_msg"
msgstr "트릭 오어 트리트?"

msgid "adv_303602_0020_msg"
msgstr "과자를 안 주면\\r\\n장난칠 거야, 하는 거예요!"

msgid "adv_303602_0021_msg"
msgstr ""

msgid "adv_303602_0022_msg"
msgstr "프레이아?"

msgid "adv_303602_0023_msg"
msgstr "…저, 정말 즐거워 보이는 민메이 씨를\\r\\n보고 생각했어요"

msgid "adv_303602_0024_msg"
msgstr "여러 사람을 점점 끌어들이면서, 모두를\\r\\n즐거운 기분으로 만들어주는 민메이 씨가\\r\\n정말 멋지다고 생각했어요"

msgid "adv_303602_0025_msg"
msgstr "그리고 즐거운 일은\\r\\n다 같이 할수록 훨씬 더 즐겁다는 것도요!"

msgid "adv_303602_0026_msg"
msgstr "그래서 미라쥬 씨하고도\\r\\n같이 할로윈을 즐기고 싶어요!"

msgid "adv_303602_0027_msg"
msgstr "…알겠습니다. 그렇게까지 말씀하신다면"

msgid "adv_303602_0028_msg"
msgstr "정말인가요!?\\r\\n감사합니다, 미라쥬 씨!"

msgid "adv_303602_0029_msg"
msgstr "천만에요, 프레이아"

msgid "adv_303602_0031_msg"
msgstr "약속 받아냈어"

msgid "adv_303602_0032_msg"
msgstr "레이나 씨!?"

msgid "adv_303602_0034_msg"
msgstr "미라미라!\\r\\n엄청 귀여운 의상 골라줄게!"

msgid "adv_303602_0035_msg"
msgstr "마, 마키나 씨까지!"

msgid "adv_303602_0036_msg"
msgstr "…어쩔 수 없네요.\\r\\n프레이아와 약속했으니 저도 각오하겠습니다!"

msgid "adv_303602_0037_msg"
msgstr "오오~!"

msgid "adv_303602_0038_msg"
msgstr "할로윈, 같이 즐겨요!"

msgid "adv_104201_0008_msg"
msgstr "으음… 어떻게 할까"

msgid "adv_104201_0010_msg"
msgstr "카나메, 왜 그래?"

msgid "adv_104201_0011_msg"
msgstr "미쿠모!"

msgid "adv_104201_0012_msg"
msgstr "사실 다음 라이브의 테마를 정하려고\\r\\n생각하고 있는데…"

msgid "adv_104201_0013_msg"
msgstr "뭔가 좋은 테마가 없을까 고민하고 있었어"

msgid "adv_104201_0014_msg"
msgstr "그래"

msgid "adv_104201_0015_msg"
msgstr "『고마워 투어』는 모두에게 고맙다는 마음을\\r\\n전하는 좋은 라이브였잖아?"

msgid "adv_104201_0016_msg"
msgstr "이번 라이브도 좋은 라이브로 만들려면\\r\\n역시 테마가 필요하다고 생각했거든"

msgid "adv_104201_0017_msg"
msgstr "미쿠모는 뭔가 생각나는 거 있어?"

msgid "adv_104201_0018_msg"
msgstr ""

msgid "adv_104201_0019_msg"
msgstr "미쿠모?"

msgid "adv_104201_0020_msg"
msgstr "그러네, 『포기하지 않는다』는 어때?"

msgid "adv_104201_0021_msg"
msgstr "『포기하지 않는다』…?"

msgid "adv_104201_0022_msg"
msgstr "응"

msgid "adv_104201_0023_msg"
msgstr "무언가에 도전하고, 그걸 『포기하지 않는다』"

msgid "adv_104201_0024_msg"
msgstr "아주 단순하지만 어려운 일"

msgid "adv_104201_0025_msg"
msgstr "확실히 그렇네…"

msgid "adv_104201_0026_msg"
msgstr "…조금 의외의 제안이긴 하지만\\r\\n괜찮을지도 모르겠어"

msgid "adv_104201_0027_msg"
msgstr "『포기하지 않는다』는 말은\\r\\n우리 왈큐레한테도 잘 어울릴 것 같아!"

msgid "adv_104201_0028_msg"
msgstr "다른 모두의 의견도 들어보자!"

msgid "adv_104201_0029_msg"
msgstr "응"

msgid "adv_104202_0010_msg"
msgstr "미쿠모! 수고했어!"

msgid "adv_104202_0011_msg"
msgstr "오늘 고마워.\\r\\n정말 좋은 라이브가 됐어…!"

msgid "adv_104202_0012_msg"
msgstr "난 그냥 노래했을 뿐이야"

msgid "adv_104202_0013_msg"
msgstr "그래도 목표로 했던 『지금까지보다\\r\\n더욱 호흡을 맞춘 무대』가 된 것 같아"

msgid "adv_104202_0014_msg"
msgstr "후훗, 많이 연습했잖아"

msgid "adv_104202_0015_msg"
msgstr "안무를 맞추는 타이밍도\\r\\n완벽했어!"

msgid "adv_104202_0016_msg"
msgstr "그래"

msgid "adv_104202_0017_msg"
msgstr "…있잖아, 미쿠모. 하나 물어봐도 돼?"

msgid "adv_104202_0018_msg"
msgstr "뭐?"

msgid "adv_104202_0019_msg"
msgstr "미쿠모는 이번에 뭘 『포기하지 않을』 생각이었어?"

msgid "adv_104202_0020_msg"
msgstr ""

msgid "adv_104202_0021_msg"
msgstr "딱히 깊은 뜻은 없는데…"

msgid "adv_104202_0022_msg"
msgstr "도전해보고 싶은 일로 나와의 듀엣을\\r\\n말해줘서 기뻤어"

msgid "adv_104202_0023_msg"
msgstr "그래도 역시 조금 신경 쓰였다고 해야 하나…"

msgid "adv_104202_0024_msg"
msgstr "그러네… 누군가와 함께 노래하는 것…일까"

msgid "adv_104202_0025_msg"
msgstr "이렇게 오랜 시간을 함께 쌓아왔기 때문에,\\r\\n더욱 강하게 느끼게 됐어"

msgid "adv_104202_0026_msg"
msgstr "누군가와 함께 노래하는 걸 포기하고 싶지 않다고"

msgid "adv_104202_0027_msg"
msgstr "그래서 도전한 거야"

msgid "adv_104202_0028_msg"
msgstr "너와 어디까지 마음을 맞춰 노래할 수 있을지.\\r\\n그 너머에 펼쳐질 미지의 세계를 보고 싶다고"

msgid "adv_104202_0029_msg"
msgstr "…소감 물어봐도 돼?"

msgid "adv_104202_0030_msg"
msgstr "나쁘지 않았어"

msgid "adv_104202_0031_msg"
msgstr "후훗, 그렇구나…"

msgid "adv_104202_0032_msg"
msgstr "있잖아, 미쿠모.\\r\\n나도 정말 즐거웠어!"

msgid "adv_104202_0033_msg"
msgstr "…그거 다행이네"

msgid "adv_100364901_0004_msg"
msgstr "있잖아, 제안이 하나 있는데… 그 머리 모양, 바꿔보지 않을래?\\r\\n머리 모양을 바꾸면 안 된다는 규칙은 없잖아?"

msgid "adv_100364901_0005_msg"
msgstr "그건 확실히 그렇긴 하지만…\\r\\n딱히 바꿀 이유도 없어서요"

msgid "adv_100364901_0006_msg"
msgstr "무슨 소리야! 꾸미는 데 이유가 필요한 건 아니잖아!\\r\\n풀어도 잘 어울릴 것 같아, 카나메는 미인이니까"

msgid "adv_100364901_0007_msg"
msgstr "딱히, 미, 미인은 아니라고 생각하는데요…"

msgid "adv_100364901_0008_msg"
msgstr "됐으니까, 됐으니까!\\r\\n부탁이야, 나한테 맡겨주지 않을래?"

msgid "adv_100364901_0009_msg"
msgstr "알겠습니다… 너무 심하게는 하지 말아주세요"

msgid "adv_100364901_0010_msg"
msgstr "응! 모두를 깜짝 놀라게 해주자!"

msgid "adv_100364902_0004_msg"
msgstr "그러고 보니 란카 씨의 귀여운 몸짓…\\r\\n뭔가 비결이 있는 걸까요?"

msgid "adv_100364902_0005_msg"
msgstr "비결이요!? 전혀 생각해본 적 없어요"

msgid "adv_100364902_0006_msg"
msgstr "예를 들면 어떻게 보여줄지, 뭘 의식한다든지…\\r\\n존경하는 란카 씨에게 한 명의 아이돌로서 배우고 싶어요"

msgid "adv_100364902_0007_msg"
msgstr "가, 감사합니다.\\r\\n그런데 저는 늘 눈앞의 일에 정신이 없어서,\\r\\n어떻게 보여줄지까지 신경 쓸 여유가 없거든요…"

msgid "adv_100364902_0008_msg"
msgstr "앗, 죄송해요!\\r\\n이래서는 전혀 참고가 안 되겠네요…"

msgid "adv_100364902_0009_msg"
msgstr "아니에요, 분명 그런 열심인 모습이\\r\\n란카 씨의 귀여움 비결인 거겠죠! 후훗, 멋져요!"

msgid "adv_100364902_0010_msg"
msgstr "귀여움… 에헤헤, 카나메 씨한테 그런 말을 들으니까,\\r\\n왠지 부끄럽네요"

msgid "adv_100366101_0004_msg"
msgstr "미쿠모, 수고했어. 레슨은 이제 끝났어?"

msgid "adv_100366101_0005_msg"
msgstr "응.\\r\\n…카나메, 여기 앉을게"

msgid "adv_100366101_0006_msg"
msgstr "…별일이네, 미쿠모가 일부러 옆에 앉다니.\\r\\n무슨 일 있어?"

msgid "adv_100366101_0007_msg"
msgstr "오늘은 그러고 싶은 기분이야"

msgid "adv_100366101_0008_msg"
msgstr "…후훗. 미쿠모도 참, 왠지 고양이 같네"

msgid "adv_100366101_0009_msg"
msgstr "그래? 그럼 무릎 위에라도 올라가볼까?"

msgid "adv_100366101_0010_msg"
msgstr "좋긴 한데, 그대로 잠들지는 마?"

msgid "adv_100366102_0004_msg"
msgstr "있잖아, 쿠모쿠모. 오늘은 이 의상 입어줄래?"

msgid "adv_100366102_0005_msg"
msgstr "응, 알겠어"

msgid "adv_100366102_0006_msg"
msgstr "다행이다~!\\r\\n이런 귀엽고 프릴 가득한 의상,\\r\\n쿠모쿠모는 싫어할지도 몰라서 조금 걱정했어!"

msgid "adv_100366102_0007_msg"
msgstr "…이걸 입으면 네가\\r\\n『너무 귀여워』라고 외치면서 좋아할 거잖아?"

msgid "adv_100366102_0008_msg"
msgstr "가끔 그 목소리가 듣고 싶어지거든"

msgid "adv_100366102_0009_msg"
msgstr "어!? 정말!?\\r\\n…잠깐, 쿠모쿠모! 자세히 얘기해줘!"

msgid "adv_1400301_0009_msg"
msgstr "프레프레, 다 갈아입었어~?"

msgid "adv_1400301_0011_msg"
msgstr "저기… 이런 느낌이면 되는 건가요?"

msgid "adv_1400301_0012_msg"
msgstr "이, 이건…!"

msgid "adv_1400301_0013_msg"
msgstr "최고로 너무 귀여워~!!"

msgid "adv_1400301_0014_msg"
msgstr "에헤헤…! 마키나 씨, 귀여운 의상 만들어주셔서\\r\\n감사합니다!"

msgid "adv_1400301_0015_msg"
msgstr "천만에!"

msgid "adv_1400301_0016_msg"
msgstr "그나저나… 이 의상을 입으니까\\r\\n드디어 왈큐레 카페가 시작되는구나~ 하는\\r\\n실감이 나네"

msgid "adv_1400301_0017_msg"
msgstr "그러네요…!\\r\\n왠지 이렇게, 허리가 쭉 펴지는 기분이에요!"

msgid "adv_1400301_0019_msg"
msgstr "둘 다, 다 갈아입었어?"

msgid "adv_1400301_0020_msg"
msgstr "네~! 완료했어, 레이레이!"

msgid "adv_1400301_0021_msg"
msgstr "완벽해요!"

msgid "adv_1400301_0022_msg"
msgstr "좋아"

msgid "adv_1400301_0023_msg"
msgstr "왈큐레 카페는 새로운 도전"

msgid "adv_1400301_0024_msg"
msgstr "맞아. 라이브 전에 실제로 카페를 운영하고,\\r\\n그다음 라이브 연출에도 활용한다…"

msgid "adv_1400301_0025_msg"
msgstr "새로운 것투성이라 두근두근해!"

msgid "adv_1400301_0026_msg"
msgstr "팬 여러분과 더 많이 교류해보고 싶다는\\r\\n도전이 이 카페에서 실현되겠네요!"

msgid "adv_1400301_0027_msg"
msgstr "맞아, 맞아!\\r\\n카나카나랑 쿠모쿠모한테 지지 않을 만큼 열심히 하자!"

msgid "adv_1400301_0028_msg"
msgstr "네엣!"

msgid "adv_1400301_0029_msg"
msgstr "뭐든 덤벼"

msgid "adv_1400301_0030_msg"
msgstr "좋~아!\\r\\n왈큐레 카페, 힘차게 가보자~!"

msgid "adv_1400301_0031_msg"
msgstr "오~!"

msgid "adv_1400302_0009_msg"
msgstr "하아… 끝나버렸네, 왈큐레 카페"

msgid "adv_1400302_0010_msg"
msgstr "그러네요.\\r\\n진짜 바쁘고 힘든 며칠이었지만…"

msgid "adv_1400302_0011_msg"
msgstr "끝나고 나니까 그건 그것대로 아쉬운 기분도 들어요"

msgid "adv_1400302_0012_msg"
msgstr "프레프레도 그렇게 생각해?"

msgid "adv_1400302_0013_msg"
msgstr "라이브도 있고, 새의 인간과의 싸움도 있으니\\r\\n계속 카페를 할 수는 없다고\\r\\n생각하지만…"

msgid "adv_1400302_0014_msg"
msgstr "그래도 그렇기 때문에 우리에겐\\r\\n팬 여러분과 제로 거리에서 교류하는 시간이\\r\\n필요하다고 생각해"

msgid "adv_1400302_0015_msg"
msgstr "그러네요!"

msgid "adv_1400302_0016_msg"
msgstr "확실히 저도\\r\\n팬 여러분과 제로 거리에서 교류하면서\\r\\n진짜 힘을 많이 받았어요!"

msgid "adv_1400302_0017_msg"
msgstr "모두를 위해 내일부터의 싸움도 열심히 하자고\\r\\n지금 그런 마음으로 가득해요!"

msgid "adv_1400302_0018_msg"
msgstr "레이레이도 완전히 의욕이 넘치는 것 같고,\\r\\n기회가 되면 또 하자, 왈큐레 카페!"

msgid "adv_1400302_0019_msg"
msgstr "네!"

msgid "adv_1400302_0020_msg"
msgstr "그러고 보니 그 레이나 씨는 어디에?"

msgid "adv_1400302_0021_msg"
msgstr "음~. 아마 사무실 아닐까?"

msgid "adv_1400302_0022_msg"
msgstr "레이레이도 왈큐레 카페를\\r\\n엄청 마음에 들어 한 것 같고"

msgid "adv_1400302_0023_msg"
msgstr "오너가 돼서 더 자극적인 카페로 만들겠다고\\r\\n의욕 넘치더라!"

msgid "adv_1400302_0024_msg"
msgstr "오~!\\r\\n평소의 레이나 씨네요!"

msgid "adv_1400302_0025_msg"
msgstr "후훗. 그러네!"

msgid "adv_104301_0009_msg"
msgstr "셰릴 씨.\\r\\n오늘 불러주셔서 감사했습니다!"

msgid "adv_104301_0010_msg"
msgstr "프론티어의 크리스마스 일루미네이션…\\r\\n정말 아름다웠어요"

msgid "adv_104301_0011_msg"
msgstr "후훗, 즐거웠던 것 같아서 다행이네"

msgid "adv_104301_0012_msg"
msgstr "그나저나 이제 곧 한 해가 끝난다니…\\r\\n시간 참 빨리 지나가네"

msgid "adv_104301_0013_msg"
msgstr "정말 그러네요…"

msgid "adv_104301_0014_msg"
msgstr "있잖아. 카나메는 어릴 때 보냈던 크리스마스를\\r\\n기억해?"

msgid "adv_104301_0015_msg"
msgstr "어릴 때의 크리스마스요?"

msgid "adv_104301_0016_msg"
msgstr "나는 말이야, 크리스마스가 다가오면\\r\\n그레이스와 함께 축하했던 특별한 하루를\\r\\n떠올려"

msgid "adv_104301_0017_msg"
msgstr "함께 먹었던 케이크 맛과 선물의 색깔.\\r\\n그때 느꼈던 즐거운 마음도…"

msgid "adv_104301_0018_msg"
msgstr "크리스마스가 다가오면 이상하게 특별한 기분이 드는 건\\r\\n어릴 적 기억 때문일지도 모르겠네!"

msgid "adv_104301_0019_msg"
msgstr "…어떤 행성에도, 어떤 한 해에도\\r\\n반드시 크리스마스는 찾아와"

msgid "adv_104301_0020_msg"
