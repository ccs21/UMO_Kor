msgid "adv_102601_0018_msg"
msgstr "…그래. 그럼 다녀올게"

msgid "adv_102601_0022_msg"
msgstr "셰릴 씨!\\r\\n오늘 라이브, 힘내요!"

msgid "adv_102601_0023_msg"
msgstr "란카!"

msgid "adv_102601_0024_msg"
