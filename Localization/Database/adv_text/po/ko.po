msgid "adv_102702_0008_msg"
msgstr "아~! 실컷 놀았다~!"

msgid "adv_102702_0009_msg"
msgstr "대만족"

msgid "adv_102702_0010_msg"
msgstr "네엣!\\n오늘 하루 정말 감사했습니다!"

msgid "adv_102702_0012_msg"
msgstr "자, 다들 슬슬 돌아가자.\\n내일부터는 다시 라이브를 위한 레슨이야!"

msgid "adv_102702_0013_msg"
msgstr "네~!"

msgid "adv_102702_0015_msg"
msgstr ""

msgid "adv_102702_0016_msg"
msgstr "하야테"

msgid "adv_102702_0017_msg"
msgstr "왜?"

msgid "adv_102702_0018_msg"
msgstr "고마워. 오늘 하루 수고했어"

msgid "adv_102702_0019_msg"
msgstr "미쿠모한테 감사 인사를 들으니까 좀 어색하네…"

msgid "adv_102702_0020_msg"
msgstr "그래"

msgid "adv_102702_0021_msg"
msgstr "뭐, 오늘 미쿠모는\\n하루 종일 그런 느낌이었지만"

msgid "adv_102702_0022_msg"
msgstr "정말 즐거워 보였어"

msgid "adv_102702_0023_msg"
msgstr ""

msgid "adv_102702_0024_msg"
msgstr "추억이 갖고 싶었어"

msgid "adv_102702_0025_msg"
msgstr ""

msgid "adv_102702_0026_msg"
msgstr "내겐 추억이 적으니까"

msgid "adv_102702_0027_msg"
msgstr "최근에 다른 시공의 모두와\\n어울리면서 깨달았어"

msgid "adv_102702_0028_msg"
msgstr "기억은 마음을 만들고. 마음은 노래를 연주한다…고"

msgid "adv_102702_0029_msg"
msgstr "그래서 나도 추억을 모아가려고 해"

msgid "adv_102702_0030_msg"
msgstr "조금씩이면 돼.\\n왈큐레 모두와의 추억을…"

msgid "adv_102702_0031_msg"
msgstr "미쿠모…"

msgid "adv_102702_0032_msg"
msgstr "하야테가 찍는 사진, 싫지 않아"

msgid "adv_102702_0033_msg"
msgstr "우리가 즐겁다고 느낀 순간을\\n빠짐없이 담아주고 있어"

msgid "adv_102702_0034_msg"
msgstr "파일럿보다 사실은 사진가가 더 어울리는 거 아니야?"

msgid "adv_102702_0035_msg"
msgstr "…하하. 그거 고맙네.\\n하지만 아마 나도 같이 즐겼기 때문일 거야"

msgid "adv_102702_0036_msg"
msgstr "카메라 담당을 맡았을 때는\\n솔직히 이걸 어쩌라는 거야 싶었는데…"

msgid "adv_102702_0037_msg"
msgstr "너희가 어린애처럼 신나게 노는 걸 보고 있으니까\\n나도 덩달아 엄청 즐거워지더라고"

msgid "adv_102702_0038_msg"
msgstr "나도 나름 좋은 추억을 남긴 것 같아.\\n그러니까… 소중히 간직해줘. 오늘 찍은 사진들"

msgid "adv_102702_0039_msg"
msgstr "응. 물론이지"

msgid "adv_302401_0009_msg"
msgstr "헤에…"

msgid "adv_302401_0011_msg"
msgstr "셰릴 씨! 수고하셨어요"

msgid "adv_302401_0012_msg"
msgstr "수고했어, 란카.\\r\\n그쪽 촬영도 끝났어?"

msgid "adv_302401_0013_msg"
msgstr "네! 셰릴 씨는 뭘 보고 계세요?"

msgid "adv_302401_0014_msg"
msgstr "이거야"

msgid "adv_302401_0015_msg"
msgstr "초시공 SNS…?\\r\\n왈큐레 모두도 바다에 와 있네요!"

msgid "adv_302401_0016_msg"
msgstr "그런 것 같네.\\r\\n저쪽은 완전히 쉬는 날인 것 같지만"

msgid "adv_302401_0017_msg"
msgstr "와아. 정말 대단한 우연이네요!"

msgid "adv_302401_0018_msg"
msgstr "…후훗. 다들 완전히 신났네"

msgid "adv_302401_0019_msg"
msgstr "…다섯 명이 색깔만 다른 수영복이구나.\\r\\n정말 귀여워~!"

msgid "adv_302401_0020_msg"
msgstr "어머. 맞춰 입은 수영복이라면\\r\\n오늘 우리도 지지 않거든"

msgid "adv_302401_0021_msg"
msgstr "후훗, 그러네요!\\r\\n맞춰 입은 수영복으로 촬영하는 일은 별로 없으니까\\r\\n…기뻐요!"

msgid "adv_302401_0023_msg"
msgstr "어이, 셰릴, 란카. 목 안 말라?"

msgid "adv_302401_0024_msg"
msgstr "어머, 알토가 웬일로 센스가 있네?"

msgid "adv_302401_0025_msg"
msgstr "내가 생각한 거 아니야.\\r\\n…미셸이 음료수 가져다주라고 해서"

msgid "adv_302401_0026_msg"
msgstr "역시 미셸이었네"

msgid "adv_302401_0027_msg"
msgstr "고마워, 알토 군!"

msgid "adv_302401_0028_msg"
msgstr "…그런데 둘 다\\r\\n뭘 보고 그렇게 신나 있었던 거야?"

msgid "adv_302401_0029_msg"
msgstr "초시공 SNS. 왈큐레 모두가,\\r\\n우리처럼 바다에 와 있는 것 같아"

msgid "adv_302401_0030_msg"
msgstr "아, 이거구나.\\r\\n아까 하야테가 나한테 푸념하던 게…"

msgid "adv_302401_0031_msg"
msgstr "하야테, 미쿠모한테 부탁받아서\\r\\n촬영 담당으로 임명됐다면서요"

msgid "adv_302401_0032_msg"
msgstr "그런 것 같더라"

msgid "adv_302401_0033_msg"
msgstr "그런 거니까 알토도… 자!"

msgid "adv_302401_0034_msg"
msgstr "…자, 잠깐만! 뭐야, 이 카메라는…"

msgid "adv_302401_0035_msg"
msgstr "우리도 이 촬영이 끝나면 오늘은 쉬는 날이야"

msgid "adv_302401_0036_msg"
msgstr "하지만 카메라를 들고 있으면,\\r\\n란카랑 마음껏 놀 수가 없잖아?"

msgid "adv_302401_0037_msg"
msgstr "그러니까 비하인드 사진 촬영은 알토한테 맡길게.\\r\\n예쁘게 찍어줘, 알겠지?"

msgid "adv_302401_0038_msg"
msgstr "…정말, 너 말이야"

msgid "adv_302401_0039_msg"
msgstr "와~! 고마워, 알토 군!\\r\\n모두와 함께하는 여름 추억… 기쁘다"

msgid "adv_302401_0040_msg"
msgstr "후훗. 왈큐레 모두에게 지지 않을 만큼\\r\\n우리도 실컷 놀자, 란카!"

msgid "adv_302401_0041_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_302401_0042_msg"
msgstr "…정말, 어쩔 수 없네"

msgid "adv_302402_0008_msg"
msgstr "하아… 왠지 한꺼번에 피곤이 몰려오네…"

msgid "adv_302402_0010_msg"
msgstr "어이, 알토!"

msgid "adv_302402_0011_msg"
msgstr "하야테?"

msgid "adv_302402_0012_msg"
msgstr "수고했어. 오늘은 서로 고생 많았네"

msgid "adv_302402_0013_msg"
msgstr "그래… 뭐 그렇지"

msgid "adv_302402_0014_msg"
msgstr "우리 둘 다 고생이 많네.\\r\\n자유분방한 녀석들한테 휘둘려서 말이야"

msgid "adv_302402_0015_msg"
msgstr "헤헷. 그러게~"

msgid "adv_302402_0016_msg"
msgstr "…아~ 근데 나, 조금 그런 생각이 들었어.\\r\\n저 녀석들 사진 찍는 것도 의외로 재밌을지도 모르겠다고"

msgid "adv_302402_0017_msg"
msgstr "그래?"

msgid "adv_302402_0018_msg"
msgstr "응! 왜냐하면 말이야…"

msgid "adv_302402_0019_msg"
msgstr "저 녀석들 움직임을\\r\\n그렇게 필사적으로 쫓아다닐 일은\\r\\n좀처럼 없잖아?"

msgid "adv_302402_0020_msg"
msgstr "파인더 너머로 저 녀석들이\\r\\n마음껏 신나게 노는 모습을 바라보고…"

msgid "adv_302402_0021_msg"
msgstr "그러다 그중에서 괜찮은 사진 한 장이 찍히면\\r\\n나도 『해냈다!』 싶은 기분이 들더라고"

msgid "adv_302402_0022_msg"
msgstr "원래는 추억을 만들고 싶다는\\r\\n미쿠모의 부탁으로 시작한 일이지만…"

msgid "adv_302402_0023_msg"
msgstr "이래저래,\\r\\n오히려 내가 제일 많은 추억을 만든 것 같아"

msgid "adv_302402_0024_msg"
msgstr "추억…인가"

msgid "adv_302402_0025_msg"
msgstr "…정말. 너는 솔직해서 좋겠다, 하야테"

msgid "adv_302402_0026_msg"
msgstr "그래?"

msgid "adv_302402_0027_msg"
msgstr "그런 알토는 어땠어?\\r\\n오늘 하루 그 둘을 찍어보니까"

msgid "adv_302402_0028_msg"
msgstr "글쎄. 뭐랄까, 음…"

msgid "adv_302402_0029_msg"
msgstr "…둘이 즐거워하는 얼굴을 볼 수 있었던 건\\r\\n나쁘지 않았던 것 같아"

msgid "adv_302402_0030_msg"
msgstr "요즘\\r\\n새의 인간 때문에 사람들이 기억을 잃거나 습격당하는 일이 계속돼서\\r\\n둘 다 계속 긴장하고 있었던 것 같고"

msgid "adv_302402_0031_msg"
msgstr "오늘은 웃는 얼굴도 볼 수 있었고…\\r\\n둘도 푹 쉬면서 기분 전환할 수 있었다면 다행이지"

msgid "adv_302402_0032_msg"
msgstr "헤에… 그렇구나"

msgid "adv_302402_0033_msg"
msgstr "알토는 평소에도\\r\\n둘을 잘 지켜보고 있구나"

msgid "adv_302402_0034_msg"
msgstr "! 벼, 별로 그런 건…"

msgid "adv_302402_0035_msg"
msgstr "어쨌든 말이야. 내일부터는 또 싸움이 시작돼"

msgid "adv_302402_0036_msg"
msgstr "앞으로도 저 녀석들의 노래를 지킬 수 있게\\r\\n서로 힘내자!"

msgid "adv_302402_0037_msg"
msgstr "하야테…"

msgid "adv_302402_0038_msg"
msgstr "…그래. 그러자"

msgid "adv_302402_0041_msg"
msgstr "잠깐, 알토! 빨리 오라니까!"

msgid "adv_302402_0042_msg"
msgstr "알토 군!"

msgid "adv_302402_0045_msg"
msgstr "부르는데?"

msgid "adv_302402_0046_msg"
msgstr "그래, 그럼 또 보자. 하야테"

msgid "adv_302402_0047_msg"
msgstr "응!"

msgid "adv_102801_0009_msg"
msgstr "있잖아, 프레이아,\\r\\n잠깐 괜찮아?"

msgid "adv_102801_0011_msg"
msgstr "하야테! 갑자기 무슨 일이야?"

msgid "adv_102801_0012_msg"
msgstr "볼일이라고 할 정도는 아닌데… 어?"

msgid "adv_102801_0013_msg"
msgstr "…뭐랄까, 생각보다 멀쩡하네"

msgid "adv_102801_0014_msg"
msgstr "…??\\r\\n무슨 말인진 모르겠지만, 그보다 이것 좀 들어봐!"

msgid "adv_102801_0015_msg"
msgstr "오늘 라이브에서 란카 씨 앞에서\\r\\n『성간비행』을 부르게 됐어!"

msgid "adv_102801_0016_msg"
msgstr "아~ 들었어.\\r\\n그래서 난 당연히 네가 엄청 긴장해서\\r\\n딱딱하게 굳어 있을 줄 알았는데…"

msgid "adv_102801_0017_msg"
msgstr "…혹시 걱정돼서\\r\\n보러 와준 거야?"

msgid "adv_102801_0018_msg"
msgstr "뭐, 그렇지.\\r\\n긴장해서 딱딱하게 굳은 네 얼굴, 웃기거든"

msgid "adv_102801_0019_msg"
msgstr "하~야~테~!!!"

msgid "adv_102801_0020_msg"
msgstr "…뭐, 그래도 말이야.\\r\\n너 왜 그렇게 긴장 안 해?\\r\\n오히려 즐거워 보이기까지 하는데"

msgid "adv_102801_0021_msg"
msgstr "아무리 요즘 익숙해졌다 해도\\r\\n존경하는 사람 앞에서 그 사람의 노래를 부르는 거면\\r\\n평소의 너라면 돌처럼 굳어도 이상하지 않잖아"

msgid "adv_102801_0022_msg"
msgstr "왠지 기뻐"

msgid "adv_102801_0023_msg"
msgstr "…이거, 추억이 담긴 곡이거든.\\r\\n어렸을 때 지구인 아저씨한테\\r\\n받은 음악 플레이어에 들어 있었어"

msgid "adv_102801_0024_msg"
msgstr "정말 멋진 노래라고,\\r\\n나도 이런 식으로 노래하고 싶다고 생각했어"

msgid "adv_102801_0025_msg"
msgstr "이 곡이 있었기 때문에 지금 내가 여기 있는 거야"

msgid "adv_102801_0026_msg"
msgstr "…그렇구나"

msgid "adv_102801_0027_msg"
msgstr "그렇게 나한테 소중한 곡을,\\r\\n란카 씨… 아니, 그 란카 리 앞에서\\r\\n부를 수 있다니, 너무 기쁘고 즐거워서"

msgid "adv_102801_0028_msg"
msgstr "그런 거라면 확실히 긴장하고 있을 때가 아니네.\\r\\n본番, 힘내. 응원할게"

msgid "adv_102801_0029_msg"
msgstr "그럼 난 슬슬 갈게.\\r\\n긴장 푸는 건 좋은데 무대에서 넘어지진 마!"

msgid "adv_102801_0031_msg"
msgstr "정말~!!\\r\\n하야테는 항상 꼭 한마디가 더 많다니까!"

msgid "adv_102801_0032_msg"
msgstr "…그래도.\\r\\n고마워, 하야테"

msgid "adv_102801_0036_msg"
msgstr "어라, 하야테 군?\\r\\n웬일이야, 무슨 일이야?"

msgid "adv_102801_0037_msg"
msgstr "아~.\\r\\n란카한테 부탁할 게 좀 있어서…"

msgid "adv_102801_0038_msg"
msgstr "내가 할 수 있는 일이라면 들어볼게"

msgid "adv_102801_0039_msg"
msgstr "사실은 말이야……"

msgid "adv_102802_0009_msg"
msgstr "란카 씨!\\r\\n이번에는 정말, 정말 감사했습니다!"

msgid "adv_102802_0010_msg"
msgstr "어릴 적의 저한테 자랑하고 싶어요!\\r\\n정말 좋아하던 그 란카 리와 함께 노래했다고"

msgid "adv_102802_0011_msg"
msgstr "게다가 이렇게 멋진 커플 의상을 입고\\r\\n『성간비행』을 불렀다고…"

msgid "adv_102802_0012_msg"
msgstr "프레이아…"

msgid "adv_102802_0013_msg"
msgstr "이 추억, 평생의 보물로 간직할게요!"

msgid "adv_102802_0014_msg"
msgstr "과장이… 아니지.\\r\\n나도 그랬으니까"

msgid "adv_102802_0015_msg"
msgstr "란카 씨도…?"

msgid "adv_102802_0016_msg"
msgstr "응. 나도 동경하던 가희였던 셰릴 씨와\\r\\n처음 함께 노래했을 때의 감동은 잊을 수 없어"

msgid "adv_102802_0017_msg"
msgstr "…그렇구나.\\r\\n노래를 이어간다는 건 이런 거구나"

msgid "adv_102802_0018_msg"
msgstr "어려운 건 잘 모르겠지만… 그래도,\\r\\n저한테는 특별한 라이브가 됐어요"

msgid "adv_102802_0019_msg"
msgstr "후훗, 그러네.\\r\\n나한테도 정말 특별한 라이브였어!"

msgid "adv_102802_0020_msg"
msgstr "맞다, 프레이아.\\r\\n이번 일을 계획한 건 사실 내가 아니야"

msgid "adv_102802_0021_msg"
msgstr "네!? 란카 씨가 아니었어요?"

msgid "adv_102802_0022_msg"
msgstr "…지난번 프레이아의 라이브가 끝난 뒤,\\r\\n하야테 군한테 연락이 왔거든"

msgid "adv_102802_0023_msg"
msgstr "『성간비행』을 같이 불러달라고.\\r\\n프레이아를 놀라게 해주고 싶다고 해서\\r\\n전부 비밀로 해서 미안해?"

msgid "adv_102802_0024_msg"
msgstr "하야테…\\r\\n란카 씨, 저… 잠깐 다녀올게요!"

msgid "adv_102802_0025_msg"
msgstr "응, 다녀와!"

msgid "adv_102802_0030_msg"
msgstr "하야테! 드디어 찾았어!"

msgid "adv_102802_0032_msg"
msgstr "프레이아?\\r\\n왜 그래, 그렇게 숨까지 차서"

msgid "adv_102802_0033_msg"
msgstr "란카 씨한테 들었어.\\r\\n이번 일을 계획한 게 하야테라고"

msgid "adv_102802_0034_msg"
msgstr "아~ 그거라면 난 아무것도 안 했어.\\r\\n노래를 부른 건 란카고\\r\\n옷을 만든 건 마키나 일행이고"

msgid "adv_102802_0035_msg"
msgstr "아니, 그렇지 않아.\\r\\n그러니까 제대로 말하고 싶어"

msgid "adv_102802_0036_msg"
msgstr "…고마워. 정말 기뻤어"

msgid "adv_102802_0037_msg"
msgstr "뭐, 가끔은 이런 것도 괜찮잖아?"

msgid "adv_102802_0038_msg"
msgstr "후훗! 그러네!"

msgid "adv_302501_0009_msg"
msgstr "바사라, 밀레느. 슬슬 쉬었다 할까"

msgid "adv_302501_0010_msg"
msgstr "응"

msgid "adv_302501_0011_msg"
msgstr "…으음"

msgid "adv_302501_0012_msg"
msgstr "밀레느?"

msgid "adv_302501_0013_msg"
msgstr "있잖아, 나 바다 가고 싶어!!"

msgid "adv_302501_0014_msg"
msgstr "…뭐?"

msgid "adv_302501_0015_msg"
msgstr "Fire Bomber 다 같이 바다에 가자!"

msgid "adv_302501_0016_msg"
msgstr "요즘 계속 같은 곳에서\\r\\n연습, 라이브, 연습, 라이브만 반복하고 있잖아?"

msgid "adv_302501_0017_msg"
msgstr "슬슬 신곡 아이디어도 얻을 겸,\\r\\n다 같이 밖에 나가는 게 좋을 것 같아!"

msgid "adv_302501_0018_msg"
msgstr "다른 녀석들이 바다에 간 걸 초시공 SNS에서 보고\\r\\n부러워진 것뿐이잖아?"

msgid "adv_302501_0019_msg"
msgstr "!? 그, 그런 거 아니거든!"

msgid "adv_302501_0020_msg"
msgstr "자자, 둘 다 진정해"

msgid "adv_302501_0021_msg"
msgstr "슬슬 밀레느가\\r\\n그런 말을 할 때가 됐다고 생각하고 있었어"

msgid "adv_302501_0022_msg"
msgstr "간다, 바다. 대신 일이야"

msgid "adv_302501_0023_msg"
msgstr "정말!?"

msgid "adv_302501_0024_msg"
msgstr "응. 리조트 함에 있는 바닷가 가게의\\r\\n오프닝 이벤트에 나와달라는 의뢰가 들어왔어"

msgid "adv_302501_0025_msg"
msgstr "야호~!\\r\\n레이 고마워, 정말 좋아해~!"

msgid "adv_302501_0026_msg"
msgstr "하하… 과장이 심하네.\\r\\n감사 인사는 일을 따온 아키코한테 해"

msgid "adv_302501_0030_msg"
msgstr "미레미레! 들었어!\\r\\n바다 가게 됐다며?"

msgid "adv_302501_0031_msg"
msgstr "마키나~! 응, 맞아!"

msgid "adv_302501_0032_msg"
msgstr "후훗. 미레미레 정말 신나 보이네~.\\r\\n계속 『나도 바다 가고 싶어』라고 했었잖아"

msgid "adv_302501_0033_msg"
msgstr "어쩌면 아키코 씨한테도,\\r\\n그런 미레미레의 마음이 전해졌을지도?"

msgid "adv_302501_0034_msg"
msgstr "그런데 미레미레. 바다 갈 준비는 다 됐어?"

msgid "adv_302501_0035_msg"
msgstr "음. 사실 제일 중요한 수영복이 아직…"

msgid "adv_302501_0036_msg"
msgstr "후훗! 이럴 줄 알고~!"

msgid "adv_302501_0037_msg"
msgstr "마키마키가 정말 좋아하는 미레미레를 위해\\r\\n너무 귀여운 수영복을 디자인했습니다!"

msgid "adv_302501_0038_msg"
msgstr "뭐!?"

msgid "adv_302501_0042_msg"
msgstr "와~! 정말 귀여운 수영복!\\r\\n역시 마키나네"

msgid "adv_302501_0043_msg"
msgstr "응응, 미레미레 너무 귀여워~!!"

msgid "adv_302501_0044_msg"
msgstr "이걸 입고 라이브하면\\r\\n모두가 미레미레한테 푹 빠질 거야!"

msgid "adv_302501_0045_msg"
msgstr "아무리 그 사람이라도 말이지!"

msgid "adv_302501_0046_msg"
msgstr "그 사람??"

msgid "adv_302501_0047_msg"
msgstr "후훗! 아무것도 아니야! 바다, 재밌게 즐기고 와!"

msgid "adv_302501_0048_msg"
msgstr "응! 마키나, 수영복 고마워!\\r\\n사진 잔뜩 보내줄게!"

msgid "adv_302502_0009_msg"
msgstr "하아……"

msgid "adv_302502_0011_msg"
msgstr "실례할게"

msgid "adv_302502_0012_msg"
msgstr "미쿠모인가. 무슨 일이야?"

msgid "adv_302502_0013_msg"
msgstr "리조트 함의 바다가 보고 싶어졌어"

msgid "adv_302502_0014_msg"
msgstr "…아름답네.\\r\\n라그나와는 달리 사람이 만든 바다인데도"

msgid "adv_302502_0015_msg"
msgstr "바다는 바다잖아"

msgid "adv_302502_0016_msg"
msgstr "바다는 바다…?"

msgid "adv_302502_0017_msg"
msgstr "뭐야. 내가 이상한 말이라도 했어?"

msgid "adv_302502_0018_msg"
msgstr "…아니"

msgid "adv_302502_0019_msg"
msgstr "그런 네 생각,\\r\\n싫지 않아"

msgid "adv_302502_0020_msg"
msgstr "그래"

msgid "adv_302502_0021_msg"
msgstr "그런데 한숨을 쉬고 있던 것 같은데?"

msgid "adv_302502_0022_msg"
msgstr "아… 피곤해서 그래.\\r\\n밀레느한테 어울려주다 보니까"

msgid "adv_302502_0023_msg"
msgstr "정말이지.\\r\\n저 녀석이랑 바다에 오면 늘 제대로 되는 일이 없어"

msgid "adv_302502_0024_msg"
msgstr "이제야 혼자 있게 됐으니까,\\r\\n내가 하고 싶은 걸 하려던 참이야"

msgid "adv_302502_0025_msg"
msgstr "하고 싶은 것이라"

msgid "adv_302502_0026_msg"
msgstr "그건 노래하는 것?"

msgid "adv_302502_0027_msg"
msgstr "당연하잖아"

msgid "adv_302502_0028_msg"
msgstr "이렇게 바다를 보면서 멍하니 있으면\\r\\n나도 모르게 입에서 노래가 나와"

msgid "adv_302502_0029_msg"
msgstr "바다까지 오는 건 귀찮지만 말이야.\\r\\n이런 곳에서 새 곡을 만드는 것도 의외로 나쁘지 않아"

msgid "adv_302502_0030_msg"
msgstr ""

msgid "adv_302502_0031_msg"
msgstr "…나는 자주 바다에 와서,\\r\\n해파리들에게 노래를 들려줘"

msgid "adv_302502_0032_msg"
msgstr "해파리한테?"

msgid "adv_302502_0033_msg"
msgstr "어머. 안 들려줘?"

msgid "adv_302502_0034_msg"
msgstr "응"

msgid "adv_302502_0035_msg"
msgstr "그래"

msgid "adv_302502_0036_msg"
msgstr "해파리가 있는지는 모르겠지만,\\n바다 녀석들한테 노래를 들려주는 것도 재밌겠네"

msgid "adv_302502_0037_msg"
msgstr "좀 헤엄쳐볼까"

msgid "adv_302502_0038_msg"
msgstr "응, 그래보는 것도 좋겠네"

msgid "adv_302502_0040_msg"
msgstr "잠깐, 바사라! …어, 미쿠모!"

msgid "adv_302502_0041_msg"
msgstr "즐기고 있는 것 같네"

msgid "adv_302502_0042_msg"
msgstr "응! 이제부터 바닷가 가게에서 파티할 거야!\\r\\n미쿠모도 잠깐 보고 갈래?"

msgid "adv_302502_0043_msg"
msgstr "바닷가 가게… 재밌겠네.\\r\\n그럼 나도 그래볼까"

msgid "adv_302502_0044_msg"
msgstr "마음대로 해"

msgid "adv_102901_0009_msg"
msgstr "란카, 있어?"

msgid "adv_102901_0010_msg"
msgstr "셰릴 씨. 무슨 일이세요?"

msgid "adv_102901_0011_msg"
msgstr "란카, 이 이벤트에 참가해본 적 있어?"

msgid "adv_102901_0012_msg"
msgstr "이건… 다음에 시내에서 열리는\\n할로윈 이벤트 전단지인가요?"

msgid "adv_102901_0013_msg"
msgstr "맞아! 아까 일하다 쉬는 시간에\\n스태프분한테 받았는데…"

msgid "adv_102901_0014_msg"
msgstr "다들 분장을 하고\\n거리를 돌아다닌다면서?"

msgid "adv_102901_0015_msg"
msgstr "네!\\n프론티어에서도 꽤 유명한 이벤트예요"

msgid "adv_102901_0016_msg"
msgstr "저는 참가해본 적은 없지만…\\n셰릴 씨, 관심 있으세요?"

msgid "adv_102901_0017_msg"
msgstr "응!"

msgid "adv_102901_0018_msg"
msgstr "프론티어는 정말 재밌는 곳이네!\\n모처럼이니까 나도 여기 사람들과 함께\\n이벤트를 즐겨보고 싶어"

msgid "adv_102901_0019_msg"
msgstr "있잖아, 란카.\\n너도 참가해본 적 없다고 했으니까…"

msgid "adv_102901_0020_msg"
msgstr "올해는 나랑 같이 참가해보지 않을래?"

msgid "adv_102901_0021_msg"
msgstr "가고 싶어요!\\n저도 한 번쯤 참가해보고 싶다고 생각했어요!"

msgid "adv_102901_0022_msg"
msgstr "그래도 셰릴 씨가 거리 한복판을 당당하게 돌아다니면,\\n눈에 띄어서 큰일 나는 거 아니에요…?"

msgid "adv_102901_0023_msg"
msgstr "후훗! 안 들키면 되지.\\n그러려고 『분장』하는 거잖아?"

msgid "adv_102901_0024_msg"
msgstr "아…!"

msgid "adv_102901_0025_msg"
msgstr "후훗. 다행이네!\\n역시 란카도 참가해보고 싶었던 거구나"

msgid "adv_102901_0026_msg"
msgstr "란카랑 같이 참가할 수 있으면 좋겠다고\\n생각하고 있었으니까, 기뻐"

msgid "adv_102901_0027_msg"
msgstr "셰릴 씨…"

msgid "adv_102901_0028_msg"
msgstr "그렇게 정했으면,\\n당장 의상을 준비해야겠네!"

msgid "adv_102901_0029_msg"
msgstr "그러네. 이런 걸 부탁하려면 역시…"

msgid "adv_102901_0033_msg"
msgstr "네네~! 마키마키 등장~!"

msgid "adv_102901_0034_msg"
msgstr "있잖아, 셰리셰리!\\n이번엔 어떤 의상을 만들 거야?"

msgid "adv_102901_0035_msg"
msgstr "역시 마키나! 말이 빨라서 좋네"

msgid "adv_102901_0036_msg"
msgstr "에헤헤~! 나 셰리셰리들 의상 만드는 거\\n정말 좋아하거든!"

msgid "adv_102901_0037_msg"
msgstr "이번엔 란란이랑 세트로?"

msgid "adv_102901_0038_msg"
msgstr "응. 두 사람분 할로윈 분장 의상을\\n부탁하고 싶어서"

msgid "adv_102901_0039_msg"
msgstr "와~! 할로윈이구나~! 재밌겠다~"

msgid "adv_102901_0040_msg"
msgstr "마키나 씨, 정말 부탁드려도 괜찮아요…?"

msgid "adv_102901_0041_msg"
msgstr "물론이지, 란란!\\n엄청 귀여운 의상으로 만들어줄게!"

msgid "adv_102901_0042_msg"
msgstr "우후훗. 정말 든든하네.\\n부탁할게, 마키나!"

msgid "adv_102901_0043_msg"
msgstr "맡겨달라냥!"

msgid "adv_102901_0044_msg"
msgstr "…냥?"

msgid "adv_102902_0009_msg"
msgstr "아이고.\\n대장님이 할로윈 의상을 원한다는 거\\n란카한테 들켜버렸네요?"

msgid "adv_102902_0010_msg"
msgstr "큭… 내가 이런 실수를…!"

msgid "adv_102902_0011_msg"
msgstr "그런데 란카, 드라큘라가 좋은 건가…?\\n그런 것의 어디가 좋은 거지"

msgid "adv_102902_0012_msg"
msgstr "자자. 란카도 여자애니까요"

msgid "adv_102902_0013_msg"
msgstr "아마 사실은 알토쯤 되는 사람에게\\n분장해줬으면 했던 거겠죠"

msgid "adv_102902_0014_msg"
msgstr "!? 뭐라고…!?"

msgid "adv_102902_0016_msg"
msgstr "대장, 미셸.\\n대체 뭐 하는 거야…"

msgid "adv_102902_0017_msg"
msgstr "알토오! 거기 똑바로 서!!"

msgid "adv_102902_0018_msg"
msgstr "우왓!? 뭐, 뭐야!? 갑자기!!"

msgid "adv_102902_0019_msg"
msgstr "하하하….\\n뭐, 일단 진정하시죠, 대장"

msgid "adv_102902_0020_msg"
msgstr "이번 할로윈에,\\n소중한 여동생 란카를 기쁘게 해주자는\\n그런 계획이었잖아요"

msgid "adv_102902_0021_msg"
msgstr "아, 그래…"

msgid "adv_102902_0022_msg"
msgstr "예전부터 거리에서 열리는 할로윈 이벤트에\\n참가하고 싶어 했는데, 내가 바빴던 탓에\\n계속 데려가주지 못했으니까…"

msgid "adv_102902_0023_msg"
msgstr "갑자기 나타난 셰릴에게 선수 뺏겨서\\n분했던 거죠?"

msgid "adv_102902_0024_msg"
msgstr "시끄러워! …뭐, 부정은 안 하겠지만"

msgid "adv_102902_0025_msg"
msgstr "부정 안 하는 거냐…"

msgid "adv_102902_0026_msg"
msgstr "…응?\\n대장. 밀레느한테 뭔가 왔습니다"

msgid "adv_102902_0027_msg"
msgstr "이건…"

msgid "adv_102902_0028_msg"
msgstr "…이거 바사라지?\\n이 의상은 분명 할로윈 때 그거…"

msgid "adv_102902_0029_msg"
msgstr "『바사라 의상 데이터 줄 테니까 힘내!\\n오빠!』…라고 하네요"

msgid "adv_102902_0030_msg"
msgstr "오오…!"

msgid "adv_102902_0031_msg"
msgstr "이, 이거다! 내가 원했던 건!"

msgid "adv_102902_0032_msg"
msgstr "뭐?"

msgid "adv_102902_0033_msg"
msgstr "당장 준비에 들어간다!\\n기다려라… 란카!"

msgid "adv_102902_0035_msg"
msgstr ""

msgid "adv_102902_0036_msg"
msgstr ""

msgid "adv_102902_0037_msg"
msgstr "이거 진짜 입는 거야…?\\n대장이…?"

msgid "adv_102902_0038_msg"
msgstr "뭐랄까…\\n별로 상상이 안 된다고 해야 하나…"

msgid "adv_102902_0039_msg"
msgstr "상상하고 싶지도 않은데…"

msgid "adv_302601_0010_msg"
msgstr "카나메 씨.\\r\\n왈큐레가 영화에 출연하게 됐다는 거,\\r\\n진짜야?"

msgid "adv_302601_0011_msg"
msgstr "어머! 아직 모두한테 말하지도 않았는데…\\r\\n소식이 정말 빠르네!"

msgid "adv_302601_0012_msg"
msgstr "어딘가의 누군가가,\\r\\n룬을 반짝반짝 빛내면서 알려주러 왔거든…"

msgid "adv_302601_0013_msg"
msgstr "그런데 프레이아 설명만 들어서는\\r\\n영화 내용이 전혀 이해가 안 되더라고"

msgid "adv_302601_0014_msg"
msgstr "프레이아가 뭐라고 했는데?"

msgid "adv_302601_0015_msg"
msgstr "인간과 바닷새의 유대를 그린 감동 대작.\\r\\n웃음과 섹시함도 있고, 손에 땀을 쥐게 하는\\r\\n액션 초대작! …이라고 했던가"

msgid "adv_302601_0016_msg"
msgstr "그리고 마지막 20분에는,\\r\\n관객의 예상을 뒤엎는 숨 돌릴 틈 없는 초전개가 기다리고 있다나"

msgid "adv_302601_0017_msg"
msgstr "스포일러하자면,\\r\\n정체불명의 거대 괴수가 라그나를 습격한다나…"

msgid "adv_302601_0018_msg"
msgstr "맞아, 맞아!\\r\\n대충 그런 내용이라고 보면 틀림없어"

msgid "adv_302601_0019_msg"
msgstr "…진짜냐"

msgid "adv_302601_0020_msg"
msgstr "이 일은 말이야. 내가 예전에 솔로 아이돌로 활동했을 때\\r\\n신세를 졌던 분께서 의뢰하신 거야"

msgid "adv_302601_0021_msg"
msgstr "그분, 영화감독은 처음이라나 봐…\\r\\n『지금까지의 영화 상식을 깨부숴주겠어!』라고 하면서\\r\\n엄청 의욕을 불태우고 있어"

msgid "adv_302601_0022_msg"
msgstr "그 의욕이 제대로 느껴질 만큼\\r\\n엉망진창인 내용이네…"

msgid "adv_302601_0023_msg"
msgstr "이 일, 정말 괜찮은 거야?"

msgid "adv_302601_0024_msg"
msgstr "나는 기꺼이 맡겠다고 했어!\\r\\n물론 왈큐레 모두도"

msgid "adv_302601_0025_msg"
msgstr "그런데 미쿠모는 말이지…"

msgid "adv_302601_0026_msg"
msgstr "아~. 그 녀석은 그런 거 별로 내켜 하지 않을 것 같긴 하지"

msgid "adv_302601_0027_msg"
msgstr "아니, 그게 아니야!"

msgid "adv_302601_0028_msg"
msgstr "미쿠모는 『이런 내용으론 부족해』라면서\\r\\n누구보다 의욕이 넘쳐!"

msgid "adv_302601_0029_msg"
msgstr "뭐…?"

msgid "adv_302601_0031_msg"
msgstr "하야테"

msgid "adv_302601_0032_msg"
msgstr "미쿠모!"

msgid "adv_302601_0033_msg"
msgstr "…잠깐, 너 얘기 듣고 있었어?"

msgid "adv_302601_0034_msg"
msgstr "너야말로 얘기 들었잖아?"

msgid "adv_302601_0035_msg"
msgstr "뭔가 좋은 아이디어 없을까.\\r\\n이 영화를 더 재미있게 만들 만한"

msgid "adv_302601_0036_msg"
msgstr "그렇게 말해도 말이지~.\\r\\n이미 충분히 영문 모를 영화잖아"

msgid "adv_302601_0037_msg"
msgstr "있잖아, 미쿠모! 나한테 좋은 생각이 있는데"

msgid "adv_302601_0038_msg"
msgstr "들려줘, 카나메"

msgid "adv_302601_0039_msg"
msgstr "『왈큐레에 환상의 여섯 번째 멤버 등장!?\\r』\\n이라는 건 어때?"

msgid "adv_302601_0040_msg"
msgstr "환상의…?"

msgid "adv_302601_0041_msg"
msgstr "여섯 번째?"

msgid "adv_302601_0042_msg"
msgstr "후훗.\\r\\n얼마 전에 본 히어로 영화 포스터에\\r\\n그렇게 적혀 있는 걸 봤거든"

msgid "adv_302601_0043_msg"
msgstr "꽤 흥미를 끌 만한 내용이라고 생각했는데,\\r\\n어때?"

msgid "adv_302601_0044_msg"
msgstr "…흐음. 그렇구나. 나쁘지 않네"

msgid "adv_302601_0045_msg"
msgstr "여섯 번째라니… 그건 누굴 시킬 생각이야?"

msgid "adv_302601_0046_msg"
msgstr "글쎄…"

msgid "adv_302601_0050_msg"
msgstr "읏!?"

msgid "adv_302601_0051_msg"
msgstr "…오한이. 감기라도 걸린 걸까요?"

msgid "adv_302602_0009_msg"
msgstr "하아… 드디어 평소 옷으로 돌아왔네요…"

msgid "adv_302602_0010_msg"
msgstr "아쉽네.\\r\\n좀 더 입고 있어줬으면 했는데"

msgid "adv_302602_0011_msg"
msgstr "자자, 미쿠모.\\r\\n본인이 이렇게까지 싫어하니까,\\r\\n이번에는 포기하자, 응?"

msgid "adv_302602_0012_msg"
msgstr "우우… 감사합니다. 카나메 씨"

msgid "adv_302602_0013_msg"
msgstr "카나메 씨가 와주시지 않았으면,\\r\\n무조건 감독님한테\\r\\n끌려갈 뻔했어요…"

msgid "adv_302602_0014_msg"
msgstr "모두와 초시공 SNS로 이야기를 나누고 있을 때,\\r\\n감독님한테 연락이 왔거든.\\r\\n좋은 아이디어가 떠올랐대"

msgid "adv_302602_0015_msg"
msgstr "뭔가 부족하다고 생각했던 부분에는,\\r\\n우리 라이브 장면을 넣기로 했대"

msgid "adv_302602_0016_msg"
msgstr "그쪽이 여러분답고 좋다고 생각합니다"

msgid "adv_302602_0017_msg"
msgstr "저는 이런 옷은 익숙하지도 않고…\\r\\n더군다나 스크린에 나선다니 당치도 않습니다"

msgid "adv_302602_0018_msg"
msgstr "저는 VF-31의 파일럿으로서,\\r\\n파일럿 슈트를 입고 여러분을 지키는 것이\\r\\n제 일이니까요"

msgid "adv_302602_0019_msg"
msgstr "…그러네. 그것도 너다운 모습이지"

msgid "adv_302602_0020_msg"
msgstr "하지만 말이야. 가끔은 평소와 다른 네 모습도\\r\\n보고 싶었어"

msgid "adv_302602_0021_msg"
msgstr "평소와 다른 모습…인가요?"

msgid "adv_302602_0022_msg"
msgstr "의상, 꽤 잘 어울렸어"

msgid "adv_302602_0023_msg"
msgstr "너도 사실,\\r\\n그렇게 싫지만은 않았지?"

msgid "adv_302602_0024_msg"
msgstr "…! 그, 그런 건…"

msgid "adv_302602_0025_msg"
msgstr ""

msgid "adv_302602_0026_msg"
msgstr "…전혀 그렇지 않다고 하면… 거짓말이겠지만…"

msgid "adv_302602_0027_msg"
msgstr "후훗"

msgid "adv_302602_0028_msg"
msgstr "우, 웃지 마세요! 미쿠모 씨!"

msgid "adv_302602_0029_msg"
msgstr "후훗. 다행이네.\\r\\n그럼 이건 좋은 기념사진 한 장이 됐겠네"

msgid "adv_302602_0030_msg"
msgstr "이거요? …잠깐, 카나메 씨.\\r\\n손에 들고 있는 그 이미지 데이터는!?"

msgid "adv_302602_0031_msg"
msgstr "레이나가 몰래 찍어뒀나 봐…"

msgid "adv_302602_0032_msg"
msgstr "꽤 잘 찍혔잖아"

msgid "adv_302602_0033_msg"
msgstr "나중에 밀레느한테 보내둘게"

msgid "adv_302602_0034_msg"
msgstr "네!?"

msgid "adv_302602_0035_msg"
msgstr "그, 그, 그것만은…!\\r\\n그것만은 하지 말아주세요~!!"

msgid "adv_302602_0036_msg"
msgstr "후훗…"

msgid "adv_103001_0009_msg"
msgstr "미라쥬, 잠깐 괜찮아?"

msgid "adv_103001_0010_msg"
msgstr "네? 뭔가요, 하야테"

msgid "adv_103001_0011_msg"
msgstr "부탁할 게 있는데.\\r\\n내일 하루, 시간 좀 내줄래?"

msgid "adv_103001_0012_msg"
msgstr "나 사실 아직 못 정했거든…\\r\\n프레이아 생일 선물"

msgid "adv_103001_0013_msg"
msgstr "뭐라고요!?\\r\\n프레이아 생일은 벌써 모레라고요!?"

msgid "adv_103001_0014_msg"
msgstr "목소리 너무 커. 프레이아한테 들리잖아?"

msgid "adv_103001_0015_msg"
msgstr "으… 그러고 보니 생일 파티 얘기는\\r\\n프레이아한테 비밀…이었죠"

msgid "adv_103001_0016_msg"
msgstr "하지만 계획이 정해진 뒤로\\r\\n벌써 며칠이나 지났잖아요? 오늘까지 대체\\r\\n뭘 하고 있었던 겁니까, 당신은"

msgid "adv_103001_0017_msg"
msgstr "어쩔 수 없잖아.\\r\\n걔한테 뭘 선물해야 좋아할지\\r\\n도무지 감이 안 잡혀서…"

msgid "adv_103001_0018_msg"
msgstr "그러니까 좀 같이 가줘.\\r\\n선물 고르러!"

msgid "adv_103001_0019_msg"
msgstr "정말이지… 어쩔 수 없네요"

msgid "adv_103001_0020_msg"
msgstr "알겠습니다. 그럼 내일 10시에\\r\\n쇼핑몰에서 만나죠"

msgid "adv_103001_0021_msg"
msgstr "땡큐! 살았다, 미라쥬"

msgid "adv_103001_0022_msg"
msgstr "그런데… 그렇게 잘난 듯이 말하는 걸 보니,\\r\\n너는 벌써 선물 정해둔 거겠지?"

msgid "adv_103001_0023_msg"
msgstr "당연하죠. 이미 구해뒀습니다"

msgid "adv_103001_0024_msg"
msgstr "헤에. 참고로 뭔데?"

msgid "adv_103001_0025_msg"
msgstr "이겁니다. 이번 주 DAISY DAISY에 실린\\r\\n인기 아이템인데…"

msgid "adv_103001_0026_msg"
msgstr "흐음… 아니, 너무 비싸지 않아?"

msgid "adv_103001_0027_msg"
msgstr "무슨 소리를 하는 겁니까.\\r\\n여성에게 주는 생일 선물이라고요?"

msgid "adv_103001_0028_msg"
msgstr "그 모습을 보니,\\r\\n예산조차 생각 안 한 것 같네요…"

msgid "adv_103001_0029_msg"
msgstr "아니, 선물은 돈이 중요한 게 아니잖아"

msgid "adv_103001_0030_msg"
msgstr "결국 마음이 담겨 있으면 되는 거 아니야?"

msgid "adv_103001_0031_msg"
msgstr "그건 그럴지도 모르지만…!"

msgid "adv_103001_0033_msg"
msgstr "둘이 무슨 얘기 하고 있어?"

msgid "adv_103001_0034_msg"
msgstr "! 프레이아…!"

msgid "adv_103001_0035_msg"
msgstr "아, 아무것도 아닙니다!\\r\\n그럼 저희는 이만!"

msgid "adv_103001_0037_msg"
msgstr "…호아? 왜 저러지…?"

msgid "adv_103001_0038_msg"
msgstr "다음 라이브에서 입을 새 의상,\\r\\n두 사람한테도 보여주고 싶었는데…"

msgid "adv_103001_0040_msg"
msgstr "프레이아"

msgid "adv_103001_0041_msg"
msgstr "앗… 네엣!\\r\\n리허설 시간이네요. 지금 갈게요!"

msgid "adv_103001_0043_msg"
msgstr ""

msgid "adv_103001_0044_msg"
msgstr "나도 생각해봐야겠네.\\r\\n프레이아의 생일 선물…"

msgid "adv_103002_0009_msg"
msgstr "하야테, 미라쥬 씨!\\r\\n어제는 정말 감사했습니다!"

msgid "adv_103002_0010_msg"
msgstr "너 어젯밤부터 계속\\r\\n그 말만 하고 있네"

msgid "adv_103002_0011_msg"
msgstr "말해도 말해도 부족할 정도로 고마운걸!"

msgid "adv_103002_0012_msg"
msgstr "그래그래.\\r\\n우린 이제 됐으니까, 이따 라이브에서\\r\\n팬들한테도 마음껏 전하고 와"

msgid "adv_103002_0013_msg"
msgstr "우히히. 그건 물론이지!"

msgid "adv_103002_0014_msg"
msgstr "어제 파티에서 제가 느꼈던,\\r\\n진짜 즐겁고 기운 팍팍 날 만큼 기뻤던 마음을\\r\\n모두도 느껴봤으면 좋겠어요!"

msgid "adv_103002_0015_msg"
msgstr "지금처럼 입이 귀에 걸린 너라면\\r\\n식은 죽 먹기겠네"

msgid "adv_103002_0016_msg"
msgstr "우히히히히히…"

msgid "adv_103002_0019_msg"
msgstr "완전히 들떴네"

msgid "adv_103002_0020_msg"
msgstr "그러게.\\r\\n너무 들떠서 넘어지지만 않으면 좋겠는데"

msgid "adv_103002_0021_msg"
msgstr "넘어지겠지. 아주 제대로"

msgid "adv_103002_0022_msg"
msgstr "아니, 단정하는 거냐…"

msgid "adv_103002_0023_msg"
msgstr "그래도… 그러네"

msgid "adv_103002_0024_msg"
msgstr "저 아이, 오늘은 좋은 노래를 부를 거야.\\r\\n분명 평소보다 더"

msgid "adv_103002_0025_msg"
msgstr "…헤에.\\r\\n네가 그런 식으로 말하다니 드문 일이네"

msgid "adv_103002_0026_msg"
msgstr "그렇게 말하면,\\r\\n네가 어제 준비했던 생일 선물도,\\r\\n꽤 뜻밖의 물건 아니었어?"

msgid "adv_103002_0027_msg"
msgstr "그래? 난 그냥 평범하다고 생각하는데…"

msgid "adv_103002_0028_msg"
msgstr "…잠깐. 내가 준 선물이 뭔지\\r\\n미쿠모가 왜 알고 있는 거야?"

msgid "adv_103002_0029_msg"
msgstr "그러고 보니 하야테,\\r\\n저랑 선물 찾으러 갔을 때는,\\r\\n결국 아무것도 안 사고 돌아왔죠?"

msgid "adv_103002_0030_msg"
msgstr "미쿠모 씨는 알고 계신 것 같은데…\\r\\n결국 뭘 선물한 겁니까?"

msgid "adv_103002_0031_msg"
msgstr "그건…"

msgid "adv_103002_0032_msg"
msgstr "…그건?"

msgid "adv_103002_0033_msg"
msgstr "…아~ 그러고 보니 나 지금부터 훈련이었네.\\r\\n메서가 화내기 전에 가야겠다"

msgid "adv_103002_0034_msg"
msgstr "그럼!"

msgid "adv_103002_0036_msg"
msgstr "뭐라고요!? 잠깐, 하야테!?\\r\\n…도망갔네…"

msgid "adv_103002_0037_msg"
msgstr "…왠지 오늘 하야테, 미쿠모 씨 같아요.\\r\\n저를 적당히 얼버무리면서 즐기고 있는 거 아니에요?"

msgid "adv_103002_0038_msg"
msgstr "그러네.\\r\\n넌 놀리는 재미가 있으니까"

msgid "adv_103002_0039_msg"
msgstr "그, 그런…"

msgid "adv_103002_0040_msg"
msgstr "궁금해? 하야테가 프레이아에게 뭘 선물했는지"

msgid "adv_103002_0041_msg"
msgstr "그건 말이지……"

msgid "adv_103002_0042_msg"
msgstr "…에에엣!? 그 하야테가,\\r\\n프레이아한테 그런 로맨틱한 걸…!?"

msgid "adv_103002_0043_msg"
msgstr "의외네요… 너무 의외예요…!"

msgid "adv_103002_0044_msg"
msgstr "하야테는 나와는 다른 의미로,\\r\\n미스터리한 사람이네"

msgid "adv_103002_0045_msg"
msgstr "…듣고 보니 그럴지도 모르겠네요"

msgid "adv_302701_0010_msg"
msgstr "있잖아, 있잖아, 바사라!"

msgid "adv_302701_0011_msg"
msgstr "시답잖은 얘기면 안 들을 거야"

msgid "adv_302701_0012_msg"
msgstr "정말! 시작부터 단정 짓지 마!\\r\\n아직 아무 말도 안 했잖아?"

msgid "adv_302701_0013_msg"
msgstr "네 얼굴 보면 대충 알아.\\r\\n딱 봐도 뭔가 시답잖은 생각을 하고 있는 얼굴이야"

msgid "adv_302701_0014_msg"
msgstr "흥이다. 시답잖은 거 아니거든!"

msgid "adv_302701_0015_msg"
msgstr "나는 앞으로의 Fire Bomber를 위해\\r\\n최고의 아이디어를 가져왔다고.\\r\\n바사라도 분명 마음에 들어 할 거야!"

msgid "adv_302701_0016_msg"
msgstr "…일단 들어는 줄게. 뭔데?"

msgid "adv_302701_0017_msg"
msgstr "다음 라이브에는 게스트 보컬을 부르자!"

msgid "adv_302701_0018_msg"
msgstr "기각"

msgid "adv_302701_0019_msg"
msgstr "그럴 줄 알았어…\\r\\n있잖아, 좀 제대로 들어보라니까!"

msgid "adv_302701_0020_msg"
msgstr "우리 팬도 늘었지만,\\r\\n슬슬 색다른 걸 해보는 게 모두도 좋아할 것 같아"

msgid "adv_302701_0021_msg"
msgstr "바사라도,\\r\\n슬슬 뭔가 자극이 필요하지 않아?"

msgid "adv_302701_0022_msg"
msgstr "…자극이라"

msgid "adv_302701_0023_msg"
msgstr "거봐! 조금 하고 싶어졌지?"

msgid "adv_302701_0024_msg"
msgstr "게스트 보컬은,\\r\\n다른 시공의 누군가에게 부탁할 생각이야.\\r\\n나 당장 사람들한테 물어볼게!"

msgid "adv_302701_0025_msg"
msgstr "마음대로 해"

msgid "adv_302701_0027_msg"
msgstr "앗, 잠깐 바사라!\\r\\n…가버렸네"

msgid "adv_302701_0028_msg"
msgstr "뭐야, 정말.\\r\\n겨우 관심을 보이나 했더니"

msgid "adv_302701_0030_msg"
msgstr "밀레느 씨, 안녕하세요!"

msgid "adv_302701_0031_msg"
msgstr "…그런데 밀레느, 무슨 일 있어?"

msgid "adv_302701_0032_msg"
msgstr "아. 프레이아, 란카!\\r\\n마침 잘 왔어!"

msgid "adv_302701_0035_msg"
msgstr "…라는 걸 생각하고 있는데…"

msgid "adv_302701_0036_msg"
msgstr "와아, 그거 정말 좋은데요!"

msgid "adv_302701_0037_msg"
msgstr "그렇지, 그렇지~!?"

msgid "adv_302701_0038_msg"
msgstr "그래서… 그 게스트를 누구로 할지는,\\r\\n벌써 정했어요?"

msgid "adv_302701_0039_msg"
msgstr "어? 어~ 그건 아직 안 정했는데…"

msgid "adv_302701_0040_msg"
msgstr "프레이아 비온, 지원하겠습니다!"

msgid "adv_302701_0041_msg"
msgstr "앗, 저, 저도요! 저도 하고 싶어요!"

msgid "adv_302701_0042_msg"
msgstr "와앗! 두, 둘 다,\\r\\n그렇게까지 바짝 다가오지 않아도…!"

msgid "adv_302701_0043_msg"
msgstr "밀레느 씨!"

msgid "adv_302701_0044_msg"
msgstr "밀레느!!"

msgid "adv_302701_0045_msg"
msgstr "으음… 어떻게 정하면 좋을까?"

msgid "adv_302702_0009_msg"
msgstr "레이나, 수고했어!\\r\\n게스트 보컬 맡아줘서 고마워!"

msgid "adv_302702_0010_msg"
msgstr "감사 인사는 필요 없어. 나도 즐거웠어"

msgid "adv_302702_0011_msg"
msgstr "마키나도 기뻐했어"

msgid "adv_302702_0012_msg"
msgstr "그렇구나. 그럼 다행이네!"

msgid "adv_302702_0013_msg"
msgstr "레이나의 연출도 굉장했고,\\r\\n덕분에 팬들도 정말 좋아해줬어"

msgid "adv_302702_0014_msg"
msgstr "…이번 라이브에서 부른 곡, 마음에 들었어"

msgid "adv_302702_0015_msg"
msgstr "특히 가사가 좋아"

msgid "adv_302702_0016_msg"
msgstr "가사? 그래?"

msgid "adv_302702_0017_msg"
msgstr "응"

msgid "adv_302702_0018_msg"
msgstr "자극이 없으면 즐길 수 없어.\\r\\n인생도, 노래도, 사랑도"

msgid "adv_302702_0019_msg"
msgstr "따끔따끔, 욱신욱신, 찌릿찌릿…\\r\\n더 많이 느끼게 하고 싶어. 느끼고 싶어"

msgid "adv_302702_0020_msg"
msgstr "항상 그렇게 생각해. 지루한 건 재미없어"

