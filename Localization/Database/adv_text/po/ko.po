msgid "adv_102002_0031_msg"
msgstr "후훗. 하야테 군도 분명 그런 말을\\r\\n하고 싶었던 게 아닐까?"

msgid "adv_102002_0032_msg"
msgstr "에엣!? 그, 그런 걸까요…?"

msgid "adv_102002_0033_msg"
msgstr "그래도 꼭 자신을 바꾸고 싶다면\\r\\n다른 부분을 바꿔보는 건 어때?"

msgid "adv_102002_0034_msg"
msgstr "평소와 다른 옷을 입어본다든가,\\r\\n헤어스타일을 조금 바꿔본다든가"

msgid "adv_102002_0035_msg"
msgstr "우선 겉모습부터 바꿔보는 거야. 그러면\\r\\n새로운 자신을 발견할 수 있을지도 몰라!"

msgid "adv_102002_0036_msg"
msgstr "겉모습부터 바꾼다…!\\r\\n그렇군요… 참고가 됐어요!"

msgid "adv_102002_0037_msg"
msgstr "맞다… 지금부터 하는 라이브,\\r\\n프레이아도 같이 나갈래?"

msgid "adv_102002_0038_msg"
msgstr "정말요!? 하지만… 괜찮을까요?"

msgid "adv_102002_0039_msg"
msgstr "당연하지! 자, 프레이아도 의상으로 갈아입어!"

msgid "adv_102002_0040_msg"
msgstr "네엣!"

msgid "adv_102002_0041_msg"
msgstr "올해도 1년 잘 부탁해, 프레이아!"

msgid "adv_102002_0042_msg"
msgstr "네엣!\\r\\n저야말로 잘 부탁드려요!"

msgid "adv_201801_0008_msg"
msgstr "와~! 셰리셰리다~!"

msgid "adv_201801_0009_msg"
msgstr "어머, 마키나잖아. 무슨 일이야?"

msgid "adv_201801_0010_msg"
msgstr "에헤헤… 란란한테,\\r\\n셰리셰리가 귀여운 기모노 의상을\\r\\n입고 있다고 들어서 저도 모르게 와버렸어~!"

msgid "adv_201801_0011_msg"
msgstr "얘기 들은 대로 오늘 의상, 정말 잘 어울려!\\r\\n평소 이미지랑 조금 다르기도 하고, 색다르달까…"

msgid "adv_201801_0012_msg"
msgstr "후훗! 고마워.\\r\\n사실 오늘은 지금까지 해본 적 없는 장르의 노래를 커버할 거야"

msgid "adv_201801_0013_msg"
msgstr "엔카라는 장르라던데…"

msgid "adv_201801_0014_msg"
msgstr "헤에~! 그렇구나!"

msgid "adv_201801_0016_msg"
msgstr "…갑자기 기모노 입었을 때의 몸가짐을 가르쳐달라고\\r\\n쳐들어와서 고생했어"

msgid "adv_201801_0017_msg"
msgstr "아, 알알이다~! 야호~!"

msgid "adv_201801_0018_msg"
msgstr "그래"

msgid "adv_201801_0019_msg"
msgstr "어머, 몸가짐 정도 가르쳐주는 게 뭐 어때?\\r\\n딱히 손해 보는 것도 아니잖아"

msgid "adv_201801_0020_msg"
msgstr "너 말이야…"

msgid "adv_201801_0021_msg"
msgstr "게다가 이번에는 몸가짐뿐만 아니라\\r\\n한 가지 더 도와줬잖아"

msgid "adv_201801_0022_msg"
msgstr "어?"

msgid "adv_201801_0023_msg"
msgstr "어이, 셰릴!"

msgid "adv_201801_0024_msg"
msgstr "딱히 숨길 일도 아니잖아"

msgid "adv_201801_0025_msg"
msgstr "정말 너는…"

msgid "adv_201801_0026_msg"
msgstr "후훗!\\r\\n여전히 셰리셰리랑 알알은 사이가 좋네!"

msgid "adv_201801_0027_msg"
msgstr "사이가 좋다기보다 내가 휘둘리고 있을 뿐이야"

msgid "adv_201801_0028_msg"
msgstr "그나저나 왜 갑자기 엔카야?\\r\\n너 그런 거 관심 없었잖아?"

msgid "adv_201801_0029_msg"
msgstr "관심이 생겼거든. 누구 덕분에 말이야"

msgid "adv_201801_0030_msg"
msgstr "헤에"

msgid "adv_201801_0031_msg"
msgstr "…혹시 알알. 눈치 못 챘어?"

msgid "adv_201801_0032_msg"
msgstr "뭘?"

msgid "adv_201801_0033_msg"
msgstr "셰리셰리가 일본풍 문화에\\r\\n관심을 갖게 된 계기가 누구냐는 거!"

msgid "adv_201801_0034_msg"
msgstr "누군데?"

msgid "adv_201801_0035_msg"
msgstr "정말 눈치 못 챘구나…"

msgid "adv_201801_0036_msg"
msgstr "알토가 둔한 건 늘 있는 일이잖아"

msgid "adv_201801_0037_msg"
msgstr "음, 이건 놀랍네"

msgid "adv_201801_0038_msg"
msgstr "그럼 슬슬 촬영을 시작할까"

msgid "adv_201801_0039_msg"
msgstr "힘내, 셰리셰리!"

msgid "adv_201802_0008_msg"
msgstr "…춤이라"

msgid "adv_201802_0010_msg"
msgstr "어이, 알토"

msgid "adv_201802_0011_msg"
msgstr "하야테"

msgid "adv_201802_0012_msg"
msgstr "…뭔가 심각한 표정이던데 괜찮아?"

msgid "adv_201802_0013_msg"
msgstr "응. 이번에 셰릴의 안무를 도와주다 보니\\r\\n여러 가지 생각이 났을 뿐이야"

msgid "adv_201802_0014_msg"
msgstr "…예전에 나도 비슷하게\\r\\n연습을 받던 때가 있었지, 싶어서"

msgid "adv_201802_0015_msg"
msgstr "헤에…"

msgid "adv_201802_0016_msg"
msgstr "…뭐, 자세한 사정은 모르겠지만,\\r\\n어렵게 생각해봤자 어쩔 수 없는 일도 있으니까.\\r\\n너무 신경 쓰지 마"

msgid "adv_201802_0017_msg"
msgstr "…하야테는 고민 같은 게 없어 보이네"

msgid "adv_201802_0018_msg"
msgstr "나 무시하는 거야?"

msgid "adv_201802_0019_msg"
msgstr "그런 뜻 아니야"

msgid "adv_201802_0020_msg"
msgstr "뭐랄까, 프레이아가 자주 그러거든.\\r\\n날면 날 수 있어…라고"

msgid "adv_201802_0021_msg"
msgstr "그 영향일지도 모르겠네"

msgid "adv_201802_0022_msg"
msgstr "날면 날 수 있다, 라…"

msgid "adv_201802_0023_msg"
msgstr "그러고 보니 하야테.\\r\\n무슨 볼일이 있었던 거 아니야?"

msgid "adv_201802_0024_msg"
msgstr "아~… 뭐, 별일은 아니니까\\r\\n다음에 할게"

msgid "adv_201802_0025_msg"
msgstr "그래?"

msgid "adv_201802_0027_msg"
msgstr "알토! 이런 데 있었네"

msgid "adv_201802_0028_msg"
msgstr "셰릴"

msgid "adv_201802_0029_msg"
msgstr "…딱히 대단한 용건은 아닌데,\\r\\n제대로 감사 인사를 못 했잖아?\\r\\n그래도 한마디는 해둬야겠다 싶어서"

msgid "adv_201802_0030_msg"
msgstr "이번에는 도움 많이 받았어"

msgid "adv_201802_0031_msg"
msgstr "자극적이고 새로운 곡과 안무를 만들 수 있었던 건\\r\\n알토 덕분이야"

msgid "adv_201802_0032_msg"
msgstr "…웬일로 솔직하네"

msgid "adv_201802_0033_msg"
msgstr "어머, 불만이야? 그만큼 고맙다는 뜻이거든!\\r\\n그러니까 지금부터 잠깐 어울려줘?"

msgid "adv_201802_0034_msg"
msgstr "다음 라이브에서 선보일 때를 위해\\r\\n다른 패턴도 정해두고 싶어"

msgid "adv_201802_0035_msg"
msgstr "알겠지?"

msgid "adv_201802_0036_msg"
msgstr "…정말, 알았어"

msgid "adv_301701_0007_msg"
msgstr "…후훗!"

msgid "adv_301701_0008_msg"
msgstr "저기… 밀레느?\\r\\n엄청 기뻐 보이네…"

msgid "adv_301701_0009_msg"
msgstr "당연하죠! 무려\\r\\n그 『린 민메이 이야기』에 출연하게 됐으니까요"

msgid "adv_301701_0010_msg"
msgstr "주인공이에요, 주인공!\\r\\n갑자기 주인공이라니 꿈만 같아요!"

msgid "adv_301701_0011_msg"
msgstr "게다가 제가 민메이 씨 역할이라니…"

msgid "adv_301701_0012_msg"
msgstr "음. 이런 말 하긴 그렇지만\\r\\n나는 좀 복잡한 기분이야…"

msgid "adv_301701_0013_msg"
msgstr "나와 민메이의 이야기가 드라마가 되고… 게다가,\\r\\n바사라와 밀레느가 그 역할을 연기하게 된다니"

msgid "adv_301701_0014_msg"
msgstr "그렇게 복잡해요?"

msgid "adv_301701_0015_msg"
msgstr "꽤나. 쑥스럽기도 하고,\\r\\n어떤 이야기로 만들어졌을지 궁금하기도 하고…"

msgid "adv_301701_0017_msg"
msgstr "갈아입었어. 이거면 돼?"

msgid "adv_301701_0018_msg"
msgstr "생각보다 잘 어울리잖아, 바사라!"

msgid "adv_301701_0019_msg"
msgstr "꽤 그럴듯하게 재현했네, 그 파일럿 슈트"

msgid "adv_301701_0020_msg"
msgstr "그래?"

msgid "adv_301701_0021_msg"
msgstr "잘 들어, 바사라?\\r\\n모처럼 이치죠 씨 본인이 직접 와주셨으니까,\\r\\n제대~로 조언을 들으라고?"

msgid "adv_301701_0022_msg"
msgstr "네네"

msgid "adv_301701_0023_msg"
msgstr "뭐야~! 그 남의 일 같은 태도는!"

msgid "adv_301701_0024_msg"
msgstr "아무래도 상관없잖아"

msgid "adv_301701_0025_msg"
msgstr "정말! 바사라도 참!"

msgid "adv_301701_0026_msg"
msgstr "…저기, 진정해. 밀레느"

msgid "adv_301701_0027_msg"
msgstr "죄, 죄송해요!\\r\\n…이번 드라마는 시티7의 모두에게 용기를 주기 위해,\\r\\n엄마가 기획한 거예요"

msgid "adv_301701_0028_msg"
msgstr "그런데 바사라는 드라마 출연이 결정된 뒤부터\\r\\n계속 이런 태도라니까요!"

msgid "adv_301701_0029_msg"
msgstr "…뭐, 바사라는 이런 일에\\r\\n적극적으로 나설 타입은 아니니까"

msgid "adv_301701_0030_msg"
msgstr "용기를 준다고 해도,\\r\\n이렇게 귀찮은 짓 안 하고 그냥 노래하면 되는 거잖아"

msgid "adv_301701_0031_msg"
msgstr "또 그런 말 하고…"

msgid "adv_301701_0032_msg"
msgstr "바사라.\\r\\n너, 자기 역할로는 노래를 못 부르니까\\r\\n삐진 거지?"

msgid "adv_301701_0033_msg"
msgstr ""

msgid "adv_301701_0034_msg"
msgstr "확실히 파일럿은 노래를 안 하니까…"

msgid "adv_301701_0035_msg"
msgstr "걱정하지 않아도 바사라 몫까지\\r\\n내가 실컷 노래해줄게"

msgid "adv_301701_0036_msg"
msgstr "그러니까 바사라는 자기 역할을\\r\\n끝까지 제대로 연기하는 거야. 알겠지?"

msgid "adv_301701_0037_msg"
msgstr "글쎄"

msgid "adv_301701_0038_msg"
msgstr "뭐야, 그 대답은~!"

msgid "adv_301701_0039_msg"
msgstr "…하하. 대체 어떤 드라마가 될까.\\r\\n기대되기도 하고, 조금 무섭기도 하고…?"

msgid "adv_301702_0008_msg"
msgstr "밀레느!\\r\\n완성된 드라마, 히카루랑 같이 봤어"

msgid "adv_301702_0009_msg"
msgstr "네!? 정말요?\\r\\n…저기, 어땠어요?"

msgid "adv_301702_0010_msg"
msgstr "후훗! 정말 재미있었어!\\r\\n특히 클라이맥스 장면이 멋졌어"

msgid "adv_301702_0011_msg"
msgstr "밀레느한테 배역 얘기는 들었지만…\\r\\n정말 푹 빠져서 봤는걸!"

msgid "adv_301702_0012_msg"
msgstr "재미있게 봐주셔서 다행이에요!"

msgid "adv_301702_0013_msg"
msgstr "정말 즐거웠어.\\r\\n멋진 드라마를 만들어줘서 고마워.\\r\\n영상은 소중히 간직할게"

msgid "adv_301702_0014_msg"
msgstr "그나저나 밀레느가 나를 연기한다니…\\r\\n역시 왠지 신기한 기분이 들어"

msgid "adv_301702_0015_msg"
msgstr "저도 연기하면서 조금 그런 생각이 들었어요"

msgid "adv_301702_0016_msg"
msgstr "…저, 이번 드라마에서,\\r\\n이렇게 평소에 이야기할 때의 민메이 씨를\\r\\n떠올리면서 연기했어요"

msgid "adv_301702_0017_msg"
msgstr "민메이 씨라면 이럴 때 무슨 생각을 하고\\r\\n어떻게 행동할까~ 하고…"

msgid "adv_301702_0018_msg"
msgstr "시티7의 모두가 떠올리는 민메이 씨와는\\r\\n다를지도 모르지만, 이게 제가 알고 있는\\r\\n민메이 씨라고 생각하면서요!"

msgid "adv_301702_0019_msg"
msgstr "…고마워, 밀레느"

msgid "adv_301702_0020_msg"
msgstr "…? 민메이 씨?"

msgid "adv_301702_0021_msg"
msgstr "후훗! 아무것도 아니야!\\r\\n나를 제대로 알아주는 사람이 있다는 게\\r\\n기쁘다고 생각했을 뿐이야"

msgid "adv_301702_0022_msg"
msgstr "…? 그렇네요"

msgid "adv_301702_0026_msg"
msgstr "둘이 무슨 얘기를 하는 걸까.\\r\\n정말 즐거워 보이네"

msgid "adv_301702_0027_msg"
msgstr "글쎄"

msgid "adv_301702_0028_msg"
msgstr "…드라마를 보고 생각한 건데"

msgid "adv_301702_0029_msg"
msgstr "뭔데?"

msgid "adv_301702_0030_msg"
msgstr "자유롭게 날면서 그렇게 뜨거운 노래를 부를 수 있는\\r\\n바사라는 역시 대단하네"

msgid "adv_301702_0031_msg"
msgstr "노래하는 건 간단해. 그냥 부르면 되니까"

msgid "adv_301702_0032_msg"
msgstr "음. 그렇게 간단한 건가?"

msgid "adv_301702_0033_msg"
msgstr "간단하다 어렵다의 문제가 아니야.\\r\\n그냥 노래하고 싶다는 마음만 있으면 돼"

msgid "adv_301702_0034_msg"
msgstr "히카루가 나는 걸 좋아하고, 날고 싶다고 생각하는 것과 똑같아"

msgid "adv_301702_0035_msg"
msgstr "그렇구나… 확실히 그럴지도 모르겠네"

msgid "adv_301702_0036_msg"
msgstr "다음에는 발키리를 타면서\\r\\n노래 한 곡 불러볼까?"

msgid "adv_301702_0037_msg"
msgstr "민메이랑 같이"

msgid "adv_301702_0038_msg"
msgstr "훗… 괜찮지 않겠어?"

msgid "adv_102101_0009_msg"
msgstr "…방금 그건"

msgid "adv_102101_0010_msg"
msgstr ""

msgid "adv_102101_0011_msg"
msgstr "글쎄"

msgid "adv_102101_0012_msg"
msgstr "지금 우리는 분명히 봤어.\\r\\n본 적 없는 기억을"

msgid "adv_102101_0013_msg"
msgstr "…아무도 모르는 시공의 기억을"

msgid "adv_102101_0014_msg"
msgstr "노래하는 도중에 전혀 기억에 없는 장면을 본 적은\\r\\n전에도 있었지만…"

msgid "adv_102101_0015_msg"
msgstr "이번에 본 기억에는 나나 왈큐레,\\r\\n란카 일행은 단 한 명도 나오지 않았어"

msgid "adv_102101_0016_msg"
msgstr "이런 일은 지금까지 없었지?"

msgid "adv_102101_0017_msg"
msgstr "응. 이번에는 꽤 달랐어"

msgid "adv_102101_0018_msg"
msgstr "…저게 샤론 애플.\\r\\n전자적으로 만들어진 가희"

msgid "adv_102101_0019_msg"
msgstr "샤론 애플…"

msgid "adv_102101_0020_msg"
msgstr "그리고 그 파일럿들"

msgid "adv_102101_0021_msg"
msgstr "이사무, 갈드… 누군가가 그렇게 계속 되뇌고 있었어.\\r\\n너무나 슬프고 애절한 목소리로"

msgid "adv_102101_0022_msg"
msgstr "…응"

msgid "adv_102101_0023_msg"
msgstr "그나저나 왜 우리는\\r\\n샤론 애플의 기억을 볼 수 있었던 걸까"

msgid "adv_102101_0024_msg"
msgstr "우리에게 보여줌으로써 뭔가를 전하고 싶었던 걸까?"

msgid "adv_102101_0025_msg"
msgstr "복잡하게 생각해봤자 어쩔 수 없잖아"

msgid "adv_102101_0026_msg"
msgstr "어떤 시공의 어떤 기억을 봤든\\r\\n우리가 할 일은 아무것도 달라지지 않아"

msgid "adv_102101_0027_msg"
msgstr "응, 그러네"

msgid "adv_102101_0028_msg"
msgstr "우리는 우리답게 노래할 뿐이야"

msgid "adv_102101_0029_msg"
msgstr "…모르는 시공에 대한 건 분명 노래가 알려줄 거야"

msgid "adv_102101_0030_msg"
msgstr "우리가 노래하면 다시 그 시공의 기억을\\r\\n볼 수 있을 거야"

msgid "adv_102101_0031_msg"
msgstr "그러면 그녀에 대해서도\\r\\n더 많이 알 수 있을지도 모르겠네"

