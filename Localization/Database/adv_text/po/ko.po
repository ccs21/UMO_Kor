msgid "adv_102001_0026_msg"
msgstr "확실히 쉬는 날이긴 한데…"

msgid "adv_102001_0027_msg"
msgstr "그때 뭐 하고 싶은지 지금부터 생각해둬.\\r\\n나도 같이 해줄 테니까"

msgid "adv_102001_0028_msg"
msgstr "하야테가?"

msgid "adv_102001_0029_msg"
msgstr "응. 뭐든 좋아"

msgid "adv_102001_0030_msg"
msgstr "…그럼 라그나 시내에 사과 사러 안 갈래?"

msgid "adv_102001_0031_msg"
