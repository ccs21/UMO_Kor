msgid "adv_302002_0026_msg"
msgstr "이번에는 내 상담 좀 들어줄래?\\n네 의견을 듣고 싶어"

msgid "adv_302002_0027_msg"
msgstr "물론이죠!"

msgid "adv_302002_0028_msg"
msgstr "맞다! 이왕이면 편하게 쉴 수 있는 곳에서\\n이야기하고 싶네요…"

msgid "adv_302002_0029_msg"
msgstr "셰릴 씨, 지금부터 냥냥에 가지 않을래요?"

msgid "adv_302002_0030_msg"
msgstr "좋아, 그러자!"

msgid "adv_102401_0009_msg"
msgstr "카나메 씨! 라이브 준비 끝났어요!"

msgid "adv_102401_0010_msg"
