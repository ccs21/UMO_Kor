msgid "adv_202102_0018_msg"
msgstr ""

msgid "adv_202102_0019_msg"
msgstr "란카?"

msgid "adv_202102_0020_msg"
msgstr "! 죄, 죄송해요!\\r\\n…다른 시공의 저도 다시 셰릴 씨 일행과\\r\\n만날 수 있으면 좋겠다고 생각해서요"

msgid "adv_202102_0021_msg"
msgstr "분명 괜찮을 거야"

msgid "adv_202102_0022_msg"
msgstr "그야 다른 시공의 셰릴 놈도\\r\\n란카를 만나고 싶다고 생각하고 있을 테니까"

msgid "adv_202102_0023_msg"
msgstr "…! 네!"

msgid "adv_202102_0024_msg"
msgstr "자, 그럼 슬슬 알토를 데리러\\r\\n가볼까?"

msgid "adv_202102_0025_msg"
msgstr "후훗! 그러죠!"

msgid "adv_302001_0009_msg"
