msgid "adv_100348102_0010_msg"
msgstr "그래? 그냥 평범한 거 아니야?"

msgid "adv_1400201_0009_msg"
msgstr ""

msgid "adv_1400201_0011_msg"
msgstr "마키나, 레이나! 잠깐 괜찮아?"

msgid "adv_1400201_0012_msg"
msgstr "마키나는 낮잠 중"

msgid "adv_1400201_0013_msg"
msgstr "어머, 정말이네.\\r\\n후훗… 레이나한테 기대서 잘 자고 있네"

msgid "adv_1400201_0014_msg"
msgstr "일어나면 셰릴이 왔다고 전해둘게"

msgid "adv_1400201_0015_msg"
msgstr "응, 고마워.\\r\\n어머, 레이나. 무슨 잡지 읽고 있어?"

msgid "adv_1400201_0016_msg"
msgstr "『DaisyDaisy 특별호』"

msgid "adv_1400201_0017_msg"
msgstr "헤에… 표지가 꽤 멋진데. 어때? 재밌어?"

msgid "adv_1400201_0018_msg"
msgstr "의외로 흥미로워"

msgid "adv_1400201_0019_msg"
msgstr "마키나가 즐겨 읽는 이유, 잘 알겠어"

msgid "adv_1400201_0020_msg"
msgstr "후훗. 확실히 마키나는 이런 거 좋아할 것 같네"

msgid "adv_1400201_0021_msg"
msgstr "나도 잠깐 봐도 될까?"

msgid "adv_1400201_0022_msg"
msgstr "봐도 OK"

msgid "adv_1400201_0023_msg"
msgstr "헤에… 그렇구나.\\r\\n레이나네 세계에서는 이런 패션이 유행하는구나"

msgid "adv_1400201_0024_msg"
msgstr "…눈이 진지해"

msgid "adv_1400201_0025_msg"
msgstr "후훗. 사실 이번에 잡지 기획 일을 맡게 됐거든"

msgid "adv_1400201_0026_msg"
msgstr "내가 데뷔했을 때 신세를 졌던 잡지가\\r\\n몇 년 만에 복간하게 돼서…"

msgid "adv_1400201_0027_msg"
msgstr "그래서 축하와 보답도 겸해서\\r\\n뭔가 특별한 걸 하고 싶다고 생각했는데…\\r\\n좀처럼 좋은 아이디어가 떠오르지 않더라고"

msgid "adv_1400201_0028_msg"
msgstr "그렇구나. 그래서 마키나한테"

msgid "adv_1400201_0029_msg"
msgstr "그런 거야"

msgid "adv_1400201_0030_msg"
msgstr "그나저나 재미있네…"

msgid "adv_1400201_0031_msg"
msgstr "…맞다!!"

msgid "adv_1400201_0032_msg"
msgstr "왜 그래!?"

msgid "adv_1400201_0033_msg"
msgstr "좋은 생각 났어"

msgid "adv_1400201_0034_msg"
msgstr "아무리 생각해도 최고의 아이디어야.\\r\\n다른 사람은 절대로 따라 할 수 없는, 그렇지?"

msgid "adv_1400201_0035_msg"
msgstr "열기가 식기 전에 아이디어를 정리해야겠어!\\r\\n레이나, 나중에 또 보자!"

msgid "adv_1400201_0037_msg"
msgstr "굉장해… VF-31급 기동력…"

msgid "adv_1400201_0039_msg"
msgstr "후아!? 지크프리짱!?"

msgid "adv_1400201_0040_msg"
msgstr "좋은 아침, 마키나"

msgid "adv_1400202_0009_msg"
msgstr "레이나! 촬영 수고했어"

msgid "adv_1400202_0010_msg"
msgstr "어땠어? 오늘 하루 여러 옷을 입고\\r\\n촬영해본 소감은"

msgid "adv_1400202_0011_msg"
msgstr ""

msgid "adv_1400202_0012_msg"
msgstr "레이나?"

msgid "adv_1400202_0013_msg"
msgstr "…가슴이 따끔따끔해서, 기분 좋았어"

msgid "adv_1400202_0014_msg"
msgstr "카페에서 멍하니 시간을 보내기도 하고,\\r\\n드라이브 데이트도 하고…"

msgid "adv_1400202_0015_msg"
msgstr "오늘 하루만으로도 여러 모습의 나를 만났어"

msgid "adv_1400202_0016_msg"
msgstr "내가 몰랐던 나를 만났어.\\r\\n아직도 가슴이 따끔따끔, 두근두근해"

msgid "adv_1400202_0017_msg"
msgstr "이게 셰릴 놈이 보고 있는 세계…"

msgid "adv_1400202_0018_msg"
msgstr "레이나…"

msgid "adv_1400202_0019_msg"
msgstr "초시공 SNS에서도 말했지만…\\r\\n셰릴은 정말 대단해"

msgid "adv_1400202_0020_msg"
msgstr "아무도 해보지 않은 것, 새로운 것에\\r\\n계속 도전하고…\\r\\n새로운 세계로 발을 내딛는 걸 두려워하지 않아"

msgid "adv_1400202_0021_msg"
msgstr "멋진 삶의 방식"

msgid "adv_1400202_0022_msg"
msgstr "…후훗. 당연하지!\\r\\n왜냐하면 나는 셰릴 놈이니까"

msgid "adv_1400202_0023_msg"
msgstr "사람의 일생은 별이 반짝이는 순간 같은 것…\\r\\n누구도 영원할 수는 없어"

msgid "adv_1400202_0024_msg"
msgstr "그렇다면 그 짧은 시간 동안\\r\\n조금이라도 더 많은 세계와 새로운 자신을 만나는 편이\\r\\n멋지다고 생각하지 않아?"

msgid "adv_1400202_0025_msg"
msgstr "영원할 수는 없어…"

msgid "adv_1400202_0026_msg"
msgstr "확실히 그렇게 생각해"

msgid "adv_1400202_0027_msg"
msgstr "오늘은 분명 기념일이 될 거야"

msgid "adv_1400202_0028_msg"
msgstr "레이나의 세계를 넓혀줄 수 있었다면\\r\\n이보다 기쁜 일은 없어"

msgid "adv_1400202_0029_msg"
msgstr "앞으로도\\r\\n새로운 세계로 발을 내딛는 걸 즐겨.\\r\\n그걸 돕는 일이라면 뭐든 해줄 테니까!"

msgid "adv_1400202_0030_msg"
msgstr "고마워, 셰릴"

msgid "adv_1400202_0031_msg"
msgstr "나야말로. 고마워, 레이나"

msgid "adv_1400202_0032_msg"
msgstr "…자, 그럼. 레이나, 이다음은 오프지?"

msgid "adv_1400202_0033_msg"
msgstr "이제부터는 완전히 개인 시간인 걸로 하고\\r\\n프론티어 안을 관광해보지 않을래?"

msgid "adv_1400202_0034_msg"
msgstr "전에 알토가 알려준 추천\\r\\n명소에 데려가줄게. 어때?"

msgid "adv_1400202_0035_msg"
msgstr "…갈래! 가고 싶어!"

msgid "adv_1400202_0036_msg"
msgstr "결정됐네.\\r\\n그럼 가자!"

msgid "adv_104101_0009_msg"
msgstr "브레라! 잘 지냈어?"

msgid "adv_104101_0010_msg"
msgstr "…문제없어"

msgid "adv_104101_0011_msg"
msgstr "정말… 여전히 무뚝뚝한 표정이네"

msgid "adv_104101_0012_msg"
msgstr "오늘은 란카의 신곡 공개 파티라고?\\n자자, 좀 더 분위기 띄워야지!"

msgid "adv_104101_0013_msg"
msgstr ""

msgid "adv_104101_0014_msg"
msgstr "잠깐, 듣고 있어? 브레라"

msgid "adv_104101_0015_msg"
msgstr "란카의 생체 신호가 이상해"

msgid "adv_104101_0016_msg"
msgstr "어?"

msgid "adv_104101_0017_msg"
msgstr "으음…? 듣고 보니 확실히\\n평소의 란카답지 않은 것 같기도 하고?"

msgid "adv_104101_0018_msg"
msgstr "하지만 그건 신곡 분위기에 맞춘 거 아닐까?\\n아름답지만 어딘가 애절한 곡이기도 하고…"

msgid "adv_104101_0019_msg"
msgstr ""

msgid "adv_104101_0021_msg"
msgstr "…어!? 브레라, 잠깐…!?"

msgid "adv_104101_0024_msg"
msgstr "…하아"

msgid "adv_104101_0026_msg"
msgstr "란카"

msgid "adv_104101_0027_msg"
msgstr "앗… 브레라 씨!\\n오늘 와주셔서 감사합니다"

msgid "adv_104101_0028_msg"
msgstr "무슨 문제라도 있나?"

msgid "adv_104101_0029_msg"
msgstr "네…?"

msgid "adv_104101_0030_msg"
msgstr "생체 신호가 이상하다"

msgid "adv_104101_0031_msg"
msgstr "저기… 저…"

msgid "adv_104101_0032_msg"
msgstr "…죄송해요!"

msgid "adv_104101_0034_msg"
msgstr "란카…?"

msgid "adv_104101_0036_msg"
msgstr "잠깐, 브레라!"

msgid "adv_104101_0037_msg"
msgstr "…뭐지"

msgid "adv_104101_0038_msg"
msgstr "있잖아…"

msgid "adv_104101_0039_msg"
msgstr "브레라는 너무 직설적으로 말한다니까!\\n좀 다른 말투도 있잖아?"

msgid "adv_104101_0040_msg"
msgstr "……어떻게 말했어야 하지"

msgid "adv_104101_0041_msg"
msgstr "어쩔 수 없네…\\n이 내가 어떻게든 해줄게!"

msgid "adv_104101_0042_msg"
msgstr "나도 란카가 웃고 있었으면 좋으니까!"

msgid "adv_104102_0010_msg"
msgstr "란카, 수고했어!\\n오늘 라이브 대성공이네!"

msgid "adv_104102_0011_msg"
msgstr "네! 밀레느가 같이 무대에\\n서준 덕분이에요.\\n정말 고마웠어요…!"

msgid "adv_104102_0012_msg"
msgstr "…다행이다. 정말 기운을 되찾은 것 같네"

msgid "adv_104102_0013_msg"
msgstr "아… 네"

msgid "adv_104102_0014_msg"
msgstr "아까도 노래하는 도중에 그 기억을\\n잠깐 보긴 했는데…"

