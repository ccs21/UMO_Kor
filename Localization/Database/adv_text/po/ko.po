msgstr "미쿠모 씨~!"

msgid "adv_102701_0051_msg"
msgstr "쿠모쿠모 이리 와~! 바다, 기분 좋아~!"

msgid "adv_102701_0053_msg"
msgstr "응"

msgid "adv_102701_0055_msg"
msgstr "어, 응"

msgid "adv_102701_0056_msg"
