msgstr "카나메…"

msgid "adv_101402_0029_msg"
msgstr "…그건 내가 할 말이야.\\n너희를 만날 수 있었기에, 나는…"

msgid "adv_101402_0031_msg"
msgstr "미쿠모 씨~!"

msgid "adv_101402_0032_msg"
