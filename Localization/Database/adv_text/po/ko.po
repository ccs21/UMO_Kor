msgstr "좋은 음악이라는 건 나이도 성별도 상관없이\\r\\n누구나 신나게 즐길 수 있는 거라고…"

msgid "adv_302801_0039_msg"
msgstr "애들 상대라도 괜찮잖아.\\r\\n우리 사운드를 들려주자고. 응?"

msgid "adv_302801_0040_msg"
msgstr ""

msgid "adv_302801_0041_msg"
msgstr "맞아, 맞아! 일이 있는 것만으로도 감사한 거니까,\\r\\n기운 내서 해보자!"

msgid "adv_302801_0042_msg"
msgstr "후훗. 이번에는 어떤 라이브로 해야\\r\\n아이들도 좋아해줄까…"

msgid "adv_302801_0043_msg"
msgstr "당장 다 같이 생각해봐야겠네!"

msgid "adv_302801_0044_msg"
msgstr "정말… 어쩔 수 없네"

msgid "adv_302801_0045_msg"
msgstr "이렇게 된 이상 제대로 날뛰어주겠어!"

msgid "adv_302802_0009_msg"
msgstr "밀레느 씨!\\r\\n크리스마스 라이브, 수고하셨습니다"

msgid "adv_302802_0010_msg"
msgstr "감린 씨! 고마워요!"

msgid "adv_302802_0011_msg"
msgstr "혹시 무슨 일이 생길 때를 대비해서\\r\\n감린 씨와 다이아몬드 포스 분들이\\r\\n대기해주셨으니까…"

msgid "adv_302802_0012_msg"
msgstr "안심하고 마음껏 날 수 있었어요!"

msgid "adv_302802_0013_msg"
msgstr "그거 다행이군요.\\r\\n지상에서 발키리에 타고 지켜보고 있었는데,\\r\\n아이들에게도 반응이 좋았던 것 같습니다"

msgid "adv_302802_0014_msg"
msgstr "그렇구나. 그럼 다행이다…!"

msgid "adv_302802_0015_msg"
msgstr "뭐, 확실히 중간에\\r\\n아찔한 장면도 있긴 했습니다만…"

msgid "adv_302802_0017_msg"
msgstr "…뭐야"

msgid "adv_302802_0018_msg"
msgstr "아무 일도 없었으니까 됐잖아?"

msgid "adv_302802_0019_msg"
msgstr "아니, 안 돼"

msgid "adv_302802_0020_msg"
msgstr "그렇게 저공비행을 하다가,\\r\\n지상의 건물에 부딪히기라도 하면\\r\\n어쩌려고 했던 거야?"

msgid "adv_302802_0021_msg"
msgstr "난 그렇게 서툴게 조종하지 않는다니까"

msgid "adv_302802_0022_msg"
msgstr "나는 만일의 경우를 말하는…!"

msgid "adv_302802_0023_msg"
msgstr "자자!\\r\\n그보다 감린 씨"

msgid "adv_302802_0024_msg"
msgstr "…자! 이거 받아주세요!"

msgid "adv_302802_0025_msg"
msgstr "? 이건…"

msgid "adv_302802_0026_msg"
msgstr "크리스마스 선물이에요.\\n저랑 바사라가 드리는!"

msgid "adv_302802_0027_msg"
msgstr "밀레느 씨와… 바사라가!?"

msgid "adv_302802_0028_msg"
msgstr "신곡이야"

msgid "adv_302802_0029_msg"
msgstr "너, 다음에는 그거 듣고\\r\\n우리 노래를 외워서 와"

msgid "adv_302802_0030_msg"
msgstr "그 조종 실력,\\r\\n전쟁에만 쓰면 아깝잖아"

msgid "adv_302802_0031_msg"
msgstr "…설마 이걸 노래하면서 날라는 건가?"

msgid "adv_302802_0032_msg"
msgstr "흥. 잘 아네"

msgid "adv_302802_0033_msg"
msgstr "저, 저는 그런 식으로 비행하는 건…!"

msgid "adv_302802_0034_msg"
msgstr "후훗… 감린 씨.\\r\\n저, 엄마한테 들었어요"

msgid "adv_302802_0035_msg"
msgstr "지상에서 대기하던 감린 씨가\\r\\n우리 노래를 흥얼거리는 걸 봤다고요"

msgid "adv_302802_0036_msg"
msgstr ""

msgid "adv_302802_0037_msg"
msgstr "다음에는 같이 날면서, 같이 노래해요!"

msgid "adv_302802_0038_msg"
msgstr "네?"

msgid "adv_302802_0039_msg"
msgstr ""

msgid "adv_302802_0040_msg"
msgstr "미… 밀레느 씨가 그렇게 말씀하신다면…"

msgid "adv_302802_0041_msg"
msgstr "해냈다!"

msgid "adv_302802_0042_msg"
msgstr "후훗.\\r\\n감린 씨 노래, 기대하고 있을게요!"

msgid "adv_100284502_0004_msg"
msgstr "있잖아, 카나메. 좋아하는 사람 있어?"

msgid "adv_100284502_0005_msg"
msgstr "물론 있죠!"

msgid "adv_100284502_0006_msg"
msgstr "미쿠모에 프레이아, 마키나에 레이나…"

msgid "adv_100284502_0007_msg"
msgstr "그리고 델타 소대 멤버들이랑,\\n카오스의 모두, 함장님도요"

msgid "adv_100284502_0008_msg"
msgstr "물론 시공을 넘어 만난 여러분도,\\n정말 좋아해요!"

msgid "adv_100284502_0009_msg"
msgstr "어… 그런 의미로 물어본 건 아니었는데…"

msgid "adv_100284502_0010_msg"
msgstr "네?"

msgid "adv_100284502_0011_msg"
msgstr "…뭐, 카나메다워서 좋다고 생각해"

msgid "adv_103201_0009_msg"
msgstr "셰릴 씨 무대는 언제 봐도\\n진짜 멋있어요~!"

msgid "adv_103201_0010_msg"
msgstr "맞아, 맞아.\\n역시 셰리셰리는 정말 대단하지!"

msgid "adv_103201_0011_msg"
msgstr "혼자 무대에 서 있어도\\n아우라가 있어서 눈길을 끈다고 해야 하나,\\n존재감이 굉장하다고 해야 하나…!"

msgid "adv_103201_0012_msg"
msgstr "알 것 같아요!\\n…으음. 어떻게 하면 그렇게\\n당당할 수 있는 걸까요?"

msgid "adv_103201_0013_msg"
msgstr "후훗. 프레프레는 라이브에서 솔로곡 부를 때\\n아직도 많이 긴장하잖아~"

msgid "adv_103201_0014_msg"
msgstr "우우. 그렇다니까요~…"

msgid "adv_103201_0016_msg"
msgstr ""

msgid "adv_103201_0017_msg"
msgstr "카나카나, 왜 그래?"

msgid "adv_103201_0018_msg"
msgstr "어?\\n…아, 아니. 아무것도 아니야. 신경 쓰지 마"

msgid "adv_103201_0019_msg"
msgstr ""

msgid "adv_103201_0022_msg"
msgstr "셰릴 씨, 오늘 라이브에 초대해주셔서\\n감사했습니다!"

msgid "adv_103201_0023_msg"
msgstr "후훗, 이 정도는 별것도 아니야.\\n즐거웠던 것 같아서 다행이네"

msgid "adv_103201_0024_msg"
msgstr "그런데… 잠깐 괜찮으세요?"

msgid "adv_103201_0025_msg"
msgstr "뭔데…?"

msgid "adv_103201_0026_msg"
msgstr "제가 잘못 본 거라면 죄송해요"

msgid "adv_103201_0027_msg"
msgstr "아까 무대 도중에…"

msgid "adv_103201_0028_msg"
msgstr ""

msgid "adv_103201_0029_msg"
msgstr "아까 노래하실 때, 아주 잠깐\\n뭔가를 깨달은 듯한 표정을 지으셔서,\\n조금 신경 쓰였어요"

msgid "adv_103201_0030_msg"
msgstr "…역시 왈큐레를 이끄는 리더답네"

msgid "adv_103201_0031_msg"
msgstr "걱정해줘서 고마워. 하지만 괜찮아.\\n조금 낯선 기억을 봤을 뿐이니까"

msgid "adv_103201_0032_msg"
msgstr "그건…"

msgid "adv_103201_0033_msg"
msgstr "자, 이제 가봐야 해. 모두가 나를…\\n셰릴 놈을 기다리고 있으니까"

msgid "adv_103201_0034_msg"
msgstr "셰릴 씨…"

msgid "adv_103201_0035_msg"
msgstr "…알겠어요.\\n하지만 무리는 하지 마세요.\\n이야기라면 언제든 또 들어드릴 테니까요"

msgid "adv_103201_0036_msg"
msgstr "카나메…"

msgid "adv_103201_0037_msg"
msgstr "…응, 고마워. 다녀올게!"

msgid "adv_103201_0038_msg"
msgstr "네, 힘내세요!"

msgid "adv_103202_0009_msg"
msgstr "카나메!\\n오늘 고마웠어"

msgid "adv_103202_0010_msg"
msgstr "왈큐레의 리더라는 자리가\\n괜히 있는 게 아니라는 걸 새삼 실감했어"

msgid "adv_103202_0011_msg"
msgstr "아니에요! 그렇지 않아요"

msgid "adv_103202_0013_msg"
msgstr "셰릴, 카나메"

msgid "adv_103202_0015_msg"
msgstr "셰릴 씨, 카나메 씨!\\n라이브 수고하셨어요!"

msgid "adv_103202_0016_msg"
msgstr "알토, 란카!?"

msgid "adv_103202_0017_msg"
msgstr "후훗.\\n…그럼 저는 슬슬 돌아갈게요"

msgid "adv_103202_0018_msg"
msgstr "알토 군, 란카 씨. 뒤는 잘 부탁드릴게요!"

msgid "adv_103202_0019_msg"
msgstr "네! 맡겨주세요!"

msgid "adv_103202_0021_msg"
msgstr "…? 잘 부탁한다니…?"

msgid "adv_103202_0022_msg"
msgstr "…카나메한테 상담받았어.\\n너, 또 모르는 기억을 본 거지?"

msgid "adv_103202_0023_msg"
msgstr "정말, 카나메도 참…"

msgid "adv_103202_0024_msg"
msgstr "정말이지. 너무 오지랖이라니까…\\n걱정 안 해도 이제 아무렇지도 않아"

msgid "adv_103202_0025_msg"
msgstr "그래. 그럼 됐어"

msgid "adv_103202_0026_msg"
msgstr "셰릴 씨. 언제든 저랑 알토 군이\\n곁에 있을 테니까요!"

msgid "adv_103202_0027_msg"
msgstr "맞아.\\n넌 혼자가 아니니까"

msgid "adv_103202_0028_msg"
msgstr "…알토, 란카…"

msgid "adv_103202_0029_msg"
msgstr ""

msgid "adv_103202_0030_msg"
msgstr "…그 기억 속에서도,\\n둘이 내 곁에 있어줬어"

msgid "adv_103202_0031_msg"
msgstr "고마워. 알토, 란카.\\n나는 혼자가 아니라는 걸… 알게 됐으니까"

msgid "adv_103202_0032_msg"
msgstr "셰릴 씨…"

msgid "adv_103202_0033_msg"
msgstr "혼자가 아니라…인가"

msgid "adv_103202_0034_msg"
msgstr "당연하잖아.\\n네가 노래할 때는 옆에 란카가 있어"

msgid "adv_103202_0035_msg"
msgstr "나는 네 노래를 들으며 하늘을 날아.\\n누구도 혼자가 아니야.\\n우리 셋은 말이지"

msgid "adv_103202_0036_msg"
msgstr "…후훗. 정말이지.\\n알토 주제에 멋있는 말이나 하고…!"

msgid "adv_103202_0037_msg"
msgstr "…그래도 고마워"

msgid "adv_103202_0038_msg"
msgstr "나도 널 위해 노래할게.\\n앞으로도 계속… 란카와 함께"

msgid "adv_103202_0039_msg"
msgstr "그렇지, 란카!"

msgid "adv_103202_0040_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_302901_0010_msg"
msgstr "민메이!\\r\\n하아, 드디어 말을 걸 수 있네…"

msgid "adv_302901_0011_msg"
msgstr "히카루! 와줬구나"

msgid "adv_302901_0012_msg"
msgstr "응. 그런데 민메이 주위를\\r\\n팬들이 둘러싸고 있어서 전혀 가까이 갈 수가 없었어"

msgid "adv_302901_0013_msg"
msgstr "그랬어? 미안해!\\n내가 먼저 찾아서 말을 걸었어야 했는데…"

msgid "adv_302901_0014_msg"
msgstr "괜찮아. 어쩔 수 없지.\\r\\n민메이도 예전과 달리 완전히 유명인이 됐으니까"

msgid "adv_302901_0015_msg"
msgstr "그렇지 않아!\\r\\n난 아직 멀었어"

msgid "adv_302901_0016_msg"
msgstr "아니. 민메이는 이제 어엿한 아이돌이야"

msgid "adv_302901_0017_msg"
msgstr "아~ 이러다간 내가 닿을 수 없는 곳까지\\r\\n가버릴 것 같네"

msgid "adv_302901_0018_msg"
msgstr "정말, 히카루도 참. 농담만 하고!"

msgid "adv_302901_0019_msg"
msgstr "아하하…"

msgid "adv_302901_0020_msg"
msgstr "…라이브, 기대하고 있을게.\\r\\n그 말만 하려고 했어. 그럼!"

msgid "adv_302901_0022_msg"
msgstr "앗, 히카루…! …정말!"

msgid "adv_302901_0023_msg"
msgstr ""

msgid "adv_302901_0025_msg"
msgstr "민민, 새해 복 많이 받아~!"

msgid "adv_302901_0026_msg"
msgstr "앗… 마키나, 레이나.\\r\\n새해 복 많이 받아!"

msgid "adv_302901_0027_msg"
msgstr "이제 뉴이어 라이브지?\\n힘내!"

msgid "adv_302901_0028_msg"
msgstr "고마워. 열심히 노래하고 올게"

msgid "adv_302901_0029_msg"
msgstr ""

msgid "adv_302901_0030_msg"
msgstr "…? 레이나, 무슨 일이야?\\r\\n무서운 표정 짓고…"

msgid "adv_302901_0031_msg"
msgstr "후후후~.\\n레이레이가 민민한테 부탁이 있대!"

msgid "adv_302901_0032_msg"
msgstr "…민메이"

msgid "adv_302901_0033_msg"
msgstr "사인, 해줘"

msgid "adv_302901_0034_msg"
msgstr "어…? 사인?"

msgid "adv_302901_0035_msg"
msgstr "새해 첫날에 레이레이랑 같이\\r\\n『린 민메이 이야기』를 또 봤어!"

msgid "adv_302901_0036_msg"
msgstr "그랬더니 민민을 향한 마음이\\r\\n더 뜨거워졌거든!"

msgid "adv_302901_0037_msg"
msgstr "…손에 땀을 쥐게 하는 전개, 몇 번을 봐도 가슴이 뜨거워져"

msgid "adv_302901_0038_msg"
msgstr "사인, 해줘"

msgid "adv_302901_0039_msg"
msgstr "그런 거였구나!\\r\\n알겠어. 내 사인이라도 괜찮다면"

msgid "adv_302901_0040_msg"
msgstr "…레이나에게, 라고. 이러면 될까?"

msgid "adv_302901_0041_msg"
msgstr "오오오……"

msgid "adv_302901_0042_msg"
msgstr "전자 사인이지만 이름까지 들어갔으니\\r\\n초레어 아이템…!"

msgid "adv_302901_0043_msg"
msgstr "좋아해줘서 다행이야!\\n그럼 나, 슬슬 본番이라…\\n다녀올게!"

msgid "adv_302901_0044_msg"
msgstr "다녀와"

msgid "adv_302901_0045_msg"
msgstr "즐기고 와, 민민!"

msgid "adv_302901_0047_msg"
msgstr ""

msgid "adv_302901_0048_msg"
msgstr "…민민, 왠지 조금 기운 없어 보이지 않았어?\\r\\n기분 탓인가?"

msgid "adv_302901_0049_msg"
msgstr "…확실히"

msgid "adv_302902_0009_msg"
msgstr "민메이. 촬영 협조해줘서 고마워"

msgid "adv_302902_0010_msg"
msgstr "레이나! 나야말로 고마워!"

msgid "adv_302902_0011_msg"
msgstr "그 뒤로 일정을 조정해서\\n히카루랑 미사 씨 일행과 함께\\n완성된 『린 민메이 이야기』를 봤어!"

msgid "adv_302902_0012_msg"
msgstr "히카루도 즐거워 보였고… 나, 안심했어"

msgid "adv_302902_0013_msg"
msgstr "다행이야. 둘이 사이좋게 지내면 기뻐"

msgid "adv_302902_0014_msg"
msgstr "후훗. 고마워, 레이나"

msgid "adv_302902_0015_msg"
msgstr "…그래서 말인데.\\r\\n히카루한테는 조금 더 뭔가 보답을 하고 싶어"

msgid "adv_302902_0016_msg"
msgstr "조금 나중 일이 될지도 모르지만\\r\\n히카루만을 위해 노래를 부르려고 해"

msgid "adv_302902_0017_msg"
msgstr "히카루가 내 목소리를 좋은 목소리라고…\\n내 노래를 좋아한다고 말해줬으니까"

msgid "adv_302902_0018_msg"
msgstr "좋다고 생각해.\\r\\n누군가를 위해 부르는 노래는 따끔따끔해"

msgid "adv_302902_0019_msg"
msgstr "분명 히카루도 좋아할 거야"

msgid "adv_302902_0020_msg"
msgstr "후훗. 그렇게 말해주니 든든하네"

msgid "adv_302902_0021_msg"
msgstr "…있잖아, 레이나.\\r\\n어떤 노래를 부르면 히카루가 좋아할까?"

msgid "adv_302902_0022_msg"
msgstr "민메이의 노래라면 뭐든지.\\r\\n…라고 말하고 싶지만"

msgid "adv_302902_0023_msg"
msgstr "사랑 노래가 좋을 것 같아"

msgid "adv_302902_0024_msg"
msgstr "사랑 노래…?"

msgid "adv_302902_0025_msg"
msgstr "응. 노래는 사랑이니까"

msgid "adv_302902_0026_msg"
msgstr "히카루도 민메이의 사랑 노래, 분명 정말 좋아할 거야"

msgid "adv_302902_0027_msg"
msgstr "나도 정말 좋아해"

msgid "adv_302902_0028_msg"
msgstr "레이나…"

msgid "adv_302902_0029_msg"
msgstr "…하나, 민메이한테 묻고 싶어"

msgid "adv_302902_0030_msg"
msgstr "민메이는 사랑 노래를 부를 때,\\r\\n무슨 생각을 해?"

msgid "adv_302902_0031_msg"
msgstr "……글쎄"

msgid "adv_302902_0032_msg"
msgstr "좋아하는 사람 생각으로 머릿속을 가득 채워"

msgid "adv_302902_0033_msg"
msgstr "그 사람과의 만남, 그 사람과의 즐거운 추억.\\r\\n그 사람의 목소리, 눈동자, 미소…"

msgid "adv_302902_0034_msg"
msgstr "그러면 자연스럽게 마음이 따뜻해지고\\r\\n그 마음이 그대로 노랫소리가 되어가거든"

msgid "adv_302902_0035_msg"
msgstr "…잘 알겠어"

msgid "adv_302902_0036_msg"
msgstr "다음에 민메이의 사랑 노래를 부를 때 참고할게"

msgid "adv_302902_0037_msg"
msgstr "고마워, 민메이"

msgid "adv_302902_0038_msg"
msgstr "아니… 나야말로 고마워, 레이나!"

msgid "adv_103301_0009_msg"
msgstr "영차… 음, 이 정도면 되려나?"

msgid "adv_103301_0010_msg"
msgstr "어머, 프레이아. 장 보고 왔어?"

msgid "adv_103301_0011_msg"
msgstr "카, 카나메 씨!!"

msgid "adv_103301_0012_msg"
msgstr "…왜 그래? 그렇게 당황하고"

msgid "adv_103301_0013_msg"
msgstr "혹시 내가 보면 곤란한 거였어?"

msgid "adv_103301_0014_msg"
msgstr "사실은, 그게…"

msgid "adv_103301_0015_msg"
msgstr "…저, 모두에게 줄 초콜릿을\\r\\n몰래 직접 만들려고 했어요"

msgid "adv_103301_0016_msg"
msgstr "초콜릿? 아, 그렇구나.\\r\\n이제 곧 밸런타인데이니까"

msgid "adv_103301_0017_msg"
msgstr "네엣!\\r\\n밸런타인데이 라이브가 끝난 뒤,\\r\\n왈큐레랑 델타 소대 모두에게 주고 싶어요"

msgid "adv_103301_0018_msg"
msgstr "지난 밸런타인데이 때는\\r\\n카나메 씨가 모두를 위해 몰래 만들었으니까\\r\\n올해는 제가 해보려고요!"

msgid "adv_103301_0019_msg"
msgstr "그런데 바로 들켜버렸네요…"

msgid "adv_103301_0020_msg"
msgstr "후훗. 왠지 미안하네"

msgid "adv_103301_0021_msg"
msgstr "사과라고 하긴 뭐하지만…\\r\\n괜찮다면 그 초콜릿 만들기, 나도 도와줄게"

msgid "adv_103301_0022_msg"
msgstr "네!? 저, 정말 괜찮으세요?"

msgid "adv_103301_0023_msg"
msgstr "응.\\r\\n사실 나도 초콜릿을 만들 생각이었거든"

msgid "adv_103301_0024_msg"
msgstr "프레이아, 과자 만들어본 적 별로 없지?\\r\\n이것저것 조언해줄 수 있을 것 같은데… 어때?"

msgid "adv_103301_0025_msg"
msgstr "카나메 씨!!!"

msgid "adv_103301_0026_msg"
msgstr "맞아요! 저, 정말 아무것도 몰라서,\\r\\n사실 혼자 몰래 만드는 거 엄청 불안했어요!"

msgid "adv_103301_0027_msg"
msgstr "그럼 다행이네"

msgid "adv_103301_0028_msg"
msgstr "내가 있으니까 걱정 마, 프레이아!\\r\\n모두를 위해 최고의 초콜릿을 준비하자"

msgid "adv_103301_0029_msg"
msgstr "가, 감사합니다~!!"

msgid "adv_103301_0030_msg"
msgstr "아니야. 천만에"

msgid "adv_103301_0031_msg"
msgstr "일단 이 재료들부터 주방으로 옮길까"

msgid "adv_103301_0032_msg"
msgstr "네엣!"

msgid "adv_103301_0035_msg"
msgstr "프레이아… 카나메 씨…?"

msgid "adv_103301_0036_msg"
msgstr "저렇게 많은 짐을 들고…\\n무슨 일일까요?"

msgid "adv_103303_0009_msg"
msgstr "미라쥬 씨.\\r\\n자! 이거, 진심 초콜릿이에요!"

msgid "adv_103303_0010_msg"
msgstr "가, 감사합니다"

msgid "adv_103303_0011_msg"
msgstr "…면전에서 진심이라고 들으니,\\r\\n왠지 묘한 기분이네요"

msgid "adv_103303_0012_msg"
msgstr "그, 그런가요…??"

msgid "adv_103303_0013_msg"
msgstr "후훗!\\r\\n프레이아도 참, 왈큐레 모두에게도 똑같이\\r\\n말하면서 건네주고 있었어"

msgid "adv_103303_0014_msg"
msgstr "척 소위에게는 말하지 않는 편이 좋겠네요.\\n나중에 귀찮아질 것 같으니까요"

msgid "adv_103303_0015_msg"
msgstr "네, 네엣!"

msgid "adv_103303_0016_msg"
msgstr "자, 그럼 이제 남은 건\\n척 군이랑 아라드 대장, 메서 군이랑…"

msgid "adv_103303_0017_msg"
msgstr "그리고… 후훗, 하야테 군뿐이네?\\r\\n좋아해주면 좋겠다, 프레이아"

msgid "adv_103303_0018_msg"
msgstr "하야테한테… 초콜릿…"

msgid "adv_103303_0019_msg"
msgstr "프레이아?"

msgid "adv_103303_0020_msg"
msgstr "아, 아, 아무것도 아니에요!\\r\\n그보다 카나메 씨, 가요!"

msgid "adv_103303_0021_msg"
msgstr "어, 응…"

msgid "adv_103303_0022_msg"
msgstr "아. 두 분, 잠깐만요"

msgid "adv_103303_0023_msg"
msgstr "왜 그래, 미라쥬?"

msgid "adv_103303_0024_msg"
msgstr "저기… 이거요"

msgid "adv_103303_0025_msg"
msgstr "어머, 초콜릿?"

msgid "adv_103303_0026_msg"
msgstr "미라쥬 씨가 주는 초콜릿…!\\r\\n받아도 돼요?"

msgid "adv_103303_0027_msg"
msgstr "네. 제가 직접 만든 거라,\\r\\n모양은 그다지 좋지 않지만…"

msgid "adv_103303_0028_msg"
msgstr "미라쥬 씨가 직접 만든 초콜릿이라니\\r\\n진짜 기뻐요!"

msgid "adv_103303_0029_msg"
msgstr "……열심히 준비하는 두 분을 보고 자극받아서, 저도 모르게"

msgid "adv_103303_0030_msg"
msgstr "그리고 저도 왈큐레 여러분의 노래에\\r\\n언제나 도움받고 있으니까요"

msgid "adv_103303_0031_msg"
msgstr "그 감사의 뜻입니다"

msgid "adv_103303_0032_msg"
msgstr "미라쥬 씨…!"

msgid "adv_103303_0033_msg"
msgstr "그, 그렇게 반짝이는 눈으로 보지 마세요…!\\r\\n자, 저도 다른 멤버들에게 나눠주러 갈 테니까,\\r\\n같이 가요!"

msgid "adv_103303_0034_msg"
msgstr "네엣! 감사합니다, 미라쥬 씨!"

msgid "adv_103303_0035_msg"
msgstr "고마워, 미라쥬.\\r\\n앞으로도 잘 부탁해!"

msgid "adv_103303_0036_msg"
msgstr "…네!"

msgid "adv_100290501_0004_msg"
msgstr "…프레이아. 룬, 빛나고 있어"

msgid "adv_100290501_0005_msg"
msgstr "호에!?"

msgid "adv_100290501_0006_msg"
msgstr "후후훗… 거짓말"

msgid "adv_100290501_0007_msg"
msgstr "레, 레이나 씨! 저 갖고 놀지 마세요~!"

msgid "adv_100290501_0008_msg"
msgstr "하지만 요즘 자주 빛나… 누구 때문?"

msgid "adv_100290501_0009_msg"
msgstr "안 빛났어요!\\r\\n그리고 누, 누구 때문도 아니에요!"

msgid "adv_100290501_0010_msg"
msgstr "수상해… 이건 마키나와 함께 파자마 파티에서\\r\\n심문해야겠어…!"

msgid "adv_100290501_0011_msg"
msgstr "호와앗! 제, 제발 봐주세요~!"

msgid "adv_100290502_0004_msg"
msgstr "룬이라는 거 좋네"

msgid "adv_100290502_0005_msg"
msgstr "호와앗!? 바, 바사라 씨!\\r\\n부끄러우니까 너무 보지 말아주세요…!"

msgid "adv_100290502_0006_msg"
msgstr "그거 감정이 고조되면 빛나는 거지?\\r\\n알아보기 쉬워서 좋잖아"

msgid "adv_100290502_0007_msg"
msgstr "나한테도 룬이 있으면, 이 불타는 마음을\\r\\n다른 녀석들한테 더 쉽게 전할 수 있을지도 모르겠네"

msgid "adv_100290502_0008_msg"
msgstr "괜찮아요! 바사라 씨 마음이라면 제대로\\r\\n노래를 통해 전해지고 있어요!"

msgid "adv_100290502_0009_msg"
msgstr "…그래. 그럼 됐어"

msgid "adv_100290502_0010_msg"
msgstr "뭐, 바사라 씨의 룬피카 버닝도 보고 싶은\\r\\n마음은 있지만…"

msgid "adv_100290502_0011_msg"
msgstr "룬피카… 뭐라고?"

msgid "adv_100290502_0012_msg"
msgstr "아, 아무것도 아니에요!!"

msgid "adv_001001_0004_msg"
msgstr "으으으으음, 어떡하지"

msgid "adv_001001_0005_msg"
msgstr "뭘 고민하고 있어? 밀레느"

msgid "adv_001001_0006_msg"
msgstr "레이! 마침 잘 왔어~!\\r\\n다음 라이브 때문에 고민하고 있어!"

msgid "adv_001001_0007_msg"
msgstr "아, 만우절 한정 라이브 말이지"

msgid "adv_001001_0008_msg"
msgstr "맞아! 만우절에 라이브를 하는 거라면\\r\\n관객들이 깜짝 놀랄 만한… 그런 라이브로 만들고 싶잖아!"

msgid "adv_001001_0009_msg"
msgstr "그런데 바사라는 『평소처럼 뜨겁게 하면 되잖아』\\r\\n라고 했단 말이야!"

msgid "adv_001001_0010_msg"
msgstr "뭐, 바사라라면 그렇게 말하겠지"

msgid "adv_001001_0011_msg"
msgstr "있잖아, 레이! 부탁이야, 같이 생각해줘!"

msgid "adv_001001_0012_msg"
msgstr "흐음… 그렇다면.\\r\\n초시공 네트워크를 써서 누군가에게 아이디어를 빌려보는 건 어때?"

msgid "adv_001001_0013_msg"
msgstr "그거 좋다! 한번 물어볼게!"

msgid "adv_001001_0017_msg"
msgstr "…그런 상황인데, 뭔가 좋은 아이디어 없을까?"

msgid "adv_001001_0018_msg"
msgstr "그렇군요, 만우절입니까…"

msgid "adv_001001_0019_msg"
msgstr "어렵네요"

msgid "adv_001001_0022_msg"
msgstr "…근데 왜 그런 걸 우리한테 묻는 거야"

msgid "adv_001001_0023_msg"
msgstr "왈큐레 모두는 레슨 중이고,\\r\\n셰릴이랑 란카도 외출 중이었거든…"

msgid "adv_001001_0024_msg"
msgstr "그러다 발키리 오퍼레이션을 끝낸\\r\\n너희 셋을 만난 거지!"

msgid "adv_001001_0025_msg"
msgstr "혼자 생각하려면 힘드니까요.\\n저도 협력하게 해주세요!"

msgid "adv_001001_0028_msg"
msgstr "저도 도움이 될 수 있도록 열심히 해보겠습니다!"

msgid "adv_001001_0029_msg"
msgstr "둘 다 고마워~!"

msgid "adv_001001_0030_msg"
msgstr "그렇긴 해도… 미라쥬도 감린도\\r\\n지나치게 진지한 녀석들이라, 아무리 봐도 인선 실패잖아"

msgid "adv_001001_0031_msg"
msgstr "포기하고 레이나가 돌아올 때까지 기다리는 건 어때?\\r\\n그 녀석은 이런 거 잘하잖아"

msgid "adv_001001_0032_msg"
msgstr "무슨 말씀을 하는 겁니까, 하야테!"

msgid "adv_001001_0033_msg"
msgstr "확실히… 이런 일은 레이나 씨가 더 적임자지만…\\r\\n이모님이 고민하고 계신데 그냥 둘 수는 없습니다!"

msgid "adv_001001_0036_msg"
msgstr "맞아, 밀레느 씨가 고민하고 있잖아!"

msgid "adv_001001_0037_msg"
msgstr "…아~ 알았다고"

msgid "adv_001001_0038_msg"
msgstr "그나저나 놀라게 한다… 놀라게 한다라……"

msgid "adv_001001_0039_msg"
msgstr "…………아"

msgid "adv_001001_0042_msg"
msgstr "미라쥬?"

msgid "adv_001001_0043_msg"
msgstr "좋은 생각이 났습니다!"

msgid "adv_001001_0044_msg"
msgstr "정말~!?"

msgid "adv_001001_0045_msg"
msgstr "네, 분명 깜짝 놀랄 겁니다!\\r\\n그리고 이걸 위해서는 하야테의 힘이 꼭 필요합니다!"

msgid "adv_001001_0046_msg"
msgstr "…………뭐?"

msgid "adv_303001_0009_msg"
msgstr "수고하셨습니다~!"

msgid "adv_303001_0010_msg"
msgstr "…하아.\\r\\n이 의상으로 촬영하니까 좀 두근거렸네"

msgid "adv_303001_0012_msg"
msgstr "란카"

msgid "adv_303001_0013_msg"
msgstr "와아!\\r\\n셰릴 씨, 브레라 씨, 어떻게 여기에…!?"

msgid "adv_303001_0014_msg"
msgstr "뭐, 이런저런 일이 있어서. 그보다…\\r\\n그 의상, 정말 귀엽잖아!"

msgid "adv_303001_0015_msg"
msgstr "가, 감사합니다…!"

msgid "adv_303001_0016_msg"
msgstr "스태프분이 『이걸 입고 촬영해주세요!』라고\\r\\n했을 때는 깜짝 놀랐지만…"

msgid "adv_303001_0017_msg"
msgstr "그래도 잘 어울린다고 해주시니까\\r\\n조금 안심됐어요"

msgid "adv_303001_0018_msg"
msgstr "너도 잘 어울린다고 생각하지? 브레라"

msgid "adv_303001_0019_msg"
msgstr ""

msgid "adv_303001_0020_msg"
msgstr "가변 전투기의 특징을 살리면서도, 착용할 수 있는\\n의상으로 잘 재구성되어 있다"

msgid "adv_303001_0021_msg"
msgstr "좀 더 알아듣기 쉽게 말해"

msgid "adv_303001_0022_msg"
msgstr "…그래서 어떤 영화지"

msgid "adv_303001_0023_msg"
msgstr "그러니까…… 간단히 말하면,\\r\\n발키리 파일럿끼리의 연애 영화예요!"

msgid "adv_303001_0024_msg"
msgstr "연애 영화… 언제 격추당할지 모르는 하늘의 전장에서 말인가.\\n한가한 소리군"

msgid "adv_303001_0025_msg"
msgstr "그런 극한 상황이기에 싹트는 사랑도 있는 거야?\\r\\n내용도 정말 재밌다고"

msgid "adv_303001_0026_msg"
msgstr "브레라는 이 영화를 보면서,\\n로맨스라는 걸 좀 더 배울 필요가 있겠네"

msgid "adv_303001_0027_msg"
msgstr "어라?\\r\\n셰릴 씨, 이 영화 스토리 알고 계세요?"

msgid "adv_303001_0028_msg"
msgstr "아직 촬영도 막 시작한 참이라,\\r\\n내용은 비밀이라고 들었던 것 같은데…?"

msgid "adv_303001_0029_msg"
msgstr "말해주고 싶긴 한데…\\r\\n아직은 큰 소리로 말할 수가 없네"

msgid "adv_303001_0030_msg"
msgstr "나중에 초시공 SNS로 알려줄게.\\r\\n약속할게"

msgid "adv_303001_0031_msg"
msgstr "잘 모르겠지만… 알겠어요!\\r\\n기대하고 있을게요, 셰릴 씨, 브레라 씨!"

msgid "adv_303001_0032_msg"
msgstr ""

msgid "adv_303002_0009_msg"
msgstr "셰릴, 란카. 촬영 수고했어"

msgid "adv_303002_0010_msg"
msgstr "알토 군!"

msgid "adv_303002_0011_msg"
msgstr "고마워, 알토.\\r\\n오늘은 감독한테 붙잡히지 않고 데리러 왔네?"

msgid "adv_303002_0012_msg"
msgstr "그 얘기는 이제 됐잖아…\\r\\n거절하는 거 진짜 힘들었다고"

msgid "adv_303002_0013_msg"
msgstr "후훗. 고생했네, 알토 군"

msgid "adv_303002_0014_msg"
msgstr "정말이지… 그나저나"

msgid "adv_303002_0015_msg"
msgstr "알토 군, 왜 그래?"

msgid "adv_303002_0016_msg"
msgstr "아니, 그게…"

msgid "adv_303002_0017_msg"
msgstr "자기가 타는 기체를 닮은 우리를 보고\\r\\n두근했어?"

msgid "adv_303002_0018_msg"
msgstr "! …그럴 리가 있냐!"

msgid "adv_303002_0019_msg"
msgstr "거짓말. 방금 조금 당황했지?"

msgid "adv_303002_0020_msg"
msgstr "정말이지, 솔직하지 못하다니까"

msgid "adv_303002_0022_msg"
msgstr "셰리셰리, 란란!!"

msgid "adv_303002_0023_msg"
msgstr "마키나 씨!"

msgid "adv_303002_0024_msg"
msgstr "에헤헤~… 도저히 가만히 있을 수가 없어서\\n내가 직접 보러 와버렸어!"

msgid "adv_303002_0025_msg"
msgstr "상상했던 걸 훨씬 뛰어넘는… 귀여움이야아아~!!"

msgid "adv_303002_0026_msg"
msgstr "지금까지 본 것 중에 제일 텐션 높은\\r\\n마키나 씨다…"

msgid "adv_303002_0027_msg"
msgstr "그야 귀여움과 메카의 협연이니까 말이지?\\r\\n우후훗"

msgid "adv_303002_0028_msg"
msgstr "하아~… 눈이 호강한다~…"

msgid "adv_303002_0029_msg"
msgstr "있잖아, 마키나. 저기…"

msgid "adv_303002_0030_msg"
msgstr ""

msgid "adv_303002_0031_msg"
msgstr "아까 브레라 씨가\\r\\n우리 의상을 보고 이렇게 말했어요"

msgid "adv_303002_0032_msg"
msgstr "『듣고 보니 나쁘지 않을지도 모르겠군』이라고요"

msgid "adv_303002_0033_msg"
msgstr "마키나의 열변이 브레라한테 전해진 걸까"

msgid "adv_303002_0034_msg"
msgstr "그렇구나…! 정말 그런 거라면 기쁘다~"

msgid "adv_303002_0035_msg"
msgstr "그러네. 이제 남은 건,\\r\\n알토가 솔직해지기만 하면 되겠는데…?"

msgid "adv_303002_0038_msg"
msgstr "아~ 정말. 알았어, 알았다고!"

msgid "adv_303002_0039_msg"
msgstr "…둘 다. 정말 잘 어울려"

msgid "adv_303002_0040_msg"
msgstr "좋아"

msgid "adv_303002_0041_msg"
msgstr "후훗. 고마워, 알토 군!"

msgid "adv_103401_0009_msg"
msgstr ""

msgid "adv_103401_0010_msg"
msgstr "아라드 대장! 죄송합니다, 오늘 훈련에 대해서…\\n…저기, 아라드 대장?"

msgid "adv_103401_0011_msg"
msgstr "아, 미라쥬. 무슨 일이야?"

msgid "adv_103401_0012_msg"
msgstr "오늘 훈련에 대해 상의드릴 게 있었는데요\\n그보다……"

msgid "adv_103401_0013_msg"
msgstr ""

msgid "adv_103401_0014_msg"
msgstr "…뭔가 고민하고 계십니까?\\n제가 도움이 될 수 있는 일이라면 협력하겠습니다!"

msgid "adv_103401_0015_msg"
msgstr "그렇게 말해주니 고맙긴 한데……\\n미라쥬한테 부탁하는 것도 왠지 미안하네"

msgid "adv_103401_0016_msg"
msgstr "왜 그렇습니까?"

msgid "adv_103401_0017_msg"
msgstr "음… 사실 말이지. 화이트데이 답례를\\n생각하고 있었어"

msgid "adv_103401_0018_msg"
msgstr ""

msgid "adv_103401_0019_msg"
msgstr "일단 서프라이즈로 줄 생각이거든.\\n왈큐레나 다른 녀석들한테는 비밀로 해주겠어?"

msgid "adv_103401_0020_msg"
msgstr "아라드 대장…"

msgid "adv_103401_0021_msg"
msgstr "역시 나답지 않지?\\n나도 그렇게 생각하긴 했는데…"

msgid "adv_103401_0022_msg"
msgstr "아뇨. 그런 뜻이 아니라…"

msgid "adv_103401_0023_msg"
msgstr ""

msgid "adv_103401_0024_msg"
msgstr "아라드 대장. 괜찮으시다면\\n그 화이트데이 준비, 저도 돕게 해주세요!"

msgid "adv_103401_0025_msg"
msgstr "왈큐레 여러분께는 늘 신세를 지고 있으니까,\\n함께 좋아해주실 만한 서프라이즈를 생각해봐요!"

msgid "adv_103401_0028_msg"
msgstr "…흐음"

msgid "adv_103401_0030_msg"
msgstr "뭐 하고 있어, 레이나"

msgid "adv_103401_0031_msg"
msgstr "쉿. 조용히 할 것"

msgid "adv_103401_0032_msg"
msgstr "…아라드랑 미라쥬가 뭔가 얘기하고 있어.\\n비밀 냄새가 풀풀 나…"

msgid "adv_103401_0033_msg"
msgstr "그래"

msgid "adv_103401_0034_msg"
msgstr "후후후훗…\\n비밀이라고 들으면 파헤치지 않고는 못 배겨.\\n그게 바로 나라는 여자…!"

msgid "adv_103401_0035_msg"
msgstr "렛츠, 리서치!"

msgid "adv_103402_0009_msg"
msgstr "레이나, 이제 곧 화이트데이 라이브네.\\n잘하고 와"

msgid "adv_103402_0010_msg"
msgstr "오늘도 전력을 다해 지켜드리겠습니다!\\n힘내세요, 레이나 씨"

msgid "adv_103402_0011_msg"
msgstr "당연. 하지만 그전에…"

msgid "adv_103402_0012_msg"
msgstr "뒤를 밟은 건 반성. 악의는 없었어"

msgid "adv_103402_0013_msg"
msgstr "오늘은 유난히 솔직하네…\\n카나메 씨한테 혼났어?"

msgid "adv_103402_0014_msg"
msgstr "아니. 일단 사과는 해두려고 했을 뿐"

msgid "adv_103402_0015_msg"
msgstr "하하하, 그래"

msgid "adv_103402_0018_msg"
msgstr "몰래 수상한 짓을 하는 사람이 있으면 신경 쓰이는 건\\n어쩔 수 없잖아"

msgid "adv_103402_0019_msg"
msgstr "우리는 비밀이라고 들으면 파헤치고 싶어지는 여자니까"

msgid "adv_103402_0020_msg"
msgstr "그건 내 대사…"

msgid "adv_103402_0021_msg"
msgstr "…후훗"

msgid "adv_103402_0022_msg"
msgstr "하아…… 정말.\\n미쿠모 씨는 반성하지도 않잖아요… 그래도"

msgid "adv_103402_0023_msg"
msgstr "결과적으로 서프라이즈는 성공했으니,\\n신경 쓰지 않으셔도 됩니다"

msgid "adv_103402_0026_msg"
msgstr "미라쥬도 다음에는 미행을 눈치챌 수 있게\\n훈련해야겠네"

msgid "adv_103402_0027_msg"
msgstr "윽…………"

msgid "adv_103402_0030_msg"
msgstr "후훗, 슬슬 시간이네"

msgid "adv_103402_0031_msg"
msgstr "다녀올게"

msgid "adv_103402_0032_msg"
msgstr "오늘도 최고의 노래를 전할 테니까…"

msgid "adv_103402_0033_msg"
msgstr "호위, 부탁해"

msgid "adv_103402_0034_msg"
msgstr "알겠습니다!\\n힘내세요, 미쿠모 씨, 레이나 씨!"

msgid "adv_100298901_0004_msg"
msgstr "사운드 부스터에 관심 있어"

msgid "adv_100298901_0005_msg"
msgstr "그럼 닥터 치바한테 물어보면 되잖아"

msgid "adv_100298901_0006_msg"
msgstr "그 아저씨도 너희가 쓰는 장비에\\r\\n엄청 관심 많았어"

msgid "adv_100298901_0007_msg"
msgstr "생체 폴드파를 볼 수 있는 그 붙이는 손톱 같은 거"

msgid "adv_100298901_0008_msg"
msgstr "그건 카오스와 왈큐레의 극비 정보…\\r\\n외부에 흘릴 수는 없어"

msgid "adv_100298901_0009_msg"
msgstr "뭐야, 안 되는 거야?"

msgid "adv_100298901_0010_msg"
msgstr "…닥터 치바라는 사람의 태도에 달렸어.\\r\\n이름부터 왠지 수상해 보여…!"

msgid "adv_100298902_0004_msg"
msgstr "레이레이~! 같이 밥 먹으러… 어?\\r\\n뭐 하고 있어?"

msgid "adv_100298902_0005_msg"
msgstr "…자극적인 놀이"

msgid "adv_100298902_0006_msg"
msgstr "그렇구나, 해킹이구나…\\r\\n카나카나한테 들키면 혼날걸~?"

msgid "adv_100298902_0007_msg"
msgstr "난 위험을 사랑하는 여자. 그 정도는 여유"

msgid "adv_100298902_0008_msg"
msgstr "역시 레이레이! 당당한 모습도 너무 귀여워~!\\n그럼 혼날 때도 같이네!"

msgid "adv_100298902_0009_msg"
msgstr "마키나… 고마워"

msgid "adv_100298902_0010_msg"
msgstr "에헤헤… 레이레이를 위해서라면 당연하지!\\r\\n그럼, 가보자~!"

msgid "adv_303101_0009_msg"
msgstr ""

msgid "adv_303101_0010_msg"
msgstr "…프레이아?"

msgid "adv_303101_0011_msg"
msgstr "깜짝 놀랐어. 전혀 눈치 못 챘네.\\n대체 언제부터 거기 있었어?"

msgid "adv_303101_0012_msg"
msgstr "호와아…"

msgid "adv_303101_0013_msg"
msgstr "프레이아?"

msgid "adv_303101_0014_msg"
msgstr "기운 팍팍~… 천사 같아요…"

msgid "adv_303101_0015_msg"
msgstr "저기… 프레이아!"

msgid "adv_303101_0016_msg"
msgstr "…!? 네엣!!"

msgid "adv_303101_0017_msg"
msgstr "앗.\\r\\n미, 민메이 씨, 죄송해요!"

msgid "adv_303101_0018_msg"
msgstr "민메이 씨 모습이\\r\\n너무나 천사 같아서…\\r\\n넋을 놓고 멍하니 보고 있었어요!"

msgid "adv_303101_0019_msg"
msgstr "우후훗. 고마워!\\r\\n하지만 천사라니 너무 과장이야"

msgid "adv_303101_0020_msg"
msgstr "그렇지 않아요!\\r\\n저 정말 정말, 완전히 마음을 빼앗겼어요!"

msgid "adv_303101_0021_msg"
msgstr "너무 아름답고, 신비롭고…"

msgid "adv_303101_0022_msg"
msgstr "…저도 모르게 전에 미쿠모 씨한테 들었던 말이\\r\\n생각났어요"

msgid "adv_303101_0023_msg"
msgstr "미쿠모 씨한테?"

msgid "adv_303101_0024_msg"
msgstr "네엣.\\r\\n얼마 전에 미쿠모 씨가 말했어요"

msgid "adv_303101_0025_msg"
msgstr "『프레이아. 너는 좀 더 신비로움을 두르도록 해』\\r\\n…라고요"

msgid "adv_303101_0026_msg"
msgstr "몸에 신비로움을 두른다…?\\r\\n으음, 왠지 어려울 것 같네"

msgid "adv_303101_0027_msg"
msgstr "그런데 민메이 씨의\\r\\n천사 같은 모습을 보고 있으니까…"

msgid "adv_303101_0028_msg"
msgstr "혹시 이런 걸 신비라고 하는 건가? 하고\\r\\n생각하기도 했어요!"

msgid "adv_303101_0029_msg"
msgstr "그렇구나. 그런 거라면…"

msgid "adv_303101_0030_msg"
msgstr "프레이아. 나 지금부터 이 의상으로\\nPV 촬영을 할 거야"

msgid "adv_303101_0031_msg"
msgstr "괜찮다면 이 모습을\\n가장 가까이에서 볼 수 있는 곳에서 보고 가지 않을래?"

msgid "adv_303101_0032_msg"
msgstr "『이 모습을 가장 가까이에서 볼 수 있는 곳…?』\\r\\n이라면요?"

msgid "adv_303101_0033_msg"
msgstr "프레이아도 나랑 같이 PV에 출연하지 않을래?\\n라는 제안이야!"

msgid "adv_303101_0034_msg"
msgstr "…호에에!?"

msgid "adv_303101_0035_msg"
msgstr "의상은 마키나한테 부탁하면\\r\\n준비해줄 수 있으려나"

msgid "adv_303101_0036_msg"
msgstr "모처럼이니까 프레이아도 드레스업해서\\n나랑 똑같이 천사가 되어보자, 응?"

msgid "adv_303101_0037_msg"
msgstr "제, 제가 천사로…?"

msgid "adv_303102_0009_msg"
msgstr "미, 민메이 씨!\\r\\n오늘, 자, 잘 부탁드립니닷!!"

msgid "adv_303102_0010_msg"
msgstr "프레이아, 그렇게 긴장하지 않아도 돼"

msgid "adv_303102_0011_msg"
msgstr "마키나가 만들어준\\r\\n『꽃의 천사』 의상, 정말 잘 어울리고\\r\\n멋진걸…"

msgid "adv_303102_0012_msg"
msgstr "좀 더 자신감을 가져! 응?"

msgid "adv_303102_0013_msg"
msgstr "감사합니다.\\r\\n그런데 PV 촬영이 이렇게 큰 규모일 줄은\\r\\n몰랐거든요…!"

msgid "adv_303102_0014_msg"
msgstr "세트도 파티장처럼 크고…\\r\\n엄청난 아우라를 뿜는 사람들도\\r\\n잔뜩 있고…"

msgid "adv_303102_0015_msg"
msgstr "…우우"

msgid "adv_303102_0016_msg"
msgstr "으음. 어떻게든 프레이아의\\r\\n긴장을 풀어줄 수 없을까…"

msgid "adv_303102_0017_msg"
msgstr "…맞다!"

msgid "adv_303102_0018_msg"
msgstr "프레이아.\\r\\n하야테 군이 했던 말, 기억나?"

msgid "adv_303102_0019_msg"
msgstr "호에?"

msgid "adv_303102_0020_msg"
msgstr "프레이아랑 같이 있으면 힘이 난다고"

msgid "adv_303102_0021_msg"
msgstr "프레이아는,\\r\\n모두에게 활기를 나눠주는 천사야. 그러니까…"

msgid "adv_303102_0022_msg"
msgstr "여기 있는 사람들과 스태프분들,\\r\\n그리고 이 PV를 보는 사람들도…\\r\\n분명 힘이 나게 해줄 수 있을 거야!"

msgid "adv_303102_0023_msg"
msgstr "민메이 씨…"

msgid "adv_303102_0024_msg"
msgstr "나도 오늘은 프레이아처럼 되고 싶어"

msgid "adv_303102_0025_msg"
msgstr "내 이 노래로 모두에게 힘을 주고 싶어!"

msgid "adv_303102_0026_msg"
msgstr "프레이아.\\n프레이아의 활기찬 힘… 나한테 빌려줄래?"

msgid "adv_303102_0027_msg"
msgstr "…활기…"

msgid "adv_303102_0028_msg"
msgstr "…! 네엣, 물론이죠!\\r\\n노래는 활기니까요!"

msgid "adv_303102_0029_msg"
msgstr "후훗. 바로 그 기세야!"

msgid "adv_303102_0030_msg"
msgstr "그럼 여러분께 인사도 할 겸\\r\\n한 곡 들려드리러 가볼까"

msgid "adv_303102_0031_msg"
msgstr "…네!? 지, 지금부터요!?"

msgid "adv_303102_0032_msg"
msgstr "응. 지금부터!"

msgid "adv_303102_0033_msg"
msgstr "서두르지 않으면\\r\\n금방 촬영이 시작돼버려.\\r\\n자, 가자!"

msgid "adv_303102_0035_msg"
msgstr "민메이 씨, 기다려주세요~!"

msgid "adv_303102_0036_msg"
msgstr "으음.\\n민메이 씨를 처음에는 신비로운 천사~라고\\n생각했는데…"

msgid "adv_303102_0037_msg"
msgstr "의외로 꽤 행동파라고 해야 하나…?"

msgid "adv_303102_0038_msg"
msgstr "…우히히.\\n그래도 그 정도가 더 좋을지도 몰라!"

msgid "adv_303102_0040_msg"
msgstr "프레이아~!"

msgid "adv_303102_0041_msg"
msgstr "네엣!\\r\\n프레이아 비온, 갑니~다!"

msgid "adv_103501_0009_msg"
msgstr "그럼 이런 건 어때요?\\r\\n예를 들면…"

msgid "adv_103501_0010_msg"
msgstr "…그렇구나!\\r\\n그거 좋은 생각이네, 란카!"

msgid "adv_103501_0011_msg"
msgstr "에헤헤. 감사합니다"

msgid "adv_103501_0013_msg"
msgstr "안녕, 둘 다. 무슨 얘기를 하고 있어?"

msgid "adv_103501_0014_msg"
msgstr "아, 미셸 군!"

msgid "adv_103501_0015_msg"
msgstr "이번에 미호시 학원에서\\r\\n신입생 환영 이벤트가 있잖아?"

msgid "adv_103501_0016_msg"
msgstr "신입생?\\r\\n아, 그렇구나. 벌써 그런 계절이었지"

msgid "adv_103501_0017_msg"
msgstr "우리 학교는 매년 엄청 열심히 준비하니까"

msgid "adv_103501_0018_msg"
msgstr "그래서 말인데, 올해는…"

msgid "adv_103501_0019_msg"
msgstr "셰릴 씨랑 둘이서 라이브를 하게 됐어!"

msgid "adv_103501_0020_msg"
msgstr "후훗.\\r\\n미호시 학원에는 몇 번이나 드나들기도 했으니까"

msgid "adv_103501_0021_msg"
msgstr "뭔가 보답할 수 있다면 나도 기뻐!"

msgid "adv_103501_0022_msg"
msgstr "아하하… 확실히\\r\\n셰릴은 우리 학교에 자주 오긴 하지"

msgid "adv_103501_0023_msg"
msgstr "그렇게 마음에 들었으면\\r\\n아예 입학해버리면 되는 거 아니야?"

msgid "adv_103501_0024_msg"
msgstr "…! 그거 좋네…"

msgid "adv_103501_0025_msg"
msgstr "그레이스한테 한번 상담해볼까?"

msgid "adv_103501_0026_msg"
msgstr "뭐!? 농담으로 한 말이었는데…"

msgid "adv_103501_0027_msg"
msgstr "…뭐, 그건 그렇다 치고.\\r\\n상의하던 건 라이브 내용을 어떻게 할지에 대한 얘기야?"

msgid "adv_103501_0028_msg"
msgstr "응!\\r\\n셰릴 씨가 아이디어를 잔뜩 내줘서\\r\\n정말 즐거운 라이브가 될 것 같아!"

msgid "adv_103501_0029_msg"
msgstr "란카의 아이디어도 꽤 좋았어.\\n둘이서 얘기하니까 좋은 아이디어가 떠오르네"

msgid "adv_103501_0030_msg"
msgstr "이제 남은 건, 그렇네.\\r\\n신입생 모두가 미호시 학원에는\\r\\n이런 선배들이 있구나 하고 알 수 있게…"

msgid "adv_103501_0031_msg"
msgstr "라이브 출연자 중에,\\r\\n재학생도 있으면 좋을지도 모르겠어"

msgid "adv_103501_0032_msg"
msgstr "재학생 출연자요. 으음…"

msgid "adv_103501_0033_msg"
msgstr "……저기, 란카.\\r\\n대놓고 나를 쳐다보는 건 그만해줄래…?"

msgid "adv_103501_0034_msg"
msgstr "어!? 아, 미안!"

msgid "adv_103501_0035_msg"
msgstr "그래도 미셸 군은 여자애들한테 인기가 많으니까,\\n신입생 여자애들도 좋아하지 않을까 싶어서"

msgid "adv_103501_0036_msg"
msgstr "그렇구나. 그거 나쁘지 않네"

msgid "adv_103501_0037_msg"
msgstr "참 단순하네…"

msgid "adv_103501_0038_msg"
msgstr "아쉽게도 연하는 취향이 아니지만,\\r\\n여자애들의 뜨거운 시선을 받는 건 대환영이지"

msgid "adv_103501_0039_msg"
msgstr "…그렇다면, 그래"

msgid "adv_103501_0040_msg"
msgstr "좋아.\\r\\n알토랑 클란한테도 한번 물어볼게"

msgid "adv_103501_0041_msg"
msgstr "어?"

msgid "adv_103501_0042_msg"
msgstr "기대해. 신입생들을,\\r\\n엄청 러블리하고 봄버한 사운드로\\r\\n맞이해줄 테니까!"

msgid "adv_103502_0009_msg"
msgstr "둘 다 학교 무대 수고했어"

msgid "adv_103502_0010_msg"
msgstr "미셸 군!\\n미셸 군도 참가해줘서 고마워!"

msgid "adv_103502_0011_msg"
msgstr "분하지만 덕분에 분위기가 달아올랐어.\\r\\n특히 여자애들한테 말이지"

msgid "adv_103502_0012_msg"
msgstr "어때? 팬이 더 늘 것 같아?"

msgid "adv_103502_0013_msg"
msgstr "글쎄.\\r\\n새 팬이라면 몇 명 낚은 것 같긴 한데?"

msgid "adv_103502_0014_msg"
msgstr "그래도 말했잖아? 연하는 취향이 아니라고"

msgid "adv_103502_0015_msg"
msgstr "흐음. 그래"

msgid "adv_103502_0016_msg"
msgstr "너 참 신기하네.\\n여자 문제로 고생할 것 같지는 않은데\\n애인 하나 없다니"

msgid "adv_103502_0017_msg"
msgstr "쓸데없는 참견이야. 난 여러모로 선을 확실히 그은\\r\\n관계만 맺거든"

msgid "adv_103502_0018_msg"
msgstr "왜?"

msgid "adv_103502_0019_msg"
msgstr "그건 비밀"

msgid "adv_103502_0020_msg"
msgstr "하아… 정말이지"

msgid "adv_103502_0021_msg"
msgstr "그런 것보다,\\r\\n슬슬 출격할 시간 아니야?"

msgid "adv_103502_0022_msg"
msgstr "앗, 그러네요!\\n셰릴 씨, 우리도 준비해야 해요!"

msgid "adv_103502_0023_msg"
msgstr "응, 그러네. …정말이지"

msgid "adv_103502_0024_msg"
msgstr "다음엔 제대로 들려줘야 해, 알겠지?"

msgid "adv_103502_0025_msg"
msgstr "그래그래"

msgid "adv_103502_0026_msg"
msgstr "그럼 란카. 가볼까!"

msgid "adv_103502_0027_msg"
msgstr "여기서 실수하면 어제 신입생들이\\r\\n실망할 테니까"

msgid "adv_103502_0028_msg"
msgstr "네! 그러네요!"

msgid "adv_103502_0029_msg"
msgstr "앞으로도 학교 모두를… 은하의 모두를\\r\\n우리 노래로 지켜야죠!"

msgid "adv_103502_0030_msg"
msgstr "응, 물론이지!"

msgid "adv_100307301_0004_msg"
msgstr "바사라 씨, 부탁이 하나 있는데요…\\r\\n괜찮으세요?"

msgid "adv_100307301_0005_msg"
msgstr "뭔데. 사양하지 말고 말해봐"

msgid "adv_100307301_0006_msg"
msgstr "그… 사인해주세요!\\r\\n오빠가 갖고 싶어 해서…"

msgid "adv_100307301_0007_msg"
msgstr "…근데 오즈마한테는 얼마 전에 해줬잖아?"

msgid "adv_100307301_0008_msg"
msgstr "그게, 바사라 씨 사인은 그때그때 다르니까,\\r\\n모든 패턴을 다 모으고 싶다면서…"

msgid "adv_100307301_0009_msg"
msgstr "그야 매번 기분 내키는 대로 쓰니까.\\r\\n전부 모으겠다는 건 무리야"

msgid "adv_100307301_0010_msg"
msgstr "그랬군요… 오빠가 납득하려나?"

msgid "adv_100307302_0004_msg"
msgstr "알토 군이랑 하야테 군,\\n요즘 정말 사이가 좋죠"

msgid "adv_100307302_0005_msg"
msgstr "알토 군도 하야테 군도 나는 걸 좋아하니까,\\n마음이 잘 맞는 걸지도?"

msgid "adv_100307302_0006_msg"
msgstr "서로 닮은 꼴이라고 해야 하나"

msgid "adv_100307302_0007_msg"
msgstr "그런 의미라면 너랑 셰릴도\\r\\n서로 닮은 꼴일지도 모르겠네?"

msgid "adv_100307302_0008_msg"
msgstr "노래를 좋아하는, 닮은 꼴"

msgid "adv_100307302_0009_msg"
msgstr "…셰릴 씨랑 제가 닮은 꼴…!\\r\\n에헤헤, 왠지 정말 기뻐요!"

msgid "adv_303201_0009_msg"
msgstr "얘들아! 수고했어!"

msgid "adv_303201_0010_msg"
msgstr "수고하셨습니다!"

msgid "adv_303201_0011_msg"
msgstr "후우… 계속 긴장하고 있어서 그런지\\r\\n무대에서 내려오자마자 힘이 쭉 빠지네요…"

msgid "adv_303201_0012_msg"
msgstr "…셔터 찬스"

msgid "adv_303201_0013_msg"
msgstr "앗! 레, 레이나 씨!?"

msgid "adv_303201_0014_msg"
msgstr "라이브 직후 프레이아의\\r\\n흐물흐물한 얼굴… 겟"

msgid "adv_303201_0015_msg"
msgstr "그, 그런 거 찍지 마세요!\\n지금 당장 지워주세요~!"

msgid "adv_303201_0016_msg"
msgstr "거절"

msgid "adv_303201_0019_msg"
msgstr "쿠모쿠모, 수고했어!\\r\\n첫날부터 절호조였네!"

msgid "adv_303201_0020_msg"
msgstr "별로, 평소랑 똑같았어.\\n마키나야말로 평소보다 더\\n의욕이 넘쳤던 거 아니야?"

msgid "adv_303201_0021_msg"
msgstr "에헤헤~. 그야 그렇지"

msgid "adv_303201_0022_msg"
msgstr "오늘은 은하 곳곳의 여러 행성을 도는\\r\\n투어 라이브 첫날인걸!"

msgid "adv_303201_0023_msg"
msgstr "나는 말이야. 이번 투어에서 은하의 모두에게\\r\\n왈큐레에 대해\\r\\n좀 더 잘 알게 해주고 싶어!"

msgid "adv_303201_0024_msg"
msgstr "왈큐레에 대해 좀 더 잘 안다…?"

msgid "adv_303201_0025_msg"
msgstr "그건 우리 노래를 들려주는 것만으로는\\r\\n부족한 거야?"

msgid "adv_303201_0026_msg"
msgstr "그건 물론인데…\\r\\n뭐랄까, 아직 보여주지 못한 우리 모습을\\r\\n알아줬으면 한다고 해야 하나!"

msgid "adv_303201_0027_msg"
msgstr "구체적으로 뭘 할지는\\r\\n아직 생각 중이지만!"

msgid "adv_303201_0028_msg"
msgstr "마키나. 봐"

msgid "adv_303201_0029_msg"
msgstr "왜, 레이레이?\\n…앗! 프레프레 힘 빠진 얼굴 너무 귀여워~!"

msgid "adv_303201_0030_msg"
msgstr "다른 것도 많이 찍었어"

msgid "adv_303201_0031_msg"
msgstr "라이브 직전 긴장하고 있는 프레이아,\\r\\n쉬는 시간에 물 마시는 카나메…"

msgid "adv_303201_0032_msg"
msgstr "대기실에 들어오자마자 바로 옷을 벗기 시작하는 미쿠모"

msgid "adv_303201_0033_msg"
msgstr "어머, 정말이네"

msgid "adv_303201_0034_msg"
msgstr "정말, 레이레이.\\r\\n찍는 건 괜찮지만 너무 이상한 사진은\\r\\n찍으면 안 돼~… 어?"

msgid "adv_303201_0035_msg"
msgstr "…좋은 생각 났다!!"

msgid "adv_303201_0036_msg"
msgstr ""

msgid "adv_303201_0037_msg"
msgstr "있잖아, 레이레이.\\r\\n레이레이 단말기에 들어 있는 사진\\r\\n잠깐 보여줄 수 있어?"

msgid "adv_303201_0038_msg"
msgstr "당연히 OK"

msgid "adv_303201_0039_msg"
msgstr "마키나, 뭘 하려는 거야?"

msgid "adv_303201_0040_msg"
msgstr "후훗! 그건 아직 기대해줘!"

msgid "adv_303202_0009_msg"
msgstr "마키나"

msgid "adv_303202_0010_msg"
msgstr "아, 쿠모쿠모!\\r\\n모두의 비하인드 사진, 찍었어?"

msgid "adv_303202_0011_msg"
msgstr "응"

msgid "adv_303202_0012_msg"
msgstr "고마워~!\\r\\n그럼 이걸 레이레이한테 보내고…"

msgid "adv_303202_0013_msg"
msgstr "…자, 이걸로 OK!\\r\\n곧 레이레이가 퍼뜨려줄 거야"

msgid "adv_303202_0014_msg"
msgstr "알겠어"

msgid "adv_303202_0015_msg"
msgstr ""

msgid "adv_303202_0016_msg"
msgstr "찍은 사진 다시 보고 있는 거야?"

msgid "adv_303202_0017_msg"
msgstr "응"

msgid "adv_303202_0018_msg"
msgstr "우후훗. 다들 좋은 표정이네"

msgid "adv_303202_0019_msg"
msgstr "쿠모쿠모, 사람들 사진 찍는 재능 있는 거 아니야?"

msgid "adv_303202_0020_msg"
msgstr "그런가?\\r\\n그래도… 이렇게 내가 직접 찍은 사진을 다시 보는 건\\r\\n나쁘지 않네"

msgid "adv_303202_0021_msg"
msgstr "마키나. 너는\\r\\n왈큐레의 새로운 매력을 알리기 위해서\\r\\n라고 했지만…"

msgid "adv_303202_0022_msg"
msgstr "나한테는 이게 좋은 추억이 될 것 같아.\\r\\n…그런 기분이 들어"

msgid "adv_303202_0023_msg"
msgstr "내겐 아직 추억이라고 부를 만한 게\\r\\n그렇게 많지 않으니까"

msgid "adv_303202_0024_msg"
msgstr "쿠모쿠모…"

msgid "adv_303202_0025_msg"
msgstr "그러니까… 나, 이번 투어가 끝나도\\r\\n계속 너희 사진을 찍고 싶어"

msgid "adv_303202_0026_msg"
msgstr "그래도 될까?"

msgid "adv_303202_0027_msg"
msgstr "…응! 좋아, 좋아! 물론이지!"

msgid "adv_303202_0028_msg"
msgstr "레이레이한테 말해서 사진 퍼뜨리는 것도 계속 부탁하자!\\r\\n쿠모쿠모가 찍은 사진, 분명 다들 좋아할 거야!"

msgid "adv_303202_0029_msg"
msgstr "그러네"

msgid "adv_303202_0030_msg"
msgstr ""

msgid "adv_303202_0031_msg"
msgstr "후훗!"

msgid "adv_303202_0032_msg"
msgstr "부끄러워하는 쿠모쿠모, 너무 귀여워~!"

msgid "adv_303202_0033_msg"
msgstr "…놀리지 말아줘"

msgid "adv_303202_0034_msg"
msgstr "네네~!"

msgid "adv_103601_0009_msg"
msgstr "하아~…"

msgid "adv_103601_0010_msg"
msgstr "수고했어~!"

msgid "adv_103601_0011_msg"
msgstr "척, 봤어.\\r\\n메서한테 엄청 혼나는 거"

msgid "adv_103601_0012_msg"
msgstr "아차~. 꼴사나운 모습을 들켜버렸네…"

msgid "adv_103601_0013_msg"
msgstr "…으음.\\r\\n메사메사가 엄격한 건 늘 그렇지만…"

msgid "adv_103601_0014_msg"
msgstr "오늘 척은 평소보다 피곤해 보여"

msgid "adv_103601_0015_msg"
msgstr "밤샘이라도 해서 잠을 전혀 못 잔\\r\\n느낌이랄까?"

msgid "adv_103601_0016_msg"
msgstr "역시 마키나랑 레이나네. 딱 맞혔어"

msgid "adv_103601_0017_msg"
msgstr "지금 라그나는 관광 시즌이라\\r\\n온 도시가 북적거리잖아?"

msgid "adv_103601_0018_msg"
msgstr "우리 가게도 장사가 잘돼서 말이야.\\r\\n물론 고마운 일이긴 한데…"

msgid "adv_103601_0019_msg"
msgstr "나랑 동생들만으론 손이 턱없이 부족해서.\\r\\n매일매일 정신없이 바빠"

msgid "adv_103601_0020_msg"
msgstr "어제도 밤늦게까지 물건 관리 같은 걸 하다 보니…\\r\\n흐아암…"

msgid "adv_103601_0021_msg"
msgstr "그렇구나, 그렇구나"

msgid "adv_103601_0022_msg"
msgstr "방심한 걸 메서한테 지적받았거든.\\r\\n하아… 모두를 지켜야 할 파일럿으로선\\r\\n확실히 실격이지"

msgid "adv_103601_0023_msg"
msgstr "그렇다고 마리안느 애들한테\\r\\n전부 맡길 수도 없고 말이야"

msgid "adv_103601_0024_msg"
msgstr "도와줄게"

msgid "adv_103601_0025_msg"
msgstr "어?"

msgid "adv_103601_0026_msg"
msgstr "가게. 마키나랑 내가 도와줄게"

msgid "adv_103601_0027_msg"
msgstr "와아. 레이레이, 그거 굿 아이디어!"

msgid "adv_103601_0028_msg"
msgstr "나체냥냥에는 항상 신세 지고 있으니까!\\r\\n우리가 도울 수 있는 일이라면,\\r\\n뭐든 할게!"

msgid "adv_103601_0029_msg"
msgstr "정말이야!? 좋았어, 살았다!"

msgid "adv_103601_0030_msg"
msgstr ""

msgid "adv_103601_0033_msg"
msgstr "레이레이, 슬슬 나체냥냥 도우러 가자~!"

msgid "adv_103601_0034_msg"
msgstr "기다려. 조금만 더"

msgid "adv_103601_0035_msg"
msgstr "…좋아. 확산 완료"

msgid "adv_103601_0036_msg"
msgstr "확산? 뭘 퍼뜨린 거야?"

msgid "adv_103601_0037_msg"
msgstr "지금부터 우리가\\r\\n나체냥냥에서 아르바이트한다는 공지"

msgid "adv_103601_0038_msg"
msgstr "뭐어!?\\r\\n그걸 인터넷에 공지해버린 거야!?"

msgid "adv_103601_0039_msg"
msgstr "후후후…"

msgid "adv_103601_0040_msg"
msgstr "어라라…\\r\\n지금 먹으러 가겠다는 사람이 잔뜩…"

msgid "adv_103601_0041_msg"
msgstr "이거 척 씨가 예상한 것보다\\r\\n훨씬 바빠질 것 같은 예감이…!"

msgid "adv_103602_0009_msg"
msgstr "척"

msgid "adv_103602_0010_msg"
msgstr "오, 둘 다 멋진데!\\r\\n그게 이번 라이브 의상이야?"

msgid "adv_103602_0011_msg"
msgstr "응, 맞아~"

msgid "adv_103602_0012_msg"
msgstr "좋네, 최고야!"

msgid "adv_103602_0013_msg"
msgstr "…그런데 미안했어.\\r\\n오늘이 라이브인데 어제 늦게까지 도와달라고 해서"

msgid "adv_103602_0014_msg"
msgstr "신경 쓰지 마!\\r\\n나도 레이레이도 컨디션 완벽하니까!"

msgid "adv_103602_0015_msg"
msgstr "역시 초시공 비너스 왈큐레!"

msgid "adv_103602_0016_msg"
msgstr "아무튼 도와줘서 정말 살았어.\\r\\n고맙다!"

msgid "adv_103602_0017_msg"
msgstr "후훗, 천만에.\\n정말 즐거웠어~"

msgid "adv_103602_0018_msg"
msgstr "완벽한 접객"

msgid "adv_103602_0019_msg"
msgstr "정말, 레이레이.\\r\\n손님이 부탁하지도 않은 생해파리를\\r\\n갖다주고 있었잖아?"

msgid "adv_103602_0020_msg"
msgstr "추천 메뉴를 물어봐서 가져다준 것뿐"

msgid "adv_103602_0021_msg"
msgstr "아하하! 확실히 그런 일도 있었지"

msgid "adv_103602_0022_msg"
msgstr "놀라는 손님이 대부분이었지만\\n의외로 푹 빠진 사람도 있지 않을까?"

msgid "adv_103602_0023_msg"
msgstr "그런데 레이레이.\\r\\n생해파리 좋아하는 사람이 늘어나면\\r\\n레이레이가 먹을 생해파리가 줄어들걸?"

msgid "adv_103602_0024_msg"
msgstr "…! 그건 곤란해!"

msgid "adv_103602_0025_msg"
msgstr "하지만 모두가 해파리를 먹어줬으면 좋겠어…"

msgid "adv_103602_0026_msg"
msgstr "궁극의 딜레마…"

msgid "adv_103602_0027_msg"
msgstr "그렇게 풀이 죽지 마.\\r\\n레이나 몫의 생해파리는,\\r\\n언제든 준비해둘 테니까"

msgid "adv_103602_0028_msg"
msgstr "척… 최고!"

msgid "adv_103602_0029_msg"
msgstr "우후훗. 잘됐네, 레이레이!"

msgid "adv_103602_0030_msg"
msgstr "둘한테 뭔가 보답해야겠네.\\r\\n뭐가 좋아?"

msgid "adv_103602_0031_msg"
msgstr "아니야, 아니야!\\r\\n평소에 늘 신세 지고 있으니까 괜찮아!"

msgid "adv_103602_0032_msg"
msgstr "게다가 라이브 전에 좋은 PR도 됐고…"

msgid "adv_103602_0033_msg"
msgstr "냥냥의 너무 귀여운 유니폼을 입고 있으니까,\\n새 의상 아이디어도 마구마구 떠올랐거든!"

msgid "adv_103602_0034_msg"
msgstr "서로 행복. 윈윈"

msgid "adv_103602_0035_msg"
msgstr "그래? …뭐, 그래도\\r\\n개인적으로 뭔가 답례를 생각해둘게"

msgid "adv_103602_0036_msg"
msgstr "…자, 슬슬 출격인가.\\r\\n너희는 라이브, 힘내!"

msgid "adv_103602_0037_msg"
msgstr "이번에는 내가 둘에게 힘이 되어줄게!"

msgid "adv_103602_0038_msg"
msgstr "응! 고마워, 척 씨!\\r\\n잘 다녀와!"

msgid "adv_103602_0039_msg"
msgstr "굿 럭"

msgid "adv_100314501_0004_msg"
msgstr "란란 머리는 쫑긋쫑긋 움직여서,\\r\\n정말 너무 귀여워~!"

msgid "adv_100314501_0005_msg"
msgstr "그런가요? 기분이 금방 들켜버려서,\\r\\n조금 부끄럽긴 한데…"

msgid "adv_100314501_0006_msg"
msgstr "그렇지 않아~. 너무 귀여워서 나도 모르게 머리를\\r\\n쓰담쓰담해주고 싶어진다니까!"

msgid "adv_100314501_0007_msg"
msgstr "쓰, 쓰담쓰담…!?"

msgid "adv_100314501_0008_msg"
msgstr "으음~… 하지만 그러려면 초시공 유닛 라이브에서\\r\\n물리적인 접촉이 가능하게 만들어야겠네"

msgid "adv_100314501_0009_msg"
msgstr "란란을 쓰담쓰담하기 위해서라도,\\r\\n레이레이랑 같이 개량 열심히 할게!"

msgid "adv_100314501_0010_msg"
msgstr "어, 저기… 여, 열심히 해주세요!"

msgid "adv_100314502_0004_msg"
msgstr "레이레이, 오늘 저녁 뭐 먹고 싶어~?"

msgid "adv_100314502_0005_msg"
msgstr "마키나가 만드는 거라면 뭐든지"

msgid "adv_100314502_0006_msg"
msgstr "정말~! 뭐든지는 안 된다고 했잖아~?\\r\\n좀 더 구체적으로!"

msgid "adv_100314502_0007_msg"
msgstr "하지만 마키나 음식은 뭐든 맛있어.\\r\\n전부 좋아하니까… 너무 고민돼"

msgid "adv_100314502_0008_msg"
msgstr "어, 정말!? 에헤헤…"

msgid "adv_100314502_0009_msg"
msgstr "제대로 생각할게. 마키나가 만든 음식 기록,\\r\\n매일 찍어두니까 그걸 다시 보고 생각할게"

msgid "adv_100314502_0010_msg"
msgstr "레이레이~~~!!"

msgid "adv_303301_0009_msg"
msgstr "굉장해~! 끝없이 펼쳐진 바다다~!"

msgid "adv_303301_0010_msg"
msgstr ""

msgid "adv_303301_0011_msg"
msgstr "…후훗! 역시 바사라도 압도당했지?"

msgid "adv_303301_0012_msg"
msgstr "뭐?"

msgid "adv_303301_0013_msg"
msgstr "바사라도 꽤 어린애 같은 구석 있잖아!\\r\\n나한테는 맨날 애 취급하면서"

msgid "adv_303301_0014_msg"
msgstr "넌 애 맞잖아"

msgid "adv_303301_0015_msg"
msgstr "뭐라고~!?"

msgid "adv_303301_0017_msg"
msgstr "둘 다. 저쪽에서 관광선을 탈 수 있는 모양이야.\\r\\n가보지 않을래?"

msgid "adv_303301_0018_msg"
msgstr "뭐!? 정말 괜찮아, 레이!?"

msgid "adv_303301_0019_msg"
msgstr "이 행성에서 라이브는 사흘 뒤니까.\\r\\n오늘은 관광이나 하자"

msgid "adv_303301_0020_msg"
msgstr "듣자 하니 저 관광선을 타면\\r\\n고래 관찰도 할 수 있다더군"

msgid "adv_303301_0021_msg"
msgstr "고래 관찰… 그럼\\r\\n고래가 있다는 거네!?"

msgid "adv_303301_0022_msg"
msgstr "나, 고래가 바다에서 헤엄치는 모습 본 적 없어!\\n무조건 보러 가고 싶어~!"

msgid "adv_303301_0023_msg"
msgstr "고래?\\r\\n고래는 바다가 아니라 하늘을 나는 거잖아"

msgid "adv_303301_0024_msg"
msgstr "하늘을?"

msgid "adv_303301_0025_msg"
msgstr "무슨 소리야, 바사라.\\r\\n고래라면 당연히 바다잖아!"

msgid "adv_303301_0026_msg"
msgstr "그래?"

msgid "adv_303301_0027_msg"
msgstr "…그러고 보니 바사라,\\r\\n전에 우주를 나는 고래가 어쩌고 했었지"

msgid "adv_303301_0028_msg"
msgstr "그건 분명 새의 인간 영향으로\\r\\n다른 시공의 기억을 보게 된 거였지?"

msgid "adv_303301_0029_msg"
msgstr "아… 그러고 보니 그런 일도 있었네"

msgid "adv_303301_0030_msg"
msgstr "바사라, 그때의 기억이랑 현실이\\r\\n뒤섞인 거야?"

msgid "adv_303301_0031_msg"
msgstr "글쎄"

msgid "adv_303301_0032_msg"
msgstr "그럼 고래는 바다에서 헤엄치는 거라는 걸\\r\\n다시 확인하러 가자!"

msgid "adv_303301_0033_msg"
msgstr "나 티켓 사올게~!"

msgid "adv_303301_0035_msg"
msgstr "밀레느, 모래사장에서 뛰면 위험해.\\r\\n…하하, 오늘 밀레느는 평소보다 더 신나 보이네"

msgid "adv_303301_0036_msg"
msgstr "고래…인가"

msgid "adv_303301_0037_msg"
msgstr "괜찮아? 바사라. 잠깐 쉬고 와도 돼.\\r\\n밀레느한테는 내가 말해둘게…"

msgid "adv_303301_0038_msg"
msgstr "…아니. 나도 갈래"

msgid "adv_303301_0039_msg"
msgstr "바다를 헤엄치는 고래라는 것도 나쁘진 않네"

msgid "adv_303301_0040_msg"
msgstr "원래는 바다에서 헤엄치는 건데 말이지…"

msgid "adv_303302_0009_msg"
msgstr "고래…인가"

msgid "adv_303302_0010_msg"
msgstr "아, 바사라 찾았다!"

msgid "adv_303302_0011_msg"
msgstr "밀레느?"

msgid "adv_303302_0012_msg"
msgstr "정말! 라이브 끝나자마자 사라져버리고…\\n혼자 바다를 보고 뭐 하는 거야?"

msgid "adv_303302_0013_msg"
msgstr ""

msgid "adv_303302_0014_msg"
msgstr "…좋아. 정했어"

msgid "adv_303302_0015_msg"
msgstr "난 이 행성에 좀 더 남을 거야"

msgid "adv_303302_0016_msg"
msgstr "뭐!?\\r\\n그럼 한동안 안 돌아갈 생각이야!?"

msgid "adv_303302_0017_msg"
msgstr "어쩔 수 없잖아.\\r\\n이 행성이 마음에 들어버렸거든"

msgid "adv_303302_0018_msg"
msgstr "난 남을 테니까\\r\\n넌 레이 일행이랑 먼저 돌아가"

msgid "adv_303302_0019_msg"
msgstr "…뭐야, 그게"

msgid "adv_303302_0020_msg"
msgstr "…싫어. 나도 남을래!"

msgid "adv_303302_0021_msg"
msgstr "뭐? 왜?"

msgid "adv_303302_0022_msg"
msgstr "이유 같은 건 아무래도 상관없잖아!"

msgid "adv_303302_0023_msg"
msgstr "나도, 그게…"

msgid "adv_303302_0024_msg"
msgstr ""

msgid "adv_303302_0025_msg"
msgstr "…아무것도 아니야! 이 행성에 있고 싶어!"

msgid "adv_303302_0026_msg"
msgstr "그게 다야! 그럼!"

msgid "adv_303302_0028_msg"
msgstr "…뭐야, 쟤"

msgid "adv_303302_0030_msg"
msgstr "밀레느도 저렇게 말하니\\r\\n이 행성에 조금 더 머물도록 할까"

msgid "adv_303302_0031_msg"
msgstr "레이…"

msgid "adv_303302_0032_msg"
msgstr "그보다 바사라.\\r\\n언제까지 그 의상을 입고 있을 생각이야?"

msgid "adv_303302_0033_msg"
msgstr "평소엔 라이브가 끝나면\\r\\n바로 사복으로 갈아입잖아"

msgid "adv_303302_0034_msg"
msgstr "아… 이걸 입고 있으니까\\r\\n이 행성 녀석들의 마음을 알 것 같은 기분이 들었어"

msgid "adv_303302_0035_msg"
msgstr "고래한테도 좀 더 가까이 다가갈 수 있을 것 같고"

msgid "adv_303302_0036_msg"
msgstr "하하. 그렇구나"

msgid "adv_303302_0037_msg"
msgstr "기다려라, 고래…!\\r\\n내 노래로 널 더 신나게 날뛰게 해주겠어!"

msgid "adv_103701_0009_msg"
msgstr ""

msgid "adv_103701_0010_msg"
msgstr "셰릴? 왜 그래. 갑자기 멈춰 서고…"

msgid "adv_103701_0011_msg"
msgstr "…알토. 방금 노래 안 들렸어?"

msgid "adv_103701_0012_msg"
msgstr "노래?"

msgid "adv_103701_0013_msg"
msgstr "…봐! 지금도 들려. 여자애의 노랫소리야"

msgid "adv_103701_0014_msg"
msgstr "나한테는 아무것도 안 들리는데…\\n어디서 들리는 거야?"

msgid "adv_103701_0015_msg"
msgstr "이쪽이야!"

msgid "adv_103701_0017_msg"
msgstr "아니, 잠깐! 셰릴, 기다려!"

msgid "adv_103701_0020_msg"
msgstr "…안 들리게 됐어"

msgid "adv_103701_0021_msg"
msgstr "이상하네.\\r\\n분명 이쪽에서 들려왔다고 생각했는데…"

msgid "adv_103701_0022_msg"
msgstr "…어머? 저게 뭐지.\\r\\n커다란 새 같은 게 천천히 날아가고 있어…"

msgid "adv_103701_0023_msg"
msgstr "…아니. 달라, 새가 아니야. 저건…"

msgid "adv_103701_0024_msg"
msgstr "발키리?"

msgid "adv_103701_0025_msg"
msgstr "이 기억, 설마…"

msgid "adv_103701_0027_msg"
msgstr "셰릴! 겨우 따라잡았네…"

msgid "adv_103701_0028_msg"
msgstr "근데 왜 그래?\\r\\n하늘을 올려다보며 멍하니 있고"

msgid "adv_103701_0029_msg"
msgstr ""

msgid "adv_103701_0030_msg"
msgstr "……대체 누가 노래하고 있었던 걸까?"

msgid "adv_103701_0031_msg"
msgstr "…혹시 또 다른 시공의 기억을 본 거야?"

msgid "adv_103701_0032_msg"
msgstr "응. 그것도 우리 말고 다른 누군가의 기억을"

msgid "adv_103701_0033_msg"
msgstr "…있잖아, 알토!\\r\\n저 발키리 기체 이름, 알아!?"

msgid "adv_103701_0034_msg"
msgstr "바, 발키리? 무슨 소리야"

msgid "adv_103701_0035_msg"
msgstr "아까부터 계속 하늘을 날고 있잖아!\\r\\n봐, 저기에…!"

msgid "adv_103701_0036_msg"
msgstr "…어머?"

msgid "adv_103701_0037_msg"
msgstr "잘못 본 거 아니야?"

msgid "adv_103701_0038_msg"
msgstr "그럴 리 없어! 게다가…"

msgid "adv_103701_0039_msg"
msgstr "그 노래와 다른 시공의 기억, 그리고 방금 발키리.\\r\\n이 세 가지가 뭔가 관련된 것 같은 느낌을 지울 수가 없어!"

msgid "adv_103701_0040_msg"
msgstr "으, 으음. 잘 모르겠지만…"

msgid "adv_103701_0041_msg"
msgstr "발키리에 관한 거라면 루카한테 물어보는 게 어때?"

msgid "adv_103701_0042_msg"
msgstr "그 녀석이라면\\r\\n그 발키리의 특징만 알려줘도\\r\\n어떤 기체인지 찾아낼 수 있을 거야"

msgid "adv_103701_0043_msg"
msgstr "그렇구나…\\r\\n그래, 한번 물어볼게!"

msgid "adv_103702_0009_msg"
msgstr "이사무 다이슨.\\r\\n갈드 고어 보먼…"

msgid "adv_103702_0010_msg"
msgstr "루카가 조사해서 이 두 사람이\\r\\n파일럿이었다는 것까지는 알아냈어"

msgid "adv_103702_0011_msg"
msgstr "하지만 그 노래를 부른 사람의 이름까지는\\r\\n알 수 없었네…"

msgid "adv_103702_0013_msg"
msgstr "그 노래 생각하고 있는 거지?"

msgid "adv_103702_0014_msg"
msgstr "미쿠모. …뭐, 그렇지"

msgid "adv_103702_0015_msg"
msgstr "…이사무와 갈드의 이름은\\r\\n전에 너랑 바사라와 함께 봤던 기억 속에도 있었어"

msgid "adv_103702_0016_msg"
msgstr "그때는 그 두 사람이\\r\\n샤론 애플과 뭔가 관계가 있는 것처럼\\r\\n보였지만…"

msgid "adv_103702_0017_msg"
msgstr "이번에 들은 그 노래는 샤론의 것이 아니야"

msgid "adv_103702_0018_msg"
msgstr "어딘가 비슷한 느낌은 있지만…\\r\\n샤론처럼 완성된 노랫소리는 아니었어"

msgid "adv_103702_0019_msg"
msgstr "너도 그렇게 생각하는구나"

msgid "adv_103702_0020_msg"
msgstr "응. 그건 틀림없이 인간의 노랫소리였어.\\r\\n그것도 아직 한참 미완성인 느낌의"

msgid "adv_103702_0021_msg"
msgstr "하지만 그게 무척 기분 좋았어.\\r\\n때 묻지 않은 꿈, 순수한 바람 같아서…"

msgid "adv_103702_0022_msg"
msgstr "덕분에 내가 노래와 함께 살아가기로 결심했던 때의 마음을\\r\\n떠올렸어"

msgid "adv_103702_0023_msg"
msgstr "노래한 사람의 이름을 알게 된다면\\r\\n내가 직접 찾아내서 프로듀스해주고 싶을 정도야"

msgid "adv_103702_0024_msg"
msgstr "라이벌이 늘어서 곤란하지 않겠어?"

msgid "adv_103702_0025_msg"
msgstr "설마. 그 애가 아무리 훌륭한 가수가 되더라도\\r\\n난 언제나 그 위를 갈 거야"

msgid "adv_103702_0026_msg"
msgstr "왜냐하면 나는 셰릴 놈이니까!"

msgid "adv_103702_0027_msg"
msgstr "너의 그런 자신만만한 점\\r\\n싫지 않아"

msgid "adv_103702_0028_msg"
msgstr "후훗. 고마워"

msgid "adv_103702_0029_msg"
msgstr "…있잖아, 미쿠모.\\r\\n그 노래, 우리 둘이서 불러보지 않을래?"

msgid "adv_103702_0030_msg"
msgstr ""

msgid "adv_103702_0031_msg"
msgstr "너라면 기억하고 있지?"

msgid "adv_103702_0032_msg"
msgstr "같이 불러보자.\\r\\n그러면 그 애가 모습을 보여줄지도 몰라"

msgid "adv_103702_0033_msg"
msgstr "…그렇구나"

msgid "adv_103702_0034_msg"
msgstr "셰릴.\\n너, 상당히 마음에 들어버린 모양이네"

msgid "adv_103702_0035_msg"
msgstr "후훗. 그런 것 같아"

msgid "adv_103702_0036_msg"
msgstr "…언젠가 만날 수 있을까"

msgid "adv_103702_0037_msg"
msgstr "분명 만날 수 있어. 은하는 이어져 있으니까…"

msgid "adv_103702_0038_msg"
msgstr "우리도 시공을 넘어 만날 수 있었으니까… 그렇지"

msgid "adv_103702_0039_msg"
msgstr "미쿠모…"

msgid "adv_103702_0040_msg"
msgstr "…응, 그러네!"

msgid "adv_100322901_0004_msg"
msgstr "셰릴 씨랑 란카 씨는\\r\\n어떻게 처음 만나셨어요?"

msgid "adv_100322901_0005_msg"
msgstr "나랑 란카? 그러네…\\r\\n처음 만난 건 란카가 아이돌이 되기 전이야"

msgid "adv_100322901_0006_msg"
msgstr "그때는 아직 이렇게 함께 노래하게 될 줄은\\r\\n생각도 못 했어"

msgid "adv_100322901_0007_msg"
msgstr "만약 운명이라는 게 정말 있다면,\\r\\n나와 란카가 만난 건\\r\\n분명 그런 거 아닐까?"

msgid "adv_100322901_0008_msg"
msgstr "…셰릴 씨는 란카 씨를 정말 좋아하시는군요!"

msgid "adv_100322901_0009_msg"
msgstr "응, 물론이지. 라이벌이기도 하고\\r\\n든든한 동료이기도 해.\\r\\n프레이아, 너도 마찬가지야?"

msgid "adv_100322901_0010_msg"
msgstr "우히히, 네엣!"

msgid "adv_100322902_0004_msg"
msgstr "바사라, 뭐 하고 있어?"

msgid "adv_100322902_0005_msg"
msgstr "기타 튜닝"

msgid "adv_100322902_0006_msg"
msgstr "튜닝…\\r\\n있잖아, 바사라. 기타는 재밌어?"

msgid "adv_100322902_0007_msg"
msgstr "관심 있어?"

msgid "adv_100322902_0008_msg"
msgstr "응, 나도 좀 만져보고 싶어!"

msgid "adv_100322902_0009_msg"
msgstr "…확실히 셰릴이라면 좋은 소리를 낼 수 있을지도 모르겠네"

msgid "adv_100322902_0010_msg"
msgstr "한번 해보지 그래? 가르쳐줄게"

msgid "adv_100322902_0011_msg"
msgstr "어머, 정말!? 고마워!"

msgid "adv_100324101_0004_msg"
msgstr "미쿠모. 넌 노래하기 위해 태어났다는 느낌이 들어"

msgid "adv_100324101_0005_msg"
msgstr "피차일반 아니야?\\r\\n너도 그렇잖아, 바사라"

msgid "adv_100324101_0006_msg"
msgstr "물어볼 필요도 없지"

msgid "adv_100324101_0007_msg"
msgstr "그 이유에 대해 생각해본 적 있어?"

msgid "adv_100324101_0008_msg"
msgstr "없어. 난 노래하고 싶으니까 노래하는 거야.\\r\\n그 이상의 이유는 필요 없잖아"

msgid "adv_100324101_0009_msg"
msgstr "후훗… 후후후"

msgid "adv_100324101_0010_msg"
msgstr "뭐야"

msgid "adv_100324101_0011_msg"
msgstr "너의 그런 삶의 방식… 동경하게 돼"

msgid "adv_100324102_0004_msg"
msgstr "미쿠모. 이따가 같이 카페라도 갈래?"

msgid "adv_100324102_0005_msg"
msgstr "그러네… 경치 좋은 곳이라면 가도 좋아"

msgid "adv_100324102_0006_msg"
msgstr "경치 좋은 곳이구나! 알겠어!\\r\\n…후훗"

msgid "adv_100324102_0007_msg"
msgstr "…뭐야?"

msgid "adv_100324102_0008_msg"
msgstr "아니. 미쿠모도 변했구나 싶어서"

msgid "adv_100324102_0009_msg"
msgstr "변했다… 내가?"

msgid "adv_100324102_0010_msg"
msgstr "나쁜 뜻이 아니야. 기뻐서 그래"

msgid "adv_100324102_0011_msg"
msgstr "좋아, 그럼 미쿠모를 멋진 곳에 데려가줘야겠네!"

msgid "adv_303401_0009_msg"
msgstr "여기예요, 알토 선배, 란카 씨!"

msgid "adv_303401_0010_msg"
msgstr "와아… 굉장해!\\r\\n이게 최신 소형 우주선이구나, 루카 군!"

msgid "adv_303401_0011_msg"
msgstr "네. L.A.I의 기술력을 총집결한\\r\\n신형 민간 항공우주선, 그 1호기입니다!"

msgid "adv_303401_0012_msg"
msgstr "민간기로서는 처음으로\\r\\n반자율형 무인기 2대를 동반 운용한다는 점에서도\\r\\n주목받고 있어요"

msgid "adv_303401_0013_msg"
msgstr "분명 루카가 그 무인기의\\r\\n개발 고문을 맡고 있지?"

msgid "adv_303401_0014_msg"
msgstr "요즘은 무슨 일만 생기면 출격했는데…\\r\\n정말 대단하네"

msgid "adv_303401_0015_msg"
msgstr "파일럿으로서의 일은 일.\\r\\n가업은 가업이니까요"

msgid "adv_303401_0016_msg"
msgstr "취미와 실익을 겸한다는 거지?"

msgid "adv_303401_0017_msg"
msgstr "아하하… 그것도 있죠"

msgid "adv_303401_0018_msg"
msgstr "그래서… 첫 공개 이벤트에서\\r\\n란카 일행의 힘을 빌리고 싶다는 얘기였지"

msgid "adv_303401_0019_msg"
msgstr "네, 맞아요!"

msgid "adv_303401_0020_msg"
msgstr "이 기체는 두 대의 동반기가 지켜주고 있다…\\r\\n라는 점을 란카 씨 일행의 힘으로\\r\\n어필해줬으면 해요"

msgid "adv_303401_0021_msg"
msgstr "저희 파일럿들은\\r\\n언제나 란카 씨 일행에게 보호받고 있으니까요"

msgid "adv_303401_0022_msg"
msgstr "그런 거였구나…\\r\\n알겠어, 루카 군!"

msgid "adv_303401_0023_msg"
msgstr "내가 다른 사람들에게도 연락해서\\r\\n무대 내용을 생각해볼게!"

msgid "adv_303401_0024_msg"
msgstr "부탁드립니다, 란카 씨!"

msgid "adv_303401_0027_msg"
msgstr "헤에. 민간 항공우주선이라…"

msgid "adv_303401_0028_msg"
msgstr "뭘 보고 있어? 히카루"

msgid "adv_303401_0029_msg"
msgstr "초시공 SNS야.\\r\\n란카 일행이 있는 시공에서 신형 우주선의\\r\\n첫 공개 이벤트를 한대"

msgid "adv_303401_0030_msg"
msgstr "헤에, 이게 우주선이야? 정말 멋있다!"

msgid "adv_303401_0031_msg"
msgstr "란카가 무대 내용을 생각하고 있는 모양이야.\\r\\n민메이, 도와주는 게 어때?"

msgid "adv_303401_0032_msg"
msgstr "그러네! 나도 란카를 도와주고 싶어"

msgid "adv_303401_0033_msg"
msgstr "…그런데 어떤 무대로 하면 좋을까?"

msgid "adv_303401_0034_msg"
msgstr "신형 우주선이니까…\\r\\n왠지 우주다운 느낌이 있으면 좋겠네"

msgid "adv_303401_0035_msg"
msgstr "우주다운 느낌이라… 으음"

msgid "adv_303401_0036_msg"
msgstr "…있잖아, 히카루!\\n지금부터 나를 발키리에 태워서\\n우주 공간으로 데려가주지 않을래?"

msgid "adv_303401_0037_msg"
msgstr "뭐어!? 아, 안 돼.\\r\\n얼마 전에도 널 발키리에 태워 데리고 나갔다가\\r\\n엄청 혼났잖아"

msgid "adv_303401_0038_msg"
msgstr "그렇구나. 으음…\\r\\n확실히 미사 씨한테 걱정 끼칠 순 없겠네…"

msgid "adv_303401_0039_msg"
msgstr "…맞다!\\r\\n평소에 우주 공간을 날아다니는 파일럿들에게\\r\\n얘기를 들어보는 건 어때?"

msgid "adv_303401_0040_msg"
msgstr "다들 비행에 익숙한 사람들이니까\\r\\n꽤 도움이 될 것 같은데"

msgid "adv_303401_0041_msg"
msgstr "그렇구나! 그거 좋네. 당장 가보자!"

msgid "adv_303402_0009_msg"
msgstr "민메이, 라이브 수고했어"

msgid "adv_303402_0010_msg"
msgstr "히카루! 보고 있었구나?"

msgid "adv_303402_0011_msg"
msgstr "물론이지.\\r\\n루카가 실시간으로 영상을 보내줬거든"

msgid "adv_303402_0012_msg"
msgstr "그나저나 놀랐어.\\r\\n정말 무중력 공간의 무대를 만들어낼 줄이야"

msgid "adv_303402_0013_msg"
msgstr "히카루가 말했잖아?\\r\\n우주다운 무대가 좋지 않겠냐고"

msgid "adv_303402_0014_msg"
msgstr "하야테 군과 맥스 씨가 말했던 『바람』의 이미지…\\r\\n안무로 잘 전해졌을까?"

msgid "adv_303402_0015_msg"
msgstr "응. 민메이와 란카의 춤이,\\r\\n발키리를 이미지한 거라는 게\\r\\n확실히 전해졌어"

msgid "adv_303402_0016_msg"
msgstr "후훗. 사실 그 뒤에 레이나한테 부탁해서\\r\\n하야테 군의 임멜만 댄스 영상을\\r\\n보내달라고 했거든"

msgid "adv_303402_0017_msg"
msgstr "그 움직임도 넣어봤더니 꽤 어렵더라"

msgid "adv_303402_0018_msg"
msgstr "하하. 확실히 하야테의 기체 움직임은\\r\\n나도 쉽게 따라 할 수 없으니까"

msgid "adv_303402_0019_msg"
msgstr "…하지만 무엇보다 대단하다고 생각한 건\\r\\n역시 둘이 호흡을 맞춘 콤비네이션이려나"

msgid "adv_303402_0020_msg"
msgstr "대단하네. 라이브까지 시간이 별로 없었는데"

msgid "adv_303402_0021_msg"
msgstr "정말? 그렇게 말해주니 기뻐!"

msgid "adv_303402_0022_msg"
msgstr "둘의 호흡이 딱 맞는 느낌은 꼭 보여주자고\\r\\n란카랑 정말 많이 연습했거든!"

msgid "adv_303402_0023_msg"
msgstr "왜냐하면…"

msgid "adv_303402_0024_msg"
msgstr "…! 앗, 출격 명령이다!"

msgid "adv_303402_0025_msg"
msgstr "미안, 민메이. 나 갈게"

msgid "adv_303402_0026_msg"
msgstr "기다려, 히카루!"

msgid "adv_303402_0027_msg"
msgstr ""

msgid "adv_303402_0028_msg"
msgstr "있잖아. 나랑 란카가\\r\\n호흡이 맞는 모습을 보여주고 싶었던 건…"

msgid "adv_303402_0029_msg"
msgstr "파일럿 모두가 호흡을 맞춰 싸우는 모습을\\r\\n표현하고 싶었기 때문이야"

msgid "adv_303402_0030_msg"
msgstr "호흡을 맞춰 싸우는 모습…?"

msgid "adv_303402_0031_msg"
msgstr "히카루와 카키자키 씨, 맥스 씨, 미리아 씨.\\r\\n바사라 씨와 밀레느, 알토 군을 비롯한 S.M.S 사람들.\\r\\n하야테 군과 미라쥬 씨…"

msgid "adv_303402_0032_msg"
msgstr "모두가 마음을 하나로 모아…\\n때로는 믿는 사람에게 등을 맡기면서\\n무언가를 필사적으로 지키려고 하고 있어…"

msgid "adv_303402_0033_msg"
msgstr "우주에서 펼쳐지는 그런 모습을\\r\\n우리 무대에서 재현하고 싶었어"

msgid "adv_303402_0034_msg"
msgstr "민메이…"

msgid "adv_303402_0035_msg"
msgstr "히카루… 조심해"

msgid "adv_303402_0036_msg"
msgstr "위험해지면 모두에게 의지해.\\r\\n나도 히카루를 노래로 지켜줄 테니까!"

msgid "adv_303402_0037_msg"
msgstr "…응, 알겠어.\\r\\n잘 부탁할게, 민메이!"

msgid "adv_303402_0038_msg"
msgstr "응!"

msgid "adv_000150_0004_msg"
msgstr "모두 모였네"

msgid "adv_000150_0005_msg"
msgstr "카나카나, 대체 무슨 일이야?\\r\\n갑자기 레슨룸에 집합이라니!"

msgid "adv_000150_0006_msg"
msgstr "긴급 상황?"

msgid "adv_000150_0007_msg"
msgstr "놀라게 해서 미안해"

msgid "adv_000150_0008_msg"
msgstr "최근 새의 인간의 공격이\\r\\n조금 잠잠해졌다는 건 알고 있지?"

msgid "adv_000150_0011_msg"
msgstr "그러고 보니 미라쥬 씨랑 하야테도\\r\\n그런 말을 했던 것 같아요"

msgid "adv_000150_0014_msg"
msgstr "하지만 아직 방심할 수 없는 상황이\\r\\n계속되고 있다는 건 변함없어"

msgid "adv_000150_0015_msg"
msgstr "응. 다음에 언제 전투가 격화될지도 모르니까…"

msgid "adv_000150_0016_msg"
msgstr "그래서 이 기간을 이용해서\\r\\n더욱 파워업하기 위해\\r\\n새로운 특훈을 해보려고 해"

msgid "adv_000150_0019_msg"
msgstr "새로운 특훈…?"

msgid "adv_000150_0020_msg"
msgstr "어떤 특훈인가요?"

msgid "adv_000150_0021_msg"
msgstr "후훗, 라이브야!"

msgid "adv_000150_0024_msg"
msgstr "어? 라이브라니… 그게 특훈이야?"

msgid "adv_000150_0025_msg"
msgstr "응. 우리는 다음 전투에 대비해서\\r\\n더욱 강해질 필요가 있어"

msgid "adv_000150_0026_msg"
msgstr "하지만 무작정 연습만 거듭한다고 해서\\r\\n강해지는 건 아니야…"

msgid "adv_000150_0027_msg"
msgstr "그렇구나. 그러니까 실전만이 답이라는 거야?"

msgid "adv_000150_0028_msg"
msgstr "물론 그것뿐만은 아니야"

msgid "adv_000150_0029_msg"
msgstr "프레이아, 우리를 강하게 해주는 건\\r\\n뭐라고 생각해?"

msgid "adv_000150_0030_msg"
msgstr "강하게 해주는 것…?"

msgid "adv_000150_0033_msg"
msgstr "…목소리, 아닐까"

msgid "adv_000150_0034_msg"
msgstr "우리 노래를 들어주는 사람들의 목소리"

msgid "adv_000150_0035_msg"
msgstr "역시 미쿠모네"

msgid "adv_000150_0036_msg"
msgstr "우리를 강하게 해주는 건\\r\\n역시 우리 노래를 들어준 사람들의 응원…"

msgid "adv_000150_0037_msg"
msgstr "맞아요! 우리를 응원해주는 목소리를 들으면,\\r\\n힘이 나기도 하고, 더더욱 열심히 해야지!\\r\\n하는 마음이 들어요!"

msgid "adv_000150_0038_msg"
msgstr "그래서 라이브를 더 많이 하면서, 더 많은 사람들에게\\r\\n우리 모습을 보여주려고 한 거야"

msgid "adv_000150_0039_msg"
msgstr "협력해줄래?"

msgid "adv_000150_0042_msg"
msgstr "물론이지! 라이브를 계속하면,\\r\\n우리 팀워크도 더 좋아질 거야"

msgid "adv_000150_0043_msg"
msgstr "저도 열심히 할게요!"

msgid "adv_000150_0046_msg"
msgstr "동의"

msgid "adv_000150_0049_msg"
msgstr "새로운 도전… 나쁘지 않아"

msgid "adv_000150_0050_msg"
msgstr "다들 고마워. 앞으로 닥칠 싸움에 대비해서\\r\\n우리 노래의 힘을 더욱 갈고닦자!"

msgid "adv_103801_0009_msg"
msgstr "프레이아!"

msgid "adv_103801_0010_msg"
msgstr "으음… 어떻게 하면 좋을까요…"

msgid "adv_103801_0011_msg"
msgstr "있잖아, 프레이아!"

msgid "adv_103801_0012_msg"
msgstr "미, 밀레느 씨!"

msgid "adv_103801_0013_msg"
msgstr "무슨 일이야?\\r\\n아까부터 뭔가 고민하고 있는 것 같은데…"

msgid "adv_103801_0014_msg"
msgstr "밀레느 씨… 도와주실 수 있나요!?"

msgid "adv_103801_0015_msg"
msgstr "뭐어!?"

msgid "adv_103801_0018_msg"
msgstr "그래서… 대체 무슨 일인데?"

msgid "adv_103801_0019_msg"
msgstr "이번에 초시공 네트워크 모두가\\r\\n투어를 하잖아요…"

msgid "adv_103801_0020_msg"
msgstr "아, 「고마워 투어」 말이지!"

msgid "adv_103801_0021_msg"
msgstr "은하의 모두에게 감사의 마음을 전한다니,\\r\\n정말 멋지잖아!"

msgid "adv_103801_0022_msg"
msgstr "민메이 씨와 왈큐레, 셰릴과 란카\\r\\n그리고 우리 Fire Bomber…"

msgid "adv_103801_0023_msg"
msgstr "시공을 넘어 모두 한자리에 모이는 라이브 투어라니\\n좀처럼 없는 일이야!"

msgid "adv_103801_0024_msg"
msgstr "네엣…"

msgid "adv_103801_0025_msg"
msgstr "아, 그렇구나… 왈큐레가 고마워 투어의\\r\\n첫 주자니까"

msgid "adv_103801_0026_msg"
msgstr "혹시 그것 때문에 긴장한 거야?"

msgid "adv_103801_0027_msg"
msgstr "긴장한 건 아닌데요,\\r\\n어떤 곡을 부를지 전혀 못 정하겠어요!"

msgid "adv_103801_0028_msg"
msgstr "흐음… 카나메나 마키나한테도 상담해봤어?"

msgid "adv_103801_0029_msg"
msgstr "그게… 「이번에는 프레이아가 생각해봐」\\n라고 하셔서요"

msgid "adv_103801_0030_msg"
msgstr "으음… 좋아, 알겠어!\\r\\n나도 같이 생각해줄게!"

msgid "adv_103801_0031_msg"
msgstr "정말인가요!?"

msgid "adv_103801_0032_msg"
msgstr "응, 곤란해하는 프레이아를 그냥 둘 순 없지"

msgid "adv_103801_0033_msg"
msgstr "그렇게 정했으면 장소를 옮기자!"

msgid "adv_103801_0034_msg"
msgstr "네엣!"

msgid "adv_103802_0009_msg"
msgstr "프레이아! 첫 주자 수고했어!"

msgid "adv_103802_0010_msg"
msgstr "정말 멋있었어! 완벽했네!"

msgid "adv_103802_0011_msg"
msgstr "감사합니다!\\r\\n상담에 응해주신 밀레느 씨 덕분이에요!"

msgid "adv_103802_0012_msg"
msgstr "그렇지 않아!"

msgid "adv_103802_0013_msg"
msgstr "게다가 나도 왠지 즐거웠어!\\r\\n같이 곡을 생각하기도 하고…"

msgid "adv_103802_0014_msg"
msgstr "그게, 나이 비슷한 애랑 그런… 연애 얘기를\\r\\n할 기회가 별로 없거든"

msgid "adv_103802_0015_msg"
msgstr "저도 진짜 즐거웠어요!"

msgid "adv_103802_0016_msg"
msgstr "뭐, 그 뒤에 레이나한테\\n이것저것 캐물어서 힘들긴 했지만…"

msgid "adv_103802_0017_msg"
msgstr "좋겠다, 나도 언젠가 프레이아 같은\\r\\n사랑을 해보고 싶네…"

msgid "adv_103802_0018_msg"
msgstr "저, 저는 딱히 사랑 같은 게 아니에요!!"

msgid "adv_103802_0019_msg"
msgstr "그래그래, 그런 걸로 해줄게"

msgid "adv_103802_0020_msg"
msgstr "좋아, 나도 이러고 있을 때가 아니네!"

msgid "adv_103802_0021_msg"
msgstr "왈큐레 모두가\\r\\n모처럼 분위기를 한껏 띄워줬잖아"

msgid "adv_103802_0022_msg"
msgstr "다음은 우리 Fire Bomber가 달아오르게 할 차례야!"

msgid "adv_103802_0023_msg"
msgstr "오오!"

msgid "adv_103802_0024_msg"
msgstr "프레이아, 기대하고 있어!"

msgid "adv_103802_0025_msg"
msgstr "네엣!"

msgid "adv_100331301_0004_msg"
msgstr "있잖아, 미쿠모는 뭐 할 때가 제일 즐거워?"

msgid "adv_100331301_0005_msg"
msgstr "글쎄. 즐겁다…고 해도 되는지는\\r\\n모르겠지만"

msgid "adv_100331301_0006_msg"
msgstr "나는 언제 어디서든 『노래하고 싶다』고…\\r\\n그저 그렇게 생각해"

msgid "adv_100331301_0007_msg"
msgstr "그렇구나, 미쿠모는 노래할 때가 제일 즐겁다는 거네!"

msgid "adv_100331301_0008_msg"
msgstr "즐겁다고 느끼지 않는다면, 언제 어디서든\\r\\n노래하고 싶다는 생각은 안 들 테니까!"

msgid "adv_100331301_0009_msg"
msgstr "알려줘서 고마워, 밀레느.\\r\\n너와 이야기하면 새로운 걸 배울 수 있어"

msgid "adv_100331301_0010_msg"
msgstr "그래? 잘 모르겠지만… 미쿠모한테 도움이 됐다면,\\r\\n다행이네! 후후훗"

msgid "adv_100331302_0004_msg"
msgstr "밀레느 씨, 들어주세요!\\r\\n하야테가 제 웃음소리를 『기분 나쁘다』고 했어요!"

msgid "adv_100331302_0005_msg"
msgstr "앗. 그거 나도 바사라한테 들은 적 있어!\\r\\n그냥 뭔가 생각나서 웃었을 뿐인데!"

msgid "adv_100331302_0006_msg"
msgstr "하야테도 바사라도 정말 섬세함이 없다니까.\\r\\n여자애한테 할 말이 아니잖아, 정말…"

msgid "adv_100331302_0007_msg"
msgstr "으… 으으으으~……"

msgid "adv_100331302_0008_msg"
msgstr "어, 프레이아, 왜 그래!? 갑자기 울고…"

msgid "adv_100331302_0009_msg"
msgstr "죄송해요… 제 마음을 알아주는 사람이 있다고 생각하니까\\n갑자기 눈물이 왈칵 쏟아져서…"

msgid "adv_100331302_0010_msg"
msgstr "어이쿠… 이, 일단 콧물부터 닦자… 응?"

msgid "adv_1400101_0009_msg"
msgstr "잠깐, 바사라 진심이야!?"

msgid "adv_1400101_0010_msg"
msgstr "몇 번이나 말하게 하지 마. 그렇다고 했잖아?"

msgid "adv_1400101_0011_msg"
msgstr "…아무튼 난 할 거야"

msgid "adv_1400101_0012_msg"
msgstr "바사라도 참! …정말~……"

msgid "adv_1400101_0015_msg"
msgstr "바사라, 밀레느!\\r\\n…근데 왜 그래? 또 싸워?"

msgid "adv_1400101_0016_msg"
msgstr "미안해, 셰릴. 이상한 모습 보여줘서"

msgid "adv_1400101_0017_msg"
msgstr "난 괜찮아.\\r\\n그런데… 이번 싸움은 뭐 때문에 그래?"

msgid "adv_1400101_0018_msg"
msgstr "바사라가 말귀를 못 알아듣는 게 문제야!"

msgid "adv_1400101_0019_msg"
msgstr "지금 우리가 있는 곳은\\r\\n『비의 행성』이라고 불릴 정도로\\r\\n일 년 내내 비가 많이 오는 곳인데…"

msgid "adv_1400101_0020_msg"
msgstr "바사라는 이런 곳에서도\\r\\n야외 무대에서 하겠다고 우긴다니까!"

msgid "adv_1400101_0021_msg"
msgstr "야외에서? 왜 그러는 걸까…"

msgid "adv_1400101_0022_msg"
msgstr "내가 물어봐도 『너한텐 말해도 몰라』라고\\r\\n하면서 안 알려줘"

msgid "adv_1400101_0023_msg"
msgstr "난 절대 반대야! 다들 감기 걸릴 거고\\r\\n상황에 따라선 중지해야 할 수도 있잖아?"

msgid "adv_1400101_0024_msg"
msgstr "난 이번 고마워 투어를\\r\\n무조건 성공시키고 싶어.\\r\\n모두에게 『고마워』를 전하는 것도 물론이지만…"

msgid "adv_1400101_0025_msg"
msgstr "앞으로도 모두를 우리가 지킬 거라고…\\r\\n새의 인간 따위 무섭지 않다고, 그걸 전하고 싶어!"

msgid "adv_1400101_0026_msg"
msgstr "그렇구나… 그러네…"

msgid "adv_1400101_0029_msg"
msgstr "바사라"

msgid "adv_1400101_0030_msg"
msgstr "밀레느가 시켜서 말리러 온 거야?"

msgid "adv_1400101_0031_msg"
msgstr "아니야. 그냥 네 생각을 좀 듣고 싶어서"

msgid "adv_1400101_0032_msg"
msgstr "밀레느, 삐쳐 있었어.\\r\\n너한텐 말해도 모른다는 소리 들었다고"

msgid "adv_1400101_0033_msg"
msgstr "이유를 제대로 말해주는 게 어때?"

msgid "adv_1400101_0034_msg"
msgstr ""

msgid "adv_1400101_0035_msg"
msgstr ""

msgid "adv_1400101_0036_msg"
msgstr "내 노래로 비 따위 멈춰주겠어"

msgid "adv_1400101_0037_msg"
msgstr "아무리 오랫동안 비가 내려서 기분이 우울해져도\\r\\n그치지 않는 비는 없다는 걸 알려주고 싶어"

msgid "adv_1400101_0038_msg"
msgstr "바사라…"

msgid "adv_1400101_0039_msg"
msgstr "…후훗!"

msgid "adv_1400101_0040_msg"
msgstr "뭐야"

msgid "adv_1400101_0041_msg"
msgstr "아니, 이상한 뜻은 아니야.\\r\\n너답다고 생각했을 뿐이야"

msgid "adv_1400101_0042_msg"
msgstr "그치지 않는 비는 없어. 맞는 말이야"

msgid "adv_1400101_0043_msg"
msgstr "…너의 그런 모습에\\r\\n힘을 얻는 사람은 분명 많이 있을 거야"

msgid "adv_1400101_0044_msg"
msgstr "나도 그중 한 명일지도 모르고, 말이야?"

msgid "adv_1400101_0045_msg"
msgstr "…무슨 뜻이야?"

msgid "adv_1400101_0046_msg"
msgstr "아무것도 아니야! 라이브, 기대하고 있을게!"

msgid "adv_1400101_0047_msg"
msgstr "흥. 맡겨둬!"

msgid "adv_1400101_0048_msg"
msgstr "기다려라, 비의 행성.\\r\\n최고로 맑은 날씨로 만들어주겠어!"

msgid "adv_1400102_0009_msg"
msgstr ""

msgid "adv_1400102_0010_msg"
msgstr "바사라. 라이브, 수고했어"

msgid "adv_1400102_0011_msg"
msgstr "…어"

msgid "adv_1400102_0012_msg"
msgstr "어머? 기운이 없네"

msgid "adv_1400102_0013_msg"
msgstr "무슨 일 있어?\\r\\n라이브가 끝난 무대에서 여운에 잠겨 있었던…\\r\\n그런 것만은 아닌 것 같은데"

msgid "adv_1400102_0014_msg"
msgstr ""

msgid "adv_1400102_0015_msg"
msgstr "비를 멈추려고\\r\\n외치고, 외치고, 외치고, 계속 외치다 보니까…"

msgid "adv_1400102_0016_msg"
msgstr "온갖 기억이 밀려들어왔어.\\r\\n전에 봤던 것도, 처음 보는 것도\\r\\n잔뜩"

msgid "adv_1400102_0017_msg"
msgstr "기억…? 그건…"

msgid "adv_1400102_0018_msg"
msgstr "그래. 또 새의 인간 영향이겠지"

msgid "adv_1400102_0019_msg"
msgstr "바사라…"

msgid "adv_1400102_0020_msg"
msgstr "뭐, 나랑은 상관없어.\\r\\n무슨 일이 일어나든 난 노래할 뿐이야"

msgid "adv_1400102_0021_msg"
msgstr "그렇게 말할 줄 알았어"

msgid "adv_1400102_0022_msg"
msgstr "…그나저나 완전히 맑아졌네!\\r\\n여름비가 그친 뒤라 그런지 정말 상쾌해"

msgid "adv_1400102_0023_msg"
msgstr "그러게. …에취!"

msgid "adv_1400102_0024_msg"
msgstr "후훗. 몸 식지 않게 조심해"

msgid "adv_1400102_0025_msg"
msgstr "밀레느가 정말 걱정했어"

msgid "adv_1400102_0026_msg"
msgstr "쓸데없는 참견이야"

msgid "adv_1400102_0027_msg"
msgstr "그래그래.\\r\\n그럼 이다음은 내 라이브니까.\\r\\n다녀올게!"

msgid "adv_1400102_0028_msg"
msgstr "나도 너한테 질 수는 없지.\\r\\n비를 멈출 정도로\\r\\n최고의 라이브를 보여줄 테니까!"

msgid "adv_1400102_0029_msg"
msgstr "그래. 힘내"

msgid "adv_1400102_0030_msg"
msgstr "응! 그럼 이따 봐!"

msgid "adv_1400102_0033_msg"
msgstr "아~! 바사라, 여기 있었구나!"

msgid "adv_1400102_0034_msg"
msgstr "뭐야"

msgid "adv_1400102_0035_msg"
msgstr "레이가 부르던데!\\r\\n오늘 라이브 뒤풀이 한대!"

msgid "adv_1400102_0036_msg"
msgstr "마음대로 해"

msgid "adv_1400102_0037_msg"
msgstr "후훗! 말 안 해도 마음대로 할 거거든~!\\r\\n자, 가자 바사라!"

msgid "adv_1400102_0038_msg"
msgstr "야…"

msgid "adv_1400102_0039_msg"
msgstr "아, 맞다! 프레이아랑 민메이 씨한테도\\r\\n나중에 말해줘야겠다!"

msgid "adv_1400102_0040_msg"
msgstr "그 둘의 라이브도 이제 곧이잖아!"

msgid "adv_1400102_0041_msg"
msgstr "…정말"

msgid "adv_103901_0009_msg"
msgstr "민메이 씨!\\n고마워 투어도 이제 슬슬 막바지네요!"

msgid "adv_103901_0010_msg"
msgstr "프레이아!"

msgid "adv_103901_0011_msg"
msgstr "…그런데 손에 들고 있는 꽃다발은 뭐예요?"

msgid "adv_103901_0012_msg"
msgstr "후훗. 귀엽지?\\n아까 어린 여자애한테 받았어. 직접 만들었대!"

msgid "adv_103901_0013_msg"
msgstr "직접 만든 부케! 좋네요~!"

msgid "adv_103901_0014_msg"
msgstr "메시지 카드도 있어.\\n열심히 써준 모양이야"

msgid "adv_103901_0015_msg"
msgstr "어디 보자, 뭐라고 썼지…?\\n『민메이, 언제나 멋진 노래를 불러줘서 고마워』…"

msgid "adv_103901_0016_msg"
msgstr "『크면 민메이 같은\\n가수가 되고 싶어요』…라"

msgid "adv_103901_0017_msg"
msgstr "후훗. 이 아이, 어릴 때의 저 같네요…"

msgid "adv_103901_0018_msg"
msgstr "그래?"

msgid "adv_103901_0019_msg"
msgstr "네엣! 저도 어릴 때,\\n여러 사람의 노래를 들으면서 자랐어요!"

msgid "adv_103901_0020_msg"
msgstr "윈더미어에 왔던 지구인에게\\n바깥 세상의 음악을 알게 됐는데…"

msgid "adv_103901_0021_msg"
msgstr "그중에 민메이 씨 노래도 있었어요!"

msgid "adv_103901_0022_msg"
msgstr "민메이 씨 노래는 진짜 따뜻하고\\n감싸주는 것처럼 다정해서"

msgid "adv_103901_0023_msg"
msgstr "외로운 기분이 들 때 자주 불렀어요!\\n…그때는 슬픈 일이 계속됐었거든요"

msgid "adv_103901_0024_msg"
msgstr "…그랬구나"

msgid "adv_103901_0025_msg"
msgstr "민메이 씨는 정말 대단해요!\\n은하의 모두가 동경하는 사람이에요!"

msgid "adv_103901_0026_msg"
msgstr "동경이라니, 그런… 나도 매일\\n프레이아한테서 힘을 받고 있는데"

msgid "adv_103901_0027_msg"
msgstr "지금은 초시공 네트워크를 통해 만나게 된\\n소중한 동료지만…"

msgid "adv_103901_0028_msg"
msgstr "바사라 씨나 셰릴 씨, 란카 씨…\\n다른 분들에게도 민메이 씨의 노래는\\n언제까지나 특별할 거라고 생각해요!"

msgid "adv_103901_0029_msg"
msgstr "그래서 저 계속 생각했어요.\\n이번 『고마워 투어』는 팬들뿐만 아니라…"

msgid "adv_103901_0030_msg"
msgstr "민메이 씨에게도 뭔가 보답하고 싶다고요!"

msgid "adv_103901_0031_msg"
msgstr "나한테?"

msgid "adv_103901_0032_msg"
msgstr "네엣! 그러니까 기대해주세요!"

msgid "adv_103901_0033_msg"
msgstr "그 부케만큼 좋을지는 모르겠지만…\\n분명, 분명 좋아해주실 거예요!"

msgid "adv_103901_0034_msg"
msgstr "프레이아…"

msgid "adv_103901_0035_msg"
msgstr "…알겠어. 기대하고 있을게!"

msgid "adv_103902_0010_msg"
msgstr "후훗. 그나저나…"

msgid "adv_103902_0011_msg"
msgstr "그 편지 덕분에 프레이아와 란카,\\r\\n둘이 처음 무대에 섰던 날 이야기를\\r\\n들을 수 있어서 좋았어!"

msgid "adv_103902_0012_msg"
msgstr "니히히… 편지에 쓰는 건\\r\\n솔직히 조금 부끄러웠어요"

msgid "adv_103902_0013_msg"
msgstr "저, 엄청 크게 넘어졌었거든요…"

msgid "adv_103902_0014_msg"
msgstr "저도 마이크에 이마를 세게 부딪혔다는\\r\\n이야기라서 왠지 부끄럽네요…"

msgid "adv_103902_0015_msg"
msgstr "부끄러워할 필요 없어.\\r\\n나도 무대에서 실수를 정말 많이 했는걸"

msgid "adv_103902_0016_msg"
msgstr "그때의 내가 있었기에 지금의 내가 있는 거야…\\r\\n그러니까 란카와 프레이아도\\r\\n좀 더 자신감을 가져!"

msgid "adv_103902_0017_msg"
msgstr "그렇구나… 그러네요!"

msgid "adv_103902_0018_msg"
msgstr "후훗.\\r\\n민메이 씨, 오늘은 왠지 정말 생기 넘쳐 보여요"

msgid "adv_103902_0019_msg"
msgstr "저도 그렇게 생각해요!\\r\\n오늘 민메이 씨는 평소보다 더 기운 팍팍이에요!"

msgid "adv_103902_0020_msg"
msgstr "고마워.\\r\\n하지만 그렇다면 모두 덕분이야!"

msgid "adv_103902_0021_msg"
msgstr "나, 좀 더 나 자신을 믿어야겠어"

msgid "adv_103902_0022_msg"
msgstr "앞으로도 이 은하에 수많은 노랫소리를\\r\\n이어가기 위해서!"

msgid "adv_103902_0023_msg"
msgstr "오오~!"

msgid "adv_103902_0024_msg"
msgstr "멋있어요! 민메이 씨!"

msgid "adv_103902_0025_msg"
msgstr "어라? 조금 거창했으려나?"

msgid "adv_103902_0026_msg"
msgstr "그렇지 않아요!"

msgid "adv_103902_0027_msg"
msgstr "후훗. 고마워"

msgid "adv_103902_0028_msg"
msgstr "아직 부족한 나지만…\\r\\n이런 나와 함께 노래해주는 모두가 있어서\\r\\n정말 다행이라고 생각해"

msgid "adv_103902_0029_msg"
msgstr "나와 만나줘서 고마워.\\r\\n프레이아, 란카.\\r\\n앞으로도 잘 부탁해"

msgid "adv_103902_0030_msg"
msgstr "저야말로 감사합니다!"

msgid "adv_103902_0031_msg"
msgstr "감사합니다, 민메이 씨!"

msgid "adv_103902_0032_msg"
msgstr "…요즘 자주 듣게 되네,\\r\\n『고마워』라는 말"

msgid "adv_103902_0033_msg"
msgstr "당연하죠, 민메이 씨!"

msgid "adv_103902_0034_msg"
msgstr "왜냐하면 우리는 지금\\r\\n『고마워 투어』 한창이니까요!"

msgid "adv_103902_0035_msg"
msgstr "그랬지!"

msgid "adv_103902_0036_msg"
msgstr "이히히! 다음은 마키나 씨랑 레이나 씨 무대예요!\\r\\n민메이 씨, 가요!"

msgid "adv_103902_0037_msg"
msgstr "응!"

msgid "adv_100339701_0004_msg"
msgstr "있잖아, 프레이아. 하나 물어봐도 될까?\\r\\n프레이아가 태어난 별은 어떤 곳이야?"

msgid "adv_100339701_0005_msg"
msgstr "윈더미어라는 별인데…\\r\\n눈으로 새하얀 별이에요!"

msgid "adv_100339701_0006_msg"
msgstr "눈…? 그럼 춥겠네"

msgid "adv_100339701_0007_msg"
msgstr "그야 정말 엄청 추운 곳이죠!\\r\\n하지만 그렇게 혹독한 별이기 때문에\\n다 같이 힘을 합쳐 살아가고 있어요"

msgid "adv_100339701_0008_msg"
msgstr "그리고 사과가 특산물이라 맛있어요!\\r\\n언젠가 셰릴 씨도 꼭 드셔보셨으면 좋겠어요!"

msgid "adv_100339701_0009_msg"
msgstr "윈더미어 풍경도 분명 마음에 드실 거라고\\r\\n생각해요"

msgid "adv_100339701_0010_msg"
msgstr "후훗, 정말 멋진 곳인가 보네.\\r\\n언젠가 가보고 싶어"

msgid "adv_100339702_0004_msg"
msgstr "란카 씨 머리는 역시 신기하네요…\\r\\n쫑긋 움직여서 귀여워요!"

msgid "adv_100339702_0005_msg"
msgstr "정말? 고마워!"

msgid "adv_100339702_0006_msg"
msgstr "프레이아 머리도 귀여워!\\n프레이아가 춤추면 살랑살랑 움직여서,\\r\\n보고 있으면 기운이 난다고 해야 하나…"

msgid "adv_100339702_0007_msg"
msgstr "정말이에요!? 감사합니다!"

msgid "adv_100339702_0008_msg"
msgstr "맞다! 다음에 우리 머리 모양 맞춰봐도 될까?"

msgid "adv_100339702_0009_msg"
msgstr "오오, 좋네요! 나이스 아이디어예요!"

msgid "adv_100340901_0004_msg"
msgstr "오늘 라이브 좋았어. 최고로 뜨거운 라이브였어"

msgid "adv_100340901_0005_msg"
msgstr "정말인가요? 감사합니다!\\r\\n바사라 씨한테 그런 말을 들으니 기뻐요"

msgid "adv_100340901_0006_msg"
msgstr "기뻐? 그런 건가?"

msgid "adv_100340901_0007_msg"
msgstr "네! Fire Bomber 여러분께\\r\\n폐 끼치지 않으려고 했거든요"

msgid "adv_100340901_0008_msg"
msgstr "어려운 생각 할 필요 없잖아.\\r\\n부르고 싶은 대로 부르면 돼"

msgid "adv_100340901_0009_msg"
msgstr "부르고 싶은 대로 부른다?\\n후훗, 바사라 씨답네요!"

msgid "adv_100340901_0010_msg"
msgstr "세트리스트에도 아무것에도 얽매이지 않는 라이브,\\r\\n정말 자극적이었어요! 다음에 또 불러주세요!"

msgid "adv_100340901_0011_msg"
msgstr "그래! 또 뜨거운 노래를 울려 퍼뜨리자!"

msgid "adv_100340902_0004_msg"
msgstr "밀레느의 『린 민메이 이야기』, 몇 번이나 다시 보게 돼!\\r\\n정말 잘하더라!"

msgid "adv_100340902_0005_msg"
msgstr "에에~!? 봐주시는 건 기쁘지만,\\r\\n왠지 쑥스럽기도 하고…"

msgid "adv_100340902_0006_msg"
msgstr "왜? 히카루 역의 바사라 씨도 정말 멋졌어"

msgid "adv_100340902_0007_msg"
msgstr "바사라는 연기한 게 아니라,\\r\\n그냥 자기 하고 싶은 대로 한 것뿐이에요…\\r\\n정말이지! 바사라도 참!"

msgid "adv_100340902_0008_msg"
msgstr "그나저나 역시 내 이야기가 드라마가 된다는 건,\\r\\n묘한 기분이 들어…"

msgid "adv_100340902_0009_msg"
msgstr "이상할 거 없어요! 드라마가 될 정도로,\\r\\n민메이 씨가 대단한 사람이라는 뜻이에요!"

msgid "adv_100340902_0010_msg"
msgstr "그렇진 않은 것 같은데…\\r\\n그래도 고마워, 밀레느!"

msgid "adv_303501_0009_msg"
msgstr "여러 행성을 도는 『고마워 투어』,\\r\\n정말 좋은 투어가 되고 있네!"

msgid "adv_303501_0010_msg"
msgstr "그러네. 이런 것도 나쁘지 않아"

msgid "adv_303501_0011_msg"
msgstr "시공을 넘어 많은 사람들에게\\r\\n노래를 전할 수 있어서 정말 기뻤어요!"

msgid "adv_303501_0013_msg"
msgstr "응응! 더, 더 많이 노래하고 싶어지지"

msgid "adv_303501_0014_msg"
msgstr "아… 맞다, 이것 좀 봐!\\r\\n투어 중에 찍은 이미지 데이터, 엄청 많아!"

msgid "adv_303501_0015_msg"
msgstr "오오~! 보물 같은 사진이 잔뜩이네요!"

msgid "adv_303501_0016_msg"
msgstr "그치, 그치~!"

msgid "adv_303501_0018_msg"
msgstr ""

msgid "adv_303501_0019_msg"
msgstr "레이나, 왜 그래?"

msgid "adv_303501_0020_msg"
msgstr "…잠깐 생각 중"

msgid "adv_303501_0021_msg"
msgstr "레이레이?"

msgid "adv_303501_0022_msg"
msgstr "이번 투어를 통해 여러 사람들의\\r\\n『고마워』를 봐왔어"

msgid "adv_303501_0023_msg"
msgstr "…그래서 나도 고맙다고 말하고 싶은 사람을 생각하고 있었어"

msgid "adv_303501_0024_msg"
msgstr "후훗, 그랬구나"

msgid "adv_303501_0026_msg"
msgstr "레이나 씨는 누구한테 고맙다고 말하고 싶어요?"

msgid "adv_303501_0027_msg"
msgstr "셰릴, 란카, 바사라, 밀레느, 민메이…\\r\\n델타 소대 모두…"

msgid "adv_303501_0028_msg"
msgstr "하지만 역시 제일은 왈큐레"

msgid "adv_303501_0029_msg"
msgstr "레이레이…"

msgid "adv_303501_0030_msg"
msgstr "왈큐레를 만나서 여러 가지를 알게 됐으니까"

msgid "adv_303501_0032_msg"
msgstr "레이나 마음, 정말 잘 알아.\\r\\n나도 똑같은 마음이니까"

msgid "adv_303501_0033_msg"
msgstr "응! 맞아!"

msgid "adv_303501_0035_msg"
msgstr "저도요!"

msgid "adv_303501_0037_msg"
msgstr "…그러네"

msgid "adv_303501_0038_msg"
msgstr "…자, 슬슬 투어의 마지막 무대가 시작돼.\\r\\n다들 준비하자!"

msgid "adv_303501_0040_msg"
msgstr "첫 주자는 마키나와 레이나!\\r\\n잘 부탁해!"

msgid "adv_303501_0042_msg"
msgstr "네네~ 맡겨줘!\\r\\n마음껏 분위기 띄워볼게!"

msgid "adv_303501_0043_msg"
msgstr "그렇지, 레이레이!"

msgid "adv_303501_0044_msg"
msgstr "당연"

msgid "adv_303502_0009_msg"
msgstr "『고마워 투어』 중에 찍은\\r\\n영상과 사진으로 추억 앨범을 만든다…"

msgid "adv_303502_0010_msg"
msgstr "마키나 아이디어, 정말 좋아"

msgid "adv_303502_0011_msg"
msgstr "이거라면 모두에게 특별한 고마움을\\r\\n전할 수 있을 것 같아"

msgid "adv_303502_0012_msg"
msgstr "다행이다~!"

msgid "adv_303502_0013_msg"
msgstr "이번에는 조금 긴 투어였으니까,\\r\\n여러 가지 추억이 있잖아?"

msgid "adv_303502_0014_msg"
msgstr "초시공 네트워크의 모두와도\\r\\n많이 노래했고…"

msgid "adv_303502_0015_msg"
msgstr "처음 가본 행성에서 새로운 만남도 있었지!"

msgid "adv_303502_0016_msg"
msgstr "그러니까 한데 모아보면\\r\\n분명 정말 즐거울 거라고 생각해!"

msgid "adv_303502_0017_msg"
msgstr "…응, 해보고 싶어"

msgid "adv_303502_0018_msg"
msgstr "마키나는… 어땠어?"

msgid "adv_303502_0019_msg"
msgstr "이번 『고마워 투어』"

msgid "adv_303502_0020_msg"
msgstr "나는… 으음, 글쎄"

msgid "adv_303502_0021_msg"
msgstr "나는 말이야, 이번 투어에서,\\r\\n은하의 모두에게 왈큐레를\\r\\n좀 더 잘 알게 해주고 싶었어!"

msgid "adv_303502_0022_msg"
msgstr "이번 투어를 통해 왈큐레의 매력을\\r\\n많이 전할 수 있어서 기뻤어"

msgid "adv_303502_0023_msg"
msgstr "응"

msgid "adv_303502_0024_msg"
msgstr "레이레이는 어땠어?"

msgid "adv_303502_0025_msg"
msgstr "자극적이었어. 아주 많이"

msgid "adv_303502_0026_msg"
msgstr "그렇구나…!"

msgid "adv_303502_0027_msg"
msgstr "앨범… 마키나도 기대해줘"

msgid "adv_303502_0028_msg"
msgstr "마키나한테도 『고마워』를 전하고 싶으니까"

msgid "adv_303502_0029_msg"
msgstr "응, 『고마워』 레이레이!\\r\\n기대하고 있을게!"

msgid "adv_104001_0009_msg"
msgstr "으음…"

msgid "adv_104001_0010_msg"
msgstr "아니야~!"

msgid "adv_104001_0011_msg"
msgstr "고민하고 있나 보네"

msgid "adv_104001_0012_msg"
msgstr "뭐야, 미쿠모였어? 언제부터 거기 있었던 거야"

msgid "adv_104001_0013_msg"
msgstr "네가 노래하기 시작할 때부터 계속"

msgid "adv_104001_0014_msg"
msgstr "끙끙거리다가 노래하다가를 반복하고 있는 것 같은데…\\r\\n뭔가 고민이라도 있어?"

msgid "adv_104001_0015_msg"
msgstr "…뭐, 그렇지"

msgid "adv_104001_0016_msg"
msgstr ""

msgid "adv_104001_0017_msg"
msgstr "생각해내려고 하는 거야.\\r\\n다른 시공에서 들었던 노래를"

msgid "adv_104001_0018_msg"
msgstr "다른 시공의…"

msgid "adv_104001_0019_msg"
msgstr "너, 또 다른 시공의 기억을 본 거구나"

msgid "adv_104001_0020_msg"
msgstr "지난번 라이브 도중에. 그 속에서 이 노래를 들었어"

msgid "adv_104001_0021_msg"
msgstr "다른 노래들은 기억나는데,\\r\\n이 노래만 띄엄띄엄 들려왔어"

msgid "adv_104001_0022_msg"
msgstr "그런데도 이상하게 가슴 깊이 꽂히더라고.\\r\\n그래서 완벽하게 떠올려서 끝까지 부르고 싶어"

msgid "adv_104001_0023_msg"
msgstr "헤에…"

msgid "adv_104001_0024_msg"
msgstr "그런데 아무리 해도 딱 맞지 않는 파트가 있어…"

msgid "adv_104001_0025_msg"
msgstr "내가 생각할 법한 멜로디나 프레이즈를\\r\\n적당히 넣어봐도 전부 달라"

msgid "adv_104001_0026_msg"
msgstr "그렇구나. 그래서 고민하고 있었던 거네"

msgid "adv_104001_0027_msg"
msgstr "…뭐, 고민만 해봐야 소용없나"

msgid "adv_104001_0028_msg"
msgstr "어쩔 생각이야?"

msgid "adv_104001_0029_msg"
msgstr "일단 이 노래는 잠시 접어두고 내 노래를 부를 거야.\\r\\n노래하다 보면 또 기억을 볼 수도 있으니까"

msgid "adv_104001_0030_msg"
msgstr "그래도 생각나지 않으면?"

msgid "adv_104001_0031_msg"
msgstr "생각날 때까지 노래할 뿐이야!"

msgid "adv_104001_0032_msg"
msgstr "후훗. 너답네"

msgid "adv_104001_0033_msg"
msgstr "좋아, 나도 도와줄게.\\r\\n같이 네 노래를 부르자"

msgid "adv_104001_0034_msg"
msgstr "아니. 미쿠모는 미쿠모 노래를 불러"

msgid "adv_104001_0035_msg"
msgstr "…내 노래를?"

msgid "adv_104001_0036_msg"
msgstr "그래"

msgid "adv_104001_0037_msg"
msgstr ""

msgid "adv_104001_0038_msg"
msgstr "그렇구나… 둘이 동시에 서로 다른 노래를 부른다…는 거네"

msgid "adv_104001_0039_msg"
msgstr "해보는 건 상관없지만,\\r\\n정말 괜찮겠어?"

msgid "adv_104001_0040_msg"
msgstr "노래할 거라면 전력으로 부를 거야, 난"

msgid "adv_104001_0041_msg"
msgstr "헤에. 제법 말하는데!\\r\\n그럼 나도 전력으로 받아줄 뿐이지"

msgid "adv_104001_0042_msg"
msgstr "후훗… 재미있어질 것 같네"

msgid "adv_104002_0010_msg"
msgstr "…좋아, 이 정도면 됐네"

msgid "adv_104002_0011_msg"
msgstr "…어머?"

msgid "adv_104002_0012_msg"
msgstr "바사라. 그 노래, 완성했구나?"

msgid "adv_104002_0013_msg"
msgstr "그래. 전부 생각났어"

msgid "adv_104002_0014_msg"
msgstr "너랑 서로 노래하고, 셰릴과도 서로 노래하고.\\r\\n너희 노래에 날아가버릴 것 같으면서도,\\r\\n나도 내 노래를 부르고…"

msgid "adv_104002_0015_msg"
msgstr "그랬더니 선명하게 보이기 시작했어.\\r\\n그 다른 시공의 기억이"

msgid "adv_104002_0016_msg"
msgstr "어쩐지 나 혼자 불러서는\\r\\n완성될 리가 없더라"

msgid "adv_104002_0017_msg"
msgstr "무슨 뜻이야?"

msgid "adv_104002_0018_msg"
msgstr "미쿠모. 같이 이 노래 불러줘"

msgid "adv_104002_0019_msg"
msgstr "네 노랫소리라면 딱 맞을 것 같아"

msgid "adv_104002_0020_msg"
msgstr "…흐응"

msgid "adv_104002_0021_msg"
msgstr "그렇구나. 그런 거였네"

msgid "adv_104002_0022_msg"
msgstr "알겠어. 내가 대신할 수 있다면"

msgid "adv_104002_0023_msg"
msgstr "그래. 이왕 할 거면 전력으로 덤벼줘.\\r\\n지난번 라이브 때처럼 말이야"

msgid "adv_104002_0024_msg"
msgstr "바라던 바야"

msgid "adv_104002_0027_msg"
msgstr "바사라! 들었어, 미쿠모랑 듀엣한 거!"

msgid "adv_104002_0028_msg"
msgstr "좋겠다! 나도 부르고 싶어!"

msgid "adv_104002_0029_msg"
msgstr "너한텐 아직 일러"

msgid "adv_104002_0030_msg"
msgstr "뭐야 그게~!"

msgid "adv_104002_0031_msg"
msgstr "…어라? 언니한테 전화다"

msgid "adv_104002_0032_msg"
msgstr "언니?"

msgid "adv_104002_0033_msg"
msgstr "응. 지금은 다른 행성에 살고 있지만"

msgid "adv_104002_0034_msg"
msgstr "여보세요, 언니? 오랜만이야!\\r\\n잘 지내?"

msgid "adv_104002_0035_msg"
msgstr "응! 아빠도 엄마도 잘 지내.\\r\\n있잖아, 다음에 그쪽 행성에 놀러 가도 돼?"

msgid "adv_104002_0036_msg"
msgstr ""

msgid "adv_104002_0037_msg"
msgstr "밀레느"

msgid "adv_104002_0038_msg"
msgstr "뭐야. 나 지금 통화 중이거든?"

msgid "adv_104002_0039_msg"
msgstr "그 녀석한테 전해줘"

msgid "adv_104002_0040_msg"
msgstr "다음에 또 같이 노래하자…고"

msgid "adv_104002_0041_msg"
msgstr ""

msgid "adv_104002_0043_msg"
msgstr "…이상한 바사라"

msgid "adv_100348101_0004_msg"
msgstr "바사라! 잠깐, 아무리 그래도 쉬지도 않고\\r\\n너무 많이 노래하는 거 아니야?"

msgid "adv_100348101_0005_msg"
msgstr "뭐? 상관없잖아.\\r\\n난 노래하고 싶을 때 부르고 싶은 만큼 부를 거야"

msgid "adv_100348101_0006_msg"
msgstr "휴식도 중요해. 너무 무리해서\\r\\n목소리가 안 나오기라도 하면 어쩌려고?"

msgid "adv_100348101_0007_msg"
msgstr "그럴 리가 있냐"

msgid "adv_100348101_0008_msg"
msgstr "만약을 말하는 거야! …하아, 뭐 됐어.\\r\\n만약 그렇게 되면 내가 바사라 대신 노래해줄게!"

msgid "adv_100348101_0009_msg"
msgstr "흥, 네가 내 대신을 할 수 있을 리가 없지"

msgid "adv_100348101_0010_msg"
msgstr "난 노래할 거야! 내 마음대로!"

msgid "adv_100348101_0011_msg"
msgstr "그래그래, 알았어"

msgid "adv_100348102_0004_msg"
msgstr "바사라. 너는 어떤 마음으로 노래해?"

msgid "adv_100348102_0005_msg"
msgstr "글쎄… 산을 움직이고 싶다…는 마음이려나"

msgid "adv_100348102_0006_msg"
msgstr "산?"

msgid "adv_100348102_0007_msg"
msgstr "어릴 때 내 노래로 산을 움직여주겠다고 생각했어.\\r\\n지금도 그건 변하지 않았고"

msgid "adv_100348102_0008_msg"
msgstr "아니… 오히려 더 거대한 걸\\r\\n움직여주겠다고 생각하고 있어"

msgid "adv_100348102_0009_msg"
