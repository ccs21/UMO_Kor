msgid "adv_302102_0025_msg"
msgstr "자, 감린 씨! 가요!"

msgid "adv_302102_0026_msg"
msgstr ""

msgid "adv_302102_0027_msg"
msgstr "…훗"

msgid "adv_302102_0028_msg"
msgstr "? 왜 그러세요?"

msgid "adv_302102_0029_msg"
msgstr "아닙니다, 역시 밀레느 씨에게는\\r\\n당할 수 없다는 생각이 들었을 뿐입니다"

