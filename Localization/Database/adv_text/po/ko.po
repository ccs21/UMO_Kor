msgid "adv_202101_0045_msg"
msgstr "셰릴 씨…"

msgid "adv_202101_0046_msg"
msgstr "…하지만 그 전에 잠깐 쉬자!\\r\\n간식으로 붕어빵을 사왔어"

msgid "adv_202101_0047_msg"
