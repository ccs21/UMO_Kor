msgid "adv_102701_0042_msg"
msgstr "응. 맞아"

msgid "adv_102701_0043_msg"
msgstr "하아… 그래서 이걸 잘 부탁한다는 게 무슨 뜻이야?"

msgid "adv_102701_0044_msg"
