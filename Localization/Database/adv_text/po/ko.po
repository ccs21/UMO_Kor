msgid "adv_102401_0012_msg"
msgstr "오늘 라이브도 진짜 기운 팍팍 넣고 가야죠!"

msgid "adv_102401_0016_msg"
msgstr ""

msgid "adv_102401_0020_msg"
msgstr "…어라? 마키나 씨, 멍하니 밖을 보고 있는데\\r\\n무슨 일일까요?"

msgid "adv_102401_0021_msg"
msgstr "왠지 평소보다 기운이 없어 보이는데…?"

msgid "adv_102401_0022_msg"
