msgstr "저기… 프레프레, 레이레이?"

msgid "adv_101601_0011_msg"
msgstr "마키나의 오른손을 잡은 프레이아… 왼손을 잡은 레이나"

msgid "adv_101601_0012_msg"
msgstr "보기 드문 광경이네"

msgid "adv_101601_0013_msg"
msgstr "저기… 마키나, 대체 무슨 일이 있었어?\\n프레이아랑 레이나 상태가 이상한 것 같은데"

msgid "adv_101601_0014_msg"
msgstr "그게 나도 잘 모르겠단 말이지…\\n라이브가 끝난 뒤부터 계속 이러고 있다고 해야 하나"

msgid "adv_101601_0015_msg"
msgstr "그래…"

msgid "adv_101601_0016_msg"
msgstr "뭐, 이것대로 정~말 귀여워서 좋긴 하지만!"

msgid "adv_101601_0017_msg"
msgstr "있잖아, 프레이아, 레이나. 괜찮아?\\n무슨 일이 있었는지 말해줄래?"

msgid "adv_101601_0019_msg"
msgstr "훌쩍…"

msgid "adv_101601_0020_msg"
msgstr ""

msgid "adv_101601_0022_msg"
msgstr "자, 울지 마. 응?"

msgid "adv_101601_0024_msg"
msgstr "뭐, 그런 기억을 봤으니 충격이 클 만도 하지"

msgid "adv_101601_0025_msg"
msgstr "미쿠모… 둘이 우는 이유를 알고 있었어?"

msgid "adv_101601_0026_msg"
msgstr "응. 둘이 본 건 마키나가 총격을 당했던 기억.\\n물론 이 세계의 기억은 아닌 것 같지만"

msgid "adv_101601_0027_msg"
msgstr "내가 총격을…?"

msgid "adv_101601_0029_msg"
msgstr "그래"

msgid "adv_101601_0030_msg"
msgstr "그 세계의 마키나 씨가 저를 감싸줬어요… 그래서…"

msgid "adv_101601_0031_msg"
msgstr "…괴롭고, 슬퍼"

msgid "adv_101601_0033_msg"
msgstr "그렇구나… 둘이 이렇게 슬퍼하는 것도 이해가 되네"

msgid "adv_101601_0034_msg"
msgstr "제 탓이에요!\\n제가 멍하니 있었던 탓에 마키나 씨가…!"

msgid "adv_101601_0035_msg"
msgstr "그렇지 않아, 프레프레!\\n애초에 여기 있는 나한테 일어난 일도 아니고…"

msgid "adv_101601_0036_msg"
msgstr "하지만…!"

msgid "adv_101601_0038_msg"
msgstr "프레이아, 진정해"

msgid "adv_101601_0039_msg"
msgstr "네, 네엣"

msgid "adv_101601_0040_msg"
msgstr "몇 번이나 말하지만, 그건 다른 세계의 기억이야"

msgid "adv_101601_0041_msg"
msgstr "그리고 이 세계의 너희에게는\\n그 세계와 똑같은 일이 일어나지 않도록 할 수 있는 일이 분명 있을 거야"

msgid "adv_101601_0042_msg"
msgstr "우리가 할 수 있는 일"

msgid "adv_101601_0044_msg"
msgstr "…이 세계의 마키나를 지킨다"

msgid "adv_101601_0045_msg"
msgstr "절대로 다치게 하지 않아"

msgid "adv_101601_0046_msg"
msgstr "레이레이…"

msgid "adv_101601_0047_msg"
msgstr "맞아요!\\n저도 반드시 마키나 씨를 지켜낼 거예요!"

msgid "adv_101601_0048_msg"
msgstr "프레프레!"

msgid "adv_101601_0049_msg"
msgstr "저, 마키나 씨를 위해 진짜 열심히 할 테니까요!"

msgid "adv_101601_0050_msg"
msgstr "마키나는 아무 걱정도 하지 마"

msgid "adv_101601_0051_msg"
msgstr "둘 다…!!"

msgid "adv_101601_0053_msg"
msgstr "…이 정도면 괜찮을 것 같네.\\n고마워, 미쿠모"

msgid "adv_101601_0054_msg"
msgstr "난 해야 할 말을 했을 뿐이야.\\n…그보다 슬슬 시간이지 않아?"

msgid "adv_101601_0055_msg"
msgstr "그러네.\\n곧 다음 무대야, 가자!"

msgid "adv_101602_0008_msg"
msgstr "프레이아, 마키나 못 봤어?"

msgid "adv_101602_0009_msg"
msgstr "마키나 씨라면 지금 레이나 씨랑\\n같이 있을 텐데… 불러올까요?"

msgid "adv_101602_0010_msg"
msgstr "아니, 괜찮아. 다음 라이브 의상에 대해\\n얘기를 듣고 싶었는데… 나중에 해도 돼"

msgid "adv_101602_0011_msg"
msgstr "그런 기억을 본 뒤니까.\\n당분간 레이나와 둘이 있게 해주자"

msgid "adv_101602_0012_msg"
msgstr "네엣!"

msgid "adv_101602_0013_msg"
msgstr "후훗!"

msgid "adv_101602_0014_msg"
msgstr "…카나메 씨?"

msgid "adv_101602_0015_msg"
msgstr "프레이아도 완전히 기운을 되찾아서 다행이다 싶어서.\\n아까는 울 것 같았잖아"

msgid "adv_101602_0016_msg"
msgstr "죄, 죄송해요!"

msgid "adv_101602_0017_msg"
msgstr "사과할 일이 아니야.\\n동료를 걱정하는 건 당연한 일이니까"

msgid "adv_101602_0018_msg"
msgstr "…감사해요.\\n저, 미쿠모 씨 덕분에 깨달았어요!\\n이 세계의 내가 할 수 있는 게 뭘까 하고…"

msgid "adv_101602_0019_msg"
msgstr "다들 무사해서 정말 다행이에요"

msgid "adv_101602_0020_msg"
msgstr "그러고 보니 미라쥬 씨도 마키나 씨를\\n진짜 많이 걱정했었죠…"

msgid "adv_101602_0021_msg"
msgstr "그랬구나… 있잖아, 프레이아.\\n잠깐 미라쥬 상태를 보고 와줄래?"

msgid "adv_101602_0022_msg"
msgstr "네엣!"

msgid "adv_101602_0024_msg"
msgstr "그렇게 뛰지 않아도 괜찮은데… 벌써 가버렸네"

msgid "adv_101602_0026_msg"
msgstr "일단락됐다고 봐도 되려나"

msgid "adv_101602_0027_msg"
msgstr "미쿠모…"

msgid "adv_101602_0028_msg"
msgstr "응. 프레이아와 레이나도 이제야 안심한 것 같네"

msgid "adv_101602_0029_msg"
msgstr "…카나메도 그렇지?"

msgid "adv_101602_0030_msg"
msgstr "들켰어?"

msgid "adv_101602_0031_msg"
msgstr "…사실 나도 마키나가 총격을 당한다는 말을 듣고,\\n동요했어"

msgid "adv_101602_0032_msg"
msgstr "하지만 나까지 당황하면\\n다들 불안해질 테니까…"

msgid "adv_101602_0033_msg"
msgstr "그래서 숨기고 있다고 생각했는데\\n언제 눈치챘어?"

msgid "adv_101602_0034_msg"
msgstr "글쎄, 언제였을까"

msgid "adv_101602_0035_msg"
msgstr "여전하네"

msgid "adv_101602_0036_msg"
msgstr "그게 나니까"

msgid "adv_101602_0037_msg"
msgstr "후훗! 확실히 그렇네"

msgid "adv_101602_0038_msg"
msgstr "있잖아, 미쿠모.\\n왈큐레는 다섯 명이 아니면 의미가 없어"

msgid "adv_101602_0039_msg"
msgstr "누군가가 무대에 설 수 없게 되는 건\\n절대로 있어선 안 돼"

msgid "adv_101602_0040_msg"
msgstr "그러니까 미쿠모도 기억해둬.\\n너도 빠지면 안 되는 거니까"

msgid "adv_101602_0041_msg"
msgstr "…알고 있어"

msgid "adv_201501_0009_msg"
msgstr "민메이 씨, 안녕하세요!"

msgid "adv_201501_0010_msg"
msgstr "어머, 밀레느!"

msgid "adv_201501_0011_msg"
msgstr "이제 곧 본 공연이죠?\\n오늘 라이브도 정말 기대하고 있어요!"

msgid "adv_201501_0012_msg"
msgstr "고마워. 최선을 다하고 올게!"

msgid "adv_201501_0013_msg"
msgstr "…어라?\\n민메이 씨 무릎 위에 놓인 그거… 앨범인가요?"

msgid "adv_201501_0014_msg"
msgstr "저기… 그렇긴 한데, 이건 그게…"

msgid "adv_201501_0015_msg"
msgstr "민메이 씨?"

msgid "adv_201501_0016_msg"
msgstr "아, 알겠다!\\n혹시 좋아하는 사람 사진이라도 들어 있는 거예요?"

msgid "adv_201501_0017_msg"
msgstr "어?"

msgid "adv_201501_0019_msg"
msgstr "밀레느, 그러니까 네가 애라는 거야"

msgid "adv_201501_0020_msg"
msgstr "뭐야, 바사라… 잠깐, 바사라!?\\n왜 민메이 씨한테 와 있는 거야~!?"

msgid "adv_201501_0021_msg"
msgstr "뭐든 상관없잖아.\\n그럼 민메이, 난 돌아갈게"

msgid "adv_201501_0022_msg"
msgstr "네. 바사라 씨, 감사합니다"

msgid "adv_201501_0024_msg"
msgstr "잠깐… 벌써 가버렸네"

msgid "adv_201501_0025_msg"
msgstr "내가 민메이 씨를 만나러 왔더니\\n나보다 먼저 바사라가 와 있고…"

msgid "adv_201501_0026_msg"
msgstr "민메이 씨가 그 바사라한테 감사 인사를 하고…?"

msgid "adv_201501_0027_msg"
msgstr "이게 대체 무슨 상황이지??"

msgid "adv_201501_0028_msg"
msgstr "후훗!"

msgid "adv_201501_0029_msg"
msgstr "있잖아, 밀레느.\\n바사라 씨는 정말 좋은 사람이네!"

msgid "adv_201501_0030_msg"
msgstr "네!? 미, 민메이 씨\\n그거 진심으로 하는 말이에요?"

msgid "adv_201501_0031_msg"
msgstr "바사라는 늘~ 제멋대로고\\n늘~ 안하무인이에요"

msgid "adv_201501_0032_msg"
msgstr "…뭐, 노래에 관해서는\\n확실히 존경할 만한 점이 없는 것도 아니고…\\n가끔 좋은 말도 하긴 하지만"

msgid "adv_201501_0033_msg"
msgstr "…? 밀레느, 뭐라고 했어?\\n목소리가 작아서 안 들렸는데…"

msgid "adv_201501_0034_msg"
msgstr "! 아, 아무것도 아니에요!"

msgid "adv_201501_0035_msg"
msgstr "그보다 민메이 씨!\\n본 공연 시간, 괜찮으세요?"

msgid "adv_201501_0036_msg"
msgstr "응, 슬슬 무대로 가야겠네…\\n아, 맞다, 밀레느!"

msgid "adv_201501_0037_msg"
msgstr "이 앨범 안에 뭐가 들었는지는 오늘 라이브에서 부를\\n노래 속에 힌트가 있을지도 몰라"

msgid "adv_201501_0038_msg"
msgstr "노래 속에… 말인가요?"

msgid "adv_201501_0039_msg"
msgstr "응. 괜찮으면 잘 들어보고 찾아봐!"

msgid "adv_201501_0040_msg"
msgstr "…알겠어요!\\n오늘은 평소보다 더 집중해서 들어볼게요!"

msgid "adv_201501_0042_msg"
msgstr "그나저나 왜 민메이 씨랑 바사라가…?"

msgid "adv_201501_0043_msg"
msgstr "그리고 그 앨범… 어떤 사진이 들어 있는 걸까?\\n민메이 씨 모습도 평소와 좀 달랐던 것 같은데…"

msgid "adv_201502_0008_msg"
msgstr "바사라 씨!"

msgid "adv_201502_0009_msg"
msgstr "민메이"

msgid "adv_201502_0010_msg"
msgstr "…저기, 오늘 라이브 전에\\n제 이야기를 들어주셔서 감사했어요"

msgid "adv_201502_0011_msg"
msgstr "난 그냥 노래하러 왔을 뿐이야"

msgid "adv_201502_0012_msg"
msgstr "그랬죠.\\n…아까 SNS로 모두에게 앨범 이야기를 할 수 있었어요"

msgid "adv_201502_0013_msg"
msgstr "밀레느가 바사라 씨와 똑같은 말을\\n해줬어요.\\n앨범 속의 제 모습을 봐도 실망하지 않을 거라고!"

msgid "adv_201502_0014_msg"
msgstr "그래"

msgid "adv_201502_0015_msg"
msgstr "…후훗!"

msgid "adv_201502_0016_msg"
msgstr "사실… 진짜 저는 굉장히 제멋대로예요"

msgid "adv_201502_0017_msg"
msgstr "그런데 밀레느나 란카,\\n프레이아가 있는 세계에서는 제가 대단한 사람인 것 같아서…"

msgid "adv_201502_0018_msg"
msgstr "저 자신은 전혀 실감도 안 나는데\\n정말 신기한 기분이고… 그래도 조금은\\n기쁘기도 해서"

msgid "adv_201502_0019_msg"
msgstr "그래서 그 기대를 저버리지 말아야겠다고 생각했어요.\\n다른 사람들 앞에서는 조금\\n어른인 척하기도 했고요"

msgid "adv_201502_0020_msg"
msgstr ""

msgid "adv_201502_0021_msg"
msgstr "하지만 오늘 바사라 씨가 해준 말과\\n모두에게 들은 말 덕분에 생각이 조금 바뀌었어요"

msgid "adv_201502_0022_msg"
msgstr "조금쯤은 모두에게 진짜 제 모습을, 제멋대로인\\n제 모습을 보여줘도 괜찮지 않을까 하고요!"

msgid "adv_201502_0023_msg"
msgstr "…그래"

msgid "adv_201502_0024_msg"
msgstr "정말 감사했어요.\\n그럼 저는 슬슬 돌아갈게요"

msgid "adv_201502_0025_msg"
msgstr "진짜 모습이니 뭐니, 그런 건 관심 없어"

msgid "adv_201502_0026_msg"
msgstr "하지만 난 싫지 않아, 네 노래"

msgid "adv_201502_0027_msg"
msgstr ""

msgid "adv_201502_0028_msg"
msgstr "…후훗. 하야테 군도 말했지만\\n바사라 씨는 정말 기분 좋은 사람이네요"

msgid "adv_201502_0029_msg"
msgstr "그래?"

msgid "adv_201502_0030_msg"
msgstr "네. 정말 큰 도움이 돼요.\\n진심으로 감사합니다"

msgid "adv_201502_0031_msg"
msgstr "하지만! 가끔은 밀레느도,\\n그렇게 칭찬해 주세요"

msgid "adv_201502_0032_msg"
msgstr "걔는 애니까.\\n조금만 칭찬해도 금방 우쭐해져"

msgid "adv_201502_0033_msg"
msgstr "어머! 우후훗!"

msgid "adv_201502_0034_msg"
msgstr "그럼 저, 이번에야말로 돌아갈게요"

msgid "adv_201502_0035_msg"
msgstr "…혹시 또 고민이 생기면…\\n그때는 상담해도 괜찮을까요?"

msgid "adv_201502_0036_msg"
msgstr "마음 내키면"

msgid "adv_201502_0037_msg"
msgstr "…! 감사합니다, 바사라 씨!"

msgid "adv_301401_0009_msg"
msgstr "하야하야, 발견!"

msgid "adv_301401_0010_msg"
msgstr "확보"

msgid "adv_301401_0011_msg"
msgstr "뭐!? 갑자기 뭐야!\\n어이, 놓으라고!"

msgid "adv_301401_0012_msg"
msgstr "저항은 무의미"

msgid "adv_301401_0013_msg"
msgstr "맞아, 맞아!\\n조~금만 어울려주면 되니까, 응?"

msgid "adv_301401_0014_msg"
msgstr "…정말, 뭐야 그게. 불길한 예감밖에 안 드는데"

msgid "adv_301401_0016_msg"
msgstr "…그래서 슬슬 설명 좀 해봐.\\n왜 내가 이런 데까지 끌려온 거야?\\n그리고 왜 척이랑…"

msgid "adv_301401_0017_msg"
msgstr "…메서가 있는 거지?"

msgid "adv_301401_0018_msg"
msgstr ""

msgid "adv_301401_0019_msg"
msgstr "자자, 하야테. 진정해!\\n나도 메서도 뭐가 뭔지 모르니까"

msgid "adv_301401_0021_msg"
msgstr "자자~! 싸우면 안 돼?\\n그럼 바로 설명할게"

msgid "adv_301401_0022_msg"
msgstr "…아니, 그보다 뭐야 그 차림"

msgid "adv_301401_0023_msg"
msgstr "그건 지금부터 할 얘기랑 관련이 있어!"

msgid "adv_301401_0024_msg"
msgstr "아주 많아"

msgid "adv_301401_0025_msg"
msgstr "자, 하야하야.\\n곧 큰 이벤트가 있는데 무슨 이벤트인지 알아?"

msgid "adv_301401_0026_msg"
msgstr "할로윈"

msgid "adv_301401_0027_msg"
msgstr "레이레이, 정답!"

msgid "adv_301401_0028_msg"
msgstr "뭐?"

msgid "adv_301401_0029_msg"
msgstr "그래서 정~말 귀엽고\\n재밌는 걸 생각해냈습니다!"

msgid "adv_301401_0030_msg"
msgstr "그 이름도, 할로윈 장난 대작전"

msgid "adv_301401_0031_msg"
msgstr "…장난?"

msgid "adv_301401_0032_msg"
msgstr "응! 할로윈 하면 장난이지!\\n모처럼이니까 다 같이 실컷 즐겨보자고!"

msgid "adv_301401_0034_msg"
msgstr "오~!\\n재밌어 보이는 계획인데! 괜찮지 않아?"

msgid "adv_301401_0035_msg"
msgstr "그래서 어떤 계획인데?"

msgid "adv_301401_0036_msg"
msgstr "아주 간단해!\\n이번 할로윈에는 나랑 레이레이가 장난치는 담당이 될 거야~!\\n그래서 다들한테 그걸 도와줬으면 하는데…"

msgid "adv_301401_0038_msg"
msgstr "…임무로 돌아간다"

msgid "adv_301401_0040_msg"
msgstr "아, 어이, 메서 도망가지 마!"

msgid "adv_301401_0041_msg"
msgstr "…역시 메사메사를 참가시키는 건 어렵나~"

msgid "adv_301401_0042_msg"
msgstr "괜찮아. 하야테랑 척이 있어"

msgid "adv_301401_0043_msg"
msgstr "응, 그렇네!"

msgid "adv_301401_0044_msg"
msgstr "아비규환, 안색 창백…"

msgid "adv_301401_0045_msg"
msgstr "가슴이 따끔따끔해질 만큼 굉장한 할로윈으로 만들자"

msgid "adv_301401_0046_msg"
msgstr "응!"

msgid "adv_301401_0048_msg"
msgstr "…괜찮겠냐?"

msgid "adv_301401_0049_msg"
msgstr "글쎄…"

msgid "adv_301402_0008_msg"
msgstr "바사라 씨! 우리 장난, 어땠어?"

msgid "adv_301402_0009_msg"
msgstr "나쁘지 않았어, 마키나"

msgid "adv_301402_0010_msg"
msgstr "오오~! 다행이다~!"

msgid "adv_301402_0011_msg"
msgstr "…그거, 무슨 장치였어?"

msgid "adv_301402_0012_msg"
msgstr "초시공 유닛 네트워크를 사용했어.\\n그 정도는 식은 죽 먹기"

msgid "adv_301402_0013_msg"
msgstr "헤에, 대단하네"

msgid "adv_301402_0014_msg"
msgstr "당연"

msgid "adv_301402_0015_msg"
msgstr "처음엔 어떤 장난을 칠까~ 하고 생각했는데\\n어떤 사람한테 힌트를 받았거든…"

msgid "adv_301402_0016_msg"
msgstr "밀레느지"

msgid "adv_301402_0017_msg"
msgstr "에에~!? 어떻게 알았어!?"

msgid "adv_301402_0018_msg"
msgstr "밀레느 같은 애가 생각할 법한 거니까"

msgid "adv_301402_0019_msg"
msgstr "…사실 그 의상, 미레미레가 준비한 거야.\\n그런데 절대 안 입어줄 테니까, 어떻게 해서든\\n바사라 씨한테 입히고 싶다고 상담해와서…"

msgid "adv_301402_0020_msg"
msgstr "그래서 우리가 장난으로 써먹기로 한 거야!"

msgid "adv_301402_0021_msg"
msgstr "대성공"

msgid "adv_301402_0022_msg"
msgstr "뭐, 할로윈이니까.\\n특별히 의상을 바꿔 입는 것도 나쁘진 않네"

msgid "adv_301402_0023_msg"
msgstr "그러고 보니… 미레미레가 안 보이는 것 같은데…?"

msgid "adv_301402_0024_msg"
msgstr "레이나 비히다한테 과자라도 받으러 간 거 아니야?"

msgid "adv_301402_0025_msg"
msgstr "아~! 우리도 카나카나한테 과자 받으러 가야 해!"

msgid "adv_301402_0026_msg"
msgstr "가야 해"

msgid "adv_301402_0027_msg"
msgstr "그래, 또 보자"

msgid "adv_301402_0031_msg"
msgstr "카나메"

msgid "adv_301402_0032_msg"
msgstr "카나메 씨!"

msgid "adv_301402_0033_msg"
msgstr "프레이아랑...미쿠모?"

msgid "adv_301402_0034_msg"
msgstr "트릭 오어 트릿"

msgid "adv_301402_0035_msg"
msgstr "네?"

msgid "adv_301402_0036_msg"
msgstr "지금 미쿠모 씨랑 같이 여러 사람들한테\\n돌아다니고 있어요!"

msgid "adv_301402_0037_msg"
msgstr "미라쥬 씨랑 척 씨한테도,\\n과자를 잔~뜩 받았어요!"

msgid "adv_301402_0038_msg"
msgstr "후훗… 마키나랑 레이나뿐만 아니라\\n미쿠모도 할로윈을 즐기는 것 같아서 다행이네"

msgid "adv_301402_0039_msg"
msgstr "…별다른 의미는 없어.\\n가끔은 이런 기분 전환도 괜찮다고 생각했을 뿐이야"

msgid "adv_301402_0040_msg"
msgstr "후훗! 그래…"

msgid "adv_301402_0041_msg"
msgstr "맞다!\\n이제 아라드 대장이랑 메서 씨한테 갈 건데…\\n카나메 씨도 같이 가실래요?"

msgid "adv_301402_0042_msg"
msgstr "뭐!? 나도!? 그건 아무래도 좀…\\n너무 들떴다고 생각할지도 모르고…"

msgid "adv_301402_0043_msg"
msgstr "어머? 가끔은 그런 카나메도 괜찮지 않을까?"

msgid "adv_301402_0044_msg"
msgstr "음, 그런가…?"

msgid "adv_301402_0045_msg"
msgstr "같이 가요, 카나메 씨!"

msgid "adv_301402_0046_msg"
msgstr "응, 그러자!"

msgid "adv_101701_0008_msg"
msgstr "오오~! 여기가 학교구나!\\n분명 오늘은 란카 씨가\\n여기서 촬영한다고 들었는데…"

msgid "adv_101701_0009_msg"
msgstr "아, 란카 씨~!\\n약속대로 구경하러 왔어요!"

msgid "adv_101701_0011_msg"
msgstr ""

msgid "adv_101701_0012_msg"
msgstr "…란카 씨? 무슨 일이에요?"

msgid "adv_101701_0013_msg"
msgstr "왓! 프, 프레이아!?"

msgid "adv_101701_0014_msg"
msgstr "미안해! 나 멍하니 있었어…\\n프레이아, 일부러 와줬구나!"

msgid "adv_101701_0015_msg"
msgstr "네엣! 오늘 촬영 장소를 듣고\\n어떤 곳일까? 싶어서 저도 모르게…"

msgid "adv_101701_0016_msg"
msgstr "또 마음대로 초시공 유닛 라이브를 썼다고…\\n레이나 씨 일행한테 혼날지도 모르지만…"

msgid "adv_101701_0017_msg"
msgstr "란카 씨, 비밀로 해주세요!"

msgid "adv_101701_0018_msg"
msgstr "후훗! 물론이지!"

msgid "adv_101701_0019_msg"
msgstr "그보다 오늘 란카 씨 의상,\\n진짜 귀여워요!"

msgid "adv_101701_0020_msg"
msgstr "…정말? 잘 어울려?"

msgid "adv_101701_0021_msg"
msgstr "네엣! 란카 씨한테 딱 어울리는 느낌이에요!"

msgid "adv_101701_0022_msg"
msgstr "고마워!\\n이 의상은 이번에 부를 노래의 의상이야.\\n학교 교복을 모티브로 했어"

msgid "adv_101701_0023_msg"
msgstr "호오~…! 학교 교복!"

msgid "adv_101701_0024_msg"
msgstr "학교는 즐겁잖아! 친구랑 수다도 떨고\\n같이 점심도 먹고… 운동회나 문화제처럼,\\n두근거리는 이벤트도 잔뜩 있고!"

msgid "adv_101701_0025_msg"
msgstr "소중한 친구가 생기기도 하고, 좋아하는 사람이 생기기도 하고\\n매일매일 여러 가지 일이 생기고…"

msgid "adv_101701_0026_msg"
msgstr ""

msgid "adv_101701_0027_msg"
msgstr "…란카 씨, 무슨 일이에요?"

msgid "adv_101701_0028_msg"
msgstr "아… 미안해. 그러니까…"

msgid "adv_101701_0029_msg"
msgstr "…프레이아한테는 말해도 될 것 같아.\\n사실 아까 리허설 중에 또 모르는 기억을\\n본 것 같은 기분이 들었어"

msgid "adv_101701_0030_msg"
msgstr "…! 혹시 그거\\n다른 세계의 란카 씨 기억…?"

msgid "adv_101701_0031_msg"
msgstr "응… 그곳은 전장이었어"

msgid "adv_101701_0032_msg"
msgstr "이걸로 모든 게 결정돼버리는,\\n중요한 결전을 바로 앞둔 때였고…\\n나는 지금과 똑같은 의상을 입고 서 있었어"

msgid "adv_101701_0033_msg"
msgstr "이제 싸우러 가는 소중한 사람을 향해\\n나는 내 마음을…"

msgid "adv_101701_0034_msg"
msgstr ""

msgid "adv_101701_0035_msg"
msgstr "…미안! 역시 이 이상은 그만할게.\\n모처럼 프레이아가 와 있잖아.\\n좀 더 즐거운 이야기를 하고 싶기도 하고!"

msgid "adv_101701_0036_msg"
msgstr "란카 씨…"

msgid "adv_101701_0037_msg"
msgstr "…기억 속의 내가 품고 있던 감정은\\n어렴풋이 기억나는데,\\n지금의 나는 그걸 잘 표현할 수가 없어서"

msgid "adv_101701_0038_msg"
msgstr "그 마음… 조금은 알 것 같아요"

msgid "adv_101701_0039_msg"
msgstr "그러니까 억지로 말하지 않아도 괜찮아요!\\n란카 씨의 마음은 분명 소중한 거라고 생각하니까…"

msgid "adv_101701_0040_msg"
msgstr "란카 씨 마음속에만,\\n살며시 간직해 주세요!"

msgid "adv_101701_0041_msg"
msgstr "프레이아… 고마워!"

msgid "adv_101701_0042_msg"
msgstr "…다른 세계의 기억을 봤을 때 느꼈던 마음도,\\n그 기억 속의 내가 지금의 나에게 전해준 감정도,\\n이 노래에 담을 수 있을 것 같아"

msgid "adv_101701_0043_msg"
msgstr "그럼 나, 최선을 다해 노래할 테니까 끝까지 들어줘,\\n프레이아!"

msgid "adv_101701_0044_msg"
msgstr "기대하고 있을게요, 란카 씨!"

msgid "adv_101702_0008_msg"
msgstr "프레이아!"

msgid "adv_101702_0009_msg"
msgstr "란카 씨, 보세요!\\n아까 보내주신 의상,\\n마키나 씨가 재현해줬어요!"

msgid "adv_101702_0010_msg"
msgstr "이번 라이브 의상으로 쓰기로 했는데…\\n지금부터 진짜 기대돼요!"

msgid "adv_101702_0011_msg"
msgstr "잘 어울려요?"

msgid "adv_101702_0012_msg"
msgstr "응! 정말 귀여워!\\n아주 잘 어울려, 프레이아!"

msgid "adv_101702_0013_msg"
msgstr "정말요!? 진짜 기뻐요!"

msgid "adv_101702_0014_msg"
msgstr "이 차림으로 방과 후에 여기저기 들르면,\\n확실히 재밌을 것 같네요…"

msgid "adv_101702_0015_msg"
msgstr "후훗! 그러게!\\n같이 카페에도 가고, 쇼핑도 하고…"

msgid "adv_101702_0016_msg"
msgstr "기운 팍팍~!!"

msgid "adv_101702_0017_msg"
msgstr "…있잖아, 프레이아.\\n조금 물어보고 싶은 게 있는데"

msgid "adv_101702_0018_msg"
msgstr "네엣!"

msgid "adv_101702_0019_msg"
msgstr "프레이아는 좋아하는 사람… 있어?"

msgid "adv_101702_0020_msg"
msgstr "…좋아하는 사람이요?"

msgid "adv_101702_0021_msg"
msgstr "그거라면 진짜 많아요!\\n왈큐레 모두랑 델타 소대 사람들도 그렇고…"

msgid "adv_101702_0022_msg"
msgstr "그런 의미의 좋아한다는 게 아니라…\\n음, 뭐라고 해야 할까?"

msgid "adv_101702_0023_msg"
msgstr "같이 있으면 두근두근하고…\\n가슴이 꼬옥 조이는 것 같은… 그런 소중한 사람"

msgid "adv_101702_0024_msg"
msgstr "가, 가슴이 꼬옥… 저기…?"

msgid "adv_101702_0025_msg"
msgstr "프레이아한테는 아직 그런 사람이 없는 걸까?"

msgid "adv_101702_0026_msg"
msgstr "…잘 모르겠어요.\\n란카 씨한테는 그런 사람이 있나요?"

msgid "adv_101702_0027_msg"
msgstr "나는…"

msgid "adv_101702_0028_msg"
msgstr "…글쎄? 나도 아직 잘 모르겠는걸"

msgid "adv_101702_0029_msg"
msgstr "언젠가는 두근두근하고\\n가슴이 꼬옥 조이는 사람을 만날지도 모르겠네요!"

msgid "adv_101702_0030_msg"
msgstr "그러게!"

msgid "adv_101702_0031_msg"
msgstr "그런데 왜 물어보신 거예요??"

msgid "adv_101702_0032_msg"
msgstr "오늘 촬영에서 방과 후에 고백하는 장면을 찍었거든!\\n그래서 왠지 프레이아한테 물어보고 싶어져서"

msgid "adv_101702_0033_msg"
msgstr "…곤란하게 했나?"

msgid "adv_101702_0034_msg"
msgstr "전혀요!\\n그보다 오늘 여러 가지 알려주셔서 감사했어요!"

msgid "adv_101702_0035_msg"
msgstr "다음에는 왈큐레 멤버들이랑도\\n교복 차림으로 라그나 거리를 걸어보고 싶어졌어요"

msgid "adv_101702_0036_msg"
msgstr "그러니까 그때는 란카 씨도 같이 가요!\\n초시공 유닛 라이브로!"

msgid "adv_101702_0037_msg"
msgstr "재밌겠다! 그럼 나도 같이 가볼까?"

msgid "adv_101702_0038_msg"
msgstr "가끔은 이런 것도 괜찮을 것 같네!"

msgid "adv_101702_0039_msg"
msgstr "…우히히. 진짜 기대되네요!"

msgid "adv_201601_0008_msg"
msgstr "있잖아, 하야테. 해파리는 맛있어?\\n레이나가 유난히 추천하던데…"

msgid "adv_201601_0009_msg"
msgstr "레이나가?"

msgid "adv_201601_0010_msg"
msgstr "그래. 접시에 산더미처럼 쌓인\\n생해파리 이미지 데이터를 보내오더라고"

msgid "adv_201601_0011_msg"
msgstr "음… 뭐, 생으로 통째로 삼키는 건\\n레이나 정도일 것 같긴 하지만"

msgid "adv_201601_0013_msg"
msgstr "둘 다 즐거워 보이네!"

msgid "adv_201601_0014_msg"
msgstr "카나메 씨. 그 의상은 뭐야?"

msgid "adv_201601_0015_msg"
msgstr "오늘은 라이브가 아니었던 것 같은데?"

msgid "adv_201601_0016_msg"
msgstr "오늘은 어네스트 함장님의 지인에게\\n개인적으로 부탁을 받았어"

msgid "adv_201601_0017_msg"
msgstr "『해파리 보내기 때 노래해줬으면 한다』고"

msgid "adv_201601_0018_msg"
msgstr "해파리 보내기?"

msgid "adv_201601_0019_msg"
msgstr "나도 모르겠는데. 해파리 보내기가 뭐야?"

msgid "adv_201601_0021_msg"
msgstr "뭐야, 하야테도 몰랐어?"

msgid "adv_201601_0022_msg"
msgstr "척"

msgid "adv_201601_0023_msg"
msgstr "뭐 그렇지. 해파리 축제 같은 건가?"

msgid "adv_201601_0024_msg"
msgstr "아니. 라그나에서는 죽은 사람의 영혼이 바다로 돌아가서\\n빛해파리가 된다는 전설이 있어"

msgid "adv_201601_0025_msg"
msgstr "…천천히 바다를 떠돌며 조금씩 조금씩 치유되고\\n깨끗해져서 다시 태어나는 거야"

msgid "adv_201601_0026_msg"
msgstr "그래서 제대로 해파리가 될 수 있도록\\n영혼을 배에 태워서 보내주는 거지.\\n술 마시고 노래하면서 성대하게"

msgid "adv_201601_0027_msg"
msgstr "헤에…"

msgid "adv_201601_0028_msg"
msgstr "죽은 사람의 영혼을, 말이지.\\n…그런 식으로 떠나보내는 방법도 있구나"

msgid "adv_201601_0030_msg"
msgstr "응…"

msgid "adv_201601_0031_msg"
msgstr "내 노래가 돌아가신 분을 위한 추모가 될 수 있을지\\n조금 걱정되지만"

msgid "adv_201601_0032_msg"
msgstr "딱히 걱정할 필요 없을 것 같은데"

msgid "adv_201601_0033_msg"
msgstr "맞아, 카나메 씨!\\n카나메 씨가 와주면 떠나보내는 사람도, 떠나는 사람도\\n분명 기뻐할 거야"

msgid "adv_201601_0034_msg"
msgstr "그래? 그렇다면 나도 기쁠 텐데…"

msgid "adv_201601_0036_msg"
msgstr "카나메 씨"

msgid "adv_201601_0037_msg"
msgstr "메서 군!"

msgid "adv_201601_0038_msg"
msgstr "시간입니다. 슬슬 가시죠"

msgid "adv_201601_0039_msg"
msgstr "카나메 씨, 힘내!"

msgid "adv_201601_0041_msg"
msgstr "조심해서 다녀와"

msgid "adv_201601_0042_msg"
msgstr "고마워!\\n…메서 군. 오늘 호위, 잘 부탁할게"

msgid "adv_201601_0043_msg"
msgstr "알겠습니다"

msgid "adv_201602_0008_msg"
msgstr "카나메 씨"

msgid "adv_201602_0009_msg"
msgstr "메서 군. 미쿠모 못 봤어?\\n바로 근처에 있는 것 같은데…"

msgid "adv_201602_0010_msg"
msgstr "미쿠모 씨에게 SNS로 연락이 왔습니다.\\n자기는 찾지 않아도 된다고"

msgid "adv_201602_0011_msg"
msgstr "…그렇구나. 그럼 슬슬 돌아갈까"

msgid "adv_201602_0012_msg"
msgstr "…네"

msgid "adv_201602_0013_msg"
msgstr ""

msgid "adv_201602_0014_msg"
msgstr "있잖아, 메서 군. 오늘 내 노래, 어땠어?"

msgid "adv_201602_0015_msg"
msgstr "…오늘 노래 말입니까?"

msgid "adv_201602_0016_msg"
msgstr "저기… 딱히 깊은 뜻은 없는데,\\n메서 군이 듣고 어떻게 느꼈는지 알고 싶어서"

msgid "adv_201602_0017_msg"
msgstr ""

msgid "adv_201602_0018_msg"
msgstr "…추모받는 사람의 마음을 생각하면서 들었습니다"

msgid "adv_201602_0019_msg"
msgstr "어…?"

msgid "adv_201602_0020_msg"
msgstr "자신을 위해 노래해주는 것을\\n기뻐하지 않을 사람은 없을 거라고"

msgid "adv_201602_0021_msg"
msgstr "그게 자신에게 특별한 노래라면 더더욱"

msgid "adv_201602_0022_msg"
msgstr "메서 군…"

msgid "adv_201602_0023_msg"
msgstr "…아라드 대장에게 임무 완료를 보고하고 오겠습니다"

msgid "adv_201602_0024_msg"
msgstr ""

msgid "adv_201602_0025_msg"
msgstr "…고마워, 메서 군"

msgid "adv_201602_0027_msg"
msgstr "카나메"

msgid "adv_201602_0028_msg"
msgstr "…! 미쿠모, 거기 있었구나"

msgid "adv_201602_0029_msg"
msgstr "봤지? 다른 세계의 기억"

msgid "adv_201602_0030_msg"
msgstr "…소중한 동료를 떠나보내던 기억"

msgid "adv_201602_0031_msg"
msgstr "…미쿠모"

msgid "adv_201602_0032_msg"
msgstr "네 노랫소리에서 슬픔이 느껴졌어"

msgid "adv_201602_0033_msg"
msgstr "…그러네"

msgid "adv_201602_0034_msg"
msgstr "노래하는 동안 계속 슬펐어.\\n그 세계의 나는 어떤 마음으로 노래하고 있었을까 하고.\\n하지만 그와 동시에…"

msgid "adv_201602_0035_msg"
msgstr "그 세계의 메서 군이\\n내 노래를 소중히 여겼다는 것도 느꼈어"

msgid "adv_201602_0036_msg"
msgstr "…그래"

msgid "adv_201602_0037_msg"
msgstr "그리고… 그 세계만이 아니야.\\n이 세계에도 내 노래를 소중히 여겨주는 사람이 있어"

msgid "adv_201602_0038_msg"
msgstr "그러니까 나는 노래할 거야… 누구보다 강하게"

msgid "adv_301501_0008_msg"
msgstr "기다렸지, 프레이아!\\n셰릴 씨 생일 라이브에 손님이 정말 많이 와줬네!"

msgid "adv_301501_0009_msg"
msgstr "네엣! 역시 셰릴 씨예요!\\n생일 라이브가 진짜 기대돼서 잠도 못 잤어요…"

msgid "adv_301501_0010_msg"
msgstr "나도!\\n빨리 다 같이 셰릴 씨 생일을 축하해주고 싶다!"

msgid "adv_301501_0011_msg"
msgstr "네엣!\\n그나저나 초시공 유닛 라이브는 정말 편리하네요!\\n직접 얼굴을 보면서 축하할 수 있다는 게 진짜 기뻐서…"

msgid "adv_301501_0012_msg"
msgstr "맞다!\\n셰릴 씨를 만나기 전에 머리가 눌리진 않았는지 확인해야지…"

msgid "adv_301501_0013_msg"
msgstr "후훗! 프레이아도 참"

msgid "adv_301501_0015_msg"
msgstr "란카, 프레이아. 둘 다 와줬구나"

msgid "adv_301501_0016_msg"
msgstr "후앗!?"

msgid "adv_301501_0017_msg"
msgstr "셰릴 씨!\\n그 의상, 오늘 라이브 의상이에요? 정말 예뻐요!"

msgid "adv_301501_0018_msg"
msgstr "응. 모처럼 맞은 생일이잖아.\\n의상까지 제대로 신경 써야지!"

msgid "adv_301501_0019_msg"
msgstr "저, 저기! 셰릴 씨!"

msgid "adv_301501_0020_msg"
msgstr "프레이아, 왜 그래?"

msgid "adv_301501_0021_msg"
msgstr "생일 축하드려요!\\n저도 지지 않도록 열심히 할 테니까,\\n앞으로도 같이 많이 노래해주세요!"

msgid "adv_301501_0022_msg"
msgstr "셰릴 씨, 생일 축하드려요!\\n저도 셰릴 씨와 더 많이, 더 많이 함께 노래하고 싶어요"

msgid "adv_301501_0023_msg"
msgstr "…프레이아, 란카"

msgid "adv_301501_0024_msg"
msgstr "…뭐랄까, 이렇게까지 솔직하게\\n축하받으니까 조금 쑥스럽네"

msgid "adv_301501_0025_msg"
msgstr "우후훗, 둘 다 고마워.\\n앞으로도 계속 뜨거운 노래를 전해줄게"

msgid "adv_301501_0026_msg"
msgstr "네엣! 기대하고 있을게요!"

msgid "adv_301501_0027_msg"
msgstr "…그보다 오늘 라이브 말인데,\\n둘을 위해 특등석을 준비했어!"

msgid "adv_301501_0028_msg"
msgstr "와, 정말요!? 그런데 괜찮아요?"

msgid "adv_301501_0029_msg"
msgstr "응. 사실 오늘 생일 라이브를\\n최고의 라이브로 만들려면 둘의 도움이 필요하거든"

msgid "adv_301501_0030_msg"
msgstr "도움…이요?"

msgid "adv_301501_0031_msg"
msgstr "응, 나랑 같이 불러줬으면 하는 곡이 있어"

msgid "adv_301501_0032_msg"
msgstr "네!? 셰릴 씨 생일 라이브에,\\n저희도 같이 나가도 되는 거예요!?"

msgid "adv_301501_0033_msg"
msgstr "물론이지.\\n소중한 곡이라서 꼭 이 라이브에서 누군가와 함께 부르고 싶었어"

msgid "adv_301501_0034_msg"
msgstr "어떤 곡이에요??"

msgid "adv_301501_0035_msg"
msgstr "그건 직전까지 비밀이야.\\n어느 곡에서 무대에 올라갈지는 직전까지 모르는 거지…"

msgid "adv_301501_0036_msg"
msgstr "어때? 두근두근하지?"

msgid "adv_301501_0037_msg"
msgstr "정말 두근두근하네요!"

msgid "adv_301501_0038_msg"
msgstr "하지만 진짜 불타올라요!"

msgid "adv_301501_0039_msg"
msgstr "그러게.\\n프레이아, 같이 힘내자!"

msgid "adv_301501_0040_msg"
msgstr "네엣!"

msgid "adv_301502_0008_msg"
msgstr "셰릴, 생일 라이브 수고했어!"

msgid "adv_301502_0009_msg"
msgstr "어머, 하야테? 별일이네"

msgid "adv_301502_0010_msg"
msgstr "뭐 그렇지. 조금 신경 쓰이는 게 있었다고 해야 하나"

msgid "adv_301502_0011_msg"
msgstr "신경 쓰이는 거?"

msgid "adv_301502_0012_msg"
msgstr "뭐랄까… 프레이아한테 오늘 라이브 얘기를 듣고\\n셰릴 놈도 참 힘들겠구나 싶었거든"

msgid "adv_301502_0013_msg"
msgstr "후훗, 꼭 그렇지도 않아"

msgid "adv_301502_0014_msg"
msgstr "어?"

msgid "adv_301502_0015_msg"
msgstr "…힘들기는커녕 행복한 일이 더 많아.\\n이렇게 많은 사람에게 축하도 받았잖아"

msgid "adv_301502_0016_msg"
msgstr "게다가 프레이아나 란카, 모두를 만나서\\n함께 노래할 수 있는 사람은 흔치 않으니까"

msgid "adv_301502_0017_msg"
msgstr "…처음에는 살아가기 위해 노래했어. 하지만 지금은 노래하기 위해 살아"

msgid "adv_301502_0018_msg"
msgstr "…혼자가 아니라, 모두와 함께 말이야"

msgid "adv_301502_0019_msg"
msgstr "헤에…"

msgid "adv_301502_0020_msg"
msgstr "뭐야?"

msgid "adv_301502_0021_msg"
msgstr "왠지 좀 의외라고 해야 하나…\\n셰릴한테서 그런 이야기를 들을 줄은 몰랐거든"

msgid "adv_301502_0022_msg"
msgstr "그러게.\\n나도 이런 말을 할 생각은 없었는데"

msgid "adv_301502_0023_msg"
msgstr "그런데 하야테는 조금 알토랑 닮았단 말이지.\\n그래서 조금 말하기 편하다고 해야 하나…"

msgid "adv_301502_0025_msg"
msgstr "…별로 안 닮은 것 같은데"

msgid "adv_301502_0026_msg"
msgstr "알토!"

msgid "adv_301502_0027_msg"
msgstr "어이, 알토"

msgid "adv_301502_0028_msg"
msgstr "이런 데 있었구나"

msgid "adv_301502_0029_msg"
msgstr "알토가 아무리 기다려도 안 오니까 그렇잖아"

msgid "adv_301502_0030_msg"
msgstr "내 탓이냐"

msgid "adv_301502_0031_msg"
msgstr "자, 내 볼일은 끝났으니까 간다.\\n또 보자! 알토, 셰릴"

msgid "adv_301502_0032_msg"
msgstr "어? 아, 응…"

msgid "adv_301502_0034_msg"
msgstr "있잖아, 알토! 오늘 라이브 어땠어?"

msgid "adv_301502_0035_msg"
msgstr "너다운 화려한 라이브였던 것 같은데?\\n다들 축하도 해줬고 말이야"

msgid "adv_301502_0036_msg"
msgstr "어라? 그러고 보니…\\n아직 알토한테는 축하를 못 받았는데"

msgid "adv_301502_0037_msg"
msgstr "뭐? 그건… 정말"

msgid "adv_301502_0038_msg"
msgstr "…셰릴"

msgid "adv_301502_0039_msg"
msgstr "왜?"

msgid "adv_301502_0040_msg"
msgstr "생일, 축하해"

msgid "adv_301502_0041_msg"
msgstr "후훗! 고마워, 알토!\\n앞으로도 최고의 노래를 은하에 울려 퍼뜨릴게"

msgid "adv_301502_0042_msg"
msgstr "…그래"

msgid "adv_101801_0008_msg"
msgstr "미라쥬, 저거 봐!\\n기념 발키리라… 생각보다 괜찮은데!"

msgid "adv_101801_0009_msg"
msgstr "분명… 오늘 우리는 저 기체에 타는 거지?"

msgid "adv_101801_0010_msg"
msgstr "네. 오늘 식전을 위해 준비된 기체입니다.\\n잘 들으세요, 하야테.\\n평소처럼 무모하게 비행하지만 마세요"

msgid "adv_101801_0011_msg"
msgstr "그래도 식전이라고 할 만큼 딱딱한 건 아니잖아?"

msgid "adv_101801_0012_msg"
msgstr "게다가 메인은 왈큐레의 백신 라이브고,\\n우리는 기념행사에 분위기를 더하는 정도라고 했잖아"

msgid "adv_101801_0013_msg"
msgstr "그렇다면 뭔가 특별한 걸 하는 편이\\n낫지 않을까?"

msgid "adv_101801_0014_msg"
msgstr "안 됩니다!"

msgid "adv_101801_0015_msg"
msgstr "그렇게 말하고 무모하게 날다가\\n소중한 기체에 흠집이라도 내면 어쩌려고요?"

msgid "adv_101801_0016_msg"
msgstr "포메이션을 흐트러뜨리지 말고, 아라드 대장과 제\\n지시에 따르세요. 알겠습니까? 하야테 소위"

msgid "adv_101801_0017_msg"
msgstr "네네"

msgid "adv_101801_0018_msg"
msgstr "또 그렇게 대충 대답하고…\\n정말 이해한 겁니까?"

msgid "adv_101801_0019_msg"
msgstr "알았다니까"

msgid "adv_101801_0021_msg"
msgstr "자자, 둘 다!\\n이제 라이브인데 싸울 때가 아니잖아!"

msgid "adv_101801_0023_msg"
msgstr "하핫! 하야테 녀석, 기운이 넘치나 보군.\\n오늘도 모두 컨디션이 좋아 보여서 다행이야"

msgid "adv_101801_0024_msg"
msgstr "…그냥 둬도 괜찮습니까, 대장"

msgid "adv_101801_0025_msg"
msgstr "하야테랑 미라쥬 말이지? 그러게…\\n뭐, 어떻게든 되겠지"

msgid "adv_101801_0027_msg"
msgstr "…정말, 뭐야 미라쥬 녀석"

msgid "adv_101801_0029_msg"
msgstr "라이브 전인데 꽤 시끌벅적하네"

msgid "adv_101801_0030_msg"
msgstr "미쿠모!"

msgid "adv_101801_0031_msg"
msgstr "임멜만 댄스…\\n오늘은 못 보나 봐?"

msgid "adv_101801_0032_msg"
msgstr "뭐… 일단은, 일단"

msgid "adv_101801_0033_msg"
msgstr "일단?"

msgid "adv_101801_0034_msg"
msgstr "내가 춤출 생각이 없어도\\n라이브 중에 좋은 노래가 들리면\\n나도 모르게 춤춰버릴 수도 있잖아?"

msgid "adv_101801_0035_msg"
msgstr "……후훗, 그렇구나"

msgid "adv_101801_0036_msg"
msgstr "그런 거지"

msgid "adv_101801_0037_msg"
msgstr "미쿠모. 오늘 라이브,\\n나도 모르게 춤추고 싶어질 만한 노래 부탁할게"

msgid "adv_101801_0038_msg"
msgstr "춤추고 싶어질 만한 노래라.\\n난 내가 부르고 싶은 대로 부를 뿐이야"

msgid "adv_101801_0039_msg"
msgstr "하지만… 그러네"

msgid "adv_101801_0040_msg"
msgstr "일단 기억해둘게"

msgid "adv_101801_0041_msg"
msgstr "그래! 그래야지"

msgid "adv_101802_0008_msg"
msgstr "아! 쿠모쿠모 발견!"

msgid "adv_101802_0009_msg"
msgstr "마키나"

msgid "adv_101802_0010_msg"
msgstr "에헤헤, 데리러 왔습니다~!\\n이제 나체냥냥에 갈 건데, 쿠모쿠모도 어떨까 싶어서!"

msgid "adv_101802_0011_msg"
msgstr "그래"

msgid "adv_101802_0012_msg"
msgstr "…후훗"

msgid "adv_101802_0013_msg"
msgstr "왜?"

msgid "adv_101802_0014_msg"
msgstr "…오늘 라이브 중의 쿠모쿠모, 정말 즐거워 보였어"

msgid "adv_101802_0015_msg"
msgstr "그랬나?"

msgid "adv_101802_0016_msg"
msgstr "정말 기분 좋게 노래하고 있었다고 해야 하나…\\n보고 있던 우리까지 저절로 즐거워졌다고 해야 하나!"

msgid "adv_101802_0017_msg"
msgstr "난 내가 부르고 싶은 대로 불렀을 뿐"

msgid "adv_101802_0018_msg"
msgstr "하지만… 그러네.\\n가끔은 이렇게 놀라움이 있는 라이브도\\n괜찮을지도 모르겠다고 생각했어"

msgid "adv_101802_0019_msg"
msgstr "분명 레이나가 장난칠 때도,\\n이런 기분이겠지"

msgid "adv_101802_0020_msg"
msgstr "레이레이에 쿠모쿠모까지…\\n왈큐레에는 장난꾸러기가 많네!"

msgid "adv_101802_0021_msg"
msgstr "…기뻐 보이네"

msgid "adv_101802_0022_msg"
msgstr "그야 그렇게 즐겁게 노래하는\\n쿠모쿠모를 보면 기뻐질 수밖에 없잖아"

msgid "adv_101802_0023_msg"
msgstr "나는 모두가 정말 좋으니까!"

msgid "adv_101802_0024_msg"
msgstr "…그래"

msgid "adv_101802_0025_msg"
msgstr "좋아, 그럼 쿠모쿠모!\\n같이 밥 먹으러 가자~!"

msgid "adv_101802_0026_msg"
msgstr "물론 미라미라를 비롯한 델타 소대 모두도 있어"

msgid "adv_101802_0027_msg"
msgstr ""

msgid "adv_101802_0028_msg"
msgstr "…알겠어"

msgid "adv_000120_0003_msg"
msgstr "루카, 왜 그래? 갑자기…"

msgid "adv_000120_0004_msg"
msgstr "알토 선배, 미셸 선배!\\n갑자기 불러서 죄송합니다!"

msgid "adv_000120_0005_msg"
msgstr "그건 괜찮아.\\n그런데 급히 알려줄 게 있다니… 대체 무슨 일이야?"

msgid "adv_000120_0006_msg"
msgstr "사실 얼마 전에 알토 선배가 초시공 네트워크에서\\n가져온 데이터 말인데요…"

msgid "adv_000120_0007_msg"
msgstr "아, 발키리 오퍼레이션 중에 찾은 데이터 말이지.\\n평소와 뭔가 다른 느낌이 들었는데…"

msgid "adv_000120_0008_msg"
msgstr "네. 그걸 분석해봤더니,\\n지금까지 없었던 데이터라는 걸 알게 됐습니다"

msgid "adv_000120_0009_msg"
msgstr "지금까지 없었던 데이터?"

msgid "adv_000120_0010_msg"
msgstr "헤에… 초시공 네트워크 세계는 아직도 미지의 영역이 많네"

msgid "adv_000120_0011_msg"
msgstr "그래서 레이나 씨와 마키나 씨와 함께\\n데이터 분석을 진행한 결과…"

msgid "adv_000120_0013_msg"
msgstr "발키리 강화에 쓸 수 있을 것 같다는 걸 알아냈어"

msgid "adv_000120_0014_msg"
msgstr "우왓! 레이나 씨!?\\n갑자기 나타나지 마세요!"

msgid "adv_000120_0015_msg"
msgstr "악의는 없어"

msgid "adv_000120_0016_msg"
msgstr "발키리 강화… 그런 것도 가능한 건가"

msgid "adv_000120_0017_msg"
msgstr "할 수 있어. 나랑 마키나의 노력의 결정"

msgid "adv_000120_0018_msg"
msgstr "…그리고 루카도"

msgid "adv_000120_0019_msg"
msgstr "…덤처럼 말하지 말아주세요"

msgid "adv_000120_0020_msg"
msgstr "하지만 아직 완벽하진 않아"

msgid "adv_000120_0022_msg"
msgstr "완벽하지 않다니… 무슨 뜻이야?"

msgid "adv_000120_0023_msg"
msgstr "이미 발키리를 강화하는 데는 성공했어.\\n하지만 더 강화하려면 아직 데이터가 부족해"

msgid "adv_000120_0024_msg"
msgstr "아무래도 데이터 자체에 알 수 없는 부분이 많으니까요…\\n분석을 전부 끝내려면 조금 더 시간이 필요합니다"

msgid "adv_000120_0025_msg"
msgstr "…하지만 새의 인간이 내뿜는 멸망의 노래의 위협은 계속되고 있습니다.\\n앞으로의 전투에 대비하기 위해서라도,\\n발키리를 더 강화하는 건 아주 중요하다고 생각합니다"

msgid "adv_000120_0026_msg"
msgstr "발키리 오퍼레이션 때\\n강화에 쓸 수 있는 데이터를 찾으면 가져와줬으면 해"

msgid "adv_000120_0027_msg"
msgstr "…그렇군.\\n자기 기체를 강하게 만들고 싶으면 직접 데이터를 모아오라는 거네"

msgid "adv_000120_0028_msg"
msgstr "그래"

msgid "adv_000120_0030_msg"
msgstr "알겠어"

msgid "adv_000120_0031_msg"
msgstr "그럼 기체가 있는 곳으로 가죠!\\n자세한 설명은 거기서 할게요"

msgid "adv_000120_0032_msg"
msgstr "그래"

msgid "adv_000130_0003_msg"
msgstr "자자~! 다들 주목!\\n지금부터 모두에게 중대 발표를 하겠습니다!"

msgid "adv_000130_0004_msg"
msgstr "주목할 것"

msgid "adv_000130_0005_msg"
msgstr "네!?"

msgid "adv_000130_0007_msg"
msgstr "네엣!"

msgid "adv_000130_0009_msg"
msgstr "…이번엔 또 뭘 시작하려는 걸까"

msgid "adv_000130_0010_msg"
msgstr "…있잖아, 사실 우리는\\n평소부터 뭔가 부족하다고 생각하고 있었거든"

msgid "adv_000130_0012_msg"
msgstr "뭔가…?"

msgid "adv_000130_0013_msg"
msgstr "응. 초시공 SNS, 초시공 유닛 라이브…\\n초시공 네트워크를 이용해서,\\n레이레이가 여러 가지를 발명했잖아?"

msgid "adv_000130_0014_msg"
msgstr "덕분에 시공을 넘어 많은 사람들과\\n교류할 수 있게 됐지만, 계속 뭔가 부족한 느낌이 들었어…"

msgid "adv_000130_0015_msg"
msgstr "부족한 것… 음, 딱히 생각나는 게 없네요"

msgid "adv_000130_0017_msg"
msgstr "다들 각자 마음대로 교류하고 있고,\\n나름대로 만족하고 있지 않아?"

msgid "adv_000130_0019_msg"
msgstr "…나도 딱히 떠오르는 건 없네"

msgid "adv_000130_0020_msg"
msgstr "그런데 말이야, 우리 드디어 깨달았어!"

msgid "adv_000130_0022_msg"
msgstr "오오!! 그게 뭔데요?"

msgid "adv_000130_0023_msg"
msgstr "귀여움이 부족하다는 거야!"

msgid "adv_000130_0024_msg"
msgstr "…오오?"

msgid "adv_000130_0025_msg"
msgstr "그래서 레이레이한테 부탁해서, 내 취향대로 귀여운 교류 공간을\\n초시공 네트워크상에 만들어버렸습니다~!"

msgid "adv_000130_0026_msg"
msgstr "어!? 벌써 만들어놨어?"

msgid "adv_000130_0028_msg"
msgstr "그 이름하여 데카르챠 모드"

msgid "adv_000130_0029_msg"
msgstr "데카르챠??"

msgid "adv_000130_0030_msg"
msgstr "초시공 유닛 라이브는 여러 곳에서 동시에 기동하면\\n초시공 네트워크에 부하가 걸릴 때도 있어서…"

msgid "adv_000130_0031_msg"
msgstr "파티처럼 모두가 한꺼번에 모일 수 있는 이벤트는\\n좀처럼 열기 어려웠잖아?"

msgid "adv_000130_0032_msg"
msgstr "그래서 모두가 부담 없이 모일 수 있는 방을 만드는 건\\n어떨까 싶었어!\\n방이라면 귀엽게 꾸밀 수도 있고!"

msgid "adv_000130_0033_msg"
msgstr "게다가 방에 있을 때는 초시공 유닛 라이브처럼\\n다른 시공의 사람들과 평범하게 대화할 수도 있어~!"

msgid "adv_000130_0034_msg"
msgstr "기운 팍팍!?"

msgid "adv_000130_0035_msg"
msgstr "그야 귀여운 방에 가면\\n분명 친구들이랑 이야기하고 싶어질 테니까!"

msgid "adv_000130_0036_msg"
msgstr "테니까"

msgid "adv_000130_0037_msg"
msgstr "참고로 데카르챠 모드 중에,\\n현실 세계의 사람과 이야기하고 싶을 때는 채팅으로 대화하는 것도 가능"

msgid "adv_000130_0039_msg"
msgstr "그건 대단하네…"

msgid "adv_000130_0040_msg"
msgstr "어떤 방으로 꾸밀까~라든지, 이야기도 잔뜩 할 수 있겠다~라든지…\\n새로운 즐거움이 늘어날 것 같지?"

msgid "adv_000130_0041_msg"
msgstr "모처럼 만났잖아!\\n모두랑 더 많이, 더 많이 친해질 계기가 생기면 좋겠어…"

msgid "adv_000130_0043_msg"
msgstr "그렇구나…"

msgid "adv_000130_0044_msg"
msgstr "후훗! 마키나다운 생각이네.\\n확실히 지금보다 서로를 더 잘 알게 돼서 더욱 협력할 수 있다면,\\n정말 든든할 것 같아"

msgid "adv_000130_0045_msg"
msgstr "앞으로 기다리고 있을지도 모르는 어려움에도 함께 맞설 수 있는…\\n그런 관계가 될 수 있겠네"

msgid "adv_000130_0046_msg"
msgstr "근데 초시공 네트워크상에 있는 방이라니\\n왠지 상상이 안 되네요…?"

msgid "adv_000130_0048_msg"
msgstr "괜찮아, 프레프레! 직접 보면 바로 알 수 있으니까!\\n그럼 바로 방에 가보자~!"

msgid "adv_000130_0049_msg"
msgstr "기운 팍팍~!"

msgid "adv_000140_0003_msg"
msgstr "뭐야, 이거… 대체 어떻게 된 거야!?"

msgid "adv_000140_0004_msg"
msgstr "적의 습격입니다! 일단 서둘러 출격 준비를 해주세요!"

msgid "adv_000140_0005_msg"
msgstr "원인은 불명이지만… 흉포해진 적들이 무리를 지어\\n우리를 공격하려는 것 같습니다!"

msgid "adv_000140_0006_msg"
msgstr "뭐!?"

msgid "adv_000140_0007_msg"
msgstr "됐으니 서두르세요, 하야테!\\n프레이아를 비롯한 왈큐레가 위험해질 겁니다!"

msgid "adv_000140_0008_msg"
msgstr "젠장! 알고 있다니까!"

msgid "adv_000140_0012_msg"
msgstr "어, 어이, 메서!\\n이 정도 숫자의 적을 델타 소대만으로는…"

msgid "adv_000140_0013_msg"
msgstr "이미 지원 요청은 해뒀다.\\n…지원군이 도착할 때까지 버틴다"

msgid "adv_000140_0014_msg"
msgstr "…알겠습니다!"

msgid "adv_000140_0018_msg"
msgstr "…이미 들었을 거라 생각하지만,\\n우리는 지금 전례 없는 위기에 직면해 있다"

msgid "adv_000140_0019_msg"
msgstr "새의 인간이 내뿜는 멸망의 노래의 영향인 건 확실하지만…\\n이 정도로 대규모인 전투는 처음이다.\\n지금까지 이상으로 힘을 합칠 필요가 있어"

msgid "adv_000140_0020_msg"
msgstr "실제로 린 민메이, Fire Bomber, 셰릴 놈,\\n란카 리, 그리고 왈큐레는 협력해서\\n대규모 라이브를 열기로 결정했다"

msgid "adv_000140_0021_msg"
msgstr "그야말로 총력 라이브…라고 할 수 있겠군"

msgid "adv_000140_0022_msg"
msgstr "그래서 카오스 대원인 자네에게도 협력해줬으면 한다"

msgid "adv_000140_0023_msg"
msgstr "이미 임시로 여러 부대가 편성되어 있다.\\n이제 그 부대로 가서 다른 대원들과 연락을 주고받으며,\\n협력해서 임무를 수행해주길 바란다"

msgid "adv_000140_0024_msg"
msgstr "처음에는 모르는 사람들끼리 연계하는 게 어려울 수도 있지만…\\n뭐, 정 안 되면 마크로스 캐논도 있으니까. 안심해"

msgid "adv_000140_0025_msg"
msgstr "모든 시공과 은하를 위한 싸움이다. 건투를 빈다"

msgid "adv_000140_0029_msg"
msgstr "다들 모였지?"

msgid "adv_000140_0031_msg"
msgstr "네엣!"

msgid "adv_000140_0032_msg"
msgstr "준비는 완벽해!"

msgid "adv_000140_0034_msg"
msgstr "이렇게 열 명이 나란히 서 있으니까 장관이네~!"

msgid "adv_000140_0035_msg"
msgstr "그러네!"

msgid "adv_000140_0037_msg"
msgstr "초시공 유닛 라이브에서 쌓아온 경험을\\n마음껏 살려보겠어"

msgid "adv_000140_0038_msg"
msgstr "뜨거운 라이브로 만들어주지"

msgid "adv_000140_0040_msg"
msgstr "그럼 은하를 건 총력 라이브, 시작하자!"

msgid "adv_201701_0008_msg"
msgstr "안녕, 미라쥬"

msgid "adv_201701_0009_msg"
msgstr "…! 할아버지, 그리고 할머니!"

msgid "adv_201701_0010_msg"
msgstr "초시공 유닛 라이브로 뵙는 건 처음이네요…\\n오늘 잘 부탁드립니다!"

msgid "adv_201701_0011_msg"
msgstr "그렇게 딱딱하게 굴 필요는 없어, 미라쥬"

msgid "adv_201701_0012_msg"
msgstr "맥스. 가족이라 해도 윗사람을 존중하는\\n미라쥬의 태도는 군인으로서 옳다"

msgid "adv_201701_0013_msg"
msgstr "좋은 마음가짐이구나, 미라쥬"

msgid "adv_201701_0014_msg"
msgstr "가, 감사합니다…!"

msgid "adv_201701_0015_msg"
msgstr "그런데 우리를 여기로 부른 장본인은\\n대체 어디 있는 걸까?"

msgid "adv_201701_0017_msg"
msgstr "아빠, 엄마, 미라쥬!\\n내 라이브에 온 걸 환영해!"

msgid "adv_201701_0018_msg"
msgstr "이모님! 그 의상은…?"

msgid "adv_201701_0019_msg"
msgstr "후훗! 어때? 잘 어울려?\\n오늘은 내 마법을 마음껏 즐기게 해줄게!"

msgid "adv_201701_0020_msg"
msgstr "마법…인가요?"

msgid "adv_201701_0021_msg"
msgstr "있잖아, 미라쥬! 이 실크햇 안을 들여다보고,\\n안에 아무것도 없는지 확인해봐"

msgid "adv_201701_0022_msg"
msgstr "…? 네, 네…"

msgid "adv_201701_0023_msg"
msgstr "쓰리… 투… 원!"

msgid "adv_201701_0024_msg"
msgstr ""

msgid "adv_201701_0025_msg"
msgstr "실크햇에서 비둘기가 나왔어요…!"

msgid "adv_201701_0026_msg"
msgstr "굉장한 마술이네"

msgid "adv_201701_0027_msg"
msgstr "하아… 조금 긴장했지만 잘돼서 다행이다.\\n이거 할 수 있게 될 때까지 몇 번이나 연습했어!"

msgid "adv_201701_0028_msg"
msgstr "대단합니다, 이모님!\\n…그런데 왜 마술을?"

msgid "adv_201701_0029_msg"
msgstr "음… 사실 오늘은,\\n가족을 위한 특별한 라이브를 하고 싶었어"

msgid "adv_201701_0030_msg"
msgstr "다들 시공을 넘어 만날 수 있었던\\n내 소중한 가족이잖아?"

msgid "adv_201701_0031_msg"
msgstr "이렇게 만날 기회는 좀처럼 없으니까…\\n한 번쯤은 그런 라이브를 해도 괜찮겠다 싶어서"

msgid "adv_201701_0032_msg"
msgstr "이모님…"

msgid "adv_201701_0033_msg"
msgstr "시공을 초월한 가족이라… 확실히 그렇네"

msgid "adv_201701_0034_msg"
msgstr "고마워, 밀레느.\\n…너처럼 밝은 딸을 둘 수 있다니\\n미래의 우리는 행복한 사람들이구나"

msgid "adv_201701_0035_msg"
msgstr "그렇지, 미리아"

msgid "adv_201701_0037_msg"
msgstr "그래"

msgid "adv_201701_0038_msg"
msgstr "고마워!\\n그럼 지너스 가족 여러분! 준비됐어~?"

msgid "adv_201701_0039_msg"
msgstr "노래와 마술이 함께하는 즐거운 라이브! 신나게 가보자~!"

msgid "adv_201701_0041_msg"
msgstr "네! 이모님!"

msgid "adv_201702_0008_msg"
msgstr "미라쥬 씨.\\n오늘 밀레느 씨의 라이브에 와주셔서\\n감사합니다"

msgid "adv_201702_0009_msg"
msgstr "아니에요. 저도 정말 즐거웠습니다!"

msgid "adv_201702_0010_msg"
msgstr "이모님께서 일부러 오늘을 위해\\n마술 연습까지 하셨다고 해서… 정말 감동했어요"

msgid "adv_201702_0011_msg"
msgstr "하지만 그와 동시에 조금은\\n죄송한 마음도 들었습니다"

msgid "adv_201702_0012_msg"
msgstr "죄송한 마음…이요?"

msgid "adv_201702_0013_msg"
msgstr "네. 이모님은 이렇게까지 저를 생각해주시는데\\n제가 이모님께 해드릴 수 있는 건 너무 적어서요…"

msgid "adv_201702_0014_msg"
msgstr "…미라쥬 씨는 정말 상냥한 분이네요.\\n그런 점은 밀레느 씨와 닮은 것 같아요"

msgid "adv_201702_0015_msg"
msgstr "네…?"

msgid "adv_201702_0016_msg"
msgstr "사실 저와 바사라도 조금은 마술\\n연습을 함께했는데,\\n밀레느 씨는 정말 열심히 하셨어요"

msgid "adv_201702_0017_msg"
msgstr "가족 모두를 기쁘게 해주겠다고 의욕이 넘쳤으니까요"

msgid "adv_201702_0018_msg"
msgstr "그러니 분명 밀레느 씨는 미라쥬 씨가\\n그저 즐겨주기만 해도 그걸로 충분할 거예요"

msgid "adv_201702_0019_msg"
msgstr "…감린 씨"

msgid "adv_201702_0020_msg"
msgstr "…이모님은 정말 훌륭한 분이네요.\\n동경하게 돼요"

msgid "adv_201702_0021_msg"
msgstr "네, 정말로…"

msgid "adv_201702_0023_msg"
msgstr "밀레느"

msgid "adv_201702_0024_msg"
msgstr "왜 그래, 바사라?"

msgid "adv_201702_0025_msg"
msgstr "…아, 알겠다!\\n오늘 라이브에서 바사라 파트가 적어서 불만인 거지~?"

msgid "adv_201702_0026_msg"
msgstr "아니거든"

msgid "adv_201702_0027_msg"
msgstr "오늘 라이브, 마술까지 할 필요는 없었던 거 아니야?"

msgid "adv_201702_0028_msg"
msgstr "가족을 대접하는 거라면\\n오늘 네 노래만으로도 충분했잖아?"

msgid "adv_201702_0029_msg"
msgstr "음… 뭐라고 해야 할까?"

msgid "adv_201702_0030_msg"
msgstr "조금 특별한 라이브로 만들고 싶었어.\\n아빠, 엄마, 미라쥬…\\n앞으로도 모두와 친구 같은 가족으로 지내고 싶으니까!"

msgid "adv_201702_0031_msg"
msgstr "그렇구나"

msgid "adv_201702_0032_msg"
msgstr "뭐야~.\\n자기가 물어봐 놓고 반응이 너무 시큰둥하잖아"

msgid "adv_201702_0033_msg"
msgstr "…그보다 아까 그 말!\\n대접하는 것뿐이라면 내 노래만으로도 충분하다고…\\n그게 무슨 뜻이야?"

msgid "adv_201702_0034_msg"
msgstr "내가 그런 말 했나?"

msgid "adv_201702_0035_msg"
msgstr "했잖아!!"

msgid "adv_201702_0036_msg"
msgstr "기억 안 나는데"

msgid "adv_201702_0037_msg"
msgstr "그보다 빨리 준비해. 다음 라이브 시작한다"

msgid "adv_201702_0038_msg"
msgstr "정말! 진짜 제멋대로라니까~!"

msgid "adv_301601_0008_msg"
msgstr ""

msgid "adv_301601_0009_msg"
msgstr "어이, 알토.\\r\\n갑자기 불러내고… 무슨 일 있어?"

msgid "adv_301601_0010_msg"
msgstr "상담할 게 있다고 했는데…\\r\\n감린이나 맥스도 부르는 게 낫지 않았어?"

msgid "adv_301601_0011_msg"
msgstr "아니, 그렇게 대단한 건 아니야.\\r\\n그… 오늘 크리스마스잖아?"

msgid "adv_301601_0012_msg"
msgstr "…크리스마스 선물에 관한 건데"

msgid "adv_301601_0013_msg"
