msgid "adv_100402_0021_msg"
msgstr "그렇군요. 확실히 하야테와 미라쥬도\\n지난번 여기서 라이브했을 때와 비교하면 성장했습니다"

msgid "adv_100402_0022_msg"
msgstr "메서는… 여전하지만요"

msgid "adv_100402_0023_msg"
