msgid "adv_101403_0029_msg"
msgstr "안 했거든!"

msgid "adv_101403_0030_msg"
msgstr "갑자기 답장이 끊긴 건 조금 걱정되네요.\\n무슨 문제라도 생긴 걸까요?"

msgid "adv_101403_0031_msg"
msgstr "음… 나도 히카루한테 한번 물어볼까.\\n혹시 짐작 가는 게 있을지도 모르고… 어라?"

msgid "adv_101403_0032_msg"
msgstr ""

msgid "adv_101403_0033_msg"
msgstr "하야테, 왜 그래?\\n그렇게 허둥대고…"

msgid "adv_101403_0034_msg"
msgstr "…큰일 났다"

msgid "adv_101403_0035_msg"
msgstr "…내 단말기가 없어"

msgid "adv_101403_0038_msg"
msgstr "아까 전투가 끝난 뒤 주운 이 단말기…\\n아무래도 하야테 임멜만의 물건인 것 같군"

msgid "adv_101403_0039_msg"
msgstr "…이런 걸 떨어뜨리다니, 어리석은 녀석이다"

msgid "adv_101403_0040_msg"
msgstr "하지만 이걸 이용하면\\n델타 소대에 관한 유력한 정보를 얻을 수 있을지도 몰라"

msgid "adv_101403_0041_msg"
msgstr "잘만 하면, 윈더미어의 백성들을 괴롭히고 있는\\n수수께끼의 기억 소실 원인도…"

msgid "adv_101403_0042_msg"
msgstr "어쨌든 하야테 임멜만인 척해서,\\n뭔가 정보를 캐내볼까"

msgid "adv_101403_0043_msg"
msgstr "…넥키 바사라? 어디선가 들어본 이름이군.\\n뭐, 됐다. 우선 이 녀석부터다"

msgid "adv_101403_0045_msg"
msgstr "――충격의 라이브까지, 앞으로 5시간"

msgid "adv_101404_0003_msg"
msgstr "좌우 주머니"

msgid "adv_101404_0004_msg"
msgstr "없어"

msgid "adv_101404_0005_msg"
msgstr "벗어 던져둔 파일럿 슈트"

msgid "adv_101404_0006_msg"
msgstr "없어"

msgid "adv_101404_0007_msg"
msgstr "하아…"

msgid "adv_101404_0008_msg"
msgstr "하야테가 잃어버린 단말기라는 게… 초시공 SNS 연락용으로\\n지급받은 그 단말기야?"

msgid "adv_101404_0009_msg"
msgstr "응. 그나저나 이상하네…?\\n전투 전까지만 해도 분명 있었는데"

msgid "adv_101404_0010_msg"
msgstr "정말, 당신이라는 사람은…\\n악용이라도 당하면 어쩌려고요!\\n아무튼 빨리 레이나 씨에게 알려서…"

msgid "adv_101404_0012_msg"
msgstr "하야테!!"

msgid "adv_101404_0013_msg"
msgstr "…우왓! 밀레느?"

msgid "adv_101404_0014_msg"
msgstr "왜 그래?\\n갑자기 초시공 유닛 라이브를 기동하면 놀라잖아"

msgid "adv_101404_0015_msg"
msgstr "그건 그렇지만…!"

msgid "adv_101404_0016_msg"
msgstr "아무튼 하야테! 바사라를 용서해줘?\\n걔, 일부러 그런 건 아니야!"

msgid "adv_101404_0017_msg"
msgstr "이모님?\\n바사라 씨가…라니, 무슨 일이 있었던 건가요?"

msgid "adv_101404_0018_msg"
msgstr "그게… 나도 자세히는 모르겠는데\\n바사라가 하야테를 화나게 한 모양이야"

msgid "adv_101404_0020_msg"
msgstr "…? 하야테, 화난 거야?"

msgid "adv_101404_0021_msg"
msgstr "…아니?"

msgid "adv_101404_0023_msg"
msgstr "어, 안 화났어?"

msgid "adv_101404_0024_msg"
msgstr "…불길한 예감이 드네요.\\n저기, 이모님. 그 이야기 자세히 들려주시겠어요?"

msgid "adv_101404_0025_msg"
msgstr "응!\\n아까 우리한테 하야테가 메시지를 보냈거든.\\n분명… 우리가 멸해야 할 적에 대해 알려달라고"

msgid "adv_101404_0026_msg"
msgstr "그런데 바사라가 귀찮은 걸 싫어하잖아?\\n그 질문에 제대로 대답을 안 해서…\\n그래서 하야테가 장난치지 말라고 화냈고"

msgid "adv_101404_0027_msg"
msgstr "벌써 악용당하고 있잖아요!"

msgid "adv_101404_0028_msg"
msgstr "진짜냐…"

msgid "adv_101404_0029_msg"
msgstr "이모님, 안심하세요.\\n멸해야 할 적… 같은 어려운 표현은 하야테한테 불가능합니다"

msgid "adv_101404_0030_msg"
msgstr "아무래도 바사라 씨와 대화했던 건\\n하야테인 척한 다른 사람인 것 같습니다"

msgid "adv_101404_0031_msg"
msgstr "뭐어어!?"

msgid "adv_101404_0032_msg"
msgstr "…왠지 엄청 무시당한 기분인데"

msgid "adv_101404_0034_msg"
msgstr "우히히히…"

msgid "adv_101404_0035_msg"
msgstr "프레이아, 넌 왜 웃는 거야"

msgid "adv_101404_0036_msg"
msgstr "안 웃었거든~!"

msgid "adv_101404_0037_msg"
msgstr "하야테, 프레이아!\\n말다툼은 나중에 하세요"

msgid "adv_101404_0038_msg"
msgstr "알았다니까.\\n…그나저나 누가 내 단말기를 가지고 있는 거지?"

msgid "adv_101404_0039_msg"
msgstr "…서둘러 찾아야겠네요"

msgid "adv_101404_0041_msg"
msgstr "…잘은 모르겠지만,\\n화를 낸 게 아니라서 다행이야"

msgid "adv_101404_0042_msg"
msgstr "또 뭔가 알게 되면 연락할게!"

msgid "adv_101404_0045_msg"
msgstr "아~ 다행이다!\\n그 작전 전에 화나게 했다면… 어쩌나 했어"

msgid "adv_101404_0046_msg"
msgstr "네, 밀레느 씨. 하지만 단말기를 잃어버리다니…"

msgid "adv_101404_0047_msg"
msgstr "분명 레이나라면 어떻게든 해주지 않을까?"

msgid "adv_101404_0048_msg"
msgstr "그보다 그 작전에 집중해야지!"

msgid "adv_101404_0049_msg"
msgstr "모처럼 왈큐레 모두를 위해 준비한\\n비장의 작전이니까, 반드시 성공시켜야 해!"

msgid "adv_101404_0050_msg"
msgstr "네!"

msgid "adv_101404_0051_msg"
msgstr "있잖아요, 감린 씨! 그런데 바사라는…?\\n아까까지만 해도 이 근처에 있었던 것 같은데"

msgid "adv_101404_0052_msg"
msgstr "그러고 보니 아까부터 모습이 안 보이네요…"

msgid "adv_101404_0053_msg"
msgstr "…설마 또 어디론가 가버린 거야!?\\n정말~!!"

msgid "adv_101404_0054_msg"
msgstr "아무튼 민메이 씨 일행에게 폐를 끼치지 않게\\n빨리 바사라를 찾아야 해!"

msgid "adv_101404_0055_msg"
msgstr "저도 도와드리겠습니다, 밀레느 씨!"

msgid "adv_101404_0058_msg"
msgstr "넥키 바사라… 대체 뭐 하는 녀석이지.\\n메시지를 읽고도 전혀 답장을 하지 않다니!"

msgid "adv_101404_0059_msg"
msgstr "겨우 말을 하나 했더니, 이쪽 이야기는 아랑곳하지 않고\\n더러운 노래에 대해서 일방적으로 떠들어대다니…"

msgid "adv_101404_0060_msg"
msgstr "다음에야말로 유력한 정보를!"

msgid "adv_101404_0061_msg"
msgstr "…흥, 이 녀석이면 괜찮겠지.\\n제대로 말해줘야겠다, 사신"

msgid "adv_101404_0063_msg"
msgstr "――충격의 라이브까지, 앞으로 4시간"

msgid "adv_101405_0003_msg"
msgstr ""

msgid "adv_101405_0004_msg"
msgstr "그래서 말인데, 이번에 아라드 대장이랑 같이\\n그 바렛타네코쿠라게를 먹기로 했는데\\n메서 군도… 그러니까"

msgid "adv_101405_0005_msg"
msgstr "메서 군, 꽤 험악한 표정으로 단말기를 보고 있는데…\\n무슨 일 있었어?"

msgid "adv_101405_0006_msg"
msgstr "아닙니다"

msgid "adv_101405_0008_msg"
msgstr "그런가?"

msgid "adv_101405_0009_msg"
msgstr ""

msgid "adv_101405_0010_msg"
msgstr "…후훗, 뭔가 재미있는 일이 벌어지고 있나 보네"

msgid "adv_101405_0011_msg"
msgstr "…미쿠모 씨. 함부로 남의 단말기를 보지 마십시오"

msgid "adv_101405_0012_msg"
msgstr "어머, 신경 쓸 것 없잖아.\\n그보다 카나메도 한번 봐"

msgid "adv_101405_0013_msg"
msgstr "…이거, 하야테 군이 메서 군에게 보낸 메시지야?"

msgid "adv_101405_0014_msg"
msgstr "적의 최신 정보를 알려달라…니, 무슨 일이라도 있나.\\n평소랑 분위기가 다르다고 해야 하나"

msgid "adv_101405_0015_msg"
msgstr "…마치 전혀 모르는 사람 같네"

msgid "adv_101405_0016_msg"
msgstr "미쿠모?"

msgid "adv_101405_0017_msg"
msgstr "…아라드 대장에게 확인하고 오겠습니다"

msgid "adv_101405_0018_msg"
msgstr "메서, 답장은 나한테 맡겨줄래?"

msgid "adv_101405_0019_msg"
msgstr ""

msgid "adv_101405_0020_msg"
msgstr ""

msgid "adv_101405_0021_msg"
msgstr "…알겠습니다"

msgid "adv_101405_0024_msg"
msgstr "사신에게서 답장이 왔다!"

msgid "adv_101405_0025_msg"
msgstr "…당신에게 알려줄 것은 없어, 나는 그저 노래할 뿐"

msgid "adv_101405_0026_msg"
msgstr "…무슨 뜻이지. 무슨 암호인가?"

msgid "adv_101405_0027_msg"
msgstr "그나저나 키스 님께 들었던\\n사신의 인상과는 꽤 다른 것 같은데…"

msgid "adv_101405_0028_msg"
msgstr "…모르겠군"

msgid "adv_101405_0029_msg"
msgstr "이렇게 된 이상 다른 사람에게 묻는 편이 빠르겠어.\\n…란카 리, 이 녀석으로 해볼까"

msgid "adv_101405_0032_msg"
msgstr "…후훗"

msgid "adv_101405_0033_msg"
msgstr "미쿠모, 괜찮아?\\n메시지 말투가 메서 군 같지 않은데…"

msgid "adv_101405_0034_msg"
msgstr "문제없어.\\n저쪽이 가짜라면 이쪽도 가짜가 대답하면 될 뿐이야"

msgid "adv_101405_0035_msg"
msgstr "후훗…"

msgid "adv_101405_0036_msg"
msgstr "…정말 괜찮은 걸까"

msgid "adv_101405_0039_msg"
msgstr "…정말, 단말기는 못 찾겠고,\\n메서한테는 말없이 노려보임만 당하고, 진짜 되는 일이 없네"

msgid "adv_101405_0040_msg"
msgstr "아라드 대장이 감싸줘서 다행이네.\\n미라쥬 녀석, 하야테 발키리 안을 샅샅이 뒤지고 있다며?"

msgid "adv_101405_0041_msg"
msgstr "아까 스쳐 지나갈 때 보니까 미간의 주름이\\n평소의 세 배쯤 늘어난 느낌이던데?"

msgid "adv_101405_0042_msg"
msgstr "…진짜냐"

msgid "adv_101405_0043_msg"
msgstr "빨리 찾아야겠네…\\n그나저나 정말 누가 가지고 있는 거지?"

msgid "adv_101405_0045_msg"
msgstr "…하야테, 잠깐 괜찮을까"

msgid "adv_101405_0046_msg"
msgstr "우왓!? 셰릴?"

msgid "adv_101405_0048_msg"
msgstr "――충격의 라이브까지, 앞으로 3시간"

msgid "adv_101406_0003_msg"
msgstr "셰릴, 무슨 일이야?"

msgid "adv_101406_0004_msg"
msgstr "하야테. 너, 초시공 SNS로 란카한테\\n꽤 무례한 메시지를 보냈다면서?"

msgid "adv_101406_0005_msg"
msgstr "무례한 메시지…라는 건,\\n란카한테도 보냈다는 거야?"

msgid "adv_101406_0006_msg"
msgstr "잠깐, 듣고 있어?\\n시치미 떼려고 해도 소용없어.\\n나도 옆에서 똑똑히 봤으니까"

msgid "adv_101406_0008_msg"
msgstr "저기, 셰릴 씨! 저는 괜찮아요!"

msgid "adv_101406_0009_msg"
msgstr "란카는 너무 착해.\\n이럴 때는 제대로 말해줘야 해"

msgid "adv_101406_0010_msg"
msgstr "그, 그래도…"

msgid "adv_101406_0012_msg"
msgstr "진정해, 셰릴"

msgid "adv_101406_0013_msg"
msgstr "알토!"

msgid "adv_101406_0014_msg"
msgstr "란카를 란카 리라고 부르기도 하고,\\n더러운 노래가 어쩌고, 위대한 바람이… 같은\\n알 수 없는 말을 하기도 했잖아"

msgid "adv_101406_0015_msg"
msgstr "메시지 말투가 분명히 달랐어.\\n하야테가 아니라 다른 녀석이 보냈을 가능성이 있어"

msgid "adv_101406_0016_msg"
msgstr "본인도 짐작 가는 게 없는 것 같고"

msgid "adv_101406_0017_msg"
msgstr "…그러고 보니 확실히 말투가 이상했네"

msgid "adv_101406_0018_msg"
msgstr "…살았다, 알토"

msgid "adv_101406_0019_msg"
msgstr "신경 쓰지 마"

msgid "adv_101406_0020_msg"
msgstr "하지만 정말 단말기를 잃어버린 거라면,\\n가능한 한 빨리 찾는 게 좋을 거야"

msgid "adv_101406_0021_msg"
msgstr "왜?"

msgid "adv_101406_0022_msg"
msgstr "…빨리 오해를 풀지 않으면,\\n납득하지 못할 사람들이 있으니까"

msgid "adv_101406_0025_msg"
msgstr ""

msgid "adv_101406_0026_msg"
msgstr ""

msgid "adv_101406_0028_msg"
msgstr "…그렇군"

msgid "adv_101406_0029_msg"
msgstr "정말, 오빠들도 참…\\n미안해, 하야테 군!"

msgid "adv_101406_0030_msg"
msgstr "아니, 딱히 신경 안 써.\\n애초에 내가 단말기를 잃어버린 게 잘못이니까"

msgid "adv_101406_0031_msg"
msgstr "후훗, 하야테 군은 상냥하네!"

msgid "adv_101406_0034_msg"
msgstr ""

msgid "adv_101406_0035_msg"
msgstr ""

msgid "adv_101406_0037_msg"
msgstr "…저 둘, 눈빛이 너무 매서운 거 아니냐?"

msgid "adv_101406_0038_msg"
msgstr "참아"

msgid "adv_101406_0039_msg"
msgstr "메시지는 깜짝 놀랐지만,\\n셰릴 씨가 걱정해줘서 왠지 기뻤어요"

msgid "adv_101406_0041_msg"
msgstr "당연하지, 란카.\\n란카는 소중한 동료고… 그, 뭐랄까"

msgid "adv_101406_0042_msg"
msgstr "…나한테 소중한 사람이니까"

msgid "adv_101406_0043_msg"
msgstr "셰릴 씨…!\\n물론 저한테도 셰릴 씨는 소중한 사람이에요!"

msgid "adv_101406_0044_msg"
msgstr "너희, 정말 사이좋구나"

msgid "adv_101406_0045_msg"
msgstr "지금까지 수많은 무대를 함께 헤쳐왔으니\\n당연하잖아"

msgid "adv_101406_0046_msg"
msgstr "하야테.\\n너는 일단 빨리 단말기부터 찾아"

msgid "adv_101406_0047_msg"
msgstr "그래"

msgid "adv_101406_0048_msg"
msgstr "셰릴 씨, 슬슬 연습하러 돌아가요!\\n민메이 씨랑 대사 연습도 해야 하고…"

msgid "adv_101406_0049_msg"
msgstr "응, 그러자"

msgid "adv_101406_0050_msg"
msgstr "그 전에 밀레느한테서\\n바사라 씨를 찾았다는 연락이 오면 좋겠는데…"

msgid "adv_101406_0051_msg"
msgstr "대사 연습? 바사라?\\n…아니, 그보다 민메이랑 연락이 돼?"

msgid "adv_101406_0052_msg"
msgstr "프레이아 녀석이 민메이한테 답장이 안 온다고\\n난리였거든"

msgid "adv_101406_0053_msg"
msgstr "그건, 그게…"

msgid "adv_101406_0054_msg"
msgstr "자, 란카, 가자!\\n그럼 우리는 이만"

msgid "adv_101406_0055_msg"
msgstr "아, 어이…!"

msgid "adv_101406_0057_msg"
msgstr "정말, 뭐야…?"

msgid "adv_101406_0059_msg"
msgstr "――충격의 라이브까지, 앞으로 2시간"

msgid "adv_101407_0003_msg"
msgstr "…왜지"

msgid "adv_101407_0004_msg"
msgstr "…란카 리에게 메시지를 보냈더니,\\n별의별 사람한테 추궁당했다"

msgid "adv_101407_0005_msg"
msgstr "특히 브레라 스턴, 오즈마 리…\\n이 녀석들은 대체 정체가 뭐지"

msgid "adv_101407_0006_msg"
msgstr "그나저나 정보가 전혀 손에 들어오질 않는군.\\n…린 민메이, 이번에야말로!"

msgid "adv_101407_0009_msg"
msgstr "후훗!"

msgid "adv_101407_0010_msg"
msgstr "민메이, 꽤 즐거워 보이네"

msgid "adv_101407_0011_msg"
msgstr "히카루!\\n응, 지금 하야테 군이랑 초시공 SNS로 대화하고 있어"

msgid "adv_101407_0012_msg"
msgstr "하야테랑? 별일이네"

msgid "adv_101407_0013_msg"
msgstr "그게 갑자기 내가 가진 최신 정보를\\n알려달라고 하더라고…"

msgid "adv_101407_0014_msg"
msgstr "무슨 얘기를 해야 할지 모르겠어서,\\n오늘 라이브 이야기랑 미사 씨랑 갔던 새 가게 이야기를 했어"

msgid "adv_101407_0015_msg"
msgstr "그리고 냥냥의 최신 메뉴도 보내줬어!\\n그런데 중간부터 답장이 안 오더라"

msgid "adv_101407_0016_msg"
msgstr "흐음.\\n그런데 하야테는 왜 그런 걸 알고 싶었던 걸까?"

msgid "adv_101407_0017_msg"
msgstr "오늘은 왠지 하야테 군 분위기도 평소랑 다른 것 같고…\\n혹시 프레이아랑 무슨 일이 있었던 걸지도 모르겠네"

msgid "adv_101407_0018_msg"
msgstr "둘이 늘 싸우니까"

msgid "adv_101407_0020_msg"
msgstr "히카루, 민메이. 이런 데 있었나"

msgid "adv_101407_0021_msg"
msgstr "선배!"

msgid "adv_101407_0022_msg"
msgstr "민메이, 그 준비가 끝난 모양이야.\\n바로 가봐"

msgid "adv_101407_0023_msg"
msgstr "네, 감사합니다!"

msgid "adv_101407_0024_msg"
msgstr "그 준비?"

msgid "adv_101407_0025_msg"
msgstr "뭐야, 히카루는 몰랐던 거야?"

msgid "adv_101407_0026_msg"
msgstr "대체 무슨 준비를 하고 있는 건데요"

msgid "adv_101407_0027_msg"
msgstr "그건 기대해두라는 거지"

msgid "adv_101407_0028_msg"
msgstr "에이… 뭐예요, 그게"

msgid "adv_101407_0031_msg"
msgstr "다들, 모여줘서 고마워!"

msgid "adv_101407_0033_msg"
msgstr "문제없어.\\n좋은 라이브를 만들려면 철저한 준비가 필요하니까"

msgid "adv_101407_0034_msg"
msgstr "어떤 라이브가 될지 두근두근하네요!"

msgid "adv_101407_0036_msg"
msgstr "다 같이 의논하는 데 늦지 않아서 다행이야~!\\n바사라는 금방 어디론가 가버린다니까.\\n정말 초조했어~"

msgid "adv_101407_0037_msg"
msgstr "왔으니까 됐잖아"

msgid "adv_101407_0038_msg"
msgstr "그런 문제가 아니거든~!"

msgid "adv_101407_0040_msg"
msgstr "후훗! 그럼 바로…\\n각자 부를 파트를 정해볼게요!"

msgid "adv_101407_0041_msg"
msgstr "부를 파트라…\\n나는 마키나나 카나메가 좋겠어!"

msgid "adv_101407_0042_msg"
msgstr "각자 부르고 싶은 대로 부르는 건 어때?"

msgid "adv_101407_0043_msg"
msgstr "그러면 제각각이 돼버리잖아!"

msgid "adv_101407_0045_msg"
msgstr "부를 파트… 그러네,\\n해보고 싶은 결정 대사로 정하는 건 어때?"

msgid "adv_101407_0047_msg"
msgstr "그거 좋네요!\\n왈큐레 멤버들은 각자 결정 대사가 있었으니까요"

msgid "adv_101407_0048_msg"
msgstr "그래, 그렇게 하자!"

msgid "adv_101407_0049_msg"
msgstr "후훗, 왈큐레 애들 분명 깜짝 놀라겠네!"

msgid "adv_101407_0051_msg"
msgstr "――충격의 라이브까지, 앞으로 1시간"

msgid "adv_101408_0003_msg"
msgstr ""

msgid "adv_101408_0004_msg"
msgstr "뭐야, 아직도 화났어?"

msgid "adv_101408_0005_msg"
msgstr "당연"

msgid "adv_101408_0006_msg"
msgstr "하야하야, 제대~로 반성해?\\n단말기를 잃어버렸으면 좀 더 빨리 말해줬어야지"

msgid "adv_101408_0007_msg"
msgstr "그러니까 미안하다니까"

msgid "adv_101408_0008_msg"
msgstr "해파리 칩스"

msgid "adv_101408_0009_msg"
msgstr "뭐?"

msgid "adv_101408_0010_msg"
msgstr "해파리 칩스"

msgid "adv_101408_0011_msg"
msgstr "…알았다니까, 다음에 가져다줄게"

msgid "adv_101408_0013_msg"
msgstr "그나저나 누군가 하야테 군 대신\\n단말기를 쓰고 있다니… 좀 큰일이 됐네.\\n레이나, 좋은 방법 없어?"

msgid "adv_101408_0014_msg"
msgstr "간단해"

msgid "adv_101408_0015_msg"
msgstr "이럴 때를 위한 원격 조작"

msgid "adv_101408_0016_msg"
msgstr "진짜냐"

msgid "adv_101408_0017_msg"
msgstr "초시공 네트워크 접속을 끊고,\\n초기화하면 괜찮아"

msgid "adv_101408_0018_msg"
msgstr "…물론 단말기를 폭파하는 것도 가능"

msgid "adv_101408_0020_msg"
msgstr "폭파!? 기, 기운 팍팍…"

msgid "adv_101408_0021_msg"
msgstr "잠깐만! 폭파는 하지 마!"

msgid "adv_101408_0023_msg"
msgstr "어머, 잃어버리면 곤란한 데이터라도 있나 봐?"

msgid "adv_101408_0024_msg"
msgstr "그런 건 아닌데, 다음 단말기를 지급받을 때까지\\n아무것도 못 하잖아"

msgid "adv_101408_0025_msg"
msgstr "자업자득"

msgid "adv_101408_0026_msg"
msgstr "윽…"

msgid "adv_101408_0028_msg"
msgstr "그러고 보니 하나 더 신경 쓰이는 게 있어"

msgid "adv_101408_0029_msg"
msgstr "신경 쓰이는 것?"

msgid "adv_101408_0030_msg"
msgstr "…초시공 네트워크 부하가\\n커지고 있는 에리어가 있어"

msgid "adv_101408_0031_msg"
msgstr "이 에리어, 민민 일행이 있는 곳이지?\\n대규모 초시공 유닛 라이브라도 하고 있는 걸까?"

msgid "adv_101408_0033_msg"
msgstr "민메이 씨라고 하니까… 아까부터\\n초시공 SNS로 메시지를 보내도 답장이 안 와요"

msgid "adv_101408_0034_msg"
msgstr "그건 좀 걱정되네…"

msgid "adv_101408_0035_msg"
msgstr "…후훗"

msgid "adv_101408_0036_msg"
msgstr "그렇다면 내 차례"

msgid "adv_101408_0037_msg"
msgstr "이제부터 해킹해서 알아볼 뿐"

msgid "adv_101408_0039_msg"
msgstr "잠깐, 레이나! 아무리 그래도…"

msgid "adv_101408_0041_msg"
msgstr "왈큐레 여러분! 잠깐 괜찮을까요?"

msgid "adv_101408_0043_msg"
msgstr "민메이 씨!"

msgid "adv_101408_0044_msg"
msgstr "…호랑이도 제 말 하면 온다더니"

msgid "adv_101408_0046_msg"
msgstr "민메이 씨, 마침 잘 오셨어요!\\n여쭤볼 게 있는데…"

msgid "adv_101408_0047_msg"
msgstr "카나메 씨! 그 전에 잠깐 이야기해도 될까요?"

msgid "adv_101408_0048_msg"
msgstr "…? 네"

msgid "adv_101408_0049_msg"
msgstr "저기… 초시공 SNS가 연결되고, 모두 함께 모일 수 있게 된 지\\n딱 1년이 됐잖아요?"

msgid "adv_101408_0050_msg"
msgstr "그래서 저, 꼭 왈큐레 여러분께\\n감사 인사를 하고 싶었어요"

msgid "adv_101408_0051_msg"
msgstr "감사 인사요?"

msgid "adv_101408_0052_msg"
msgstr "네. 멸망의 노래 영향으로 기억 소실이 진행돼서…\\n저, 처음엔 정말 어떻게 해야 할지 몰랐거든요"

msgid "adv_101408_0053_msg"
msgstr "하지만 모두와 이어질 수 있었기에,\\n이렇게 노래해서 마크로스 시티 사람들을 도울 수 있었어요"

msgid "adv_101408_0054_msg"
msgstr "그 감사한 마음을 전하고 싶었어요.\\n그런데 어떤 식으로 감사해야 왈큐레 여러분이\\n기뻐할까 정말 고민했거든요. 그랬더니…"

msgid "adv_101408_0056_msg"
msgstr "그런 건 노래밖에 없잖아"

msgid "adv_101408_0057_msg"
msgstr "…라는 바사라의 제안으로, 우리가\\n왈큐레 여러분의 노래를 부르기로 했어!"

msgid "adv_101408_0059_msg"
msgstr "저희 노래를요!?"

msgid "adv_101408_0061_msg"
msgstr "누가 어느 파트를 부를지도 제대로 의논해서 정했어!\\n리허설도 완벽하고"

msgid "adv_101408_0062_msg"
msgstr "오늘은 관객으로서 우리 노래를 들어줘"

msgid "adv_101408_0064_msg"
msgstr "――충격의 라이브, 시작"

msgid "adv_101409_0003_msg"
msgstr "「노래는, 사랑!」"

msgid "adv_101409_0005_msg"
msgstr "「노래는, 희망!」"

msgid "adv_101409_0007_msg"
msgstr "「노래는, 파이어!!」"

msgid "adv_101409_0009_msg"
msgstr "「노래는, 신비」"

msgid "adv_101409_0011_msg"
msgstr "「노래는 힘!」"

msgid "adv_101409_0013_msg"
msgstr "「들려줄게, 우리들의 노래를!」"

msgid "adv_101409_0020_msg"
msgstr "기운 팍팍…"

msgid "adv_101409_0021_msg"
msgstr "프레이아, 굳었어"

msgid "adv_101409_0022_msg"
msgstr "다들, 대단해~!! 안무도 완벽해!!"

msgid "adv_101409_0024_msg"
msgstr "…이렇게까지 강하게 울려 퍼지는 노래도 있구나"

msgid "adv_101409_0025_msg"
msgstr "내 말 맞지? 노래로 전하면 되는 거야"

msgid "adv_101409_0026_msg"
msgstr "이런 것도 나쁘지 않네. 정말 자극적인 라이브였어"

msgid "adv_101409_0028_msg"
msgstr "프레이아!\\n우리 라이브, 어땠어?"

msgid "adv_101409_0029_msg"
msgstr "진짜 기운 팍팍이라 말로 표현이 안 돼요…"

msgid "adv_101409_0030_msg"
msgstr "그렇게 좋아해줬다면 다행이네!"

msgid "adv_101409_0031_msg"
msgstr "그나저나 대단해~!\\n프레이아 머리에 있는 룬, 엄청 빛나네~!"

msgid "adv_101409_0032_msg"
msgstr "후왓! 보면 안 돼!"

msgid "adv_101409_0033_msg"
msgstr "에이~? 왜?\\n프레이아, 숨기지 말고 보여줘~!"

msgid "adv_101409_0034_msg"
msgstr "아와와와!!"

msgid "adv_101409_0035_msg"
msgstr "미, 밀레느!"

msgid "adv_101409_0037_msg"
msgstr "민메이 씨, 감사합니다!\\n여러분의 노래를 듣고… 그, 저희 왈큐레도\\n마음가짐을 새롭게 해야겠다고 해야 하나…"

msgid "adv_101409_0038_msg"
msgstr "…아무튼 리더로서 감사 인사를 드리게 해주세요"

msgid "adv_101409_0039_msg"
msgstr "감사라니요! …후훗, 카나메 씨는\\n정말 진지한 분이네요!\\n저희는 그냥 감사한 마음을 전하고 싶었을 뿐이니까요"

msgid "adv_101409_0040_msg"
msgstr "저희 마음, 전해졌나요?"

msgid "adv_101409_0041_msg"
msgstr "…네, 정말 많이요!"

msgid "adv_101409_0044_msg"
msgstr ""

msgid "adv_101409_0045_msg"
msgstr "하야테 단말기의 위치 정보… 특정"

msgid "adv_101409_0046_msg"
msgstr "…여긴 윈더미어?"

msgid "adv_101409_0047_msg"
msgstr "…후훗"

msgid "adv_101409_0048_msg"
msgstr "…기폭 스위치, 온"

msgid "adv_101409_0050_msg"
msgstr "아, 레이레이~! 여기 있었구나!\\n이제부터 바사라 씨 기타에 맞춰서\\n뭔가 노래하자고 얘기하고 있었는데…"

msgid "adv_101409_0051_msg"
msgstr "레이레이?"

msgid "adv_101409_0052_msg"
msgstr "…아무것도 아니야"

msgid "adv_101409_0053_msg"
msgstr "금방 갈게"

msgid "adv_101409_0056_msg"
msgstr ""

msgid "adv_101409_0057_msg"
msgstr "윽…"

msgid "adv_101409_0059_msg"
msgstr "…왜 그러지, 보그. 테오와 자오가 찾고 있더군"

msgid "adv_101409_0060_msg"
msgstr "키, 키스 님!"

msgid "adv_101409_0061_msg"
msgstr "…무슨 일이 있었나 보군. 얼굴이 온통 그을음투성이야"

msgid "adv_101409_0062_msg"
msgstr "아, 아닙니다… 그게… 이건"

msgid "adv_101409_0063_msg"
msgstr "…치료부터 받고 가라"

msgid "adv_101409_0064_msg"
msgstr "네, 알겠습니다!"

msgid "adv_101409_0066_msg"
msgstr "…설마 그런 라이브를 보고 난 직후에\\n갑자기 단말기가 폭발할 줄은…"

msgid "adv_101409_0067_msg"
msgstr "이놈, 하야테 임멜만…"

msgid "adv_101409_0068_msg"
msgstr "이놈… 왈큐레!!!"

msgid "adv_201301_0008_msg"
msgstr "민메이!"

msgid "adv_201301_0009_msg"
msgstr "어머, 히카루. 왜 이런 데 있어?\\n군의 특별 훈련은 끝났어?"

msgid "adv_201301_0010_msg"
msgstr "음… 뭐, 그런 셈이지?\\n그보다 민메이한테 모자를 가져왔어"

msgid "adv_201301_0011_msg"
msgstr "햇볕이 강하니까 조심해야겠다… 싶어서"

msgid "adv_201301_0012_msg"
msgstr "어머, 귀여운 모자! 이거 내가 받아도 돼?"

msgid "adv_201301_0013_msg"
msgstr "응. 아무래도 나한테는 안 어울리니까"

msgid "adv_201301_0014_msg"
msgstr "고마워, 히카루!"

msgid "adv_201301_0015_msg"
msgstr "아니… 하하"

msgid "adv_201301_0016_msg"
msgstr "그보다 말이야, 민메이.\\n이 촬영 끝나고 나서 같이…"

msgid "adv_201301_0018_msg"
msgstr "찾았다!\\n이치죠 중위, 이런 데 있었군요"

msgid "adv_201301_0019_msg"
msgstr "…헉"

msgid "adv_201301_0020_msg"
msgstr "히카루?"

msgid "adv_201301_0021_msg"
msgstr "…저기"

msgid "adv_201301_0022_msg"
msgstr "후훗, 히카루도 참… 알겠어!"

msgid "adv_201301_0023_msg"
msgstr "미사 씨 몰래 훈련을 빠져나온 거구나?"

msgid "adv_201301_0024_msg"
msgstr "뭐!?\\n아, 아니, 그런 거 아니야!"

msgid "adv_201301_0025_msg"
msgstr "그 말을 들으니 안심이네요"

msgid "adv_201301_0026_msg"
msgstr "이치죠 중위쯤 되는 분이 수영복 차림의 민메이 씨와 이야기하고 싶어서\\n훈련을 빠져나온다… 그런 일은 없겠죠?"

msgid "adv_201301_0027_msg"
msgstr "윽…"

msgid "adv_201301_0028_msg"
msgstr "있잖아요, 미사 씨!\\n훈련은 앞으로 얼마나 더 하면 끝나요?"

msgid "adv_201301_0029_msg"
msgstr "그러게요… 촬영 중인 민메이 씨의 호위를 겸한\\n훈련이니까, 촬영이 끝나면 마칠 예정이에요"

msgid "adv_201301_0030_msg"
msgstr "하지만 이치죠 중위는 훈련이 끝난 뒤에\\n추가 메뉴까지 해달라고 할까"

msgid "adv_201301_0031_msg"
msgstr "뭐어!?"

msgid "adv_201301_0032_msg"
msgstr "땡땡이치려 한 벌이에요"

msgid "adv_201301_0033_msg"
msgstr "오해예요!\\n민메이가 햇볕 때문에 쓰러지기라도 하면\\n큰일이겠다 싶어서…!"

msgid "adv_201301_0034_msg"
msgstr "…! 맞아, 이것도 호위의 일환이에요!"

msgid "adv_201301_0035_msg"
msgstr "네네, 그러네요. 그런 걸로 해둘게요"

msgid "adv_201301_0036_msg"
msgstr "저쪽에서 포커 소령님이 기다리고 계세요.\\n얼른 가세요"

msgid "adv_201301_0037_msg"
msgstr "기다린다니…\\n선배는 딱히 저 같은 거 기다리지 않을 것 같은데요"

msgid "adv_201301_0038_msg"
msgstr "구보!"

msgid "adv_201301_0039_msg"
msgstr "네네, 알겠습니다"

msgid "adv_201301_0040_msg"
msgstr "힘내, 히카루!"

msgid "adv_201301_0042_msg"
msgstr "정말이지…"

msgid "adv_201301_0043_msg"
msgstr "…그나저나 적의 습격도 없이\\n촬영이 무사히 끝날 것 같아서 다행이네요"

msgid "adv_201301_0044_msg"
msgstr "감사합니다.\\n군인 여러분이 함께해주신 덕분이죠!"

msgid "adv_201301_0045_msg"
msgstr "…아, 그러고 보니 미사 씨!\\n왈큐레 애들이 보내온 라이브 영상, 보셨어요?"

msgid "adv_201301_0046_msg"
msgstr "네. 우리가 초시공 SNS를 통해 만난 지 1주년.\\n감사를 담은 여름 페스티벌 라이브… 정말 멋졌어요"

msgid "adv_201301_0047_msg"
msgstr "저도 완전히 자극받아서…\\n바다 근처에 멋진 무대를 준비해달라고 했어요!"

msgid "adv_201301_0048_msg"
msgstr "이제 그 무대에서 노래할 거라서,\\n미사 씨와 히카루에게도 보여주고 싶었는데…"

msgid "adv_201301_0049_msg"
msgstr "그래도 히카루에게는 훈련이 끝난 뒤에\\n영상을 보내도록 할게요!"

msgid "adv_201301_0050_msg"
msgstr "훈련을 빼먹으려 한 벌로!"

msgid "adv_201301_0051_msg"
msgstr "어머… 후훗, 그러네!"

msgid "adv_201302_0008_msg"
msgstr "후우. 드디어 풀려났다…"

msgid "adv_201302_0009_msg"
msgstr "히카루!"

msgid "adv_201302_0010_msg"
msgstr "수고했어.\\n남아서 하는 훈련, 끝났어?"

msgid "adv_201302_0011_msg"
msgstr "남아서라니… 뭐, 비슷하긴 하지만"

msgid "adv_201302_0012_msg"
msgstr "다들 좋겠다… 훈련 끝나고 바다에서 놀 수 있고.\\n나는 바다에 한 번도 못 들어갔다고"

msgid "adv_201302_0013_msg"
msgstr "후훗… 힘들었구나"

msgid "adv_201302_0014_msg"
msgstr "뭐 그렇지.\\n하야세 대위도 포커 선배도 엄격하니까"

msgid "adv_201302_0015_msg"
msgstr "…그러고 보니 그 하야세 대위는?\\n촬영 끝나고 같이 놀지 않았어?"

msgid "adv_201302_0016_msg"
msgstr "그게 미사 씨가 수영복이 부끄럽다고 해서\\n방금 전에 뛰어가서 갈아입으러 갔어"

msgid "adv_201302_0017_msg"
msgstr "전혀 이상한 데도 없었는데.\\n예쁜데 아깝다!…고 다들 얘기하고 있었어"

msgid "adv_201302_0018_msg"
msgstr "헤에… 뭐, 하야세 대위는\\n그런 차림에 익숙하지 않은 것 같긴 하지"

msgid "adv_201302_0019_msg"
msgstr "게다가 그 사람한테는\\n역시 군복이 제일 잘 어울리지 않아?"

msgid "adv_201302_0020_msg"
msgstr "어머. 그건 어떨까"

msgid "adv_201302_0021_msg"
msgstr "히카루도 그 수영복 차림을 보면\\n미사 씨를 보는 눈이 달라질지도 몰라?"

msgid "adv_201302_0022_msg"
msgstr "어… 그래?"

msgid "adv_201302_0023_msg"
msgstr "흥미가 생긴 것 같네?"

msgid "adv_201302_0024_msg"
msgstr "!? 그, 그런 거 아니야.\\n난 딱히 그 사람 수영복 차림에 관심 같은 건…"

msgid "adv_201302_0025_msg"
msgstr "헤에…?"

msgid "adv_201302_0026_msg"
msgstr ""

msgid "adv_201302_0027_msg"
msgstr "…후훗"

msgid "adv_201302_0028_msg"
msgstr "…있잖아, 히카루!\\n괜찮으면 지금부터 같이 해변을 걸어보지 않을래?"

msgid "adv_201302_0029_msg"
msgstr "어? 좋긴 한데, 왜?"

msgid "adv_201302_0030_msg"
msgstr "어머? 모처럼 데이트 신청하는 건데…"

msgid "adv_201302_0031_msg"
msgstr "! 데, 데이트!?"

msgid "adv_201302_0032_msg"
msgstr "응! 이 밀짚모자를 조금만 더\\n쓰고 있고 싶어서…"

msgid "adv_201302_0033_msg"
msgstr "민메이…"

msgid "adv_201302_0034_msg"
msgstr "…히카루는 나랑 같이 있는 게 싫어?"

msgid "adv_201302_0035_msg"
msgstr "그, 그럴 리 없잖아!"

msgid "adv_201302_0036_msg"
msgstr "그냥 갑자기 데이트라고 하니까\\n조금 놀랐던 거야"

msgid "adv_201302_0037_msg"
msgstr "이 해변 너머에 멋진 부두가 있어.\\n거기서 오늘 촬영 때 불렀던 노래를 들려줄게"

msgid "adv_201302_0038_msg"
msgstr "석양도 정말 아름답고, 분명 멋진\\n무대가 될 것 같아!"

msgid "adv_201302_0039_msg"
msgstr "선셋…인가.\\n확실히 그 노래랑 잘 어울릴 것 같네"

msgid "adv_201302_0040_msg"
msgstr "응. 자, 가자, 히카루!"

msgid "adv_301201_0003_msg"
msgstr "봐봐! 바다야, 바다!"

msgid "adv_301201_0004_msg"
msgstr "나, 리조트 함에 오는 거 엄청 기대했거든~!\\n지난번에 왔을 때는 여러 가지 일이 있었고…\\n이번엔 좋은 추억을 만들어야지!"

msgid "adv_301201_0005_msg"
msgstr "노래하고 싶어졌어"

msgid "adv_301201_0006_msg"
msgstr "바사라도 참, 맨날 그 얘기네…\\n이제 곧 라이브니까 걱정 안 해도 실컷 노래할 수 있어"

msgid "adv_301201_0007_msg"
msgstr "그렇게 말하는 밀레느도 오늘은\\n노래하고 싶은 마음을 못 참는 것 같네"

msgid "adv_301201_0008_msg"
msgstr "뭐 그렇지… 왈큐레랑 민메이 씨 일행의\\n그렇게 대단한 노래를 들었는데! 불타오르는 게 당연하잖아!"

msgid "adv_301201_0009_msg"
msgstr "왈큐레의 초시공 유닛 라이브는\\n확실히 대단했지만…"

msgid "adv_301201_0010_msg"
msgstr "응! 왈큐레뿐만 아니라 민메이 씨도\\n바다에서 촬영한 PV 영상을 보내줬어! 둘 다 정말 멋졌고…"

msgid "adv_301201_0012_msg"
msgstr "우리도 질 수 없겠다고 생각했어.\\n그치, 바사라!"

msgid "adv_301201_0013_msg"
msgstr "어라? 바사라?\\n…아까까지만 해도 거기 있었지?"

msgid "adv_301201_0014_msg"
msgstr "또 어디론가 가버린 모양이네"

msgid "adv_301201_0015_msg"
msgstr "뭐어!? 이제 곧 본 공연인데!?"

msgid "adv_301201_0016_msg"
msgstr "…뭐, 라이브 전에 바사라가 사라지는 건\\n늘 있는 일이니까"

msgid "adv_301201_0017_msg"
msgstr "게다가 밀레느와 마찬가지로 바사라도\\n다들 노래를 듣고 뭔가 자극받았을지도 모르지"

msgid "adv_301201_0018_msg"
msgstr "하아… 어쩔 수 없네…\\n내가 바사라를 찾아올게!"

msgid "adv_301201_0020_msg"
msgstr "저기, 밀레느 씨!"

msgid "adv_301201_0021_msg"
msgstr "감린 씨! 왜 여기에?"

msgid "adv_301201_0022_msg"
msgstr "사실 델타 소대 분들에게 해상 훈련을 권유받아서…\\n그래서 우리 다이아몬드 포스도 이 리조트 함에서\\n훈련하게 됐습니다"

msgid "adv_301201_0023_msg"
msgstr "그래서 그… 마침 훈련이 끝났을 때\\n밀레느 씨가 보여서, 저도 모르게"

msgid "adv_301201_0024_msg"
msgstr "훈련… 그랬군요"

msgid "adv_301201_0025_msg"
msgstr "저기, 밀레느 씨. 그 수영복 차림…"

msgid "adv_301201_0026_msg"
msgstr "아, 맞다, 감린 씨!"

msgid "adv_301201_0027_msg"
msgstr "네, 넵!"

msgid "adv_301201_0028_msg"
msgstr "바사라 못 봤어!?\\n아까까지만 해도 거기 있었는데 사라졌어~!"

msgid "adv_301201_0029_msg"
msgstr "네!? 바사라가요?"

msgid "adv_301201_0030_msg"
msgstr "그래!\\n이러다 라이브에 늦겠어!"

msgid "adv_301201_0031_msg"
msgstr "왈큐레 애들이랑 민메이 씨가 깜짝 놀랄 만큼\\n굉장한 라이브로 만들려고 했는데!"

msgid "adv_301201_0032_msg"
msgstr "밀레느 씨. 제가 바사라를 데려오겠습니다"

msgid "adv_301201_0033_msg"
msgstr "그러니 밀레느 씨는\\n부디 라이브에 집중해 주세요"

msgid "adv_301201_0034_msg"
msgstr "감린 씨, 그래도 괜찮아요?"

msgid "adv_301201_0035_msg"
msgstr "네, 맡겨주세요!\\n조금이라도 도움이 될 수 있다면 그보다 기쁜 일은 없으니까요"

msgid "adv_301201_0036_msg"
msgstr "그럼 다녀오겠습니다!"

msgid "adv_301201_0037_msg"
msgstr "감린 씨, 감사합니다!\\n저, 최선을 다할게요!"

msgid "adv_301201_0039_msg"
msgstr "밀레느, 슬슬 시간인데… 괜찮겠어?"

msgid "adv_301201_0040_msg"
msgstr "괜찮아, 레이!\\n모처럼 감린 씨도 도와줬잖아"

msgid "adv_301201_0041_msg"
msgstr "바사라가 돌아올 때까지 내가 어떻게든 해야지!"

msgid "adv_301201_0042_msg"
msgstr "자, 간다!"

msgid "adv_301202_0008_msg"
msgstr "눈 깜짝할 사이에 끝나버렸네, 초시공 유닛 라이브.\\n좀 더 노래하고 싶다~"

msgid "adv_301202_0009_msg"
msgstr "밀레느의 뜨거운 하트, 제대로 전해졌어"

msgid "adv_301202_0010_msg"
msgstr "그런데…"

msgid "adv_301202_0011_msg"
msgstr "계속 신경 쓰이던 게 있어"

msgid "adv_301202_0012_msg"
msgstr "신경 쓰이던 거?"

msgid "adv_301202_0013_msg"
msgstr "라이브 때부터,\\n계속 밀레느를 쳐다보는 사람이 있어"

msgid "adv_301202_0014_msg"
msgstr "…저 나무 뒤"

msgid "adv_301202_0015_msg"
msgstr "아~… 저 사람은"

msgid "adv_301202_0016_msg"
msgstr "…적"

msgid "adv_301202_0017_msg"
msgstr "잠깐, 레이나!\\n진정해, 저 사람은 괜찮아!"

msgid "adv_301202_0018_msg"
msgstr "저 사람은 그냥 나를 걱정해주는 것뿐이야!"

msgid "adv_301202_0019_msg"
msgstr "아는 사람?"

msgid "adv_301202_0020_msg"
msgstr "응. 저 사람은 마이클이라고 해.\\n덩치도 크고 험상궂지만 나쁜 사람은 아니야!\\n…가끔 조~금 귀찮을 뿐이지"

msgid "adv_301202_0021_msg"
msgstr "…그렇구나"

msgid "adv_301202_0022_msg"
msgstr "역시 함장과 시장의 딸. 금지옥엽"

msgid "adv_301202_0023_msg"
msgstr "음… 엄마도 그렇고, 다들 걱정이 너무 많다니까"

msgid "adv_301202_0024_msg"
msgstr "…밀레느도 고생이네"

msgid "adv_301202_0026_msg"
msgstr "레이레이랑 미레미레,\\n무슨 얘기 하고 있을까~?"

msgid "adv_301202_0027_msg"
msgstr "둘이 사이좋게 있는 걸 보면 조~금 외로운 기분도 들지만\\n귀여운 두 사람을 보고 있으면 행복하단 말이지…"

msgid "adv_301202_0028_msg"
msgstr "그렇죠, 감린 씨?"

msgid "adv_301202_0029_msg"
msgstr "귀여…?"

msgid "adv_301202_0030_msg"
msgstr "예를 들면 웃고 있는 모습 같은 거?\\n그런 걸 보고 있으면 나까지 행복해진달까…"

msgid "adv_301202_0031_msg"
msgstr "그렇군요.\\n확실히 그건 행복한 기분이 드네요"

msgid "adv_301202_0032_msg"
msgstr "사이가 좋다는 건 나쁜 일이 아니니까요"

msgid "adv_301202_0033_msg"
msgstr "그러고 보니 감린 씨. 미레미레한테 말했어요?"

msgid "adv_301202_0034_msg"
msgstr "그 수영복, 잘 어울린다고~!"

msgid "adv_301202_0035_msg"
msgstr "어, 어떻게 그걸!?"

msgid "adv_301202_0036_msg"
msgstr "티 다 나거든요~!"

msgid "adv_301202_0037_msg"
msgstr "…이건 난감하네요. 사실 아직 아무 말도…"

msgid "adv_301202_0038_msg"
msgstr "하지만 밀레느 씨는 인기가 많으니까요.\\n저는 다음 기회에라도…"

msgid "adv_301202_0039_msg"
msgstr "그러면 안 되지~!\\n수영복 칭찬을 듣고 기분 나쁠 여자애는 없으니까\\n빨리 칭찬해줘야지!"

msgid "adv_301202_0040_msg"
msgstr "하지만…"

msgid "adv_301202_0041_msg"
msgstr "그럴 땐 마키마키에게 맡겨!"

msgid "adv_301202_0042_msg"
msgstr "네?"

msgid "adv_301202_0043_msg"
msgstr "어이~ 미레미레~!\\n감린 씨가 할 말이 있대!"

msgid "adv_301202_0044_msg"
msgstr "마, 마키나 씨! 잠깐만요!"

msgid "adv_000110_0003_msg"
msgstr "…아라드 대장"

msgid "adv_000110_0004_msg"
msgstr "각 시공의 파일럿들과 통신을 연결했습니다.\\n…그런데 왜 갑자기 합동 회의를 하게 된 겁니까?"

msgid "adv_000110_0005_msg"
msgstr "그 얘긴데… 메서,\\n그 건에 대해서 뭔가 들었어?"

msgid "adv_000110_0006_msg"
msgstr "네, 카나메 씨에게 들었습니다.\\n초시공 네트워크에서 일어나고 있는 이상 현상 말씀이시죠"

msgid "adv_000110_0007_msg"
msgstr "그래. 최근 레이나가 만든 초시공 네트워크에서\\n통신 장애가 잇따르고 있었어"

msgid "adv_000110_0008_msg"
msgstr "그 원인이 아무래도 새의 인간이 내뿜는\\n멸망의 노래 영향이라는 게 밝혀졌는데…"

msgid "adv_000110_0009_msg"
msgstr "초고대 시스템, 새의 인간…입니까"

msgid "adv_000110_0010_msg"
msgstr "…설마 멸망의 노래 영향이\\n초시공 네트워크에까지 나타나게 될 줄이야"

msgid "adv_000110_0011_msg"
msgstr "초시공 SNS, 초시공 유닛 라이브…\\n초시공 네트워크를 통해 성립되는 시스템은 많습니다"

msgid "adv_000110_0012_msg"
msgstr "그래. 그게 망가져버리면…\\n린 민메이, 셰릴 놈, 란카 리…"

msgid "adv_000110_0013_msg"
msgstr "그리고 Fire Bomber.\\n그들과 연결될 방법이 사라지게 돼"

msgid "adv_000110_0014_msg"
msgstr "우리의 연계가 끊기면 기억 소실도 더욱 진행될 겁니다.\\n확실히 적에게는 유리한 상황이겠네요"

msgid "adv_000110_0015_msg"
msgstr "…물론 그렇게 되도록 놔둘 수는 없어.\\n하지만 우리 델타 소대만으로는 할 수 있는 일이 꽤 제한적이지"

msgid "adv_000110_0016_msg"
msgstr "…네"

msgid "adv_000110_0017_msg"
msgstr "그래서 말인데.\\n오즈마 일행과 상의해서 레이나에게 어떤 시스템을 만들어달라고 했어"

msgid "adv_000110_0018_msg"
msgstr "…서로 힘을 합쳐야 하는 건 가희들뿐만이 아니야.\\n우리 파일럿들도 협력할 때가 온 게 아닐까 싶어서"

msgid "adv_000110_0019_msg"
msgstr ""

msgid "adv_000110_0022_msg"
msgstr "…발키리 오퍼레이션"

msgid "adv_000110_0023_msg"
msgstr "…좋은 느낌"

msgid "adv_000110_0024_msg"
msgstr "그나저나 정말 아라드 대장다운 발상이네!"

msgid "adv_000110_0025_msg"
msgstr "그러니까 『초시공 네트워크를 지키고 싶으니 우리가\\n네트워크 세계에서 싸울 수 있게 해줘!』라는 거지!"

msgid "adv_000110_0026_msg"
msgstr "대담해"

msgid "adv_000110_0027_msg"
msgstr "물론 그걸 진짜로 구현해버린 레이레이도 대단해!"

msgid "adv_000110_0028_msg"
msgstr "설마 발키리를 데이터화해서\\n초시공 네트워크상에서 전투가 가능하게 만들다니!"

msgid "adv_000110_0029_msg"
msgstr "후훗… 이 정도는 식은 죽 먹기"

msgid "adv_000110_0030_msg"
msgstr "자… 이제 네트워크상의 이상을 감지하면\\n레이레이가 파일럿들에게 오퍼레이션을 요청하기만 하면 되겠네"

msgid "adv_000110_0031_msg"
msgstr "…시작하자, 마키나"

msgid "adv_000110_0032_msg"
msgstr "네네~!\\n발키리 오퍼레이션, 기동!"

msgid "adv_101501_0009_msg"
msgstr "거기 두 사람, 잠깐 괜찮을까?"

msgid "adv_101501_0010_msg"
msgstr "아… 네!\\n무슨 일이세요, 셰릴 씨"

msgid "adv_101501_0011_msg"
msgstr "헤에, 별일도 다 있네.\\n셰릴 쪽에서 먼저 우리한테 말을 걸다니"

msgid "adv_101501_0012_msg"
msgstr "알토라면 여기 없는데?"

msgid "adv_101501_0013_msg"
msgstr "그건 알고 있어"

msgid "adv_101501_0014_msg"
msgstr "그래서… 부탁할 게 하나 있는데,\\n괜찮을까?"

msgid "adv_101501_0015_msg"
msgstr "부탁이요?"

msgid "adv_101501_0016_msg"
msgstr "왠지 불길한 예감이…"

msgid "adv_101501_0017_msg"
msgstr "뭐라고 했어?"

msgid "adv_101501_0018_msg"
msgstr "아, 아닙니다! 아무것도 아니에요!"

msgid "adv_101501_0019_msg"
msgstr "그래서 그 부탁이라는 게…"

msgid "adv_101501_0020_msg"
msgstr "알토의 발키리에 살짝 페인트를 하고 싶어"

msgid "adv_101501_0021_msg"
msgstr "네!? 바, 발키리에요…!?"

msgid "adv_101501_0022_msg"
msgstr "물론 협력해줄 거지"

msgid "adv_101501_0023_msg"
msgstr "협력이라고 해도… 어떡하죠? 미셸 선배"

msgid "adv_101501_0024_msg"
msgstr "내가 뭐라고 하긴 어렵다…고 말하고 싶지만,\\n알토 공주가 놀란 얼굴을 보는 건 재밌을 것 같네"

msgid "adv_101501_0025_msg"
msgstr "또 그런 말 하시고… 알토 선배한테 혼나요?"

msgid "adv_101501_0026_msg"
msgstr "어쩔 수 없지.\\n다름 아닌 셰릴 놈이 직접 부탁한 거니까,\\n거절할 수는 없잖아"

msgid "adv_101501_0027_msg"
msgstr "그래서… 셰릴. 그 얘기, 좀 자세히 들려주겠어?"

msgid "adv_101501_0028_msg"
msgstr "응, 물론이지! 사실은 말이야……"

msgid "adv_101501_0029_msg"
msgstr "하아… 전 모릅니다"

msgid "adv_101501_0031_msg"
msgstr "어이, 셰릴"

msgid "adv_101501_0032_msg"
msgstr "알토, 무슨 일이야?"

msgid "adv_101501_0033_msg"
msgstr "…너, 무슨 일 있었어?"

msgid "adv_101501_0034_msg"
msgstr "어머, 왜?"

msgid "adv_101501_0035_msg"
msgstr "왠지 평소랑 분위기가 다른 것 같아서.\\n평소보다 더 즐거워 보인다고 해야 하나, 뭐랄까…"

msgid "adv_101501_0036_msg"
msgstr "…헤에, 알토는 나를 참~ 잘 보고 있네"

msgid "adv_101501_0037_msg"
msgstr "뭐…!? 그런 뜻이 아니야!"

msgid "adv_101501_0038_msg"
msgstr "후훗! 뭐, 됐어"

msgid "adv_101501_0039_msg"
msgstr "오늘은 늘 열심히 해주는 알토를 위해\\n특별한 발키리를 준비했어"

msgid "adv_101501_0040_msg"
msgstr "특별한 발키리라니… 무슨 뜻이야?"

msgid "adv_101501_0041_msg"
msgstr "그건 보고 나서의 즐거움이지"

msgid "adv_101501_0042_msg"
msgstr "아무튼 나랑 란카의 무대,\\n오늘도 확실히 지켜줘"

msgid "adv_101501_0044_msg"
msgstr "어이…!\\n…정말, 대체 무슨 소리야?"

msgid "adv_101502_0008_msg"
msgstr "하아…"

msgid "adv_101502_0010_msg"
msgstr "알토!"

msgid "adv_101502_0011_msg"
msgstr "알토 군! 수고했어!"

msgid "adv_101502_0012_msg"
msgstr "…셰릴, 란카"

msgid "adv_101502_0013_msg"
msgstr "우리가 준비한,\\n특별한 발키리는 타보니까 어땠어?"

msgid "adv_101502_0014_msg"
msgstr "노코멘트"

msgid "adv_101502_0015_msg"
msgstr "앞으로를 위해 말해두는데…\\n이런 걸 할 때는 미리 나한테 말해줘"

msgid "adv_101502_0016_msg"
msgstr "어머. 미셸이랑 루카한테는 말해뒀는데?"

msgid "adv_101502_0017_msg"
msgstr "다만 마음이 내키면 알토한테 알려주라고\\n했으니까…"

msgid "adv_101502_0018_msg"
msgstr "말 안 했다는 건,\\n둘 다 마음이 안 내켰던 거겠지"

msgid "adv_101502_0019_msg"
msgstr "…그 녀석들"

msgid "adv_101502_0020_msg"
