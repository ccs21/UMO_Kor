msgstr "그럼 간다!"

msgid "adv_200401_0040_msg"
msgstr "자, 잠깐만!"

msgid "adv_200401_0041_msg"
msgstr "…정말, 바사라도 참!"

msgid "adv_200402_0009_msg"
msgstr "…밀레느가 말했던 기억이라는 게 이건가"

