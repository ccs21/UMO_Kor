msgid "adv_102401_0024_msg"
msgstr "조금 기다릴 것"

msgid "adv_102401_0025_msg"
msgstr ""

msgid "adv_102401_0026_msg"
msgstr "레이나 씨!? 언제부터 거기 있었어요!?"

msgid "adv_102401_0027_msg"
msgstr "그건 비밀"

msgid "adv_102401_0028_msg"
msgstr "그보다 마키나는 조금만 더 혼자 있게 해줬으면 해"

msgid "adv_102401_0029_msg"
msgstr "혼자 있게 둔다…?\\r\\n마키나 씨, 무슨 일 있었어요?"

msgid "adv_102401_0030_msg"
msgstr "별일 아니야"

msgid "adv_102401_0031_msg"
