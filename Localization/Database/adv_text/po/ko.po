msgstr "…무슨 일이야? 바사라가 뭐라고 했어?"

msgid "adv_105402_0015_msg"
msgstr "네, 조언을 해줘서…"

msgid "adv_105402_0016_msg"
msgstr "알겠다! 어차피 「노래하면 돼」 같은 말 했지?"

msgid "adv_105402_0017_msg"
msgstr "후훗… 뭐, 그렇네요"

msgid "adv_105402_0018_msg"
msgstr "바사라도 참… 좀 더 제대로 된\\r\\n조언을 해주면 좋을 텐데"

msgid "adv_105402_0019_msg"
msgstr "넌 아무것도 모르는구나, 밀레느"

msgid "adv_105402_0020_msg"
msgstr "정말! 무슨 뜻이야!"

msgid "adv_105402_0021_msg"
msgstr "그보다 빨리 가자. 우리 라이브 시작하겠어"

msgid "adv_105402_0022_msg"
msgstr "그래그래, 알고 있어!\\r\\n그럼 카나메! 이따 또 봐!"

msgid "adv_105402_0023_msg"
msgstr "후훗, 네!"

msgid "adv_100465701_0003_msg"
msgstr "…정말, 밀레느도 참"

msgid "adv_100465701_0004_msg"
msgstr "바사라 씨, 또 밀레느랑 싸웠어요?"

msgid "adv_100465701_0005_msg"
msgstr "싸운 건 아니야. 밀레느가 혼자 화내는 것뿐이지"

msgid "adv_100465701_0006_msg"
msgstr "싸울수록 친한 사이라고 하잖아요…\\r\\n가끔은 밀레느한테도 다정하게 대해주세요!"

msgid "adv_100465701_0007_msg"
msgstr "다정하게?"

msgid "adv_100465701_0008_msg"
msgstr "네! 밀레느도 여자애니까요!"

msgid "adv_100465701_0009_msg"
msgstr "여자애라… 뭐, 내키면"

msgid "adv_100465702_0003_msg"
msgstr "저기, 바사라! 봐바 봐바!"

msgid "adv_100465702_0004_msg"
msgstr "뭐야?"

msgid "adv_100465702_0005_msg"
msgstr "이 의상, 마키나가 디자인해줬어!\\r\\n어때? 잘 어울려?"

msgid "adv_100465702_0006_msg"
msgstr "아아"

msgid "adv_100465702_0007_msg"
msgstr "후후훗! 역시 마키나라니까~!\\r\\n내 취향을 제대로 이해하고 있다고 해야 하나!"

msgid "adv_100465702_0008_msg"
msgstr "잘됐네"

msgid "adv_100465702_0009_msg"
msgstr "정말~! 조금은 관심 좀 가져!"

msgid "adv_100466901_0003_msg"
msgstr "원 투 쓰리 포,\\n원 투 쓰리 포…"

msgid "adv_100466901_0004_msg"
msgstr "어라? 카나메 씨, 그거 제 노래의 안무예요?"

msgid "adv_100466901_0005_msg"
msgstr "미, 민메이 씨!\\n죄송해요, 보고 있는 줄 몰랐어요…"

msgid "adv_100466901_0006_msg"
msgstr "아뇨, 아주 잘 추시고 있어요!"

msgid "adv_100466901_0007_msg"
msgstr "정말인가요!? 사실은 민메이 씨와 함께 노래하고 싶어서\\n계속 연습하고 있었어요"

msgid "adv_100466901_0008_msg"
msgstr "와, 그럼 지금 여기서 함께 해보는 건 어때요?\\n둘이서 함께 무대에 선다는 생각으로!"

msgid "adv_100466901_0009_msg"
msgstr "네! 잘 부탁드립니다!"

msgid "adv_100466902_0003_msg"
msgstr "레이나. 그러고 보니 이제 곧이었지?\\r\\n마키나와 레이나의 기념일"

msgid "adv_100466902_0004_msg"
msgstr "응"

msgid "adv_100466902_0005_msg"
msgstr "맨날 싸우기만 하던 둘이 화해한 날이라… 후훗"

msgid "adv_100466902_0006_msg"
msgstr "예전의 두 사람이 지금의 두 사람을 보면 분명 깜짝 놀라겠네"

msgid "adv_100466902_0007_msg"
msgstr "응. 하지만 예전의 우리를 만나더라도,\\r\\n지금은 이렇게 됐다고 알려주고 싶진 않아"

msgid "adv_100466902_0008_msg"
msgstr "마키나와 처음 서로를 이해하게 된\\r\\n그 순간의 감동이 희미해질 것 같으니까"

msgid "adv_100466902_0009_msg"
msgstr "그렇구나, 확실히. 미래가 어떻게 될지\\r\\n모르기 때문에 인생은 재미있는 거겠지"

msgid "adv_100466902_0010_msg"
msgstr "맞아. 즐거움은 아껴두는 게\\r\\n두근두근, 따끔따끔의 비결…!"

msgid "adv_1400901_0008_msg"
msgstr "후우… 란카, 슬슬 쉬자"

msgid "adv_1400901_0009_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_1400901_0010_msg"
msgstr "다음 라이브… 정말 멋진 라이브가 될 것 같네요.\\r\\n벌써부터 기대돼요!"

msgid "adv_1400901_0011_msg"
msgstr "후훗, 분명 좋은 라이브가 될 거야.\\r\\n…하지만 아직 조금 부족한 부분이 있어"

msgid "adv_1400901_0012_msg"
msgstr "부족한 부분…이요?"

msgid "adv_1400901_0013_msg"
msgstr "응. 이번 라이브의 테마는 「낙원」이잖아?"

msgid "adv_1400901_0014_msg"
msgstr "네! 의상도 연출도 그 테마에 맞춰서\\r\\n준비됐으니까요"

msgid "adv_1400901_0015_msg"
msgstr "하지만 아직 만족할 만한 연출은 아닌 것 같아.\\r\\n좀 더 「낙원」다운 느낌을 표현할 수 있지 않을까 해서"

msgid "adv_1400901_0016_msg"
msgstr "라이브를 한다면 완벽하고 만족스러운 걸로 만들고 싶어.\\r\\n그래서 계속 뭐가 부족한지 생각하고 있는데…"

msgid "adv_1400901_0017_msg"
msgstr "「낙원」다운 느낌…인가요"

msgid "adv_1400901_0018_msg"
msgstr "머릿속에 어렴풋한 이미지는 있는데\\r\\n아무래도 구체화가 안 돼"

msgid "adv_1400901_0019_msg"
msgstr "으음…"

msgid "adv_1400901_0020_msg"
msgstr ""

msgid "adv_1400901_0021_msg"
msgstr "맞다! 그렇다면 좀 더 많이 노래해보지 않을래요?"

msgid "adv_1400901_0022_msg"
msgstr "노래를?"

msgid "adv_1400901_0023_msg"
msgstr "네! 프레이아가 자주 말해주거든요.\\r\\n고민되면 일단 노래하지 않을래요! 하고요"

msgid "adv_1400901_0024_msg"
msgstr "프레이아답네. 하지만 정말 좋은 아이디어야!"

msgid "adv_1400901_0025_msg"
msgstr "조금만 어울려줄래, 란카?"

msgid "adv_1400901_0026_msg"
msgstr "물론이죠! 셰릴 씨!"

msgid "adv_1400902_0008_msg"
msgstr "란카, 수고했어!\\r\\n정말 멋진 라이브가 됐네!"

msgid "adv_1400902_0009_msg"
msgstr "네, 정말 즐거웠어요, 셰릴 씨!"

msgid "adv_1400902_0010_msg"
msgstr "라이브 중에도 들렸죠,\\r\\n샤론 애플 씨의 목소리"

msgid "adv_1400902_0011_msg"
msgstr "응, 그랬지"

msgid "adv_1400902_0012_msg"
msgstr "기분 탓일지도 모르지만…\\r\\n그래도 샤론 씨도 같이 노래해주는 것 같아서\\r\\n왠지 기뻤어요"

msgid "adv_1400902_0013_msg"
msgstr "후훗, 기분 탓이 아닐지도 몰라"

msgid "adv_1400902_0014_msg"
msgstr "네?"

msgid "adv_1400902_0015_msg"
msgstr "후훗, 농담이야"

msgid "adv_1400902_0016_msg"
msgstr "저기, 셰릴 씨…"

msgid "adv_1400902_0017_msg"
msgstr "…언젠가 만날 수 있을까요?\\r\\n진짜 샤론 씨를"

msgid "adv_1400902_0018_msg"
msgstr "분명 만날 수 있을 거야.\\r\\n은하는 이어져 있으니까"

msgid "adv_1400902_0019_msg"
msgstr "우리도 왈큐레나 Fire Bomber,\\n민메이 일행과 시공을 넘어 만날 수 있었잖아, 그렇지?"

msgid "adv_1400902_0020_msg"
msgstr "셰릴 씨…"

msgid "adv_1400902_0021_msg"
msgstr "네, 그러네요!"

msgid "adv_105501_0008_msg"
msgstr "레이레이! 쿠모쿠모!\\r\\n오늘 라이브, 엄청 좋은 느낌이었지"

msgid "adv_105501_0009_msg"
msgstr "절호조"

msgid "adv_105501_0010_msg"
msgstr "프레이아랑 카나메도 컨디션이 좋아 보였어"

msgid "adv_105501_0011_msg"
msgstr "미쿠모 씨, 마키나 씨, 레이나 씨!\\r\\n수고하셨어요!"

msgid "adv_105501_0012_msg"
msgstr "아, 미라미라다!"

msgid "adv_105501_0013_msg"
msgstr "라이브, 정말 분위기가 뜨거웠네요"

msgid "adv_105501_0014_msg"
msgstr "당연"

msgid "adv_105501_0015_msg"
msgstr "후훗…"

msgid "adv_105501_0016_msg"
msgstr "미라쥬! 대장님이 부른다!"

msgid "adv_105501_0017_msg"
msgstr "알겠습니다, 바로 갈게요"

msgid "adv_105501_0018_msg"
msgstr "미쿠모 씨, 레이나 씨, 죄송해요!\\r\\n이따 또 봬요!"

msgid "adv_105501_0019_msg"
msgstr "…미라쥬 일행, 요즘 바빠 보여"

msgid "adv_105501_0020_msg"
msgstr "응응. 출격도 많고 라이브도 많이 하고 있으니까.\\n하야하야 일행도 좀 지쳐 보이는 것 같지?"

msgid "adv_105501_0021_msg"
msgstr "다음 라이브도 얼마 안 남았고…"

msgid "adv_105501_0022_msg"
msgstr "그러고 보니 카나메가 다음 라이브에 대해\\r\\n얘기했었지"

msgid "adv_105501_0023_msg"
msgstr "아~ 어떤 라이브를 하고 싶은지, 각자 테마를\\r\\n생각해오라고 했던 거구나!"

msgid "adv_105501_0024_msg"
msgstr "어떤 게 좋을까~"

msgid "adv_105501_0025_msg"
msgstr "음"

msgid "adv_105501_0026_msg"
msgstr ""

msgid "adv_105501_0027_msg"
msgstr "레이레이?"

msgid "adv_105501_0028_msg"
msgstr "좋은 생각 났어"

msgid "adv_105502_0008_msg"
msgstr "레이나 씨, 라이브 수고하셨어요"

msgid "adv_105502_0009_msg"
msgstr "…정말 멋진 라이브였어요.\\r\\n감사합니다"

msgid "adv_105502_0010_msg"
msgstr "그… 제가 신청한 곡도 불러주셔서요"

msgid "adv_105502_0011_msg"
msgstr "그건 미쿠모의 서프라이즈"

msgid "adv_105502_0012_msg"
msgstr "미쿠모 씨…"

msgid "adv_105502_0013_msg"
msgstr "처음에는 미라쥬를 무대에 세우려고 했어"

msgid "adv_105502_0014_msg"
msgstr "…왈큐레 의상을 입혀서"

msgid "adv_105502_0015_msg"
msgstr "네에!?"

msgid "adv_105502_0016_msg"
msgstr "하지만 카나메한테 기각당했어"

msgid "adv_105502_0017_msg"
msgstr "다, 다행이에요…"

msgid "adv_105502_0018_msg"
msgstr "그랬더니 미쿠모가\\r\\n「미라쥬가 신청한 곡을 부르는 건 어때」라고 했어"

msgid "adv_105502_0019_msg"
msgstr "그래서 미쿠모 씨가 이것저것 물어보셨던 거군요!\\r\\n어떤 곡을 좋아하는지, 어떤 곡을 듣고 싶은지 같은 걸…"

msgid "adv_105502_0020_msg"
msgstr "응"

msgid "adv_105502_0021_msg"
msgstr "밤에 복도에서 미쿠모 씨한테 다그침을 당했을 때는\\r\\n대체 무슨 일인가 싶었는데…"

msgid "adv_105502_0022_msg"
msgstr "라이브를 보고 나서야 이해했어요"

msgid "adv_105502_0023_msg"
msgstr "…앞으로도 왈큐레 여러분을\\r\\n지킬 수 있도록 저도 최선을 다하겠습니다!"

msgid "adv_105502_0024_msg"
msgstr "응, 기대할게"

msgid "adv_100474101_0003_msg"
msgstr "…레이나. 거기 있는 거 다 알아"

msgid "adv_100474101_0004_msg"
msgstr "…뜨끔"

msgid "adv_100474101_0005_msg"
msgstr "또 나를 미행하고 있었어?"

msgid "adv_100474101_0006_msg"
msgstr "이것도 미쿠모의 비밀에 다가가기 위해서"

msgid "adv_100474101_0007_msg"
msgstr "딱히 뭔가 숨기고 있는 건 아닌데…\\n뭐, 됐어"

msgid "adv_100474101_0008_msg"
msgstr "이제 바다에 갈 건데. 너도 어때?"

msgid "adv_100474101_0009_msg"
msgstr "…! 같이 갈래"

msgid "adv_100474102_0003_msg"
msgstr "이게 해파리 튀김. 이쪽이 해파리 수프.\\r\\n그리고 이게 생해파리…!"

msgid "adv_100474102_0004_msg"
msgstr "전부 해파리 요리네"

msgid "adv_100474102_0005_msg"
msgstr "당연. 나는 해파리를 사랑하는 여자.\\r\\n주변에서 이상하게 쳐다본다 해도!"

msgid "adv_100474102_0006_msg"
msgstr "괜찮잖아?\\r\\n무언가에 뜨거워지는 마음은 누구도 막을 수 없어"

msgid "adv_100474102_0007_msg"
msgstr "역시 바사라… 잘 아네"

msgid "adv_100474102_0008_msg"
msgstr "바사라도 해파리 먹을래?"

msgid "adv_100474102_0009_msg"
msgstr "내키면"

msgid "adv_100475301_0003_msg"
msgstr "자, 미쿠모. 한입…"

msgid "adv_100475301_0004_msg"
msgstr "레이나… 이거, 정말 먹는 거야?"

msgid "adv_100475301_0005_msg"
msgstr "해파리는 음식.\\r\\n맛있어, 딜리셔스, 데카르챠…!"

msgid "adv_100475301_0006_msg"
msgstr ""

msgid "adv_100475301_0007_msg"
msgstr "어때?"

msgid "adv_100475301_0008_msg"
msgstr "특이한 맛이네. 하지만 나쁘지 않아"

msgid "adv_100475301_0009_msg"
msgstr "훗, 그게 해파리의 매력"

msgid "adv_100475302_0003_msg"
msgstr "미쿠모 씨 머리는 정말 예쁘네요.\\r\\n뭔가 특별히 관리하는 방법이 있나요?"

msgid "adv_100475302_0004_msg"
msgstr "특별한 건 아무것도.\\r\\n그냥 놔둬도 늘 이런 느낌이야"

msgid "adv_100475302_0005_msg"
msgstr "네, 정말요? 좋겠다, 조금 부러워요…"

msgid "adv_100475302_0006_msg"
msgstr "…조금은 더 신경 쓰는 게 좋을까?"

msgid "adv_100475302_0007_msg"
msgstr "그럴 필요 없어요!\\r\\n자연 그대로 아름다운 게 제일 좋고…"

msgid "adv_100475302_0008_msg"
msgstr "무엇보다 그게 미쿠모 씨답다고 생각해요!"

msgid "adv_100475302_0009_msg"
msgstr "나다운 모습… 그런 걸까?"

msgid "adv_1401001_0008_msg"
msgstr "민민, 안녕~!"

msgid "adv_1401001_0009_msg"
msgstr "마키나, 안녕!"

msgid "adv_1401001_0010_msg"
msgstr "어라? 무슨 일이야?"

msgid "adv_1401001_0011_msg"
msgstr "에헤헤!\\n다들 어떤 크리스마스를 보내는지 궁금해서\\n잠깐 이야기 들으러 왔어!"

msgid "adv_1401001_0012_msg"
msgstr "미레미레랑 셰리셰리한테도\\r\\n가서 이것저것 물어보고 왔어!"

msgid "adv_1401001_0013_msg"
msgstr "그랬구나"

msgid "adv_1401001_0014_msg"
msgstr "왈큐레 여러분은 어떻게 보내세요?"

msgid "adv_1401001_0015_msg"
msgstr "이브에는 다 같이 크리스마스 파티를 할 예정이야!\\r\\n올해는 레이레이랑 프레프레 담당이야"

msgid "adv_1401001_0016_msg"
msgstr "후훗! 두 사람이 생각한 크리스마스 파티라면\\n왠지 자극적이고 재미있을 것 같아!"

msgid "adv_1401001_0017_msg"
msgstr "나도 히카루랑 맥스 씨, 미사 씨 일행을 불러서\\n파티를 할까 생각 중이야"

msgid "adv_1401001_0018_msg"
msgstr "히카루가 노래해달라고 했으니까,\\r\\n조금 특별한 무대를 보여주고 싶어서"

msgid "adv_1401001_0019_msg"
msgstr "장소는 당연히 냥냥에서!"

msgid "adv_1401001_0020_msg"
msgstr "와아, 정말 멋지다!"

msgid "adv_1401001_0021_msg"
msgstr "왈큐레도 크리스마스 라이브를 하나요?"

msgid "adv_1401001_0022_msg"
msgstr "응, 크리스마스 당일에!\\r\\n아직 어떤 의상으로 할지 고민 중이지만…"

msgid "adv_1401001_0023_msg"
msgstr "아, 맞다 민민! 이왕이면,\\r\\n냥냥을 잠깐 구경해봐도 될까?"

msgid "adv_1401001_0024_msg"
msgstr "의상 콘셉트를 조금만 더 구체화하고 싶어서…"

msgid "adv_1401001_0025_msg"
msgstr "물론이지!"

msgid "adv_1401001_0026_msg"
msgstr "그렇게 정했으면 바로 삼촌들한테도 말해야겠다!"

msgid "adv_1401001_0027_msg"
msgstr "와아~! 고마워!"

msgid "adv_1401002_0008_msg"
msgstr "마키나, 크리스마스 라이브 수고했어!"

msgid "adv_1401002_0009_msg"
msgstr "고마워! 민민 덕분에\\r\\n정말 멋진 라이브를 할 수 있었어!"

msgid "adv_1401002_0010_msg"
msgstr "쿵푸를 도입한 연출도\\r\\n관객들이 좋아해줬고…"

msgid "adv_1401002_0011_msg"
msgstr "나도 춤추면서 신나버렸어!"

msgid "adv_1401002_0012_msg"
msgstr "마키나다운 멋진 무대였어"

msgid "adv_1401002_0013_msg"
msgstr "보고 있던 나도 조마조마 두근두근해서\\r\\n새로운 크리스마스 라이브라고 생각했는걸"

msgid "adv_1401002_0014_msg"
msgstr "다행이다~!"

msgid "adv_1401002_0015_msg"
msgstr "그리고… 이 라이브 의상 고마워!"

msgid "adv_1401002_0016_msg"
msgstr "에헤헤, 천만에!\\r\\n이번엔 민민한테 도움을 많이 받았고…"

msgid "adv_1401002_0017_msg"
msgstr "게다가 민민도 크리스마스 파티에서 노래한다고\\r\\n했잖아?"

msgid "adv_1401002_0018_msg"
msgstr "그래서 민민 이미지에 맞게\\r\\n만들어봤어~!"

msgid "adv_1401002_0019_msg"
msgstr "응응, 민민의 귀여운 매력이\\r\\n제대로 살아 있어서 잘 어울려!"

msgid "adv_1401002_0020_msg"
msgstr "후훗, 정말 기뻐요!"

msgid "adv_1401002_0021_msg"
msgstr "이거라면 히카루 일행도 좋아해줄\\r\\n크리스마스 파티가 될 것 같아!"

msgid "adv_105601_0008_msg"
msgstr ""

msgid "adv_105601_0009_msg"
msgstr "마키나?"

msgid "adv_105601_0010_msg"
msgstr "마키나 씨? 왜 그러세요?"

msgid "adv_105601_0011_msg"
msgstr "아, 미안 미안!\\r\\n아무것도 아니야, 잠깐 멍하니 있었을 뿐이야!"

msgid "adv_105601_0012_msg"
msgstr "…그래서, 무슨 얘기였지?"

msgid "adv_105601_0013_msg"
msgstr "다음 라이브 얘기"

msgid "adv_105601_0014_msg"
msgstr "아, 맞다!\\r\\n어떤 의상이 좋을지 아이디어를 정리해둬야 해!"

msgid "adv_105601_0015_msg"
msgstr "잠깐 카나카나한테 상담하고 올게!"

msgid "adv_105601_0016_msg"
msgstr "네엣!"

msgid "adv_105601_0017_msg"
msgstr ""

msgid "adv_105601_0018_msg"
msgstr "…마키나, 요즘 뭔가 이상해"

msgid "adv_105601_0019_msg"
msgstr "그저께 라이브가 끝난 뒤부터,\\r\\n멍하니 있는 때가 많은 것 같아"

msgid "adv_105601_0020_msg"
msgstr "확실히 그러네요… 무슨 일 있었던 걸까요?"

msgid "adv_105601_0021_msg"
msgstr "물어봐도 「괜찮아」라고만 해"

msgid "adv_105601_0022_msg"
msgstr "미쿠모는 뭐 아는 거 있어?"

msgid "adv_105601_0023_msg"
msgstr "…글쎄"

msgid "adv_105601_0024_msg"
msgstr "미쿠모 씨, 짐작 가는 게 있으세요?"

msgid "adv_105601_0025_msg"
msgstr "응, 뭐. 하지만… 본인이 아무 말도 하지 않는 이상,\\r\\n그게 맞다고 단정할 수도 없어"

msgid "adv_105601_0026_msg"
msgstr ""

msgid "adv_105601_0027_msg"
msgstr ""

msgid "adv_105601_0028_msg"
msgstr "그럼 지금 우리가 할 수 있는 일을 찾아봐요!\\n레이나 씨!"

msgid "adv_105601_0029_msg"
msgstr "…응"

msgid "adv_105602_0008_msg"
msgstr "즐거웠지, 쿠모쿠모!"

msgid "adv_105602_0009_msg"
msgstr "다 같이 잔뜩 노래하고 이야기하고…\\r\\n왠지 기운이 나기 시작했어!"

msgid "adv_105602_0010_msg"
msgstr "모두 덕분이네"

msgid "adv_105602_0011_msg"
msgstr "그래, 다행이네"

msgid "adv_105602_0012_msg"
msgstr ""

msgid "adv_105602_0013_msg"
msgstr "쿠모쿠모?"

msgid "adv_105602_0014_msg"
msgstr "지난번 라이브에서 나도 봤어"

msgid "adv_105602_0015_msg"
msgstr "다른 시공의 기억"

msgid "adv_105602_0016_msg"
msgstr "어!? 정말?"

msgid "adv_105602_0017_msg"
msgstr "내가 본 기억이랑… 같은 기억이었을까?"

msgid "adv_105602_0018_msg"
msgstr "…글쎄"

msgid "adv_105602_0019_msg"
msgstr "하지만 나도 느꼈어. 다섯이 함께 노래하는 것의 소중함을"

msgid "adv_105602_0020_msg"
msgstr "저쪽 시공과 우리 시공은 달라.\\r\\n…하지만 같은 일이 벌어질 가능성도 제로는 아니야"

msgid "adv_105602_0021_msg"
msgstr "그래서 더더욱 지금을 소중히 하고 싶다고 생각했어"

msgid "adv_105602_0022_msg"
msgstr "지금을 소중히 한다… 응, 그러네!"

msgid "adv_100482501_0003_msg"
msgstr "…마키나. 그건 뭐야?"

msgid "adv_100482501_0004_msg"
msgstr "이건 말이지, 나체냥냥 특제 해파리 춘권이야.\\r\\n신메뉴래! 하나 먹어볼래?"

msgid "adv_100482501_0005_msg"
msgstr "그럼 하나만…"

msgid "adv_100482501_0006_msg"
msgstr "자, 아~!"

msgid "adv_100482501_0007_msg"
msgstr "마키나… 나 혼자 먹을 수 있어"

msgid "adv_100482501_0008_msg"
msgstr "아, 미안! 레이레이한테\\r\\n항상 먹여주다 보니까 나도 모르게…"

msgid "adv_100482501_0009_msg"
msgstr "…여전히 사이좋네"

msgid "adv_100482502_0003_msg"
msgstr "밀레느. 너는 어떤 마음으로 노래해?"

msgid "adv_100482502_0004_msg"
msgstr "어? 어, 어떤 마음이라니…"

msgid "adv_100482502_0005_msg"
msgstr "후훗. 그 반응, 프레이아랑 똑같네.\\r\\n…안심해. 그냥 궁금해서 물어보는 것뿐이야"

msgid "adv_100482502_0006_msg"
msgstr "난 알고 싶어. 다른 시공의\\r\\n가희들이 어떤 마음으로 노래하는지"

msgid "adv_100482502_0007_msg"
msgstr "그렇구나. 글쎄… 나는,\\r\\n『음악을 사랑해!』라는 마음으로, 일까. 미쿠모는?"

msgid "adv_100482502_0008_msg"
msgstr "글쎄… 그건 내 노래에서 느껴봐"

msgid "adv_100482502_0009_msg"
msgstr "앗. 뭐야 그게, 치사해~! 알려줘! 알려달라고~!"

msgid "adv_100482502_0010_msg"
msgstr "후훗… 너도 미라쥬랑 닮아서\\r\\n놀리는 재미가 있겠네"

msgid "adv_100483701_0003_msg"
msgstr "미레미레! 다음에 또 맞춰 입은 의상으로\\n같이 무대에 서지 않을래?\\n이번에는 미레미레 노래가 좋겠어~!"

msgid "adv_100483701_0004_msg"
msgstr "으, 으음. 그러네…"

msgid "adv_100483701_0005_msg"
msgstr "…어라? 미레미레, 별로 내키지 않아?"

msgid "adv_100483701_0006_msg"
msgstr "그런 거 아니야!\\r\\n하지만 있잖아, 이건 절대 마키나 탓은 아닌데…"

msgid "adv_100483701_0007_msg"
msgstr "맞춰 입은 의상을 입고 마키나 옆에 서면,\\r\\n그, 뭐랄까… 체형 차이가…"

msgid "adv_100483701_0008_msg"
msgstr "응?"

msgid "adv_100483701_0009_msg"
msgstr "아, 아냐! 아무것도 아니야! 아무것도!\\r\\n무대, 같이 열심히 해보자!"

msgid "adv_100483702_0003_msg"
msgstr "민민! 마크로스 안은 정말 굉장하네~!!"

msgid "adv_100483702_0004_msg"
msgstr "하아… 여기저기 있는 레트로한 메카들, 너무 귀여워~!\\n전부 라그나로 가져가고 싶을 정도야!"

msgid "adv_100483702_0005_msg"
msgstr "그래? 나한테는 익숙한 것들이지만…\\r\\n마키나는 정말 메카를 좋아하는구나"

msgid "adv_100483702_0006_msg"
msgstr "이 아이들이 익숙해질 정도로,\\n매일 같이 생활하는 거구나…\\n으으, 점점 더 부러워져~"

msgid "adv_100483702_0007_msg"
msgstr "내 시공에서도 이 아이들을 재현할 수 없을까?\\r\\n구조를 알려면 한 번 분해해보고 싶은데…"

msgid "adv_100483702_0008_msg"
msgstr "아앗. 나중에 제대로 원래대로 돌려놓을게!\\n조금만 안을 보여줘~!"

msgid "adv_100483702_0009_msg"
msgstr "마키나… 메카들이 다 도망가고 있어…"

msgid "adv_304301_0008_msg"
msgstr "란카! 안녕"

msgid "adv_304301_0009_msg"
msgstr "아, 민메이 씨!"

msgid "adv_304301_0010_msg"
msgstr "여기가 란카 방이구나.\\n정말 귀엽다"

msgid "adv_304301_0011_msg"
msgstr "어라, 이건…"

msgid "adv_304301_0012_msg"
msgstr "냥냥 유니폼이에요!"

msgid "adv_304301_0013_msg"
msgstr "와아, 귀엽다!"

msgid "adv_304301_0014_msg"
msgstr "혹시 뭔가 도움이 될까 해서\\r\\n준비해봤어요"

msgid "adv_304301_0015_msg"
msgstr "오늘은 냥냥 CM의 이미지를\\n확실히 정해야 하니까요!"

msgid "adv_304301_0016_msg"
msgstr "그러네. 어떤 CM으로 할지\\r\\n잔뜩 이야기해보자!"

msgid "adv_304301_0017_msg"
msgstr "네! 그런데…\\r\\n『냥냥 신규 점포 오픈 기념 캠페인』…이라"

msgid "adv_304301_0018_msg"
msgstr "민메이 씨랑 함께 CM에 출연할 수 있다니\\n정말 기뻐요"

msgid "adv_304301_0019_msg"
msgstr "설마 이런 기회가 생길 줄은…"

msgid "adv_304301_0020_msg"
msgstr "나도 정말 기뻐!\\n이번 캠페인으로 함께 냥냥을 더욱 띄워보자"

msgid "adv_304301_0021_msg"
msgstr "네!"

msgid "adv_304302_0008_msg"
msgstr "민메이 씨, CM 촬영 수고하셨어요!"

msgid "adv_304302_0009_msg"
msgstr "수고했어!\\r\\n참치만두 먹는 장면, 정말 좋았어!"

msgid "adv_304302_0010_msg"
msgstr "란카, 참치만두를 정말 좋아하는구나.\\r\\n너무 맛있게 먹어서 나도 먹고 싶어졌어"

msgid "adv_304302_0011_msg"
msgstr "감사합니다!\\r\\n명물이니까 제대로 홍보해야겠다고 생각해서\\r\\n긴장하긴 했지만… 그래도 즐거웠어요!"

msgid "adv_304302_0012_msg"
msgstr "저도 민메이 씨가 요리를 나르는 장면을 보고\\r\\n감탄했어요!"

msgid "adv_304302_0013_msg"
msgstr "정말 익숙해 보인다고 해야 하나, 저라면\\r\\n떨어뜨릴 것 같은데… 역시 대단하세요!"

msgid "adv_304302_0014_msg"
msgstr "정말? 그렇게 말해주니 기뻐!\\r\\n여러 장면을 찍었으니 완성본이 기대되네"

msgid "adv_304302_0015_msg"
msgstr "후훗, CM 완성되면 같이 봐요!"

msgid "adv_304302_0016_msg"
msgstr "네, 물론이죠!"

msgid "adv_304302_0017_msg"
msgstr "…촬영도 일단락됐으니,\\r\\n슬슬 라이브 연습도 해야지!"

msgid "adv_304302_0018_msg"
msgstr "『샤오파이론』 말고도 란카와 함께\\r\\n여러 곡을 불러보고 싶어!"

msgid "adv_304302_0019_msg"
msgstr "저도 민메이 씨랑 같이 부르고 싶은 곡이\\r\\n잔뜩 있어요!"

msgid "adv_304302_0020_msg"
msgstr "후훗, 기쁘네!"

msgid "adv_304302_0021_msg"
msgstr "그럼 옷 갈아입고 다시 모이자!\\r\\n이번에는 내 방으로 와줘"

msgid "adv_304302_0022_msg"
msgstr "즐거운 라이브가 되도록\\r\\n잔뜩 이야기해보자!"

msgid "adv_304302_0023_msg"
msgstr "네, 민메이 씨!"

msgid "adv_105701_0008_msg"
msgstr "어라? 란카"

msgid "adv_105701_0009_msg"
msgstr "아, 안녕하세요, 란카 씨!"

msgid "adv_105701_0010_msg"
msgstr "미셸 군이랑 루카 군!"

msgid "adv_105701_0011_msg"
msgstr "여기서 뭐 하고 있어?\\r\\n대장님이라면 아직 안 돌아오실 것 같은데…"

msgid "adv_105701_0012_msg"
msgstr "아니, 오늘은 오빠가 아니라,\\r\\n알토 군한테 잠깐 볼일이 있어서…"

msgid "adv_105701_0013_msg"
msgstr "죄송해요, 란카 씨.\\r\\n알토 선배는 아직 훈련 중이에요"

msgid "adv_105701_0014_msg"
msgstr "우리라도 괜찮다면 대신 이야기 들어줄까?\\r\\n뭔가 고민이 있는 것 같으니까"

msgid "adv_105701_0015_msg"
msgstr "고마워!\\r\\n사실 이번에 셰릴 씨와 함께\\r\\nCM에 출연하게 됐는데…"

msgid "adv_105701_0016_msg"
msgstr "와아, 대단하네요!\\n어떤 CM이에요?"

msgid "adv_105701_0017_msg"
msgstr "드레스 CM인데,\\r\\n미궁이 테마야"

msgid "adv_105701_0018_msg"
msgstr "미궁에 길을 잃은 여자아이가,\\r\\n잠들어 있는 소중한 사람을 깨우기 위해\\r\\n노래한다… 같은 느낌이야"

msgid "adv_105701_0019_msg"
msgstr "나는 길을 잃은 여자아이 역할인데,\\r\\n노래에 어떤 마음을 담아야 할지\\r\\n조금 고민돼서"

msgid "adv_105701_0020_msg"
msgstr "그렇구나"

msgid "adv_105701_0021_msg"
msgstr "셰릴 씨한테도 상담하려고 하는데\\r\\n알토 군 의견도 들어보고 싶다고 생각했어"

msgid "adv_105701_0022_msg"
msgstr "그런 거라면 나중에 알토 선배한테\\r\\n전해둘게요!"

msgid "adv_105701_0023_msg"
msgstr "응, 맡겨둬.\\r\\n제대로 답해주라고 말해둘게"

msgid "adv_105701_0024_msg"
msgstr "고마워, 미셸 군, 루카 군!"

msgid "adv_105702_0008_msg"
msgstr ""

msgid "adv_105702_0009_msg"
msgstr "저건… 다른 시공의 셰릴 씨?\\r\\n그리고 노래하고 있던 건…"

msgid "adv_105702_0010_msg"
msgstr "나…?"

msgid "adv_105702_0013_msg"
msgstr "란카, 촬영 수고했어!\\r\\n좋은 느낌의 CM이 될 것 같네"

msgid "adv_105702_0014_msg"
msgstr ""

msgid "adv_105702_0015_msg"
msgstr "란카? 왜 그래?"

msgid "adv_105702_0016_msg"
msgstr "셰릴 씨! 죄송해요…"

msgid "adv_105702_0017_msg"
msgstr "뭔가 멍하니 있었던 것 같은데 괜찮아?\\r\\n오랜 시간 촬영했으니 피곤해진 걸까?"

msgid "adv_105702_0018_msg"
msgstr "아니요! 괜찮아요…"

msgid "adv_105702_0019_msg"
msgstr ""

msgid "adv_105702_0020_msg"
msgstr "정말 괜찮아?"

msgid "adv_105702_0021_msg"
msgstr "저기, 셰릴 씨.\\r\\n저, 만약 셰릴 씨가 잠들어버리더라도…"

msgid "adv_105702_0022_msg"
msgstr "내가?"

msgid "adv_105702_0023_msg"
msgstr "아니에요, 아무것도 아니에요!"

msgid "adv_105702_0024_msg"
msgstr "셰릴 씨, 조금만 더 같이 노래하지 않을래요?\\r\\n함께 노래할 수 있는 시간을 소중히 하고 싶다고 해야 하나…"

msgid "adv_105702_0025_msg"
msgstr "아무튼 셰릴 씨랑\\r\\n잔뜩 노래하고 싶은 기분이에요!"

msgid "adv_105702_0026_msg"
msgstr "물론이지"

msgid "adv_105702_0027_msg"
msgstr "감사합니다!"

msgid "adv_100490901_0003_msg"
msgstr "으음… 저도 미쿠모 씨처럼 프로필을\\r\\n비밀로 해보면 조금은 미스터리하게 보일까요?"

msgid "adv_100490901_0004_msg"
msgstr "지금의 자신을 억지로 바꿀 필요는 없지 않아?\\r\\n나도 딱히 숨기려는 건 아니야"

msgid "adv_100490901_0005_msg"
msgstr "그저 부르고 싶은 곡을 부를 뿐"

msgid "adv_100490901_0006_msg"
msgstr "부르고 싶은 곡을…"

msgid "adv_100490901_0007_msg"
msgstr "『성간비행』도 부를 거야. 물론 안무도 곁들여서"

msgid "adv_100490901_0008_msg"
msgstr "네에!? 정말이에요!?"

msgid "adv_100490901_0009_msg"
msgstr "후훗, 글쎄"

msgid "adv_100490902_0003_msg"
msgstr "란카~! 정말, 들어봐! 바사라가 말이야…!"

msgid "adv_100490902_0004_msg"
msgstr "후훗… 바사라 씨랑 밀레느,\\r\\n정말 사이좋지"

msgid "adv_100490902_0005_msg"
msgstr "뭐!? 그렇지 않아!\\r\\n누가 바사라 같은 녀석이랑…!"

msgid "adv_100490902_0006_msg"
msgstr "그래도 당당하게 속마음을 말하고,\\r\\n싸울 수 있는 상대가 있다는 건 좋겠다고 생각해!"

msgid "adv_100490902_0007_msg"
msgstr "으음… 그런가?\\r\\n그러고 보니 란카랑 셰릴은 싸우지 않네"

msgid "adv_100490902_0008_msg"
msgstr "그러게… 하지만 셰릴 씨는 늘 다정하고\\r\\n어른스러우니까 말다툼할 일은 없는 것 같아"

msgid "adv_100490902_0009_msg"
msgstr "그렇구나… 나랑 바사라한테 부족한 건\\r\\n서로에 대한 리스펙트인 걸까…?"

msgid "adv_100492101_0003_msg"
msgstr "앗! 레이나, 마침 잘 왔어! 있잖아, 지금 시간 있어?"

msgid "adv_100492101_0004_msg"
msgstr "있다고 하면 있어"

msgid "adv_100492101_0005_msg"
msgstr "그럼 네 시간을 나한테 줘.\\r\\n전부터 네 패션에 관심이 있었거든"

msgid "adv_100492101_0006_msg"
msgstr "평소 레이나가 입는 옷의 분위기를\\r\\n다음 라이브 의상에 넣어보고 싶었거든"

msgid "adv_100492101_0007_msg"
msgstr "알겠어. 대신 셰릴의 시간도 줘"

msgid "adv_100492101_0008_msg"
msgstr "후훗, 좋아. 그럼 오늘은 서로의\\r\\n패션에 대해 마음껏 이야기해보자!"

msgid "adv_100492101_0009_msg"
msgstr "제대로 이야기해볼게"

msgid "adv_100492102_0003_msg"
msgstr "그래서 셰리셰리.\\r\\n상담할 게 있다고 했는데, 무슨 일 있었어?"

msgid "adv_100492102_0004_msg"
msgstr "응. 다음에 라이브가 있는데 의상 때문에 조금 고민 중이야.\\r\\n그래서 마키나의 힘을 빌릴 수 있으면 해서… 안 될까?"

msgid "adv_100492102_0005_msg"
msgstr "전혀! 안 될 리가 없지~! 오히려 대환영이야!\\r\\n셰리셰리가 나한테 의지해준다니 기뻐~!"

msgid "adv_100492102_0006_msg"
msgstr "고마워. 그렇게 말해주니 안심이네! 이건데\\r\\n말이야… 이 연출에서는 아무래도 의상이 묻혀버려"

msgid "adv_100492102_0007_msg"
msgstr "그렇구나, 그렇구나… 응응. 그럼 이런 건 어때?\\r\\n이거라면 연출에 방해도 안 될 것 같아"

msgid "adv_100492102_0008_msg"
msgstr "…응, 좋네! 역시 마키나야!\\r\\n다음에 답례하게 해줘"

msgid "adv_100492102_0009_msg"
msgstr "천만에! 하지만 답례는 필요 없어.\\r\\n셰리셰리가 기뻐해주는 것만으로 충분하니까!"

msgid "adv_304401_0008_msg"
msgstr "어디 보자… 준비할 건,\\r\\n재료랑 앞치마랑 주방용품이랑…"

msgid "adv_304401_0009_msg"
msgstr "그리고 주인공인 초콜릿!"

msgid "adv_304401_0010_msg"
msgstr "셰리셰리, 준비 완벽하네"

msgid "adv_304401_0011_msg"
msgstr "모처럼 마키나랑 카나메가 초콜릿 만드는 법을\\r\\n가르쳐주는걸"

msgid "adv_304401_0012_msg"
msgstr "당연하잖아?"

msgid "adv_304401_0013_msg"
msgstr "에헤헤, 오늘은 우리한테 맡겨!"

msgid "adv_304401_0014_msg"
msgstr "모르는 게 있으면\\r\\n언제든 물어보세요"

msgid "adv_304401_0015_msg"
msgstr "고마워, 카나메, 마키나"

msgid "adv_304401_0016_msg"
msgstr "그런데 셰리셰리가\\n「초콜릿 만드는 법을 알려줘」라고\\n했을 때는 깜짝 놀랐어"

msgid "adv_304401_0017_msg"
msgstr "알알이 좋아해주면 좋겠다!"

msgid "adv_304401_0018_msg"
msgstr "벼, 별로 알토를 위해 만드는 건 아니야!"

msgid "adv_304401_0019_msg"
msgstr "밸런타인데이 라이브를 앞두고,\\r\\n마음을 가다듬고 싶었을 뿐이야"

msgid "adv_304401_0020_msg"
msgstr "후훗, 그렇구나, 그렇구나!"

msgid "adv_304401_0021_msg"
msgstr "저희도 왈큐레 모두에게\\r\\n매년 초콜릿을 선물하고 있어요"

msgid "adv_304401_0022_msg"
msgstr "받는 사람이 기뻐할 만한\\r\\n맛있는 초콜릿을 만들어봐요!"

msgid "adv_304401_0023_msg"
msgstr "응! 바로 시작할까"

msgid "adv_304402_0008_msg"
msgstr "셰리셰리! 좋은 라이브가 됐네!\\r\\n정말 즐거웠어~!"

msgid "adv_304402_0009_msg"
msgstr "갑작스럽긴 했지만 왈큐레 모두가\\r\\n게스트로 와줘서 다행이야"

msgid "adv_304402_0010_msg"
msgstr "애절한 밸런타인데이라는 테마,\\r\\n이번 라이브와 곡에 딱 맞았지!"

msgid "adv_304402_0011_msg"
msgstr "응, 그러네!"

msgid "adv_304402_0012_msg"
msgstr "……맞다, 마키나"

msgid "adv_304402_0013_msg"
msgstr "밸런타인데이 초콜릿,\\r\\n도와줘서 고마워"

msgid "adv_304402_0014_msg"
msgstr "란카도 그레이스 일행도 좋아해줬어!\\r\\n카나메한테도 고맙다고 전해줘"

msgid "adv_304402_0015_msg"
msgstr "그렇구나! 다행이다~!!"

msgid "adv_304402_0016_msg"
msgstr ""

msgid "adv_304402_0017_msg"
msgstr "셰리셰리, 왜 그래?"

msgid "adv_304402_0018_msg"
msgstr "마키나가 신경 쓰는 것 같았으니까,\\r\\n일단 말해두는데……"

msgid "adv_304402_0019_msg"
msgstr "알토한테도 제대로 전해줬어"

msgid "adv_304402_0020_msg"
msgstr "정말!? 에~ 그 이야기 좀 더 자세히 들려줘!"

msgid "adv_304402_0021_msg"
msgstr "정말… 앙코르 끝나고 말해줄게.\\r\\n지금은 일단 노래하자!"

msgid "adv_304402_0022_msg"
msgstr "네~! 즐기자, 셰리셰리!"

msgid "adv_304402_0023_msg"
msgstr "응!"

msgid "adv_105801_0008_msg"
msgstr "오~! 눈이 엄청 많이 와요!"

msgid "adv_105801_0009_msg"
msgstr "마키나 씨, 레이나 씨!\\r\\n오늘은 이 행성에서 라이브를 하는 거죠?"

msgid "adv_105801_0010_msg"
msgstr "무슨 기념이라고 했더라…?"

msgid "adv_105801_0011_msg"
msgstr "축제 기념 라이브"

msgid "adv_105801_0012_msg"
msgstr "맞아 맞아! 이 행성에서 오래전부터 열리고 있는\\r\\n눈 축제 기념 라이브야"

msgid "adv_105801_0013_msg"
msgstr "맞다!\\n눈 축제, 진짜 좋네요~!"

msgid "adv_105801_0014_msg"
msgstr "그런데…"

msgid "adv_105801_0015_msg"
msgstr ""

msgid "adv_105801_0016_msg"
msgstr ""

msgid "adv_105801_0017_msg"
msgstr "마키나 씨? 레이나 씨?"

msgid "adv_105801_0018_msg"
msgstr "…추워"

msgid "adv_105801_0019_msg"
msgstr "응, 엄청 추워~! 못 견디겠어~!\\n프레프레는 평소처럼 쌩쌩하네…"

msgid "adv_105801_0020_msg"
msgstr "추운 건 익숙하니까요!"

msgid "adv_105801_0021_msg"
msgstr "게다가 이 추위는 윈더미어가 생각나요"

msgid "adv_105801_0022_msg"
msgstr "…언젠가 윈더미어에서도\\r\\n왈큐레 라이브를 할 수 있으면 좋겠다"

msgid "adv_105801_0023_msg"
msgstr "…그러게"

msgid "adv_105801_0024_msg"
msgstr ""

msgid "adv_105801_0025_msg"
msgstr "프레프레…"

msgid "adv_105801_0026_msg"
msgstr "…슬슬 무대로 갈까!\\r\\n카나카나 일행도 기다리고 있을 테니까!"

msgid "adv_105801_0027_msg"
msgstr "네엣!"

msgid "adv_105801_0028_msg"
msgstr "알겠어"

msgid "adv_105801_0029_msg"
msgstr ""

msgid "adv_105802_0008_msg"
msgstr "후훗, 눈놀이 정말 즐거웠지!"

msgid "adv_105802_0009_msg"
msgstr "카나카나도 처음엔 당황했지만\\r\\n결국 제일 신나게 놀았고!"

msgid "adv_105802_0010_msg"
msgstr "미쿠모도 꽤 진심으로 놀았어"

msgid "adv_105802_0011_msg"
msgstr "그렇지!\\r\\n그리고 프레프레도 기운을 차린 것 같고…"

msgid "adv_105802_0012_msg"
msgstr "…다행이야"

msgid "adv_105802_0013_msg"
msgstr "역시 고향이 생각나면\\r\\n조~금 쓸쓸해질 때도 있잖아"

msgid "adv_105802_0014_msg"
msgstr "나"

msgid "adv_105802_0015_msg"
msgstr "레이레이?"

msgid "adv_105802_0016_msg"
msgstr "프레이아가 말한 것처럼\\r\\n언젠가 윈더미어에서도 라이브를 하고 싶어"

msgid "adv_105802_0017_msg"
msgstr "프레이아의 소중한 고향에서 노래하고 싶어"

msgid "adv_105802_0018_msg"
msgstr "왈큐레로서, 함께"

msgid "adv_105802_0019_msg"
msgstr "…응, 그러네"

msgid "adv_105802_0020_msg"
msgstr "언젠가 윈더미어에서 라이브를 하게 되면\\n프레프레의 룬이 반짝반짝 빛날 만큼\\n너무 귀여운 의상을 준비해야지!"

msgid "adv_105802_0021_msg"
msgstr "지금은 그날을 위해,\\r\\n우리가 할 수 있는 걸 하자!"

msgid "adv_105802_0022_msg"
msgstr "응, 힘껏 노래할게"

msgid "adv_100499301_0003_msg"
msgstr "레이레이! 오랜만에 한번 싸워볼래?"

msgid "adv_100499301_0004_msg"
msgstr "싸움… 알겠어. 받아주지"

msgid "adv_100499301_0005_msg"
msgstr "좋아, 그럼 바로… 어디 보자, 으음…\\n레이레이 바보! 장난꾸러기!\\n그런 점이 너무 귀여운 개구쟁이!"

msgid "adv_100499301_0006_msg"
msgstr "마키나, 중간부터 전혀 욕이 아니야"

msgid "adv_100499301_0007_msg"
msgstr "으음… 역시 안 되겠네.\\r\\n레이레이랑 싸우는 건 못 하겠어…"

msgid "adv_100499301_0008_msg"
msgstr "당연"

msgid "adv_100499301_0009_msg"
msgstr "난 어떤 마키나도 싫어할 수 없어"

msgid "adv_100499301_0010_msg"
msgstr "나도 그래! 레이레~이!"

msgid "adv_100499302_0003_msg"
msgstr "으, 으음…?"

msgid "adv_100499302_0004_msg"
msgstr "앗… 카나카나 미안, 깨웠어?"

msgid "adv_100499302_0005_msg"
msgstr "마키나? …어머, 나 테이블에서\\n잠들어버렸구나… 이 담요, 마키나가 덮어준 거야?"

msgid "adv_100499302_0006_msg"
msgstr "응. 열심히 하는 것도 좋지만 무리하면 안 돼.\\n자, 이제 방으로 돌아가자?"

msgid "adv_100499302_0007_msg"
msgstr "그래야겠네… 그런데 마키나.\\n너까지 내 방에 올 생각이야?"

msgid "adv_100499302_0008_msg"
msgstr "안 그러면 카나카나 또 일할 것 같으니까.\\n오늘은 레이레이랑 같이 자고 갈까~?"

msgid "adv_100499302_0009_msg"
msgstr "정말… 그래도 고마워. 걱정 끼쳐서 미안해"

msgid "adv_100500501_0003_msg"
msgstr "…됐다! 해파리 장식 썰기…!"

msgid "adv_100500501_0004_msg"
msgstr "잘하잖아! 역시 레이나, 배우는 게 빠르네"

msgid "adv_100500501_0005_msg"
msgstr "카나메가 잘 가르치는 것뿐. 칭찬하는 것도.\\r\\n…카나메의 그런 점, 대단해"

msgid "adv_100500501_0006_msg"
msgstr "그렇지 않아. 레이나가 빨리 성장하는 거야"

msgid "adv_100500501_0007_msg"
msgstr "그런데… 후훗, 예전의 레이나와 비교하면,\\r\\n정말 많이 성장했네"

msgid "adv_100500501_0008_msg"
msgstr "옛날 얘기는 없어. 중요한 건 언제나 지금"

msgid "adv_100500501_0009_msg"
msgstr "후훗, 미안해. 그렇지"

msgid "adv_100500502_0003_msg"
msgstr "『린 민메이 이야기』, 보고 왔어"

msgid "adv_100500502_0004_msg"
msgstr "어머, 또 보고 왔어? 후훗, 레이나한테\\n이 보고를 받는 것도 벌써 몇 번째일까"

msgid "adv_100500502_0005_msg"
msgstr "몇 번을 봐도 재미있어. 정말 좋아해. 하지만…"

msgid "adv_100500502_0006_msg"
msgstr "하지만?"

msgid "adv_100500502_0007_msg"
msgstr "요즘은 진짜 민메이를 보는 것도 좋아. 이야기하면 즐거워"

msgid "adv_100500502_0008_msg"
msgstr "깜짝 놀라게 해주고 싶어져"

msgid "adv_100500502_0009_msg"
msgstr "에엣? 저기… 장난은 적당히, 알았지?"

msgid "adv_1401101_0008_msg"
msgstr "어, 프레이아"

msgid "adv_1401101_0009_msg"
msgstr "아, 하야테!"

msgid "adv_1401101_0010_msg"
msgstr "아이스스케이트 연습은 이제 끝났어?"

msgid "adv_1401101_0011_msg"
msgstr "프레이아가 너무 많이 넘어져서\\r\\n카나메 씨가 곤란해했다던데?"

msgid "adv_1401101_0012_msg"
msgstr "그건 지난번 라이브 때 얘기잖아!\\r\\n지금은 이제 완벽하게 탈 수 있다고!"

msgid "adv_1401101_0013_msg"
msgstr "미안, 미안. 그랬지"

msgid "adv_1401101_0014_msg"
msgstr "전혀 미안해하는 것 같지 않아!"

msgid "adv_1401101_0015_msg"
msgstr "그래서… 창밖을 멍하니 보고 있던데, 무슨 일이야?"

msgid "adv_1401101_0016_msg"
msgstr "…지난번 라이브를 떠올리고 있었어"

msgid "adv_1401101_0017_msg"
msgstr "지난번 라이브에서 마키나 씨랑 레이나 씨랑\\r\\n이야기했는데…"

msgid "adv_1401101_0018_msg"
msgstr "언젠가 윈더미어에서도 라이브를 하고 싶다고 생각했어"

msgid "adv_1401101_0019_msg"
msgstr "관객도 델타 소대도,\\r\\n왈큐레도, 모두가 웃는 즐거운 라이브…"

msgid "adv_1401101_0020_msg"
msgstr "살아 있다는 걸 실감할 수 있는 그런 라이브를"

msgid "adv_1401101_0021_msg"
msgstr "그렇구나~. 그래서 그렇게 심각한 표정을 하고 있었구나"

msgid "adv_1401101_0022_msg"
msgstr ""

msgid "adv_1401101_0023_msg"
msgstr "있잖아, 프레이아.\\r\\n다음 라이브, 기대하고 있어"

msgid "adv_1401101_0024_msg"
msgstr "후에??"

msgid "adv_1401101_0025_msg"
msgstr "좀 재미있는 게 떠올랐거든. 그럼 간다"

msgid "adv_1401101_0027_msg"
msgstr "…하야테, 대체 뭘 하려는 걸까?"

msgid "adv_1401102_0008_msg"
msgstr "하야테!"

msgid "adv_1401102_0009_msg"
msgstr "수고했어, 프레이아. 오늘 라이브 대단하더라"

msgid "adv_1401102_0010_msg"
msgstr "진짜 깜짝 놀랐어!\\r\\n설마 맥스 씨가 와줄 줄은 몰랐거든…"

msgid "adv_1401102_0011_msg"
msgstr "레이나가 여러 가지 방법을 생각해줬어."

msgid "adv_1401102_0012_msg"
msgstr "아마 초시공 유닛 라이브를\\r\\n조정했다던가, 뭐라던가…?"

msgid "adv_1401102_0013_msg"
msgstr "뭐, 아무튼 『관객도 델타 소대도\\r\\n왈큐레도, 모두가 웃는 즐거운 라이브』\\r\\n가 됐잖아?"

msgid "adv_1401102_0014_msg"
msgstr "응! 나도 진짜 즐거웠어!"

msgid "adv_1401102_0015_msg"
msgstr "…지금 상황에선 윈더미어에서 라이브를 하는 건,\\r\\n조금 먼 이야기가 될 것 같지만"

msgid "adv_1401102_0016_msg"
msgstr "언젠가 할 수 있게 되면\\r\\n이렇게 게스트로 와달라고 하는 것도 괜찮겠지"

msgid "adv_1401102_0017_msg"
msgstr "우히히, 그러네!"

msgid "adv_1401102_0018_msg"
msgstr ""

msgid "adv_1401102_0019_msg"
msgstr "뭐야?"

msgid "adv_1401102_0020_msg"
msgstr "하야테, 고마워!"

msgid "adv_1401102_0021_msg"
msgstr "천만에"

msgid "adv_105901_0008_msg"
msgstr "있잖아, 바사라! 좋은 생각 같지 않아?"

msgid "adv_105901_0009_msg"
msgstr "전혀"

msgid "adv_105901_0010_msg"
msgstr "에~! 왜!"

msgid "adv_105901_0011_msg"
msgstr "그러니까 난 관심 없다고 했잖아"

msgid "adv_105901_0012_msg"
msgstr "그러지 말고! 부탁이야!"

msgid "adv_105901_0013_msg"
msgstr "싫어"

msgid "adv_105901_0014_msg"
msgstr "밀레느, 바사라. 또 싸우는 거야?"

msgid "adv_105901_0015_msg"
msgstr "아, 레이!"

msgid "adv_105901_0016_msg"
msgstr "싸우는 거 아니야. 밀레느가 혼자 떠들고 있는 것뿐이지"

msgid "adv_105901_0017_msg"
msgstr "바사라가 제대로 안 들어주니까 그렇잖아!\\r\\n잠깐, 어디 가는 거야!"

msgid "adv_105901_0018_msg"
msgstr "정말! 아직 얘기 안 끝났는데…"

msgid "adv_105901_0019_msg"
msgstr "자자, 진정해. 그래서 무슨 얘기였는데?"

msgid "adv_105901_0020_msg"
msgstr "다음 라이브, 놀이공원 근처에서 하잖아?\\r\\n그래서 이왕이면 다 같이 놀 수 없을까 해서…"

msgid "adv_105901_0021_msg"
msgstr "그런데 바사라는 싫다는 말만 반복하면서\\r\\n전~혀 들어주질 않아!"

msgid "adv_105901_0022_msg"
msgstr "…요즘 계속 바빴으니까,\\r\\n바사라도 좀 기분 전환을 했으면 하는데"

msgid "adv_105901_0023_msg"
msgstr "그렇구나. 확실히 가끔은 바사라도 기분 전환이\\r\\n필요할 때가 있지"

msgid "adv_105901_0024_msg"
msgstr "밀레느, 나한테 맡겨보지 않을래?"

msgid "adv_105901_0025_msg"
msgstr "어?"

msgid "adv_105901_0026_msg"
msgstr "뭐, 어떻게든 해볼게"

msgid "adv_105902_0008_msg"
msgstr "바사라, 어땠어?\\r\\n가끔은 이런 것도 좋았지~?"

msgid "adv_105902_0009_msg"
msgstr "뭐가?"

msgid "adv_105902_0010_msg"
msgstr "뭐긴 뭐야… 놀이공원에서 기분 전환한 거!"

msgid "adv_105902_0011_msg"
msgstr "뭐, 좋은 곡이 나왔으니까 나쁘진 않았어"

msgid "adv_105902_0012_msg"
msgstr "에헤헤, 그렇지? 나랑 레이한테 감사하라고!"

msgid "adv_105902_0013_msg"
msgstr "그보다 밀레느.\\r\\n어제 만든 곡, 다음 라이브에서 한다"

msgid "adv_105902_0014_msg"
msgstr "…어?"

msgid "adv_105902_0015_msg"
msgstr "그러니까 어제 만든 곡 말이야"

msgid "adv_105902_0016_msg"
msgstr "잠깐 잠깐! 방금 라이브 끝난 참인데?\\r\\n애초에 다음 라이브는 아직 정해지지도 않았잖아?"

msgid "adv_105902_0017_msg"
msgstr "모레야"

msgid "adv_105902_0018_msg"
msgstr "거짓말!?"

msgid "adv_105902_0019_msg"
msgstr "레이한테 부탁했어"

msgid "adv_105902_0020_msg"
msgstr "알았으면 연습해둬"

msgid "adv_105902_0021_msg"
msgstr "뭐!? 잠깐 바사라!? 아무리 그래도 모레까지는…"

msgid "adv_105902_0022_msg"
msgstr "정말! 제멋대로라니까!"

msgid "adv_100507701_0003_msg"
msgstr "있잖아, 바사라. 다음 라이브에서 할 곡 말인데…"

msgid "adv_100507701_0004_msg"
msgstr "그래, 나도 마침 생각하고 있었어. \\r\\n할 곡이랑 공연장 분위기가 안 맞아"

msgid "adv_100507701_0005_msg"
msgstr "맞아! 웬일로 의견이 맞았네!\\r\\n그래서 세트리스트를 바꾸려고 해!"

msgid "adv_100507701_0006_msg"
msgstr "아니, 필요한 건 신곡이야"

msgid "adv_100507701_0007_msg"
msgstr "뭐!? 신곡!? 라이브까지 이제 얼마 안 남았잖아?"

msgid "adv_100507701_0008_msg"
msgstr "괜찮겠지. 자, 빨리 스튜디오 가자!"

msgid "adv_100507701_0009_msg"
msgstr "아 정말, 웬일로 의견이 맞나 했더니!\\r\\n바사라 바보!"

msgid "adv_100507702_0003_msg"
msgstr "…흠흠, 그렇구나"

msgid "adv_100507702_0004_msg"
msgstr "밀레느, 뭐 하고 있어?"

msgid "adv_100507702_0005_msg"
msgstr "민메이 씨! 사실 해킹에 대해\\r\\n조금 공부하고 있어요!"

msgid "adv_100507702_0006_msg"
msgstr "레이나랑 브레라를 보고 있으니까,\\n왠지 저도 해보고 싶어져서요!"

msgid "adv_100507702_0007_msg"
msgstr "하지만… 해킹은 위험한 거 아니야?"

msgid "adv_100507702_0008_msg"
msgstr "괜찮아요! 레이나한테\\r\\n제대로 배우면서 하고 있으니까요!"

msgid "adv_100507702_0009_msg"
msgstr "빨리 「특기는 해킹!」 같은 말 해보고 싶다~!"

msgid "adv_100508901_0003_msg"
msgstr "에헤헤……"

msgid "adv_100508901_0004_msg"
msgstr "왈큐레 신곡 재킷이야?\\r\\n어떻게 안 질리고 계속 보고 있냐…"

msgid "adv_100508901_0005_msg"
msgstr "몇 번을 봐도 안 질려~. 프레프레는 활짝 웃고 있고,\\n쿠모쿠모는 여신 같은 미소라 넋을 놓게 되고…"

msgid "adv_100508901_0006_msg"
msgstr "카나카나는 딱 멋지게 표정을 잡아서 짜릿해!\\r\\n그리고 무엇보다 레이레이의 수줍은 표정!"

msgid "adv_100508901_0007_msg"
msgstr "너무 귀여워~!"

msgid "adv_100508901_0008_msg"
msgstr "…너, 정말 왈큐레를 좋아하는구나"

msgid "adv_100508901_0009_msg"
msgstr "당연하지! 왈큐레는 내 보물이고,\\n모두 정말 소중한 사람들이니까"

msgid "adv_100508902_0003_msg"
msgstr "후~ 좋네! 역시 카레는 엄청 매워야 제맛이지"

msgid "adv_100508902_0004_msg"
msgstr "정말 매워 보이는 카레네요…\\r\\n바사라 씨가 있는 세계에서는 그런 게 인기인가요?"

msgid "adv_100508902_0005_msg"
msgstr "아니, 인기 있는지는 모르겠고\\r\\n그냥 내가 좋아해서 먹는 거야"

msgid "adv_100508902_0006_msg"
msgstr "좋겠다, 저도 먹어보고 싶어졌어요!"

msgid "adv_100508902_0007_msg"
msgstr "그럼 특별한 레시피를 알려줄게"

msgid "adv_100508902_0008_msg"
msgstr "카레에 매운 소스랑 고추를 넣어봐. 맛이 확 살아"

msgid "adv_100508902_0009_msg"
msgstr "매운 소스랑 고추… 네! 다음에 해볼게요!"

msgid "adv_001003_0003_msg"
msgstr "란카, 기다렸지!\\n오늘 파티용으로 맛있는 케이크 사왔어!"

msgid "adv_001003_0004_msg"
msgstr "그리고 이게 추천하는… 그런데,\\r\\n그렇게 허둥대면서 무슨 일이야?"

msgid "adv_001003_0005_msg"
msgstr "셰릴 씨! 크, 큰일이에요!\\r\\n도와주세요!!"

msgid "adv_001003_0006_msg"
msgstr "…어?"

msgid "adv_001003_0009_msg"
msgstr "그렇구나, 소속사에서 보내준 봉투가\\r\\n사라져버린 거네"

msgid "adv_001003_0010_msg"
msgstr "네… 도착한 뒤에 거실 테이블 위에\\n올려둔 줄 알았는데요"

msgid "adv_001003_0011_msg"
msgstr "아무리 찾아도 전혀 안 보여서…"

msgid "adv_001003_0012_msg"
msgstr "그렇게 당황한 걸 보니,\\r\\n꽤 중요한 게 들어 있었나 보네?"

msgid "adv_001003_0013_msg"
msgstr "사실 소속사에서 보내준 건,\\r\\n제가 메이저 데뷔하기 전의 영상이에요"

msgid "adv_001003_0014_msg"
msgstr "메이저 데뷔 전 영상?"

msgid "adv_001003_0015_msg"
msgstr "네!\\r\\n계속 보관해주고 있었나 봐요…"

msgid "adv_001003_0016_msg"
msgstr "절대, 절~대로 아무한테도 보여주고 싶지 않은 영상인데!\\r\\n대체 어디로 간 거지…"

msgid "adv_001003_0017_msg"
msgstr "누가 실수로 가져간 건 아닐까?\\r\\n짐작 가는 데 없어?"

msgid "adv_001003_0018_msg"
msgstr "짐작 가는 데… 앗!!"

msgid "adv_304501_0008_msg"
msgstr "민메이 씨~! 슬슬 쉬지 않을래요?"

msgid "adv_304501_0009_msg"
msgstr "민메이 씨 덕분에 리허설도 순조롭고요!\\r\\n지금 쉬어두자고요!"

msgid "adv_304501_0010_msg"
msgstr "응, 고마워!"

msgid "adv_304501_0011_msg"
msgstr "에헤헤…"

msgid "adv_304501_0012_msg"
msgstr "왜 그래?"

msgid "adv_304501_0013_msg"
msgstr "죄송해요! 저, 민메이 씨와 함께하는 라이브를\\r\\n정말 기대하고 있었거든요…"

msgid "adv_304501_0014_msg"
msgstr "저도 모르게 자꾸 웃음이 나와요!"

msgid "adv_304501_0015_msg"
msgstr "정말? 그렇게 말해주니 나도 기뻐!"

msgid "adv_304501_0016_msg"
msgstr "오랜만에 Fire Bomber 여러분과\\r\\n마음껏 노래할 수 있는걸. 본무대에서는 신나게 즐기자!"

msgid "adv_304501_0017_msg"
msgstr "네!"

msgid "adv_304501_0018_msg"
msgstr "어, 민메이"

msgid "adv_304501_0019_msg"
msgstr "아, 바사라"

msgid "adv_304501_0020_msg"
msgstr "바사라 씨!"

msgid "adv_304501_0021_msg"
msgstr ""

msgid "adv_304501_0022_msg"
msgstr "어, 저기…?"

msgid "adv_304501_0023_msg"
msgstr "잠깐 바사라! 그렇게 빤히 쳐다보면\\r\\n민메이 씨한테 실례잖아!"

msgid "adv_304501_0024_msg"
msgstr "여행을 떠나자"

msgid "adv_304501_0025_msg"
msgstr "………네?"

msgid "adv_304501_0026_msg"
msgstr "뭐어어어!?"

msgid "adv_304502_0008_msg"
msgstr "바사라 씨, 오늘 정말 즐거운 라이브였어요!\\r\\n감사합니다!"

msgid "adv_304502_0009_msg"
msgstr "그래, 꽤 좋았어"

msgid "adv_304502_0010_msg"
msgstr "정말요?\\r\\n분명 바사라 씨 덕분이에요"

msgid "adv_304502_0011_msg"
msgstr "이번에 여행을 떠나 여러 행성을 돌아다니면서…\\r\\n제가 모르는 게 정말 많다는 걸 느꼈어요"

msgid "adv_304502_0012_msg"
msgstr "설레고 두근거리는…\\r\\n모든 게 새롭게 느껴지는 그런 여행이었어요"

msgid "adv_304502_0013_msg"
msgstr "정말 감사합니다!"

msgid "adv_304502_0014_msg"
msgstr "난 딱히 아무것도 안 했어.\\r\\n뭘 느끼는지는 자기 하기 나름이야"

msgid "adv_304502_0015_msg"
msgstr "후훗, 그럴지도 모르겠네요"

msgid "adv_304502_0016_msg"
msgstr "밀레느한테는 조금 걱정을 끼치긴 했지만…\\n바사라 씨와 여행할 수 있어서 좋았어요"

msgid "adv_304502_0017_msg"
msgstr "밀레느가 시끄러운 건 늘 있는 일이니까.\\r\\n너무 신경 쓰지 마"

msgid "adv_304502_0018_msg"
msgstr "우후훗! 그런 말 하면 밀레느한테\\r\\n혼나요?"

msgid "adv_304502_0019_msg"
msgstr "늘 있는 일이지"

msgid "adv_304502_0020_msg"
msgstr "그보다 준비됐어?\\r\\n슬슬 앙코르하러 간다"

msgid "adv_304502_0021_msg"
msgstr "네! 잘 부탁드립니다!"

msgid "adv_106101_0003_msg"
msgstr "프레이아, 하야테 군.\\r\\n출격 준비는 됐어?"

msgid "adv_106101_0004_msg"
msgstr "네엣!\\r\\n오늘도 기운 팍팍 힘낼게요!"

msgid "adv_106101_0005_msg"
msgstr "부탁한다, 프레이아"

msgid "adv_106101_0006_msg"
msgstr "네엣!"

msgid "adv_106101_0007_msg"
msgstr "…초고대 시스템 「새의 인간」"

msgid "adv_106101_0008_msg"
msgstr "이 녀석 때문에\\r\\n여러 사람의 기억이 사라지고 있는 거지?"

msgid "adv_106101_0009_msg"
msgstr "응. 우리나 민메이 씨, Fire Bomber,\\r\\n셰릴 씨와 란카 씨…"

msgid "adv_106101_0010_msg"
msgstr "시공을 넘은 모두의 협력 덕분에,\\r\\n새의 인간의 위협은 일시적으로 잠잠해지고 있었어"

msgid "adv_106101_0011_msg"
msgstr "하지만 최근 들어 다시 심해지기 시작해서…"

msgid "adv_106101_0012_msg"
msgstr "레이나를 중심으로 여러 가지를 조사하고 있지만,\\r\\n아직 원인은 불명이야"

msgid "adv_106101_0013_msg"
msgstr "모처럼 되찾은 모두의 기억이…"

msgid "adv_106101_0014_msg"
msgstr "아니, 우울해하고 있을 때가 아니야.\\r\\n우리가 할 일은 변하지 않았잖아!"

msgid "adv_106101_0015_msg"
msgstr "그렇지"

msgid "adv_106101_0016_msg"
msgstr ""

msgid "adv_106101_0017_msg"
msgstr "하야테, 왜 웃는 거야?"

msgid "adv_106101_0018_msg"
msgstr "아니, 그립다고 생각해서.\\r\\n처음 새의 인간과 싸웠을 때도 비슷한 얘기 하지 않았나?"

msgid "adv_106101_0019_msg"
msgstr "으음, 그랬던가?"

msgid "adv_106101_0020_msg"
msgstr "뭐, 됐어. 가자, 프레이아!"

msgid "adv_106101_0021_msg"
msgstr "네엣!"

msgid "adv_106101_0023_msg"
msgstr "후훗, 이렇게 심각한 상황인데도…\\r\\n저 둘은 변함없어서 왠지 안심이 되네"

msgid "adv_106101_0024_msg"
msgstr "너도 그렇게 생각하지 않아?"

msgid "adv_106101_0026_msg"
msgstr "…이번 작전에는 네 협력도 필요해"

msgid "adv_106101_0027_msg"
msgstr "부탁할게, 우리에게 힘을 빌려줄래?"

msgid "adv_106102_0003_msg"
msgstr "레이레~이! 어때? 분석은 순조로워?"

msgid "adv_106102_0004_msg"
msgstr "다들 덕분에 데이터도 잔뜩 모여서\\r\\n다행이야! 이거라면 분명…"

msgid "adv_106102_0005_msg"
msgstr ""

msgid "adv_106102_0006_msg"
msgstr "레이레이?"

msgid "adv_106102_0007_msg"
msgstr "순조롭다고 하면 순조롭지만…"

msgid "adv_106102_0008_msg"
msgstr "저기, 뭔가 신경 쓰이는 거라도 있어?"

msgid "adv_106102_0009_msg"
msgstr "…마키나, 이걸 봐줘"

msgid "adv_106102_0010_msg"
msgstr "분석 결과? 어디 보자…"

msgid "adv_106102_0011_msg"
msgstr ""

msgid "adv_106102_0012_msg"
msgstr "빨리 카나카나 일행한테 보고해야 해!"

msgid "adv_106102_0013_msg"
msgstr "응"

msgid "adv_206301_0003_msg"
msgstr "…방금 그 기억은 대체"

msgid "adv_206301_0004_msg"
msgstr ""

msgid "adv_206301_0006_msg"
msgstr "미쿠모, 괜찮아? 어디 다친 건…"

msgid "adv_206301_0007_msg"
msgstr "아니, 문제없어"

msgid "adv_206301_0008_msg"
msgstr "그럼 다행이네. 전투 중에 갑자기 멈춰 서길래\\r\\n무슨 일인가 했어"

msgid "adv_206301_0009_msg"
msgstr "카나메"

msgid "adv_206301_0010_msg"
msgstr "뭐야?"

msgid "adv_206301_0011_msg"
msgstr "아무래도 우리는 싸우고 있는 상대에 대해\\r\\n좀 더 알아야 할 것 같아"

msgid "adv_206301_0012_msg"
msgstr "…무슨 뜻이야? 아, 잠깐 미쿠모!"

msgid "adv_206301_0015_msg"
