msgid "adv_200801_0021_msg"
msgstr "응!\\n아까 라이브에서 부를 곡을 흥얼거렸더니,\\n머릿속으로 기억이 흘러들어와서…"

msgid "adv_200801_0022_msg"
msgstr "마크로스 함내에서 길을 잃었을 때의 기억이야?"

msgid "adv_200801_0023_msg"
msgstr "맞긴 한데,\\n내가 기억하는 것과는 조금 다른 기억이었어.\\n그래도 그 기억 속의 나를 보고 이미지가 잡혔어"

msgid "adv_200801_0024_msg"
msgstr "헤에… 어떤 이미지인데?"

msgid "adv_200801_0025_msg"
msgstr "후훗, 조금 장난기 있는,\\n귀여운 여자아이 같은 이미지로 불러볼까 해"

msgid "adv_200801_0026_msg"
msgstr "음, 예를 들면…"

msgid "adv_200801_0027_msg"
msgstr "있잖아, 히카루. 사실 나, 계속 네가 좋았어"

msgid "adv_200801_0028_msg"
msgstr "뭐!?"

msgid "adv_200801_0029_msg"
msgstr "농담이야. 이런 건 연기로도 할 수 있잖아, 비즈니스야"

msgid "adv_200801_0030_msg"
msgstr "뭐어!?"

msgid "adv_200801_0031_msg"
msgstr "…뭐, 이런 식으로 딱 잘라 생각할 수 있는 애랄까"

msgid "adv_200801_0032_msg"
msgstr "왠지 심장에 안 좋네…"

msgid "adv_200801_0033_msg"
msgstr "후훗! 어떤 라이브가 될지 기대해줘!"

msgid "adv_200801_0034_msg"
msgstr "응"

msgid "adv_200802_0008_msg"
msgstr "…민메이는 정말 대단하구나"

msgid "adv_200802_0009_msg"
msgstr "왜 그래? 갑자기…"

msgid "adv_200802_0010_msg"
msgstr "아니, 무대 위의 민메이를 보고 그렇게 생각했다고 해야 하나"

msgid "adv_200802_0011_msg"
msgstr "후훗, 잘 모르겠지만 고마워"

msgid "adv_200802_0012_msg"
msgstr "그보다 히카루, 라이브 전에는 놀라게 해서 미안해.\\n그럴 생각은 아니었는데"

msgid "adv_200802_0013_msg"
msgstr "아, 그 연기하면서 고백했던 거?\\n신경 안 써"

msgid "adv_200802_0014_msg"
msgstr "오히려 그 얘기를 했더니\\n카키자키 일행이 부럽다고 하더라"

msgid "adv_200802_0015_msg"
msgstr "정말?"

msgid "adv_200802_0016_msg"
msgstr "응, 그보다 민메이…"

msgid "adv_200802_0018_msg"
msgstr "이치죠 중위!"

msgid "adv_200802_0019_msg"
msgstr ""

msgid "adv_200802_0020_msg"
msgstr "미사 씨!\\n미사 씨도 라이브 보러 와주셨군요"

msgid "adv_200802_0021_msg"
msgstr "안녕하세요, 민메이 씨!\\n네, 오늘도 정말 멋진 라이브였어요"

msgid "adv_200802_0022_msg"
msgstr "감사합니다!"

msgid "adv_200802_0023_msg"
msgstr "그런데 대체 무슨 일이에요? 그렇게 급하게…\\n저, 뭐 잘못했나요?"

msgid "adv_200802_0024_msg"
msgstr "뭘 잘못했냐니… 정말.\\n그 보고서는 대체 뭐야?"

msgid "adv_200802_0025_msg"
msgstr "보고서?\\n…아, 라이브 전에 민메이 찾으러 갔을 때 그거"

msgid "adv_200802_0026_msg"
msgstr "내용이 전혀 이해가 안 됐어.\\n매번 말하지만 보고는 알기 쉽게…"

msgid "adv_200802_0027_msg"
msgstr "네네, 알고 있어요. 정말 세세하다니까"

msgid "adv_200802_0028_msg"
msgstr "정말… 아무튼 다시 써줘"

msgid "adv_200802_0029_msg"
msgstr "알았다니까요"

msgid "adv_200802_0030_msg"
msgstr "그럼 민메이, 나중에 또 냥냥에 갈게!"

msgid "adv_200802_0031_msg"
msgstr "응, 기다리고 있을게!"

msgid "adv_200802_0033_msg"
msgstr "시끄럽게 해서 미안해요, 민메이 씨.\\n정말 이치죠 중위도 참…"

msgid "adv_200802_0034_msg"
msgstr "후훗, 미사 씨도 고생이 많으시네요"

msgid "adv_200802_0035_msg"
msgstr "그건 민메이 씨도 마찬가지라고 생각해요.\\n그래, 가끔은 여자들끼리 기분 전환하러 가요"

msgid "adv_200802_0036_msg"
msgstr "좋네요, 기대할게요!"

msgid "adv_000102_0003_msg"
msgstr "프레이아, 하야테 군.\\n출격 준비는 됐어?"

msgid "adv_000102_0004_msg"
msgstr "호이나!\\n오늘도 고리고리하게 힘낼게!"

msgid "adv_000102_0005_msg"
msgstr "그런데, 이번 적은 뭐지?\\n공중기사단과는 많이 달랐었는데"

msgid "adv_000102_0006_msg"
msgstr "역시 닮은 듯 안 닮았지?"

msgid "adv_000102_0007_msg"
msgstr "...저게, 초고대 시스템 「새인간」.\\n우리가 싸울 상대야"

msgid "adv_000102_0008_msg"
msgstr "두 사람 모두 조금 전에 설명한 건 기억하고 있어?"

msgid "adv_000102_0009_msg"
msgstr "아, 그 새인간이라는 녀석 때문에\\n여러 사람의 기억을 잃어 버렸다고 했었지"

msgid "adv_000102_0010_msg"
msgstr "그리고... 그 새인간과 맞설 수\\n있는게, 생체 폴드파를 가진\\n우리들 왈큐레란 거죠"

msgid "adv_000102_0011_msg"
msgstr "그래, 맞아. 하지만 이렇게 싸우는 건 처음이니까\\n어쨌든 조심하자"

msgid "adv_000102_0012_msg"
msgstr "호이나!\\n그래도 우리가 하는 일은 안 바뀌잖아요!"

msgid "adv_000102_0013_msg"
msgstr "뭐, 그런 거지"

msgid "adv_000102_0014_msg"
msgstr "두 사람 모두 든든하네.\\n그럼 준비하자"

msgid "adv_000102_0018_msg"
msgstr "프레이아, 하야테 군, 괜찮아?"

msgid "adv_000102_0019_msg"
msgstr "아, 문제 없어.\\n이제 곧 다 쓰러뜨릴 수 있을 것 같아"

msgid "adv_000102_0020_msg"
msgstr "하지만 하야테, 평소보다 더 고전하는 것 같네…"

msgid "adv_000102_0021_msg"
msgstr "우리의 노래와 하야테 군과의 호흡이 잘 맞으면\\n잘 될 텐데…"

msgid "adv_000102_0022_msg"
msgstr "역시 우리들의 노래의 힘을\\n좀 더 키워야 할 것 같네"

msgid "adv_000102_0023_msg"
msgstr "무슨 말이야?"

msgid "adv_000102_0024_msg"
msgstr "즉, 생체 폴드파를 증폭시켜서\\n하야테 군에게 더 많이 노래를 전할 수 있다는 뜻이야"

msgid "adv_000102_0025_msg"
msgstr "그런데 어떻게 해야 증폭시킬 수 있으려나.\\n아까도 제대로 평소처럼 노래를 불렀잖아?"

msgid "adv_000102_0026_msg"
msgstr "한 가지 생각이 있어.\\n에피소드 플레이트를 사용해 보자"

msgid "adv_000102_0027_msg"
msgstr "에피소드 플레이트... 처음 들어보는 말이네?"

msgid "adv_000102_0028_msg"
msgstr "괜찮아, 지금부터 자세히 설명할게.\\n프레이아, 따라와"

msgid "adv_000102_0032_msg"
msgstr "기다렸지, 이걸로 출격 전 준비는 끝났어"

msgid "adv_000102_0033_msg"
msgstr "그럼, 프레이아.\\n좋은 느낌으로 부탁할게"

msgid "adv_000102_0034_msg"
msgstr "맡겨줘, 하야테!"

msgid "adv_000102_0035_msg"
msgstr "어떤 적이 나와도 내가\\n노래로 고리고리하게 응원해줄게!"

msgid "adv_000102_0036_msg"
msgstr "그래, 한 번에 정리할게!"

msgid "adv_000102_0037_msg"
msgstr "둘 다, 그럼 가자!"

msgid "adv_000102_0041_msg"
msgstr "프레이아, 고마워.\\n네 노래, 잘 들렸어"

msgid "adv_000102_0042_msg"
msgstr "정말!? 에피소드 플레이트 덕분이네!"

msgid "adv_000102_0043_msg"
msgstr "아… 그러고 보니 카나메 씨.\\n아까 노래하고 있을 때 머릿속으로 영상이\\n흘러들어오는 느낌이 들었어요."

msgid "adv_000102_0044_msg"
msgstr "처음 노래할 때는\\n그런 느낌 없었는데"

msgid "adv_000102_0045_msg"
msgstr "혹시 그게 잃어버린 기억이었던 걸까...?\\n아무튼, 작전이 성공해서 다행이네"

msgid "adv_000102_0046_msg"
msgstr "델타 소대원들과 왈큐레가 힘을 합치면\\n분명 세상도 금방 원래대로 돌아갈 수 있을 것 같네요!"

msgid "adv_000102_0047_msg"
msgstr "그렇겠네. 하지만 더 굉장한 협력자도 있는데?"

msgid "adv_000102_0048_msg"
msgstr "협력자라니, 우리 말고도?"

msgid "adv_000102_0049_msg"
msgstr "응, 레이나가 개발한 초시공 SNS에 말야"

msgid "adv_000102_0050_msg"
msgstr "초시공… SNS?"

msgid "adv_000102_0051_msg"
msgstr "맞아.\\n단말기를 지급할 테니 설명을 잘 들어둬"

msgid "adv_000102_0054_msg"
msgstr "오오!\\n초시공 SNS 정말 대단하네!"

msgid "adv_000102_0055_msg"
msgstr "이걸 사용하여 모두가 힘을 합치면\\n기억을 지켜낼 수 있을 거야"

msgid "adv_000102_0056_msg"
msgstr "이것은 은하와 우리의 기억을 지키는 싸움이야.\\n프레이아, 하야테 군, 같이 힘내보자!"

msgid "adv_000102_0057_msg"
msgstr "아, 물론이지!"

msgid "adv_000102_0058_msg"
msgstr "넵! 맡겨주세요!"

msgid "adv_000102_0059_msg"
msgstr "그러고 보니 오늘 케이오스 라그나 지부에\\n우리와 함께 일할 새로운 동료가 합류한다고 하네"

msgid "adv_000102_0060_msg"
msgstr "그러고 보니 미라쥬가 그런 얘길 했었지"

msgid "adv_000102_0061_msg"
msgstr "새로운 동료... 어떤 사람일까?"

msgid "adv_000102_0065_msg"
msgstr "기다리고 있었습니다.\\n당신이 저희에게 협력해주신다고 한 분이시죠?"

msgid "adv_000102_0066_msg"
msgstr "처음 뵙겠습니다.\\n저는 케이오스 라그나 지부 델타 소대 소속\\n미라쥬 파리나 지너스입니다"

msgid "adv_000102_0067_msg"
msgstr "당신을 지원하라는 지시를 받고 왔습니다.\\n잘 부탁드립니다"

msgid "adv_000102_0068_msg"
msgstr "우선 입대 절차를 진행할 테니,\\n이 서류에 서명해 주십시오"

msgid "adv_000102_0069_msg"
msgstr "그럼 다음으로 함께 싸우게 될 가희 여러분을 소개하겠습니다"

msgid "adv_000102_0073_msg"
msgstr "이걸로 준비는 완료됐습니다"

msgid "adv_000102_0074_msg"
msgstr "앞으로의 전투에서는 하야테 소위가\\n당신을 지원해 줄 겁니다"

msgid "adv_000102_0075_msg"
msgstr "이제부터 새의 인간과의 싸움이 시작되겠지만,\\n당신과 가희 여러분의 힘이 있다면,\\n분명 잘 해낼 수 있을 겁니다"

msgid "adv_000102_0076_msg"
msgstr "그럼 저는 이만 실례하겠습니다"

msgid "adv_000102_0077_msg"
msgstr "머지않아 전장에서\\n다시 만나게 될 것 같습니다만…"

msgid "adv_000102_0078_msg"
msgstr "그날까지 부디 무사하시길"

msgid "adv_300701_0008_msg"
msgstr ""

msgid "adv_300701_0009_msg"
msgstr "…하아"

msgid "adv_300701_0011_msg"
msgstr "…알토, 평소랑 뭔가 다르네.\\n한숨도 자주 쉬고, 계속 기운이 없어 보인달까"

msgid "adv_300701_0012_msg"
msgstr "뭔가 고민이라도 있는 걸까요?\\n조금 걱정되네요"

msgid "adv_300701_0013_msg"
msgstr "…이렇게 된 이상 직접 본인한테 물어볼래"

msgid "adv_300701_0014_msg"
msgstr "네, 셰릴 씨!?"

msgid "adv_300701_0015_msg"
msgstr "그게 더 빠르잖아?\\n게다가 우리가 모처럼 만나러 왔는데.\\n좀 더 기쁜 표정을 지어줬으면 좋잖아"

msgid "adv_300701_0016_msg"
msgstr "그건 그렇지만…"

msgid "adv_300701_0017_msg"
msgstr "혼자 고민해도 해결되지 않는 일이 많으니까\\n빨리 다른 사람한테 털어놓는 게 편해질 때도 있어"

msgid "adv_300701_0019_msg"
msgstr "그게 좀처럼 얘기를 안 해준단 말이지, 알토 공주님.\\n정말 고집도 세다니까"

msgid "adv_300701_0020_msg"
msgstr "미셸 군!"

msgid "adv_300701_0021_msg"
msgstr "안녕, 란카. 그리고 셰릴도"

msgid "adv_300701_0022_msg"
msgstr "알토 군, 미셸 군한테도 상담 안 했구나…"

msgid "adv_300701_0023_msg"
msgstr "뭔가 짐작 가는 거 없어? 알토가 고민하는 이유"

msgid "adv_300701_0024_msg"
msgstr "음… 상태가 이상해진 건 전투가 끝난 뒤부터인데,\\n딱히 실수한 것도 아니거든"

msgid "adv_300701_0025_msg"
msgstr "나도 짐작이 안 가"

msgid "adv_300701_0026_msg"
msgstr "…그렇구나"

msgid "adv_300701_0027_msg"
msgstr "어쨌든 알토 군을 기운 나게 해주고 싶은데…\\n우리가 뭘 할 수 있을까?"

msgid "adv_300701_0028_msg"
msgstr "그러게. 데이트 신청을 해본다든가, 여러 가지 있겠지만…"

msgid "adv_300701_0029_msg"
msgstr "…역시 우리가 할 수 있는 건 노래하는 걸까"

msgid "adv_300701_0030_msg"
msgstr "…! 그러네요!"

msgid "adv_300701_0031_msg"
msgstr "분위기에 딱 맞는 의상과 안무로,\\n끝내주게 밝은 노래를 선물해주자"

msgid "adv_300701_0032_msg"
msgstr "그런 거니까 내일 라이브 때 알토를 회장까지 데려와줘"

msgid "adv_300701_0033_msg"
msgstr "어, 내가?"

msgid "adv_300701_0034_msg"
msgstr "당연하지, 우리는 이제부터 연습해야 하잖아"

msgid "adv_300701_0035_msg"
msgstr "네네, 알겠어"

msgid "adv_300701_0036_msg"
msgstr "고마워, 미셸 군!"

msgid "adv_300701_0037_msg"
msgstr "그럼 부탁할게"

msgid "adv_300701_0039_msg"
msgstr "…정말, 알토는 행복한 녀석이네"

msgid "adv_300702_0008_msg"
msgstr "어이, 셰릴"

msgid "adv_300702_0009_msg"
msgstr "어머, 알토.\\n…후훗, 조금은 기분이 풀린 것 같네"

msgid "adv_300702_0010_msg"
msgstr "…뭐, 그렇지"

msgid "adv_300702_0011_msg"
msgstr "나는 그럴 생각이 없었는데,\\n그렇게까지 고민하는 것처럼 보였어?"

msgid "adv_300702_0012_msg"
msgstr "응. 나뿐만 아니라,\\n란카도 다른 사람들도 다 걱정했어"

msgid "adv_300702_0013_msg"
msgstr "…걱정 끼쳤네"

msgid "adv_300702_0014_msg"
msgstr "정말이지. 알토 주제에 건방지다니까"

msgid "adv_300702_0015_msg"
msgstr "…그래도 이번에는 나도 알토한테\\n고맙다고 해야 할지도 모르겠네"

msgid "adv_300702_0016_msg"
msgstr "고맙다고?"

msgid "adv_300702_0017_msg"
msgstr "이번 곡은 란카와 듀엣이라서\\n같이 연습했는데… 조금 즐거웠거든"

msgid "adv_300702_0018_msg"
msgstr "같이 어떤 무대로 만들지 고민하고,\\n늦게까지 연습하고…\\n평소 혼자서는 못 하는 걸 많이 경험했어"

msgid "adv_300702_0019_msg"
msgstr "조금 신기한 기분이었지만, 나쁘진 않았어"

msgid "adv_300702_0020_msg"
msgstr "셰릴…"

msgid "adv_300702_0022_msg"
msgstr "아! 알토 군, 셰릴 씨!"

msgid "adv_300702_0023_msg"
msgstr "란카! 오늘 수고했어.\\n좋은 무대가 돼서 다행이네"

msgid "adv_300702_0024_msg"
msgstr "호흡도 완벽하게 맞았고, 밀레느 일행이랑\\n왈큐레 여러분의 조언 덕분이네요"

msgid "adv_300702_0025_msg"
msgstr "란카, 수고했어. 너한테도 걱정 끼쳤네"

msgid "adv_300702_0026_msg"
msgstr "신경 쓰지 마, 알토 군.\\n나도 정말 즐거웠으니까!"

msgid "adv_300702_0027_msg"
msgstr ""

msgid "adv_300702_0028_msg"
msgstr "…있잖아, 란카"

msgid "adv_300702_0029_msg"
msgstr "네!"

msgid "adv_300702_0030_msg"
msgstr "알토가 말이야, 뭐 달콤한 거라도 먹으러 가지 않겠냐던데"

msgid "adv_300702_0031_msg"
msgstr "뭐!?"

msgid "adv_300702_0032_msg"
msgstr "알토 군, 정말!?"

msgid "adv_300702_0033_msg"
msgstr "응. 걱정 끼친 사과라네"

msgid "adv_300702_0034_msg"
msgstr "어이, 셰릴!"

msgid "adv_300702_0035_msg"
msgstr "이 정도는 별일 아니잖아? 잠깐 어울려줘"

msgid "adv_300702_0036_msg"
msgstr "알토 군이랑 셰릴 씨랑 셋이서 외출이라…\\n에헤헤, 기대된다"

msgid "adv_300702_0037_msg"
msgstr ""

msgid "adv_300702_0038_msg"
msgstr "그래서, 어떻게 할래?"

msgid "adv_300702_0039_msg"
msgstr "…하아, 마음대로 해"

msgid "adv_300702_0040_msg"
msgstr "와! 고마워, 알토 군!"

msgid "adv_300702_0041_msg"
msgstr "후훗! 자, 빨리 가자?"

msgid "adv_300702_0042_msg"
msgstr "…정말"

msgid "adv_101001_0008_msg"
msgstr "…그 기억은"

msgid "adv_101001_0010_msg"
msgstr "미쿠모 씨!"

msgid "adv_101001_0011_msg"
msgstr "어머, 미라쥬. 무슨 일이야?"

msgid "adv_101001_0012_msg"
msgstr "무슨 일이냐니요…\\n미쿠모 씨가 안 보여서 걱정돼서 찾으러 왔잖아요!"

msgid "adv_101001_0013_msg"
msgstr "어머, 그래"

msgid "adv_101001_0014_msg"
msgstr "공중기사단이 공격해 와서 라이브가 중단됐다고요!\\n지금은 함부로 돌아다니지 말고 가만히…"

msgid "adv_101001_0015_msg"
msgstr "하지만 그들… 이번에는 꽤 순순히 철수했잖아"

msgid "adv_101001_0016_msg"
msgstr "네… 하지만 전략적 철수라고 하기에는 부자연스러웠고,\\n그들이 철수한 이유는 저희도 아직 잘 모르겠어요"

msgid "adv_101001_0017_msg"
msgstr ""

msgid "adv_101001_0018_msg"
msgstr "저기, 미쿠모 씨?"

msgid "adv_101001_0019_msg"
msgstr "…아까 라이브에서 전혀 기억에 없는 기억을 봤어"

msgid "adv_101001_0020_msg"
msgstr "그거 시공의 왜곡이 심해지면서 보이게 되는,\\n다른 시공의 기억을 말씀하시는 건가요?"

msgid "adv_101001_0021_msg"
msgstr "그럴지도 몰라. 선명하게 기억나진 않지만,\\n그 기억 속에서 나는 무언가에 붙잡혀 있었어"

msgid "adv_101001_0022_msg"
msgstr "…그다지 기분 좋은 기억은 아니었지만, 그래도\\n아주 소중한 마음을 얻게 된 것 같은 기분이 들어"

msgid "adv_101001_0023_msg"
msgstr "공중기사단 사람들도 나처럼\\n그 기억을 봤다면, 철수한 이유를 알 것 같아"

msgid "adv_101001_0024_msg"
msgstr "무슨 뜻인가요? 왜 그들이 철수를…"

msgid "adv_101001_0025_msg"
msgstr "…별의 가희"

msgid "adv_101001_0026_msg"
msgstr ""

msgid "adv_101001_0027_msg"
msgstr "하지만 내가 누구인지는 상관없어.\\n내게는 노래하고 싶다는 마음이 전부야.\\n그 이상도, 그 이하도 아니야"

msgid "adv_101001_0028_msg"
msgstr "자, 라이브를 재개할 거야.\\n미라쥬, 너도 재개할 준비를 해"

msgid "adv_101001_0029_msg"
msgstr "자, 잠깐만요, 미쿠모 씨! 질문에 대답해 주세요!"

msgid "adv_101001_0031_msg"
msgstr "…정말, 자유로운 사람이라니까"

msgid "adv_101001_0032_msg"
msgstr "…별의 가희. 대체 무슨 뜻일까요…"

msgid "adv_101002_0008_msg"
msgstr "왜 철수했지, 키스?\\n그런 지시를 내린 기억은 없는데"

msgid "adv_101002_0009_msg"
msgstr "…기억에 혼란이 생겼다.\\n그 상태로는 전투를 계속할 수 없었어"

msgid "adv_101002_0010_msg"
msgstr "기억?"

msgid "adv_101002_0011_msg"
msgstr "이상한 기억을 봤다.\\n내 기억이지만, 내가 경험하지 않은 기억을"

msgid "adv_101002_0012_msg"
msgstr "그렇군. 시공 왜곡의 영향인가…"

msgid "adv_101002_0013_msg"
msgstr "평행세계의 경계가 흔들리고 있는지도 몰라.\\n다른 세계의 기억이 흘러들어온 건가"

msgid "adv_101002_0014_msg"
msgstr "하지만 지금은 정상이다. 당장이라도 전선에 복귀할 수 있어"

msgid "adv_101002_0015_msg"
msgstr "그래야 곤란하지 않지…라고 말하고 싶지만\\n절대로 무리하지는 마"

msgid "adv_101002_0016_msg"
msgstr "키스, 어떤 기억을 봤지?\\n앞으로의 전략을 세우는 데 참고가 될지도 몰라.\\n다른 세계의 상황에는 관심이 있어"

msgid "adv_101002_0017_msg"
msgstr ""

msgid "adv_101002_0018_msg"
msgstr "왜 그러지?"

msgid "adv_101002_0019_msg"
msgstr "아니, 참고가 될 만한 건 아니다.\\n그런 과거나 미래가 있을 리 없으니까"

msgid "adv_101002_0020_msg"
msgstr "…그렇군"

msgid "adv_101002_0021_msg"
msgstr "로이드… 내게는 지금 이 순간이 전부다"

msgid "adv_101002_0022_msg"
msgstr "…무슨 뜻이지?"

msgid "adv_101002_0023_msg"
msgstr "아니… 신경 쓰지 마"

msgid "adv_101002_0025_msg"
msgstr "로이드 님, 하인츠 전하께서 부르십니다!"

msgid "adv_101002_0026_msg"
msgstr "알겠다. 그럼 키스, 다음은 부탁하지"

msgid "adv_101002_0027_msg"
msgstr "그래"

msgid "adv_101002_0029_msg"
msgstr "…로이드"

msgid "adv_101002_0030_msg"
msgstr "만약 그 기억과 같은 일이 벌어진다면…\\n그때는 바람을 내가 멈추겠다"

msgid "adv_101002_0031_msg"
msgstr "키스 님?"

msgid "adv_101002_0032_msg"
msgstr "…가자, 보그"

msgid "adv_101002_0033_msg"
msgstr "네, 넵!"

msgid "adv_200901_0008_msg"
msgstr "우와, 대단하네.\\n공원 전체가 벚꽃으로 가득하잖아"

msgid "adv_200901_0009_msg"
msgstr "이거 일부러 다 준비한 거잖아…\\n마을 회장님이나 주민들의 활력에는\\n계속 놀라게 된다니까"

msgid "adv_200901_0011_msg"
msgstr ""

msgid "adv_200901_0012_msg"
msgstr "…그런데 왜 제 휴가에\\n하야세 대위님까지 따라오는 겁니까?"

msgid "adv_200901_0013_msg"
msgstr "이것도 업무의 일환이야.\\n이치죠 중위, 요즘 당신은 제멋대로 행동하는 일이 너무 많아"

msgid "adv_200901_0014_msg"
msgstr "어제 전투만 해도\\n당신이 내 명령을 무시하고 적을 너무 깊이 쫓는 바람에\\n포커 소령님과 다른 대원들에게까지 폐를…"

msgid "adv_200901_0015_msg"
msgstr "네네, 알고 있다니까요.\\n이렇게 반성하고 있습니다!"

msgid "adv_200901_0016_msg"
msgstr "정말…"

msgid "adv_200901_0018_msg"
msgstr "아, 히카루! 그리고 미사 씨도!"

msgid "adv_200901_0019_msg"
msgstr "민메이!"

msgid "adv_200901_0020_msg"
msgstr "민메이 씨… 안녕하세요"

msgid "adv_200901_0021_msg"
msgstr "…이치죠 중위. 설마 당신\\n오늘 민메이 씨랑 만나기로 한 거야?"

msgid "adv_200901_0022_msg"
msgstr "어, 그게… 그러니까"

msgid "adv_200901_0023_msg"
msgstr "후훗, 아니에요!"

msgid "adv_200901_0024_msg"
msgstr "히카루한테는 『신곡 영상 촬영을 하니까\\n시간 나면 보러 와』라고 말해뒀어요"

msgid "adv_200901_0025_msg"
msgstr "그런 거였구나"

msgid "adv_200901_0026_msg"
msgstr "그러고 보니 미사 씨도 괜찮으시면 촬영을\\n보고 가세요"

msgid "adv_200901_0027_msg"
msgstr "오늘 촬영하는 곡… 저, 정말 좋아하거든요"

msgid "adv_200901_0028_msg"
msgstr "조금 슬픈 곡이긴 하지만…\\n벚꽃이 흩날리는 가운데 영상을 찍으면\\n정말 예쁘게 나올 것 같아요"

msgid "adv_200901_0029_msg"
msgstr "그래요?\\n그럼 모처럼이니 구경하고 갈까"

msgid "adv_200901_0030_msg"
msgstr "요즘 적의 습격이 계속돼서\\n계속 브리지에만 있었거든"

msgid "adv_200901_0031_msg"
msgstr "클로디아한테도\\n『마을에 나가서 꽃구경이라도 하고 오지 그래?』\\n라는 말을 듣던 참이었고…"

msgid "adv_200901_0032_msg"
msgstr "…! 꽃구경, 좋네요!"

msgid "adv_200901_0033_msg"
msgstr "네?"

msgid "adv_200901_0034_msg"
msgstr "히카루, 미사 씨.\\n촬영 끝나면 같이 꽃구경해요!"

msgid "adv_200901_0035_msg"
msgstr "항상 열심히 해주는 두 분을 위해서,\\n제가 한 곡 부를게요"

msgid "adv_200901_0036_msg"
msgstr "계속 감사 인사를 하고 싶었어요.\\n제가 마음껏 노래할 수 있는 건,\\n히카루 일행이 열심히 해주는 덕분이니까요"

msgid "adv_200901_0037_msg"
msgstr "민메이 씨…"

msgid "adv_200901_0038_msg"
msgstr "고마워, 민메이.\\n민메이 노래, 기대할게"

msgid "adv_200901_0039_msg"
msgstr "응. 기대해줘! 미사 씨도요!"

msgid "adv_200901_0040_msg"
msgstr "…왠지 갑자기 끼어들게 돼서\\n미안하네"

msgid "adv_200901_0041_msg"
msgstr "그래도… 그러네.\\n가끔은 이런 것도 나쁘지 않을지도"

msgid "adv_200901_0042_msg"
msgstr "고마워요, 민메이 씨"

msgid "adv_200902_0008_msg"
msgstr ""

msgid "adv_200902_0009_msg"
msgstr "민메이 씨. 여기 있었군요"

msgid "adv_200902_0010_msg"
msgstr "아… 미사 씨"

msgid "adv_200902_0011_msg"
msgstr "군의 꽃놀이에 갑자기 초대해버려서\\n미안해요"

msgid "adv_200902_0012_msg"
msgstr "그런데 왜 그래요?\\n오늘의 스페셜 게스트가 연회 자리를 떠나서…"

msgid "adv_200902_0013_msg"
msgstr "벚꽃을 보고 있었어요.\\n촬영 중간에는 천천히 볼 시간도 없었거든요"

msgid "adv_200902_0014_msg"
msgstr "미사 씨는 왜 오셨어요?"

msgid "adv_200902_0015_msg"
msgstr "이치죠 군… 아니, 이치죠 중위가\\n갑자기 본부로 돌아가게 됐다고 해서, 그걸 전하러 왔어요"

msgid "adv_200902_0016_msg"
msgstr "저도 이제 돌아가야 해요.\\n그 사람은 자꾸 사고를 치니까 제대로 지켜보고 있어야 해서"

msgid "adv_200902_0017_msg"
msgstr ""

msgid "adv_200902_0018_msg"
msgstr "포커 소령님과 클로디아 일행은\\n아직 한동안 여기서 꽃을 본대요"

msgid "adv_200902_0019_msg"
msgstr "그럼 또 봐요"

msgid "adv_200902_0020_msg"
msgstr "저기, 미사 씨!"

msgid "adv_200902_0021_msg"
msgstr "저…"

msgid "adv_200902_0022_msg"
msgstr ""

msgid "adv_200902_0023_msg"
msgstr "민메이 씨?"

msgid "adv_200902_0024_msg"
msgstr "히카루를… 잘 부탁드려요"

msgid "adv_200902_0025_msg"
msgstr "왜 그래요, 갑자기.\\n이치죠 중위와는 당신 쪽이 훨씬 더 친한 사이잖아요"

msgid "adv_200902_0026_msg"
msgstr "그건… 잘 모르겠지만…\\n갑자기 이상한 말을 해서 죄송해요"

msgid "adv_200902_0027_msg"
msgstr ""

msgid "adv_200902_0028_msg"
msgstr "…알겠어요"

msgid "adv_200902_0029_msg"
msgstr "상관으로서 앞으로도 확실히\\n그 사람의 행동을 주의 깊게 지켜볼게요"

msgid "adv_200902_0030_msg"
msgstr "그 사람이 전투에서 무리하지 않도록.\\n무사히 돌아올 수 있도록"

msgid "adv_200902_0031_msg"
msgstr "민메이 씨. …저, 당신 노래 좋아해요"

msgid "adv_200902_0032_msg"
msgstr "미사 씨…"

msgid "adv_200902_0033_msg"
msgstr "앞으로도 우리는\\n당신의 노래를 싣고 계속 날아갈 거예요"

msgid "adv_200902_0034_msg"
msgstr "언젠가 전설이 될지도 모르는\\n당신의 노래를"

msgid "adv_200902_0035_msg"
msgstr "그러니까… 당신도 자신의 노래를 소중히 해요"

msgid "adv_200902_0036_msg"
msgstr "네!"

msgid "adv_300801_0008_msg"
msgstr "란카! 다친 데는 없어?"

msgid "adv_300801_0009_msg"
msgstr "응, 괜찮아, 오빠!\\n그보다 봐… 눈이야!"

msgid "adv_300801_0010_msg"
msgstr "…추모의 눈인가"

msgid "adv_300801_0011_msg"
msgstr "응?"

msgid "adv_300801_0012_msg"
msgstr "아까 전투에서 적이 아일랜드1의 돔에 구멍을 냈거든.\\n아마 감압 현상 때문에 눈이 내리기 시작한 거겠지"

msgid "adv_300801_0013_msg"
msgstr "…평소에는 인공적으로 제어되고 있으니까,\\n왠지 신기한 느낌이네"

msgid "adv_300801_0014_msg"
msgstr "응… 그래도 정말 예뻐"

msgid "adv_300801_0015_msg"
msgstr ""

msgid "adv_300801_0016_msg"
msgstr "란카?"

msgid "adv_300801_0017_msg"
msgstr "아까 전투 중에 노래했을 때 기억에 없는 장면을 봤어.\\n아마 이 시공과는 다른 시공의 기억일 거야"

msgid "adv_300801_0018_msg"
msgstr "어떤 기억이었어?"

msgid "adv_300801_0019_msg"
msgstr "지금처럼 눈이 내리고 있었어.\\n그걸 셰릴 씨랑 알토 군이랑 같이 보고 있었고.\\n따뜻하면서도 조금 쓸쓸한 느낌의 기억이었어"

msgid "adv_300801_0020_msg"
msgstr "…그렇구나"

msgid "adv_300801_0021_msg"
msgstr "기억 속에서도 똑같이 싸우고 있었는데\\n셰릴 씨와 알토 군이 나를 도와줬어…"

msgid "adv_300801_0022_msg"
msgstr "그러고 보니 두 사람은 어디 갔지?\\n서로 떨어진 건가?"

msgid "adv_300801_0023_msg"
msgstr "격렬한 전투였으니까.\\n하지만 전투가 막 끝나서 잔해도 많아.\\n넌 여기서 얌전히…"

msgid "adv_300801_0024_msg"
msgstr "내가 찾아보고 올게!"

msgid "adv_300801_0026_msg"
msgstr "어이, 란카! …정말"

msgid "adv_300801_0028_msg"
msgstr "아, 셰릴 씨! 알토 군!"

msgid "adv_300801_0030_msg"
msgstr "란카! 그쪽은 괜찮아?\\n뭐, 대장이 있으면 괜찮을 것 같긴 하지만"

msgid "adv_300801_0031_msg"
msgstr "응!"

msgid "adv_300801_0032_msg"
msgstr "아까 전투에서 란카도 기억을 본 거구나?\\n다른 시공에 있는 우리들의 기억"

msgid "adv_300801_0033_msg"
msgstr "그래서 걱정돼서 와준 거겠지?"

msgid "adv_300801_0034_msg"
msgstr "후훗! 알토랑 똑같네"

msgid "adv_300801_0035_msg"
msgstr "어, 알토 군도!?"

msgid "adv_300801_0036_msg"
msgstr "어이, 셰릴!"

msgid "adv_300801_0037_msg"
msgstr "…그래도 고마워. 알토, 란카"

msgid "adv_300801_0038_msg"
msgstr "내가 혼자가 아니라는 걸 알게 됐으니까.\\n지금의 나도 그런 마음이야"

msgid "adv_300801_0039_msg"
msgstr "혼자가 아니다…인가"

msgid "adv_300801_0040_msg"
msgstr "저기! 셰릴 씨, 알토 군!\\n제 노래를 들어주시겠어요?"

msgid "adv_300801_0041_msg"
msgstr "응?"

msgid "adv_300801_0042_msg"
msgstr "아까 그 기억을 보고 생각했어요.\\n다른 시공의 오빠나 미셸 군, 브레라 씨…"

msgid "adv_300801_0043_msg"
msgstr "모~두에게 이쪽 시공의 우리들에 대해서도\\n알아줬으면 좋겠다고요!"

msgid "adv_300801_0044_msg"
msgstr "…다른 시공의 알토 군과 셰릴 씨도,\\n제 소중한 사람들이라는 걸 전하고 싶어요!"

msgid "adv_300801_0045_msg"
msgstr "란카…\\n응, 들려줄래?"

msgid "adv_300801_0046_msg"
msgstr "네!"

msgid "adv_300802_0008_msg"
msgstr "…눈사람, 눈싸움?"

msgid "adv_300802_0009_msg"
msgstr "란카? 무슨 일이야?"

msgid "adv_300802_0010_msg"
msgstr "셰릴 씨!"

msgid "adv_300802_0011_msg"
msgstr "지금 초시공 SNS로 프레이아랑 얘기하고 있었어요!\\n모처럼 눈이 왔으니까 눈으로 놀아보고 싶어서요"

msgid "adv_300802_0012_msg"
msgstr "프레이아가 살았던 윈더미어라는 행성도\\n눈이 내리는 것 같아서 추천할 만한 걸 물어봤어요"

msgid "adv_300802_0013_msg"
msgstr "눈으로 놀기… 좋네!"

msgid "adv_300802_0014_msg"
msgstr "…후훗"

msgid "adv_300802_0015_msg"
msgstr "왜 그러세요?"

msgid "adv_300802_0016_msg"
msgstr "아니, 별건 아닌데,\\n다른 시공의 우리들도 똑같이\\n눈으로 놀자고 하고 있을까… 싶어서"

msgid "adv_300802_0017_msg"
msgstr "정말 그렇다면 멋지겠네요!\\n똑같이 프레이아한테 추천할 만한 걸 물어보고 있을지도 몰라요"

msgid "adv_300802_0018_msg"
msgstr "후훗, 정말 그럴지도 모르겠네"

msgid "adv_300802_0019_msg"
msgstr "…있잖아, 란카. 우리끼리만 말고\\n초시공 SNS로 연락하는 모두에게도 편지를 써보지 않을래?"

msgid "adv_300802_0020_msg"
msgstr "모두에게 편지를요?"

msgid "adv_300802_0021_msg"
msgstr "응. 초시공 SNS로 이어져 있긴 하지만,\\n편지는 써본 적 없잖아…"

msgid "adv_300802_0022_msg"
msgstr "다들 존경하는 사람들이니까.\\n직접 말하고 싶지만 말하기 어려운 것도 있잖아?"

msgid "adv_300802_0023_msg"
msgstr "…사실은 존경하고 있어서,\\n초시공 SNS로 얘기하는 것만으로도 긴장된다든가요?"

msgid "adv_300802_0024_msg"
msgstr "맞아 맞아"

msgid "adv_300802_0025_msg"
msgstr "게다가 정말로 전달된다면\\n다른 시공의 우리에게도 닿을 가능성이 있다고 생각하지 않아?"

msgid "adv_300802_0026_msg"
msgstr "좋네요! 쓰고 싶어요!"

msgid "adv_300802_0027_msg"
msgstr "결정됐네!\\n그럼 다른 사람들에게도 한번 말해보자"

msgid "adv_300802_0028_msg"
msgstr "네!"

msgid "adv_101101_0010_msg"
msgstr "…이 일대는 기억 소실이 심하네"

msgid "adv_101101_0011_msg"
msgstr "응. 최근에는 이 근처와 마찬가지로,\\n심각한 피해를 입은 지역이 여러 곳 확인되고 있어"

msgid "adv_101101_0012_msg"
msgstr "멸망의 노래 영향이 강해지고 있다는 건가…?"

msgid "adv_101101_0013_msg"
msgstr "…응, 아마도"

msgid "adv_101101_0014_msg"
msgstr "우리 노래로 모든 기억을 되찾으려면\\n시간이 좀 걸릴 것 같네…"

msgid "adv_101101_0015_msg"
msgstr "걱정할 필요는 없지 않을까"

msgid "adv_101101_0016_msg"
msgstr "에엣!?"

msgid "adv_101101_0017_msg"
msgstr "뭔가 대책을 생각해둔 거지, 카나메?\\n레이나가 뭔가 준비하고 있던 건 알고 있어"

msgid "adv_101101_0018_msg"
msgstr "…역시 미쿠모네. 맞아.\\n멸망의 노래에 맞서기 위해 레이나에게 작은 부탁을 해뒀어"

msgid "adv_101101_0019_msg"
msgstr "작은 부탁…?"

msgid "adv_101101_0020_msg"
msgstr "응, 그건 바로…"

msgid "adv_101101_0022_msg"
msgstr "드디어 때가 왔어"

msgid "adv_101101_0023_msg"
msgstr "초시공 유닛 라이브"

msgid "adv_101101_0024_msg"
msgstr "초시공 유닛 라이브!?"

msgid "adv_101101_0025_msg"
msgstr "초시공 SNS 네트워크를 튜닝해서\\n홀로그래피 시스템을 탑재했어~!"

msgid "adv_101101_0026_msg"
msgstr "이번 시스템 버전 업으로,\\n초시공 SNS로 연결된 모두의 생체 폴드파를\\n홀로그램으로 만들어 투영할 수 있게 됐어"

msgid "adv_101101_0027_msg"
msgstr "버, 버전 업? 홀로그램?"

msgid "adv_101101_0028_msg"
msgstr "쉽게 말하면 엄청난 시스템"

msgid "adv_101101_0029_msg"
msgstr "오오~!"

msgid "adv_101101_0031_msg"
msgstr "이번에 우리가 가진 생체 폴드파를\\n홀로그램화하는 데 성공했어"

msgid "adv_101101_0032_msg"
msgstr "그 홀로그램을 투영하면… 지금까지는 글로만 주고받을 수 있었지만\\n우리 모습이 입체적으로 투영돼서\\n같이 노래하거나 이야기할 수 있다는 거네"

msgid "adv_101101_0033_msg"
msgstr "그러니까 셰리셰리나 란란, 다른 모~두와\\n더 힘을 합쳐 라이브를 할 수 있는 거야!"

msgid "adv_101101_0034_msg"
msgstr "기운 팍팍!!"

msgid "adv_101101_0036_msg"
msgstr "우선 기동"

msgid "adv_101101_0037_msg"
msgstr "그러자! 해보자~!"

msgid "adv_101101_0039_msg"
msgstr "셰릴 씨, 드디어네요!\\n왠지 긴장되기 시작했어요…"

msgid "adv_101101_0040_msg"
msgstr "그래? 나는 두근두근한데.\\n이제야 왈큐레 애들을 직접 만날 수 있잖아"

msgid "adv_101101_0041_msg"
msgstr "게다가 란카와 함께 서는 무대잖아.\\n정말 기대돼"

msgid "adv_101101_0042_msg"
msgstr "셰릴 씨…"

msgid "adv_101101_0043_msg"
msgstr "그나저나 우리가 홀로그램이 된다니\\n신기하네요… 좀처럼 상상이 안 된다고 해야 하나"

msgid "adv_101101_0044_msg"
msgstr "그래도 이걸로 왈큐레나 Fire Bomber, 민메이…\\n모두와 라이브를 할 수 있는 거지"

msgid "adv_101101_0045_msg"
msgstr "시공을 뛰어넘는 라이브라… 멋지네요!"

msgid "adv_101101_0046_msg"
msgstr "아, 레이나한테 연락이 왔어!\\n이제 곧 기동한대"

msgid "adv_101101_0047_msg"
msgstr "그럼… 란카, 가자!"

msgid "adv_101101_0048_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_101102_0008_msg"
msgstr "아, 미셸 선배!"

msgid "adv_101102_0009_msg"
msgstr "루카"

msgid "adv_101102_0010_msg"
msgstr "초시공 유닛 라이브, 성공했네요!"

msgid "adv_101102_0011_msg"
msgstr "그래.\\n그러고 보니 L.A.I도 협력했다고 들었는데"

msgid "adv_101102_0012_msg"
msgstr "확실히 하드웨어 쪽은 협력했지만, 그래도 역시\\n레이나 씨의 기술은 대단해요"

msgid "adv_101102_0013_msg"
msgstr "정말 아군이라 다행이라고 생각해요.\\n이쪽 보안에 대해서도 여러 가지 조언을 해줬고요"

msgid "adv_101102_0014_msg"
msgstr "헤에…"

msgid "adv_101102_0015_msg"
msgstr "그나저나 초시공 유닛 라이브…\\n이번 라이브로 멸망의 노래 영향에 맞설 수 있다는 걸 알게 됐네요"

msgid "adv_101102_0016_msg"
msgstr "큰 한 걸음이라고 할 수 있겠네"

msgid "adv_101102_0017_msg"
msgstr "네!"

msgid "adv_101102_0018_msg"
msgstr "그런데 미셸 선배! …알토 선배는요?"

msgid "adv_101102_0019_msg"
msgstr "알토라면 셰릴이랑 란카한테 간 거 아닐까?"

msgid "adv_101102_0020_msg"
msgstr "초시공 유닛 라이브는 안전상 문제없다고 말했는데도…\\n뭐랄까, 역시 알토 선배답네요"

msgid "adv_101102_0021_msg"
msgstr "…정말이지, 그러게"

msgid "adv_101102_0023_msg"
msgstr "셰릴 씨!\\n초시공 유닛 라이브, 정말 즐거웠네요!"

msgid "adv_101102_0024_msg"
msgstr "응, 그러네! 왈큐레 애들이랑도 이야기할 수 있었고,\\n새롭게 알게 된 것도 많았어!"

msgid "adv_101102_0025_msg"
msgstr "에헤헤…"

msgid "adv_101102_0026_msg"
msgstr "…? 란카, 왜 그래?"

msgid "adv_101102_0027_msg"
msgstr "아, 아니에요! 그냥 이번 의상이\\n셰릴 씨랑 맞춰 입은 거라 기뻐서요…"

msgid "adv_101102_0028_msg"
msgstr "밀레느가 자매 같다고 말해줘서,\\n왠지 기분이 좋아졌어요"

msgid "adv_101102_0029_msg"
msgstr "란카…"

msgid "adv_101102_0030_msg"
msgstr "셰릴 씨 같은 언니가 있었다면,\\n매일 어떤 생활을 했을까… 하고 생각했어요"

msgid "adv_101102_0031_msg"
msgstr "후훗!\\n란카 같은 여동생이 있으면 매일 즐거울 것 같네!"

msgid "adv_101102_0032_msg"
msgstr "그래도 자매가 아니라서 다행이야.\\n자매였다면 지금처럼 서로 경쟁하면서 노래할 수 없었을 테니까"

msgid "adv_101102_0033_msg"
msgstr "그러고 보니 그렇네요!"

msgid "adv_101102_0034_msg"
msgstr "자, 다음 라이브 준비를 하자!\\n다른 사람들과도 함께 노래할 수 있게 됐으니, 더 갈고닦아야지!"

msgid "adv_101102_0035_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_201001_0007_msg"
msgstr "있잖아, 바사라!"

msgid "adv_201001_0008_msg"
msgstr ""

msgid "adv_201001_0009_msg"
msgstr "…아, 잠깐!"

msgid "adv_201001_0011_msg"
msgstr "음… 역시 또…"

msgid "adv_201001_0013_msg"
msgstr "왜 그래, 밀레느?"

msgid "adv_201001_0014_msg"
msgstr "레이!"

msgid "adv_201001_0015_msg"
msgstr "그게… 요즘 바사라가 라이브가 끝나면 어딘가로 가거든.\\n그게 신경 쓰여서"

msgid "adv_201001_0016_msg"
msgstr "그렇구나. 그래도 여기저기 돌아다니는 건 늘 그렇잖아"

msgid "adv_201001_0017_msg"
msgstr "그건 그렇지만… 요즘 계속 그런다고?\\n레이는 걱정 안 돼?"

msgid "adv_201001_0018_msg"
msgstr "이렇게 된 이상…!"

msgid "adv_201001_0019_msg"
msgstr "밀레느, 그렇다고 미행하는 건 좀 그렇지 않나.\\n사람마다 각자 사적인 사정이 있는 거야"

msgid "adv_201001_0020_msg"
msgstr "그래도… 조금만!"

msgid "adv_201001_0022_msg"
msgstr "…정말, 뭐든 궁금해할 나이인가 보군"

msgid "adv_201001_0024_msg"
msgstr "레이는 그렇게 말했지만… 걱정되는 걸 어떡해.\\n일단 바사라를 쫓아가야겠어!"

msgid "adv_201001_0026_msg"
msgstr "밀레느, 이런 데서 뭐 하고 있어?"

msgid "adv_201001_0027_msg"
msgstr "꺄악!!"

msgid "adv_201001_0028_msg"
msgstr "정말! 놀라게 하지 마, 바사라!"

msgid "adv_201001_0029_msg"
msgstr "그냥 말 걸었을 뿐이잖아.\\n그래서 이런 데서 뭐 하고 있는 거야?"

msgid "adv_201001_0030_msg"
msgstr "그건 내가 할 말이야!\\n바사라야말로 매번 라이브 끝나고 어디 가는 건데?"

msgid "adv_201001_0031_msg"
msgstr "노래하러 가"

msgid "adv_201001_0032_msg"
msgstr "어디로?"

msgid "adv_201001_0033_msg"
msgstr "숲으로"

msgid "adv_201001_0034_msg"
msgstr "숲!? 누구한테 노래하는데?"

msgid "adv_201001_0035_msg"
msgstr "누군지는 나도 몰라"

msgid "adv_201001_0036_msg"
msgstr "모른다니… 무슨 뜻이야?"

msgid "adv_201001_0037_msg"
msgstr "너한텐 아직 몰라.\\n난 이만 간다, 그럼"

msgid "adv_201001_0039_msg"
msgstr "잠깐, 바사라! 기다려!"

msgid "adv_201002_0008_msg"
msgstr "결국 바사라를 놓쳐버렸네…"

msgid "adv_201002_0009_msg"
msgstr "뭐, 바사라가 어딘가에 가던 이유는\\n알았으니 됐잖아"

msgid "adv_201002_0010_msg"
msgstr "그건 그렇지만… 아~!\\n나도 바사라가 말한 사람을 만나보고 싶었는데"

msgid "adv_201002_0011_msg"
msgstr "미행 기술을 좀 더 배워야겠어!"

msgid "adv_201002_0012_msg"
msgstr "적당히 해둬"

msgid "adv_201002_0013_msg"
msgstr "그런데… 밀레느.\\n바사라는 어디 있어?"

msgid "adv_201002_0014_msg"
msgstr "또 어딘가로 훌쩍 나가버렸어.\\n…왠지 조금 기운 없어 보였던 것 같기도 해"

msgid "adv_201002_0015_msg"
msgstr "…나, 역시 상태 좀 보러 갔다 올래!"

msgid "adv_201002_0017_msg"
msgstr "그래… 라고 해도 벌써 가버렸나.\\n정말, 뭐든 궁금해할 나이는 힘들구나…"

msgid "adv_201002_0019_msg"
msgstr "시빌…인가"

msgid "adv_201002_0021_msg"
msgstr "바사라!"

msgid "adv_201002_0022_msg"
msgstr "뭐야, 밀레느였나"

msgid "adv_201002_0023_msg"
msgstr "뭐야라니! 모처럼 걱정돼서 찾아와줬는데!"

msgid "adv_201002_0024_msg"
msgstr "무슨 일이야?"

msgid "adv_201002_0025_msg"
msgstr "그건… 그러니까, 뭐랄까…"

msgid "adv_201002_0026_msg"
msgstr "나, 바사라 노래 싫어하지 않으니까!"

msgid "adv_201002_0027_msg"
msgstr "뭐?"

msgid "adv_201002_0028_msg"
msgstr "그러니까 마음 내키면,\\n내가 바사라 노래를 들어줘도 된다고?"

msgid "adv_201002_0029_msg"
msgstr "…무슨 말인진 잘 모르겠지만, 걱정할 필요 없어.\\n그 녀석은 또 어디선가 만날 것 같거든"

msgid "adv_201002_0030_msg"
msgstr "바사라… 그렇네!"

msgid "adv_201002_0031_msg"
msgstr "아, 맞다! 오늘 연습 말인데…"

msgid "adv_201002_0032_msg"
msgstr "오늘은 패스"

msgid "adv_201002_0033_msg"
msgstr "정말~!!"

msgid "adv_300901_0007_msg"
msgstr ""

msgid "adv_300901_0008_msg"
msgstr "알토 선배, 왜 그러세요?"

msgid "adv_300901_0009_msg"
msgstr "아니, 란카랑 셰릴이 요즘\\n열심히 뭔가 영상을 보고 있잖아? 뭘 보는 거야?"

msgid "adv_300901_0010_msg"
msgstr "아! 그건 Fire Bomber 영상이에요!\\n저도 자세히는 모르지만 오즈마 대장이 가지고 있었나 봐요…"

msgid "adv_300901_0011_msg"
msgstr "둘 다 다음 위문 라이브까지 뭔가 새로운 연출이 필요하다고\\n했으니까, 아이디어라도 찾고 있는 거 아닐까요?"

msgid "adv_300901_0012_msg"
msgstr "위문 라이브라…"

msgid "adv_300901_0013_msg"
msgstr "이런, 호랑이도 제 말 하면 온다더니…"

msgid "adv_300901_0014_msg"
msgstr "셰릴 씨! 란카 씨!"

msgid "adv_300901_0016_msg"
msgstr "여기 있었구나.\\n너희들, 잠깐 괜찮아?"

msgid "adv_300901_0018_msg"
msgstr "마침 지금 너희 얘기하고 있었어.\\n다음 위문 라이브, 좋은 아이디어라도 떠올랐어?"

msgid "adv_300901_0019_msg"
msgstr "응, 완벽해. 그렇지, 란카?"

msgid "adv_300901_0020_msg"
msgstr "네!\\n그래서 말인데, 알토 군들한테 부탁이 하나 있어…"

msgid "adv_300901_0021_msg"
msgstr "부탁?"

msgid "adv_300901_0022_msg"
msgstr "이번 위문 라이브에서 같이 무대에 서"

msgid "adv_300901_0024_msg"
msgstr "…응?"

msgid "adv_300901_0025_msg"
msgstr "뭐어어어!?"

msgid "adv_300901_0027_msg"
msgstr "잠깐만, 셰릴! 무슨 생각이야!\\n란카, 너도…"

msgid "adv_300901_0028_msg"
msgstr "셰릴 씨랑 얘기하다가 밴드를 한번 해보자는\\n이야기가 나왔어! 이름하여 Lovely Bomber!!"

msgid "adv_300901_0029_msg"
msgstr "뭐?"

msgid "adv_300901_0030_msg"
msgstr "Fire Bomber를 오마주한 의상을 입는 건 어때?\\n예를 들면… 미셸이 넥키 바사라 차림을 한다든가"

msgid "adv_300901_0031_msg"
msgstr "와…! 잘 어울릴지도!\\n셰릴 씨, 저희는 어떻게 할까요…?"

msgid "adv_300901_0032_msg"
msgstr "맡겨둬!\\nFire Bomber를 이미지로 하면서도 섹시한 걸 준비할게"

msgid "adv_300901_0033_msg"
msgstr "위문 라이브가 데뷔 무대인 거야.\\n초보라고 봐줄 생각은 없어. 마음껏 분위기를 띄워보자!"

msgid "adv_300901_0035_msg"
msgstr "미셸 선배, 넥키 바사라 역할이라네요…\\n왠지 엄청난 일이 돼버렸네요…"

msgid "adv_300901_0036_msg"
msgstr "그래… 어떻게 될지 모르겠군"

msgid "adv_300901_0038_msg"
msgstr "자… 드디어 위문 라이브 당일이네.\\n의상도 연습도 완벽하고, 좋은 라이브가 될 것 같아"

msgid "adv_300901_0039_msg"
msgstr "루카랑 미셸도 준비는 다 된 것 같아"

msgid "adv_300901_0040_msg"
msgstr "알토도 서둘러"

msgid "adv_300901_0041_msg"
msgstr "…몇 번이나 말했지만 난 무대에 서도 아무것도 못 해.\\n루카나 미셸과 달리 연습도 안 했고"

msgid "adv_300901_0042_msg"
msgstr "어머, 어느 정도는 출 수 있잖아?\\n나랑 란카가 연습하는 걸 항상 봤으니까"

msgid "adv_300901_0043_msg"
msgstr ""

msgid "adv_300901_0044_msg"
msgstr "문제없겠네"

msgid "adv_300901_0045_msg"
msgstr "자, 얼른 준비해! 모처럼 귀여운 드레스도 준비했으니까"

msgid "adv_300901_0046_msg"
msgstr "뭐? 드레스!?\\nFire Bomber를 오마주한 의상이라고 했잖아!"

msgid "adv_300901_0047_msg"
msgstr "감사하도록 해, 알토한테는 특별한 의상을 준비해줬으니까.\\n자, 가자!"

msgid "adv_300901_0048_msg"
msgstr "어이, 셰릴!?"

msgid "adv_300902_0008_msg"
msgstr "셰릴 씨! 라이브, 대성공이었네요!"

msgid "adv_300902_0009_msg"
msgstr "정말 즐거웠고, 정말 멋진 시간이었어요.\\n게다가 이번 의상도 정말 마음에 들어요!"

msgid "adv_300902_0010_msg"
msgstr "응, 정말 잘 어울려, 란카"

msgid "adv_300902_0011_msg"
msgstr "감사합니다! 셰릴 씨도 멋져요!"

msgid "adv_300902_0012_msg"
msgstr "만약 Fire Bomber와 함께 라이브를 하게 된다면,\\n밀레느 일행과도 맞춰 입은 의상을 입고 싶네!"

msgid "adv_300902_0013_msg"
msgstr "네!"

msgid "adv_300902_0014_msg"
msgstr ""

msgid "adv_300902_0015_msg"
msgstr "셰릴 씨?"

msgid "adv_300902_0016_msg"
msgstr "있잖아, 란카.\\n잠깐만 내 어리광에 어울려줄래?"

msgid "adv_300902_0017_msg"
msgstr "어리광이요?"

msgid "adv_300902_0018_msg"
msgstr "응. 라이브는 끝났지만 조금 더 노래하고 싶은 기분이야"

msgid "adv_300902_0019_msg"
msgstr "저도요! 이대로 무대에서 내려가면\\n왠지 아까울 것 같아서…"

msgid "adv_300902_0020_msg"
msgstr "셰릴 씨는 어떤 곡을 부르고 싶으세요?"

msgid "adv_300902_0021_msg"
msgstr "그러게… 모처럼이니까 Fire Bomber 노래는 어때?"

msgid "adv_300902_0022_msg"
msgstr "와! 좋네요, 찬성이에요!"

msgid "adv_300902_0023_msg"
msgstr "…이번 무대에서 배운 게 정말 많았어"

msgid "adv_300902_0024_msg"
msgstr "내가 할 수 있는 것, 모두와 함께라서 할 수 있는 것,\\n그리고 란카와 함께라서 할 수 있는 것"

msgid "adv_300902_0025_msg"
msgstr "셰릴 씨…"

msgid "adv_300902_0026_msg"
msgstr "뜨거운 노래를 전해주자, 란카!"

msgid "adv_300902_0027_msg"
msgstr "네!"

msgid "adv_300902_0029_msg"
msgstr "알토 선배, 미셸 선배!\\n수고하셨습니다!"

msgid "adv_300902_0030_msg"
msgstr "…어라? 벌써 갈아입으셨어요?"

msgid "adv_300902_0031_msg"
msgstr "당연하지"

msgid "adv_300902_0032_msg"
msgstr "…뭐, 아깝긴 하지만 다음 임무까지 시간이 없으니까.\\n…그런데, 어이, 알토…"

msgid "adv_300902_0034_msg"
msgstr "가버렸네요… 알토 선배.\\n의상 때문에 아직 화난 걸까요?"

msgid "adv_300902_0035_msg"
msgstr "아니. 셰릴이랑 란카가 아직 노래하고 있는 것 같으니까\\n그쪽으로 간 거겠지"

msgid "adv_300902_0036_msg"
msgstr "…그나저나 무대 위의 알토 선배는\\n정말 대단했네요"

msgid "adv_300902_0037_msg"
msgstr "본 공연에서 놀랄 만큼 완벽하게 춤을 췄으니까요…"

msgid "adv_300902_0038_msg"
msgstr "…그러게.\\n뭐, 본인한테 말해도 인정하려 들진 않겠지만"

msgid "adv_300902_0039_msg"
msgstr "…확실히 그렇겠네요"

msgid "adv_101201_0008_msg"
msgstr "카나메 씨, 진짜 예뻐요!\\n이게 웨딩드레스라는 거죠!"

msgid "adv_101201_0009_msg"
msgstr "카나카나한테 딱 어울리고, 너무 귀여워~!"

msgid "adv_101201_0010_msg"
msgstr "프레이아, 마키나, 고마워"

msgid "adv_101201_0011_msg"
msgstr "그래도 이렇게 실제로 입어보니까\\n왠지 긴장되네…"

msgid "adv_101201_0012_msg"
msgstr ""

msgid "adv_101201_0013_msg"
msgstr "마키나? 왜 그래?"

msgid "adv_101201_0014_msg"
msgstr "…훌쩍… 카나카나가 시집간다고 생각하니까\\n왠지 쓸쓸해져서"

msgid "adv_101201_0015_msg"
msgstr "뭐!?"

msgid "adv_101201_0016_msg"
msgstr "으으… 저도…"

msgid "adv_101201_0017_msg"
msgstr "어, 음… 둘 다 진정해.\\n레이나, 손수건 좀 가져다줄래?"

msgid "adv_101201_0019_msg"
msgstr "응"

msgid "adv_101201_0020_msg"
msgstr "고마워"

msgid "adv_101201_0022_msg"
msgstr "마키나, 프레이아.\\n있잖아, 어제부터 몇 번이나 설명했지만…"

msgid "adv_101201_0023_msg"
msgstr "이번 촬영의 테마가 웨딩일 뿐이지\\n내가 정말 결혼하는 건 아니야"

msgid "adv_101201_0024_msg"
msgstr "응…"

msgid "adv_101201_0025_msg"
msgstr "그건… 알고 있긴 한데, 자꾸 눈물이 나요~!"

msgid "adv_101201_0026_msg"
msgstr "후훗… 그래그래.\\n닦아줄 테니까 가만히 있어?"

msgid "adv_101201_0027_msg"
msgstr "뭐, 나도 언젠가는… 하고 생각할 때도 있지만,\\n그래도 지금은 왈큐레가 가장 소중하니까"

msgid "adv_101201_0028_msg"
msgstr "카나카나!"

msgid "adv_101201_0029_msg"
msgstr "카나메 씨…!"

msgid "adv_101201_0030_msg"
msgstr "이제 괜찮겠지?\\n…그럼 슬슬 촬영하러 가야겠다!\\n나머지는 부탁할게"

msgid "adv_101201_0031_msg"
msgstr "네~! 카나카나, 잘 다녀와~!"

msgid "adv_101201_0032_msg"
msgstr "힘내세요, 카나메 씨!"

msgid "adv_101201_0034_msg"
msgstr "…자, 그럼 프레프레!"

msgid "adv_101201_0035_msg"
msgstr "마키나 씨? 무슨 일이에요?"

msgid "adv_101201_0036_msg"
msgstr "카나카나의 너무 귀여운 드레스 차림,\\n좀 더 보고 싶지 않아?"

msgid "adv_101201_0037_msg"
msgstr "보고 싶어요!\\n하지만 이번 일은 저희가 집을 지키는 역할이라고 들었는데…"

msgid "adv_101201_0038_msg"
msgstr "걱정 안 해도 괜찮아!\\n그치, 레이레이!"

msgid "adv_101201_0040_msg"
msgstr "촬영 현장 카메라 해킹 완료.\\n이걸로 언제든 몰래 볼 수 있어"

msgid "adv_101201_0041_msg"
msgstr "역시 레이나 씨예요…"

msgid "adv_101201_0042_msg"
msgstr "좋아! 그럼 쿠모쿠모도 불러서\\n다 같이 카나카나를 응원하자!"

msgid "adv_101201_0043_msg"
msgstr "기운 팍팍~!"

msgid "adv_101202_0008_msg"
msgstr "…움직이기 불편해"

msgid "adv_101202_0009_msg"
msgstr "…불만"

msgid "adv_101202_0010_msg"
msgstr "레이레이, 너무 귀여워~!!\\n진짜 잘 어울려!"

msgid "adv_101202_0011_msg"
msgstr ""

msgid "adv_101202_0012_msg"
msgstr "레이나 씨! 촬영은 어땠어요?"

msgid "adv_101202_0013_msg"
msgstr "…폭발에 휘말리면서 싸웠어"

msgid "adv_101202_0014_msg"
msgstr "에엣!?"

msgid "adv_101202_0015_msg"
msgstr "꽤 하드한 액션"

msgid "adv_101202_0016_msg"
msgstr "…그런 결혼식도 있구나"

msgid "adv_101202_0017_msg"
msgstr "이번 레이레이랑 카나카나의 사진은\\n드레스 광고로 은하 전역에 나간대!"

msgid "adv_101202_0018_msg"
msgstr "기운 팍팍~!\\n은하 전역이면 라그나나 윈더미어에도 나오는 거죠?"

msgid "adv_101202_0019_msg"
msgstr "물론이지!"

msgid "adv_101202_0020_msg"
msgstr "오오오! 진짜 기대돼요!"

msgid "adv_101202_0022_msg"
msgstr "뭐!? …이, 이건"

msgid "adv_101202_0023_msg"
msgstr "왈큐레가 신부 의상을…!?"

msgid "adv_101202_0025_msg"
msgstr "보그, 무슨 일이냐?"

msgid "adv_101202_0026_msg"
msgstr "아, 아닙니다!? 그게…"

msgid "adv_101202_0027_msg"
msgstr "…? 얼굴이 빨갛군.\\n몸 상태가 안 좋은 모양이네. 쉬어라"

msgid "adv_101202_0028_msg"
msgstr "로이드에게는 내가 말해두지"

msgid "adv_101202_0029_msg"
msgstr "아닙니다! 오늘은 모처럼\\n백기사님께서 직접 훈련을 봐주시는 날인데…"

msgid "adv_101202_0030_msg"
msgstr "명령이다. 쉬어라"

msgid "adv_101202_0032_msg"
msgstr "그럴 수가…"

msgid "adv_101202_0033_msg"
msgstr "이놈, 왈큐레!"

msgid "adv_101202_0034_msg"
msgstr "이놈, 레이나 프라우러!!"

msgid "adv_201101_0008_msg"
msgstr "셰릴 씨 라이브를\\n맨 앞줄에서 볼 수 있는 날이 오다니, 꿈만 같아!"

msgid "adv_201101_0009_msg"
msgstr "…아니, 아무리 그래도 너무 들떴나?\\n그냥 팬이었던 시절과 달리 지금은 같은 무대에\\n서기도 하는데…"

msgid "adv_201101_0010_msg"
msgstr "그래도 셰릴 씨의 팬이라는 마음은\\n계속 변하지 않았달까…"

msgid "adv_201101_0012_msg"
msgstr "란카?"

msgid "adv_201101_0013_msg"
msgstr "꺅!? 깜짝이야… 어, 알토 군!\\n그 차림은…"

msgid "adv_201101_0014_msg"
msgstr "그래, 오늘은 셰릴 라이브의 호위야.\\n노랫소리를 들은 적이 언제 습격해올지 모르니까"

msgid "adv_201101_0015_msg"
msgstr "…그런데 란카는 왜 이런 데 있어?"

msgid "adv_201101_0017_msg"
msgstr "관객으로 왔을 뿐이다"

msgid "adv_201101_0018_msg"
msgstr "브레라…?"

msgid "adv_201101_0019_msg"
msgstr "란카. 자리로 돌아가자"

msgid "adv_201101_0020_msg"
msgstr "브레라 씨!"

msgid "adv_201101_0021_msg"
msgstr "…그렇군. 브레라는 란카의 호위라는 거네"

msgid "adv_201101_0022_msg"
msgstr "그래"

msgid "adv_201101_0023_msg"
msgstr "설령 네놈이 전투에서 시시한 실수를 하더라도,\\n란카에게는 내가 붙어 있다. 안심해라"

msgid "adv_201101_0024_msg"
msgstr "시시한 실수 같은 거 안 해!"

msgid "adv_201101_0026_msg"
msgstr "잠깐, 너희들!"

msgid "adv_201101_0027_msg"
msgstr "본 공연 전이야?\\n신성한 무대 뒤를 험악한 분위기로 더럽히지 말아줄래"

msgid "adv_201101_0029_msg"
msgstr "셰릴 씨!"

msgid "adv_201101_0030_msg"
msgstr "안녕, 란카.\\n약속대로 보러 와줬구나!"

msgid "adv_201101_0031_msg"
msgstr "네!\\n정말 좋은 자리 감사합니다!"

msgid "adv_201101_0032_msg"
msgstr "그 의상… 혹시 오늘 라이브 의상인가요?\\n정말 잘 어울려요!"

msgid "adv_201101_0033_msg"
msgstr "고마워.\\n오늘 란카 옷도 정말 귀여워"

msgid "adv_201101_0034_msg"
msgstr ""

msgid "adv_201101_0035_msg"
msgstr "어머, 알토. 뭘 그렇게 빤히 보고 있는 걸까?"

msgid "adv_201101_0036_msg"
msgstr "뭐!? …딱히 보고 있던 거 아니야"

msgid "adv_201101_0037_msg"
msgstr "흐음… 그래?\\n뭐, 확실히 알토한테는 자극이 너무 강할지도 모르겠네"

msgid "adv_201101_0038_msg"
msgstr "어이, 가까이 오지 마, 셰릴!"

msgid "adv_201101_0039_msg"
msgstr "왜?"

msgid "adv_201101_0040_msg"
msgstr "왜냐니… 너도 알잖아!\\n나 가지고 놀지 마!"

msgid "adv_201101_0041_msg"
msgstr "알토 군!? 셰릴 씨!?"

msgid "adv_201101_0043_msg"
msgstr "셰릴에게 인사는 끝났나"

msgid "adv_201101_0044_msg"
msgstr "란카. 자리로 돌아가자"

msgid "adv_201101_0045_msg"
msgstr "앗… 브레라 씨, 기다려주세요!"

msgid "adv_201101_0047_msg"
msgstr "란카도 참, 얼굴이 새빨개졌네.\\n귀여워라"

msgid "adv_201101_0048_msg"
msgstr "너 말이야…"

msgid "adv_201101_0049_msg"
msgstr "자, 이제 곧 본 공연이야.\\n알토, 내 무대 제대로 지켜"

msgid "adv_201101_0050_msg"
msgstr "다쳐서 돌아오더라도 내가\\n제대로 간호해줄 테니까 안심해"

msgid "adv_201101_0051_msg"
msgstr "뭐!\\n누가 너한테 간호받는대!!"

msgid "adv_201101_0052_msg"
msgstr "…후훗.\\n알토도 란카도 놀리는 재미가 있어서 즐겁네"

msgid "adv_201101_0053_msg"
msgstr "덕분에 긴장이 풀렸어.\\n…자, 가볼까"

msgid "adv_201101_0054_msg"
msgstr "알토, 란카… 그리고\\n은하의 모든 사람들에게도,\\n내 최고의 무대를 전해주겠어!"

msgid "adv_201102_0008_msg"
msgstr "기운 팍팍…"

msgid "adv_201102_0009_msg"
msgstr "…흐음"

msgid "adv_201102_0011_msg"
msgstr "…프레이아, 하야테, 뭐 하고 있어요?\\n둘이서 단말기를 들여다보고"

msgid "adv_201102_0012_msg"
msgstr "미라쥬인가. 아, 란카한테 받은\\n셰릴 라이브 영상을 보고 있어"

msgid "adv_201102_0013_msg"
msgstr "프레이아는 벌써 20번쯤 반복해서 보고 있어.\\n안 질리나 몰라"

msgid "adv_201102_0014_msg"
msgstr "하야테도 남 말할 처지가 아니잖아?\\n중간부터 시간 가는 줄도 모르고 넋 놓고 봤으면서!"

msgid "adv_201102_0015_msg"
msgstr "넋 놓고 본 거 아니거든"

msgid "adv_201102_0016_msg"
msgstr "아무튼 너는 화면에서 얼굴 좀 떨어뜨려.\\n내가 보기 힘들잖아"

msgid "adv_201102_0017_msg"
msgstr "역시 남 말할 처지가 아니네!\\n정말 솔직하지 못하다니까…"

msgid "adv_201102_0018_msg"
msgstr "…그렇군요.\\n확실히 이건 대단하네요…"

msgid "adv_201102_0021_msg"
msgstr "셰릴, 어이, 기다려!"

msgid "adv_201102_0022_msg"
msgstr "무슨 일이야? 그렇게 소리 안 질러도 들려"

msgid "adv_201102_0023_msg"
msgstr "그럼 멈추라고!\\n…너, 왜 화난 거야"

msgid "adv_201102_0024_msg"
msgstr "…딱히 화난 거 아니야"

msgid "adv_201102_0025_msg"
msgstr "그냥 알토가 갑자기 나를 칭찬하니까…\\n어떻게 반응해야 할지 조금 곤란했을 뿐이야!"

msgid "adv_201102_0026_msg"
msgstr "…뭐야, 그게 다야?"

msgid "adv_201102_0027_msg"
msgstr "그게 다라니! 나한테는…\\n아니, 아무것도 아니야"

msgid "adv_201102_0028_msg"
msgstr "…그래서, 할 말은 그게 다야?"

msgid "adv_201102_0029_msg"
msgstr "그리고… 그 의상.\\n너답고 괜찮은 것 같아"

msgid "adv_201102_0030_msg"
msgstr "상식에 얽매이지 않는 느낌이 셰릴 놈답다고 생각해"

msgid "adv_201102_0031_msg"
msgstr ""

msgid "adv_201102_0032_msg"
msgstr "감상. 일단 말해두는 게 좋을 것 같아서"

msgid "adv_201102_0033_msg"
msgstr "알토…"

msgid "adv_201102_0034_msg"
msgstr "요즘 조금 너무 힘이 들어가 있었거든"

msgid "adv_201102_0035_msg"
msgstr "힘이 들어가? 네가?"

msgid "adv_201102_0036_msg"
msgstr "이제 내 노래를 듣는 건\\n이 은하의 사람들뿐만이 아니잖아"

msgid "adv_201102_0037_msg"
msgstr "린 민메이, Fire Bomber, 왈큐레…\\n다른 은하에 있는 가수들까지\\n모두가 내 노래를 듣고 있어"

msgid "adv_201102_0038_msg"
msgstr "그렇게 생각하니까 조금 너무 힘이 들어가서.\\n나답지 않게 긴장하기도 했거든"

msgid "adv_201102_0039_msg"
msgstr "하지만… 그러네.\\n중요한 걸 잊고 있었어"

msgid "adv_201102_0040_msg"
msgstr "나는 셰릴 놈.\\n셰릴 놈은 상식에도, 그 어떤 것에도 얽매이지 않아.\\n나는 그저 내 노래를 부를 뿐이야"

msgid "adv_201102_0041_msg"
msgstr "떠올리게 해줘서 고마워, 알토"

msgid "adv_201102_0042_msg"
msgstr "…셰릴"

msgid "adv_201102_0043_msg"
msgstr "내가 이렇게 솔직하게 고맙다고 하는 건 귀한 일이니까,\\n감사하게 생각해?"

msgid "adv_201102_0045_msg"
msgstr ""

msgid "adv_201102_0046_msg"
msgstr "…정말.\\n화냈다가 좋아했다가, 바쁜 녀석이네"

msgid "adv_301001_0003_msg"
msgstr "마키나, 잠깐 괜찮아?"

msgid "adv_301001_0004_msg"
msgstr "카나카나! 무슨 일이야?"

msgid "adv_301001_0005_msg"
msgstr "부탁했던 그 건 말인데… 어때?"

msgid "adv_301001_0006_msg"
msgstr "아! 초시공 유닛 라이브 개량 말이지?\\n아까 최종 조정까지 끝나서 완벽하게 완료했어!"

msgid "adv_301001_0007_msg"
msgstr "정말!?"

msgid "adv_301001_0008_msg"
msgstr "지금 같이 기동해볼까 했는데,\\n레이레이가 안 보여서…"

msgid "adv_301001_0009_msg"
msgstr "레이나라면 아까 프레이아랑 같이 있었어"

msgid "adv_301001_0010_msg"
msgstr "그렇구나!\\n그러고 보니… 프레프레, 어제 라이브 이후로\\n상태가 좀 이상한데 괜찮을까?"

msgid "adv_301001_0011_msg"
msgstr "그러게… 나도 그게 걱정되긴 해"

msgid "adv_301001_0012_msg"
msgstr "일단 둘한테 가볼게!\\n카나카나, 고마워~!"

msgid "adv_301001_0014_msg"
msgstr "그래~.\\n…잠깐, 마키나, 너무 뛰면 안 돼!"

msgid "adv_301001_0015_msg"
msgstr "…정말"

msgid "adv_301001_0017_msg"
msgstr ""

msgid "adv_301001_0018_msg"
msgstr "으으… 잘 모르겠어…"

msgid "adv_301001_0019_msg"
msgstr ""

msgid "adv_301001_0021_msg"
msgstr "어이~ 둘 다… 어라, 무슨 일이야?"

msgid "adv_301001_0022_msg"
msgstr "마키나"

msgid "adv_301001_0023_msg"
msgstr "마키나 씨!"

msgid "adv_301001_0024_msg"
msgstr "프레프레, 왠지 얼굴이 새빨간데?"

msgid "adv_301001_0025_msg"
msgstr "아, 아무것도 아니에요! 멀쩡해요!"

msgid "adv_301001_0026_msg"
msgstr "정말?"

msgid "adv_301001_0027_msg"
msgstr "거짓말"

msgid "adv_301001_0028_msg"
msgstr "에엣!?"

msgid "adv_301001_0029_msg"
msgstr "자자~ 숨기는 건 금지!\\n어제 라이브 끝난 뒤부터 기운 없었지?\\n마키마키한테는 전~부 다 보인다고"

msgid "adv_301001_0030_msg"
msgstr "네, 네엣…"

msgid "adv_301001_0031_msg"
msgstr "그래서 대체 무슨 일이 있었던 거야?"

msgid "adv_301001_0032_msg"
msgstr "사실… 어제 라이브 때,\\n전혀 기억에 없는 기억을 봤어요"

msgid "adv_301001_0033_msg"
msgstr "기억에 없는 기억…이라면,\\n혹시 다들 가끔 말하는 평행세계의 기억인가?"

msgid "adv_301001_0034_msg"
msgstr "그럴지도 몰라요…"

msgid "adv_301001_0035_msg"
msgstr "…그런데 프레프레가 얼굴이 새빨개질 정도의 기억이라면,\\n혹시 하야하야랑 관련된 기억이야?"

msgid "adv_301001_0036_msg"
msgstr "어, 어떻게 아신 거예요!?"

msgid "adv_301001_0037_msg"
msgstr "티 다 나"

msgid "adv_301001_0038_msg"
msgstr "…기억 속의 나는 하야테에게 노래를 전해야 한다고 생각했어요.\\n그런데 하야테뿐만 아니라,\\n모두도 미쿠모 씨도 큰일이 난 상태였고…"

msgid "adv_301001_0039_msg"
msgstr "어쨌든 목숨 걸고 노래하고 있었어요"

msgid "adv_301001_0040_msg"
msgstr "그때 하야테한테… 조, 조…"

msgid "adv_301001_0041_msg"
msgstr "조?"

msgid "adv_301001_0042_msg"
msgstr "아와와와와!?"

msgid "adv_301001_0043_msg"
msgstr "고장 났어"

msgid "adv_301001_0044_msg"
msgstr "프레프레, 정신 차려!"

msgid "adv_301001_0045_msg"
msgstr "으으…"

msgid "adv_301001_0046_msg"
msgstr "음… 이건 중증일지도…"

msgid "adv_301001_0047_msg"
msgstr "마키나"

msgid "adv_301001_0048_msg"
msgstr "응?"

msgid "adv_301001_0049_msg"
msgstr "초시공 유닛 라이브, 하자"

msgid "adv_301001_0050_msg"
msgstr "그러자, 그럼 프레프레도\\n조금은 기분 전환이 될지도…"

msgid "adv_301001_0051_msg"
msgstr "좋아, 프레프레! 같이 노래하자!"

msgid "adv_301001_0052_msg"
msgstr "에엣!?"

msgid "adv_301001_0053_msg"
msgstr "초시공 유닛 라이브, 나랑 레이레이가 개량했어!\\n다음엔 셋이 함께 시공을 초월한 라이브를 할 수 있어!"

msgid "adv_301001_0054_msg"
msgstr "그러니까 미레미레나 셰리셰리한테도\\n우리 셋의 무대를 보여주자!"

msgid "adv_301001_0055_msg"
msgstr "…네엣??"

msgid "adv_301001_0056_msg"
msgstr "노래하면 알아"

msgid "adv_301001_0057_msg"
msgstr "맞아 맞아!\\n그럼 레이레이, 부탁해!"

msgid "adv_301001_0058_msg"
msgstr "초시공 유닛 라이브, 기동"

msgid "adv_301002_0008_msg"
msgstr "초시공 유닛 라이브, 대성공이네!"

msgid "adv_301002_0009_msg"
msgstr "당연"

msgid "adv_301002_0010_msg"
msgstr "바사라 씨도 밀레느 씨도 정말 좋아해줘서\\n기뻤어요!"

msgid "adv_301002_0011_msg"
msgstr "그치~! 레이레이랑 같이 개량할 때는\\n힘들었지만, 다들 웃는 얼굴을 볼 수 있어서 좋았어~!"

msgid "adv_301002_0012_msg"
msgstr "만족"

msgid "adv_301002_0013_msg"
msgstr "자… 이제 남은 건 프레프레가\\n하야하야랑 화해하는 것뿐인가?"

msgid "adv_301002_0014_msg"
msgstr ""

msgid "adv_301002_0015_msg"
msgstr "카나카나도 걱정하고 있었어~?"

msgid "adv_301002_0016_msg"
msgstr "으…"

msgid "adv_301002_0017_msg"
msgstr "프레이아"

msgid "adv_301002_0018_msg"
msgstr "네엣!"

msgid "adv_301002_0019_msg"
msgstr "빠를수록 좋아"

msgid "adv_301002_0020_msg"
msgstr "…네엣! 다녀올게요!!"

msgid "adv_301002_0023_msg"
msgstr ""

msgid "adv_301002_0024_msg"
msgstr "미라쥬"

msgid "adv_301002_0025_msg"
msgstr "미쿠모 씨!"

msgid "adv_301002_0026_msg"
msgstr "프레이아와 하야테가 봤다는 다른 세계의 기억…\\n너도 본 거 아니야?"

msgid "adv_301002_0027_msg"
msgstr "그걸 어떻게!?"

msgid "adv_301002_0028_msg"
msgstr "그냥 왠지 그런 것 같았을 뿐이야"

msgid "adv_301002_0029_msg"
msgstr "…역시 신기한 사람이네요. 미쿠모 씨는"

msgid "adv_301002_0030_msg"
msgstr "그런가?"

msgid "adv_301002_0031_msg"
msgstr ""

msgid "adv_301002_0032_msg"
msgstr "프레이아 일행에게도 말했지만, 어딘가 다른 세계의 이야기야.\\n앞으로 너희가 어떻게 될지는 아무도 몰라"

msgid "adv_301002_0033_msg"
msgstr "…물론, 나도"

msgid "adv_301002_0034_msg"
msgstr "…! 혹시 미쿠모 씨도 본 건가요?"

msgid "adv_301002_0035_msg"
msgstr "글쎄"

msgid "adv_301002_0037_msg"
msgstr "아, 미라미라!!"

msgid "adv_301002_0038_msg"
msgstr "마키나 씨… 무슨 일이에요?"

msgid "adv_301002_0039_msg"
msgstr "사실 화해하려던 프레프레랑 하야하야가\\n또 싸워버렸어…"

msgid "adv_301002_0040_msg"
msgstr "또요!?"

msgid "adv_301002_0041_msg"
msgstr "…정말, 그 둘은!\\n마키나 씨, 감사합니다. 말리러 갈게요"

msgid "adv_301002_0043_msg"
msgstr "어라? 왠지 미라미라, 기운이 없었던 것 같은데…?"

msgid "adv_301002_0044_msg"
msgstr "평소랑 다를 거 없어"

msgid "adv_301002_0045_msg"
msgstr "…그런가?"

msgid "adv_301002_0046_msg"
msgstr "그보다 마키나, 다음 라이브 준비를 하자.\\n우리는 멈춰 있을 수 없어"

msgid "adv_301002_0047_msg"
msgstr "응, 그러자…!"

msgid "adv_101301_0008_msg"
msgstr "바사라~! 잠깐, 아직이야~?"

msgid "adv_101301_0009_msg"
msgstr "재촉하지 말라니까.\\n조금만 더 기다려…"

msgid "adv_101301_0011_msg"
msgstr "이걸로 됐어?"

msgid "adv_101301_0012_msg"
msgstr "와…! 괜찮은데!"

msgid "adv_101301_0013_msg"
msgstr "괜찮은데라니,\\n네가 가져온 의상이잖아?"

msgid "adv_101301_0014_msg"
msgstr "가져온 건 내가 맞지만\\n의상을 준비해준 건 아키코 씨라고?"

msgid "adv_101301_0015_msg"
msgstr "게다가 실제로 입어보기 전까지는\\n어울릴지 아닐지 모르잖아"

msgid "adv_101301_0016_msg"
msgstr "그런 건가"

msgid "adv_101301_0017_msg"
msgstr "그래도… 응, 잘 어울려!"

msgid "adv_101301_0018_msg"
msgstr "나도 빨리 갈아입고 싶다~"

msgid "adv_101301_0019_msg"
msgstr "그럼 손에 들고 있지 말고 갈아입으면 되잖아"

msgid "adv_101301_0020_msg"
msgstr "그런 건 말 안 해도 안다고~!"

msgid "adv_101301_0022_msg"
msgstr "둘 다, 무슨 일이야?"

msgid "adv_101301_0023_msg"
msgstr "아, 레이! 들어봐 들어봐!"

msgid "adv_101301_0024_msg"
msgstr "아키코 씨가 우리 앞으로\\n의상을 보내줬어!"

msgid "adv_101301_0025_msg"
msgstr "전에 왈큐레 애들이랑 의상 얘기로\\n엄청 들떴었거든. 그때 나도\\n새 의상 갖고 싶다~고 생각했는데"

msgid "adv_101301_0026_msg"
msgstr "아키코 씨, 내 마음을 알아챈 걸까…?\\n진짜 너무 기뻐!"

msgid "adv_101301_0027_msg"
msgstr "글쎄. 그건 모르겠지만…"

msgid "adv_101301_0028_msg"
msgstr "오늘은 그 의상 입고 라이브에 나갈 거지?"

msgid "adv_101301_0029_msg"
msgstr "물론이지!"

msgid "adv_101301_0030_msg"
msgstr "아, 맞다!\\n비히다한테도 이 의상 보여줘야지"

msgid "adv_101301_0031_msg"
msgstr "그럼 잠깐 다녀올게!"

msgid "adv_101301_0032_msg"
msgstr "아, 레이! 바사라가 라이브 전에\\n어디론가 가버리지 않게 제대~로 지켜봐줘!"

msgid "adv_101301_0033_msg"
msgstr "그래, 알겠어"

msgid "adv_101301_0034_msg"
msgstr "너무 들떠서 넘어지지 마"

msgid "adv_101301_0035_msg"
msgstr "바사라가 말 안 해도 괜찮거든~!"

msgid "adv_101301_0037_msg"
msgstr ""

msgid "adv_101301_0038_msg"
msgstr "왜 그래, 바사라.\\n…뭐, 물어볼 것도 없나"

msgid "adv_101301_0039_msg"
msgstr "억지로 입힌 의상이 마음에 안 든다\\n뭐 그런 거겠지?"

msgid "adv_101301_0040_msg"
msgstr "반대야"

msgid "adv_101301_0041_msg"
msgstr ""

msgid "adv_101301_0042_msg"
msgstr "반대라고. 뭐랄까… 이번 의상은 나쁘지 않아"

msgid "adv_101301_0043_msg"
msgstr "…아키코에게 부탁하길 잘했나 보군"

msgid "adv_101301_0044_msg"
msgstr "뭐라고 했어?"

msgid "adv_101301_0045_msg"
msgstr "…아, 아니. 신경 쓰지 마.\\n별일도 다 있구나 싶었을 뿐이야"

msgid "adv_101301_0046_msg"
msgstr "그보다 바사라.\\n밀레느가 돌아올 때까지 뭐라도 연주하면서 기다릴까"

msgid "adv_101301_0047_msg"
msgstr "좋네, 그거"

msgid "adv_101301_0048_msg"
msgstr "그럼 바로 한 곡 간다!"

msgid "adv_101302_0008_msg"
msgstr "수고했어~!\\n오늘 밤 라이브도 대성황이었네!"

msgid "adv_101302_0009_msg"
msgstr "우리 노래가 제대로 전해졌다는 거겠지"

msgid "adv_101302_0010_msg"
msgstr "그것뿐만 아니라…\\n분명 이 새 의상 덕분이야!"

msgid "adv_101302_0011_msg"
msgstr "오늘이 첫 공개였잖아.\\n반응이 너무 좋아서 나도\\n연주하는 내내 싱글벙글했다니까!"

msgid "adv_101302_0012_msg"
msgstr "역시 레이가 생각한 의상이네"

msgid "adv_101302_0013_msg"
msgstr "그치 그치~!?"

msgid "adv_101302_0014_msg"
msgstr "소매도 없고, 이상한 장식 같은 것도 없어서\\n연주하기 편해"

msgid "adv_101302_0015_msg"
msgstr "그리고 소재도 나쁘지 않아. 노래하는 데 방해가 안 돼"

msgid "adv_101302_0016_msg"
msgstr "…기능 얘기뿐이네"

msgid "adv_101302_0017_msg"
msgstr "내가 말하는 건 생김새 얘기야!\\n겉・모・습!"

msgid "adv_101302_0018_msg"
msgstr "바사라도 좀, 멋있다! 라든가\\n제대로 된 감상은 없어?"

msgid "adv_101302_0019_msg"
msgstr "넌 아직 멀었네"

msgid "adv_101302_0020_msg"
msgstr "의상 같은 건 라이브할 때 제대로 움직이고\\n제대로 노래하고, 제대로 연주할 수 있으면\\n그걸로 됐잖아"

msgid "adv_101302_0021_msg"
msgstr "너는 아직 노래한다는 게 뭔지 잘 모르는군"

msgid "adv_101302_0022_msg"
msgstr "뭐라고~!"

msgid "adv_101302_0024_msg"
msgstr ""

msgid "adv_101302_0025_msg"
msgstr "왜 그래? 비히다"

msgid "adv_101302_0026_msg"
msgstr ""

msgid "adv_101302_0027_msg"
msgstr "…아. 의상 얘기인가.\\n가끔은 괜찮잖아?"

msgid "adv_101302_0028_msg"
msgstr "밀레느 아버지한테는\\n『딸을 너무 응석받이로 만들지 말아달라』고\\n말을 듣긴 했지만…"

msgid "adv_101302_0029_msg"
msgstr "그래도 밀레느는\\n우리에게 소중한 동료니까"

msgid "adv_101302_0030_msg"
msgstr "의상 하나로 저렇게 기뻐하고\\n의욕까지 내준다면, 싼 거 아니겠어?"

msgid "adv_101302_0031_msg"
msgstr ""

msgid "adv_101302_0032_msg"
msgstr "…아니, 난 그렇게 대단한 일을 한 것도 아니야.\\n언제나 그렇듯이"

msgid "adv_101302_0033_msg"
msgstr ""

msgid "adv_101302_0035_msg"
msgstr "레이!"

msgid "adv_101302_0036_msg"
msgstr "있잖아 있잖아. 레이랑 비히다 의상도\\n새걸로 바꾸자!"

msgid "adv_101302_0037_msg"
msgstr "둘 의상도 나랑 바사라 의상이랑\\n세트처럼 맞춰달라고 하자!"

msgid "adv_101302_0039_msg"
msgstr "그런 것보다 신곡이지, 신곡"

msgid "adv_101302_0040_msg"
msgstr "레이. 신곡 써왔으니까 맞춰보자"

msgid "adv_101302_0041_msg"
msgstr "그래, 알겠어"

msgid "adv_101302_0043_msg"
msgstr "잠깐, 레이!\\n내 얘기 듣고 있었어~?"

msgid "adv_101302_0044_msg"
msgstr "그래. 그것도 알고 있어, 밀레느"

msgid "adv_101302_0045_msg"
msgstr ""

msgid "adv_101302_0047_msg"
msgstr ""

msgid "adv_201201_0008_msg"
msgstr "히카루…"

msgid "adv_201201_0009_msg"
msgstr "드디어\\n이 몸의 데뷔할 때가 온 거 아니냐?"

msgid "adv_201201_0010_msg"
msgstr "선배.\\n거기 있으면 촬영에 방해돼요"

msgid "adv_201201_0011_msg"
msgstr "정말.\\n오늘은 민메이가 출연하는 영화 촬영이라고\\n몇 번이나 말했잖아요"

msgid "adv_201201_0012_msg"
msgstr "하지만 영화 촬영은\\n마크로스 메인 브리지에서 하는 거잖아?"

msgid "adv_201201_0013_msg"
msgstr "웬만한 배우들보다\\n이곳을 훨씬 잘 아는 우리가\\n배경에 더 자연스럽게 어울리지 않겠어?"

msgid "adv_201201_0014_msg"
msgstr "그런 건가요"

msgid "adv_201201_0016_msg"
msgstr "포커 소령님 말씀이 맞아, 히카루!"

msgid "adv_201201_0017_msg"
msgstr "이 영화 감독님은 말이야,\\n리얼리티를 중요하게 생각하는 영화를\\n찍고 싶어 한대"

msgid "adv_201201_0018_msg"
msgstr "진짜 마크로스의 브리지를 빌린 것도\\n그 때문…이니까"

msgid "adv_201201_0019_msg"
msgstr "『이왕이면 진짜 군인분들에게도\\n협조를 부탁해보면 어떨까요?』라고\\n내가 제안해뒀어"

msgid "adv_201201_0020_msg"
msgstr "오오! 역시 민메이야!"

msgid "adv_201201_0021_msg"
msgstr "그렇게 정해졌으면\\n바로 감독한테 이야기하러 가볼까"

msgid "adv_201201_0023_msg"
msgstr "히카루도 영화에 출연해보지 않을래?"

msgid "adv_201201_0024_msg"
msgstr "에엣? 난 됐어.\\n선배랑 달리 그런 성격도 아니고…"

msgid "adv_201201_0025_msg"
msgstr "…그나저나,\\n오늘 민메이 의상 정말 잘 어울리네"

msgid "adv_201201_0026_msg"
msgstr "칭찬해주시니 영광입니다. 이치죠 중위님"

msgid "adv_201201_0027_msg"
msgstr "하하, 경례도 제법 늘었잖아"

msgid "adv_201201_0028_msg"
msgstr "고마워.\\n현역 여성 군인분에게\\n연기 지도를 받은 덕분이지"

msgid "adv_201201_0029_msg"
msgstr "현역 여성 군인?\\n…설마"

msgid "adv_201201_0031_msg"
msgstr "민메이 씨"

msgid "adv_201201_0032_msg"
msgstr "미사 씨!"

msgid "adv_201201_0033_msg"
msgstr "경례하는 거 봤어요. 흠잡을 데 없네요"

msgid "adv_201201_0034_msg"
msgstr "와…! 감사합니다!"

msgid "adv_201201_0035_msg"
msgstr "그렇군. 하야세 대위에게\\n연기 지도를 받은 거였나"

msgid "adv_201201_0036_msg"
msgstr "제가 평소에 하는 걸 가르쳐드렸을 뿐이지만…\\n도움이 됐다면 기쁘네요"

msgid "adv_201201_0037_msg"
msgstr "…그런데\\n포커 소령님은 감독님과 무슨 얘기를 하고 있는 거예요?"

msgid "adv_201201_0038_msg"
msgstr "영화에 출연하게 해달라고\\n직접 담판 지으러 간 것 같아요"

msgid "adv_201201_0039_msg"
msgstr "정말. 촬영에 방해만은 하지 말라고\\n그렇게나 말해뒀는데…"

msgid "adv_201201_0040_msg"
msgstr "…! 맞다!\\n미사 씨도 영화에 출연하지 않을래요?"

msgid "adv_201201_0041_msg"
msgstr "네?"

msgid "adv_201201_0042_msg"
msgstr "미사 씨 예쁘시고, 현역 군인이시잖아요.\\n감독님께 부탁하면 대사도 받을 수 있을지도 몰라요!"

msgid "adv_201201_0043_msg"
msgstr "제가 잠깐 얘기하고 올게요!"

msgid "adv_201201_0045_msg"
msgstr "앗, 잠깐만요 민메이 씨!"

msgid "adv_201201_0046_msg"
msgstr "말도 안 돼! 내가 영화에 출연한다니…!"

msgid "adv_201201_0047_msg"
msgstr "괜찮지 않아요?"

msgid "adv_201201_0048_msg"
msgstr "정말! 남의 일이라고 신났네요!"

msgid "adv_201201_0049_msg"
msgstr "그런 거 아니에요"

msgid "adv_201201_0050_msg"
msgstr "정말… 쓸데없이 시간 보낼 여유가 있으면,\\n민메이 씨 라이브 준비나\\n도와주는 게 어때?"

msgid "adv_201201_0051_msg"
msgstr "네… 제가요?"

msgid "adv_201201_0052_msg"
msgstr "당연하죠"

msgid "adv_201201_0053_msg"
msgstr "…사람 참 막 부리네"

msgid "adv_201202_0008_msg"
msgstr "하아…"

msgid "adv_201202_0009_msg"
msgstr "미사 씨.\\n촬영 수고하셨어요!"

msgid "adv_201202_0010_msg"
msgstr "민메이 씨도 수고했어요…"

msgid "adv_201202_0011_msg"
msgstr "저, 너무 긴장해서…\\n그런 식으로 해도 괜찮았을까요?"

msgid "adv_201202_0012_msg"
msgstr "물론이죠!\\n감독님도 극찬하셨어요!"

msgid "adv_201202_0013_msg"
msgstr "미사 씨, 감독님 마음에 들어서\\n배우로 데뷔하게 되는 거 아니에요?"

msgid "adv_201202_0014_msg"
msgstr "이제 그만 좀 해줘.\\n어제부터 계속 치켜세워져서\\n아무래도 부끄럽단 말이야"

msgid "adv_201202_0015_msg"
msgstr "…그나저나 민메이 씨는 늘\\n이렇게 힘든 일을 하고 있었군요"

msgid "adv_201202_0016_msg"
msgstr "수많은 사람들의 시선을 받으며 조명을 받고.\\n그 속에서 노래하거나 연기를 하고"

msgid "adv_201202_0017_msg"
msgstr "긴장하기는커녕\\n수많은 사람들을 즐겁게 하고, 감동까지 주다니…"

msgid "adv_201202_0018_msg"
msgstr "분명 누구나 할 수 있는 일은 아니겠죠.\\n당신을 진심으로 존경해요"

msgid "adv_201202_0019_msg"
msgstr "미사 씨…"

msgid "adv_201202_0020_msg"
msgstr "…저도 『배역으로서』이긴 하지만"

msgid "adv_201202_0021_msg"
msgstr "군인의 일을 체험해보고\\n미사 씨와 비슷한 생각을 했어요"

msgid "adv_201202_0022_msg"
msgstr "군인들은 우리 민간인을 지키기 위해\\n힘든 훈련을 해내고, 엄격한 규율을 지키고…\\n저 같은 사람은 도저히 계속할 수 없을 거예요"

msgid "adv_201202_0023_msg"
msgstr "미사 씨는 정말 대단한 여성이구나 하고\\n저, 새삼 느꼈어요"

msgid "adv_201202_0024_msg"
msgstr "그 일이 얼마나 힘든지는\\n직접 해보지 않으면 좀처럼 알 수 없으니까요"

msgid "adv_201202_0025_msg"
msgstr "그러네요.\\n저, 미사 씨의 일을 체험해볼 수 있어서\\n정말 좋았어요"

msgid "adv_201202_0026_msg"
msgstr "저도요. 당신 덕분에\\n귀중한 경험을 할 수 있었어요"

msgid "adv_201202_0027_msg"
msgstr "고마워요, 민메이 씨"

msgid "adv_201202_0028_msg"
msgstr "저야말로요!\\n연기 지도까지 해주셔서\\n정말 감사합니다!"

msgid "adv_201202_0030_msg"
msgstr "어이~ 민메이.\\n라이브 준비가 끝났대"

msgid "adv_201202_0031_msg"
msgstr "오늘 밤은 촬영에 협조해준 답례로\\n다들한테 한 곡 들려주는 거지?"

msgid "adv_201202_0032_msg"
msgstr "응! 바로 갈게"

msgid "adv_201202_0033_msg"
msgstr "그럼 미사 씨, 먼저 실례할게요"

msgid "adv_201202_0034_msg"
msgstr "다녀와요.\\n무대, 저도 보러 갈게요"

msgid "adv_201202_0035_msg"
msgstr "네!"

msgid "adv_201202_0037_msg"
msgstr ""

msgid "adv_201202_0038_msg"
msgstr "긴장했다는 것치고는\\n표정이 꽤 좋아 보이는데요, 하야세 대위님?"

msgid "adv_201202_0039_msg"
msgstr "!?\\n그, 그렇지 않거든?"

msgid "adv_201202_0040_msg"
msgstr "평소보다 입꼬리가 올라가 있는데요?"

msgid "adv_201202_0041_msg"
msgstr "뭐니 뭐니 해도\\n사실 조금은 즐기셨던 거죠.\\n잠깐이나마 배우가 된 기분을"

msgid "adv_201202_0042_msg"
msgstr "농담은 그만해줘.\\n…자, 업무로 돌아가자"

msgid "adv_201202_0043_msg"
msgstr "영화 촬영은 끝났어.\\n이제부터는 평소대로 경계 임무를 해야 해"

msgid "adv_201202_0044_msg"
msgstr "당신도 얼른 자기 위치로 돌아가.\\n알겠지?"

msgid "adv_201202_0045_msg"
msgstr "네네.\\n알고 있다니까요~"

msgid "adv_201202_0047_msg"
msgstr "…본인은 모르는 건가.\\n촬영 중인 대위님, 딴 사람처럼 반짝반짝했는데"

msgid "adv_201202_0048_msg"
msgstr "배우 하야세 대위라…"

msgid "adv_301101_0003_msg"
msgstr "란카,\\n초시공 유닛 라이브 얘기는 들었지?"

msgid "adv_301101_0004_msg"
msgstr "들었어요!\\n셰릴 씨나 밀레느 일행과 함께\\n라이브를 할 수 있다니 기뻐요…!"

msgid "adv_301101_0005_msg"
msgstr "응, 나도 그래.\\n게다가 이번에는 Fire Bomber와의 크로스오버 라이브잖아.\\n대규모 라이브가 될 거야"

msgid "adv_301101_0006_msg"
msgstr "…확실히 마크로스7 함내에서도 멸망의 노래 영향이\\n큰 곳에서 개최되는 거죠"

msgid "adv_301101_0007_msg"
msgstr "응. 초시공 유닛 라이브라면 더 높은 효과를 기대할 수 있어.\\n…마크로스7 사람들에게도 우리 노래를\\n확실히 전해줘야겠네"

msgid "adv_301101_0009_msg"
msgstr "셰릴, 란카"

msgid "adv_301101_0010_msg"
msgstr "알토!"

msgid "adv_301101_0011_msg"
msgstr "알토 군!"

msgid "adv_301101_0012_msg"
msgstr "둘 다 이번엔 꽤 의욕이 넘치네"

msgid "adv_301101_0013_msg"
msgstr "당연하지. 존경하는 사람들과 함께 노래하는 거잖아.\\n물론 그렇다고 질 수는 없지만"

msgid "adv_301101_0014_msg"
msgstr "그럼 준비하러 갈게.\\n가자, 란카"

msgid "adv_301101_0015_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_301101_0017_msg"
msgstr "초시공 유닛 라이브라…"

msgid "adv_301101_0019_msg"
msgstr "잠깐, 알토!"

msgid "adv_301101_0020_msg"
msgstr "밀레느!?"

msgid "adv_301101_0021_msg"
msgstr "셰릴이랑 란카라면\\n지금 준비하러 갔으니까 조금만 기다려줘"

msgid "adv_301101_0022_msg"
msgstr "그럼 마침 잘됐네!\\n처음부터 알토한테 볼일이 있었거든!"

msgid "adv_301101_0023_msg"
msgstr "나한테…?"

msgid "adv_301101_0024_msg"
msgstr "응, 맞아!\\n사실 알토한테 부탁할 게 하나 있는데…"

msgid "adv_301101_0025_msg"
msgstr "부탁…?"

msgid "adv_301101_0026_msg"
msgstr "…그래서, 그 부탁이라는 게 뭔데"

msgid "adv_301101_0028_msg"
msgstr "기다렸지, 알토 군!\\n의상 갈아입고 왔어"

msgid "adv_301101_0029_msg"
msgstr "꽤 괜찮은 의상이네.\\n그런데 왜 갑자기 의상을 바꿔달라고 한 거야?"

msgid "adv_301101_0030_msg"
msgstr "나도 깜짝 놀랐어!\\n갑자기 왜 그러지 했는데…"

msgid "adv_301101_0031_msg"
msgstr "보통이라면 라이브 직전에 의상을 바꾸진 않지만,\\n이번엔 원래 준비했던 의상보다 곡에 더 잘 어울릴 것 같아서\\n바꾼 거야"

msgid "adv_301101_0032_msg"
msgstr "이유 정도는 제대로 설명해주겠지?"

msgid "adv_301101_0033_msg"
msgstr "…뭐, 모처럼 하는 라이브니까"

msgid "adv_301101_0034_msg"
msgstr "그게 이유야?\\n흐음… 조금 수상한데"

msgid "adv_301101_0035_msg"
msgstr "…뭐야, 안 기쁜 거야?"

msgid "adv_301101_0036_msg"
msgstr "그, 그런 말 안 했잖아!"

msgid "adv_301101_0037_msg"
msgstr "정말 귀여운 의상이야!\\n고마워, 알토 군!"

msgid "adv_301101_0038_msg"
msgstr "…아, 그래"

msgid "adv_301101_0039_msg"
msgstr "…여러 가지 물어보고 싶은 건 있지만,\\n지금은 봐줄게"

msgid "adv_301101_0040_msg"
msgstr "그보다 더 집중해야 할 일이 있으니까"

msgid "adv_301101_0041_msg"
msgstr "대신 라이브가 끝나면 각오해!"

msgid "adv_301101_0042_msg"
msgstr "…하아, 마음대로 해"

msgid "adv_301101_0043_msg"
msgstr "그럼 가자! 란카!"

msgid "adv_301101_0044_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_301102_0008_msg"
msgstr "란카, 수고했어!\\n정말 멋진 노래였어"

msgid "adv_301102_0009_msg"
msgstr "감사합니다!\\n…그나저나 이렇게 큰 무대에\\n설 수 있었다니, 아직도 꿈만 같아요!"

msgid "adv_301102_0010_msg"
msgstr "어머, 그래? 당당하고 훌륭했어"

msgid "adv_301102_0011_msg"
msgstr "맞아, 란카!\\n이번 라이브, 둘 다 정말 대단했어!"

msgid "adv_301102_0012_msg"
msgstr "이 정도는 당연하지"

msgid "adv_301102_0013_msg"
msgstr "역시 은하의 요정, 셰릴 놈,\\n초시공 신데렐라, 란카 리네!"

msgid "adv_301102_0014_msg"
msgstr "게다가 두 사람이 내가 고른 의상을 입고,\\n내가 부탁한 노래까지 불러주다니… 정말 행복해!"

msgid "adv_301102_0015_msg"
msgstr "아니야, 우리가 더 고맙지!\\n이 멋진 의상 덕분에,\\n정말 두근거리는 라이브가 됐어!"

msgid "adv_301102_0016_msg"
msgstr "다행이다~! 둘한테 잘 어울릴까 싶어서,\\n레이랑 비히다한테도 많이 물어보면서 열심히 골랐거든!"

msgid "adv_301102_0017_msg"
msgstr "알토도 도와줘서 고마워~!"

msgid "adv_301102_0019_msg"
msgstr "그래"

msgid "adv_301102_0020_msg"
msgstr "다음엔 거짓말하는 연습도 좀 더 해둬?"

msgid "adv_301102_0021_msg"
msgstr "쓸데없는 참견이야"

msgid "adv_301102_0022_msg"
msgstr "알토는 분명 다음에도 도와줄 거야.\\n의외로 상냥하잖아!"

msgid "adv_301102_0023_msg"
msgstr "너무 높게 평가하는 거야"

msgid "adv_301102_0024_msg"
msgstr "…그래도 정말 고마워.\\n마크로스7 선단을 위해 협력해줘서 정말 기뻤어"

msgid "adv_301102_0025_msg"
msgstr "그럼 다음엔 프론티어에서 함께\\n노래하자!"

msgid "adv_301102_0026_msg"
msgstr "정말~!?"

msgid "adv_301102_0028_msg"
