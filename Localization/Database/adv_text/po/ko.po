msgid "adv_100502_0010_msg"
msgstr ""

msgid "adv_100502_0011_msg"
msgstr "란카?"

msgid "adv_100502_0012_msg"
msgstr "…그 손에 든 종이비행기, 우리가 봤던\\n기억 속의 종이비행기랑 닮았네"

msgid "adv_100502_0013_msg"
msgstr "네, 아까 어디선가 날아왔어요.\\n그 기억을 보고 나니까 왠지 너무 소중한 물건처럼\\n느껴져서…"

msgid "adv_100502_0014_msg"
msgstr "…그러게"

msgid "adv_100502_0015_msg"
msgstr "하지만 그 기억은 우리 세계의 기억이 아니야.\\n너무 신경 쓰면 안 돼"

msgid "adv_100502_0016_msg"
msgstr "…셰릴 씨는 강하시네요.\\n저도 본받아야겠어요!"

msgid "adv_100502_0017_msg"
msgstr "난 셰릴 놈이니까.\\n이 정도 일로 흔들리진 않아"

msgid "adv_100502_0018_msg"
msgstr "게다가 이 세계에서도 반드시 똑같은 일이 일어난다고\\n정해진 것도 아니잖아"

msgid "adv_100502_0019_msg"
msgstr "비슷한 상황이 되더라도 어쩌면\\n바꿀 수 있을지도 모르고…"

msgid "adv_100502_0020_msg"
msgstr "…기억 속의 알토도"

msgid "adv_100502_0021_msg"
msgstr "네!"

msgid "adv_100502_0022_msg"
msgstr "…아! 셰릴 씨, 보세요!\\n저기 날고 있는 거 알토 군 맞죠?"

msgid "adv_100502_0023_msg"
msgstr "아주 기분 좋게 날고 있네…\\n이쪽 마음도 모르고"

msgid "adv_100502_0024_msg"
msgstr "후훗, 즐거워 보이네요"

msgid "adv_100502_0025_msg"
msgstr "정말…\\n뭐, 저게 알토답긴 하지"

msgid "adv_100502_0026_msg"
msgstr "자, 란카!\\n오늘도 최고의 라이브를 해서 모두의 기억을 되찾는 거야"

msgid "adv_100502_0027_msg"
msgstr "준비됐어?"

msgid "adv_100502_0028_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_200501_0010_msg"
msgstr "셰릴 씨, 슬슬 Fire Bomber 여러분의\\n무대가 시작돼요!"

msgid "adv_200501_0011_msg"
msgstr "응, 기대되네!\\n뭐, 화면으로만 봐야 한다는 게 조금 아쉽긴 하지만"

msgid "adv_200501_0012_msg"
msgstr "그나저나 크로스오버 라이브라니 대단하네요!\\nFire Bomber 여러분의 라이브를 볼 수 있다니!"

msgid "adv_200501_0013_msg"
msgstr "오빠도 좋아하겠다…"

msgid "adv_200501_0014_msg"
msgstr "그러게, 각 시공을 네트워크로 연결해서,\\n라이브를 생중계한다니 쉽게 할 수 있는 일이 아니지"

msgid "adv_200501_0015_msg"
msgstr "하지만 밀레느 일행의 라이브 영상이\\n이쪽에 일방적으로 송출되기만 하는 건 아쉽네.\\n아직 개발 중이라니 어쩔 수 없지만"

msgid "adv_200501_0016_msg"
msgstr "멸망의 노래 영향으로 뒤틀린 시공을 이용한다고 들었어요.\\n보고 싶었던 사람들의 라이브를 볼 수 있는 게 멸망의 노래 영향\\n덕분이라니 왠지 복잡한 기분이네요…"

msgid "adv_200501_0017_msg"
msgstr "그래도 이게 더 발전하면 노래의 힘을 합쳐서,\\n더 많은 사람들의 기억을 되찾을 방법을 찾을 수 있을지도 몰라"

msgid "adv_200501_0018_msg"
msgstr "그러게요! 정말 그렇게 되면 좋겠어요"

msgid "adv_200501_0019_msg"
msgstr "그럼 밀레느랑 바사라한테 응원 메시지라도 보내볼까?"

msgid "adv_200501_0020_msg"
msgstr "네!"

msgid "adv_200501_0022_msg"
msgstr "아, 란카랑 셰릴한테 메시지가 왔네.\\n둘 다 기대하고 있는 것 같아"

msgid "adv_200501_0023_msg"
msgstr "아, 민메이 씨한테도… 후훗!"

msgid "adv_200501_0024_msg"
msgstr "…다들 응원해주고 있는데\\n바사라는 대체 어디 간 거야"

msgid "adv_200501_0025_msg"
msgstr "오늘은 중요한 크로스오버 라이브라고\\n그렇게 말했는데"

msgid "adv_200501_0026_msg"
msgstr "잠깐, 바사라!"

msgid "adv_200501_0028_msg"
msgstr "왜 그래, 밀레느"

msgid "adv_200501_0029_msg"
msgstr "여기 있었구나! 찾았잖아!"

msgid "adv_200501_0030_msg"
msgstr "라이브 전에 사라지지 말라고 늘 말하잖아?\\n오늘은…"

msgid "adv_200501_0031_msg"
msgstr "중요한 라이브잖아?"

msgid "adv_200501_0032_msg"
msgstr "뭐야, 제대로 알고 있잖아"

msgid "adv_200501_0033_msg"
msgstr "당연하지"

msgid "adv_200501_0034_msg"
msgstr "이 은하뿐만 아니라 다른 은하 녀석들에게도\\n우리 노래를 들려줄 수 있다는 거니까"

msgid "adv_200501_0035_msg"
msgstr "불타오르는데!"

msgid "adv_200501_0036_msg"
msgstr "그래, 모두에게 Fire Bomber의 매력을 전해야지!"

msgid "adv_200501_0037_msg"
msgstr "은하를 넘어, 우리 노래를 들어!"

msgid "adv_200502_0009_msg"
msgstr "크로스오버 라이브, 대성공해서\\n정말 다행이야!"

msgid "adv_200502_0010_msg"
msgstr "셰릴과 란카의 무대는 귀엽고 멋져서 최고였고,\\n민메이 씨 무대는 넋을 놓고 보게 되고…"

msgid "adv_200502_0011_msg"
msgstr "같은 동료인데도 각자 이렇게나 다르구나 싶어서\\n감동해버렸어!"

msgid "adv_200502_0012_msg"
msgstr "그래, 다른 녀석들의 노래를 듣는 것도 나쁘지 않네.\\n란카랑 셰릴, 민메이의 뜨거운 하트가 전해졌어"

msgid "adv_200502_0013_msg"
msgstr "언젠가 Fire Bomber의 노래를 다 같이 부를 수 있으면 좋겠다"

msgid "adv_200502_0014_msg"
msgstr "예를 들면 셰릴이 부르는 돌격 러브하트라든가…\\n분명 멋질 것 같아!"

msgid "adv_200502_0015_msg"
msgstr "아니면 바사라가 부르는 성간비행이라든가?\\n…조금 재밌을 것 같아!"

msgid "adv_200502_0016_msg"
msgstr "뭘 그렇게 실실 웃고 있어?"

msgid "adv_200502_0017_msg"
msgstr "하트가 담긴 노래라면 어떤 노래든 상관없잖아"

msgid "adv_200502_0018_msg"
msgstr "그보다 밀레느, 레이가 밥 먹으러 간대.\\n엄청 매운 카레면 되지?"

msgid "adv_200502_0019_msg"
msgstr "또 그 카레!? 이번에는 피자로 하자!"

msgid "adv_200502_0020_msg"
msgstr "빨리 와, 두고 간다"

msgid "adv_200502_0021_msg"
msgstr "기다려! 아직 얘기 안 끝났잖아!"

msgid "adv_200502_0022_msg"
msgstr "정말… 어라? 메시지가 왔네.\\n후훗, 다들 즐거워한 것 같아서 다행이다"

msgid "adv_200502_0023_msg"
msgstr "어디 보자, 『다음에는 나도 다들 노래를 불러보고 싶어』… 됐다!"

msgid "adv_200502_0024_msg"
msgstr "…이렇게 초시공 SNS로 대화할 수 있는 것도\\n멸망의 노래 영향으로 시공이 뒤틀렸기 때문이잖아"

msgid "adv_200502_0025_msg"
msgstr "그렇다는 건 멸망의 노래 영향이 사라지고\\n기억을 전부 되찾고 나면…"

msgid "adv_200502_0026_msg"
msgstr ""

msgid "adv_200502_0027_msg"
msgstr "…지금은 생각하지 말자"

msgid "adv_200502_0028_msg"
msgstr "아, 비히다! 바사라랑 레이가 밥 먹으러 간대!\\n같이 가자!"

msgid "adv_300401_0008_msg"
msgstr "미쿠모, 크리스마스트리 장식은 다 했어?"

msgid "adv_300401_0009_msg"
msgstr "그래. 그나저나 꽤 공들인 파티네.\\n흥미로워"

msgid "adv_300401_0010_msg"
msgstr "크리스마스 분위기를 느낄 수 있어서 좋지?\\n미쿠모가 올 줄 몰랐어서 척 군 일행도 신이 났었어"

msgid "adv_300401_0011_msg"
msgstr "…후훗, 와줘서 기뻐"

msgid "adv_300401_0012_msg"
msgstr "깊은 뜻은 없어. 그냥 크리스마스가 어떤 건지 알고 싶었을 뿐이야"

msgid "adv_300401_0013_msg"
msgstr "그래… 오늘은 다 같이 즐기자!"

msgid "adv_300401_0014_msg"
msgstr "후훗, 하야테랑 프레이아가 다투고 있는 것 같네"

msgid "adv_300401_0015_msg"
msgstr ""

msgid "adv_300401_0016_msg"
msgstr "곤란하네… 이런 때까지 싸우다니"

msgid "adv_300401_0018_msg"
msgstr "산타는 있어!"

msgid "adv_300401_0019_msg"
msgstr "없다니까"

msgid "adv_300401_0020_msg"
msgstr "무~조건 있어!"

msgid "adv_300401_0021_msg"
msgstr "그러니까 없다니까"

msgid "adv_300401_0022_msg"
msgstr "…하아, 둘 다 이제 그만하세요"

msgid "adv_300401_0023_msg"
msgstr "하야테는 왜 그렇게 꿈 없는 소리를 하는 거야!?\\n산타는 있어! 그리고 양말 가득 사과를 받는 거야!"

msgid "adv_300401_0024_msg"
msgstr "하필 사과냐. 아니, 애초에 양말에 그렇게 많이 안 들어가잖아"

msgid "adv_300401_0025_msg"
msgstr "미라쥬 씨는 믿어요!? 산타클로스!"

msgid "adv_300401_0026_msg"
msgstr "네!? 저요? 저는, 그게…"

msgid "adv_300401_0028_msg"
msgstr "자~ 거기까지!"

msgid "adv_300401_0029_msg"
msgstr "자자, 둘 다! 이제 크리스마스 파티가 시작되는데\\n싸우면 안 되지~!"

msgid "adv_300401_0030_msg"
msgstr "마, 마키나 씨!?"

msgid "adv_300401_0031_msg"
msgstr "산타가 어쩌고저쩌고는 잘 모르겠지만\\n오늘은 내가 산타가 되어줄 테니까, 싸움은 끝!"

msgid "adv_300401_0032_msg"
msgstr "…그런 문제인가?"

msgid "adv_300401_0034_msg"
msgstr "크리스마스 한정 산타클로스풍 마키나…"

msgid "adv_300401_0035_msg"
msgstr "최고…"

msgid "adv_300401_0036_msg"
msgstr "그럼 자! 프레프레도 하야하야도 가자!\\n파티 시작하겠다?"

msgid "adv_300401_0037_msg"
msgstr "오늘 밤은 꿈이 가득한 크리스마스니까,\\n마음껏 즐기지 않으면 손해야"

msgid "adv_300401_0038_msg"
msgstr "확실히 그러네…네엣!"

msgid "adv_300401_0039_msg"
msgstr "다 같이 최고의 크리스마스로 만들자~!"

msgid "adv_300401_0040_msg"
msgstr "기운 팍팍~!"

msgid "adv_300402_0009_msg"
msgstr "프레이아, 이런 데 있었냐"

msgid "adv_300402_0010_msg"
msgstr "언제까지 눈 가지고 놀 거야?\\n슬슬 디저트 케이크를 나눈다던데"

msgid "adv_300402_0011_msg"
msgstr "그래도 조금만 더 놀아두지 않으면\\n아까운 것 같단 말이지"

msgid "adv_300402_0012_msg"
msgstr "헤에, 그런 건가"

msgid "adv_300402_0013_msg"
msgstr "고마워, 하야테!"

msgid "adv_300402_0014_msg"
msgstr "눈, 마음에 들어?"

msgid "adv_300402_0015_msg"
msgstr "엄청 팍팍!"

msgid "adv_300402_0016_msg"
msgstr "오늘 카오스 사람들이랑 한 파티,\\n정말 즐거웠어!"

msgid "adv_300402_0017_msg"
msgstr "마키나 씨한테 크리스마스 선물도 받고,\\n미쿠모 씨가 크리스마스 노래도 불러주고…"

msgid "adv_300402_0018_msg"
msgstr "우히히히…"

msgid "adv_300402_0019_msg"
msgstr "셰릴 씨랑 란카 씨, 민메이 씨랑 다른 사람들은\\n어떤 크리스마스를 보냈을까?"

msgid "adv_300402_0020_msg"
msgstr "언젠가 다~ 같이 모일 수 있으면\\n엄청 재밌을 것 같아!"

msgid "adv_300402_0021_msg"
msgstr "…재밌다기보다 엄청난 일이 될 것 같은데"

msgid "adv_300402_0022_msg"
msgstr "뭐… 연락해보면 어때?\\nS.M.S. 녀석들도 오늘은 신나게 놀고 있는 것 같던데"

msgid "adv_300402_0023_msg"
msgstr "바사라 일행은 평소처럼 라이브 중일지도 모르지만"

msgid "adv_300402_0024_msg"
msgstr "그러네!\\n…아, 미라쥬 씨!"

msgid "adv_300402_0026_msg"
msgstr "…읏!"

msgid "adv_300402_0027_msg"
msgstr "이런 데서 뭐 하고 있어요… 그런데\\n미라쥬 씨, 눈이 좀 빨간 것 같은데…"

msgid "adv_300402_0028_msg"
msgstr "아, 아무것도 아닙니다.\\n…그냥 제가 만든 눈사람을 보러 왔을 뿐이에요"

msgid "adv_300402_0029_msg"
msgstr "…? 그럼 됐지만…"

msgid "adv_300402_0030_msg"
msgstr "그보다 자, 다들 있는 곳으로 가죠.\\n미쿠모 씨 일행도 기다리고 있어요"

msgid "adv_300402_0031_msg"
msgstr "그래"

msgid "adv_300402_0032_msg"
msgstr "네엣!"

msgid "adv_100601_0007_msg"
msgstr "카운트다운 라이브, 이제 곧 시작이네.\\n반드시 성공시키자, 란카"

msgid "adv_100601_0008_msg"
msgstr "네, 셰릴 씨!\\n회의도 리허설도 완벽하니까 분명 괜찮을 거예요!"

msgid "adv_100601_0009_msg"
msgstr "후훗, 그러게"

msgid "adv_100601_0010_msg"
msgstr "…그나저나 시간은 정말 눈 깜짝할 사이에 흐르네.\\n올해도 정말 여러 일이 있었어"

msgid "adv_100601_0011_msg"
msgstr "여러 곳에서 라이브를 하며 모두의 기억을\\n되찾았던 것도 있지만, 여름에는 수영복으로 촬영도 했고…\\n그런 즐거운 추억도 많이 생겼네"

msgid "adv_100601_0012_msg"
msgstr "아! 그거 알토 군이 전에 얘기했던 거죠?\\n분명 비치볼이…"

msgid "adv_100601_0013_msg"
msgstr "맞아 맞아!\\n말다툼도 했지만 좋은 추억이 됐어"

msgid "adv_100601_0014_msg"
msgstr "저도 추억이 잔뜩이에요!\\n할로윈 라이브 때는 정말 깜짝 놀랐었죠"

msgid "adv_100601_0015_msg"
msgstr "레이나 씨가 준비한 연출이 제 라이브에도 반영돼버려서…\\n귀여운 호박이 잔뜩 날아다녔거든요"

msgid "adv_100601_0016_msg"
msgstr "처음에는 누가 한 짓인지 몰라서,\\n브레라가 필사적으로 범인을 찾았었지"

msgid "adv_100601_0017_msg"
msgstr "그리고 또…"

msgid "adv_100601_0018_msg"
msgstr "Fire Bomber와의 크로스오버 라이브!\\n역시 그들은 대단해. 공연장이 순식간에 뜨거워졌던 게 기억나"

msgid "adv_100601_0019_msg"
msgstr "민메이 씨도 함께해서 정말 엄청 신났었죠!"

msgid "adv_100601_0020_msg"
msgstr "…그러고 보니 오늘은 민메이 씨도 왈큐레 여러분도\\n카운트다운 라이브를 한다고 했었죠"

msgid "adv_100601_0021_msg"
msgstr "Fire Bomber도 말이지.\\n그래서 조금 재미있는 생각이 났는데…"

msgid "adv_100601_0022_msg"
msgstr "재미있는 생각이요?"

msgid "adv_100601_0023_msg"
msgstr "응, 곡을 하나 정해서 그 같은 곡을 다 같이 부르는 건 어때?\\n각자의 차이나 개성이 확실히 드러나서 재미있을 것 같지 않아?"

msgid "adv_100601_0024_msg"
msgstr "와, 확실히 재미있을 것 같아요!\\n올해 마지막을 장식하기에 딱 좋은 특별한 라이브가 될 것 같아요!"

msgid "adv_100601_0025_msg"
msgstr "그렇지? 바로 초시공 SNS로 연락해야겠어!"

msgid "adv_100601_0026_msg"
msgstr "다 같이 한 곡을… 그런데 어떤 곡이 좋을까?"

msgid "adv_100601_0027_msg"
msgstr "음… 뜨겁게 달아오를 수 있는 곡이 좋겠지"

msgid "adv_100601_0028_msg"
msgstr "그러게… 라이온은 어떨까?"

msgid "adv_100602_0009_msg"
msgstr "우리가 직접 부르는 것도 좋지만,\\n역시 셰릴 씨와 란카 씨의 라이온에는 못 당하겠네"

msgid "adv_100602_0010_msg"
msgstr "기운 팍팍~!"

msgid "adv_100602_0011_msg"
msgstr "그래도 정말 기억에 남는 라이브가 됐지~!\\n그건 셰리셰리와 란란한테 감사해야겠어!"

msgid "adv_100602_0012_msg"
msgstr "슬슬 카운트다운 라이브도 막바지네. 다들 준비됐어?"

msgid "adv_100602_0013_msg"
msgstr "네엣!"

msgid "adv_100602_0014_msg"
msgstr "올해는 잔~뜩 노래했으니까, 내년에는 더~ 많이 노래하고 싶어!"

msgid "adv_100602_0016_msg"
msgstr "쌓인 피로는 올해 안에 풀어두렴"

msgid "adv_100602_0017_msg"
msgstr "한 해 동안 수고 많았어. 내년에도 잘 부탁할게"

msgid "adv_100602_0019_msg"
msgstr "연말에는 다 같이 코타츠에서 새근새근 잘 거야~"

msgid "adv_100602_0020_msg"
msgstr "해넘이 해파리 소바, 다 같이 먹자"

msgid "adv_100602_0022_msg"
msgstr "올해도 한 해 열심히 했다! 내년에도 노래할 거야~!"

msgid "adv_100602_0023_msg"
msgstr "내년에도 실컷 노래해주겠어~!"

msgid "adv_100602_0025_msg"
msgstr "벌써 한 해가 끝나는구나… 있잖아, 나와의 추억 잊지 말아줘?"

msgid "adv_100602_0027_msg"
msgstr "올해도 이제 곧 끝나네… 왠지 쓸쓸하다"

msgid "adv_100602_0028_msg"
msgstr "올해도 즐거웠지. 내년엔 더 신나게 가는 거야!"

msgid "adv_100602_0029_msg"
msgstr "자, 카운트다운을 시작하자!"

msgid "adv_100602_0030_msg"
msgstr "네!"

msgid "adv_100701_0008_msg"
msgstr "란카. 슬슬 뉴이어 라이브가 시작될 거야"

msgid "adv_100701_0009_msg"
msgstr "아, 브레라 씨! 새해 복 많이 받으세요!"

msgid "adv_100701_0010_msg"
msgstr "새해 복 많이…\\n그건 새해에 하는 특별한 인사였지"

msgid "adv_100701_0011_msg"
msgstr "네, 새해를 축하하는 말이에요!"

msgid "adv_100701_0012_msg"
msgstr "그렇군"

msgid "adv_100701_0013_msg"
msgstr "…란카, 새해 복 많이 받아"

msgid "adv_100701_0014_msg"
msgstr "이렇게 하면 맞나?"

msgid "adv_100701_0015_msg"
msgstr "후훗! 네, 완벽해요!"

msgid "adv_100701_0016_msg"
msgstr "그런데 뭘 그렇게 기쁜 표정으로 보고 있었지?"

msgid "adv_100701_0017_msg"
msgstr "설날에 다 같이 새해 첫 참배를 갔거든요.\\n그때 찍은 데이터를 보고 있었어요…"

msgid "adv_100701_0018_msg"
msgstr "새해 첫 참배…"

msgid "adv_100701_0019_msg"
msgstr "다 같이 기모노를 입을 기회는 좀처럼 없고…\\n새해 분위기를 제대로 느꼈다고 해야 하나"

msgid "adv_100701_0020_msg"
msgstr "기모노…"

msgid "adv_100701_0021_msg"
msgstr "보세요, 나나랑 루카 군도 제대로 찍혔어요!"

msgid "adv_100701_0022_msg"
msgstr "아! 이건 알토 군의 기모노 차림!\\n정말 잘 어울려서 부러웠는데… 아마 설날에만 볼 수 있겠죠"

msgid "adv_100701_0023_msg"
msgstr ""

msgid "adv_100701_0024_msg"
msgstr "…앗, 죄송해요!\\n저도 모르게 너무 빠져버려서…"

msgid "adv_100701_0025_msg"
msgstr "…아니, 네가 즐거워 보이면 그걸로 됐어"

msgid "adv_100701_0026_msg"
msgstr "에헤헤, 고마워요.\\n다음에는 브레라 씨도 같이 가요!"

msgid "adv_100701_0027_msg"
msgstr "…그래"

msgid "adv_100701_0029_msg"
msgstr "란카, 잠깐 괜찮아?"

msgid "adv_100701_0030_msg"
msgstr "알토 군! 새해 복 많이 받아!"

msgid "adv_100701_0031_msg"
msgstr "…사오토메 알토"

msgid "adv_100701_0032_msg"
msgstr "뭐야, 브레라도 있었냐"

msgid "adv_100701_0033_msg"
msgstr "무슨 일이지"

msgid "adv_100701_0034_msg"
msgstr "아니, 셰릴을 찾고 있었어"

msgid "adv_100701_0035_msg"
msgstr "자기가 불러놓고는 어디에도 없잖아.\\n…정말, 어디 간 거야"

msgid "adv_100701_0036_msg"
msgstr "셰릴 씨라면 대기실에 있지 않을까요?\\n새해에 딱 맞는 가사가 떠올랐다면서 엄청 집중하고 있었거든요"

msgid "adv_100701_0037_msg"
msgstr "…또야? 정말, 어쩔 수 없네"

msgid "adv_100701_0038_msg"
msgstr "볼일 끝났으면 얼른 가"

msgid "adv_100701_0039_msg"
msgstr "말 안 해도 그럴 거야.\\n그럼 또 보자, 란카. 라이브 힘내"

msgid "adv_100701_0040_msg"
msgstr "응, 고마워, 알토 군!"

msgid "adv_100701_0042_msg"
msgstr ""

msgid "adv_100701_0043_msg"
msgstr "…란카.\\n라이브가 끝나면 설날에 대해 알려주겠어?"

msgid "adv_100701_0044_msg"
msgstr "낯선 말이 많지만… 혼자 알아보는 것보다\\n사람에게 직접 물어보는 게 좋다고 하더군"

msgid "adv_100701_0045_msg"
msgstr "네, 물론이죠, 브레라 씨! 기대하세요?\\n알려드리기만 하는 게 아니라 설날다운 것도 잔뜩 해봐요!"

msgid "adv_100701_0046_msg"
msgstr "…그래"

msgid "adv_100702_0009_msg"
msgstr "…후훗"

msgid "adv_100702_0010_msg"
msgstr "어라, 카나카나, 무슨 일 있어?"

msgid "adv_100702_0011_msg"
msgstr "사실 란카 씨한테서 이미지 데이터가 왔어"

msgid "adv_100702_0012_msg"
msgstr "와, 브레브레랑 란란이다!\\n설날을 제대로 즐기고 있는 것 같네"

msgid "adv_100702_0013_msg"
msgstr "응. 설날에 대해 알려달라고 했다는데\\n뭐부터 알려줘야 할지 란카 씨가 상담해왔거든"

msgid "adv_100702_0014_msg"
msgstr "나도 제대로 답해주진 못했는데, 걱정할 필요 없었던 것 같아.\\n브레라 씨도 란카 씨도 정말 즐거워 보여"

msgid "adv_100702_0015_msg"
msgstr "이렇게 이미지 데이터로 보니까,\\n둘 다 사이좋은 남매처럼 보이네~!"

msgid "adv_100702_0016_msg"
msgstr "그보다 마키나, 의상으로 안 갈아입어도 돼?\\n슬슬 뉴이어 라이브 시작할 시간이야"

msgid "adv_100702_0017_msg"
msgstr "네네~! 서두를게요!"

msgid "adv_100702_0018_msg"
msgstr "그러고 보니 미쿠모랑 레이나랑… 프레이아는?\\n아까부터 안 보이는데"

msgid "adv_100702_0019_msg"
msgstr "세뱃돈을 받고 신기한 표정을 짓는\\n너무 귀여운 쿠모쿠모를 다 같이 관찰하고 있어!"

msgid "adv_100702_0020_msg"
msgstr "…후훗, 정말 사이좋다니까"

msgid "adv_100702_0021_msg"
msgstr "그런데 카나카나! 올해 목표는 정했어?"

msgid "adv_100702_0022_msg"
msgstr "그러게… 무엇보다 멸망의 노래 영향을 막아야겠지"

msgid "adv_100702_0023_msg"
msgstr "아직 구체적인 해결책은 없지만, 그래도\\n조금이라도 빨리 모두의 기억을 되찾고 싶어"

msgid "adv_100702_0024_msg"
msgstr "…그러게!"

msgid "adv_100702_0025_msg"
msgstr "그럼 다들 불러올게.\\n마키나도 준비 서둘러"

msgid "adv_100702_0026_msg"
msgstr "네~!"

msgid "adv_200601_0010_msg"
msgstr "…음"

msgid "adv_200601_0011_msg"
msgstr ""

msgid "adv_200601_0012_msg"
msgstr "…? 마키나 씨, 레이나 씨!\\n심각한 표정인데 무슨 일 있어요?"

msgid "adv_200601_0013_msg"
msgstr "…문제 발생"

msgid "adv_200601_0014_msg"
msgstr "무, 문제라고요!?"

msgid "adv_200601_0015_msg"
msgstr "프레프레, 얼마 전에 초시공 SNS가\\n해킹당할 뻔했던 건 알고 있어?"

msgid "adv_200601_0016_msg"
msgstr "그러고 보니 그런 얘기가 있었던 것 같은데…\\n분명 수상한 누군가가 초시공 SNS에 접속하려 했다는 얘기였죠?"

msgid "adv_200601_0017_msg"
msgstr "맞아 맞아! 물론 레이레이 덕분에 미리 막긴 했지만…\\n해킹하려던 범인의 정체를 도저히 알아낼 수 없었어"

msgid "adv_200601_0018_msg"
msgstr "하지만 최근에 드디어 단서를 찾았어"

msgid "adv_200601_0019_msg"
msgstr "오오! 역시 레이나 씨네요!"

msgid "adv_200601_0020_msg"
msgstr "그 단서가 다음에 열리는\\n미스 마크로스 콘테스트 회장에 있는 것 같아…"

msgid "adv_200601_0021_msg"
msgstr "미스 마크로스 콘테스트라면, 그 민메이 씨랑 란카 씨가\\n출전했던 콘테스트인가요!?"

msgid "adv_200601_0022_msg"
msgstr "응! …그렇다고 진짜 미스 마크로스 콘테스트는 아니고\\n어떤 별에서 열리는 작은 콘테스트야!"

msgid "adv_200601_0023_msg"
msgstr "어쨌든 범인에 대한 정보를 얻으려면,\\n거기에 잠입해야 하는데…"

msgid "adv_200601_0024_msg"
msgstr "잠입은 누가 하는 건가요? 미쿠모 씨라든가?"

msgid "adv_200601_0025_msg"
msgstr "…그 문제 때문에 조금 고민하고 있었어"

msgid "adv_200601_0026_msg"
msgstr ""

msgid "adv_200601_0027_msg"
msgstr "레이레이, 역시 걱정돼!\\n혼자 잠입한다니…"

msgid "adv_200601_0028_msg"
msgstr "이 정도는 문제없어"

msgid "adv_200601_0029_msg"
msgstr "하지만…!"

msgid "adv_200601_0030_msg"
msgstr "회장 어디에 단서가 있을지 모르는 이상,\\n참가자로서 내부에 잠입할 필요가 있어"

msgid "adv_200601_0031_msg"
msgstr "콘테스트에 출전할 수 있는 건 한 명뿐.\\n게다가 마키나를 위험하게 만들 순 없어"

msgid "adv_200601_0032_msg"
msgstr "레이레이…!"

msgid "adv_200601_0033_msg"
msgstr "마키나는 객석에서 지켜봐 줬으면 해.\\n반드시 성과를 내고 올게"

msgid "adv_200601_0034_msg"
msgstr "…응, 알겠어"

msgid "adv_200601_0035_msg"
msgstr "그럼…\\n엄청 귀여운 마키나 특제 의상으로 우승을 노려보자!"

msgid "adv_200601_0036_msg"
msgstr "우, 우승!?"

msgid "adv_200601_0037_msg"
msgstr "모처럼 이렇게 귀여운 레이레이가 콘테스트에 나가는 건데\\n우승하지 않으면 아쉽잖아!"

msgid "adv_200601_0038_msg"
msgstr "의상은 언젠가 이런 날이 오지 않을까 싶어서\\n사실 미리 준비해뒀지~!"

msgid "adv_200601_0039_msg"
msgstr "역시 마키나"

msgid "adv_200601_0040_msg"
msgstr "이제 남은 건 부를 곡… 그리고 경험자의 조언"

msgid "adv_200601_0041_msg"
msgstr "미스 마크로스 콘테스트에서 곡이라고 하면 역시 그거지!"

msgid "adv_200601_0042_msg"
msgstr "그리고… 조언을 부탁한다면 딱 맞는 사람이 있어!"

msgid "adv_200601_0043_msg"
msgstr "…누구지?"

msgid "adv_200601_0045_msg"
msgstr "어머? 마키나 씨한테 연락이 왔네…\\n어디 보자… 미스 마크로스 콘테스트에서 우승하려면\\n조언을 해달라고?"

msgid "adv_200601_0046_msg"
msgstr "어머… 레이나 씨가 내 노래를 불러주는구나! 기쁘네!"

msgid "adv_200601_0047_msg"
msgstr "제대로 본보기가 될지는 모르겠지만, 시험 삼아 한 곡 불러본 데이터를\\n마키나 씨 일행에게 보내볼까? 그게 더 빠를 것 같기도 하고…"

msgid "adv_200601_0048_msg"
msgstr "후훗, 그렇다면 열심히 해야겠네!"

msgid "adv_200602_0009_msg"
msgstr "레이레이, 수고했어~!\\n노래도 춤도 완벽했어!"

msgid "adv_200602_0010_msg"
msgstr "그 정도는 식은 죽 먹기"

msgid "adv_200602_0011_msg"
msgstr "레이나 씨, 수고하셨어요!\\n내 남자친구는 파일럿, 정말 좋았어요!"

msgid "adv_200602_0012_msg"
msgstr "그런데 레이나 씨!\\n왜 처음 인사할 때 마이크에 머리를 부딪치려고 한 거예요?"

msgid "adv_200602_0013_msg"
msgstr "그건 작전"

msgid "adv_200602_0014_msg"
msgstr "미스 마크로스 프론티어 때의\\n란카 재현"

msgid "adv_200602_0015_msg"
msgstr "근데 마이크 위치가 조금 높아서 안 부딪혔지.\\n레이레이 너무 귀여워~!"

msgid "adv_200602_0016_msg"
msgstr "본의 아니었어"

msgid "adv_200602_0017_msg"
msgstr "…그래서 레이레이,\\n뭔가 단서가 될 만한 건 있었어?"

msgid "adv_200602_0018_msg"
msgstr ""

msgid "adv_200602_0019_msg"
msgstr "…없었어"

msgid "adv_200602_0020_msg"
msgstr "역시 그렇지…"

msgid "adv_200602_0021_msg"
msgstr "저랑 마키나 씨도 이것저것 찾아봤지만,\\n수상한 건 못 찾았어요"

msgid "adv_200602_0022_msg"
msgstr "…헛수고"

msgid "adv_200602_0023_msg"
msgstr "레이나 씨…"

msgid "adv_200602_0024_msg"
msgstr "있잖아, 레이레이!\\n확실히 범인으로 이어질 단서는 못 찾았지만"

msgid "adv_200602_0025_msg"
msgstr "그래도 난 이렇게 귀여운 레이레이를 볼 수 있어서\\n좋았다고 생각해"

msgid "adv_200602_0026_msg"
msgstr "마키나…"

msgid "adv_200602_0027_msg"
msgstr ""

msgid "adv_200602_0028_msg"
msgstr "…마키나가 만족했다면 됐어"

msgid "adv_200602_0029_msg"
msgstr "…그리고 아직 방법이 완전히 사라진 것도 아니야"

msgid "adv_200602_0030_msg"
msgstr "범인에 대해 아직 자세히 확인하지 않은 정보가 몇 개 있어.\\n그쪽이 정답일 가능성도 남아 있어"

msgid "adv_200602_0031_msg"
msgstr "그럼 쿠모쿠모 일행한테도 도와달라고 해서\\n다른 정보들도 확인해보자~!"

msgid "adv_200602_0032_msg"
msgstr "저도 도울게요!"

msgid "adv_200602_0033_msg"
msgstr "그럼 라그나로 돌아갈까!\\n카나카나 일행한테도 귀여운 레이레이를 보여줘야지"

msgid "adv_200602_0034_msg"
msgstr "그러죠! 가요, 레이나 씨!"

msgid "adv_200602_0035_msg"
msgstr "…응"

msgid "adv_300501_0007_msg"
msgstr "알토! 드디어 왔네.\\n촬영이 조금 더 걸릴 것 같으니까 잠깐 기다려"

msgid "adv_300501_0008_msg"
msgstr "갑자기 불러놓고 기다리라니\\n대체 뭐냐고… 정말"

msgid "adv_300501_0009_msg"
msgstr "그나저나… 이번 의상도 또 대단하네"

msgid "adv_300501_0010_msg"
msgstr "어때? 잘 어울려?"

msgid "adv_300501_0011_msg"
msgstr "얼마 전에 초시공 SNS에서 레이나랑 마키나한테,\\n미스 마크로스 콘테스트에 잠입했다는 얘기를 들었거든"

msgid "adv_300501_0012_msg"
msgstr "그 잠입 조사 이야기에서 영감을 받아서\\n스파이풍으로 해봤어"

msgid "adv_300501_0013_msg"
msgstr "미쿠모한테도 이것저것 의견을 받았고"

msgid "adv_300501_0014_msg"
msgstr "미쿠모라면… 왈큐레의?"

msgid "adv_300501_0015_msg"
msgstr "응. 꽤 재미있는 사람이야.\\n신비롭고, 얘기하다 보면 여러모로 자극을 받는달까"

msgid "adv_300501_0016_msg"
msgstr "…그래도 이번에 제일 마음에 드는 건 사실 머리 모양이지만"

msgid "adv_300501_0017_msg"
msgstr "머리? 왜?"

msgid "adv_300501_0018_msg"
msgstr "정말, 둔하다니까!\\n잘 봐봐? 알토랑 똑같이 맞춘 거니까… 농담이야?"

msgid "adv_300501_0019_msg"
msgstr "뭐…!"

msgid "adv_300501_0020_msg"
msgstr "후훗! 알토, 혹시 부끄러운 거야?"

msgid "adv_300501_0021_msg"
msgstr "그럴 리가 없잖아!"

msgid "adv_300501_0022_msg"
msgstr "설마… 너, 일부러 그 말 하려고 나를 불러낸 거냐?"

msgid "adv_300501_0023_msg"
msgstr "그것도 있지만… 오늘 이 노래를 불렀을 때,\\n잠깐 알토랑 내가 같이 있는 광경이 보였거든"

msgid "adv_300501_0024_msg"
msgstr "정말 잠깐밖에 안 보여서 언제의 기억인지는\\n확실하지 않지만"

msgid "adv_300501_0025_msg"
msgstr "알토와도 뭔가 관련 있는 기억인가 싶어서\\n불러본 건데…"

msgid "adv_300501_0026_msg"
msgstr "…헤에, 그랬구나"

msgid "adv_300501_0027_msg"
msgstr "…그러고 보니 오늘 촬영하는 곡,\\n네 데뷔곡이지?"

msgid "adv_300501_0028_msg"
msgstr "…어머, 잘 알고 있네. 알아봤어?"

msgid "adv_300501_0029_msg"
msgstr "그럴 리가 있겠냐. 루카가 얘기하는 걸 들었을 뿐이야.\\n그나저나… 곡 이미지랑 꽤 다른 의상이네"

msgid "adv_300501_0030_msg"
msgstr "그러게… 내 데뷔곡은 뭐랄까\\n여러 일이 있었어. 결과는 좋았지만"

msgid "adv_300501_0031_msg"
msgstr "확실히 데뷔곡은 네가 만든 곡이 아니었지"

msgid "adv_300501_0032_msg"
msgstr "곡만 그런 게 아니야.\\n스타일링부터 창법까지 전부 프로듀스됐어"

msgid "adv_300501_0033_msg"
msgstr "데뷔곡이니까 어쩔 수 없다는 건 알았지만\\n납득하지 못했던 것도 사실이야"

msgid "adv_300501_0034_msg"
msgstr "그래서 이 의상을 고른 거야.\\n지금의 내가 표현하면 그 곡은 이렇게 된다는 걸\\n모두에게 보여주고 싶어"

msgid "adv_300501_0035_msg"
msgstr "셰릴 놈을 가장 잘 이해하는 건 셰릴 놈이니까"

msgid "adv_300501_0036_msg"
msgstr "그러니까 알토도 똑바로 보고 있어!\\n끝내주는 걸 보여줄 테니까"

msgid "adv_300501_0037_msg"
msgstr "…그래"

msgid "adv_300502_0006_msg"
msgstr ""

msgid "adv_300502_0009_msg"
msgstr "이미지를 뒤엎는다. 상상을 뛰어넘는다…"

msgid "adv_300502_0010_msg"
msgstr "미쿠모 씨! 또 혼자 멋대로 어디 가지 마세요!"

msgid "adv_300502_0011_msg"
msgstr "아무리 촬영 중이라도 언제 적이 습격해올지\\n모른다고요"

msgid "adv_300502_0012_msg"
msgstr "있잖아, 미라쥬"

msgid "adv_300502_0013_msg"
msgstr "네?"

msgid "adv_300502_0014_msg"
msgstr "넌 나한테 어떤 이미지를 가지고 있어?"

msgid "adv_300502_0015_msg"
msgstr "미쿠모 씨에 대해서… 말인가요?"

msgid "adv_300502_0016_msg"
msgstr "글쎄요… 신비롭다고 할까, 독특한 분위기를\\n지니고 있지만, 노래하려는 의지가 강한 분이에요"

msgid "adv_300502_0017_msg"
msgstr "…멋대로 어디 가버리거나,\\n사람을 놀리기도 하지만요"

msgid "adv_300502_0018_msg"
msgstr "후훗, 그렇구나…"

msgid "adv_300502_0019_msg"
msgstr "그런데 갑자기 왜 그런 걸 물으시는 거죠?"

msgid "adv_300502_0020_msg"
msgstr "깊은 뜻은 없어. 그냥 한번 물어보고 싶었을 뿐이야"

msgid "adv_300502_0021_msg"
msgstr "나는 노래만 할 수 있으면 그걸로 충분해. …하지만 이번에,\\n직접 의상을 골라보니 조금 신기한 기분이 들었어"

msgid "adv_300502_0022_msg"
msgstr "…그러고 보니 이번에는 미쿠모 씨가 직접 의상을\\n고르셨죠"

msgid "adv_300502_0023_msg"
msgstr "골랐다고 해도, 마키나가 준비해준 것들 중에서\\n눈에 띈 걸 하나 고른 것뿐이지만"

msgid "adv_300502_0024_msg"
msgstr "그런데 그것뿐인데도 평소보다\\n더 기분 좋게 노래한 것 같아"

msgid "adv_300502_0025_msg"
msgstr "의상을 고르고 싶다고 했을 때 다들 기뻐하던 표정도\\n나쁘지 않았고"

msgid "adv_300502_0026_msg"
msgstr "후훗… 그러네요.\\n카나메 씨도 마키나 씨도 정말 놀라셨죠"

msgid "adv_300502_0027_msg"
msgstr "자기 자신을 표현한다… 셰릴한테\\n흥미로운 걸 배웠어"

msgid "adv_300502_0028_msg"
msgstr "…역시 대단한 분이네요"

msgid "adv_300502_0029_msg"
msgstr "하지만 질 수는 없겠네"

msgid "adv_300502_0030_msg"
msgstr "네!"

msgid "adv_100801_0009_msg"
msgstr "이모님, 생신 축하드립니다…\\n이건 너무 평범하겠죠.\\n진심으로 축하드립니다!… 이건 너무 딱딱할까요?"

msgid "adv_100801_0010_msg"
msgstr "미라쥬 씨, 무슨 일 있어요?\\n아까부터 엄청 고민하는 것 같은데"

msgid "adv_100801_0011_msg"
msgstr "프, 프레이아!"

msgid "adv_100801_0012_msg"
msgstr "…사실 그게, 오늘은 이모님 생신이라서요.\\n초시공 SNS로 축하 인사를 보내려고 하는데,\\n어떻게 전해야 할지 고민돼서…"

msgid "adv_100801_0013_msg"
msgstr "이모님이라면… 밀레느 씨 말이에요?"

msgid "adv_100801_0014_msg"
msgstr "네… 하야테도 너무 고민한다고 했지만,\\n제게 이모님은 동경의 대상이에요. 그래서 제대로 전하고 싶어서…"

msgid "adv_100801_0015_msg"
msgstr "그랬구나… 그럼 나도 같이 생각해볼게요!\\n같이 밀레느 씨를 축하해야죠!"

msgid "adv_100801_0016_msg"
msgstr "정말인가요? 감사합니다!"

msgid "adv_100801_0018_msg"
msgstr "…생일에 축하의 말을 전한다, 인가.\\n분명… 축하한다고 말하면 되는 거였지"

msgid "adv_100801_0019_msg"
msgstr "그래. 밀레느는 우리 미래의 딸이라더군.\\n분명 좋아해줄 거야"

msgid "adv_100801_0020_msg"
msgstr "…잘 전해지면 좋겠는데"

msgid "adv_100801_0021_msg"
msgstr "그러고 보니 미라쥬도 비슷한 걸 상담해왔어.\\n우리, 의외로 닮았을지도 모르겠네"

msgid "adv_100801_0023_msg"
msgstr "와아~! 미라쥬한테 메시지가 왔어!\\n아, 지금의 아빠랑 엄마뿐만 아니라 옛날의 아빠랑 엄마한테서도!"

msgid "adv_100801_0025_msg"
msgstr "밀레느 씨!"

msgid "adv_100801_0026_msg"
msgstr "감린 씨…랑, 바사라!?\\n…헤에, 별일이 다 있네. 같이 온 거야?"

msgid "adv_100801_0027_msg"
msgstr "네. 오늘은 밀레느 씨의 생일 파티니까요.\\n생일 축하드립니다"

msgid "adv_100801_0028_msg"
msgstr "고마워요, 감린 씨!"

msgid "adv_100801_0029_msg"
msgstr "바사라도 축하 인사 정도는 해주는 게 어떻겠나?"

msgid "adv_100801_0030_msg"
msgstr "축하 인사?…뭔가를 전하려면 역시 노래지"

msgid "adv_100801_0031_msg"
msgstr "그 마음을 모르는 건 아니지만, 가끔은…"

msgid "adv_100801_0032_msg"
msgstr "괜찮아요, 감린 씨!\\n바사라가 제대~로 회장에 와 있다는 것만으로도 충분히 대단하니까"

msgid "adv_100801_0033_msg"
msgstr "그러고 보니 오늘은 생일 파티 마지막에\\nFire Bomber 라이브를 한다고 했었죠. 저도 기대하고 있습니다"

msgid "adv_100801_0034_msg"
msgstr "응! 오늘은 늘 신세 지는 사람들이 와줬으니까,\\n끝내주게 멋진 라이브로 만들 거야. 그렇지, 바사라!"

msgid "adv_100801_0035_msg"
msgstr "밀레느, 똑똑히 봐둬"

msgid "adv_100801_0036_msg"
msgstr "어? 이게 뭐야…?"

msgid "adv_100801_0037_msg"
msgstr "악보다"

msgid "adv_100801_0038_msg"
msgstr "그건 보면 알아! 그게 아니라… 이거 신곡이지?\\n왜 갑자기?"

msgid "adv_100801_0039_msg"
msgstr "생일이니까"

msgid "adv_100801_0040_msg"
msgstr "에에!? 설마 생일 선물이라는 거야!?"

msgid "adv_100801_0041_msg"
msgstr "왜. 필요 없어?"

msgid "adv_100801_0042_msg"
msgstr "그런 건 아니지만… 조금 의외였달까,\\n놀랐달까, 기쁘달까…"

msgid "adv_100801_0043_msg"
msgstr "뭔가 여러 감정이 뒤섞여서"

msgid "adv_100801_0044_msg"
msgstr "한심한 얼굴 하지 마, 생일이잖아.\\n그런 얼굴 하고 있으면 어른 못 된다"

msgid "adv_100801_0045_msg"
msgstr "다들한테 노래 들려줄 거잖아"

msgid "adv_100801_0046_msg"
msgstr "응!"

msgid "adv_100802_0009_msg"
msgstr ""

msgid "adv_100802_0011_msg"
msgstr "밀레느 씨, 이런 곳에서 뭐 하세요?\\n오늘의 주인공이시니 좀 더 중앙으로…"

msgid "adv_100802_0012_msg"
msgstr "아, 감린 씨"

msgid "adv_100802_0013_msg"
msgstr "그건… 사진인가요?"

msgid "adv_100802_0014_msg"
msgstr "응. 아빠랑 엄마의 옛날 사진.\\n두 사람 결혼식 때 찍은 거야"

msgid "adv_100802_0015_msg"
msgstr "얼마 전에 우연히 발견했어.\\n둘 다 엄청 행복해 보이지? 지금은 상상도 안 되지만~"

msgid "adv_100802_0016_msg"
msgstr "…확실히 두 분 다 행복해 보이시네요"

msgid "adv_100802_0017_msg"
msgstr "오늘 아빠랑 엄마도 제대로 생일 파티에 와줘서\\n다행이다 싶었어"

msgid "adv_100802_0018_msg"
msgstr "당연히 오시죠. 맥스 함장님도 미리아 시장님도\\n굉장히 의욕이 넘치셨으니까요"

msgid "adv_100802_0019_msg"
msgstr "정말? 그럼 다행이다!"

msgid "adv_100802_0020_msg"
msgstr "그런데, 저 밀레느 씨.\\n오늘 드린 선물 말인데요…"

msgid "adv_100802_0021_msg"
msgstr "아아아~!"

msgid "adv_100802_0022_msg"
msgstr "미, 밀레느 씨?"

msgid "adv_100802_0023_msg"
msgstr "잠깐 바사라!! 그거 내 케이크야!"

msgid "adv_100802_0025_msg"
msgstr "어?"

msgid "adv_100802_0026_msg"
msgstr "아까 케이크는 안 매워서 필요 없다고 했잖아!"

msgid "adv_100802_0027_msg"
msgstr "시장한테 받았어"

msgid "adv_100802_0028_msg"
msgstr "그렇다고 왜 먹어버리는 건데!\\n정말, 제멋대로라니까!"

msgid "adv_100802_0029_msg"
msgstr "어이, 감린.\\n한 곡 더 듣고 갈 거지?"

msgid "adv_100802_0030_msg"
msgstr "아, 그래…"

msgid "adv_100802_0031_msg"
msgstr "좋아, 밀레느. 얼른 악기 챙겨서 준비해!"

msgid "adv_100802_0032_msg"
msgstr "자, 잠깐!\\n…정말 바사라는 언제나 변함없네"

msgid "adv_100802_0033_msg"
msgstr "그러고 보니 감린 씨.\\n아까 무슨 말 하려던 거 아니었어요?"

msgid "adv_100802_0034_msg"
msgstr "…아닙니다! 아무것도 아닙니다.\\n신경 쓰지 마세요"

msgid "adv_100802_0035_msg"
msgstr "그래요?"

msgid "adv_100802_0036_msg"
msgstr "밀레느 씨, 오늘은 기억에 남을\\n생일 파티가 돼서 다행이네요"

msgid "adv_100802_0037_msg"
msgstr "에헤헤… 응!"

msgid "adv_200701_0009_msg"
msgstr "음…"

msgid "adv_200701_0010_msg"
msgstr "어이, 하야테. 그렇게 골똘히 생각하고, 무슨 일이야?\\n고민이라면 언제든 상담해줄게"

msgid "adv_200701_0011_msg"
msgstr "아니, 고민이 있는 건 아닌데…"

msgid "adv_200701_0012_msg"
msgstr "아까 프레이아가 나가라고 해서 식당에서 쫓겨났거든.\\n왈큐레 애들끼리 뭔가 만든다고 하던데"

msgid "adv_200701_0013_msg"
msgstr "하하~ 그렇군"

msgid "adv_200701_0014_msg"
msgstr "뭔데?"

msgid "adv_200701_0015_msg"
msgstr "뭐, 오늘이 무슨 날인지 하야테가 알 리 없지"

msgid "adv_200701_0016_msg"
msgstr "뭐야 그게, 무슨 뜻인데"

msgid "adv_200701_0018_msg"
msgstr "…척, 아라드 대장이 찾고 있어"

msgid "adv_200701_0019_msg"
msgstr "오, 메서! 야, 오늘이 무슨 날인지 알아?"

msgid "adv_200701_0020_msg"
msgstr "임무와 관계 있나?"

msgid "adv_200701_0021_msg"
msgstr "아니, 관계는 없지만! 뭐랄까, 좀 더 관심을 가져보자고?"

msgid "adv_200701_0022_msg"
msgstr "오늘은 밸런타인데이잖아!\\n보통은 좀 더 들뜨는 날인 줄 알았는데"

msgid "adv_200701_0023_msg"
msgstr "…그런 건가?"

msgid "adv_200701_0024_msg"
msgstr "글쎄"

msgid "adv_200701_0025_msg"
msgstr "…너희, 그런 점은 닮았네"

msgid "adv_200701_0027_msg"
msgstr "다들! 오늘 밸런타인 라이브에서 나눠줄 초콜릿\\n준비는 다 됐지?"

msgid "adv_200701_0028_msg"
msgstr "완벽해"

msgid "adv_200701_0029_msg"
msgstr "네엣! 왈큐레 다 같이 초콜릿 만들기,\\n정말 재밌었어!"

msgid "adv_200701_0030_msg"
msgstr "프레이아, 초콜릿 묻었어"

msgid "adv_200701_0031_msg"
msgstr "에엣!? 어디? 아와와와!?"

msgid "adv_200701_0032_msg"
msgstr "후훗. 자, 그럼 다음은 라이브 준비를 하자"

msgid "adv_200701_0034_msg"
msgstr "…그나저나 초콜릿을 건네면서 고백한다니.\\n참 신기한 걸 생각해낸 사람도 있었네"

msgid "adv_200701_0035_msg"
msgstr "근데 어떤 식으로 건네는 게 맞는 걸까?\\n밸런타인 같은 건 잘 모르겠고…"

msgid "adv_200701_0037_msg"
msgstr "프레프레, 걱정 마!\\n내가 확실히 조사해왔으니까"

msgid "adv_200701_0038_msg"
msgstr "마키나 씨!"

msgid "adv_200701_0039_msg"
msgstr "마키나… 그거 오늘 라이브에서 입을 의상이지? 벌써 갈아입었어?"

msgid "adv_200701_0040_msg"
msgstr "물론이지! 카나카나 것도 준비해뒀어"

msgid "adv_200701_0041_msg"
msgstr "왈큐레를 대표해서 나랑 카나카나가 라이브에서\\n끝내주게 귀여운 건네는 법을 전수해줄게!"

msgid "adv_200701_0042_msg"
msgstr "오오!"

msgid "adv_200701_0043_msg"
msgstr "어, 나도!?"

msgid "adv_200701_0044_msg"
msgstr "즐겁고 귀여운 밸런타인 라이브로 만들자~!"

msgid "adv_200701_0045_msg"
msgstr "자, 잠깐! 마키나!"

msgid "adv_200702_0009_msg"
msgstr "수고했어, 메서 군!\\n오늘 라이브도 분위기 좋았네!"

msgid "adv_200702_0010_msg"
msgstr "…네. 그런데 그건…"

msgid "adv_200702_0011_msg"
msgstr "이 초콜릿?\\n봐, 오늘은 밸런타인이니까 감사의 의미도 담아서\\n다들 먹을 걸 만들어봤어"

