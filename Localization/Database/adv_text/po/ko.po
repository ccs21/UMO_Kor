msgid "adv_102601_0032_msg"
msgstr "셰릴 씨…"

msgid "adv_102601_0033_msg"
msgstr "그래서 란카도 같이 불러줬으면 해"

msgid "adv_102601_0034_msg"
msgstr "물론이죠!"

msgid "adv_102601_0035_msg"
msgstr "정말 멋진 것 같아요.\\r\\n마음을 담아 노래하면,\\r\\n분명 알토 군에게도 닿을 거예요!"

msgid "adv_102601_0036_msg"
msgstr "응. 분명 그럴 거야.\\r\\n가자, 란카!"

msgid "adv_102601_0037_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_102602_0008_msg"
