msgstr "민민의 라이브 의상은 항상 너무 귀여워~!"

msgid "adv_100382902_0004_msg"
msgstr "정말? 고마워, 마키나!"

msgid "adv_100382902_0005_msg"
msgstr "그러고 보니 왈큐레 모두의 의상은 마키나가 준비하는 거지?"

msgid "adv_100382902_0006_msg"
msgstr "응! 모두가 최고로 귀여운 의상을\\n입어줬으면 하니까!"

msgid "adv_100382902_0007_msg"
msgstr "마키나는 모두를 정말 좋아하는구나!"

msgid "adv_100382902_0008_msg"
msgstr "응! 세상에서 제일 좋아해!\\r\\n물론 민민 일행이나 다른 시공의 모두도!"

msgid "adv_100382902_0009_msg"
msgstr "그리고 모두가 가장 귀여울 때가 언제인지도,\\n내가 제일 잘 안다고 생각해!"

msgid "adv_1400401_0009_msg"
msgstr "란카.\\r\\n멋진 찻집 알려줘서 고마워!"

msgid "adv_1400401_0010_msg"
msgstr "홍차도 케이크도 정말 맛있었어.\\r\\n다음엔 업무 미팅 때도 이용해볼까"

msgid "adv_1400401_0011_msg"
msgstr "네! 꼭 그러세요!"

msgid "adv_1400401_0012_msg"
msgstr "…앗!"

msgid "adv_1400401_0013_msg"
msgstr "왜 그래?"

msgid "adv_1400401_0014_msg"
msgstr "셰릴 씨!\\n아까 거리 전광판에서 셰릴 씨를 봤어요!"

msgid "adv_1400401_0015_msg"
msgstr "얼마 전에 촬영한 신작 화장품 CM인가?"

msgid "adv_1400401_0016_msg"
msgstr "네! 정말 정말 아름다웠어요…"

msgid "adv_1400401_0017_msg"
msgstr "고마워, 란카"

msgid "adv_1400401_0018_msg"
msgstr "역시 셰릴 씨는\\n언제나 제 동경의 대상이에요"

msgid "adv_1400401_0019_msg"
msgstr "지금은 함께 노래하기도 하고, 새의 인간과 싸우기도 해서…\\n저한테 가까운 존재가 되셨지만"

msgid "adv_1400401_0020_msg"
msgstr "그래도 셰릴 씨는 저한테\\r\\n아득히 먼 곳의… 은하의 빛 같은 사람이에요!"

msgid "adv_1400401_0021_msg"
msgstr ""

msgid "adv_1400401_0022_msg"
msgstr "있잖아, 란카.\\r\\n사실 이번에 이 화장품 브랜드와 타이업한\\r\\n스페셜 라이브를 하게 됐는데"

msgid "adv_1400401_0023_msg"
msgstr "그 라이브에 란카도 출연해보지 않을래?"

msgid "adv_1400401_0024_msg"
msgstr "어!? 제가요…!?"

msgid "adv_1400401_0025_msg"
msgstr "그래!\\r\\n메이크업은 물론이고, 이 브랜드 화장품으로 통일하고…"

msgid "adv_1400401_0026_msg"
msgstr "의상은 내 것과 맞춰서,\\r\\n쿨하고 어른스러운 이미지로 정리해달라고 할까!"

msgid "adv_1400401_0027_msg"
msgstr "하지만 저는 셰릴 씨처럼\\r\\n어른스러운 분위기 같은 건 전혀 못 내는데요…!"

msgid "adv_1400401_0028_msg"
msgstr "괜찮아!\\r\\n가끔은 그런 란카도 좋다고 생각해"

msgid "adv_1400401_0029_msg"
msgstr "정말인가요?"

msgid "adv_1400401_0030_msg"
msgstr "응!"

msgid "adv_1400401_0031_msg"
msgstr "그렇게 정했으면 오늘 쇼핑은 여기까지!\\r\\n자, 라이브 준비를 시작하자, 란카!"

msgid "adv_1400401_0032_msg"
msgstr "앗. 기다려주세요, 셰릴 씨!"

msgid "adv_1400402_0009_msg"
msgstr "란카, 라이브 수고했어!"

msgid "adv_1400402_0010_msg"
msgstr "특훈 성과가 나왔네.\\r\\n오늘 란카, 최고로 쿨했어!"

msgid "adv_1400402_0011_msg"
msgstr "셰릴 씨…!\\r\\n이번에는 정말 정말 감사했습니다!"

msgid "adv_1400402_0012_msg"
msgstr "나나한테 멋있다는 말을 들은 적도\\r\\n있긴 하지만…"

msgid "adv_1400402_0013_msg"
msgstr "저 스스로도 평소와 다른 제 모습을\\r\\n보여줄 수 있었다고 실감하고 있어요!"

msgid "adv_1400402_0014_msg"
msgstr "후훗, 다행이네"

msgid "adv_1400402_0015_msg"
msgstr "그런데… 란카"

msgid "adv_1400402_0016_msg"
msgstr "네! 뭔가요?"

msgid "adv_1400402_0017_msg"
msgstr "란카는 메이크업이나 화장품에 얼마나\\r\\n관심이 있어?"

msgid "adv_1400402_0018_msg"
msgstr "화장품…이요?"

msgid "adv_1400402_0019_msg"
msgstr "응! 샘플을 한번 써보려고 하는데…"

msgid "adv_1400402_0020_msg"
msgstr "괜찮다면,\\n잠깐만 같이 있어주지 않을래?"

msgid "adv_1400402_0021_msg"
msgstr "물론이죠! 아, 맞다…\\r\\n저, 셰릴 씨한테 메이크업을 배우고 싶어요!"

msgid "adv_1400402_0022_msg"
msgstr "조금 멋있는 느낌의 메이크업은\\r\\n좀처럼 잘 안 되거든요"

msgid "adv_1400402_0023_msg"
msgstr "후훗, 좋아!\\r\\n잔뜩 가르쳐줄게!"

msgid "adv_1400402_0024_msg"
msgstr "감사합니다!"

msgid "adv_1400402_0025_msg"
msgstr "그럼 가볼까!"

msgid "adv_104501_0008_msg"
msgstr "으음…"

msgid "adv_104501_0009_msg"
msgstr "카나메! 안녕!"

msgid "adv_104501_0010_msg"
msgstr "밀레느 씨.\\r\\n안녕하세요, 무슨 일이세요?"

msgid "adv_104501_0011_msg"
msgstr "들었어.\\r\\n내일부터 사흘 동안 휴가라며?"

msgid "adv_104501_0012_msg"
msgstr "네, 맞아요"

msgid "adv_104501_0013_msg"
msgstr "잘됐잖아!\\r\\n카나메는 늘 바빠 보이는 이미지라서\\r\\n나도 왠지 안심이 되네!"

msgid "adv_104501_0014_msg"
msgstr "있잖아, 휴가 동안은 뭐 하면서 보낼 거야?"

msgid "adv_104501_0015_msg"
msgstr "나라면 우선 살롱에 갔다가\\r\\n그다음 쇼핑도 하고…"

msgid "adv_104501_0016_msg"
msgstr "분위기 좋은 카페에서 느긋하게 보내고…\\r\\n아, 계속 궁금했던 영화도 보고 싶다!"

msgid "adv_104501_0017_msg"
msgstr "하아… 나도 요즘 바빠서\\r\\n다음 휴일이 기다려지네…"

msgid "adv_104501_0018_msg"
msgstr "밀레느 씨는 쉬는 날 하고 싶은 게\\r\\n정말 많으시네요…"

msgid "adv_104501_0019_msg"
msgstr "카나메도 있잖아?"

msgid "adv_104501_0020_msg"
msgstr "사실, 그렇지도 않아요"

msgid "adv_104501_0021_msg"
msgstr "갑자기 함장님이 『좀 푹 쉬고 오는 게 어때』라고\\r\\n하셔서, 솔직히 뭘 해야 할지 당황스럽다고 해야 하나…"

msgid "adv_104501_0022_msg"
msgstr "으음… 그렇구나"

msgid "adv_104501_0023_msg"
msgstr "그래도 모처럼 받은 휴가니까\\r\\n아무것도 안 하고 보내기는 아깝다고 생각해서요"

msgid "adv_104501_0024_msg"
msgstr "제가 뭘 해보고 싶은지\\r\\n잡지도 읽어보고 이것저것 생각하고 있었어요"

msgid "adv_104501_0025_msg"
msgstr "그런 걸 봐봤자\\r\\n네가 하고 싶은 걸 찾을 수 있을 리가 없잖아"

msgid "adv_104501_0026_msg"
msgstr "바사라 씨?"

msgid "adv_104501_0027_msg"
msgstr "잠깐, 뭐야 바사라!"

msgid "adv_104501_0028_msg"
msgstr "카나메. 일단 내일 아침이 되면\\r\\n아무 데나 나가봐"

msgid "adv_104501_0029_msg"
msgstr "다른 행성에 가보는 것도 좋고"

msgid "adv_104501_0030_msg"
msgstr "그건 그러니까… 여행을 가라는 뜻인가요?"

msgid "adv_104501_0031_msg"
msgstr "여행이라기보다, 떠나는 거지"

msgid "adv_104501_0032_msg"
msgstr "그것도 좋을지도 모르겠네요!"

msgid "adv_104501_0033_msg"
msgstr "그렇다면 여행할 행성을 정해둬야겠네요.\\r\\n보고 싶은 장소를 정하고, 하루 계획도 제대로 세우고…"

msgid "adv_104501_0034_msg"
msgstr "그런 건 필요 없다니까.\\r\\n일단 아무 생각 없이 나가봐"

msgid "adv_104501_0035_msg"
msgstr "네… 하, 하지만…?"

msgid "adv_104501_0036_msg"
msgstr "잠깐, 바사라!"

msgid "adv_104501_0037_msg"
msgstr "여행 전에 제대로 계획을 세워두는 건\\r\\n중요한 일이잖아?"

msgid "adv_104501_0038_msg"
msgstr "넌 아무것도 모르는구나, 밀레느"

msgid "adv_104501_0039_msg"
msgstr "뭐라고~!?"

msgid "adv_104501_0040_msg"
msgstr "카나메. 생각할 필요 없을 때는 생각하지 마.\\r\\n필요할 때만 생각하면 돼"

msgid "adv_104501_0041_msg"
msgstr "그게 바로 여행이야"

msgid "adv_104501_0042_msg"
msgstr "여행…"

msgid "adv_104502_0008_msg"
msgstr "카나메"

msgid "adv_104502_0009_msg"
msgstr "바사라 씨!\\r\\n오늘 무대 수고하셨습니다"

msgid "adv_104502_0010_msg"
msgstr "너도"

msgid "adv_104502_0011_msg"
msgstr "오늘 네 노래, 평소보다 훨씬 좋았어"

msgid "adv_104502_0012_msg"
msgstr "네…?"

msgid "adv_104502_0013_msg"
msgstr "다음에 또 시간 나면 적당히 여행이나 떠나봐"

msgid "adv_104502_0014_msg"
msgstr "은하는 넓으니까.\\r\\n끝에서 끝까지 다 가보고, 봐줘야지"

msgid "adv_104502_0015_msg"
msgstr "그 말만 하고 싶었어. 그럼 간다"

msgid "adv_104502_0017_msg"
msgstr ""

msgid "adv_104502_0018_msg"
msgstr "정말이지. 바사라는 말이 너무 부족하다니까~"

msgid "adv_104502_0019_msg"
msgstr "밀레느 씨"

msgid "adv_104502_0020_msg"
msgstr "…그래도 확실히 오늘 카나메의 노래는\\r\\n내 가슴에도 불을 붙였어!"

msgid "adv_104502_0021_msg"
msgstr "휴가로 제대로 재충전한 효과가\\r\\n확실히 나온 걸지도 모르겠네!"

msgid "adv_104502_0022_msg"
msgstr "…그러네요"

msgid "adv_104502_0023_msg"
msgstr "사실 오늘 바사라 씨와 함께 노래할 때\\n여행지에서 봤던 그 아름다운 풍경을 떠올리고 있었어요"

msgid "adv_104502_0024_msg"
msgstr "아직도 여행 중인 것 같은… 그런 기분으로요"

msgid "adv_104502_0025_msg"
msgstr "…어쩌면 바사라 씨도\\n항상 이런 감각으로 노래하고 있는 걸지도 모르겠다고\\n생각했어요"

msgid "adv_104502_0026_msg"
msgstr "여행 중이라… 그러네"

msgid "adv_104502_0027_msg"
msgstr "바사라는 잠깐 한눈팔면\\r\\n금방 어디론가 가버릴 것 같은 느낌도 들고…"

msgid "adv_104502_0028_msg"
msgstr "…여행도 좋지만 적당히 하게 해야겠어.\\r\\n그러려면 내가 잘 감시하고 있어야지!"

msgid "adv_104502_0029_msg"
msgstr "후훗. 그러네요"

msgid "adv_104502_0030_msg"
msgstr "그런 카나메도\\r\\n바사라 따라 하는 건 적당히 해야 해?"

msgid "adv_104502_0031_msg"
msgstr "카나메까지 훌쩍 사라져버리면\\r\\n왈큐레 모두가 곤란할 테니까!"

msgid "adv_104502_0032_msg"
msgstr "알고 있어요. 저는 왈큐레의 리더\\r\\n카나메 버캐니어니까요!"

msgid "adv_104502_0033_msg"
msgstr "……그런데, 카나메"

msgid "adv_104502_0034_msg"
msgstr "네?"

msgid "adv_104502_0035_msg"
msgstr "바사라한테 들었다는\\r\\n바사라의 옛날 여행 이야기, 들려줘!"

msgid "adv_104502_0036_msg"
msgstr "바사라는 전혀 이야기할 생각이 없는 것 같단 말이야!"

msgid "adv_104502_0037_msg"
msgstr "네에?\\r\\n하지만 제가 말해버려도 괜찮을까요…?"

msgid "adv_104502_0038_msg"
msgstr "부탁이야~! 카나메!\\n응? 괜찮지~?"

msgid "adv_104502_0039_msg"
msgstr "저기… 네, 알겠습니다!"

msgid "adv_100390101_0003_msg"
msgstr "바사라 씨, 수고하셨습니다!"

msgid "adv_100390101_0004_msg"
msgstr "전부터 생각했는데 말이야, 카나메.\\r\\n나나 밀레느한테 너무 격식 차리는 거 아니야?"

msgid "adv_100390101_0005_msg"
msgstr "존댓말이나 「씨」 같은 거\\r\\n그런 거 없어도 되잖아?"

msgid "adv_100390101_0006_msg"
msgstr "아니요, 그럴 수는 없습니다! 선배님들께 예의를 다하는 건,\\r\\n연예계에 몸담은 사람으로서 당연한 일이니까요"

msgid "adv_100390101_0007_msg"
msgstr "선배라… 뭐, 그럴지도 모르지만…\\r\\n그전에 우리, 같은 목적을 가진 동료잖아?"

msgid "adv_100390101_0008_msg"
msgstr "동료… 확실히 그렇네요…! 으음, 하지만,\\r\\n바사라 씨 일행은 시공을 넘어선 대선배이기도 하고…\\r\\n으으음…"

msgid "adv_100390101_0009_msg"
msgstr "…뭔가 엄청 고민하게 만들어버린 것 같네…"

msgid "adv_100390102_0003_msg"
msgstr "으음…… 뭔가 아닌데"

msgid "adv_100390102_0004_msg"
msgstr "잠깐, 바사라! 듣고 있어!?"

msgid "adv_100390102_0005_msg"
msgstr "뭐야, 밀레느.\\r\\n지금 곡 만드는 중이야. 방해하지 마"

msgid "adv_100390102_0006_msg"
msgstr "보면 아는 건 알겠는데…\\r\\n있잖아, 잠깐만 초시공 SNS 좀 봐!"

msgid "adv_100390102_0007_msg"
msgstr "셰릴이 연락했잖아!\\r\\n답장 정도는 제대로 해주는 게 어때?"

msgid "adv_100390102_0008_msg"
msgstr "그래. 밀레느, 대신 답장해줘"

msgid "adv_100390102_0009_msg"
msgstr "에에에에에!? 거짓말, 믿을 수가 없네…"

msgid "adv_100391301_0003_msg"
msgstr "미쿠모. 다음엔 뭐 먹고 싶어?\\r\\n해파리 춘권? 해파리 만두?"

msgid "adv_100391301_0004_msg"
msgstr "…그렇게 많이는 못 먹어"

msgid "adv_100391301_0005_msg"
msgstr "아, 그것도 그렇네. 미안, 미안"

msgid "adv_100391301_0006_msg"
msgstr "카나메… 너, 설마 들떠 있는 거야?"

msgid "adv_100391301_0007_msg"
msgstr "…그야 오랜만의 휴일이고, 이렇게 미쿠모가\\r\\n같이 외출해줄 줄은 몰랐으니까…"

msgid "adv_100391301_0008_msg"
msgstr "그러니까 조금만 더 어울려줘! …응?"

msgid "adv_100391301_0009_msg"
msgstr "…곤란한 리더네.\\n어쩔 수 없지… 어울려줄게"

msgid "adv_100391302_0003_msg"
msgstr "으음… 다음 라이브 세트리스트,\\r\\n좀처럼 안 정해지네…"

msgid "adv_100391302_0004_msg"
msgstr "늦게까지 수고 많아, 리더.\\r\\n가끔은 따뜻한 코코아라도 어때?\\r\\n달콤해서 마음이 편안해질 거야!"

msgid "adv_100391302_0005_msg"
msgstr "마키나…"

msgid "adv_100391302_0006_msg"
msgstr "나도 같이 생각할게.\\r\\n과자도 먹고, 수다도 떨면서… 말이야!"

msgid "adv_100391302_0007_msg"
msgstr "그거 그냥 여자들끼리 수다 떨고 싶은 것뿐 아니야?"

msgid "adv_100391302_0008_msg"
msgstr "에헤헤~. 반은 정답이려나"

msgid "adv_100391302_0009_msg"
msgstr "어쩔 수 없네… 그래도 왠지 좋은 아이디어가\\r\\n떠오를 것 같아. 고마워, 마키나"

msgid "adv_303801_0008_msg"
msgstr "얘들아. 오늘까지 리허설하느라 수고했어!"

msgid "adv_303801_0009_msg"
msgstr "드디어 내일부터\\r\\n이틀간의 백신 라이브가 시작돼"

msgid "adv_303801_0010_msg"
msgstr "현재 예정으로는 이틀 동안 이 도시 인구의 절반을 동원할 예정"

msgid "adv_303801_0011_msg"
msgstr "왈큐레 역사에 남을\\r\\n최고의 라이브로 만들자!"

msgid "adv_303801_0013_msg"
msgstr "으음…"

msgid "adv_303801_0014_msg"
msgstr "왜 그래? 프레이아"

msgid "adv_303801_0015_msg"
msgstr "그게… 라이브 개최가 결정됐을 때부터\\n생각했던 건데요"

msgid "adv_303801_0016_msg"
msgstr "이런 행성이 이 은하에 있었나… 싶어서요"

msgid "adv_303801_0017_msg"
msgstr "…듣고 보니 그런 것 같기도?"

msgid "adv_303801_0018_msg"
msgstr "카나카나.\\r\\n이 행성은 어떤 곳이었지?"

msgid "adv_303801_0019_msg"
msgstr "글쎄… 내가 가진 정보는\\r\\n라이브 회장 주변 정보뿐이긴 한데…"

msgid "adv_303801_0020_msg"
msgstr "이번 라이브 회장이 있는 곳은 그 행성에서도 손꼽히는 항구도시이자\\r\\n인기 관광지이기도 한 모양이야"

msgid "adv_303801_0021_msg"
msgstr "항구도시라는 건… 바다가 보인다는 거야?"

msgid "adv_303801_0022_msg"
msgstr "최근에는 운하에 비치는 야경이 아주 아름답기로\\r\\n유명한 모양이야!"

msgid "adv_303801_0023_msg"
msgstr "도시적인 워터프런트 같은 느낌인가…\\r\\n왠지 굉장한 곳일 것 같네…!"

msgid "adv_303801_0024_msg"
msgstr "오오~!"

msgid "adv_303801_0026_msg"
msgstr "프레이아"

msgid "adv_303801_0027_msg"
msgstr "그곳이 어디든, 어떤 곳이든 상관없어"

msgid "adv_303801_0028_msg"
msgstr "우리는 우리 노래를 부를 뿐.\\r\\n그렇지?"

msgid "adv_303801_0030_msg"
msgstr "확실히 미쿠모 씨 말씀이 맞아요!\\r\\n저도 전력으로 즐길게요!"

msgid "adv_303801_0031_msg"
msgstr "라이브 끝나면 다 같이 관광도 하자!"

msgid "adv_303801_0033_msg"
msgstr "워터프런트 근처에서 차이나타운 발견.\\r\\n뒤풀이 장소 후보, 찾아둘게"

msgid "adv_303801_0034_msg"
msgstr "기운 팍팍~!"

msgid "adv_303801_0035_msg"
msgstr "그럼 얘들아, 내일 잘 부탁해!"

msgid "adv_303801_0036_msg"
msgstr "아직 만나지 못한 팬들에게\\r\\n우리 노래를 전하러 가자!"

msgid "adv_303801_0038_msg"
msgstr "응"

msgid "adv_303802_0008_msg"
msgstr "하아…"

msgid "adv_303802_0009_msg"
msgstr "프레이아"

msgid "adv_303802_0010_msg"
msgstr "후아앗! 미, 미쿠모 씨…?"

msgid "adv_303802_0011_msg"
msgstr "지난번 라이브를\\r\\n떠올리고 있는 거지?"

msgid "adv_303802_0012_msg"
msgstr "알아. 나도 같은 마음이니까"

msgid "adv_303802_0013_msg"
msgstr "미쿠모 씨도요?"

msgid "adv_303802_0014_msg"
msgstr "응. 아직도 심장이 뛰고 있어"

msgid "adv_303802_0015_msg"
msgstr "…저, 그 라이브는 평생 잊지 못할 추억이 됐어요"

msgid "adv_303802_0016_msg"
msgstr "처음 가본 행성에,\\r\\n처음 만나는 사람들뿐이었는데도"

msgid "adv_303802_0017_msg"
msgstr "우리 노래를 통해 이어질 수 있었고\\r\\n그렇게 큰 일체감을 느낄 수 있었고"

msgid "adv_303802_0018_msg"
msgstr "우리가 노래하면 모두가 응해주고…\\r\\n그런 최고의 공간을 모두와 함께할 수 있어서"

msgid "adv_303802_0019_msg"
msgstr "정말 정말… 행복했어요!"

msgid "adv_303802_0020_msg"
msgstr "프레이아"

msgid "adv_303802_0021_msg"
msgstr "난 너와 달리\\r\\n그 라이브를 지나간 추억으로\\r\\n끝낼 생각은 없어"

msgid "adv_303802_0022_msg"
msgstr "네…?"

msgid "adv_303802_0023_msg"
msgstr "언젠가 반드시.\\r\\n다시 한번 그곳에서 라이브를 할 거야"

msgid "adv_303802_0024_msg"
msgstr "왈큐레 모두와.\\r\\n우리 노래를 들으러 와준 모두와"

msgid "adv_303802_0025_msg"
msgstr "우리의 새로운 노래를 데리고, 말이야"

msgid "adv_303802_0026_msg"
msgstr "…! 그러네요!"

msgid "adv_303802_0027_msg"
msgstr "그럼 슬슬 가자.\\r\\n우리한텐 다음 라이브가 있으니까"

msgid "adv_303802_0028_msg"
msgstr "네엣!"

msgid "adv_104601_0008_msg"
msgstr "란카, 슬슬 쉬자"

msgid "adv_104601_0009_msg"
msgstr "네, 셰릴 씨!"

msgid "adv_104601_0010_msg"
msgstr "학교 라이브까지 이제 얼마 안 남았네…\\r\\n노래도 춤도 거의 완성됐어"

msgid "adv_104601_0011_msg"
msgstr "네! 춤도 호흡이 딱 맞았죠!"

msgid "adv_104601_0012_msg"
msgstr "셰릴 씨와 함께 부르는 「라이온」\\r\\n기대된다…"

msgid "adv_104601_0013_msg"
msgstr "그러고 보니… 이번에는 미호시 학원 무대를\\r\\n빌리는 거죠?"

msgid "adv_104601_0014_msg"
msgstr "응!"

msgid "adv_104601_0015_msg"
msgstr "그러니까 미호시 학원 학생들도\\r\\n다 보러 와줄 거야!"

msgid "adv_104601_0016_msg"
msgstr "그러니까…"

msgid "adv_104601_0017_msg"
msgstr ""

msgid "adv_104601_0018_msg"
msgstr "셰릴 씨?"

msgid "adv_104601_0019_msg"
msgstr "그러니까 조금만 더 공들인 연출을 하고 싶어.\\r\\n모두가 깜짝 놀랄 만한…"

msgid "adv_104601_0020_msg"
msgstr "그렇다고 해도 시간은 한정돼 있고…\\r\\n뭔가 좋은 아이디어 없을까"

msgid "adv_104601_0021_msg"
msgstr "셰릴, 란카.\\r\\n여기 있었구나"

msgid "adv_104601_0022_msg"
msgstr "알토!"

msgid "adv_104601_0023_msg"
msgstr "알토 군!"

msgid "adv_104601_0024_msg"
msgstr "이번 라이브 건으로 학교 측에서\\r\\n회의를 하고 싶다는 모양이야"

msgid "adv_104601_0025_msg"
msgstr "그래서…"

msgid "adv_104601_0026_msg"
msgstr ""

msgid "adv_104601_0027_msg"
msgstr "야, 듣고 있어?"

msgid "adv_104601_0028_msg"
msgstr "좋은 생각이 났어!\\r\\n있잖아, 알토! 잠깐 협력해주지 않을래!?"

msgid "adv_104601_0029_msg"
msgstr "뭐…?"

msgid "adv_104602_0008_msg"
msgstr "알토! 우리가 준비한 답례는 어땠어?"

msgid "adv_104602_0009_msg"
msgstr "…놀랐어"

msgid "adv_104602_0010_msg"
msgstr "후훗! 다행이다!\\r\\n셰릴 씨랑 얘기해서 알토 군한테는\\r\\n이게 제일 좋겠다고 생각했어!"

msgid "adv_104602_0011_msg"
msgstr "나와 란카의 스페셜 라이브.\\r\\n관객은 알토 한 명뿐"

msgid "adv_104602_0012_msg"
msgstr "꽤 멋지지?"

msgid "adv_104602_0013_msg"
msgstr "…그러네"

msgid "adv_104602_0014_msg"
msgstr "있잖아, 알토 군! 어떤 곡이 제일 좋았어?"

msgid "adv_104602_0015_msg"
msgstr "다 좋았지만… 굳이 고르자면\\n「라이온」이네. 둘의 호흡이 잘 맞아서 박력이 있었어"

msgid "adv_104602_0016_msg"
msgstr "당연하지"

msgid "adv_104602_0017_msg"
msgstr "많이 연습했으니까요!"

msgid "adv_104602_0018_msg"
msgstr "이렇게 눈앞에서 라이브를 보고…\\r\\n새삼 너희 노래에는 힘이 있다는 걸 느꼈어"

msgid "adv_104602_0019_msg"
msgstr "그렇게 말해주니까 기쁘다!"

msgid "adv_104602_0020_msg"
msgstr "그것도 당연하지. 셰릴 놈과\\r\\n란카 리니까"

msgid "adv_104602_0021_msg"
msgstr "후훗!"

msgid "adv_104602_0022_msg"
msgstr "다음 라이브도 협력해달라고 할까?"

msgid "adv_104602_0023_msg"
msgstr "그, 그건 좀 생각하게 해줘"

msgid "adv_104602_0024_msg"
msgstr "기대하고 있을게, 알토!"

msgid "adv_104602_0025_msg"
msgstr "잘 부탁해, 알토 군!"

msgid "adv_104602_0026_msg"
msgstr "정말, 너희는…"

msgid "adv_100398501_0003_msg"
msgstr "파자마 파티라니 왠지 두근두근하네요!\\r\\n이따가 나나랑 클란 씨 일행도 와준대요!"

msgid "adv_100398501_0004_msg"
msgstr "후훗, 그러네.\\r\\n그러고 보니 왈큐레도 비슷한 걸 했었지?"

msgid "adv_100398501_0005_msg"
msgstr "네! 왈큐레 여러분한테 이야기를 듣다 보니,\\r\\n저도 부러워져서…"

msgid "adv_100398501_0006_msg"
msgstr "과자도 음료도 준비했고,\\n얘기하고 싶은 것도 정리해왔고… 정말 기대돼요!"

msgid "adv_100398501_0007_msg"
msgstr "후훗, 어떤 파자마 파티가 될까"

msgid "adv_100398501_0008_msg"
msgstr "오늘은 오빠도 없으니까,\\r\\n비밀 이야기도 할 수 있어요!"

msgid "adv_100398501_0009_msg"
msgstr "응, 멋진 밤으로 만들자!"

msgid "adv_100398502_0003_msg"
msgstr "마키나 씨, 발키리 캐릭터 도시락도\\r\\n만들 수 있을까요?"

msgid "adv_100398502_0004_msg"
msgstr "캐릭터 도시락… 발키리 도시락!?\\n분명 엄청 귀여울 텐데, 갑자기 왜?"

msgid "adv_100398502_0005_msg"
msgstr "사실 얼마 전에 학교에서 먹으려고\\r\\n도롱뇽 씨 캐릭터 도시락을 만들어봤거든요"

msgid "adv_100398502_0006_msg"
msgstr "점심시간에 다들한테 보여줬더니 반응이 좋아서…\\r\\n다음엔 발키리 도시락을 만들면,\\r\\n알토 군이나 미셸 군도 좋아해주지 않을까 해서요…"

msgid "adv_100398502_0007_msg"
msgstr "흠흠… 그런 거라면 나도 란란을 위해\\n도와줄게~! 자료 제공이랑 조언은 맡겨둬!"

msgid "adv_100398502_0008_msg"
msgstr "정말인가요!? 마키나 씨와 함께라면\\r\\n엄청난 걸 만들 수 있을 것 같아요!"

msgid "adv_100398502_0009_msg"
msgstr "후후후~! 알알 일행이\\n깜짝 놀랄 표정이 기대되네!"

msgid "adv_100399701_0003_msg"
msgstr "…오늘 외출은 역시 이쪽 옷이 더 좋을까"

msgid "adv_100399701_0004_msg"
msgstr "와아, 좋네요! 셰릴 씨는\\r\\n뭘 입어도 잘 어울려서 부러워요…"

msgid "adv_100399701_0005_msg"
msgstr "오랜만의 휴일, 란카와 외출…\\r\\n마음껏 꾸민다고 벌받진 않겠지!"

msgid "adv_100399701_0006_msg"
msgstr "있잖아, 란카!\\r\\n이왕이면 란카 옷도 내가 골라줘도 될까?"

msgid "adv_100399701_0007_msg"
msgstr "정말요!? 너무 기뻐요!"

msgid "adv_100399701_0008_msg"
msgstr "맡겨둬! 최고로 귀엽게 꾸며줄게!"

msgid "adv_100399701_0009_msg"
msgstr "에헤헤… 기대돼요!"

msgid "adv_100399702_0003_msg"
msgstr "셰릴과 듀엣, 뭔가 신선해"

msgid "adv_100399702_0004_msg"
msgstr "그러고 보니 그렇네…\\r\\n어땠어? 자극적이었어?"

msgid "adv_100399702_0005_msg"
msgstr "굉장했어. 가슴이 따끔따끔했어.\\r\\n…그리고 셰릴에 대해 더 알고 싶어졌어"

msgid "adv_100399702_0006_msg"
msgstr "후훗, 만족한 것 같아서 다행이네"

msgid "adv_100399702_0007_msg"
msgstr "그런 의미에서 카오스 여자 기숙사에 초대.\\r\\n이것저것 많이 들려줬으면 해"

msgid "adv_100399702_0008_msg"
msgstr "알토와의 일이라든가"

msgid "adv_100399702_0009_msg"
msgstr "왜, 왜 알토 얘기가 나오는 거야! 정말…"

msgid "adv_1400501_0008_msg"
msgstr "민민, 안녕~!"

msgid "adv_1400501_0009_msg"
msgstr "마키나, 안녕!"

msgid "adv_1400501_0010_msg"
msgstr "오늘은 무슨 일이야?"

msgid "adv_1400501_0011_msg"
msgstr "사실 얼마 전에 셰리셰리랑 란란의 라이브를 보고\\n교복도 좋구나~ 싶어서…"

msgid "adv_1400501_0012_msg"
msgstr "새 의상을 만들기 위해 여러 사람한테\\r\\n이야기를 듣고 연구하고 있어!"

msgid "adv_1400501_0013_msg"
msgstr "그래서 민민 이야기도 듣고 싶어서 왔어!"

msgid "adv_1400501_0014_msg"
msgstr "와아, 멋지다! 내가 아는 거라면 얼마든지!"

msgid "adv_1400501_0015_msg"
msgstr "와~ 고마워!"

msgid "adv_1400501_0016_msg"
msgstr "그럼 바로 물어볼게…\\n민민은 학교에서 뭐가 제일 즐거웠어?"

msgid "adv_1400501_0017_msg"
msgstr "글쎄… 역시 친구들이랑 이야기하는 거였을까"

msgid "adv_1400501_0018_msg"
msgstr "방과 후에 교실에 남아서 이야기하기도 하고,\\r\\n같이 찻집에 가기도 하고…"

msgid "adv_1400501_0019_msg"
msgstr "그렇구나, 그렇구나…"

msgid "adv_1400501_0020_msg"
msgstr "물론 학교도 즐겁지만\\r\\n방과 후에는 더 재미있는 일이 잔뜩 있어!"

msgid "adv_1400501_0021_msg"
msgstr "그렇구나!"

msgid "adv_1400501_0022_msg"
msgstr "조금 다른 이야기긴 한데, 나\\r\\n방과 후에 한 번 해보고 싶은 게 있어"

msgid "adv_1400501_0023_msg"
msgstr "해보고 싶은 거?"

msgid "adv_1400501_0024_msg"
msgstr "응, 방과 후 데이트!"

msgid "adv_1400502_0008_msg"
msgstr "민민, 이게 새 의상이야! 어때?"

msgid "adv_1400502_0009_msg"
msgstr "정말 귀엽다, 마키나!"

msgid "adv_1400502_0010_msg"
msgstr "에헤헤, 고마워!"

msgid "adv_1400502_0011_msg"
msgstr "프로모션 영상은 말이야, 모두 교복을 입고\\r\\n같은 학교에 다니는 이미지로 찍었어"

msgid "adv_1400502_0012_msg"
msgstr "정말 즐거웠어!\\r\\n완성되면 영상 보내줄게!"

msgid "adv_1400502_0013_msg"
msgstr "응, 기대하고 있을게!"

msgid "adv_1400502_0014_msg"
msgstr "…나도 동경하던 방과 후 데이트를 해봐서\\r\\n정말 즐거웠어"

msgid "adv_1400502_0015_msg"
msgstr "역시 일이 바쁘면\\r\\n좀처럼 시간을 내기 어렵잖아…"

msgid "adv_1400502_0016_msg"
msgstr "그래서 이번에 마키나와 함께\\r\\n방과 후를 보낼 수 있어서 정말 기뻤어"

msgid "adv_1400502_0017_msg"
msgstr "잠깐이나마 평범한 여자애로 돌아간 기분이랄까…"

msgid "adv_1400502_0018_msg"
msgstr "그렇구나…\\r\\n그럼 다음에도 방과 후에 같이 놀자! 민민!"

msgid "adv_1400502_0019_msg"
msgstr "어?"

msgid "adv_1400502_0020_msg"
msgstr "그야 방과 후에 천진난만하게 노는 민민,\\n정말 너무 귀여웠는걸!"

msgid "adv_1400502_0021_msg"
msgstr "게다가 기분 전환할 시간도 중요하니까!"

msgid "adv_1400502_0022_msg"
msgstr "후훗, 그러네. 고마워! 마키나!"

msgid "adv_104701_0008_msg"
msgstr "감린 씨, 기다리셨죠!"

msgid "adv_104701_0009_msg"
msgstr "밀레느 씨!"

msgid "adv_104701_0010_msg"
msgstr "제가 먼저 불러놓고 늦어서 정말 죄송해요!"

msgid "adv_104701_0011_msg"
msgstr "오늘은 바사라도 같이 오기로 했는데\\r\\n아무리 찾아도 안 보여서…"

msgid "adv_104701_0012_msg"
msgstr "바사라가 안 보이는 건\\r\\n늘 있는 일이니 신경 쓰지 않습니다"

msgid "adv_104701_0013_msg"
msgstr "그러고 보니 오늘은 왈큐레 라이브를\\r\\n보러 가는 거였죠"

msgid "adv_104701_0014_msg"
msgstr "네! 초시공 네트워크를 이용해서요!"

msgid "adv_104701_0015_msg"
msgstr "레이나가 멋진 자리를 준비해줬거든요.\\r\\n그래서 다 같이 몰래 보러 가려고요"

msgid "adv_104701_0016_msg"
msgstr "초대해주셔서 감사합니다.\\r\\n정말 기대됩니다"

msgid "adv_104701_0017_msg"
msgstr "감사는 제가 아니라 레이나한테 해주세요!"

msgid "adv_104701_0018_msg"
msgstr "그러고 보니 감린 씨. 손에 들고 있는 꽃다발은…?"

msgid "adv_104701_0019_msg"
msgstr "이건, 그게…"

msgid "adv_104701_0020_msg"
msgstr "아하! 왈큐레 모두에게 주려는 거군요!"

msgid "adv_104701_0021_msg"
msgstr "아, 아닙니다! 달라요!\\r\\n이건 밀레느 씨에게…"

msgid "adv_104701_0022_msg"
msgstr "저한테요?"

msgid "adv_104701_0023_msg"
msgstr "네, 받아주세요"

msgid "adv_104701_0024_msg"
msgstr "와아, 예쁘다… 감사합니다, 감린 씨!"

msgid "adv_104701_0025_msg"
msgstr "오늘 라이브, 같이 즐겨요!"

msgid "adv_104701_0026_msg"
msgstr "네!"

msgid "adv_104702_0008_msg"
msgstr "감린, 오늘 와줘서 고마워"

msgid "adv_104702_0009_msg"
msgstr "레이나 씨! 아닙니다, 제가 오히려\\r\\n초대해주셔서 감사합니다"

msgid "adv_104702_0010_msg"
msgstr "밀레느 씨가 갑자기 끌려갔을 때는\\r\\n놀랐지만…"

msgid "adv_104702_0011_msg"
msgstr "설마 시크릿 게스트였을 줄은…"

msgid "adv_104702_0012_msg"
msgstr "놀랐어?"

msgid "adv_104702_0013_msg"
msgstr "네. 하지만 좋은 라이브였습니다!\\r\\n밀레느 씨도 정말 즐겁게 노래하고 계셨으니까요"

msgid "adv_104702_0014_msg"
msgstr ""

msgid "adv_104702_0015_msg"
msgstr "레이나 씨?"

msgid "adv_104702_0016_msg"
msgstr ""

msgid "adv_104702_0017_msg"
msgstr "저기… 왜 그러세요?"

msgid "adv_104702_0018_msg"
msgstr "감린은 밀레느를…"

msgid "adv_104702_0019_msg"
msgstr "감린 씨! 기다리셨죠!"

msgid "adv_104702_0020_msg"
msgstr "…어라? 레이나도 여기 있었네!"

msgid "adv_104702_0021_msg"
msgstr "난 이제 갈게. 밀레느, 감린, 또 봐"

msgid "adv_104702_0022_msg"
msgstr "네!"

msgid "adv_104702_0023_msg"
msgstr "응, 또 같이 노래하자!"

msgid "adv_104702_0024_msg"
msgstr "…감린 씨, 오늘 제가 불렀는데도\\r\\n같이 있지 못해서 죄송해요"

msgid "adv_104702_0025_msg"
msgstr "사과라고 하긴 뭐하지만,\\r\\n이따 같이 카페라도 가지 않으실래요?"

msgid "adv_104702_0026_msg"
msgstr "네, 물론입니다!\\r\\n오늘 라이브 이야기를 들려주세요"

msgid "adv_104702_0027_msg"
msgstr "네!"

msgid "adv_100406901_0003_msg"
msgstr "정말… 바사라는 왜 항상 라이브에 늦는 거야!"

msgid "adv_100406901_0004_msg"
msgstr "분위기 띄웠으면 됐잖아. \\r\\n조금 늦은 것 정도는 신경 쓰지 마"

msgid "adv_100406901_0005_msg"
msgstr "신경 쓰이지! 조금은 반성해!"

msgid "adv_100406901_0006_msg"
msgstr "난 노래하고 싶을 때 노래하는 거야. 그게 뭐가 잘못됐는데?"

msgid "adv_100406901_0007_msg"
msgstr "…그럼 다음 라이브에는 나도 지각할 거야. \\r\\n그래도 괜찮아?"

msgid "adv_100406901_0008_msg"
msgstr "마음대로 하면 되잖아?"

msgid "adv_100406901_0009_msg"
msgstr "마음대로 할 수 있을 리가 없잖아!\\r\\n하아… 이제 몰라!"

msgid "adv_100406902_0003_msg"
msgstr "와~. 어려워 보이는 화면이 잔뜩이네…\\r\\n이거 지금 해킹하고 있는 거야?"

msgid "adv_100406902_0004_msg"
msgstr "해킹용 새 프로그램 만들고 있어.\\r\\n언제나 어딘가에 침입하고 있는 건 아니야"

msgid "adv_100406902_0005_msg"
msgstr "타깃을 철저하게 조사하고, 준비해서…\\r\\n공격할 때는 한순간에, 체크메이트"

msgid "adv_100406902_0006_msg"
msgstr "체크메이트! 으음, 왠지 멋있다!"

msgid "adv_100406902_0007_msg"
msgstr "…그래도 예전에 카오스 서버에 침입했을 때는,\\r\\n들켜서 혼났어"

msgid "adv_100406902_0008_msg"
msgstr "그 덕분에 왈큐레에 들어갈 수 있었지만…\\r\\n그때 진 건 아직도 꽤 분해"

msgid "adv_100406902_0009_msg"
msgstr "헤에, 레이나는 꽤 지기 싫어하는 성격이구나!"

msgid "adv_100406902_0010_msg"
msgstr "당연"

msgid "adv_100408101_0003_msg"
msgstr "밀레느.\\r\\n우리는 좀 더 친해질 필요가 있다고 생각해"

msgid "adv_100408101_0004_msg"
msgstr "어? 뭐야 레이나. 갑자기 왜 그래?"

msgid "adv_100408101_0005_msg"
msgstr "더더욱 친해져서,\\r\\n밀레느의 여러 이야기를 듣고 싶어"

msgid "adv_100408101_0006_msg"
msgstr "바사라랑 감린 중에 누굴 더 좋아하는지 같은 거"

msgid "adv_100408101_0007_msg"
msgstr "에!? 누, 누구를 더 좋아하고 그런 거 없어!"

msgid "adv_100408101_0008_msg"
msgstr "자세한 건 밤 파자마 파티에서 들을게"

msgid "adv_100408101_0009_msg"
msgstr "후후후~.\\r\\n오늘 밤은 긴 밤이 될 것 같은 예감…!"

msgid "adv_100408102_0003_msg"
msgstr "어디 보자, 이거랑 이거랑… 이것도 넣고, 좋아!\\r\\n레이나 씨, 이 정도면 어때요?"

msgid "adv_100408102_0004_msg"
msgstr "그렇군. 란카의 기묘하게 귀여운 사진 모음, 이번에도 수준이 높아…"

msgid "adv_100408102_0005_msg"
msgstr "에헤헤, 즐겨찾기 폴더에서 엄선해왔어요!"

msgid "adv_100408102_0006_msg"
msgstr "…100점. 역시 취향이 잘 맞아"

msgid "adv_100408102_0007_msg"
msgstr "특히 세 번째 캐릭터…\\r\\n자연계에선 살아남지 못할 것 같은 안타까운 느낌이 좋아"

msgid "adv_100408102_0008_msg"
msgstr "그런데 알토 군한테 그 사진을 보여줬더니\\r\\n깜짝 놀라더라고요… 귀여운데"

msgid "adv_100408102_0009_msg"
msgstr "후후후… 이 매력을 모르다니,\\r\\n알토도 아직 멀었네"

msgid "adv_001002_0003_msg"
msgstr "후후후"

msgid "adv_001002_0004_msg"
msgstr "레이레이, 이걸로 완성이네!\\r\\n브레브레 일행도 협력해줘서 다행이야!"

msgid "adv_001002_0005_msg"
msgstr "브레라 스턴, 좋은 느낌"

msgid "adv_001002_0006_msg"
msgstr "마키나! 레이나!\\r\\n안녕… 어라, 뭐 하고 있어?"

msgid "adv_001002_0007_msg"
msgstr "아, 민민이다!\\r\\n올해 만우절 준비 중이야!"

msgid "adv_001002_0008_msg"
msgstr "만우절?"

msgid "adv_001002_0009_msg"
msgstr "응"

msgid "adv_001002_0010_msg"
msgstr "올해 만우절은 조금 특별해"

msgid "adv_001002_0011_msg"
msgstr "있잖아, 있잖아! 민민은 게임 좋아해?"

msgid "adv_001002_0012_msg"
msgstr "게임…?\\r\\n글쎄, 별로 해본 적 없는 것 같아"

msgid "adv_001002_0013_msg"
msgstr "그렇구나"

msgid "adv_001002_0014_msg"
msgstr "그런 민민도 틀림없이 즐길 수 있을 거야!\\r\\n그럼 레이레이, 마지막 마무리하러 가자!"

msgid "adv_001002_0015_msg"
msgstr "알겠어"

msgid "adv_001002_0016_msg"
msgstr "…대체 어떤 만우절이 될까?"

msgid "adv_303901_0008_msg"
msgstr "…이런 느낌이면 어때? 밀레느"

msgid "adv_303901_0009_msg"
msgstr "정말 좋은데! 엄청 늘었네, 란카!"

msgid "adv_303901_0010_msg"
msgstr "고마워!\\r\\n밀레느 덕분이야…!"

msgid "adv_303901_0011_msg"
msgstr "안녕하세요~!"

msgid "adv_303901_0012_msg"
msgstr "프레이아!"

msgid "adv_303901_0013_msg"
msgstr "어라, 란카 씨, 피아노 치고 있는 건가요?"

msgid "adv_303901_0014_msg"
msgstr "응, 밀레느한테 배우고 있었어!"

msgid "adv_303901_0015_msg"
msgstr "언젠가 피아노 치면서 노래까지 할 수 있게 되면\\r\\n멋지겠다고 생각해서"

msgid "adv_303901_0016_msg"
msgstr "란카 씨가 피아노 치며 노래를…! 오오~!"

msgid "adv_303901_0017_msg"
msgstr "진짜 멋질 것 같아요!\\n저도 연습 구경해도 될까요?"

msgid "adv_303901_0018_msg"
msgstr "란카 씨 피아노 연주 들어보고 싶어요!"

msgid "adv_303901_0019_msg"
msgstr "에엣? 그런… 왠지 긴장되는데"

msgid "adv_303901_0020_msg"
msgstr "괜찮아, 란카!\\r\\n게다가 연주는 사람에게 들려주려고 하는 거잖아"

msgid "adv_303901_0021_msg"
msgstr "지금부터 누군가에게 들려주는 연습도\\r\\n제대로 해두자!"

msgid "adv_303901_0022_msg"
msgstr "그러네!\\r\\n그럼 처음부터 쳐볼게!"

msgid "adv_303901_0025_msg"
msgstr "와아…!\\r\\n란카 씨, 정말 멋졌어요!"

msgid "adv_303901_0026_msg"
msgstr "란카 씨가 연주하는 소리,\\r\\n진짜 아름다운 색이었어요!"

msgid "adv_303901_0027_msg"
msgstr "따뜻하고 다정한 산들바람 같은…"

msgid "adv_303901_0028_msg"
msgstr "정말? 프레이아한테 그렇게 말해주니\\r\\n기쁘다"

msgid "adv_303901_0029_msg"
msgstr "응응, 좋은 느낌이잖아!\\n이제 긴장하지 않을 때까지 반복 연습만 하면 돼"

msgid "adv_303901_0030_msg"
msgstr "알겠어, 고마워! 밀레느!"

msgid "adv_303901_0031_msg"
msgstr "악기라…"

msgid "adv_303901_0032_msg"
msgstr "프레이아도 뭔가 해보는 게 어때?\\n내가 할 줄 아는 악기라면 가르쳐줄게!"

msgid "adv_303901_0033_msg"
msgstr "호에!? 제, 제가 악기를…요!?"

msgid "adv_303901_0034_msg"
msgstr "후훗, 그래! 한번 해보자!"

msgid "adv_303902_0008_msg"
msgstr "프레이아.\\r\\n오늘 같이 무대에 서줘서\\r\\n정말 고마워!"

msgid "adv_303902_0009_msg"
msgstr "저야말로요! 진짜 영광이었어요!"

msgid "adv_303902_0010_msg"
msgstr "관객분들도 즐거워하신 것 같아서\\r\\n정말 정말 다행이에요!"

msgid "adv_303902_0011_msg"
msgstr "후훗, 그러게!\\r\\n처음에는 작은 음악회로 할 생각이었는데…"

msgid "adv_303902_0012_msg"
msgstr "밀레느와 셰릴 씨,\\r\\n그리고 카나메 씨 일행이 밀어준 덕분이네"

msgid "adv_303902_0013_msg"
msgstr "그러네요…!\\r\\n이렇게 많은 사람 앞에서 연주할 수 있게 되다니…"

msgid "adv_303902_0014_msg"
msgstr "모두에게도, 밀레느 선생님한테도 감사해야겠어요!"

msgid "adv_303902_0015_msg"
msgstr "하야테 군한테도?"

msgid "adv_303902_0016_msg"
msgstr "하, 하야테한테도요!?"

msgid "adv_303902_0017_msg"
msgstr "응! 하야테 군,\\r\\n프레이아가 바이올린을 시작했다는 걸\\r\\n알고 난 뒤부터…"

msgid "adv_303902_0018_msg"
msgstr "자주 연습 보러 와주고, 감상도 말해주고\\r\\n응원도 해줬잖아?"

msgid "adv_303902_0019_msg"
msgstr "하, 하지만 하야테는 연주하는 저를 보고\\r\\n『이상한 얼굴~!』 같은 말도 했는걸요?"

msgid "adv_303902_0020_msg"
msgstr "프레이아는 연주할 때 긴장해서\\r\\n너무 힘이 들어갈 때가 있었잖아"

msgid "adv_303902_0021_msg"
msgstr "하야테 군은\\r\\n그런 프레이아의 긴장을 풀어주려고\\r\\n그랬던 게 아닐까?"

msgid "adv_303902_0022_msg"
msgstr "그런 걸까요…?"

msgid "adv_303902_0023_msg"
msgstr "그래도 일단 보러 와주긴 했으니까\\n그건 고맙다고 말하려고요!"

msgid "adv_303902_0024_msg"
msgstr "응! 맞다, 밀레느한테 줄 답례도 생각해야지!\\r\\n뭐가 좋을까…?"

msgid "adv_303902_0025_msg"
msgstr "같이 생각할게요!\\n최고의 감사가 담긴 답례로 해야죠!"

msgid "adv_104801_0008_msg"
msgstr "셰리셰리, 안녕~!"

msgid "adv_104801_0009_msg"
msgstr "마키나! 마침 잘 왔어"

msgid "adv_104801_0010_msg"
msgstr "새 의상 때문에 상담하고 싶었거든"

msgid "adv_104801_0011_msg"
msgstr "물론이지! 마키마키한테 맡겨줘!"

msgid "adv_104801_0012_msg"
msgstr "이게 디자인인데,\\r\\n마키나 의견을 들려줘"

msgid "adv_104801_0013_msg"
msgstr "오~! 어디 보자…"

msgid "adv_104801_0014_msg"
msgstr "와아, 너무 귀여워~!"

msgid "adv_104801_0015_msg"
msgstr "그렇구나, 그렇구나…\\n이쪽 흰색은 귀여운 느낌이고,\\n검은색은 엄청 섹시하네!"

msgid "adv_104801_0016_msg"
msgstr "있잖아, 마키나. 이 두 의상 중에서\\r\\n딱 하나만 고르라고 한다면…"

msgid "adv_104801_0017_msg"
msgstr "마키나는 어느 쪽을 고를래?"

msgid "adv_104801_0018_msg"
msgstr "어? 둘 중 하나만!?"

msgid "adv_104801_0019_msg"
msgstr "그래, 하나만"

msgid "adv_104801_0020_msg"
msgstr "으음… 난 두 의상 다 좋아해서\\n하나만 고르라고 하면… 으음…"

msgid "adv_104801_0021_msg"
msgstr "…어려워! 못 고르겠어~!"

msgid "adv_104801_0022_msg"
msgstr "후훗, 역시 그렇게 되지"

msgid "adv_104801_0023_msg"
msgstr "무대에서 어느 의상을 쓸지\\r\\n계속 고민하고 있거든"

msgid "adv_104801_0024_msg"
msgstr "나중에 다시 생각해보고 의견을 보내주면 좋겠어"

msgid "adv_104801_0025_msg"
msgstr "으음… 알겠어. 생각해볼게!"

msgid "adv_104801_0026_msg"
msgstr "왈큐레 모두한테도,\\r\\n어느 쪽이 좋은지 물어볼까"

msgid "adv_104801_0027_msg"
msgstr "도움이 되겠어! 고마워, 마키나!"

msgid "adv_104802_0008_msg"
msgstr "수많은 우주에 존재하는 나의 가능성…"

msgid "adv_104802_0009_msg"
msgstr "그리고 지금, 우리가 보고 있는\\r\\n셰릴 놈의 가능성…"

msgid "adv_104802_0010_msg"
msgstr "셰릴"

msgid "adv_104802_0011_msg"
msgstr "알토…!"

msgid "adv_104802_0012_msg"
msgstr "라이브, 수고했어.\\r\\n오늘도 연출이 대단하더라"

msgid "adv_104802_0013_msg"
msgstr ""

msgid "adv_104802_0014_msg"
msgstr "왜 그래?"

msgid "adv_104802_0015_msg"
msgstr "있잖아, 알토는 하얀 나와 검은 나\\r\\n어느 쪽이 더 좋아?"

msgid "adv_104802_0016_msg"
msgstr "뭐!? 어느 쪽이 더 좋냐니…\\r\\n갑자기 무슨 소리야"

msgid "adv_104802_0017_msg"
msgstr "됐으니까! 진지하게 대답해!"

msgid "adv_104802_0018_msg"
msgstr "…정말. 글쎄…"

msgid "adv_104802_0019_msg"
msgstr "…둘 다 셰릴 놈다웠어.\\r\\n어느 쪽이 더 좋냐고 물어봐도 고르기 어렵네"

msgid "adv_104802_0020_msg"
msgstr "실제로 넌 악동처럼 보일 때도 있고\\r\\n천진난만하고 어린애처럼 보일 때도 있으니까"

msgid "adv_104802_0021_msg"
msgstr "오늘 무대는 정말\\r\\n그런 너한테 휘둘리는 기분이었어"

msgid "adv_104802_0022_msg"
msgstr "너의 그런 면을\\r\\n꽤 재미있다고 생각하는 사람도 있지 않을까?"

msgid "adv_104802_0023_msg"
msgstr "헤에… 고마워, 알토.\\r\\n그럭저럭 참고가 됐어"

msgid "adv_104802_0024_msg"
msgstr "그럭저럭이냐. 진지하게 대답해줬는데…"

msgid "adv_104802_0025_msg"
msgstr "후훗, 농담이야! 앞으로도\\r\\n너한테 『수많은 나』를 보여줄게!"

msgid "adv_104802_0026_msg"
msgstr "그래, 기대할게"

msgid "adv_100415301_0003_msg"
msgstr "하아… 요즘 피로가 잘 안 풀리네.\\r\\n있잖아, 미쿠모. 추천할 만한 휴식법 같은 거 없어?"

msgid "adv_100415301_0004_msg"
msgstr "글쎄… 그렇다면 수중 릴랙세이션은 어때?"

msgid "adv_100415301_0005_msg"
msgstr "수중 릴랙세이션?"

msgid "adv_100415301_0006_msg"
msgstr "말 그대로야. 물에 몸을 맡기는 거지"

msgid "adv_100415301_0007_msg"
msgstr "헤에, 좋은 걸 들었네.\\r\\n있잖아, 이왕이면 실제로 어떻게 하는지\\r\\n보여줘!"

msgid "adv_100415301_0008_msg"
msgstr "좋아"

msgid "adv_100415301_0009_msg"
msgstr "후훗, 결정됐네!\\r\\n대체 어떤 느낌일까… 기대돼!"

msgid "adv_100415302_0003_msg"
msgstr "셰리셰리, 무슨 좋은 일 있었어? 기분 좋아 보이네!"

msgid "adv_100415302_0004_msg"
msgstr "어머, 티 나? 아까 란카랑 외출하고 왔거든"

msgid "adv_100415302_0005_msg"
msgstr "에~ 둘이서? 좋겠다~! 뭐 하고 왔어?"

msgid "adv_100415302_0006_msg"
msgstr "기분 전환으로 쇼핑도 했고, 맛있는 것도 먹었고…\\r\\n즐거운 시간은 정말 금방 지나가네.\\r\\n전혀 부족했어"

msgid "adv_100415302_0007_msg"
msgstr "…잘 표현은 못 하겠는데"

msgid "adv_100415302_0008_msg"
msgstr "란카와 함께 신나게 놀다 보면,\\r\\n평범한 여자애가 된 것 같아서 왠지 기뻐"

msgid "adv_100415302_0009_msg"
msgstr "그렇구나… 잘됐네, 셰리셰리"

msgid "adv_100415302_0010_msg"
msgstr "응. 고마워, 마키나"

msgid "adv_1400601_0008_msg"
msgstr "바사라, 봐! 이 베이스 스탠드…!"

msgid "adv_1400601_0009_msg"
msgstr "후훗! 다음 라이브에서는\\r\\n여기에 에밀리아 언니가 서는구나…"

msgid "adv_1400601_0010_msg"
msgstr "다들 언니의 박력에\\r\\n깜짝 놀라서 날아가버리는 거 아닐까!"

msgid "adv_1400601_0011_msg"
msgstr "바사라. 우리 Fire Bomber도\\r\\n언니 노랫소리에 날아가버리지 않게\\r\\n엄청 달아오르게 해보자!"

msgid "adv_1400601_0012_msg"
msgstr "에밀리아의 노래가 대단한 건 맞지만…\\r\\n난 내 노래를 부를 뿐이야"

msgid "adv_1400601_0013_msg"
msgstr "정말, 맨날 그러잖아!"

msgid "adv_1400601_0014_msg"
msgstr "…그런데, 바사라"

msgid "adv_1400601_0015_msg"
msgstr "뭐야"

msgid "adv_1400601_0016_msg"
msgstr "나 아직 못 들었는데"

msgid "adv_1400601_0017_msg"
msgstr "뭘?"

msgid "adv_1400601_0018_msg"
msgstr "바사라랑 우리 언니가\\r\\n언제 그렇게 친해졌는지 말이야!"

msgid "adv_1400601_0019_msg"
msgstr "이제 슬슬 알려줘도 되잖아!"

msgid "adv_1400601_0020_msg"
msgstr "있잖아, 바사라~!"

msgid "adv_1400601_0021_msg"
msgstr "정말, 시끄럽네"

msgid "adv_1400601_0022_msg"
msgstr "뭐야 그게~!"

msgid "adv_1400601_0023_msg"
msgstr "또 그러고 있냐, 너희"

msgid "adv_1400601_0024_msg"
msgstr "레이!"

msgid "adv_1400601_0025_msg"
msgstr "밀레느가 혼자 떠드는 것뿐이야"

msgid "adv_1400601_0026_msg"
msgstr "뭐라고~!?"

msgid "adv_1400601_0027_msg"
msgstr "자자, 밀레느.\\r\\n…확실히 바사라 쪽에서 『노래 대결하고 싶은 녀석이 있어』\\r\\n같은 말을 먼저 꺼내는 건 드문 일이긴 하지"

msgid "adv_1400601_0028_msg"
msgstr "…하지만 바사라는 이유를 말할 생각이 없는 거지?"

msgid "adv_1400601_0029_msg"
msgstr "나랑 에밀리아가 어떻고 하는 건, 내가 알려주지 않아도\\r\\n언젠가는 알게 돼"

msgid "adv_1400601_0030_msg"
msgstr "…? 무슨 뜻이야?"

msgid "adv_1400601_0031_msg"
msgstr "노래하면 알아"

msgid "adv_1400602_0008_msg"
msgstr "바사라, 수고했어!"

msgid "adv_1400602_0009_msg"
msgstr "별로 안 피곤해"

msgid "adv_1400602_0010_msg"
msgstr "정말! 챙겨주는 거니까\\r\\n좀 솔직하게 받아들이라고"

msgid "adv_1400602_0011_msg"
msgstr "…난 아직 한참 더 노래하고 싶어"

msgid "adv_1400602_0012_msg"
msgstr "너희랑 서로 노래했던 시간도 나쁘지 않았으니까"

msgid "adv_1400602_0013_msg"
msgstr ""

msgid "adv_1400602_0014_msg"
msgstr "뭐야, 이상한 표정 짓고"

msgid "adv_1400602_0015_msg"
msgstr "후훗, 아무것도 아니야!\\r\\n바사라, 나도 즐거웠어!"

msgid "adv_1400602_0016_msg"
msgstr "언니랑 맞춰 입은 의상으로\\r\\n노래할 수 있었던 것도 정말 기뻤고!"

msgid "adv_1400602_0017_msg"
msgstr "…그래"

msgid "adv_1400602_0018_msg"
msgstr "그럼 난 이제 간다.\\r\\n에밀리아한테 다음에 또 하자고 전해줘"

msgid "adv_1400602_0019_msg"
msgstr "…기다려, 바사라!"

msgid "adv_1400602_0020_msg"
msgstr "뭐야?"

msgid "adv_1400602_0021_msg"
msgstr "…바사라는, 말이야"

msgid "adv_1400602_0022_msg"
msgstr "『그 시공』에서도\\r\\n언니와 서로의 마음을 울려 퍼뜨렸던 거지"

msgid "adv_1400602_0023_msg"
msgstr "오늘처럼 뜨겁고, 격렬하게,\\r\\n날아가버릴 것 같으면서도…!"

msgid "adv_1400602_0024_msg"
msgstr ""

msgid "adv_1400602_0025_msg"
msgstr "…거봐. 말했잖아? 노래하면 안다고"

msgid "adv_1400602_0026_msg"
msgstr "응!"

msgid "adv_104901_0008_msg"
msgstr "으음…"

msgid "adv_104901_0009_msg"
msgstr "다음 라이브에서 부를 곡, 뭔가 마음에 안 드네요…"

msgid "adv_104901_0010_msg"
msgstr "미쿠모 씨가 노래할 때처럼\\n좀 더 반짝반짝~한 느낌으로 부르고 싶은데…"

msgid "adv_104901_0011_msg"
msgstr "으으… 이대로는 안 되겠어.\\n더더욱 연습해야 해!"

msgid "adv_104901_0012_msg"
msgstr "프레이아!"

msgid "adv_104901_0013_msg"
msgstr "카나메 씨?"

msgid "adv_104901_0014_msg"
msgstr "레슨 수고했어.\\r\\n시원한 사과 주스라도 마실래?"

msgid "adv_104901_0015_msg"
msgstr "감사합니다!\\r\\n조금 쉬었다가 다시 레슨 열심히 할게요!"

msgid "adv_104901_0016_msg"
msgstr "안 돼"

msgid "adv_104901_0017_msg"
msgstr "호엣?"

msgid "adv_104901_0018_msg"
msgstr "오늘은 이제 일찍 들어가서 푹 쉬도록 해"

msgid "adv_104901_0019_msg"
msgstr "그, 그런…! 왜요?"

msgid "adv_104901_0020_msg"
msgstr "『서두른 해파리는 해변에서 말라버린다』"

msgid "adv_104901_0021_msg"
msgstr "…해파리?"

msgid "adv_104901_0022_msg"
msgstr "서두르면 안 된다는 뜻이야, 프레이아"

msgid "adv_104901_0023_msg"
msgstr "가장 안 좋은 건,\\r\\n조급한 나머지 자기 자신을 잃어버리는 거니까"

msgid "adv_104901_0024_msg"
msgstr "조급해하지 말고, 느긋하게 가자!\\r\\n내일부터는 우리도 더 많이 도와줄 테니까. 응?"

msgid "adv_104901_0025_msg"
msgstr "...카나메 씨"

msgid "adv_104901_0026_msg"
msgstr "…그러네요. 조급해하면 안 되는 거죠!"

msgid "adv_104901_0027_msg"
msgstr "알겠습니다. 내일 다시,\\r\\n여러분과 함께 열심히 해볼게요!"

msgid "adv_104901_0028_msg"
msgstr "감사합니다, 카나메 씨!"

msgid "adv_104901_0029_msg"
msgstr "천만에. 내일 또 보자, 프레이아"

msgid "adv_104901_0030_msg"
msgstr "네엣!"

msgid "adv_104901_0031_msg"
msgstr "『느긋하게 가자』…라"

msgid "adv_104901_0032_msg"
msgstr "이번에는 내가\\r\\n그 말을 해주는 입장이 되다니…"

msgid "adv_104901_0033_msg"
msgstr "카나메 씨"

msgid "adv_104901_0034_msg"
msgstr "아라드 대장! 수고하셨습니다"

msgid "adv_104901_0035_msg"
msgstr "수고하셨습니다.\\r\\n다음 라이브를 할 행성이 정해졌다고 하는데…\\r\\n벌써 들으셨나요?"

msgid "adv_104901_0036_msg"
msgstr "아니요, 아직입니다. 어디로 정해졌나요?"

msgid "adv_104901_0037_msg"
msgstr "…카나메 씨 일행에게는,\\r\\n그리운 장소가 될지도 모르겠네요"

msgid "adv_104901_0038_msg"
msgstr "네…?"

msgid "adv_104902_0008_msg"
msgstr "카나메 씨, 진짜 즐거운 라이브였죠!"

msgid "adv_104902_0009_msg"
msgstr "그러네!"

msgid "adv_104902_0010_msg"
msgstr "연습하던 노래도 정말 좋았어, 프레이아"

msgid "adv_104902_0011_msg"
msgstr "네 노래를 듣고 있으니까\\r\\n나도 모르게 눈물이 날 정도였어!"

msgid "adv_104902_0012_msg"
msgstr "네…?"

msgid "adv_104902_0013_msg"
msgstr "…미쿠모가 왈큐레에 들어왔을 때\\r\\n나는 결심했어"

msgid "adv_104902_0014_msg"
msgstr "앞으로는 리더로서\\r\\n왈큐레를 최고의 그룹으로 만들겠다고"

msgid "adv_104902_0015_msg"
msgstr "오늘, 우리 노래가 닿지 않았던 이 행성에\\r\\n최고의 노랫소리가 울려 퍼지고…"

msgid "adv_104902_0016_msg"
msgstr "그때의 결심이 보답받은 것 같은 기분이 들었어"

msgid "adv_104902_0017_msg"
msgstr "카나메 씨…"

msgid "adv_104902_0018_msg"
msgstr "…왈큐레에 와줘서 고마워, 프레이아"

msgid "adv_104902_0019_msg"
msgstr "조금 뜻밖의 만남이긴 했지만 너를 선택하길,\\n정말 잘했다고 생각해"

msgid "adv_104902_0020_msg"
msgstr "너와 미쿠모, 마키나와 레이나는\\r\\n왈큐레에게 이보다 더 좋을 수 없는\\r\\n최고의 멤버라고 생각해"

msgid "adv_104902_0021_msg"
msgstr "…나는 앞으로도 너희를 계속 지탱해줄 거야.\\r\\n왈큐레를 최고이자 최강의 그룹으로 만들기 위해서!"

msgid "adv_104902_0022_msg"
msgstr "최고이자 최강… 분명 될 수 있어요!"

msgid "adv_104902_0023_msg"
msgstr "카나메 씨는 진짜 대단한 리더니까요!"

msgid "adv_104902_0024_msg"
msgstr "프레이아…"

msgid "adv_104902_0025_msg"
msgstr "카나카나, 프레프레!"

msgid "adv_104902_0026_msg"
msgstr "마키나?"

msgid "adv_104902_0027_msg"
msgstr "슬슬 다음 곡 시작해버려!\\r\\n무대로 가자!"

msgid "adv_104902_0028_msg"
msgstr "같이 노래하러 가요, 카나메 씨!"

msgid "adv_104902_0029_msg"
msgstr "그래, 가자!"

msgid "adv_100423701_0003_msg"
msgstr "저기, 미쿠모 씨! 괜찮으시면 오늘 같이\\n점심 먹지 않으실래요!?"

msgid "adv_100423701_0004_msg"
msgstr "좋아"

msgid "adv_100423701_0005_msg"
msgstr "에에엣? 정말 괜찮아요!?"

msgid "adv_100423701_0006_msg"
msgstr "자기가 먼저 불러놓고 놀라다니… 여전히 재미있네"

msgid "adv_100423701_0007_msg"
msgstr "죄송해요! 그래도 진짜 기뻐요!\\r\\n같이 점심을 먹는다는 게 뭔가 이렇게,\\r\\n더 친해진 것 같다고 해야 하나"

msgid "adv_100423701_0008_msg"
msgstr "그래? 뭐, 상관없지만.\\r\\n그래서 어디로 먹으러 갈 거야?"

msgid "adv_100423701_0009_msg"
msgstr "네엣! 안내할게요!!"

msgid "adv_100423702_0003_msg"
msgstr "카나메 씨, 저 어른스러운 여성을 목표로 하기로 했어요!"

msgid "adv_100423702_0004_msg"
msgstr "어른스러운 여성? 갑자기 웬일이야… 무슨 일 있었어?"

msgid "adv_100423702_0005_msg"
msgstr "카나메 씨를 보고 생각했어요!\\r\\n진짜 멋있다고!\\r\\n노래도 춤도 완벽하고, 사무 업무도 척척 해내시고…"

msgid "adv_100423702_0006_msg"
msgstr "그리고 일이 끝나면 네코쿠라게에서 한잔!"

msgid "adv_100423702_0007_msg"
msgstr "윈더미어인으로서는 저도 이미 어른이지만,\\r\\n뭔가 다르다고 해야 하나… 동경하게 돼요!"

msgid "adv_100423702_0008_msg"
msgstr "후훗, 고마워. 그럼 프레이아가\\r\\n어른스러운 여성이 될 수 있게 나도 도와줘야겠네"

msgid "adv_100423702_0009_msg"
msgstr "정말인가요!? 감사합니다!"

msgid "adv_304001_0008_msg"
msgstr "앗. 마키나, 봐.\\r\\n이 예식장도 멋지지 않아?"

msgid "adv_304001_0009_msg"
msgstr "어디 보자?\\n…와아, 너무 귀여워~!"

msgid "adv_304001_0010_msg"
msgstr "정원에 채플도 있고, 안뜰이랑\\r\\n댄스홀도 있대!"

msgid "adv_304001_0011_msg"
msgstr "영화에 나오는 세트 같네~!"

msgid "adv_304001_0012_msg"
msgstr "…에헤헤"

msgid "adv_304001_0013_msg"
msgstr "…? 왜 그래?"

msgid "adv_304001_0014_msg"
msgstr "왠지 말이야.\\n이렇게 웨딩 잡지를 보고 있으니까\\n정말 결혼식을 준비하는 것 같은 기분이 든다고 해야 하나…"

msgid "adv_304001_0015_msg"
msgstr "후훗. 듣고 보니 그럴지도 모르겠네"

msgid "adv_304001_0016_msg"
msgstr "이번에 마키나랑 웨딩드레스\\r\\n촬영 일을 하게 돼서\\r\\n참고가 될까 싶었는데…"

msgid "adv_304001_0017_msg"
msgstr "나도 이런 걸 읽는 건 처음이라\\r\\n왠지 두근거리기 시작했어"

msgid "adv_304001_0018_msg"
msgstr "그렇지~!"

msgid "adv_304001_0019_msg"
msgstr "…정말 결혼할 때는\\r\\n사랑하는 사람이랑 같이 이런 잡지를 보면서\\r\\n상상을 펼쳐나가는 걸까?"

msgid "adv_304001_0020_msg"
msgstr "힘들긴 해도 분명 즐겁겠지…"

msgid "adv_304001_0021_msg"
msgstr "그러네…"

msgid "adv_304001_0022_msg"
msgstr ""

msgid "adv_304001_0023_msg"
msgstr "아니! 넋 놓고 있을 때가 아니야!"

msgid "adv_304001_0024_msg"
msgstr "촬영 테마를\\r\\n우리가 생각해야 하는데"

msgid "adv_304001_0025_msg"
msgstr "한 페이지 볼 때마다 넋을 놓고 있어서\\r\\n전혀 못 정했어!"

msgid "adv_304001_0026_msg"
msgstr "그야 전부 멋져서 눈이 돌아가는걸"

msgid "adv_304001_0027_msg"
msgstr "그러니까~!"

msgid "adv_304001_0028_msg"
msgstr ""

msgid "adv_304001_0029_msg"
msgstr ""

msgid "adv_304001_0030_msg"
msgstr "…있잖아, 마키나.\\n다른 사람들 의견을 들어보는 건\\n어떨까?"

