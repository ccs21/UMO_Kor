msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "tips_0000_title"
msgstr "【스킬】스코어 상승이 뭐야?"

msgid "tips_0000_msg"
msgstr "발동하면 획득 점수가 올라가\n집중해서 노트를 탭해보자"

msgid "tips_0001_title"
msgstr "【스킬】라이프 회복이 뭐야?"

msgid "tips_0001_msg"
msgstr "발동하면 라이프가 회복돼\n곤경에 처했을 때 구해줄 수 있는 스킬이지"

msgid "tips_0002_title"
msgstr "【스킬】대미지 감소가 뭐야?"

msgid "tips_0002_msg"
msgstr "발동하면 대미지가 감소해\n계속 노래하기 위해 중요한 스킬이지"

msgid "tips_0003_title"
msgstr "【스킬】판정 완화가 뭐야?"

msgid "tips_0003_msg"
msgstr "발동하면 탭 판정이 완화돼\n탭이 잘 안 될 때는 이거야!"

msgid "tips_0004_title"
msgstr "【스킬】콤보 지속이 뭐야?"

msgid "tips_0004_msg"
msgstr "발동하면 콤보가 끊어지지 않게 돼\n스코어 상승에 도움이 되는 스킬이지"

msgid "tips_0005_title"
msgstr "캬와와 갤러리"

msgid "tips_0005_msg"
msgstr "란란의 생일 베스트 샷 사진이야!\n란란 너무 캬와와~!"

msgid "tips_0006_title"
msgstr "초가희 모드가 뭐야?"

msgid "tips_0006_msg"
msgstr "발키리로 전투 중, 추격 모드에서 적을\n격퇴하면 발생하는 특별한 라이브야!"

msgid "tips_0007_title"
msgstr "유닛 세트가 뭐야?"

msgid "tips_0007_msg"
msgstr "편성해둔 유닛이 맘에 들면\n그 유닛을 저장해둘 수 있어"

msgid "tips_0008_title"
msgstr "새 인간이 뭐야?"

msgid "tips_0008_msg"
msgstr "프로토 컬쳐가 남긴 거대 병기야\n기억을 망가뜨리는 무시무시한 존재야"

msgid "tips_0009_title"
msgstr "풀콤보 요령"

msgid "tips_0009_msg"
msgstr "판정 완화 스킬을 사용하면 어려운 악곡도\n풀콤보가 가능해질 수도 있어"

msgid "tips_0010_title"
msgstr "초시공 SNS가 뭐야?"

msgid "tips_0010_msg"
msgstr "시공을 초월한 소통이 가능한\n매우 굉장한 SNS 앱"

msgid "tips_0011_title"
msgstr "타이밍 조정이 뭐야?"

msgid "tips_0011_msg"
msgstr "음표와 악곡의 타이밍이 어긋난다....\n이럴 때는 타이밍 조정을 시도해 보자"

msgid "tips_0012_title"
msgstr "능력 해방이 뭐야?"

msgid "tips_0012_msg"
msgstr "능력 해방으로 에피소드\n플레이트를 강화하자!"

msgid "tips_0013_title"
msgstr "에피소드 플레이트가 뭐야?"

msgid "tips_0013_msg"
msgstr "이 세상의 기억의 파편 같은 것?\n그래서 다양한 이미지가 존재하는 거야"

msgid "tips_0014_title"
msgstr "자동 편성이 뭐야?"

msgid "tips_0014_msg"
msgstr "유닛 편성이 어려울 때는 이것!\n적합한 유닛을 자동으로 편성해줘"

msgid "tips_0015_title"
msgstr "에피소드가 뭐야?"

msgid "tips_0015_msg"
msgstr "에피소드를 해방해가는 과정에서,\n의상과 발키리를 얻을 수 있어"

msgid "tips_0016_title"
msgstr "의상이 뭐야?"

msgid "tips_0016_msg"
msgstr "의상에 따라 스테이터스가 달라져\n다양한 의상을 입고 라이브를 즐기자!"

msgid "tips_0017_title"
msgstr "프레이아의 비밀"

msgid "tips_0017_msg"
msgstr "머리에 있는 이건 '룬'이라고 불러!\n반짝반짝 빛나서 굉장하지?"

msgid "tips_0018_title"
msgstr "미쿠모의 비밀"

msgid "tips_0018_msg"
msgstr "유감스럽게도 내 비밀은\n그렇게 쉽게 알려줄 수 없어"

msgid "tips_0019_title"
msgstr "카나메의 비밀"

msgid "tips_0019_msg"
msgstr "솔로로 활동하던 시절이 있었어\n지금은 왈큐레 외에는 생각할 수 없지만"

msgid "tips_0020_title"
msgstr "마키나의 비밀"

msgid "tips_0020_msg"
msgstr "우리 할아버지는 정비공이셨어\n나도 메카메카 너무 좋아해~♪"

msgid "tips_0021_title"
msgstr "레이나의 비밀"

msgid "tips_0021_msg"
msgstr "해파리는 날 것을 통으로 꿀꺽"

msgid "tips_0022_title"
msgstr "란카의 비밀"

msgid "tips_0022_msg"
msgstr "실은, 미스 마크로스 프론티어는\n오빠 몰래 응모해 버렸어!"

msgid "tips_0023_title"
msgstr "셰릴의 비밀"

msgid "tips_0023_msg"
msgstr "갤럭시에는 많은 추억이 있어\n더 이상 말할 수 없을 정도로"

msgid "tips_0024_title"
msgstr "밀레느의 비밀"

msgid "tips_0024_msg"
msgstr "우리 집에는 언니가 6명이나 있어.\n막내딸이라고 해서 어린애 취급하지 말아줘!"

msgid "tips_0025_title"
msgstr "바사라의 비밀"

msgid "tips_0025_msg"
msgstr "비밀로 하고 있는 건 아무것도 없어.\n나는 언제든 내 노래를 부를 뿐이다!"

msgid "tips_0026_title"
msgstr "민메이의 비밀"

msgid "tips_0026_msg"
msgstr "사실 레슨 중에 잠깐씩 빠져나와서\n시내에 나갈 때도 있어!"

msgid "tips_0027_title"
msgstr "발키리가 뭐야?"

msgid "tips_0027_msg"
msgstr "3단 변형이 가능한 전투기야\n기체마다 성능이나 특성이 달라"

msgid "tips_0028_title"
msgstr "기억의 시공이 뭐야?"

msgid "tips_0028_msg"
msgstr "전 세계 사람들의 기억이 존재하는 곳이야\n우리의 노래로 그 기억을 복원할 수 있어"

msgid "tips_0029_title"
msgstr "라이브의 비밀"

msgid "tips_0029_msg"
msgstr "특정 유닛 편성으로 라이브를 하면\n연출이 달라지는 경우가 있는 것 같아"

msgid "tips_0030_title"
msgstr "서비스 가챠가 뭐야?"

msgid "tips_0030_msg"
msgstr "하루에 3번까지 뽑을 수 있는 가챠야\n아침, 점심, 저녁에 한 번씩, 잊지 마"

msgid "tips_0031_title"
msgstr "미션이 뭐야?"

msgid "tips_0031_msg"
msgstr "클리어하면 보상을 받을 수 있어\n열심히 도전해 보자!"

msgid "tips_0032_title"
msgstr "칭호가 뭐야?"

msgid "tips_0032_msg"
msgstr "이벤트에서 열심히 하면 받을 수 있어\n그 외에도 다양한 방법으로 얻을 수 있어"

msgid "tips_0033_title"
msgstr "데이터 인계가 뭐야?"

msgid "tips_0033_msg"
msgstr "기종 변경을 할 때에는,\n데이터 인계를 잊지 마!"

msgid "tips_0034_title"
msgstr "악곡 레벨이 뭐야?"

msgid "tips_0034_msg"
msgstr "같은 난이도라도 악곡마다 레벨이 있어\n난이도가 높은 악곡일수록 더 어려워"

msgid "tips_0035_title"
msgstr "액티브 스킬이 뭐야?"

msgid "tips_0035_msg"
msgstr "임의의 타이밍에 발동할 수 있는 스킬이야\n필요할 때 사용해 보자"

msgid "tips_0036_title"
msgstr "생체 폴드파가 뭐야?"

msgid "tips_0036_msg"
msgstr "우리의 노래의 힘, 그 자체야\n새 인간에 대항할 수 있는 유일한 수단이야"

msgid "tips_0037_title"
msgstr "레어도가 뭐야?"

msgid "tips_0037_msg"
msgstr "레어도가 높은 에피소드 플레이트일수록\n강력한 스킬을 발동할 수 있어"

msgid "tips_0038_title"
msgstr "이어하기가 뭐야?"

msgid "tips_0038_msg"
msgstr "라이브에 실패했을 때, 가정석을 이용해\n다시 도전할 수 있어"

msgid "tips_0039_title"
msgstr "EXTREAM이 뭐야?"

msgid "tips_0039_msg"
msgstr "매우 어려운 악곡 난이도야\n실력에 자신이 있다면 도전해 봐"

msgid "tips_0040_title"
msgstr "발키리 모드가 뭐야?"

msgid "tips_0040_msg"
msgstr "생체 폴드파를 높이면 발동돼\n노래의 힘으로 파일럿을 응원해 줘"

msgid "tips_0041_title"
msgstr "아이템 노트가 뭐야?"

msgid "tips_0041_msg"
msgstr "탭하면 아이템을 획득할 수 있어\n무엇을 얻을 수 있을지 기대되네!"

msgid "tips_0042_title"
msgstr "레어 아이템 노트가 뭐야?"

msgid "tips_0042_msg"
msgstr "보다 호화로운 아이템을 획득할 수 있어\n놓치지 말고 탭해보자!"

msgid "tips_0043_title"
msgstr "LUCK이 뭐야?"

msgid "tips_0043_msg"
msgstr "LUCK이 높을 수록 레어 아이템 노트가\n더 많이 출현하게 돼"

msgid "tips_0044_title"
msgstr "레어도 상승이 뭐야?"

msgid "tips_0044_msg"
msgstr "같은 에피소드 플레이트 2장으로\n레어도를 하나 올릴 수 있어"

msgid "tips_0045_title"
msgstr "시크릿 보드가 뭐야?"

msgid "tips_0045_msg"
msgstr "같은 에피소드 플레이트 3개가 있으면\n더 많은 능력을 해방할 수 있어"

msgid "tips_0046_title"
msgstr "View(가희)가 뭐야?"

msgid "tips_0046_msg"
msgstr "우리 모습을 자세히 볼 수 있어\n부끄러우니까 너무 많이 보진 말아줘"

msgid "tips_0047_title"
msgstr "View(발키리)가 뭐야?"

msgid "tips_0047_msg"
msgstr "캬와와~한 발키리쨩을\n구석구석 자세히 관찰할 수 있어♪"

msgid "tips_0048_title"
msgstr "분장실이 뭐야?"

msgid "tips_0048_msg"
msgstr "가희와 의상을 갈아입을 수 있어\n어떤게 가장 마음에 들어?"

msgid "tips_0049_title"
msgstr "플릭 노트가 뭐야?"

msgid "tips_0049_msg"
msgstr "라이브 중에 나타나면,\n노트가 뾰족한 방향으로 플릭해"

msgid "tips_0050_title"
msgstr "데카르 가챠가 뭐야?"

msgid "tips_0050_msg"
msgstr "가정석으로 뽑을 수 있는 뽑기야\n어떤게 나올지 기대되네"

msgid "tips_0051_title"
msgstr "라이브 클리어 요령"

msgid "tips_0051_msg"
msgstr "라이브가 어려워서 클리어할 수 없을 때는,\n라이프를 강화해보는 것을 추천할게"

msgid "tips_0052_title"
msgstr "캬와와 갤러리"

msgid "tips_0052_msg"
msgstr "란란의 생일 베스트샷 사진이야!\n란란의 발랄한 모습도 캬와와~멋져♪"

msgid "tips_0053_title"
msgstr "노트 스피드 설정이 뭐야?"

msgid "tips_0053_msg"
msgstr "노트의 스피드는, 라이브 시작 전\n「게임 설정」 화면에서 설정할 수 있어"

msgid "tips_0054_title"
msgstr "TOTAL을 더 올리자!"

msgid "tips_0054_msg"
msgstr "TOTAL이 낮아서 고민이야?\n그렇다면 플레이트를 강화해 봐"

msgid "tips_0055_title"
msgstr "더 많은 콤보를 연결해 보자!"

msgid "tips_0055_msg"
msgstr "탭 실패가 많을 때는 콤보 지속 스킬이나,\n판정 완화 스킬을 사용하면 좋다더라"

msgid "tips_0056_title"
msgstr "고난이도 레벨에 도전해 보자!"

msgid "tips_0056_msg"
msgstr "지금보다 더 높은 난이도에 도전해 보지 않을래?\n잘하면 더 많은 스코어를 올릴 수 있을 거야"

msgid "tips_0057_title"
msgstr "스코어 상승 스킬을 사용해보자!"

msgid "tips_0057_msg"
msgstr "전력 차이가 없는데도 이길 수 없을 때는\n스코어 상승 스킬이 효과적입니다"

msgid "tips_0058_title"
msgstr "럭키 리프가 뭐야?"

msgid "tips_0058_msg"
msgstr "럭키 리프를 해방하면\n라이브 중에 뭔가 좋은 일이 생길지도 몰라"

msgid "tips_0059_title"
msgstr "노트 디자인 설정이 뭐야?"

msgid "tips_0059_msg"
msgstr "노트의 외형을 바꾸고 싶다면\n「게임 설정」 화면에서 변경할 수 있어"

msgid "tips_0060_title"
msgstr "케이오스 교환소가 뭐야?"

msgid "tips_0060_msg"
msgstr "다양한 아이템을 교환할 수 있어\n기간 한정 아이템도 있으니 잊지 말고 확인해 보자"

msgid "tips_0061_title"
msgstr "초시공 프리즘이 뭐야?"

msgid "tips_0061_msg"
msgstr "가희와 의상의 외견을 바꿀 수 있는\n매우 굉장한 기능"

msgid "tips_0062_title"
msgstr "시뮬레이션 라이브가 뭐야?"

msgid "tips_0062_msg"
msgstr "S-LIVE 토큰을 사용하면\n우리의 라이브를 천천히 감상할 수 있어"

msgid "tips_0063_title"
msgstr "이벤트 스토리가 뭐야?"

msgid "tips_0063_msg"
msgstr "놓친 이벤트의 초시공 SNS는\nSNS 언록 키로 다시 볼 수 있어"

msgid "tips_0064_title"
msgstr "「데카르챠」가 뭐야?"

msgid "tips_0064_msg"
msgstr "젠트라디어 중 하나인데\n놀라움이나 감동을 표현할 때 사용해"

msgid "tips_0065_title"
msgstr "큐루루가 뭐야?"

msgid "tips_0065_msg"
msgstr "우리가 키우고 있는 바다고양이야\n사실 저 줄무늬는 옷의 무늬야"

msgid "tips_0066_title"
msgstr "도롱뇽씨가 뭐야?"

msgid "tips_0066_msg"
msgstr "내가 가지고 있는 핸드폰의 이름이야!\n생물 같아서 귀엽지?"

msgid "tips_0067_title"
msgstr "공중기사단이 뭐야?"

msgid "tips_0067_msg"
msgstr "윈더미어 왕국의 가변 전투기 부대다\n성기사단장은 로이드가 맡고 있지"

msgid "tips_0068_title"
msgstr "델타 소대가 뭐야?"

msgid "tips_0068_msg"
msgstr "왈큐레를 호위하는 발키리 부대다\n라이브의 공연도 겸하고 있지"

msgid "tips_0069_title"
msgstr "S.M.S가 뭐야?"

msgid "tips_0069_msg"
msgstr "S.M.S는 민간군사기업이야\n신형 항공기 평가 시험 같은 것도 하는 것 같아"

msgid "tips_0070_title"
msgstr "냥냥이 뭐야?"

msgid "tips_0070_msg"
msgstr "숙부가 운영하는 중국집이야\n모든 요리가 정말 맛있어!"

msgid "tips_0071_title"
msgstr "젠트라디가 뭐야?"

msgid "tips_0071_msg"
msgstr "거대하고 강인한 육체를 가진 거인족인데,\n지금은 지구 인류와 공존하고 있어"

msgid "tips_0072_title"
msgstr "바쥬라가 뭐야?"

msgid "tips_0072_msg"
msgstr "벌레처럼 생긴 우주 생물인데,\n집단으로 공격해 올 때도 있어"

msgid "tips_0073_title"
msgstr "캬와와 갤러리"

msgid "tips_0073_msg"
msgstr "란란 생일 베스트샷 사진이야!\n반짝반짝해서 정말 멋지지~?"

msgid "tips_0074_title"
msgstr "의상 강화가 뭐야?"

msgid "tips_0074_msg"
msgstr "내가 가지고 있는 의상을 강화할 수 있어요\n캬와와~한 색상의 의상이 해방될 지도?"

msgid "tips_0075_title"
msgstr "오퍼레이션이 뭐야?"

msgid "tips_0075_msg"
msgstr "발키리 소대에 오퍼레이션을 의뢰\n그리고 기다릴 뿐"

msgid "tips_0076_title"
msgstr "가희 오퍼레이션이 뭐야?"

msgid "tips_0076_msg"
msgstr "우리 가희들의 개인적인 부탁"

msgid "tips_0077_title"
msgstr "슬라이트 노트가 뭐야?"

msgid "tips_0077_msg"
msgstr "레인을 가로지르는 롱노트야\n손가락을 떼지 않고 움직이면 돼"

msgid "tips_0078_title"
msgstr "캬와와 갤러리"

msgid "tips_0078_msg"
