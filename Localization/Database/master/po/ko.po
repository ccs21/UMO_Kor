msgid "e_dsc_0031"
msgstr "델타 소대의 파일럿, 미라쥬의 탑승기.\n멋대로 구는 하야테에 질려서\n어쩔 수 없이 쫓아온 것 같다."

msgid "e_dsc_0032"
msgstr "마크로스 콘첼이 극비리에 개발한\n자율형 무인 전투기. 샤론 애플로부터\n얻은 데이터가 인공지능에 적용되고 있다."

msgid "e_dsc_0033"
msgstr "이사무가 테스트 파일럿을 맡은 시제품.\n고도의 조종기술이 요구되지만, 항공역학을\n추구한 설계로 높은 운동 성능을 자랑한다."

msgid "e_dsc_0034"
msgstr "걸드가 테스트 파일럿으로 참여한 시제품.\n혁신적 기술의 정수를 모아 개발되어\n매우 고차원적인 성능을 갖추게 되었다."

msgid "e_dsc_0035"
msgstr "프론티어 함대를 습격한 초시공 생명체.\n이 개체에게 특별한 능력은 없으며, 평소와 같이\n스킬을 발휘할 수 있다면 격퇴는 어렵지 않다."

msgid "e_dsc_0036"
msgstr "신 통합군의 주력 가변형 전투기.\n특별한 능력은 없으며, 평상시대로의 스킬을\n발휘할 수 있다면 격퇴는 어렵지 않다."

msgid "e_dsc_0037"
msgstr "란카가 애용하는 바이오 셀룰러(생체 휴대폰).\n녹색과 주황색 2종류가 존재하며,\n음악 플레이어 등 다양한 기능을 가지고 있다."

msgid "e_dsc_0038"
msgstr "밀레느와 항상 함께 하는 은하긴털쥐.\n감정을 주고받는 능력을 가지고 있으며,\n항상 밀레느와 같은 표정을 짓고 있다."

msgid "e_dsc_0039"
msgstr "회유하는 은하 고래를 노리는 밀렵단의 모선.\n무리를 지키고 있는 흰 은하 고래를 상대로,\n반응탄을 사용하여 제거를 계획하고 있다."

msgid "e_dsc_0040"
msgstr "프론티어 함대를 습격한 초시공 생명체.\n이 개체에게 특별한 능력은 없으며, 평상시처럼\n스킬을 발휘할 수 있다면 격퇴는 어렵지 않다."

msgid "e_dsc_0041"
msgstr "마크로스 콘첼이 극비리에 개발한\n자율형 무인 전투기. 샤론 애플로부터\n얻은 데이터가 인공지능에 적용되고 있다."

msgid "e_dsc_0042"
msgstr "신통합군의 주력 가변형 전투기.\n특별한 능력은 없으며, 평상시처럼 스킬을\n발휘할 수 있다면 격퇴는 어렵지 않다."

msgid "e_dsc_0043"
msgstr "반통합군 조직 「헤임달」이 운용하는\n가변형 전투기. 양자 AI 시스템 「세이렌」\n에 의해 제어되는 드론(고스트)이다."

msgid "e_dsc_0044"
