msgid "itp_dsc_0001"
msgstr "무난한 느낌의 장식품.\n어디에 두어도 그럭저럭 잘 어울린다."

msgid "itp_dsc_0002"
msgstr "세련된 분위기의 장식품.\n특별한 용도가 있는 건 아니지만 세련됐다."

msgid "itp_dsc_0003"
msgstr "최신식 아로마 디퓨저.\n불을 사용하지 않는 안전 설계라 여신님도 안심."

msgid "itp_dsc_0006"
msgstr "한입 크기의 과자.\n출출할 때 딱 좋은 양."

msgid "itp_dsc_0007"
msgstr "큰 사이즈의 과자.\n친구와 함께 먹기에 딱 좋은 양."

msgid "itp_dsc_0008"
msgstr "윈더미어 특산의 맛있는 사과.\n함부로 다루면 프레이아에게 혼나니 주의."

msgid "itp_dsc_0009"
msgstr "좀처럼 구할 수 없는 최고급 안주.\n술을 즐길 줄 아는 성인 여성에게 인기 만점."

msgid "itp_dsc_0010"
msgstr "라그나 바다에서 잡은 신선한 해파리.\n매끈매끈하고 쫄깃쫄깃하며 탱글탱글한 식감이 참을 수 없다."

msgid "itp_dsc_0011"
msgstr "길거리 매점에서 파는 핫도그.\n누군가와 함께 먹으면 더 맛있어진다."

msgid "itp_dsc_0012"
msgstr "끝부분까지 맛있는 피자.\n아이 입맛이라는 말을 들어도 먹고 싶어지는 맛."

msgid "itp_dsc_0013"
msgstr "놀랄 만큼 매운 새빨간 카레.\n모르고 먹으면 불을 뿜어버릴지도？"

msgid "itp_dsc_0014"
msgstr "중화요리점 「냥냥」의 인기 메뉴.\n중독성 있는 맛으로 여성들에게도 인기가 높다."

msgid "itp_dsc_0015"
msgstr "수많은 아이디어가 적힌 노트.\n막혔을 때 한번 들여다보자."

msgid "itp_dsc_0016"
msgstr "위대한 아티스트의 곡이 기록되어 있다.\n들으면 영감을 얻을 것이 틀림없다！"

msgid "itp_dsc_0017"
msgstr "발키리의 정교한 피규어.\n메카닉도 만족할 완전 변형 모델."

msgid "itp_dsc_0018"
msgstr "절묘하게 기묘하고 귀여운 굿즈.\n자세히 보면 그 아이의 휴대전화와 똑같이 생겼다！"

msgid "itp_dsc_0020"
msgstr "정성스럽게 포장된 초콜릿.\n마음이 담긴 달콤한 한때를 즐겨보세요."

msgid "itp_dsc_0021"
msgstr "정성스럽게 포장된 과자.\n서툰 남자의 마음이 가득 담겨 있다."

msgid "itp_dsc_0022"
msgstr "누가 받아도 기쁜 특별한 선물.\n하지만、내용물은 수수께끼에 싸여 있다."

