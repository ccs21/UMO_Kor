msgid "v_dsc_0001"
msgstr "왈큐레의 경호와 지원을 목적으로 한\n델타 소대에서 운용되는 가변 전투기.\nVF-31A 카이로스를 개수한 특별기로\n파일럿인 하야테 임멜만에게\n맞춰 튜닝되어 있다."

msgid "v_dsc_0002"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 폴드 쿼츠를 이용한\n차세대 기술을 표준 탑재하고 있으며, 이전 세대의\n가변 전투기와 비교해 안전성을 확보하면서도\n기동성을 향상시키는 데 성공했다."

msgid "v_dsc_0003"
msgstr "통합군의 VF-19를 넥키 바사라 전용으로 개수한\n기체. 새빨간 컬러링이 인상적인\n기체로, 포탄 대신 스피커를 쏘아 박는\n스피커 포드와 어깨의 스피커를 통해\n바사라의 노랫소리를 전장에 울려 퍼뜨린다."

msgid "v_dsc_0004"
msgstr "제1차 성간대전에서 활약한 가변 전투기.\n뛰어난 범용성을 갖춰 대전이 끝난 뒤에도 오랫동안\n운용된 역사적인 걸작기로 자리매김했다.\n퇴역한 뒤의 시대에도 애칭인 「발키리」는\n가변 전투기의 총칭으로 계승되고 있다."

msgid "v_dsc_0005"
msgstr "VF-31A 카이로스를 기반으로 델타 소대에서의\n운용에 최적화된 개수가 이루어진 가변 전투기.\nE형은 적 탐지와 정찰에 특화된 전자전형으로,\n접이식 레이돔을 장비하고 있다. 문자\n그대로 델타 소대의 눈과 귀가 되는 존재다."

msgid "v_dsc_0006"
msgstr "제1차 성간대전에서 활약한 가변 전투기.\nS형은 지휘관기로 운용되며, 무장 면과\n기동성에서 J형을 웃도는 성능을 자랑한다. 역전의\n에이스 로이 포커의 탑승기였으나\n이치죠 히카루가 물려받아 파일럿을 맡았다."

msgid "v_dsc_0007"
msgstr "제1차 성간대전에서 활약한 가변 전투기.\n막시밀리안 지너스의 탑승기로,\n퍼스널 컬러인 파란색으로 도색되어 있다.\n후기 생산형인 본 기체는 에이스 파일럿용으로\n항공전자장비의 개량이 이루어져 있다."

msgid "v_dsc_0008"
msgstr "VF-31A 카이로스를 기반으로 델타 소대에서의\n운용에 최적화된 개수가 이루어진 가변 전투기.\nF형은 공중전에 특화된 기체로, 전투 공역을\n지배할 수 있을 만큼 뛰어난 공중전 성능을 자랑하지만, 이를\n살리기 위해서는 높은 조종 기량이 요구된다."

msgid "v_dsc_0009"
msgstr "VF-31A 카이로스를 기반으로 델타 소대에서의\n운용에 최적화된 개수가 이루어진 가변 전투기.\nC형은 성능 밸런스가 뛰어나 팀 전체를\n지원하는 데 적합하다. 또한 S형에\n버금가는 지휘관제 능력도 갖추고 있다."

msgid "v_dsc_0011"
msgstr "마크로스 갤럭시 선단에서 개발된\n가변 전투기. 임플란트화된 병사의\n탑승을 전제로 하고 있기 때문에, 생신의 인간은\n그 경이적인 기동력에서 발생하는 G의 부하를\n견딜 수 없다고 알려져 있다."

msgid "v_dsc_0012"
msgstr "VF-31A 카이로스를 기반으로 델타 소대에서의\n운용에 최적화된 개수가 이루어진 가변 전투기.\nS형은 지휘관용으로 지휘관제 능력과 무장이\n강화되어 있다. 기체 후면 중앙에 해당하는 부분\n에는 검을 문 용의 두개골이 그려져 있다."

msgid "v_dsc_0013"
msgstr "대바쥬라전을 상정해 설계된 시작기.\nVF-25, VF-27과는 같은 기체를 원형으로 한\n자매기이지만, 그 두 기체를 능가하는 성능을\n자랑한다. 기체 성능을 크게 향상시키는\n「폴드 웨이브 시스템」이 특징."

msgid "v_dsc_0014"
msgstr "윈더미어에 배치된 가변 전투기.\nSv라는 형식번호가 나타내듯 VF 계통의 기체\n와는 다른 기술로 설계되어 있다. 특히 그\n변형 기구는 상당히 특수한 구조로 되어 있다.\n이 Hs형은 지휘관기로 운용된다."

msgid "v_dsc_0015"
msgstr "윈더미어에 배치된 가변 전투기.\nSv라는 형식번호가 나타내듯 VF 계통의 기체\n와는 다른 기술로 설계되어 있다. 특히 그\n변형 기구는 상당히 특수한 구조로 되어 있다.\n이 Ba형은 일반 병사용으로 운용된다."

msgid "v_dsc_0017"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 전용 전자전 장비, 특히 후면의\n레이돔이 특징이다. 강력한 폴드 통신 유도\n시스템을 통해 여러 대의 무인 전투기를\n동시에 제어할 수 있다."

msgid "v_dsc_0018"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 지휘관용으로 종합적인 성능의\n향상이 이루어졌다. 오즈마 리의 탑승기로,\n회색 기체에 노란색과 검은색 라인이\n도색되어 있는 것이 특징이다."

msgid "v_dsc_0019"
msgstr "윈더미어에 배치된 가변 전투기.\nSv라는 형식번호가 나타내듯 VF 계통의 기체\n와는 다른 기술로 설계되어 있다. 순백의\n기체색이 눈길을 끌지만, 기본적으로는 같은 Hs형인\n키스 기체와 동등한 성능을 지닌 기체다."

msgid "v_dsc_0020"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 장거리 저격을 주력으로 하는 특화형으로,\n스나이퍼 팩을 표준 장비하고 있다.\n머리는 외형상 A형과 차이가 없지만,\n고정밀 단안식 카메라가 탑재되어 있다."

msgid "v_dsc_0021"
msgstr "특수작전 수행을 주안점으로 둔 가변 전투기.\n스텔스성을 중시한 설계가 이루어져 있으며,\n기존 기체보다 대형이면서 중장갑이다.\n기동성과 화력도 뛰어나며, 강공 모드\n라는 특수한 가워크 형태로 변형할 수 있다."

msgid "v_dsc_0022"
msgstr "제1차 성간대전에서 활약한 가변 전투기.\n미리아 파리나의 탑승기로,\n퍼스널 컬러인 빨간색으로 도색되어 있다.\n후기 생산형인 본 기체는 에이스 파일럿용으로\n항공전자장비의 개량이 이루어져 있다."

msgid "v_dsc_0024"
msgstr "통합군의 VF-11을 밀레느 지너스\n전용으로 개수한 기체. 흰색과 분홍색을 중심으로\n한 컬러링과 부드러운 인상의 형태\n가 특징. 파이어 발키리와 마찬가지로\n스피커 포드 등이 장비되어 있다."

msgid "v_dsc_0026"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 폴드 쿼츠를 이용한\n차세대 기술을 표준 탑재하고 있으며, 이전 세대의\n가변 전투기와 비교해 안전성을 확보하면서도\n기동성을 향상시키는 데 성공했다."

msgid "v_dsc_0027"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기에 데코레이션을 한 기체.\n장갑에는 셰릴과 란카의 일러스트가 큼직하게\n그려져 있다. 참고로 이 장식들은 기체의\n소유자에게 무단으로 했다고 한다."

msgid "v_dsc_0028"
msgstr "대바쥬라전을 상정해 설계된 시작기.\n본 기체는 대기권 내외 겸용 옵션 팩\n「슈퍼 팩」을 추가로 장비한 상태.\n폴드・웨이브・프로젝터를\n탑재하고 각종 무장도 강화되어 있다."

msgid "v_dsc_0029"
msgstr "「마크로스 시리즈」 35주년을 기념해,\nVF-31J에 특별한 컬러링을 적용한 기체.\n청색, 흑색, 백색 배색에 금색이 더해졌으며,\n파이터 및 가워크 형태일 때의 상면에는\n『ANNIVERSARY』라는 글자가 그려져 있다."

msgid "v_dsc_0030"
msgstr "윈더미어에 배치된 가변 전투기.\nSv라는 형식번호가 나타내듯 VF 계통의 기체\n와는 다른 기술로 설계되어 있다. 적자색의\n기체색은 미라쥬가 이 기체를 강탈할 때\n입력한 식별 코드에 의한 것이다."

msgid "v_dsc_0031"
msgstr "「슈퍼・노바 계획」을 바탕으로 개발\n된 기체. 다루기 까다롭게 조정되어 있어\n그 특성은 「야생마」라 불릴 정도.\n조종자를 가리는 기체이지만, 매우 높은\n기동력과 운동 성능을 지닌 고성능기다."

msgid "v_dsc_0032"
msgstr "「슈퍼・노바 계획」을 바탕으로 개발\n되어 혁신 기술이 다수 적용된 기체.\n기체와 신경을 연결해 조작하는 「BDI 시스템」\n을 통해 높은 조종성을 자랑한다. 또한 그 특성은\n배틀로이드 형태에서도 발휘된다."

msgid "v_dsc_0033"
msgstr "통합군의 VF-19를 넥키 바사라 전용으로 개수한\n기체. 새빨간 컬러링은 그대로 유지하면서,\n바사라의 노래에 대한 자세에 깊이 공감하는\n셰릴의 일러스트를 그려 넣어 시공을\n초월한 컬래버레이션을 실현했다."

msgid "v_dsc_0034"
msgstr "윈더미어에 배치된 가변 전투기.\n일반 병사용 Ba형에 추가 부스터를 겸한\n무인 전투기 릴・드라켄을 주익 양 끝에\n연결한 상태. 분리하면 기체가 3대로\n분신한 것처럼 보이게 할 수도 있다."

msgid "v_dsc_0035"
msgstr "왈큐레 라이브의 연출용으로 VF-31을\n여신의 이미지 컬러로 도색한 기체.\n델타 소대의 5기 각각에 서로 다른 도색이\n적용되었으며, C형은 핑크＆라이트 블루의\n마키나 나카지마 컬러로 되어 있다."

msgid "v_dsc_0037"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 장거리 저격형의 표준 장비인\n스나이퍼 팩에 옵션 파츠를 추가로\n장비한 상태. 라이플 이외의 장비가\n내장식이기 때문에 병용이 가능하다."

msgid "v_dsc_0038"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 공중전용으로 최적화된 F형에\n대기권 외 활동용 고기동 옵션인\n슈퍼 팩을 장비한 상태. 기동력과\n화기뿐 아니라 각부 장갑도 강화되어 있다."

msgid "v_dsc_0039"
msgstr "윈더미어에 배치된 가변 전투기.\n지휘관기인 Hs형에 추가 부스터를 겸한\n무인 전투기 릴・드라켄을 주익 양 끝에\n연결한 상태. 3대로 분리해 적을 교란하는\n것이 가능하며 공격력도 향상되어 있다."

msgid "v_dsc_0040"
msgstr "「MACROSS CROSSOVER LIVE 2019」\n를 기념해, VF 시리즈의 시조인 VF-1에\n해당 라이브의 스페셜 로고를 이미지화한\n마킹을 적용한 기체. 역대 가희들을\n잇는 유서 깊은 날개로 완성되어 있다."

msgid "v_dsc_0041"
msgstr "VF-31J에 우주전용 추가 옵션을 장비\n시킨 상태. 멀티퍼포스 팩이라는 이름으로\n불리며, 추력과 공격력 강화 외에도\n멀티퍼포스 컨테이너 유닛과의 병용\n도 가능해 다양한 상황에 대응할 수 있다."

msgid "v_dsc_0042"
msgstr "대기권 외 활동용 고기동 옵션인\n슈퍼 팩을 장비한 VF-25S.\n파일럿인 오즈마는 중장 옵션인\n아머드 팩을 사용하는 경우가 많지만, 가볍고\n기동성이 높은 이쪽을 선택할 때도 있다."

msgid "v_dsc_0043"
msgstr "왈큐레 라이브의 연출용으로 VF-31을\n여신의 이미지 컬러로 도색한 기체.\n델타 소대의 5기 각각에 서로 다른 도색이\n적용되었으며, J형은 레드＆오렌지의\n프레이아 비온 컬러로 되어 있다."

msgid "v_dsc_0044"
msgstr "왈큐레 라이브의 연출용으로 VF-31을\n여신의 이미지 컬러로 도색한 기체.\n델타 소대의 5기 각각에 서로 다른 도색이\n적용되었으며, F형은 옐로＆라이트 그린의\n카나메 버캐니어 컬러로 되어 있다."

msgid "v_dsc_0045"
msgstr "대기권 내외 겸용인 토네이도 팩을\n장비해 YF-29의 성능에 가깝게 만든 VF-25F.\n아머드 팩보다도 고가의 장비로,\nYF-29의 기술 실증과 데이터 수집 및 전용\n장비를 개발하기 위한 테스트도 겸하고 있다."

msgid "v_dsc_0046"
msgstr "희대의 크리에이터가 자신의 프로 데뷔\n40주년을 기념해 직접 채색했다는\n특별 컬러의 YF-19. 검은색을 중심으로 하며,\n빨간색과 라이트 블루의 특징적인 라인이 돋보이는\n날카로운 디자인의 기체로 되어 있다."

msgid "v_dsc_0047"
msgstr "VF-31C에 우주전용 추가 옵션을 장비\n시킨 상태.\n뛰어난 성능 밸런스가 더욱 강화되었으며,\n장비 추가로 인해 동료 기체의 지원뿐 아니라\n단독 전투 능력도 향상되어 있다."

msgid "v_dsc_0048"
msgstr "VF-31S에 우주전용 추가 옵션을 장비\n시킨 상태. 기체 성능을 한계까지 끌어낸\n다루기 까다로운 조정에 더해, 장비 추가로\n성능이 더욱 강화되어 기체를 다루는 것 자체\n도 한층 어려워졌을 것으로 예상된다."

msgid "v_dsc_0049"
msgstr "대기권 내외 겸용인 토네이도 팩을,\n미하엘 블랑의 탑승기인 VF-25G에\n장비한 상태. 고가의 장비를 적용할 수 있었던 배경\n에는 S.M.S의 새로운 클라이언트인\n셰릴 놈의 존재도 크게 작용했다고 할 수 있다."

msgid "v_dsc_0050"
msgstr "VF-31E에 우주전용 추가 옵션을 장비\n시킨 상태. 추력과 공격력 강화도 물론이지만,\n장갑 강화에 따른 생존성 향상은\n정찰뿐 아니라 전투에도 직접 참가하는 일이\n많은 본 기체에 있어 중요한 요소가 되고 있다."

msgid "v_dsc_0051"
msgstr "몽키 모델인 VF-19EF를 2050년대\n후반의 기술로 개량하는 프로젝트,\n「VF-19ADVANCE」를 통해 탄생한 기체.\n어드밴스 팩을 장비한 상태인 본 기체는,\n통칭 「이사무 스페셜」이라 불린다."

msgid "v_dsc_0052"
msgstr "왈큐레의 라이브를 연출하기 위해 특별히\n준비된 스페셜 페인트의 VF-31.\nJ형에는 수영복 차림의 프레이아가 등에 페인트\n되어 있으며, 아크로바틱 쇼에서는 활기찬\n모습을 남김없이 보여줄 것이다."

msgid "v_dsc_0053"
msgstr "가변 전투기로의 기종 전환을 위해 개수가 이루어진\n복좌형 훈련기. 콕핏 연장에 따라\n외장 패널의 형상이 일부 변경되어 있다.\n훈련기이지만, 머리 레이저 기관총과\n건포드를 장비해 전투도 가능하다."

msgid "v_dsc_0054"
msgstr "특수작전 수행을 주안점으로 둔 가변 전투기.\n표준형인 D형을 바탕으로 각종 성능이 강화된,\n소수 배치된 지휘관기다. 킨류의 뒤를 이어\n다이아몬드 포스의 대장이 된\n감린 키자키의 탑승기로 인계되었다."

msgid "v_dsc_0055"
msgstr "사이보그 병사인 브레라 스턴의\n탑승기 VF-27γ에 슈퍼 팩을 장비하고,\n추가로 후면 부스터 웨폰 유닛으로\n무인 전투기 「고블린Ⅱ」를 탑재한 상태.\n그 기동성은 통상 상태의 YF-29에 필적한다."

msgid "v_dsc_0056"
msgstr "왈큐레의 라이브를 연출하기 위해 특별히\n준비된 스페셜 페인트의 VF-31.\nF형에는 주황색 리본을 두른 듯한\n장식에 카나메의 페인트가 더해져,\n고귀한 노래와 함께 포기하지 않는 의지를 전한다."

msgid "v_dsc_0057"
msgstr "VF-171을 대바쥬라용으로 개수한 기체.\nEX-기어 시스템을 탑재해 기존의 17 계열을\n능가하는 성능을 지녔지만, 기동 한계는 VF-25보다\n크게 떨어지며, 실정을 아는 파일럿들에게는\n「임시방편 기체」라는 평가를 받았다."

msgid "v_dsc_0058"
msgstr "맥스와 미리아의 성간 결혼식에서 사용된\n복좌형 기체. 맥스의 퍼스널 컬러인\n파란색으로 도색되어 있으며 퍼레이드에도 사용\n되었다. 또한 결혼식 도중 젠트라디군의\n습격을 받았을 때는 출격해 전투도 벌였다."

msgid "v_dsc_0059"
msgstr "행성 졸라의 은하 순찰대에 평가 시험용으로\n단 1기만 배치된 고정 무장 강화형 VF-19.\n은하 고래에게 노래를 들려주기 위해 넥키 바사라가\n억지로 탑승했고, 이후에도 레이 러브록에게\n대여료를 떠넘기고 빌려 가 버렸다."

msgid "v_dsc_0060"
msgstr "중장 옵션인 아머드 팩을\n장비해 화력과 방어력을 대폭 강화한\nVF-25S. 장착한 채로 변형도 가능하다.\n오즈마 리는 이 장비를 상용하며, 무거울\n터인 기체를 자유자재로 다루고 있다."

msgid "v_dsc_0061"
msgstr "VF-17에 이은 특수작전기로서 YF-21을\n일부 개수해 배치한 기체. 새로운 주력기\n로서 다이아몬드 포스에도 배치되었으며,\n대장인 감린 키자키 역시 지휘관기용으로\n통신 능력을 강화한 S형으로 갈아탔다."

msgid "v_dsc_0062"
msgstr "마크로스 프론티어 선단에서 개발된\n가변 전투기. 전용 전자전 장비, 특히 후면의\n레이돔이 특징이다. 슈퍼 팩을 병용함으로써\n화력과 방어력이 향상되어 전선의 아군과\n연계하거나 적극적인 적 탐지 활동이 가능하다."

msgid "v_dsc_0063"
msgstr "윈더미어에 배치된 가변 전투기.\nSv라는 형식번호가 나타내듯 VF 계통의 기체\n와는 다른 기술로 설계되어 있다. 본 기체는\n테오 유시라가 파일럿을 맡고 있으며,\n전투 외에도 유적 수색 등 폭넓은 임무에 종사했다."

msgid "v_dsc_0064"
msgstr "제1차 성간대전에서 활약한 가변 전투기.\n막시밀리안 지너스의 최초 탑승기\n로, 첫 출격에서 미사일을 미끼로 사용해 적을\n격추하는 「미끼 사격」을 고안하는 등,\n가변 전투기 조종사로서 천부적인 재능을 보였다."

msgid "v_dsc_0065"
msgstr "왈큐레 라이브의 연출용으로 VF-31을\n여신의 이미지 컬러로 도색한 기체.\n델타 소대의 5기 각각에 서로 다른 도색이\n적용되었으며, S형은 퍼플＆블루의\n미쿠모 기느메르 컬러로 되어 있다."

msgid "v_dsc_0066"
msgstr "VF-31A 카이로스에 VF-31 지크프리드\n의 예비 부품을 조합한 긴급 대체기.\n기수 전방에 폴드 쿼츠를 추가하고,\n드라켄Ⅲ와 같은 전방위 모니터도 채택.\n각종 장비를 강화한 특별 개조기다."

