msgid "sn_dsc_3699"
msgstr "한때 케이오스에 해킹을 시도했던 것을 계기로 신병이 확보되었던 레이나.\\n당시 일을 담담히 이야기하는 모습에서는 어딘가 레이나의 성장이 엿보이는 듯하다."

msgid "sn_dsc_3700"
