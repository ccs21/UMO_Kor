msgid "sn_dsc_0001"
msgstr "훌륭하게 발키리 최종 오디션에 합격하고 멤버가 된 프레이아.\\n「Welcome to Walküre World」―미쿠모"

msgid "sn_dsc_0002"
msgstr "갑판에서 몸을 내던진 하야테. 계곡에서 불어 올라오는 상승기류가 그의 몸을 감쌌다.\\n「이 녀석…」「바람을 탄 건가」―아라드, 메서"

msgid "sn_dsc_0003"
msgstr "오디션에 합격했다는 사실을 알고 긴장이 풀린 프레이아는 바닥에 쓰러졌다.\\n발키리의 카나메와 레이나는 그런 모습을 따뜻하게 지켜보았다."

msgid "sn_dsc_0004"
msgstr "미쿠모는 프레이아의 노래에 적지 않은 기대를 품고 있었다.\\n「쿠모쿠모의 예상대로…일까?」―마키나"

msgid "sn_dsc_0005"
msgstr "룬을 빤히 바라보거나 만지는 것은 윈더미어인에게 부끄러운 일이다.\\n「변태!」「그런 거 아무렇지도 않다니까!」―프레이아, 하야테"

msgid "sn_dsc_0006"
msgstr "프레이아는 오디션 예선에 참가하지 않았다.\\n하지만 예선 통과 조건은 충족했기에 특별히 본선 출전 허가가 내려졌다."

msgid "sn_dsc_0007"
msgstr "하늘을 날겠다는 각오를 다진 하야테.\\n「군대는 싫다. 남에게 지시받는 것도. 그러니까 내 마음대로 하게 해줘」―하야테"

msgid "sn_dsc_0008"
msgstr "하야테 안에서 무언가를 발견한 아라드 대장은 조용히 웃었다.\\n「그게 바로 바람을 느껴버린 자의 숙명이지」―아라드"

msgid "sn_dsc_0009"
msgstr "VF-31A 카이로스.\\nYF-30 크로노스의 정식 채용형. 델타 날개를 채용하고 있다."

msgid "sn_dsc_0010"
msgstr "카오스 라그나 지부의 거점이 되는 마크로스급 전함.\\n발레타 시티에 주둔하고 있다."

msgid "sn_dsc_0011"
msgstr "우미네코.\\n행성 라그나에 서식하는, 상반신은 고양이, 하반신은 물개와 같은 생물."

msgid "sn_dsc_0012"
msgstr "팔에 감기면 멋대로 계약을 시작해 버리는 라그나산 휴대전화.\\n「계약 완료. 송금 절차 개시」"

msgid "sn_dsc_0013"
msgstr "발키리 오디션을 위해 윈더미어에서 밀항해 온 프레이아.\\n「나는 좋아하는 노래를 부르고 싶어. 1분이라도 1초라도 더 오래. 그러니까 절대 돌아가지 않을 거야!」―프레이아"

msgid "sn_dsc_0014"
msgstr "발키리 멤버 프레이아 비온의 필살 대사.\\n힘차게 노래하는 그녀는 신입 멤버 오디션을 통해 찾아온 가장 신참이다."

msgid "sn_dsc_0015"
msgstr "밀항이 들켜 붙잡히기 직전! 하야테가 나타나 프레이아를 바이크에 태웠다.\\n「타!」―하야테"

msgid "sn_dsc_0016"
msgstr "하야테를 밀항범이라고 착각했던 미라쥬.\\n곧게 겨눈 총구에 한 치의 망설임도 없었다."

msgid "sn_dsc_0017"
msgstr "「미쿠모 씨, 우리 직진녀는 어때?」\\n「글쎄. 저 아이와 함께라면 잠입 수사 같은 건 못 해」―아라드, 미쿠모"

msgid "sn_dsc_0018"
msgstr "일하는 중에도 하늘을 올려다보며 농땡이를 피우는 하야테.\\n이런 태도도 그가 직장을 전전하게 된 원인 중 하나였다."

msgid "sn_dsc_0019"
msgstr "노래가 좋다. 그 솔직한 마음을 품고 프레이아는 발키리 오디션으로 향한다.\\n「노래하고 있으면, 살아 있다는 느낌이 들어」―프레이아"

msgid "sn_dsc_0020"
msgstr "출렁출렁~ 출렁출렁~."

msgid "sn_dsc_0021"
msgstr "짐 운반용 워크로이드로 발키리의 노래에 맞춰 춤추는 하야테.\\n근무 태도는 최악이어도 조종 기술만큼은 누구보다 뛰어났다."

msgid "sn_dsc_0022"
msgstr "프레이아가 어릴 적 받았던 음악 플레이어.\\n이 음악 플레이어가 은하의 명곡들과 프레이아를 만나게 해주었다."

msgid "sn_dsc_0023"
msgstr "폴드 세균의 작용으로 자아를 잃고 흉포화되는 병.\\n이 병에 대항할 수 있는 것이 바로 발키리의 노래다."

msgid "sn_dsc_0024"
msgstr "하야테가 컨테이너 운반 아르바이트를 하던 행성.\\n이 별에서 프레이아와 델타 소대, 발키리를 만나며 이야기는 시작되었다."

msgid "sn_dsc_0025"
msgstr "젠트라디와의 전투 중 공중으로 내던져진 민메이.\\n급강하하는 VF-1의 콕핏에서 히카루는 필사적으로 손을 뻗었다."

msgid "sn_dsc_0026"
msgstr "전투가 일단락된 후 히카루를 수색하는 포커.\\n격렬한 전투 속에서도 히카루는 어떻게든 살아남아 있었다."

msgid "sn_dsc_0027"
msgstr "부상을 시작한 마크로스였지만 중력 제어 시스템 이상으로 추락하고 말았다.\\n외계인의 기술에는 아직 밝혀지지 않은 부분이 많았고, 마크로스 역시 예외가 아니었다."

msgid "sn_dsc_0028"
msgstr "목숨을 잃을 뻔한 공포도 잊고 흐트러진 머리를 정리하는 민메이.\\n「물론 머리카락이지!」「하하하, 역시 그렇지?」―민메이, 히카루"

msgid "sn_dsc_0029"
msgstr "통합군 파일럿으로 오해받아 VF-1으로 출격하게 된 히카루.\\n에어 레이서로서의 자신감 때문인지 그의 표정에는 망설임이 없었다."

msgid "sn_dsc_0030"
msgstr "처음으로 발키리를 조종한 히카루는 민메이의 집을 부수고 말았다. 걱정하는 히카루.\\n「어떻게든…」―민메이"

msgid "sn_dsc_0031"
msgstr "마크로스의 주포 발사로 정체불명의 함대가 지구 침공을 시작했다.\\n외계인이 설치한 부비트랩으로 인해 인류는 전쟁에 휘말리게 되었다."

msgid "sn_dsc_0032"
msgstr "외계인과의 전투가 시작되고 전투기들이 잇달아 요격을 위해 출격한다.\\n역전의 에이스 로이 포커는 자신의 안에서 끓어오르는 감정을 억누를 수 없었다."

msgid "sn_dsc_0033"
msgstr "수리되지 않았을 시스템이 작동하며 마크로스의 주포가 발사되고 말았다.\\n긴 싸움의 시작을 알리는 이 한 발을 막을 수 있는 자는 없었다."

msgid "sn_dsc_0034"
msgstr "로이 포커가 탑승하는 VF-1. 노란색과 검은색 마킹 라인이 특징.\\n이 S형은 중대 이상 지휘관용으로 운용되는 성능 향상 타입이다."

msgid "sn_dsc_0035"
msgstr "태평양에 떠 있는 섬. 1999년 7월, 외계인의 거대한 우주선이 추락했다.\\n그 충격으로 섬 중심부가 날아가 버렸다."

msgid "sn_dsc_0036"
msgstr "지구를 침공해 온 적의 정체는 젠트라디라고 불리는 거대한 외계인이었다.\\n「하지만 이렇게까지 인간과 똑같을 줄이야…」―포커"

msgid "sn_dsc_0037"
msgstr "중화요리점 『냥냥』의 간판 아가씨로 차이나드레스를 입은 민메이.\\n그녀의 밝고 꾸밈없는 미소는 가게를 찾는 사람들에게 위로가 되었다."

msgid "sn_dsc_0038"
msgstr "능력이 있으면서도 싸우려 하지 않는 히카루에게 민메이는 부추기는 듯한 말을 한다.\\n「비행기가 네 꿈이잖아?」―민메이"

msgid "sn_dsc_0039"
msgstr "민메이의 방에서 오디션 합격 통지를 보여 받은 히카루.\\n그녀는 아주 오래전부터 가수가 되고 싶다는 꿈을 가지고 있었다."

msgid "sn_dsc_0040"
msgstr "개업한 냥냥에서 손님과 이야기하는 민메이. 히카루와의 관계를 놀림받고 얼굴을 붉힌다.\\n「이제 몰라!」―민메이"

msgid "sn_dsc_0041"
msgstr "지나가던 동네 회장에게 가게를 시작했다고 말하는 민메이.\\n지구에서 아무리 멀리 떨어져 있어도 그녀는 긍정적으로 살아가려 했다."

msgid "sn_dsc_0042"
msgstr "민메이가 자신을 「그냥 친구」라고 말하는 것을 듣고 만 히카루는,\\n어딘가 슬픈 표정을 지었다."

msgid "sn_dsc_0043"
msgstr "무사히 폐쇄 구역에서 살아 돌아온 히카루를 보고 포커는 기쁜 듯 웃었다.\\n「이 바퀴벌레 같은 녀석이!」―포커"

msgid "sn_dsc_0044"
msgstr "마크로스 내부에서 중화요리점 『냥냥』을 다시 열기로 결정되어 들뜬 민메이.\\n「나 옷 갈아입고 올게!」―민메이"

msgid "sn_dsc_0045"
msgstr "VF-1 발키리는 열핵 반응 터빈 엔진을 탑재하고 있어,\\n강제 추진제만 있다면 우주 공간도 비행할 수 있다."

msgid "sn_dsc_0046"
msgstr "주포 발사에 필요한 에너지 공급 루트를 확보하기 위해,\\n마크로스는 함체 각 블록을 재구성하여 인간형으로 변형을 감행한다."

msgid "sn_dsc_0047"
msgstr "민메이 방 문에 걸려 있는 토끼 모양 이름표.\\n민메이를 찾아온 히카루는 이 귀여운 이름표를 보고 노크를 망설였다."

msgid "sn_dsc_0048"
msgstr "막대한 피해를 입었지만 주포 발사로 적을 물리친 마크로스.\\n글로벌 함장은 진지한 표정으로 모자를 다시 고쳐 썼다."

msgid "sn_dsc_0049"
msgstr "행성 볼도르에 바르화의 수수께끼를 풀 열쇠가 있다고 예상한 델타 소대는,\\n발키리와 함께 볼도르인으로 변장해 잠입 수사를 하기로 결정했다."

msgid "sn_dsc_0050"
msgstr "차원병기를 사용한 것은 윈더미어인인가, 지구인인가?\\n프레이아와 미라쥬의 논쟁을 멈춘 미쿠모의 의미심장한 한마디."

msgid "sn_dsc_0051"
msgstr "「알겠다고냥!」\\n「냥은 필요 없어, 냥은」―프레이아, 미라쥬"

msgid "sn_dsc_0052"
msgstr "「귀여워~! 레이레이의 냥냥 너무 귀여워!」―마키나"

msgid "sn_dsc_0053"
msgstr "윈더미어 사과를 발견하고 임무도 잊은 채 흥분해 버린 프레이아.\\n「조금은 긴장감을 가져줬으면 하는데」―미라쥬"

msgid "sn_dsc_0054"
msgstr "동료들과 떨어져 단독으로 행동하던 미쿠모는,\\n정보 수집용 마이크로 드론을 수없이 설치해 두었다."

msgid "sn_dsc_0055"
msgstr "「나, 고양이 알레르기 있는데…」\\n「불만 있으면 오지 마」―하야테, 메서"

msgid "sn_dsc_0056"
msgstr "「후샤아」\\n「싫어, 발톱 세우지 마!」―레이나, 마키나"

msgid "sn_dsc_0057"
msgstr "아이들이 발키리의 노래로 구하려 했던 것은 바르화된 아버지였다.\\n「역시 거짓말이었어. 노래로 병이 낫는다니」―아이"

msgid "sn_dsc_0058"
msgstr "하야테는 고양이 알레르기가 있다.\\n고양이형 포유류로부터 만들어진 볼도르인의 별은 꽤나 힘들어 보인다."

msgid "sn_dsc_0059"
msgstr "어린 시절 프레이아의 기억. 차원병기에 의한 파괴의 광경.\\n윈더미어인과 지구인, 어느 쪽이 병기를 사용했는지는 양측의 견해가 갈렸지만…"

msgid "sn_dsc_0060"
msgstr "「이곳의 물과 윈더미어 사과를 섭취하면,\\n체내에서 바르화를 유발하는 세이즈놀이라는 물질이 합성돼」―카나메"

msgid "sn_dsc_0061"
msgstr "「이 세상에」「열리지 않는 문은 없어」―마키나, 레이나"

msgid "sn_dsc_0062"
msgstr "발키리 멤버 레이나 프라우러의 필살 대사.\\n과거 카오스에 해킹을 시도했고, 그 실력을 인정받아 멤버가 된 경력을 가지고 있다."

msgid "sn_dsc_0063"
msgstr "최신 기술을 아낌없이 사용한 발키리의 박력 넘치는 라이브.\\n레이나의 안무에 맞춰 『S』라는 글자가 떠오른다."

msgid "sn_dsc_0064"
msgstr "아무리 어려운 상황이라도 두 사람이 협력하면 두렵지 않다.\\n두 사람이 함께 만들어내는 발키리 사인은 무엇보다 강한 유대를 보여주고 있었다."

msgid "sn_dsc_0065"
msgstr "카오스의 전쟁 개입이 결정되어 소속된 전원의 계약이 갱신되게 되었다.\\n「도장, 찍어」―레이나"

msgid "sn_dsc_0066"
msgstr "「하야하야의 지크프리드」는「너덜너덜 바삭바삭」\\n「메서메서의 지크프리드는」「매끈매끈 쫀득쫀득 탱글탱글」―마키나, 레이나"

msgid "sn_dsc_0067"
msgstr "「해파리는 생것이 좋아. 생으로 통째로 삼키기」―레이나"

msgid "sn_dsc_0068"
msgstr "해킹에 성공한 레이나. 적 레이더에 발견되지 않고,\\n윈더미어 지배하에 있는 행성 볼도르에 잠입했다."

msgid "sn_dsc_0069"
msgstr "「만약의 경우에는 반드시 EX-기어 시스템을 사용해야 해」―마키나"

msgid "sn_dsc_0070"
msgstr "「어때, 보안 쪽은」\\n「전부 쓰레기, 폐기물. 이래서는 전혀 따끔하지 않아」―카나메, 레이나"

msgid "sn_dsc_0071"
msgstr "「폴드 리셉터, 비활성. 생체 폴드파 반응 없음」―레이나"

msgid "sn_dsc_0072"
msgstr "적 방어망의 네트워크를 해킹하는 레이나.\\n「상대로는 부족함이 없어」―레이나"

msgid "sn_dsc_0073"
msgstr "발키리 멤버이자 일류 해커와 메카닉인 두 사람.\\n자매처럼 사이가 좋으며, 한 지붕 아래에서 함께 생활하고 있다."

msgid "sn_dsc_0074"
msgstr "발키리 멤버 마키나 나카지마의 필살 대사.\\n그녀는 노래 실력뿐만 아니라 뛰어난 정비 기술도 보유해, 일류 메카닉으로도 활약하고 있다."

msgid "sn_dsc_0075"
msgstr "최신 기술을 아낌없이 사용한 발키리의 박력 넘치는 라이브.\\n마키나의 안무에 맞춰 『O』라는 글자가 떠오른다."

msgid "sn_dsc_0076"
msgstr "바르화 경계를 위해 현지 복장으로 갈아입고 오픈 카페에서 대기하는 마키나.\\n「샤할 시티도 이상 없음~」―마키나"

msgid "sn_dsc_0077"
msgstr "메카를 사랑하는 마키나는 다른 정비원들에게도 「누님」이라 불리며 따르고 있다.\\n「귀여운~ 지크프리드쨩들을 두고 갈 수 없잖아!」―마키나"

msgid "sn_dsc_0078"
msgstr "처음 만났을 당시 레이나와 마키나는 지금의 두 사람으로는 상상할 수 없을 정도로 사이가 나빴다.\\n「물과 기름, 섞으면 위험」―카나메"

msgid "sn_dsc_0079"
msgstr "「일단 배부터 채워야죠」―마키나"

msgid "sn_dsc_0080"
msgstr "마키나가 항상 착용하고 있는 고글.\\n단순한 패션 아이템이 아니라 사실 고성능 전자 단말기다."

msgid "sn_dsc_0081"
msgstr "「우리 모두 지크프리드쨩을 튜닝해 뒀어요~」―마키나"

msgid "sn_dsc_0082"
msgstr "하야테, 프레이아, 미라쥬의 절체절명 위기에 달려온 발키리.\\n「이 곡은…!」「정말이지, 늦어」―미라쥬, 하야테"

msgid "sn_dsc_0083"
msgstr "델타 소대와 발키리의 모함이며, 마크로스 엘리시온의\\n왼팔 부분. 마크로스 엘리시온에서 분리해 단독 행동이 가능하다."

msgid "sn_dsc_0084"
msgstr "「음~ 귀여워!」―마키나"

msgid "sn_dsc_0085"
msgstr "변화무쌍한 의상을 완벽하게 소화하는 셰릴에게 그 자리에 있던 모두가 매료되었다.\\n「대단하네…너」―알토"

msgid "sn_dsc_0086"
msgstr "간발의 차이로 바주라의 습격에서 란카를 구출한 알토.\\n「거기 초보자! 사정은 나중이다. 당장 그 아이를 데리고 도망쳐!」―오즈마"

msgid "sn_dsc_0087"
msgstr "바주라의 습격을 받고 알토는 순간적으로 파일럿을 잃은 VF-25에 올라탔다.\\n「그 녀석은 길리엄이 아니야. 초보자라고!」―오즈마"

msgid "sn_dsc_0088"
msgstr "미션 코드 『빅터』, 그것은 바주라의 출현을 의미하는 것이었다.\\n다가오는 숙명의 적을 앞두고 오즈마는 조용히 불타오르고 있었다."

msgid "sn_dsc_0089"
msgstr "「당신의 뒷모습이 너무나 매력적이어서」\\n「이런 데까지 와서 정말 대단하네요, 미셸 선배」―미셸, 루카"

msgid "sn_dsc_0090"
msgstr "처음 탑승한 VF-25를 능숙하게 조종하며 바주라에게서 도망치는 알토.\\n「정말 초보자치고는…좋은 솜씨인데」―미셸"

msgid "sn_dsc_0091"
msgstr "우주 공간으로 내던져질 뻔한 란카.\\n「눈 감고 입 다물어!」―알토"

msgid "sn_dsc_0092"
msgstr "「곧 만날 수 있겠네요, 그녀를!」\\n「같은 공기를 마실 수 있다니, 우리 행복해~」―남학생들"

msgid "sn_dsc_0093"
msgstr "흉포한 바주라와의 전투에서는 배틀로이드 형태의 격투전도 각오해야 한다.\\n「대체 이 괴물은 뭐야!?」―알토"

msgid "sn_dsc_0094"
msgstr "바주라의 압도적인 힘에 제압당해 행동 불능에 빠진 VF-25.\\n「당하고…있을까 보냐!!」―길리엄"

msgid "sn_dsc_0095"
msgstr "은하의 요정 셰릴 놈의 공연 전단.\\n은하 횡단 투어의 마지막 공연지로 선정된 곳은 프론티어 선단이었다."

msgid "sn_dsc_0096"
msgstr "바주라, 그것은 인류를 습격하는 미지의 생명체.\\n그 목적은 전혀 밝혀지지 않았으며, 단지 위협적인 존재라는 사실만 알려져 있다."

msgid "sn_dsc_0097"
msgstr "「어…거짓말. 셰릴…?」\\n「이런 서비스는 좀처럼 안 해주거든」―란카, 셰릴"

msgid "sn_dsc_0098"
msgstr "가부키의 전직 여자역 배우이자 미호시 학원의 학생 등 다양한 얼굴을 가진 파일럿.\\n「남에게 내 운명을 맡기는 건 사양이야!」―알토"

msgid "sn_dsc_0099"
msgstr "「17시부터 MBS 생방송. 노래도 있어. 19시부터는 다음 주\\n미스 마크로스 심사 회의, 그 후에는…듣고 있어요? 셰릴」―그레이스"

msgid "sn_dsc_0100"
msgstr "눈앞에 본인이 있다는 사실도 모른 채 셰릴에 대한 동경을 이야기하는 란카.\\n「저 같은 건 절대 무리라는 건 알고 있지만」―란카"

msgid "sn_dsc_0101"
msgstr "「미셸, 루카. 이쪽을 막는 것도 한계가 있어. 너희들이 해낼 수 있겠어!」\\n「하겠습니다」―오즈마, 미셸"

msgid "sn_dsc_0102"
msgstr "자신의 각오를 외친 알토.\\n「기세로 지껄이는 거 아니야! 애송이가!」―오즈마"

msgid "sn_dsc_0103"
msgstr "큰 흔들림으로 넘어지고 만 셰릴. 충격으로 원피스가 풀어져 버리고…\\n「셰릴 씨!」「응…?」―란카, 셰릴"

msgid "sn_dsc_0104"
msgstr "「내 것을 생으로 봤잖아!? 그 정도는 싸다고 생각해!」―셰릴"

msgid "sn_dsc_0105"
msgstr "자유분방한 셰릴. 립스틱으로 능숙한 프랑스어 메모를 남기고 떠났다.\\n「미안~ 그레이스. 잠깐 외출하고 올게」―셰릴"

msgid "sn_dsc_0106"
msgstr "「아, 배 안 고파요? 저 마침 엄청 맛있는 딤섬을 가지고 있거든요.\\n냥냥 명물 참치 만두!」―란카"

msgid "sn_dsc_0107"
msgstr "프론티어 선단에 있는 교육 기관.\\n옥상에는 학원장의 개인 소유인 VF-1이 장식되어 있다."

msgid "sn_dsc_0108"
msgstr "수억 년 전부터 우주에 존재했다고 여겨지는 외계 생명체.\\n「초시공 생명체」라고도 불리며, 체내에 폴드 쿼츠를 보유하고 있다."

msgid "sn_dsc_0109"
msgstr "지구인과 젠트라디, 서로 다른 종족 간 평화의 상징인 두 사람.\\n전투 속에서 서로에게 끌렸고, 역사상 최초의 성간 결혼을 했다."

msgid "sn_dsc_0110"
msgstr "「젠트라디군에서도 격추왕의 이름을 떨친 이 몸에게,\\n굴욕을 안긴 너를 용서하지 않겠다!」―미리아"

msgid "sn_dsc_0111"
msgstr "「졌다…세 번이나…죽여라」\\n「귀여워…」―미리아, 맥스"

msgid "sn_dsc_0112"
msgstr "행복한 가정을 이룬 두 사람.\\n훗날 일곱 명의 딸을 얻고, 그 혈통은 이어져 내려가게 된다."

msgid "sn_dsc_0113"
msgstr "격전을 끝낸 전함 안에서 운명이 두 사람을 만나게 했다.\\n「아아…아름답다…」―맥스"

msgid "sn_dsc_0114"
msgstr "젠트라디군의 에이스 파일럿. 통칭 『에이스 미리아』.\\n「맥스. 너와 함께, 그것도 전투 속에서 죽을 수 있다니 최고야」―미리아"

msgid "sn_dsc_0115"
msgstr "훗날 격추왕이라 불리는 천재 파일럿. 그의 조종 실력은 포커조차 뛰어넘는다.\\n「나 천재였던 건가. 그래 천재였구나. 몰랐어」―맥스"

msgid "sn_dsc_0116"
msgstr "최종 결전에 나서는 맥스. 마이크론 장치로 거대화하여 미리아와 함께 출격한다.\\n「이건…」「민메이의 노래야」―맥스, 미리아"

msgid "sn_dsc_0117"
msgstr "마크로스로 접근해 오는 멜트란디군. 즉시 스컬 소대가 요격에 나섰다.\\n「여자라고 얕보지 마!」―히카루"

msgid "sn_dsc_0118"
msgstr "붉은색과 푸른색의 콰드란 로.\\n인류군과 멜트란디군, 양측의 에이스 파일럿이 협력해 전장을 누빈다."

msgid "sn_dsc_0119"
msgstr "「린 민메이의 노래를 듣는 모든 이에게 알린다. 우리들의 적은 단 하나.\\n골 보돌저를 쓰러뜨리고, 다시 문화를 되찾는 것이다」―브리타이"

msgid "sn_dsc_0120"
msgstr "남녀로 나뉘어 계속 싸움을 이어가던 젠트라디.\\n지구인이 당연하게 영위하는 남녀 공동생활은 그들에게 큰 충격을 주었다."

msgid "sn_dsc_0121"
msgstr "바르화 발생으로 혼란이 일어나는 가운데, 어디선가 노래가 들려오기 시작했다.\\n「들려줄게, 여신의 노래를」―미쿠모"

msgid "sn_dsc_0122"
msgstr "프레이아의 눈앞에 나타난 미쿠모 긴느메르.\\n그녀는 발키리 중에서도 손꼽히는 노래 실력을 지녔으며, 에이스 보컬을 맡고 있다."

msgid "sn_dsc_0123"
msgstr "발키리의 노래의 힘은 미쿠모 혼자만으로 발휘되는 것이 아니다.\\n모두가 모여 함께 노래할 때 비로소 전술 음악 유닛 발키리가 되는 것이다."

msgid "sn_dsc_0124"
msgstr "하야테가 조종하는 발키리는 마치 춤추는 듯한 움직임으로 적을 농락한다.\\n그 춤이 만들어내는 리듬에 영향을 받은 프레이아는 다시 룬을 빛내게 된다."

msgid "sn_dsc_0125"
msgstr "발키리는 몇 차례 멤버 교체를 거쳐 지금에 이르렀다.\\n한때 카나메가 맡았던 에이스 보컬 자리는 지금 미쿠모의 차지가 되어 있었다."

msgid "sn_dsc_0126"
msgstr "적의 공격으로 건물 옥상에서 떨어진 레이나.\\n그때 곁에 있던 마키나가 누구보다 먼저 뛰어들어 레이나를 구했다."

msgid "sn_dsc_0127"
msgstr "발키리의 리더로서 수많은 전장에서 노래해 온 카나메.\\n「노래는, 생명!」―카나메"

msgid "sn_dsc_0128"
msgstr "발키리의 노래를 듣고 하트 모양의 『룬』을 빛내는 프레이아.\\n그것은 그녀 자신의 더없이 벅찬 설렘을 나타내는 것이었다."

msgid "sn_dsc_0129"
msgstr "정체불명의 발키리의 공격으로 발키리의 라이브는 중단될 수밖에 없었다.\\n하지만 그런 위기 속에서도 미쿠모는 노래하는 것을 포기하지 않았다."

msgid "sn_dsc_0130"
msgstr "전용 발키리로 구성된 델타 소대. 발키리와 함께 임무를 수행하는 그들은,\\n호위뿐만 아니라 라이브 퍼포먼스 등도 담당하고 있다."

msgid "sn_dsc_0131"
msgstr "바르화된 병사들의 손에 의해 거리는 파괴되고, 타오르는 불길이 시민들을 덮쳤다.\\n평화로운 거리가 한순간에 전장이 된다. 그것이 바르화의 무서움이다."

msgid "sn_dsc_0132"
msgstr "주 전장이 하늘인 발키리에 비해, 지상전의 주력을 담당하는 것이 데스트로이드다.\\n거리의 파괴를 막기 위해 바르화된 병사들에게 맞섰다."

msgid "sn_dsc_0133"
msgstr "폭동을 진정시키기 위해 발키리에 탄 채 노래하기 시작하는 란카.\\n그녀의 곧고 순수한 노랫소리는 싸우던 병사들의 손을 차례차례 멈추게 했다."

msgid "sn_dsc_0134"
msgstr "기대하던 셰릴의 라이브 날, 행사장에 도착하지 못해 곤란해하던 란카.\\n우연히 만난 알토의 도움을 받고, 다음에 꼭 보답하겠다고 약속했다."

msgid "sn_dsc_0135"
msgstr "알토의 위기를 알고 란카는 직접 구하러 가기로 결심한다.\\n「나, 알토 군에게 선물도 못 줬어. 아무 말도 못 했는데…」―란카"

msgid "sn_dsc_0136"
msgstr "최신형 발키리라고 해도 선단에서 행성 갈리아 4까지는 너무나 멀었다.\\n하지만 개발 중인 폴드 부스터를 사용한 미셸의 도움으로 란카는 그곳에 도착했다."

msgid "sn_dsc_0137"
msgstr "갑자기 하늘에서 나타난 란카의 모습을 보고 들뜬 젠트라디 병사들.\\n당연한 일이다. 지금 바로 전설의 퍼스트 라이브가 눈앞에서 열리고 있었으니까."

msgid "sn_dsc_0138"
msgstr "「그녀야말로 대역에서 기회를 잡고, 스타의 자리를 향해 올라가고 있는\\n초시공 신데렐라, 란카쨩입니다!」―제33부대 부대장"

msgid "sn_dsc_0139"
msgstr "위문 라이브를 위해 행성 갈리아 4에 방문한 셰릴이었지만, 직후 몸 상태가 나빠지고 만다.\\n「됐으니까 자! 이제 노래로 어떻게 될 상황이 아니야!」―알토"

msgid "sn_dsc_0140"
msgstr "폭동 소동도 진정되고, 두 사람이 함께 하늘을 나는 란카와 알토.\\n위험을 무릅쓰고 자신을 찾아와 준 란카에게 알토는 감사의 말을 전한다."

msgid "sn_dsc_0141"
msgstr "탑승하던 VF-25가 갑자기 조종 불능에 빠져 불시착하게 된 란카와 알토.\\n그곳에서 발견한 것은 무인 상태로 낡아 버린 마크로스급 함선의 모습이었다."

msgid "sn_dsc_0142"
msgstr "셰릴의 위문 라이브 날, 일부 병사들에 의한 폭동이 발생한다.\\n그들은 콰드란까지 사용하며 방해자를 제거하려 움직이기 시작했다."

msgid "sn_dsc_0143"
msgstr "오랜만의 휴일이라 미호시 학원에 등교한 란카.\\n친구들과 재회를 기뻐하던 중, 옷 속에 숨겨둔 친구가 불쑥 얼굴을 내밀었다."

msgid "sn_dsc_0144"
msgstr "셰릴이 탄 셔틀을 향해 경례하는 병사들.\\n위문 라이브를 앞두고도 그들의 질서 잡힌 움직임에는 한 치의 흐트러짐도 없었다."

msgid "sn_dsc_0145"
msgstr "마크로스 7 선단에서 활동하는 4인조 록 밴드.\\n넥키 바사라와 밀레느 지너스의 트윈 보컬로 인기를 얻고 있다."

msgid "sn_dsc_0147"
msgstr "전용기 『파이어 발키리』를 타고 바사라는 전장으로 뛰쳐나갔다.\\n그 조종간은 기타 모양으로 되어 있으며, 그야말로 바사라를 위해 개조된 기체다."

msgid "sn_dsc_0148"
msgstr "전투가 시작되자마자 바사라는 어딘가 폐허 안쪽으로 향했다.\\n그곳에는 전신이 새빨간 가변 전투기가 숨겨져 있었다."

msgid "sn_dsc_0149"
msgstr "Fire Bomber의 드럼을 담당하는 여성 젠트라디.\\n거의 말하지 않지만, 대신 드럼 스틱으로 대화할 수 있다."

msgid "sn_dsc_0150"
msgstr "Fire Bomber의 기타와 보컬을 담당한다.\\n음악에 대한 엄청난 열정을 가지고 있지만, 그 자유분방함으로 다른 사람을 휘두르는 경우도 많다."

msgid "sn_dsc_0151"
msgstr "Fire Bomber의 베이스와 보컬을 담당한다.\\n연주와 노래 모두 어른 못지않은 실력을 가지고 있지만, 나이에 맞게 아이 같은 면도 보여준다."

msgid "sn_dsc_0152"
msgstr "Fire Bomber의 리더이며 키보드를 담당한다.\\n항상 차분한 분위기를 풍기며, 어린 바사라와 밀레느를 타이르는 일도 자주 있다."

msgid "sn_dsc_0153"
msgstr "바로타군이 운용하는 가변 전투기.\\n머리 부분에서 방사되는 빔을 인간이 맞으면 생명 에너지를 흡수당한다."

msgid "sn_dsc_0154"
msgstr "엘리트 파일럿용 고성능 기체로 설계된 가변 전투기.\\n뛰어난 기동성과 화력을 갖추었으며, 특수 작전에 대응하기 위한 스텔스 성능도 중시되고 있다."

msgid "sn_dsc_0155"
msgstr "마크로스 7 선단 호위 부대의 기함. 작전 시의 총사령부.\\n긴급 상황에서는 항모 형태에서 인간형 로봇 형태로 변형할 수 있다."

msgid "sn_dsc_0156"
msgstr "마크로스 7 선단의 핵심이 되는 초대형 거주함.\\n함내에는 도시와 자연이 존재하며, 많은 사람들이 이곳에서 생활하고 있다."

msgid "sn_dsc_0157"
msgstr "바로타군과의 전투가 시작되었다는 것을 알게 된 바사라는 기세 좋게 어딘가로 뛰쳐나갔다.\\n남의 말을 듣지 않는 바사라에게 질려 하면서도 밀레느는 연주를 계속했다."

msgid "sn_dsc_0159"
msgstr "딸 밀레느가 연주하는 모습을 본 맥스는 무심코 속마음을 내뱉는다.\\n「이런 일을 시키려고 피아노를 배우게 한 건 아니었는데」―맥스"

msgid "sn_dsc_0160"
msgstr "갑작스럽게 벌어진 전투로 엄청난 충격과 강풍이 라이브 회장을 덮쳤다. 바사라에게\\n보호받았지만, 체격 차이 때문에 밀레느는 그의 품 안에 쏙 들어가 버렸다."

msgid "sn_dsc_0161"
msgstr "Fire Bomber의 라이브에 반드시 찾아오는 소녀.\\n바사라의 팬인 듯하지만, 언제나 그 꽃다발을 직접 건네지 못하고 있다."

msgid "sn_dsc_0162"
msgstr "라이브가 시작했는데도 바사라는 좀처럼 회장에 모습을 드러내지 않는다.\\n어디 있나 했더니, 놀랍게도 함선 천장에 매달린 채 무언가를 기다리고 있었다."

msgid "sn_dsc_0163"
msgstr "붉은 발키리를 타고 전장으로 뛰쳐나가 자신의 노래를 부르기 시작한 바사라.\\n「나는 이 순간을 기다리고 있었어!」―바사라"

msgid "sn_dsc_0164"
msgstr "치열한 전투가 벌어지는 우주 영역에 갑자기 끼어든 바사라.\\n통합군 파일럿 감린 키자키는 그 일에 분노를 감추지 못하는 모습이었다."

msgid "sn_dsc_0165"
msgstr "항모 배틀 7의 브리지에 앉아 있는 두 사람.\\n지구인인 함장 맥스와 젠트라디인 참모 엑세돌이다."

msgid "sn_dsc_0166"
msgstr "좀처럼 라이브 회장에 나타나지 않는 바사라.\\n마치 주인을 기다리는 듯 기타만 덩그러니 놓여 있었다."

msgid "sn_dsc_0167"
msgstr "Fire Bomber의 라이브에 뜨겁게 열광하던 팬들.\\n이번에는 바사라가 전장에서 노래하는 모습을 보고 환호하기 시작한다."

msgid "sn_dsc_0168"
msgstr "도시선 시티 7 한구석에 존재하는 작은 광장.\\n이날은 Fire Bomber의 라이브 회장으로 사용되고 있었다."

msgid "sn_dsc_0169"
msgstr "압도적인 인기를 자랑하는 톱 싱어, 셰릴 놈.\\n최신 홀로그램 기술로 꾸며진 화려한 라이브 연출 능력 또한 그녀의 매력이다."

msgid "sn_dsc_0170"
msgstr "【요정의 방문】 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_0171"
msgstr "셰릴의 라이브 회장으로 향하던 중 길을 잃은 란카.\\n그곳에서 우연히 알토와 마주치고, 청년이라고는 믿기 힘든 아름다움에 자신도 모르게 넋을 잃는다."

msgid "sn_dsc_0172"
msgstr "라이브 개최를 위해 우주선을 타고 프론티어 선단을 방문한 셰릴.\\n잠시나마 가희인 자신을 잊고, 눈앞에 펼쳐진 인공 바다에 감탄의 목소리를 흘렸다."

msgid "sn_dsc_0173"
msgstr "바주라의 습격을 받아 라이브 회장 뒷문으로 대피하는 셰릴.\\n때때로 냉정해 보이는 그녀지만, 그것은 프로로서의 자각이기도 하다."

msgid "sn_dsc_0174"
msgstr "프론티어 선단에 들어가기 직전 셰릴은 문득 표정을 바꾼다.\\n그 순간 그녀는 「은하의 요정 셰릴 놈」으로 변했다."

msgid "sn_dsc_0175"
msgstr "셰릴의 라이브 여흥으로 퍼포먼스를 하게 된 것에 불만스러운 알토.\\n동료 미셸의 놀림에 무심코 목소리를 높이고 만다."

msgid "sn_dsc_0176"
msgstr "토라져 있는 알토에게 이것은 리더인 자신의 결정이라고 타이르는 미셸.\\n「불만 있으면 다음엔 최고가 되라고」―미셸"

msgid "sn_dsc_0177"
msgstr "프론티어 선단에 배치된 VF-25.\\n특징 중 하나로 아머드 팩 장착 상태에서도 배틀로이드로 변형할 수 있다."

msgid "sn_dsc_0178"
msgstr "VF-25 시리즈는 프론티어 선단에서 개발된 최신예 발키리다.\\n주로 민간 군사 프로바이더 S.M.S가 운용하고 있다."

msgid "sn_dsc_0179"
msgstr "프론티어 선단의 항로상에 갑자기 나타난 정체불명의 적 반응.\\n즉시 방위 부대가 출격했지만, 전력 차이는 압도적이었다."

msgid "sn_dsc_0180"
msgstr "프론티어 선단을 습격한 적의 이름은 「바주라」.\\n그 모습은 명백히 생물이며, 지금까지의 어떤 군사 병기와도 달랐다."

msgid "sn_dsc_0182"
msgstr "S.M.S 소속 파일럿. 알토와는 동급생이자 라이벌.\\n장거리 저격에 특화된 VF-25G에 탑승하며, 수많은 전과를 올린 스나이퍼다."

msgid "sn_dsc_0184"
msgstr "어릴 때부터 함께 지내온 미셸과 클란 두 사람.\\n서로에게 빈정대는 일도 적지 않지만, 그 마음은 확실한 신뢰로 이어져 있다."

msgid "sn_dsc_0185"
msgstr "셰릴의 라이브 당일, 만원 전철을 타고 회장으로 향하는 란카.\\n최신 기술의 집약체인 우주 이민선이지만, 전철 혼잡 문제는 해결하지 못한 듯하다."

msgid "sn_dsc_0186"
msgstr "바주라의 습격으로부터 란카를 지키는 알토 앞에 란카의 오빠 오즈마가 나타난다.\\n그의 엄격한 말투에는 모르는 남자에게 여동생을 맡기는 것에 대한 불안이 섞여 있는 듯했다."

msgid "sn_dsc_0188"
msgstr "자신을 바주라로부터 지켜준 청년이 신경 쓰이는 란카.\\n그래서 민간 군사 프로바이더에서 일하는 오빠의 정보망을 이용하기로 한다."

msgid "sn_dsc_0189"
msgstr "아머드 팩에 탑재된 미사일의 일제 발사.\\n아무리 강인한 바주라라도 정면으로 맞으면 버틸 수 없다."

msgid "sn_dsc_0190"
msgstr "프론티어 선단 내부로 침입하기 전에 바주라를 격파하는 것.\\nVF-25F의 파일럿 길리엄은 강한 의지와 함께 기체를 가속했다."

msgid "sn_dsc_0191"
msgstr "생물 같은 외형을 가진 란카의 휴대전화.\\n손발을 늘려 헤드폰으로 만들거나 음악 재생 기기로 사용할 수도 있다."

msgid "sn_dsc_0192"
msgstr "중화요리점 「냥냥」은 은하를 넘어 전개된 체인점이다.\\n그 맛은 일품. 갓 만들어 따끈따끈할 때 먹는 것을 추천한다."

msgid "sn_dsc_0193"
msgstr "데뷔 라이브 당일, 회장에 모인 수많은 팬들 앞에서 긴장하는 프레이아.\\n하지만 일단 곡이 시작되자 멋진 노래와 춤으로 레슨의 성과를 선보였다."

msgid "sn_dsc_0195"
msgstr "다음 백신 라이브 개최가 결정되고, 그것이 하야테의 첫 출격 무대가 되었다.\\n미라쥬는 다시 정체불명의 적 부대에게 습격받을 가능성을 걱정하고 있었다."

msgid "sn_dsc_0196"
msgstr "예로부터 윈더미어에 존재하는 「바람의 노래꾼」.\\n그 노랫소리에는 특별한 힘이 있다고 전해지지만…"

msgid "sn_dsc_0197"
msgstr "자신의 환영회에서 무심코 감정이 북받친 듯한 프레이아.\\n「여전히 과장스럽네…」―하야테"

msgid "sn_dsc_0198"
msgstr "술자리에서 마음을 품고 있는 메서에게 말을 거는 마리안느.\\n하지만 동생 잭이 끼어들어 둘만의 대화는 이루어지지 못한 듯하다."

msgid "sn_dsc_0199"
msgstr "공중 기사단의 키스를 형으로 둔 윈더미어의 왕자 하인츠.\\n끝까지 신하로서의 태도를 지키는 형에게 어딘가 복잡한 마음을 품고 있었다."

msgid "sn_dsc_0200"
msgstr "한때 공중 기사단의 훈련 교관이었던 헬만.\\n윈더미어인으로서는 오래 살았으며, 그만큼 풍부한 경험을 가지고 있다."

msgid "sn_dsc_0201"
msgstr "라이브 시작 전, 모두 함께 원진을 짜고 있는 발키리.\\n새로운 멤버 프레이아도 합류해 어느 때보다 의욕이 넘친다."

msgid "sn_dsc_0202"
msgstr "윈더미어인은 감각을 표현할 때 「바람」이라는 말을 자주 사용한다.\\n그것은 그들이 가진 특수 기관 「룬」과 관련이 있는 듯하지만…"

msgid "sn_dsc_0203"
msgstr "발키리의 신멤버 프레이아의 환영회.\\n카오스 라그나 지부의 멤버들이 모여 성대하게 열리는 듯하다."

msgid "sn_dsc_0204"
msgstr "지구에서 아득히 먼 행성 윈더미어 IV에 존재하는 왕제 국가.\\n항상 눈으로 뒤덮여 있으며, 지구인과 매우 닮은 윈더미어인들이 살아가고 있다."

msgid "sn_dsc_0205"
msgstr "발키리의 리더 카나메와 델타 소대의 에이스 메서.\\n서로에 대한 신뢰는 깊으며, 전장에서도 그 호흡이 어긋나는 일은 없다."

msgid "sn_dsc_0206"
msgstr "발키리 멤버 카나메 버캐니어의 필살 대사.\\n스스로 노래할 뿐만 아니라 리더로서 일정 관리 등도 담당하고 있다."

msgid "sn_dsc_0207"
msgstr "「오늘 밤은 모두 승부 속옷」\\n「레이레이, 여자아이가 그런 말 하면 안 돼요!」―레이나, 마키나"

msgid "sn_dsc_0208"
msgstr "밤, 자신의 방에서 조용히 바깥을 바라보며 발키리의 미래를 생각하는 카나메.\\n「프레이아의 노래를 안정시킬 수 있다면, 미쿠모의 노래 힘도…」―카나메"

msgid "sn_dsc_0209"
msgstr "나체 냥냥의 야시장 앞에서 호객 노래를 선보이는 프레이아.\\n귀여운 프레이아의 노랫소리에 주변 사람들은 미소로 가득 찼다."

msgid "sn_dsc_0210"
msgstr "축제의 밤이 되면 주변은 커플이 많아지기 마련이다.\\n아무 관심 없어 보이는 하야테와 얼굴을 붉히는 미라쥬, 두 사람의 반응은 완전히 대조적이다."

msgid "sn_dsc_0211"
msgstr "델타 소대로부터 전출이 결정되어 짐 정리를 하던 메서.\\n「내일은 모두 함께 배웅하러 갈 거니까」―카나메"

msgid "sn_dsc_0212"
msgstr "발키리 팬들에게 응원을 받는 프레이아.\\n그 모습을 보고 선배인 마키나와 레이나도 안심하는 듯하다."

msgid "sn_dsc_0213"
msgstr "윈더미어를 뒤에서 지원하는 무기 상인으로 보이는 남자. 가변 전투기까지\\n조달할 수 있는 재력을 가진 것 외에는 대부분이 수수께끼에 싸여 있다."

msgid "sn_dsc_0214"
msgstr "어디선가 들려오는 바르화를 활성화시키는 「바람의 노래」.\\n마치 그 노래에 호응하듯 고대 유적들이 차례차례 반응하기 시작했다."

msgid "sn_dsc_0215"
msgstr "행성 라그나에는 해파리를 모티브로 한 특산물이 많이 존재한다.\\n해파리 만두도 그중 하나로, 해파리 축제의 야시장에서도 제공되었다."

msgid "sn_dsc_0216"
msgstr "마크로스 엘리시온 함상에서 조용히 술잔을 나누는 아라드와 어니스트.\\n「윈더미어와 인연이 있는 것 같군, 하야테 임멜만은」―아라드"

msgid "sn_dsc_0217"
msgstr "사신 메서와 백기사 키스. 운명에 이끌린 두 에이스가 이곳에서 조우한다.\\n「사신…」―키스"

msgid "sn_dsc_0218"
msgstr "델타 소대의 에이스 파일럿. 대장 아라드조차 능가하는 조종 기술을 지녔다.\\n하야테 일행의 교관 역할도 맡고 있으며, 일부러 매서운 태도로 그들을 단련하고 있다."

msgid "sn_dsc_0219"
msgstr "최신 기술을 아낌없이 사용한 발키리의 박력 넘치는 라이브.\\n미쿠모의 안무에 맞춰 『S』『O』『S』라는 글자가 떠오른다."

msgid "sn_dsc_0220"
msgstr "날뛰는 바르화 병사. 거리는 파괴와 혼란의 소용돌이에 휩싸여 간다.\\n하지만 바르화로 인한 비극이 있을 때, 그곳에는 반드시 발키리가 나타난다."

msgid "sn_dsc_0221"
msgstr "밀항에 성공한 듯했던 프레이아이지만, 우연히 하야테에게 발견되고 만다.\\n「가」「어차피 사정이 있는 거잖아?」―하야테"

msgid "sn_dsc_0222"
msgstr "골목길에서 프레이아와 이야기하던 하야테는 갑자기 나타난 여성에게 제압당한다.\\n하야테를 밀항범으로 착각한 미라쥬라는 여성은 바로 그 델타 소대의 대원이었다."

msgid "sn_dsc_0223"
msgstr "프레이아의 노랫소리에 깃든 힘을 발키리 멤버들은 확실히 느끼고 있었다.\\n「이 목소리!」「가슴이 따끔따끔해」―마키나, 레이나"

msgid "sn_dsc_0224"
msgstr "등 뒤에서 다가오는 미사일에 하야테는 순간적인 반응으로 조종간을 당겼다.\\n하야테의 외침에 응답하듯 발키리는 하늘 높이 날아올랐다."

msgid "sn_dsc_0225"
msgstr "바르화된 병사가 조종하는 리가드가 무방비한 시민에게 달려든다.\\n그 일격을 제대로 맞는다면 버텨낼 수 없을 것이다."

msgid "sn_dsc_0226"
msgstr "정체불명의 발키리 부대를 지휘하는 남자는 안경을 쓰고 전투 개시 명령을 내렸다.\\n「자, 바람을 타고 춤춰라. 하늘의 기사들이여!」―로이드"

msgid "sn_dsc_0227"
msgstr "라이브 시작과 함께 적 위치 등 필요한 정보를 수집하는 발키리와 델타 소대.\\n수많은 최신 기술로 이루어진 그녀들의 라이브는 곧 전투이기도 하다."

msgid "sn_dsc_0228"
msgstr "바르화 발생이 확인되면 발키리는 전장에서 라이브를 시작한다.\\n공포에 떠는 사람들에게 희망을 보여주는 그 모습은 그야말로 전장의 여신이다."

msgid "sn_dsc_0229"
msgstr "따가운 햇살 아래 뜨겁게 달아오른 해변에 여신이 내려왔다.\\n터질 듯한 미소와 넘치는 미모. 그녀의 무한한 매력에 끌리지 않을 사람은 없다."

msgid "sn_dsc_0230"
msgstr "조금 부끄러운 듯 모래사장에 서 있는 수영복 차림의 나나세.\\n균형 잡힌 몸매가 남성들의 시선을 끌고 있는 듯하다."

msgid "sn_dsc_0231"
msgstr "미셸과 클란은 소꿉친구 관계이며 서로를 잘 알고 있다.\\n하지만 잘 아는 사이이기에 오히려 중요한 순간에 솔직해지지 못하는 경우도 있다."

msgid "sn_dsc_0232"
msgstr "셰릴의 매니저인 그레이스도 수영복으로 갈아입고 해변을 걷고 있었다.\\n어른스러운 매력이 넘치는 수영복 모습에서는 조금 위험한 분위기가 풍긴다."

msgid "sn_dsc_0233"
msgstr "장난꾸러기 갈매기를 쫓아 바다에 뛰어든 척.\\n하지만 갈매기의 재빠름은 보통이 아니어서, 척조차도 상대하기 벅찬 듯하다."

msgid "sn_dsc_0234"
msgstr "싸움에 임하는 마음가짐을 설파하는 미라쥬에게 하야테는 의문을 던진다.\\n「즐거워? 나는 전사야, 지키기 위해 날아」―미라쥬"

msgid "sn_dsc_0235"
msgstr "석양에 비친 제프리의 옆모습. 그것을 몰래 바라보는 모니카.\\n소녀의 마음을 아는지 모르는지, 바다의 남자는 조용히 서 있다."

msgid "sn_dsc_0236"
msgstr "파라솔 아래에서 밀레느를 기다리며 조용히 독서하는 감린.\\n어쩌면 그 행동은 긴장을 억누르기 위한 방법일지도 모른다."

msgid "sn_dsc_0237"
msgstr "알토와 란카가 만나기로 한 세련된 카페.\\n시원한 그늘에서 쉬기에는 더없이 좋은 장소다."

msgid "sn_dsc_0238"
msgstr "리조트 함내의 해변에서 쉬고 있는 미녀.\\n검은 피부에 열대 음료, 그야말로 한여름 같은 모습이다."

msgid "sn_dsc_0239"
msgstr "프론티어 선단 안에는 지구와 마찬가지로 동물도 서식하고 있다.\\n바다 위를 유유히 나는 갈매기의 모습도 여름이라는 분위기를 재현하는 데 한몫하고 있다."

msgid "sn_dsc_0240"
msgstr "지구로 귀환한 마크로스는 태평양 위에 착수했다.\\n흘러가는 바닷바람과 짠내를 느낀 승무원들은 환호성을 질렀다."

msgid "sn_dsc_0241"
msgstr "매일 파일럿으로서 업무를 수행하는 미라쥬도 잠시 휴식을 얻었다.\\n바다에서 놀기로 했지만, 익숙하지 않은 수영복 차림에 자신도 모르게 귀 끝까지 붉어졌다."

msgid "sn_dsc_0242"
msgstr "델타 소대 소속 파일럿. 명문 지너스 가문 출신이다.\\n긍지를 가지고 임무에 나서는 우수한 파일럿이지만, 성실하고 융통성이 없는 면도 있다."

msgid "sn_dsc_0243"
msgstr "어머니가 맞선 상대 후보로 정해준 감린과 해변에서 만나기로 약속한 밀레느.\\n「그보다 감린 씨가 하시는 일 이야기를 듣고 싶어요」―밀레느"

msgid "sn_dsc_0244"
msgstr "내리쬐는 햇빛 아래 큰 튜브를 들고 모래사장을 달리는 밀레느.\\n꾸밈없는 미소가 흘러나오고, 아름다운 분홍색 머리카락이 산들바람에 흔들리고 있다."

msgid "sn_dsc_0245"
msgstr "은하의 요정 셰릴 놈은 당연히 이번 여름에도 광고 출연 요청이 끊이지 않는다.\\n「빛남은 차원이 다르다, 놈 퓨어실드」―셰릴"

msgid "sn_dsc_0246"
msgstr "알토와 만나기로 한 장소에 장난스러운 미소를 지으며 나타난 란카.\\n「싫어, 그렇게 빤히 보면 안 돼!」―란카"

msgid "sn_dsc_0247"
msgstr "리조트 함의 인공 바다에서 수영하는 밀레느.\\n인공이라고 해도 자연의 바다와 다르지 않아 인간도 물고기도 마음껏 헤엄칠 수 있다."

msgid "sn_dsc_0248"
msgstr "즉석 빈 캔 드럼으로 연주하는 비히다.\\n기묘한 광경에 사람들이 모이기 시작하지만, 본인은 전혀 신경 쓰지 않는 듯하다."

msgid "sn_dsc_0249"
msgstr "항상 란카의 뒤를 졸졸 따라다니는 아이군은 그녀의 소중한 친구다.\\n하지만 아이군이 도대체 누구이며 어디서 왔는지는 아직도 수수께끼로 남아 있다."

msgid "sn_dsc_0250"
msgstr "행성 라그나에 사는 라그나인은 물속 생활에 적합한 지느러미와 물갈퀴를 가지고 있다.\\n상점가에서 살 수 있는 기념품에도 그 특징이 반영되어 있는 듯하다."

msgid "sn_dsc_0251"
msgstr "마크로스 7 선단에 속한 리조트 함. 함내에 인공 바다가 있다.\\n해양 리조트 시설 외에도 어패류 양식과 연구 목적의 시설도 존재한다."

msgid "sn_dsc_0252"
msgstr "긴 여행 끝에 마침내 지구 귀환을 이룬 마크로스.\\n무사히 돌아왔다는 사실에 승무원들은 감동했고, 많은 이들이 눈물을 흘렸다."

msgid "sn_dsc_0253"
msgstr "바로타 전역이 종결되고, Fire Bomber는 은하에 이름을 떨치는 초유명 밴드가 되었다.\\n화려한 연출로 꾸며진 라이브로 오늘 밤도 수많은 팬들을 매료시킨다."

msgid "sn_dsc_0254"
msgstr "뜨거운 영혼을 눈부시게 불태우며, 라이브에 몰려든 수많은 팬들의 기대에 답한 바사라.\\n연출 교체를 위해 무대 뒤로 내려간 뒤에도 바사라를 부르는 목소리는 멈추지 않았다."

msgid "sn_dsc_0255"
msgstr "무언가 작업에 몰두하고 있는 그레이엄.\\n가볍게 인사를 건네는 바사라였지만, 그다지 환영받는 분위기는 아니었다."

msgid "sn_dsc_0256"
msgstr "트럭을 타고 바사라를 부르는 조라인의 소녀 엘마.\\n씩씩하게 목소리를 높이는 모습은 어딘가 밀레느와 닮은 면모를 느끼게 한다."

msgid "sn_dsc_0257"
msgstr "바사라가 사라지고 혼자 보컬을 맡게 된 밀레느.\\n라이브는 흥겨웠지만, 정작 밀레느 본인은 어딘가 부족함을 느끼는 듯하다."

msgid "sn_dsc_0258"
msgstr "행성 조라의 대기에는 은하 고래의 영향으로 대량의 잡균이 번식한다고 한다.\\n조라인 이외의 인간이라면 최악의 경우 죽음에 이를 수도 있다고 한다."

msgid "sn_dsc_0259"
msgstr "마크로스 7 선단을 떠나 목적지 없는 여행을 시작한 바사라.\\n쓸쓸한 표정으로 행성 조라의 석양을 바라본다."

msgid "sn_dsc_0260"
msgstr "엘마의 아버지이자 엄청난 거구인 그레이엄은 바사라를 가볍게 집어 들어 올렸다.\\n「정말 대단한 별이군…」―바사라"

msgid "sn_dsc_0261"
msgstr "은하계 변방에 위치한 행성 조라.\\n조라인이라는 원주민이 살고 있으며, 지구권과도 우호적인 관계를 맺고 있다."

msgid "sn_dsc_0262"
msgstr "그레이엄이 포경 작업을 할 때 착용하는 옷.\\n그의 체격에 맞춰 제작되었기 때문에 옷이라고 부르기에는 다소 거대하다."

msgid "sn_dsc_0263"
msgstr "행성 조라 부근을 회유하는 거대한 존재.\\n무리를 지어 이동하며, 그 무리는 특히 거대한 개체가 이끌고 있다."

msgid "sn_dsc_0264"
msgstr "은하 고래가 그려진 벽화.\\n수많은 무리가 장엄하게 헤엄치는 모습을 확인할 수 있다."

msgid "sn_dsc_0265"
msgstr "이민선에도 여름은 있다. 넘치는 미모로 해변 사람들의 시선을 사로잡는 셰릴 놈.\\n그 모습은 그야말로 눈부시게 빛나는 한여름의 요정!"

msgid "sn_dsc_0267"
msgstr "전설의 가희라 불리는 린 민메이도 한여름의 햇살 아래에서는 한 명의 소녀일 뿐이다.\\n수영복을 입고 해변에 서 있는 소녀는 왠지 평소보다 어른스러워 보인다."

msgid "sn_dsc_0268"
msgstr "마크로스 쿼터 함장 제프리는 사실 뛰어난 서퍼이기도 하다.\\n거대한 파도를 우아하게 타는 그의 모습은 모니카의 뜨거운 시선의 대상이 되었다."

msgid "sn_dsc_0269"
msgstr "휴가로 방문한 마얀 섬에서 란카와 함께 시간을 보내기로 약속한 알토.\\n거리 모니터에 비치는 아버지의 공연 광고를 보고 조금 불쾌한 표정을 짓는다."

msgid "sn_dsc_0270"
msgstr "과거 바주라에게 붙잡혔을 때, 란카는 바주라 안에서 마음의 존재를 느꼈다고 한다.\\n그 말을 듣고 바주라에게 마음 같은 게 있을 리 없다며 웃는 알토였지만…"

msgid "sn_dsc_0271"
msgstr "리조트 함에서의 라이브는 내키지 않는다고 투덜거리는 바사라를 혼내는 밀레느.\\n평소처럼 다투는 두 사람을 레이와 비히다는 아무 말 없이 지켜보고 있다."

msgid "sn_dsc_0272"
msgstr "함선 일부 구역이 봉쇄되면서 미처 도망치지 못한 바사라와 밀레느가 갇히고 만다.\\n그런 절체절명의 위기 상황에서도 두 사람은 평소처럼 말다툼을 시작했다."

msgid "sn_dsc_0273"
msgstr "마크로스 프론티어 선단 안에 존재하는 휴양지, 마얀 섬.\\n지구에 존재하는 같은 이름의 섬을 모델로 하고 있다."

msgid "sn_dsc_0274"
msgstr "바사라의 제멋대로인 행동에 분노를 드러내는 밀레느.\\n하지만 일단 바다에 나가자 그런 일은 잊고 천진난만하게 뛰어나갔다."

msgid "sn_dsc_0275"
msgstr "알토와 란카가 주문한 산더미 같은 빙수.\\n참고로 란카가 주문한 것은 오른쪽의 커다란 빙수다."

msgid "sn_dsc_0276"
msgstr "해변에 떨어져 있던 것으로 보이는 빈 캔으로 만든 드럼.\\n캔캔거리는 어설픈 소리도 나름대로 운치가 있어서 좋을지도 모른다…"

msgid "sn_dsc_0277"
msgstr "기억을 되찾고 자신의 마음과 정면으로 마주한 란카.\\n그녀의 노랫소리에 깃든 힘은 그녀 자신의 성장과 함께 지금껏 없던 수준으로 높아졌다."

msgid "sn_dsc_0279"
msgstr "출격 직전, 긴장과 결의가 가득한 모습으로 알토 앞에 나타난 란카.\\n떨리는 입술로 알토에 대한 마음을 전하고, 반드시 무사히 돌아와 달라고 바랐다."

msgid "sn_dsc_0280"
msgstr "싸움은 끝났다. 하지만 셰릴은 의식을 잃고 알토는 행방불명이 되었다.\\n그럼에도 란카는 언젠가 다시 세 사람이 함께 웃을 날이 올 것이라 믿고 있었다."

msgid "sn_dsc_0281"
msgstr "전장에 울려 퍼지는 셰릴과 란카의 노랫소리가 브레라의 깊은 곳에 잠든 마음을 흔들었다.\\n그리고 입 밖으로 나온 것은 이제 존재하지 않을 터였던 「감정」이라는 말이었다."

msgid "sn_dsc_0282"
msgstr "바주라들도 인간과 마찬가지로 마음을 가지고 있었고, 그 마음으로 싸움의 고통을 느끼고 있었다.\\n셰릴에게 받은 귀걸이를 통해 알토는 그 고통을 확실히 느꼈다."

msgid "sn_dsc_0283"
msgstr "부활한 셰릴에 이어 란카도 노래를 맞춰 부르기 시작한다.\\n은하의 요정과 어깨를 나란히 하는 신데렐라. 특별한 듀엣 메들리가 시작되었다."

msgid "sn_dsc_0284"
msgstr "알토의 마음을 알고 있었기에, 그때 고백의 대답을 하지 말라고 막았던 란카.\\n그 노랫소리에 깃든 애절함은 그래도 마음을 억누를 수 없음을 보여주고 있었다."

msgid "sn_dsc_0285"
msgstr "셰릴을 구출하고 전장으로 돌아온 오즈마를 애기가 맞이한다.\\n「고맙다!」―오즈마"

msgid "sn_dsc_0286"
msgstr "은하 각지에서 달려온 S.M.S의 증원 부대.\\n그 안에는 수많은 전장을 헤쳐온 에이스 파일럿들도 이름을 올리고 있는 듯하다."

msgid "sn_dsc_0287"
msgstr "바주라들은 몸에 주입된 임플란트 탄환에 의해 조종되고 있었다.\\n그 사실만 알게 된다면 인류 측이 반격에 나서는 것은 쉬운 일이었다."

msgid "sn_dsc_0288"
msgstr "적진 한가운데서 위기에 처한 마크로스 쿼터.\\n그때 수많은 증원 부대가 위성 궤도상에 나타났다."

msgid "sn_dsc_0289"
msgstr "하늘을 나는 알토를 밀어주듯 두 명의 가희는 계속 노래한다.\\n그 노랫소리는 날개를 선사하는 동시에 하늘을 가르는 거대한 바람을 만들어내는 듯했다."

msgid "sn_dsc_0291"
msgstr "여왕 바주라를 향한 일제 포격. 알토는 셰릴과 란카를 바라본다.\\n그리고 가슴속에 숨겨왔던 마음을 털어놓는다."

msgid "sn_dsc_0292"
msgstr "여성 젠트라디만으로 구성된 소대.\\n대장 클란 클란을 필두로 모두가 뛰어난 실력을 지니고 있다."

msgid "sn_dsc_0293"
msgstr "아침 햇살에 비치는 여왕 바주라와 금빛을 두른 YF-29.\\n사오토메 알토의 빛의 춤. 그 환상적인 아름다움에 그 자리에 있던 모두가 매료되었다."

msgid "sn_dsc_0294"
msgstr "전투 중 뜻하지 않게 임플란트의 지배에서 벗어난 그레이스.\\n마지막으로 보고 싶다고 바랐던 것은 셰릴의 노랫소리가 은하를 뒤흔드는 순간이었다."

msgid "sn_dsc_0295"
msgstr "당신의 몫까지 노래하겠다고. 자신을 지켜준 그레이스에게 그렇게 맹세한 셰릴.\\n얼마 남지 않은 생명의 힘을 쥐어짜며, 은하의 요정은 다시 무대에 올랐다."

msgid "sn_dsc_0296"
msgstr "언제나 수많은 팬들에게 둘러싸여 은하 최고의 싱어로 노래해 온 셰릴.\\n하지만 지금 이 순간 그녀의 노래는 단 한 명의 소중한 사람을 위해 불린 것이었다."

msgid "sn_dsc_0297"
msgstr "여왕 바주라에게 접근하는 YF-29. 그 날개에서 갑자기 나타난 눈부신 금빛.\\n그것은 마치 하늘에 일렁이는 오로라처럼 아름다운 것이었다."

msgid "sn_dsc_0298"
msgstr "미워할 필요는 없어. 서로 상처 입힐 필요도 없어. 알토는 필사적으로 마음을 전하려 했다.\\n그때 지배에서 풀려난 여왕 바주라는 공격을 멈췄다."

msgid "sn_dsc_0299"
msgstr "수많은 마크로스 쿼터에 의한 일제 포격.\\n그 파괴력으로 인해 전선에 있는 알토까지 휘말릴 수도 있을 것이다."

msgid "sn_dsc_0300"
msgstr "마크로스 쿼터 단독으로는 대기권 돌입 시의 열을 견딜 수 없다.\\n하지만 함장 제프리는 함선 잔해를 보드 삼아 파도타기를 하는 방식으로 돌파해냈다."

msgid "sn_dsc_0313"
msgstr "발키리의 리더이자 연장자인 카나메.\\n다소 도발적이고 성숙한 안무까지 소화해내는 그녀의 모습은 많은 팬을 매료시키고 있다."

msgid "sn_dsc_0315"
msgstr "발키리의 절대적인 에이스인 미쿠모.\\n그녀의 노래 힘을 끌어내는 것 또한 리더인 자신의 역할이라고 카나메는 생각하고 있다."

msgid "sn_dsc_0316"
msgstr "일이 끝난 뒤 메서에게 술을 마시자고 권했지만 거절당한 카나메.\\n평소에도 자주 말을 거는 듯하지만, 그는 거의 권유에 응하지 않는 듯하다."

msgid "sn_dsc_0317"
msgstr "라이브 전의 필살 구호를 외치는 카나메.\\n그 말 그대로 바르와 싸우는 발키리의 라이브는 항상 목숨을 건 일이다."

msgid "sn_dsc_0318"
msgstr "개성이 너무 강한 멤버들을 이끄는 역할로, 다른 멤버들이 모르는 고생을 짊어져 왔다.\\n그리고 어느새 그녀는 모두에게 의지받는 리더가 되어 있었다."

msgid "sn_dsc_0319"
msgstr "미쿠모의 사생활에 대해서는 카나메조차 모르는 부분이 많은 듯하다.\\n하지만 카나메 본인도 그다지 신경 쓰지는 않는 듯하다."

msgid "sn_dsc_0320"
msgstr "발키리 신멤버 오디션 결과를 발표하는 카나메.\\n리더로서 엄격한 결정을 내리는 것, 그것 또한 그녀의 일이다."

msgid "sn_dsc_0321"
msgstr "백신 라이브에는 발키리의 노래 힘으로 바르 발생을 예방하는 목적이 있다.\\n영상이나 음성만으로는 효과가 발휘되지 않기 때문에 정기적으로 라이브가 열리고 있다."

msgid "sn_dsc_0322"
msgstr "발키리의 라이브 영상을 바라보는 로이드.\\n아무래도 발키리의 노래가 그들의 목적에 방해가 되는 듯한데…?"

msgid "sn_dsc_0323"
msgstr "행성 라그나의 명물 중 하나.\\n생으로 먹어도 맛있지만, 말리면 술안주로 딱 좋다."

msgid "sn_dsc_0324"
msgstr "여자 기숙사 안에 있는 카나메의 개인실.\\n이곳에서 일하는 경우도 많은지 단말기와 자료 등이 놓여 있다."

msgid "sn_dsc_0325"
msgstr "민메이의 노랫소리를 이용해 문화를 모르는 젠트라디 병사들의 사기를 떨어뜨리는 작전.\\n전선에서 노래하는 그 모습은 아군 병사들의 사기 고취로도 이어졌고, 후세에도 전설로 전해지게 된다."

msgid "sn_dsc_0327"
msgstr "수많은 라이벌이 있는 가운데, 당당히 초대 미스 마크로스에 빛난 민메이.\\n이후 같은 형태의 콘테스트가 각지에서 전통적으로 개최되기 시작한다."

msgid "sn_dsc_0328"
msgstr "미스 마크로스 프론티어 심사 직전, 긴장으로 풀이 죽은 란카.\\n그 등을 밀어준 것은 동경하던 셰릴 놈이었다."

msgid "sn_dsc_0329"
msgstr "민메이의 노래와 함께 공격하는 작전에 일부 젠트라디 함대도 찬성 의사를 보였다.\\n여기서 역사상 최초의 이종족 간 동맹이 성립된 것이다."

msgid "sn_dsc_0330"
msgstr "란카의 퍼포먼스도 끝나고 콘테스트는 무사히 막을 내렸다.\\n심사위원들 사이에는 온화한 미소를 짓는 셰릴의 모습도 있었다."

msgid "sn_dsc_0331"
msgstr "모의전 도중 갑자기 습격한 바주라를 간신히 격퇴한 알토 일행.\\n무모한 공격으로 돌진한 알토가 걱정됐는지, 미셸은 조용히 한숨을 내쉬었다."

msgid "sn_dsc_0332"
msgstr "임무 중인데도 발키리 안에서 콘테스트 방송을 보고 있는 히카루.\\n아무도 듣고 있지 않은 것을 핑계로 조금 우쭐해하는 모습이다."

msgid "sn_dsc_0333"
msgstr "콘테스트에 출전한 민메이를 흐뭇한 표정으로 지켜보는 히카루.\\n그때 긴급 출동 소식이 전해지고, 히카루는 마지못해 기지로 돌아갔다."

msgid "sn_dsc_0334"
msgstr "콘테스트 심사용 수영복을 입은 민메이를 보고 젠트라디 병사는 의문을 느낀다.\\n저렇게 얇은 옷으로 정말 전투를 할 수 있는 것인가…라고."

msgid "sn_dsc_0335"
msgstr "수영복 차림의 여성들을 보고 이해할 수 없는 문화에 머리를 싸매는 세 사람.\\n하지만 말로 표현할 수 없는 매력은 느끼고 있는 듯하다."

msgid "sn_dsc_0336"
msgstr "마크로스 함내 TV 방송국 개국을 기념해 개최된 미스 마크로스 콘테스트.\\n상당한 수의 카메라맨이 회장에 모여 있었다."

msgid "sn_dsc_0337"
msgstr "바르 신드롬에 유일하게 맞설 수 있는 발키리 노래의 힘.\\n아직 만나지 못한 수많은 「누군가」를 구하기 위해 그녀들은 매일 노력하고 있다."

msgid "sn_dsc_0338"
msgstr "【결의를 품고】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_0339"
msgstr "메서에게 한 방 먹여주겠다고 말하는 하야테. 분함을 양분 삼아 그의 재능은 더욱 성장해 간다.\\n「사신 녀석에게 본때를 보여주자고!」―하야테"

msgid "sn_dsc_0340"
msgstr "배틀로이드 형태의 능숙한 조종으로 소행성을 피해 가는 하야테.\\n임멜만 댄스라 불린 그 움직임은 무중력 우주에서도 건재했다."

msgid "sn_dsc_0341"
msgstr "전장에서 몇 번이고 맞붙게 되는 키스와 메서 두 사람.\\n특히 키스에게 메서는 자신과 맞설 수 있는 유일한 호적수가 된 듯하다."

msgid "sn_dsc_0342"
msgstr "훈련 후 하야테에게 혹독한 평가를 내리는 메서.\\n하지만 그 엄격함 역시 부하를 전장에서 헛되이 죽게 하고 싶지 않다는 마음에서 비롯된 것이었다."

msgid "sn_dsc_0343"
msgstr "전장에서 훌륭한 연계를 보여주며 서로를 보완하는 두 사람.\\n선배인 미라쥬도 하야테의 성장을 인정하고 있는 듯하다."

msgid "sn_dsc_0344"
msgstr "전장에서 훌륭한 연계를 보여주며 서로를 보완하는 두 사람.\\n미라쥬를 향한 신뢰 역시 하야테 자신의 성장의 증거일지도 모른다."

msgid "sn_dsc_0345"
msgstr "근접 전투용 나이프로 적 발키리의 팔다리만 파괴하는 아라드.\\n쉽게 해내는 것처럼 보이지만, 고도의 조종 기술이 필요한 기술이다."

msgid "sn_dsc_0346"
msgstr "나체 냥냥에서 식사를 하는 엘리시온의 여성 승무원들.\\n평소와 달리 무언가 분주한 가게 분위기에 편히 있지 못하는 듯하다."

msgid "sn_dsc_0347"
msgstr "과거 윈더미어에서 차원 병기가 사용된 장소.\\n오랜 시간이 지난 지금도 번개가 계속 빛나는 기묘한 광경이 남아 있다."

msgid "sn_dsc_0348"
msgstr "슈퍼 팩을 장비한 VF-31S.\\n발키리의 노래 효과를 높이는 특수 스피커도 장착되어 있다."

msgid "sn_dsc_0349"
msgstr "미스 마크로스 콘테스트 잠입을 시도하는 레이나 일행.\\n이날을 위해 준비한 특별한 의상으로 우승을 휩쓸어 버릴 것 같다."

msgid "sn_dsc_0351"
msgstr "드라마 촬영 도중 또다시 바로타군의 습격이 시작되었다.\\n다시 한번 노래해 주겠다고 의욕을 불태우는 바사라에게 밀레느도 조금씩 영향을 받는다."

msgid "sn_dsc_0352"
msgstr "용기를 쥐어짜 미스 마크로스 프론티어에 출전한 란카.\\n긴장으로 몸을 떨면서도 연습한 곡을 힘차게 부르기 시작한다."

msgid "sn_dsc_0353"
msgstr "아르바이트 도중 부주의로 접시를 산산조각 내버린 란카.\\n아무래도 몰래 응모한 콘테스트 결과가 신경 쓰이는 모양이다."

msgid "sn_dsc_0354"
msgstr "란카가 콘테스트에 참가한다는 것은 오즈마에게 절대 비밀이다.\\n오즈마가 사실을 알게 되는 순간, 분명 란카를 데려가려 할 것이다."

msgid "sn_dsc_0355"
msgstr "훈련에서 받은 페널티가 쌓여 엄청난 무게의 슈트를 입게 된 알토.\\n이 상태로 격납고를 몇 바퀴나 돌게 된다고 한다."

msgid "sn_dsc_0356"
msgstr "콘테스트 무대에 올라 자기소개를 하는 란카.\\n긴장한 나머지 마이크에 이마를 부딪치고 말았다."

msgid "sn_dsc_0357"
msgstr "콘테스트 회장에서 우연히 아버지와 마주치고 의아한 표정을 짓는 알토.\\n가부키 명문 사오토메 가문의 아들로서 여러 가지 생각이 있는 듯하다."

msgid "sn_dsc_0358"
msgstr "모의전 중 적을 격파한 알토는 우아하게 포즈를 취한다.\\n발키리를 타도 그림이 되는 남자…라고 해도 전투 중 방심은 금물이다."

msgid "sn_dsc_0359"
msgstr "무대 뒤에서 긴장하고 있는 란카에게 알토가 격려의 메일을 보낸다.\\n무뚝뚝한 문장이지만 란카에게는 이것만으로도 충분히 힘이 된다."

msgid "sn_dsc_0360"
msgstr "모의전 우주 영역을 떠돌고 있던 젠트라디 군함의 잔해.\\n과거 성간 전쟁 시대부터 계속 이 모습 그대로였던 듯하다."

msgid "sn_dsc_0361"
msgstr "조금 이른 봄의 시작을 느끼게 하는 화려한 금붕어 무늬 기모노.\\n하늘하늘 흔들리는 그 디자인은 란카 리의 새로운 매력을 보여준다."

msgid "sn_dsc_0362"
msgstr "【새봄의 바람】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_0363"
msgstr "푸른 하늘 아래 차분한 일본 전통 의상을 멋지게 소화한 알토.\\n그 출신 때문인지 그저 서 있는 모습조차도 잘 어울린다."

msgid "sn_dsc_0364"
msgstr "지구의 문화를 따라 첫 참배를 하러 온 루카와 나나세.\\n화려한 전통 의상을 입은 나나세를 보고 루카는 속으로 편치 않은 듯하다."

msgid "sn_dsc_0365"
msgstr "클란에게 VF-25G의 스나이퍼 라이플을 넘겨받은 알토.\\n친구의 마음을 피부로 이어받은 듯 알토는 오른손을 내밀었다."

msgid "sn_dsc_0366"
msgstr "바주라와의 결전에 미셸의 애기를 몰고 출격하는 클란.\\n슬픔을 극복한 그녀의 눈동자는 그저 똑바로 적을 바라보고 있었다."

msgid "sn_dsc_0367"
msgstr "결전을 앞두고 나나세의 병실을 찾은 루카.\\n비겁자라고 불려도 상관없다고 말하며, 루카는 사랑하는 그녀에게 조용히 입을 맞춘다."

msgid "sn_dsc_0368"
msgstr "출격을 앞두고 알토와 셰릴은 단둘이 이야기를 나눈다.\\n하지만 결의를 흐리지 않기 위해 마지막까지 서로의 마음을 전하지 않았다."

msgid "sn_dsc_0369"
msgstr "뒤에서 암약하는 진정한 적의 정체를 밝혀내기 위해 S.M.S가 전장으로 돌아온다.\\n인류와 바주라의 결전은 갑자기 그 양상이 변하기 시작했다."

msgid "sn_dsc_0370"
msgstr "프론티어 선단의 운명을 건 바주라의 별에 대한 공격 작전.\\n전황이 유리하게 흘러가는 것을 본 레온은 입꼬리를 올렸다."

msgid "sn_dsc_0371"
msgstr "S.M.S가 프론티어 선단을 이탈한 뒤, 선단에 남은 알토는 기체를 갈아탄다.\\n역시 최신예 VF-25와는 감각이 다른 듯, 반응 속도의 차이에 애를 먹는다."

msgid "sn_dsc_0372"
msgstr "무수한 바주라들 사이에서 군림하는 여왕, 바즈라 퀸.\\n마크로스급 전함에 버금가는 거대한 몸집을 자랑한다."

msgid "sn_dsc_0373"
msgstr "일본풍 분위기로 통일된 방 안에서 은하의 요정은 온화하게 미소 짓는다.\\n섹시하지도 큐트하지도 않은, 새로운 매력을 두른 셰릴 놈의 모습이다."

msgid "sn_dsc_0374"
msgstr "마크로스 갤럭시 선단 소속 안타레스 소대의 파일럿.\\n신체 대부분을 임플란트화했으며, 전투 능력은 매우 높다."

msgid "sn_dsc_0375"
msgstr "란카의 어린 시절 기억.\\n오빠가 연주하는 하모니카 선율에 맞춰 함께 불렀던 것은 추억의 노래였다."

msgid "sn_dsc_0376"
msgstr "그레이스 오코너와 레온 미시마.\\n바주라와의 최종 결전을 앞두고 그들의 계획이 움직이기 시작하려 하고 있었다."

msgid "sn_dsc_0377"
msgstr "바주라 퀸과 맞서는 알토와 브레라.\\n격렬한 공격을 뚫고 눈앞으로 다가온다."

msgid "sn_dsc_0378"
msgstr "사람은 혼자이기 때문에 누군가를 사랑할 수 있다.\\n바주라의 힘을 이용하려는 그레이스를 향해 알토는 그렇게 외쳤다."

msgid "sn_dsc_0385"
msgstr "생일에 받은 서프라이즈 선물, 그 안에는 화려한 의상이 들어 있었다.\\n푸른 장미가 장식된 그 의상은 꿈을 이룬 그녀에게 꼭 어울리는 것이리라."

msgid "sn_dsc_0386"
msgstr "티타늄 훈장을 수여받고 소위로 승진한 히카루에게 포커는 계급장을 던져 주었다.\\n「그 훈장과 바꿔 달아. 자랑하고 다니는 물건이 아니야」─포커"

msgid "sn_dsc_0387"
msgstr "민메이에게 줄 생일 선물로, 군인의 자부심이라 할 수 있는 훈장을 건넨 히카루.\\n그에게 있어 싸워서 얻은 명예보다 더 중요한 것은 민메이의 미소였다."

msgid "sn_dsc_0388"
msgstr "차이나 드레스를 입은 민메이를 보고 들뜬 기분이 된 카키자키였지만,\\n실제로 민메이의 관심은 잘생긴 맥스에게 향하고 있었다."

msgid "sn_dsc_0389"
msgstr "맥스와 카키자키를 데리고 냥냥을 찾은 히카루.\\n마중 나온 민메이의 차이나 드레스 모습을 보고 무심코 얼굴을 붉히고 말았다."

msgid "sn_dsc_0390"
msgstr "첫 전투에서 적기 7기나 격추하는 등 놀라운 활약을 보인 맥스.\\n하지만 본인은 자신의 재능을 깨닫지 못한 듯, 천재라 불리는 것을 무척 기뻐하고 있다."

msgid "sn_dsc_0391"
msgstr "민메이와 히카루의 관계를 두고 가볍게 농담하는 카키자키.\\n전투 전에도 이런 모습이니, 사실은 대단한 인물일지도 모른다."

msgid "sn_dsc_0392"
msgstr "부하인 맥스와 카키자키에게 「대장」이라고 불리며 기분이 좋아진 히카루.\\n「잘 따라오라고!」―히카루"

msgid "sn_dsc_0393"
msgstr "민메이를 보자마자 악수를 청하는 카키자키.\\n너무 거센 기세에 민메이는 조금 무서워했던 모양이다."

msgid "sn_dsc_0394"
msgstr "스크램블 출동 소식을 듣고 택시를 타고 돌아가려는 히카루 일행.\\n그때 마침 같은 냥냥에서 식사하던 군인들이 택시 안으로 몰려들었다."

msgid "sn_dsc_0395"
msgstr "히카루에게 좋은 곳에 데려가 주겠다는 말을 듣고 들뜬 카키자키.\\n무슨 착각을 한 건지, 밤의 가게 앞에서 혼자 들떠 버렸다."

msgid "sn_dsc_0396"
msgstr "민메이에게 생일 선물을 주지 않았다는 것을 떠올린 히카루.\\n급히 밖으로 뛰쳐나갔지만, 모든 가게는 이미 문을 닫은 뒤였다."

msgid "sn_dsc_0397"
msgstr "할로윈을 이미지한 새로운 의상을 입고 레이나는 무대로 뛰어나간다.\\n주변을 날아다니는 유령들도 오늘 밤은 날개가 달린 할로윈 특별 사양이다."

msgid "sn_dsc_0398"
msgstr "발키리를 탄 사신이 그 이름 그대로의 모습으로 밤의 세계에 내려왔다.\\n한순간이라도 틈을 보이면, 날카롭게 빛나는 그 낫의 제물이 되고 말 것 같다."

msgid "sn_dsc_0399"
msgstr "신비로운 밤으로 이끄는 듯 매력적인 의상을 입은 카나메.\\n그 아름다움에 매료되어 무덤에서 나온 귀신들조차 볼을 붉힌다."

msgid "sn_dsc_0400"
msgstr "어딘가 덧없는 분위기를 풍기며 화려한 할로윈 의상을 걸친 셰릴.\\n소악마적이라고도 할 수 있는 그 매력에 당신은 분명 저항할 수 없을 것이다."

msgid "sn_dsc_0401"
msgstr "윈더미어에 잠입한 하야테 일행을 붙잡은 키스.\\n로이드와 통신하는 그의 목소리에는 무언가 생각이 담긴 듯했다."

msgid "sn_dsc_0402"
msgstr "란카의 호위를 위해 수업 중인 교실에 자리 잡은 브레라.\\n마치 수업 참관처럼 보이기도 하지만, 그 모습은 상당히 기묘했다."

msgid "sn_dsc_0403"
msgstr "마크로스 7 선단 공격 작전에 불만을 품은 기길.\\n하지만 게페르니치의 한마디에는 거부할 수 없는 위압감이 있었다."

msgid "sn_dsc_0404"
msgstr "란카의 노래가 바주라와의 전투에서 유효하다는 것이 증명되었다.\\n이 결과에 수상한 미소를 짓는 레온과 그레이스, 그들의 속셈은 과연…"

msgid "sn_dsc_0405"
msgstr "항해 중인 마크로스 7 선단을 습격한 정체불명의 적 부대.\\n발키리와 매우 흡사한 병기를 운용하는 듯하지만, 자세한 내용은 밝혀지지 않았다."

msgid "sn_dsc_0406"
msgstr "마크로스 함내에 잠입한 젠트라디군 병사들.\\n우연히 들은 「디스코」라는 단어조차 그들에게는 의미를 알 수 없는 것이었던 모양이다."

msgid "sn_dsc_0407"
msgstr "지구산 사탕을 먹은 젠트라디 병사들은 모두 놀라움을 표현했다.\\n함선으로 사탕을 가져온 세 사람은 그런 반응에 어딘가 으스대는 모습이었다."

msgid "sn_dsc_0408"
msgstr "젠트라디 사람들은 군복을 입고 있지 않으면 아무래도 불안한 듯하다.\\n지구인 여성이 군복으로 갈아입는 것을 보자마자 달려갔다."

msgid "sn_dsc_0409"
msgstr "할로윈에 딱 맞는 디자인이 귀여운 란카의 라이브 의상.\\n오늘 밤은 할로윈, 귀여운 마녀가 당신에게 반짝이는 마법을 걸어줄 것이다."

msgid "sn_dsc_0411"
msgstr "바사라의 선글라스가 달린 늑대 모자와 커다란 꼬리, 그리고 날카로운 발톱 장갑.\\n조금 유치하다며 불평하면서도, 결국에는 기대하고 있는 밀레느였다."

msgid "sn_dsc_0412"
msgstr "설마 자신까지 할로윈 의상을 입게 될 줄은 몰라 쑥스러워하는 미사.\\n그 부끄러워하는 모습 또한 그녀의 매력이라고 할 수 있을지도 모른다."

msgid "sn_dsc_0413"
msgstr "필사적으로 도망치던 미쿠모 앞을 가로막는 로이드.\\n그의 말을 듣고 움직임을 멈춘 미쿠모는 틈을 찔려 기절하고 만다."

msgid "sn_dsc_0414"
msgstr "은하를 지배하는 것, 그리고 그 너머를 목표로 한다.\\n그레이스가 말하는 「우리」라는 집단은 헤아릴 수 없는 계획 아래 움직이고 있는 듯하다."

msgid "sn_dsc_0415"
msgstr "무력 반란을 계획한 템진이었지만, 란카의 노래에 의해 저지되고 만다.\\n하지만 그럼에도 주모자인 템진은 전투를 멈추려 하지 않았다."

msgid "sn_dsc_0416"
msgstr "적 함선에 스파이를 보내는 작전에 소극적이라고 말하는 밀리아.\\n무훈을 세운 에이스 파일럿다운 발언이다."

msgid "sn_dsc_0417"
msgstr "양동 작전을 실시하겠다는 게페르니치에게 무언가 말하고 싶은 듯한 기길.\\n지구인을 상대로 계략을 꾸미는 것에는 찬성하지 않는 듯하다."

msgid "sn_dsc_0418"
msgstr "젠트라디군의 지휘관인 캄진.\\n그 용맹함과 실적은 확실하지만, 무모하고 성급한 성격 때문에 문제도 끊이지 않는다."

msgid "sn_dsc_0419"
msgstr "마크로스에 기습을 가하기 위해 적 부대가 계곡 깊숙한 곳에 숨어 있었다.\\n그들을 이끄는 것은 캄진. 젠트라디의 위험한 장교다."

msgid "sn_dsc_0420"
msgstr "라커룸에서 지구인의 옷을 구한 젠트라디 세 사람.\\n곧바로 마크로스 함내 시가지로 향했다."

msgid "sn_dsc_0421"
msgstr "발키리의 호위와 라이브 퍼포먼스를 담당하는 전속 부대.\\n대장 아라드를 필두로 개성 넘치지만 실력 있는 멤버들로 구성되어 있다."

msgid "sn_dsc_0422"
msgstr "델타 소대를 이끄는 대장. 과거에는 신통합군에 소속되어 있었다.\\n대장으로서도 파일럿으로서도 뛰어나며, 해파리와 관련된 속담을 자주 사용한다."

msgid "sn_dsc_0423"
msgstr "매번 수많은 팬이 몰려드는 발키리의 백신 라이브.\\n노랫소리뿐만 아니라, 공들인 연출과 인상적인 춤도 놓칠 수 없다."

msgid "sn_dsc_0424"
msgstr "사적으로도 사이가 좋은 마키나와 레이나.\\n두 사람의 호흡이 잘 맞는 콤비 플레이를 기대하는 팬도 많다."

msgid "sn_dsc_0425"
msgstr "어딘가에서 발키리의 라이브를 감시하고 있던 로이드.\\n그의 지시가 계기가 되어 새로운 싸움의 막이 오르려 하고 있었다."

msgid "sn_dsc_0426"
msgstr "로이드에게서 작전 개시 신호를 받은 키스.\\n그 말투에서는 남다른 결의가 느껴진다."

msgid "sn_dsc_0427"
msgstr "분노로 마음이 흐트러져 무의식적으로 룬을 빛내버리는 보그.\\n윈더미어인의 감정은 룬에 잘 드러나는 듯하다."

msgid "sn_dsc_0433"
msgstr "고향 윈더미어의 파일럿들에게 배신자라고 욕을 먹고 결의가 흔들리는 프레이아.\\n모두가 그녀를 걱정하는 가운데, 미쿠모만은 냉정하다고 느껴질 정도의 말로 프레이아에게 물었다."

msgid "sn_dsc_0434"
msgstr "검은 의상과 어우러져 검은 고양이 같은 분위기로 다채로운 세계에 녹아든 미쿠모.\\n유연하고 신비로운 모습과 가끔 보여주는 천진난만한 표정은 미쿠모의 매력 중 하나일지도 모른다."

msgid "sn_dsc_0435"
msgstr "공중 기사단의 멤버인 보그와 키스.\\n지구인의 기준으로는 아직 젊은 두 사람이지만, 공중 기사단을 지탱하는 뛰어난 파일럿이다."

msgid "sn_dsc_0436"
msgstr "윈더미어 왕국의 재상을 맡고 있는 남자로, 공중 기사단의 키스와는 오랜 지인이다.\\n안경에 대한 취향이 확고한 듯하며, 자신의 방에 수많은 안경을 수집하고 있다."

msgid "sn_dsc_0437"
msgstr "저녁 시간임에도 이날 나체 냥냥은 평소 이상으로 많은 손님으로 북적였다.\\n윈더미어와의 전쟁이 시작되면서 아이러니하게도 경기가 좋아진 것이다."

msgid "sn_dsc_0438"
msgstr "메서의 엄격한 말투에 짜증을 감추지 못하는 하야테지만, 그의 실력은 인정하고 있었다.\\n「푸른 하늘에 한 줄기, 쭉 뻗은 날카로운 선이 곧게 뻗어나가고…」―하야테"

msgid "sn_dsc_0439"
msgstr "메서와 미쿠모의 엄격함 때문에 한동안 풀이 죽었던 하야테와 프레이아.\\n하지만 그 마음을 발판으로 삼을 수 있다는 점도 두 사람은 닮아 있었다."

msgid "sn_dsc_0440"
msgstr "윈더미어 왕성 어딘가의 어두컴컴한 홀에서 계속 노래하는 하인츠.\\n신비한 힘을 지닌 그 노래지만, 본인에게 가해지는 부담은 상당한 듯하다."

msgid "sn_dsc_0441"
msgstr "미쿠모에게 「너에게서는 아무것도 느껴지지 않아」라는 말을 듣고 완전히 풀이 죽은 프레이아.\\n너무 크게 낙담한 나머지 룬은 새까맣게 변해버렸다."

msgid "sn_dsc_0442"
msgstr "바르 신드롬의 발생과 공중 기사단의 출현.\\n긴장이 고조되는 가운데 즉시 델타 소대가 출격한다."

msgid "sn_dsc_0443"
msgstr "밤의 라그나에 서 있는 마크로스 엘리시온.\\n희미한 불빛에 비친 거대한 몸체는 어딘가 환상적으로 보인다."

msgid "sn_dsc_0444"
msgstr "윈더미어군에 점령된 행성에 존재하는 고대 유적.\\n그곳에서는 무언가 수상한 실험이 진행되고 있는 듯한데…"

msgid "sn_dsc_0445"
msgstr "Fire Bomber의 보컬리스트, 넥키 바사라와 밀레느 지너스.\\n두 사람의 노랫소리는 무한한 에너지가 되어 희망의 빛을 비춘다."

msgid "sn_dsc_0447"
msgstr "과거 통합군에 소속되어 발키리 부대의 파일럿이었던 레이.\\n하지만 작전 중 마음에 상처를 입고 정처 없는 여행을 떠난 곳에서 어린 시절의 바사라를 만난다."

msgid "sn_dsc_0448"
msgstr "평소에는 마이크론화되어 있지만, 그래도 보통 인간을 뛰어넘는 거대한 체격을 자랑하는 비히다.\\n과거 어린 바사라의 연주를 들은 것을 계기로 음악의 길을 걷기 시작했다."

msgid "sn_dsc_0449"
msgstr "무기를 사용하지 말라는 바사라의 호소에 밀레느도 전장에서 노래하기 시작한다.\\n두 사람의 노래가 상승효과를 일으키듯, 노래 에너지는 폭발적으로 상승했다."

msgid "sn_dsc_0450"
msgstr "알카트라즈에서 열린 죄수들을 위한 위문 라이브.\\n진짜 란카 리의 등장에 모인 죄수들은 열광적인 분위기를 보였다."

msgid "sn_dsc_0451"
msgstr "특설된 대형 선박 무대에서 노래하는 셰릴.\\n이전 라이브가 중단된 탓인지, 그녀의 노랫소리에는 더욱 힘이 실려 있었다."

msgid "sn_dsc_0452"
msgstr "민메이가 부르는 러브송이 전투 영역의 모든 함선으로 중계된다.\\n그것은 전투 종족 젠트라디의 마음 깊은 곳에 잠든 문화를 되찾게 했다."

msgid "sn_dsc_0453"
msgstr "바사라와 밀레느의 노랫소리에서 감지되는 에너지가 점점 상승한다.\\n관측하던 적 병사는 그것을 위협으로 판단하고 일시 후퇴를 결정했다."

msgid "sn_dsc_0454"
msgstr "바사라의 노래 에너지가 급격히 상승하고 있다고 맥스 함장에게 보고하는 닥터 치바.\\n그 수치는 무려 1만 치바송. 참고로 평소 한계치는 3천 치바송 정도라고 한다."

msgid "sn_dsc_0455"
msgstr "사운드 포스로 전장에 출동하는 Fire Bomber.\\n부대 연계 지휘는 군 소속 경험이 있는 레이가 맡는 경우가 많다."

msgid "sn_dsc_0456"
msgstr "배틀로이드 카니발에 전시되어 있던 데스트로이드 몬스터.\\n과거 성간 대전 시대에 운용되었던 오래된 기체다."

msgid "sn_dsc_0457"
msgstr "자신도 모르는 사이 밀레느의 마음속에서 바사라의 존재는 점점 커져 간다.\\n비록 멀리 떨어진 어딘가에 있다 해도, 두 사람의 마음은 노래를 통해 이어져 있을 것이다."

msgid "sn_dsc_0459"
msgstr "통합군의 에이스 파일럿이자 정예 부대 다이아몬드 포스의 일원.\\n성실한 성격이지만, 가끔 마음 깊은 곳에 있는 뜨거운 열정을 드러내기도 한다."

msgid "sn_dsc_0460"
msgstr "Fire Bomber가 가는 곳이면 어디든 나타나는 소녀. 바사라의 열렬한 팬이다.\\n바사라에게 꽃다발을 건네고 싶은 듯하지만, 이상하게도 항상 실패하고 만다."

msgid "sn_dsc_0461"
msgstr "의식을 잃은 채 깨어나지 않는 바사라에게 밀레느가 울면서 호소한다.\\n「있잖아, 바사라 일어나! 파이어라든가, 봄버라든가… 말해줘!」―밀레느"

msgid "sn_dsc_0462"
msgstr "바주라는 가차 없이 도시를 파괴한다. 믿을 수 있는 란카조차 노래할 수 없다.\\n대피한 시민들의 마음이 절망으로 물드는 가운데, 또 한 명의 가희가 조용히 노래하기 시작한다."

msgid "sn_dsc_0463"
msgstr "바주라와의 싸움 속에서 자신이 사실 무엇을 위해 노래하고 싶었는지 고민하는 란카.\\n그런 란카의 마음을 알아챈 브레라는 다정하게 그녀를 안아주었다."

msgid "sn_dsc_0464"
msgstr "백기사와의 전투 중 갑자기 하야테의 발키리 움직임이 변했다.\\n그것은 틀림없이 프레이아의 노래 힘의 영향을 받은 것이었다."

msgid "sn_dsc_0465"
msgstr "생일 선물이라며 밀레느에게 다이아몬드 반지를 건네는 감린.\\n분명 특별한 그 선물에는 감린의 마음이 담겨 있는 듯하다."

msgid "sn_dsc_0466"
msgstr "어린 시절의 바사라는 오로지 거대한 산을 향해 계속 노래하고 있었다.\\n언젠가 이 산을 움직여 보이겠다고 진심으로 생각했던 모양이다."

msgid "sn_dsc_0467"
msgstr "가변 전투기에 장비하는 옵션 유닛.\\n노래의 힘을 사운드 에너지로 변환해 증폭하여 발사할 수 있다."

msgid "sn_dsc_0468"
msgstr "아주 오래전에 탄생한 엄청난 힘을 지닌 생명체.\\n생명을 유지하기 위해 정신 에너지 「스피리치아」를 흡수해야 한다."

msgid "sn_dsc_0469"
msgstr "프레이아의 생일에 하야테가 준비한 선물. 그것은 쏟아져 내리는 새하얀 눈이었다.\\n고향 윈더미어를 떠올리게 하는 깜짝 선물에 프레이아는 진심 어린 미소를 보였다."

msgid "sn_dsc_0470"
msgstr "나체 냥냥에서 차이나 드레스를 입고 활기차게 접객하는 프레이아.\\n하지만 동료들은 그녀가 무리해서 밝은 척하고 있다는 것을 알고 있었다."

msgid "sn_dsc_0471"
msgstr "프레이아의 생일 파티에 무려 사복 차림의 미쿠모가 나타났다.\\n미쿠모와 모두가 함께 부르는 생일 축하 노래. 프레이아의 눈에는 커다란 눈물이 맺혀 있었다."

msgid "sn_dsc_0472"
msgstr "특제 생일 케이크를 만드는 척.\\n상당히 큰 사이즈인 듯하지만, 서두르지 않으면 프레이아가 도착해 버린다!"

msgid "sn_dsc_0473"
msgstr "하늘에서 내리는 눈을 보고 신나게 뛰어다니며 기뻐하는 프레이아.\\n준비 때문에 파티에 늦어버린 하야테였지만, 그럴 만한 보람은 있었던 듯하다."

msgid "sn_dsc_0474"
msgstr "새하얀 눈 위에서 하야테와 서로 바라보며 프레이아는 조용히 노래하기 시작한다.\\n룬을 반짝반짝 빛내는 프레이아를 하야테는 아무 말 없이 바라보고 있었다."

msgid "sn_dsc_0475"
msgstr "자신의 아버지는 어떤 사람이었는지 아라드에게 묻는 하야테.\\n그리운 듯, 그리고 어딘가 기쁜 듯 아라드는 입을 열었다."

msgid "sn_dsc_0476"
msgstr "눈을 보고 크게 기뻐하는 척의 여동생들.\\n물갈퀴가 달린 두 손 가득 눈을 움켜쥐며 즐거워했다."

msgid "sn_dsc_0477"
msgstr "나체 냥냥에 도착한 프레이아를 맞이하는 일행.\\n하지만 그곳에는 하야테의 모습이 보이지 않았다."

msgid "sn_dsc_0478"
msgstr "척 특제 생일 케이크.\\n이제 남은 것은 촛불을 끄는 일뿐이다."

msgid "sn_dsc_0479"
msgstr "모두가 고른 선물이 운반되어 온다.\\n안에 무엇이 들어 있는지는 열어본 뒤의 즐거움이다."

msgid "sn_dsc_0480"
msgstr "파티 준비를 돕는 하크와 자크.\\n가게 전체를 장식하는 일은 꽤 고생이다."

msgid "sn_dsc_0481"
msgstr "쿨 뷰티 미쿠모의 매력을 돋보이게 하는 새로운 라이브 의상이 완성되었다.\\n흑과 백을 가르는 듯한 아름다운 라인. 그 모습은 달빛을 두른 여신과 같다."

msgid "sn_dsc_0483"
msgstr "작전의 일환이라고는 해도, 마침내 발키리의 라이브 영상 송출이 실현되었다.\\n홍보를 위해 나타난 마키나의 홀로그램에 길 가던 사람들은 눈을 떼지 못했다."

msgid "sn_dsc_0484"
msgstr "갑자기 눈앞에 나타난 레이나의 홀로그램을 보고 동요를 감추지 못하는 보그.\\n무심코 룬을 빛내며 얼굴을 새빨갛게 물들이고 말았다."

msgid "sn_dsc_0485"
msgstr "라이브 영상 송출 직전, 네트워크를 통해 자신들의 상황을 설명하는 카나메.\\n갑작스러운 일에 놀란 사람들은 이내 그것을 환호성으로 바꾸어 간다."

msgid "sn_dsc_0486"
msgstr "송출 영상을 통해 발키리로서의 마음을 이야기하는 레이나.\\n평소와 조금 다른 용감한 표정에서 그녀의 진심을 엿볼 수 있다."

msgid "sn_dsc_0487"
msgstr "라이브 영상과 동시에 방출된 바이러스가 은하 네트워크를 침식한다.\\n대규모 통신 장애를 일으키며, 비밀리에 진행되던 작전은 성공했다."

msgid "sn_dsc_0488"
msgstr "프레이아가 노래하는 모습을 무대 옆에서 지켜보던 하야테.\\n그때 주변에 환각 같은 빛이 나타나고, 하야테는 심한 현기증에 휩싸였다."

msgid "sn_dsc_0489"
msgstr "몰래 발키리의 라이브 영상을 즐기고 있던 윈더미어 병사들.\\n보그에게 들키자 급히 적 연구라고 거짓말했지만, 속일 수는 없었다."

msgid "sn_dsc_0490"
msgstr "발키리의 라이브 영상을 멈추려고 필사적으로 조작하는 보그.\\n하지만 아무것도 모르는 채 몇 번이나 결제 버튼을 눌러버리고 말았다."

msgid "sn_dsc_0491"
msgstr "라이브 연출로 나타난 거대한 하트.\\n주변의 꽃밭과 어우러져 큐트한 마키나의 이미지에 딱 맞는 광경이다."

msgid "sn_dsc_0492"
msgstr "특별 서비스 영상을 보고 단말기의 결제 버튼을 연타하는 사람들.\\n상술에 능한 아라드 대장에게 넘어가고 있다는 사실을 아무도 모른다."

msgid "sn_dsc_0493"
msgstr "수영복으로 갈아입고 놀던 프레이아. 문득 하야테의 모습을 보고 히히 웃음을 지었다.\\n즐거운 듯 무언가를 꾸미는 그녀는 과연 어떤 장난을 생각해낸 것일까."

msgid "sn_dsc_0495"
msgstr "필사적으로 애쓰지만 우미네코를 잡지 못해 분해하는 하야테.\\n「저 우미네코 자식…」―하야테"

msgid "sn_dsc_0496"
msgstr "손님들의 반응이 그다지 좋지 않았다고 생각했지만, 사실은 호평을 받고 있었던 Fire Bomber의 라이브.\\n추가 무대가 결정되면서 일행은 다시 연주를 시작했다."

msgid "sn_dsc_0497"
msgstr "장난꾸러기 괭이갈매기를 잡기 위해 하야테는 바다로 뛰어들었다.\\n하지만 역시 하야테도 물속에서는 실컷 농락당할 뿐이었다."

msgid "sn_dsc_0498"
msgstr "훈련을 빼먹은 하야테와, 함께 괭이갈매기를 쫓아다니던 척.\\n분노한 미라쥬의 추궁을 받자 알 수 없는 말을 남기고 바다로 도망쳐 버렸다."

msgid "sn_dsc_0499"
msgstr "노을빛으로 물든 해변에서 대화를 즐기는 오즈마와 캐시.\\n한때 연인이었던 두 사람이지만, 지금도 사이는 좋은 듯하다."

msgid "sn_dsc_0500"
msgstr "라이브를 위해 리조트 함선을 찾은 Fire Bomber 멤버들.\\n들뜬 것도 잠시, 마중 나온 감시역의 모습을 보고 밀레느는 한숨을 내쉰다."

msgid "sn_dsc_0501"
msgstr "행성 라그나 역시 지구 인류가 이주한 행성 중 하나다.\\n라그나에는 원주민인 라그나인이 살고 있었지만, 지금까지 좋은 관계를 유지하고 있다."

msgid "sn_dsc_0502"
msgstr "비치발리볼을 즐기는 여성들과 떨어져 혼자 물가를 걷는 보비.\\n걸음걸이만큼은 누구보다 소녀답다."

msgid "sn_dsc_0503"
msgstr "놀라울 정도로 맑고 투명한 마얀섬의 바다.\\n얕은 곳이라면 해저의 모습까지 훤히 들여다볼 수 있다."

msgid "sn_dsc_0504"
msgstr "감린과의 대화에 어느새 열을 올리고 만 밀레느.\\n어느새 시간은 지나갔고, 주문한 주스도 거의 다 마셔버렸다."

msgid "sn_dsc_0505"
msgstr "성숙한 디자인의 기모노를 훌륭하게 소화해낸 카나메.\\n발키리의 리더답게 당당한 어른의 매력을 보여준다."

msgid "sn_dsc_0507"
msgstr "새해에도 변함없이 신비로운 표정을 짓는 미쿠모.\\n아무리 오랜 시간을 함께했다 해도 그녀가 무엇을 빌었을지는 예상하기 어려울 것이다."

msgid "sn_dsc_0508"
msgstr "기모노를 입고 구바바와 함께 즐거운 시간을 보내는 밀레느.\\n아직 어린아이 같은 면은 남아 있지만, 그 밝은 모습은 봄날의 따스함을 떠올리게 한다."

msgid "sn_dsc_0509"
msgstr "S.M.S의 귀환을 보고 클란은 미소를 지었다.\\n함선에 남아 있던 그녀도 언젠가는 이렇게 될 것을 예상하고 있었던 모양이다."

msgid "sn_dsc_0510"
msgstr "프론티어 선단으로 돌아온 오즈마는 과거 자신의 부하들에게 외쳤다.\\n「대장이라고 불러라, 스컬 3!」―오즈마"

msgid "sn_dsc_0511"
msgstr "란카와 셰릴에게 경례하는 VF-25F.\\n그녀들의 배웅을 받으며 마지막 전투를 향해 날아오른다."

msgid "sn_dsc_0512"
msgstr "전장으로 향하는 알토를 배웅하는 란카와 셰릴.\\n전사의 등을 밀어주듯, 날개에 바람을 불어넣듯, 두 사람은 함께 계속 노래한다."

msgid "sn_dsc_0513"
msgstr "서로의 등을 지켜주며 싸우는 브레라와 알토.\\n한때 적으로 싸웠던 두 사람의 손으로 결전의 막이 내려지려 하고 있었다."

msgid "sn_dsc_0514"
msgstr "마침내 바즈라 퀸의 눈앞에 다가온 알토는 저격소총으로 조준한다.\\n오랜 싸움, 다양한 인연 그리고 음모. 이제 그 모든 것이 막을 내린다."

msgid "sn_dsc_0515"
msgstr "배틀 갤럭시를 격파하기 위해 총공격을 펼치는 S.M.S.\\n카나리아가 탑승한 쾨니히 몬스터가 목숨을 건 일격을 날렸다."

msgid "sn_dsc_0516"
msgstr "드디어 바즈라 퀸과 융합을 이룬 그레이스.그 막강한 힘으로\\n은하계를 지배하기 위해 우선 눈앞의 인간들을 걷어차 버리려 한다."

msgid "sn_dsc_0517"
msgstr "두 가희의 노랫소리에 담긴 폴드파의 힘. 그리고 YF-29 시스템에 의한 힘의 증폭.\\n바주라에게 마음을 전하려는 모두의 마음이 금빛 빛이 되어 이 하늘을 밝혔다."

msgid "sn_dsc_0518"
msgstr "모든 성능 면에서 VF-25를 뛰어넘는 시작기. 바주라전을 상정해 설계되었다.\\n폴드 쿼츠를 이용한 「폴드 웨이브 시스템」을 탑재하고 있다."

msgid "sn_dsc_0519"
msgstr "유명한 가부키 가문의 후계자임에도 불구하고 파일럿의 길을 선택한 알토.\\n어린 시절 어머니로부터 받은 영향도 있어 하늘에 대한 동경을 버리지 못하고 있었다."

msgid "sn_dsc_0520"
msgstr "오즈마 리와 브레라 스턴. 때로는 함께 싸우고, 때로는 적으로 맞선 두 남자.\\n입장은 크게 다르지만, 한 명의 여동생을 지켜보는 오빠라는 점은 변함없다."

msgid "sn_dsc_0521"
msgstr "누군가가 바주라를 지배하고 이 은하를 손에 넣으려 하고 있었다.\\n그것을 막을 수 있는 것은 두 사람의 노래뿐. 그리고 그 노래를 전할 수 있는 것은…"

msgid "sn_dsc_0523"
msgstr "목숨이 위험한 상황에서도 계속 노래하는 셰릴을 보고 알토의 마음속 망설임은 사라진다.\\n사오토메 알토가 다시 한번 춤출 장소, 그것은 다름 아닌 이 드넓은 하늘이었다."

msgid "sn_dsc_0529"
msgstr "눈 내리는 밤하늘에 더욱 돋보이는 붉은 의상. 귀 기울이면 어딘가에서 방울 소리가 들려온다.\\n얼어붙을 듯한 추위도 날려버리고, 오늘 밤만의 귀여운 산타가 내려왔다!"

msgid "sn_dsc_0531"
msgstr "모두에게 선물을 나눠주는 것이 산타의 일.\\n산타 의상을 입은 마키나는 겨울 추위에도 지지 않고 미소를 보여준다."

msgid "sn_dsc_0532"
msgstr "살짝 붉어진 볼이 눈 위에 선 그녀의 매력을 더욱 돋보이게 한다.\\n성스러운 밤, 선물을 모두 전달하기 전까지 마키마키 산타의 일은 끝나지 않는다."

msgid "sn_dsc_0533"
msgstr "프레이아의 생일 선물을 고르는 하야테와 미라쥬.\\n그리고 어째서인지 그것을 미행하는 레이나 일행. 두 사람의 모습을 보고 무척 기뻐하는 듯하다."

msgid "sn_dsc_0534"
msgstr "갑자기 연애 이야기가 나오자 당황하는 미라쥬.\\n하지만 둔감한 하야테는 그것을 눈치채지 못한 듯하다."

msgid "sn_dsc_0535"
msgstr "프레이아의 생일 파티에 참석한 미쿠모.\\n자신은 생일을 축하받았던 기억이 없다… 그래서 관심이 있었다고 한다."

msgid "sn_dsc_0536"
msgstr "기뻐하는 프레이아와 만족스러운 표정의 하야테. 사이좋은 두 사람을 보고 미라쥬는 미소 짓는다.\\n하지만 문득 그녀의 뺨을 타고 흐른 한 줄기 눈물은, 기쁨과는 다른 감정이 있음을 보여주고 있었다."

msgid "sn_dsc_0537"
msgstr "서프라이즈 파티가 있다는 것도 모른 채 깊이 잠든 프레이아.\\n어떤 꿈을 꾸고 있는 걸까, 잠든 얼굴에는 미소가 떠올라 있었다."

msgid "sn_dsc_0538"
msgstr "독립 전쟁이 끝난 뒤 힘든 시기를 보냈다는 프레이아.\\n그때 괴로움과 외로움을 날려준 것은 지구의 음악이었다."

msgid "sn_dsc_0539"
msgstr "갑자기 울린 폭죽 소리에 놀라는 프레이아.\\n정성껏 준비한 서프라이즈 파티의 막이 오른다."

msgid "sn_dsc_0540"
msgstr "선물로 무엇을 사야 할지 모르겠다는 하야테.\\n미라쥬를 불러 함께 가게를 돌아볼 모양이다."

msgid "sn_dsc_0541"
msgstr "호텔 한 방을 빌려 성대하게 열린 밀레느의 생일 파티.\\n커다란 리본이 특징인 드레스에 평소와 같은 밝은 미소가 잘 어울렸다."

msgid "sn_dsc_0543"
msgstr "출격 전날 밤. 기타를 품에 안고 빛나는 야경을 바라보며 노래를 시작하는 바사라.\\n다시는 만나지 못할지도 모르지만, 렉스는 마음을 전하지 못한 채 밤거리로 사라진다."

msgid "sn_dsc_0544"
msgstr "Fire Bomber를 계속 지켜봐 온 아키코는 그들이 싸움에 나가는 것을 안타까워했다.\\n그런 아키코에게 레이는 반드시 무사히 돌아오겠다고 약속한다."

msgid "sn_dsc_0545"
msgstr "동료들에게 축하한다는 말을 계속 듣는 밀레느.\\n처음에는 웃으며 답하던 밀레느였지만, 이내 눈에서 눈물이 흐르기 시작했다."

msgid "sn_dsc_0546"
msgstr "아무도 없는 행사장에서 감린은 밀레느에게 반지를 건넸다.\\n「만약 제가 살아 돌아온다면, 이것을 왼손 약지에 끼워 주세요」―감린"

msgid "sn_dsc_0547"
msgstr "전장으로 떠나는 동료들을 생각하다 울음을 터뜨리는 밀레느.\\n그때 조용히 나타난 바사라는 자신만의 방식으로 엄하면서도 다정한 말을 건넸다."

msgid "sn_dsc_0548"
msgstr "자신만 출격 멤버에서 제외되었다는 사실에 낙담하는 밀레느.\\n그렇다면 모두가 돌아올 때까지 특별한 라이브를 열자고 아키코가 제안한다."

msgid "sn_dsc_0549"
msgstr "프로토데빌룬이 숨어 있는 행성에 대한 기습 작전.\\n지원자만으로 구성된 소수 정예 부대가 실행한다."

msgid "sn_dsc_0550"
msgstr "출격하는 멤버들이 맥스에게 향했기 때문에 혼자 연습하는 밀레느.\\n하지만 외로움 때문인지 중간에 노래를 멈추고 말았다."

msgid "sn_dsc_0551"
msgstr "손수 만든 초대장을 준비하고 있었다는 밀레느.\\n그 초대장은 곧 열릴 밀레느의 생일 파티를 위한 것이었다."

msgid "sn_dsc_0552"
msgstr "생일 파티의 마지막을 장식하는 것은 Fire Bomber의 특별 라이브였다.\\n하지만 어딘가 기운 없는 밀레느는 평소 실력을 발휘하지 못하는 듯하다."

msgid "sn_dsc_0553"
msgstr "밀레느가 손에 든 사진에는 아직 젊었던 맥스와 미리아의 모습이 찍혀 있었다.\\n지금처럼 매일 다투는 모습과는 달리, 풋풋함이 남아 있는 모습이 눈부시게 보인다."

msgid "sn_dsc_0554"
msgstr "한때 젠트라디군의 에이스였던 미리아.\\n맥스와 결혼한 뒤에는 지구 인류의 편에 서서 그 실력을 발휘하고 있다."

msgid "sn_dsc_0555"
msgstr "자신을 두고 출격하는 동료들을 도저히 참지 못하고 뒤쫓아가는 밀레느.\\n혼자 기다리고만 있을 수 없다고 주장하는 그녀의 모습에서 미리아는 성장을 느꼈다."

msgid "sn_dsc_0556"
msgstr "사운드 포스 창설 당시 밀레느는 멤버에서 제외될 예정이었다.\\n하지만 최종적으로 레이의 판단으로 멤버 합류를 이루게 되었다."

msgid "sn_dsc_0559"
msgstr "프로토데빌룬과의 결전을 앞두고 새로운 발키리에 탑승해 출격한 미리아.\\n오랫동안 실전에서 떠나 있었음에도 그 실력은 아직 녹슬지 않았다."

msgid "sn_dsc_0560"
msgstr "강대한 적을 앞에 두고도 강한 의지로 계속 노래하는 밀레느.\\n제멋대로이고 어린아이 같은 성격이었던 그녀도 싸움 속에서 확실한 성장을 이루고 있었다."

msgid "sn_dsc_0565"
msgstr "수많은 초콜릿과 소녀의 마음을 자극하는 특별한 코스튬.\\n달콤함으로 가득한 세계의 중심에서 마키나가 당신을 사랑으로 이끈다."

msgid "sn_dsc_0566"
msgstr "밸런타인데이 당일, 직접 만든 초콜릿을 건네주는 셰릴.\\n주방과 셰릴의 손가락 모습에서 전해지는 노력에 저절로 가슴이 뜨거워진다."

msgid "sn_dsc_0567"
msgstr "때로는 전장에서 벗어나 평온하게 쿠키를 굽는 것도 나쁘지 않다.\\n소중한 사람을 향한 마음이 담긴 과자라면 분명 기쁘게 받아줄 것이다."

msgid "sn_dsc_0568"
msgstr "밸런타인데이에 실제로 초콜릿을 건네는 일은 긴장되는 법이다.\\n이 순간만큼은 란카도 아이돌이 아닌 한 명의 소녀로 돌아온다."

msgid "sn_dsc_0569"
msgstr "귀여운 연출이 매력적인 마키나의 솔로 스테이지.\\n남성 팬은 물론이고 여성 팬의 모습도 많이 보인다."

msgid "sn_dsc_0570"
msgstr "최근 좋은 의미로 노래에 변화가 있다고 미쿠모에게 지적받은 프레이아.\\n하야테 때문이냐는 질문을 받고 조금 부끄러운 듯 화제를 돌렸다."

msgid "sn_dsc_0571"
msgstr "다시 입안된 행성 볼도르 잠입 작전.\\n윈더미어의 감시망을 빠져나가기 위해 어떤 비책을 실행하겠다고 아라드는 말했다."

msgid "sn_dsc_0572"
msgstr "은하 네트워크에 송출된 발키리의 라이브 영상.\\n「지금 바로 단말기로 클릭해줘」라며 마키나가 조금 자극적인 동작으로 말했다."

msgid "sn_dsc_0573"
msgstr "자신의 방에서 발키리의 라이브 영상을 보고 있는 로이드.\\n그녀들이 가진 힘에 관심이 있는 것일까."

msgid "sn_dsc_0574"
msgstr "은하 네트워크에 라이브 영상과 함께 바이러스를 퍼뜨리는 작전이 성공했다.\\n어니스트 함장은 작전의 계속 진행을 지시한다."

msgid "sn_dsc_0575"
msgstr "로이드의 방에 있는 수많은 안경.\\n색도 형태도 다양하다는 점에서 그의 취향을 엿볼 수 있다."

msgid "sn_dsc_0576"
msgstr "무기 상인을 통해 전력을 확충해 나가는 윈더미어군.\\n이제는 변방의 군대라고 얕볼 수 없는 수준의 전력을 갖추었다."

msgid "sn_dsc_0577"
msgstr "차분한 분위기로 어른스러운 밸런타인데이를 표현한 카나메.\\n사랑도 초콜릿도 약간의 쓴맛이 있어야 단맛이 더욱 살아나는 법이다."

msgid "sn_dsc_0579"
msgstr "포장된 초콜릿을 건네주는 밀레느.\\n자세히 보면 구바바의 얼굴이 디자인된 정성이 담긴 물건이다."

msgid "sn_dsc_0580"
msgstr "숨어 있다가 초콜릿을 건네려는 프레이아.\\n우연인 척하기 위해 필사적이지만, 룬의 빛 때문에 들키고 만다."

msgid "sn_dsc_0581"
msgstr "얇은 옷 한 장만 걸친 자극적인 모습으로 팬들을 매료시키는 마키나.\\n이런 영상을 보여주면 결제 버튼을 연타하게 되는 것도 이해가 된다."

msgid "sn_dsc_0582"
msgstr "대담한 수영복 모습으로 팬들을 매료시키는 마키나.\\n자신의 매력을 제대로 알고 있다는 점은 역시 대단하다고 할 수 있다."

msgid "sn_dsc_0583"
msgstr "라이브 도중 무대 뒤에서 휴식하는 프레이아.\\n갑자기 뺨에 닿은 간식에 놀라 꾸밈없는 반응을 보여버린다."

msgid "sn_dsc_0584"
msgstr "하야테의 아버지에 대해 아라드는 진실을 말하려 한다.\\n지금까지 이야기하지 않았던 것은 그 내용이 군사 기밀로 분류되어 있었기 때문이라고 한다."

msgid "sn_dsc_0585"
msgstr "두 번째 볼도르 잠입 작전에서 협력자가 되어준 신통합군 병사.\\n한때 발키리의 노랫소리에 구원받았던 은혜를 잊지 않고 있다."

msgid "sn_dsc_0586"
msgstr "아버지에 대한 이야기를 듣고 격납고에 서 있는 하야테.\\n지금까지 알지 못했던 사실에 그는 무엇을 생각하고 있을까."

msgid "sn_dsc_0587"
msgstr "하야테의 친아버지.\\n윈더미어 독립 전쟁 당시, 그가 차원 병기를 무단으로 사용했다고 알려져 있다."

msgid "sn_dsc_0588"
msgstr "하인츠의 노랫소리를 들으려 수많은 사람들이 모여 있다.\\n하지만 노래하는 것으로 인한 부담은 확실히 그의 몸을 갉아먹고 있었다."

msgid "sn_dsc_0589"
msgstr "몸의 라인을 대담하게 드러내는 코스튬과 도발적인 포즈.\\n그 신비로운 눈동자에 사로잡혀 셰릴의 매력에서 벗어날 수 있는 사람은 없다."

msgid "sn_dsc_0590"
msgstr "란카에게 어떻게 아이모를 부를 수 있는지 추궁하는 셰릴.\\n주변에 긴장감이 감도는 순간, 셰릴의 가슴에서 튀어나온 것은…"

msgid "sn_dsc_0591"
msgstr "서부극의 건맨을 모티브로 한 모습으로 화려한 퍼포먼스를 선보이는 셰릴.\\n마치 마음을 꿰뚫린 듯 팬들은 한순간도 눈을 뗄 수 없다."

msgid "sn_dsc_0592"
msgstr "사오토메 알토, 셰릴 놈, 란카 리.\\n전쟁과 사랑 사이에서 흔들리는 뒤틀린 삼각관계, 그 운명의 행방은 누구도 알 수 없다."

msgid "sn_dsc_0593"
msgstr "알토의 품에서 훔친 부적을 가슴골에 숨기고 놀리는 셰릴.\\n「찾을 수 있으면 찾아봐」라는 듯 여유로운 미소를 짓고 있다."

msgid "sn_dsc_0594"
msgstr "뜻밖의 사고로 절벽에서 떨어져 정신을 잃은 셰릴.\\n눈을 뜨자마자 흐트러진 옷차림 때문에 알토에게 습격당했다고 착각하고 날카로운 일격을 날린다."

msgid "sn_dsc_0595"
msgstr "오즈마와 다투고 집을 뛰쳐나온 란카.\\n갈 곳이 정해진 것도 아니었지만 젠트라몰로 향했다."

msgid "sn_dsc_0596"
msgstr "가수가 되고 싶다는 란카의 말을 단호히 인정하지 않는 오즈마.\\n「너처럼 소심한 애가 가수 같은 걸 할 수 있을 리 없잖아!」―오즈마"

msgid "sn_dsc_0597"
msgstr "S.M.S 대원으로 정식 배속된 알토.\\n시작부터 최루가스를 이용한 혹독한 환영식을 받게 되었다."

msgid "sn_dsc_0598"
msgstr "바주라의 습격으로 큰 피해를 입은 프론티어 선단.\\n처참하게 파괴된 거리를 보며 그레이스는 혼자 미소를 짓는다."

msgid "sn_dsc_0599"
msgstr "프론티어 선단 내부에 존재하는 호수.\\n초원과 숲으로 둘러싸인 조용한 장소로, 찾아오는 사람도 적다."

msgid "sn_dsc_0600"
msgstr "프론티어 선단에서는 비밀리에 회수한 바주라에 대한 조사가 진행되고 있었다.\\n그 결과 바주라는 일종의 생물 병기라는 가설이 떠올랐다."

msgid "sn_dsc_0601"
msgstr "어딘가 중성적인 매력이 넘치는 스타일로 라이브 무대에 서는 레이나.\\n결성 초기에는 적극적이지 않았던 그녀도 이제는 많은 팬들을 매료시키고 있다."

msgid "sn_dsc_0603"
msgstr "마침내 결성된 전술 음악 유닛, 그 이름은 「발키리」.\\n활기 넘치는 멤버들을 바라보며 레이나는 무관심한 시선을 보낸다."

msgid "sn_dsc_0604"
msgstr "시설 안에 있는 미쿠모를 찾기 위해 전력으로 달려가는 카나메.\\n그녀의 노랫소리로 반응을 찾으려 하지만, 과연…"

msgid "sn_dsc_0605"
msgstr "길고 힘든 훈련 끝에 마침내 발키리의 노랫소리가 바르에게 효과를 보였다.\\n전술 음악 유닛이라는 이름에 걸맞은 활약이 이제 막 시작되려 하고 있었다."

msgid "sn_dsc_0606"
msgstr "전투복으로는 기분이 나지 않는다며 특제 의상을 준비한 마키나.\\n양손의 손가락을 맞댄 필살 포즈까지 생각하며 의욕이 넘친다."

msgid "sn_dsc_0607"
msgstr "행성 알브헤임에서 바르를 진압한 발키리.\\n그곳에서 목숨을 구원받은 병사 중에는 메서라는 이름의 청년이 있었다."

msgid "sn_dsc_0608"
msgstr "어느 날, 발키리에 신입 멤버가 들어오게 되었다.\\n오디션도 받지 않고 나타난 그 신입의 노랫소리는 들은 이들에게 깊은 감동을 주었다."

msgid "sn_dsc_0609"
msgstr "발키리의 힘을 최대한 끌어내기 위해 아라드는 공동 작전을 제안한다.\\n전장에서의 호위 역할과 라이브를 고조시키는 퍼포머 역할을 겸임하는 것이라고 한다."

msgid "sn_dsc_0610"
msgstr "근접 전투용 나이프로 적을 공격하는 아라드.\\n적을 행동 불능으로 만드는 것만이라면 이것만으로도 충분한 위력이 있다."

msgid "sn_dsc_0611"
msgstr "폴드 리셉터를 가진 멤버들로 구성된 특수 팀.\\n그 중심 역할을 맡기 위해 한 명의 여성이 찾아왔다."

msgid "sn_dsc_0612"
msgstr "윈더미어에 전해 내려오는 별의 가희에 대한 전승.\\n하인츠가 부르는 바람의 노래와는 또 다른 것이라고 한다."

msgid "sn_dsc_0613"
msgstr "발키리의 절대적인 에이스, 미쿠모 기뉴메르.\\n항상 최전선에 서는 그녀는 모든 것을 배신하고, 그리고 멈출 줄 모른다."

msgid "sn_dsc_0615"
msgstr "발키리 결성 직후, 뜻대로 되지 않아 전장에서 고전하는 카나메.\\n그런 때 그녀는 아라드와 만났다. 아직 델타 소대가 결성되기 전의 이야기다."

msgid "sn_dsc_0616"
msgstr "발키리에 가입했지만 좀처럼 진가를 발휘하지 못하는 프레이아.\\n그런 프레이아의 본질을 미쿠모는 어딘가 꿰뚫어 보고 있는 듯하다."

msgid "sn_dsc_0617"
msgstr "반격 작전 개시 직전, 하야테와 미쿠모는 둘만의 이야기를 나누고 있었다.\\n망설임과 속박을 떨쳐낸 두 사람의 표정은 온화했고, 조금은 마음을 연 듯한 모습이었다."

msgid "sn_dsc_0618"
msgstr "카오스의 반격 작전이 시작되고, 행성 랜도르에 대한 공격이 개시된다.\\n달려온 지원군 중에는 볼도르의 병사들의 모습도 있었다."

msgid "sn_dsc_0619"
msgstr "행성 알브헤임에 대한 기습이 성공하고, 발키리의 라이브가 시작된다.\\n한때 메서와 만났던 이 별. 운명은 그녀를 다시 이 별로 이끌었다."

msgid "sn_dsc_0620"
msgstr "프레이아의 노래를 듣고 또다시 폭주하고 만 하야테.\\n하필 아군에게 총구를 겨눈 하야테에게 미라쥬는 필사적으로 계속 말을 걸었다."

msgid "sn_dsc_0621"
msgstr "발키리로 돌아온 미쿠모. 하지만 그 모습은 어딘가 부자연스럽다.\\n카나메, 마키나, 레이나 앞에서 미쿠모는 자신의 탄생에 대해 이야기하기 시작했다."

msgid "sn_dsc_0622"
msgstr "처음으로 미쿠모의 노랫소리를 들은 카나메는 자신의 능력으로는 따라갈 수 없음을 깨달았다.\\n하지만 긍정적인 마음으로 그녀는 발키리의 성장을 굳게 다짐했다."

msgid "sn_dsc_0623"
msgstr "윈더미어에서의 격렬한 전투 중 함선 밖으로 튕겨 나가고 만 카나메.\\n하지만 아슬아슬한 순간, 아라드에 의해 구조된다."

msgid "sn_dsc_0624"
msgstr "행성 랜도르의 우주 영역으로 출격한 마크로스 엘리시온.\\n그 압도적인 화력으로 적의 모습을 쓸어버려 간다."

msgid "sn_dsc_0625"
msgstr "발키리에 합류한 지 시간이 흐르고, 더욱 성장해 나가는 프레이아.\\n그녀의 트레이드마크로 자리 잡은 사과가 오늘도 무대를 장식하고 있다."

msgid "sn_dsc_0626"
msgstr "노래는 곧 자신 그 자체. 자신을 필요로 하는 사람들을 위해 생명의 노래를 부르는 프레이아.\\n빛나는 룬이 다하는 그날까지, 그녀는 계속 노래할 것이다."

msgid "sn_dsc_0627"
msgstr "화려한 활약의 뒤편에서 발키리는 혹독한 레슨을 계속 견뎌왔다.\\n그 엄격함 때문인지 지금까지 몇 차례 멤버 교체도 이루어졌다."

msgid "sn_dsc_0628"
msgstr "레슨에서 좀처럼 성과를 내지 못하던 프레이아였지만, 하야테의 비행을 보고 각성한다.\\n감정이 고조되고 룬이 빛나면, 그녀의 입에서는 자연스럽게 노래가 흘러나온다."

msgid "sn_dsc_0629"
msgstr "자신이 노래하면 또다시 하야테의 폭주를 불러오는 것은 아닐까 두려워하는 프레이아.\\n하지만 그 자리에 있던 모두가 그녀의 노래를 기다리고 있었다."

msgid "sn_dsc_0630"
msgstr "제정신을 되찾은 하야테는 즉시 미라쥬와 연계해 전투에 복귀한다.\\n수많은 시련을 극복하며 두 사람의 호흡은 더욱 완벽해져 간다."

msgid "sn_dsc_0631"
msgstr "발키리의 앞을 가로막는 공중기사단.\\n그때, 멋지게 나타난 척의 일격이 돌파구를 열었다!"

msgid "sn_dsc_0632"
msgstr "전투 중 다시 발병한 바르 폭주에 시달리는 하야테.\\n하지만 그 순간, 미라쥬의 외침과 프레이아의 노랫소리가 그의 마음을 해방시켰다."

msgid "sn_dsc_0633"
msgstr "룬의 빛이 다하는 순간, 윈더미어인의 생명의 불꽃도 함께 꺼진다.\\n카심은 마지막 순간까지 사과밭과 아들의 모습을 떠올리고 있었다."

msgid "sn_dsc_0634"
msgstr "하야테와의 치열한 전투 도중 갑자기 조종을 잃은 카심의 발키리.\\n그대로 지상의 설원에 불시착한다."

msgid "sn_dsc_0635"
msgstr "윈더미어로 폴드하려는 발키리 일행.\\n곧바로 공중기사단도 추격을 개시한다."

msgid "sn_dsc_0636"
msgstr "어린 시절, 단 한 번 아버지와 함께 갔던 익룡 타기의 기억.\\n그때 키스는 「진정한 바람」이 무엇인지 배웠다."

msgid "sn_dsc_0637"
msgstr "공중기사단의 에이스에게는 대대로 「다르벤트의 백기사」라는 칭호가 주어진다.\\n현대의 백기사인 키스는 뛰어난 조종 기술과 자부심을 중시하는 훌륭한 파일럿이다."

msgid "sn_dsc_0638"
msgstr "윈더미어 왕국 공중기사단의 에이스 파일럿. 통칭 『백기사』.\\n그 압도적인 실력은 델타 소대의 멤버들조차 농락할 정도다."

msgid "sn_dsc_0639"
msgstr "공중기사단의 신입은 거친 환영을 받는 전통이 있는 모양이다.\\n하지만 키스는 이때부터 연장자에게도 맞설 수 있는 강인함을 지니고 있었다."

msgid "sn_dsc_0640"
msgstr "바람의 가희인 하인츠의 노랫소리는 윈더미어의 작전 일부로 이용된다.\\n특별한 능력을 지닌 대가로 치러야 할 숙명은 확실히 하인츠의 몸을 좀먹고 있었다."

msgid "sn_dsc_0641"
msgstr "로이드의 진짜 목적, 그것은 별의 가희의 힘으로 전 인류의 의식을 하나로 만드는 것이다.\\n그렇게 하면 은하에 영원한 평화가 찾아온다고 한다."

msgid "sn_dsc_0644"
msgstr "친구인 로이드를 막기 위해 키스는 애검을 뽑아 들었다.\\n「바람은 내가 멈춘다!」라고 외친 키스의 검이 빛난다."

msgid "sn_dsc_0649"
msgstr "마치 마법으로 가득한 세계처럼 다채로운 변화를 보여주는 라이브 무대.\\n란카의 노랫소리는 듣는 이의 마음을 열고, 그 깊은 곳에서 상상력을 끌어낸다."

msgid "sn_dsc_0651"
msgstr "무대 위를 가득 채우며 날아다니는 귀여운 요정.\\n자세히 보면 그것은 크고 작은 란카의 분신들이었다."

msgid "sn_dsc_0652"
msgstr "관객석에 있던 셰릴 앞에 요정 하나가 살며시 나타난다.\\n요정은 환하게 웃어 보인 뒤, 손에 들고 있던 곰 인형을 선물했다."

msgid "sn_dsc_0653"
msgstr "둥지 내부에서 나타난 수많은 바주라를 보고 놀라움을 감추지 못하는 알토.\\n그 수는 말 그대로 우주 영역을 가득 채울 기세였다."

msgid "sn_dsc_0654"
msgstr "쏠 수 없다면 떠나라고 말하는 브레라에게 알토는 자신을 다잡듯 외쳤다.\\n하지만 알토의 마음속에서 망설임이 완전히 사라진 것은 아니었다."

msgid "sn_dsc_0655"
msgstr "란카가 노래하고 춤출 때마다 그곳에서 무언가가 나타난다.\\n경쾌한 스텝도 기분 좋은 손뼉 소리도, 이곳에서는 모두 마법으로 변한다."

msgid "sn_dsc_0656"
msgstr "풀이 죽은 모습의 란카와 그 앞에 나타난 또 다른 란카.\\n두 명의 란카가 모이면, 그것은 꿈과 마법의 라이브가 시작된다는 신호다."

msgid "sn_dsc_0657"
msgstr "바주라는 항상 진화하는 생물이다.\\n그렇게 나타난 신형 바주라는 대부분 이전 종을 뛰어넘는 전투 능력을 지니고 있다."

msgid "sn_dsc_0658"
msgstr "바주라의 둥지가 된 요새를 향해 마크로스 캐논이 발사된다.\\n하지만 이 일격도 외벽에 작은 구멍을 내는 것에 그쳤다."

msgid "sn_dsc_0659"
msgstr "반응탄을 탑재한 공격 부대가 작전 개시를 기다리고 있다.\\n말 그대로 폭풍 전의 고요한 모습이다."

msgid "sn_dsc_0660"
msgstr "일제히 발사된 반응탄이 바주라의 둥지를 향해 날아간다.\\n강렬한 선제공격과 함께 전투의 막이 오르려 하고 있었다."

msgid "sn_dsc_0661"
msgstr "레이나의 발언을 듣고 귀까지 빨개지는 미라쥬.\\n해파리 축제는 연인들의 축제. 그녀에게는 아직 자극이 너무 강했던 모양이다."

msgid "sn_dsc_0662"
msgstr "몸과 마음 모두 바르에 침식당하면서도 메서는 자신의 역할을 다하기로 선택했다.\\n한때 자신을 구해준 노랫소리를 등에 업고, 사신은 숙적이 기다리는 하늘로 날아오른다."

msgid "sn_dsc_0663"
msgstr "마크로스 7 선단을 습격한 수수께끼의 적에게 다시 한번 노래를 들려주려는 바사라.\\n설령 적의를 가진 상대라 해도 그의 열정은 결코 식지 않는다."

msgid "sn_dsc_0664"
msgstr "갑자기 전장으로 뛰쳐나간 바사라에게 그 이유를 따져 묻는 밀레느.\\n레이나 비히다와 비교하면 아직 밀레느는 바사라의 성격을 이해하지 못하는 듯하다."

msgid "sn_dsc_0665"
msgstr "새해를 맞이하기에 어울리는 의상을 입은 하야테, 프레이아, 미라쥬.\\n머나먼 지구의 문화를 느끼며 발걸음을 맞춰 걷기 시작한다."

msgid "sn_dsc_0666"
msgstr "헤르만의 제자였던 보그는 아직도 그를 「마스터」라고 부른다.\\n그런 보그를 타이르는 헤르만의 모습은 공중기사단에서는 익숙한 광경이다."

msgid "sn_dsc_0667"
msgstr "델타 소대의 주 임무는 호위이므로 전투 훈련은 필요 없다고 말하는 하야테.\\n하지만 전장에서는 무슨 일이 일어날지 모른다는 것도 사실이다."

msgid "sn_dsc_0668"
msgstr "바사라가 혼자 나가는 이유를 알아버렸다. 복잡한 마음을 품은 밀레느는\\n어머니 미리아에게 전화를 걸지만, 전화를 받은 것은 미리아가 아니었다."

msgid "sn_dsc_0669"
msgstr "히카리와 미사에게 작별을 고하고 그 자리를 떠나려는 민메이.\\n황폐해진 거리와 그녀의 마음을 감싸 숨기듯 하늘에서 눈이 내리기 시작했다."

msgid "sn_dsc_0670"
msgstr "오랜만의 휴일에 란제리 숍을 찾은 오퍼레이터들.\\n그곳에서 본 것은 바닥에 엎드려 있는 히카리의 모습이었다."

msgid "sn_dsc_0671"
msgstr "프레이아의 생일 선물을 준비하느라 크게 늦어버린 하야테.\\n하지만 크게 기뻐하는 프레이아의 모습을 보면 그럴 만한 가치가 있었다고 할 수 있을 것이다."

msgid "sn_dsc_0672"
msgstr "의료선에 잠입하기 위해 간호사 코스튬을 입은 마키나.\\n변장은 완벽하다. 이런 간호사가 있다면 퇴원하고 싶지 않을지도 모른다."

msgid "sn_dsc_0673"
msgstr "프론티어 선단에서 열리는 셰릴의 라이브를 란카는 누구보다 기뻐했다.\\n노래를 정말 좋아하는 란카에게 셰릴은 그야말로 동경의 대상이었다."

msgid "sn_dsc_0674"
msgstr "라이브 중 벌어진 사고로 무대에서 떨어진 셰릴.\\n아슬아슬한 순간 알토에게 구조되었지만, 그녀는 라이브를 중단하려 하지 않았다."

msgid "sn_dsc_0675"
msgstr "바주라의 맹공으로부터 지키기 위해 무려 발키리의 손으로 란카를 붙잡은 알토.\\n콕핏에 태울 여유조차 없는 상황에서 필사적인 도주극이 시작되었다."

msgid "sn_dsc_0676"
msgstr "미쿠모의 질책과 격려를 받고 다시 노래하기 시작한 프레이아.\\n그 모습을 지켜보며 미쿠모 역시 자신의 노랫소리를 겹쳐 나간다."

msgid "sn_dsc_0677"
msgstr "사소한 일로 셰릴에게 오해를 사버린 알토.\\n마구 두드리는 셰릴을 상대로 알토는 오해를 풀기 위해 필사적이다."

msgid "sn_dsc_0678"
msgstr "란카가 내뿜는 폴드파에 맞서기 위해 필사적으로 계속 노래하는 셰릴.\\n「이것이… 그 아이의 진짜 힘!?」─셰릴"

msgid "sn_dsc_0679"
msgstr "리조트 시설에 설치된 인형 뽑기에 도전하는 란카 일행.\\n진지한 표정으로 크레인을 조작하는 란카, 과연 결과는…?"

msgid "sn_dsc_0680"
msgstr "영화 출연 이후 인기 아이돌로서 잡지 인터뷰를 받는 란카.\\n차분하게 대답하면서도 가끔 보여주는 미소에서 란카의 성장을 느낄 수 있다."

msgid "sn_dsc_0681"
msgstr "푸른 하늘이 비치는 무대에서 하늘을 향해 손을 뻗으며 자유롭게 노래하는 프레이아.\\n그 노랫소리는 하야테를 향한 마음을 표현하듯 빛나며, 듣는 사람들의 마음을 설레게 한다."

msgid "sn_dsc_0682"
msgstr "간호사 의상의 가슴 부분을 풀어헤치고, 흔들리듯 매혹적인 춤을 추는 셰릴.\\n겹겹이 겹쳐 보이는 모습은 무대 연출일까, 아니면 관객의 눈이 만들어낸 착각일까…?"

msgid "sn_dsc_0683"
msgstr "메서보다 강한 적을 앞에 두고 아무것도 하지 못했던 자신의 무력함을 뼈저리게 느낀 하야테.\\n그리고 해파리 배웅을 통해 메서의 몫까지 자신이 날겠다고 새로운 결의를 다진다."

msgid "sn_dsc_0684"
msgstr "노래로 싸움을 멈추기 위해 미쿠모에게 달려가 함께 노랫소리를 울려 퍼뜨리는 프레이아.\\n하야테는 발키리들의 노래에 대한 신념을 직접 목격하고 다시 한번 큰 충격을 받았다."

msgid "sn_dsc_0685"
msgstr "트윈테일을 휘날리며 구바바와 함께 노래하고 춤추는 밀레느.\\n란카에게도 지지 않는 경쾌한 춤으로 보는 이들의 마음에 빛을 선사한다."

msgid "sn_dsc_0687"
msgstr "알토와 휴일에 만나기로 약속하려던 란카였지만, 브레라에게 제지당한다.\\n조용히 시선을 보내는 브레라를 란카는 신기한 듯 올려다보았다."

msgid "sn_dsc_0688"
msgstr "라이브가 끝나갈 무렵, 관객석의 셰릴 앞에서 두 명의 란카가 미소를 보인다.\\n초대에 응해 와준 셰릴에게 감사의 마음을 전하고 싶었던 것일지도 모른다."

msgid "sn_dsc_0689"
msgstr "반응탄을 이용한 선제공격이 이루어졌지만, 바주라는 아직도 많이 남아 있다.\\n오즈마의 명령을 시작으로 전투는 근거리 도그파이트로 전환되었다."

msgid "sn_dsc_0690"
msgstr "대형 바주라의 머리 위를 차지하고 공격 태세에 들어가는 브레라.\\n임플란트화된 그의 눈에는 적의 약점이 선명하게 비치고 있었다."

msgid "sn_dsc_0691"
msgstr "마음이 흐려진 소녀는 요정의 모습이 되어 마법의 꽃밭을 날아다녔다.\\n용기와 자신감을 되찾은 순간, 소녀는 마이크를 들고 노래하기 시작한다."

msgid "sn_dsc_0692"
msgstr "요정과 함께 작은 민들레 씨앗들이 공연장 전체에 흩날린다.\\n그렇게 날아간 곳에서 민들레 씨앗은 다시 새로운 용기를 싹틔워 간다."

msgid "sn_dsc_0693"
msgstr "VF-27γ의 캐노피는 완전히 장갑화되어 있어 외부 모습을 직접 볼 수 없다.\\n대신 콕핏 내부 전체가 모니터로 되어 있다."

msgid "sn_dsc_0694"
msgstr "조용한 무대 위에 한 소녀가 슬픈 표정으로 주저앉아 있다.\\n그녀의 마음은 흐려져 있었고, 소녀는 용기를 내지 못하고 있었다."

msgid "sn_dsc_0695"
msgstr "바주라 둥지 내부에는 대형 바주라가 있었다.\\n그리고 그 주변에는 바주라의 유생으로 보이는 생물이 알 속에서 잠들어 있었다."

msgid "sn_dsc_0696"
msgstr "라이브 연출로 비춰진 푸른 하늘.\\n쏟아지는 햇살은 공연장이 실내라는 사실을 잊게 해준다."

msgid "sn_dsc_0697"
msgstr "차분한 모습의 오즈마와 브레라. 조용한 분위기가 두 사람을 감싸고 있다.\\n하지만 속으로는 란카의 라이브가 신경 쓰이는지 초대장을 계속 의식하는 듯하다."

msgid "sn_dsc_0698"
msgstr "S.M.S 소속 파일럿. 스컬 소대의 리더로서 항상 선두에 선다.\\n풍부한 경험과 숙련된 기술을 지녔으며, 마음속에는 냉정함과 뜨거운 열정을 함께 품고 있다."

msgid "sn_dsc_0699"
msgstr "스파이 혐의 사건 이후 셰릴의 감시역 겸 보디가드로 고용된 알토.\\n하지만 정작 셰릴은 그런 알토를 이용해 란카를 놀릴 여유를 보이고 있다."

msgid "sn_dsc_0700"
msgstr "일하는 틈을 내 오랜만의 휴일에 알토를 바다로 초대하는 란카.\\n약속을 받아내자 마얀섬에서 보낼 즐거운 나날을 상상하며 미소 짓는다."

msgid "sn_dsc_0702"
msgstr "바주라와의 전투가 끝난 뒤 그 자리를 떠나려는 브레라를 오즈마가 막는다.\\n지금은 함께 싸우는 관계라 해도, 두 사람 사이에는 어딘가 긴장감이 감돌고 있다."

msgid "sn_dsc_0704"
msgstr "곡의 이미지로도 사용되는 데포르메된 곰 인형.\\n마치 란카의 곁을 지키듯, 마법의 힘으로 움직인다."

msgid "sn_dsc_0709"
msgstr "콕핏에 울리는 통신 소리를 듣고 황급히 숨으려 하는 민메이.\\n안타깝게도 히카리와 함께 있다는 사실이 이미 알려져 있었는지, 순식간에 들키고 말았다."

msgid "sn_dsc_0710"
msgstr "리조트 함선 리비에라에 연주 일을 위해 찾아온 Fire Bomber.\\n일이라 해도 함내 시설을 소개하는 방송을 들으면 기대가 커질 수밖에 없다."

msgid "sn_dsc_0711"
msgstr "새장 같은 세계에 날개를 빼앗긴 채로도 새로운 땅을 찾아 나아갔던 젊은이들.\\n진정한 하늘과 마음을 되찾았을 때, 그 날개는 끝없이 펼쳐진 하늘을 자유롭게 날아오를 것이다."

msgid "sn_dsc_0712"
msgstr "하늘의 세계에는 에이스라고 불리는 파일럿들이 있다.\\n그들은 다정함과 엄격함을 함께 지니고 있으며, 때로는 목숨을 걸고 자신의 삶의 방식을 동료들에게 보여준다."

msgid "sn_dsc_0713"
msgstr "자유로운 하늘을 무엇보다 사랑하고, 하늘과 소중한 것을 지키는 데 모든 것을 바친 남자들.\\n설령 도중에 길이 끊어진다 해도 그 고결한 정신은 결코 썩어 없어지지 않는다."

msgid "sn_dsc_0714"
msgstr "황무지가 된 지상에서 이제 살아남은 사람이 없을지도 모른다며 슬퍼하는 미사.\\n그런 미사에게 히카리는 적어도 혼자가 아니라는 희망을 보여주었다."

msgid "sn_dsc_0715"
msgstr "카무진 함대의 일제 공격을 배리어 시스템으로 훌륭히 막아낸 마크로스.\\n「굉장하네」「이걸로 포기해 주면 좋겠는데 말이야」─카키자키, 히카리"

msgid "sn_dsc_0716"
msgstr "실험은 이제 괜찮냐고 묻는 레온에게 그레이스는 조련에는 당근과 채찍이 필요하다고 말한다.\\n마치 란카의 인권을 무시하는 듯한 그 말투에서는 섬뜩한 악의를 느끼게 한다."

msgid "sn_dsc_0717"
msgstr "노래에 몸을 바친 지 수년, 머나먼 은하를 건너며 노래라는 문화를 계속 전해온 셰릴.\\n때로는 격렬하게, 때로는 애절하게 타오르는 그리움과 함께 그녀의 발자취는 찬란히 빛나고 있다."

msgid "sn_dsc_0718"
msgstr "은하에 이름을 떨치는 아티스트들이 한자리에 모이는 스페셜 라이브가 열렸다.\\n울려 퍼지는 가희들의 노랫소리는 은하 모든 사람들의 마음을 이어주는 희망이라고 할 수 있을지도 모른다."

msgid "sn_dsc_0719"
msgstr "은하에 이름을 떨치는 아티스트들이 한자리에 모이는 스페셜 라이브가 열렸다.\\n가희들의 사랑과 용기, 생명을 건 노랫소리는 결코 바래지 않을 빛으로 가득했다."

msgid "sn_dsc_0720"
msgstr "은하에 이름을 떨치는 아티스트들이 한자리에 모이는 스페셜 라이브가 열렸다.\\n뜨겁게 영혼을 불태우는 노랫소리는 별들을 빛나게 하고, 시공을 넘어 전해져 갈 것이다."

msgid "sn_dsc_0721"
msgstr "은하 최고의 싱어로서 줄곧 달려온 셰릴.\\n요정이라 불렸던 그녀는 앞으로도 더욱 빛을 더하며 계속 노래할 것이다."

msgid "sn_dsc_0723"
msgstr "한때 마크로스 갤럭시 선단에 가부키의 천재 아역 배우가 찾아왔다.\\n그의 연기를 본 한 소녀는 언젠가 자신도 은하 최고의 가수가 되겠다고 맹세했다."

msgid "sn_dsc_0724"
msgstr "진정한 적을 쓰러뜨리고 프론티어 선단의 사람들은 평화를 손에 넣을 수 있었다.\\n그리고 싸움 속에서 잃어버린 것들을 떠올리며 그들은 기도를 올린다."

msgid "sn_dsc_0725"
msgstr "셰릴과 란카, 서로 다른 곳에서 태어나 자란 두 사람.\\n하지만 신기하게도 두 사람은 완전히 같은 노래를 부를 수 있었다."

msgid "sn_dsc_0726"
msgstr "갤럭시 선단의 스파이라는 혐의로 구속, 체포된 셰릴.\\n전시 법규에 따라 그녀에게는 사형이 선고되었다."

msgid "sn_dsc_0727"
msgstr "가부키의 천재 아역 배우로 유명했던 알토.\\n과거에는 공연을 위해 다른 선단을 찾아가기도 했다."

msgid "sn_dsc_0728"
msgstr "마지막 노래를 다 부른 셰릴은 의식을 잃고 그대로 깨어나지 않은 채 잠들어 있다.\\n치료는 계속되고 있지만, 앞으로 언제 눈을 뜰지는 아직 알 수 없다."

msgid "sn_dsc_0729"
msgstr "수많은 바주라와 치열한 공중전을 벌이는 알토.\\n토네이도 팩을 장비한 VF-25F라 해도 한순간도 방심할 수 없다."

msgid "sn_dsc_0730"
msgstr "전투 중 노래하는 셰릴의 모습이 프론티어 전 함선에 중계된다.\\n그 영상을 본 사람들은 아직 희망이 남아 있음을 알게 되었다."

msgid "sn_dsc_0731"
msgstr "프론티어 선단에 매장을 둔 핫도그 가게.\\n자극적인 매운맛이 인기의 비결이다."

msgid "sn_dsc_0732"
msgstr "병원 옥상에서 셰릴과 알토는 나란히 석양을 바라보고 있었다.\\n잠시 동안의 평온한 시간이 두 사람을 감싸 안는다."

msgid "sn_dsc_0733"
msgstr "가수가 되는 꿈을 꾸며 앞만 보고 달려온 란카.\\n신데렐라라 불리던 소녀도 어느새 동경하던 존재와 어깨를 나란히 할 만큼 성장했다."

msgid "sn_dsc_0735"
msgstr "미셸은 평소에도 전직 여장 배우였던 알토를 「공주님」이라고 부르며 놀리곤 했다.\\n하지만 이날 확고한 결의를 품은 그의 눈을 보고, 미셸은 기쁜 듯 미소 지었다."

msgid "sn_dsc_0736"
msgstr "어린 시절부터 사오토메 알토는 하늘을 나는 것을 꿈꿨다.\\n그리고 소년은 성장해 드넓은 하늘을 자유롭게 누비는 파일럿이 되었다."

msgid "sn_dsc_0737"
msgstr "바주라의 공격을 받아 기체 밖으로 튕겨 나가버린 미셸.\\n철제 기둥에 걸려 공중에 매달린 상태에서도 평소처럼 농담을 던져 보였다."

msgid "sn_dsc_0738"
msgstr "대파된 VF-25G의 잔해 앞에서 굵은 눈물을 흘리는 클랑.\\n하지만 생존한 미셸을 발견하면서 슬픔은 기쁨으로 바뀌었다."

msgid "sn_dsc_0739"
msgstr "아슬아슬한 근접 비행으로 바주라 모함의 뒤를 잡은 마크로스 쿼터.\\n보비의 거친 함성과 함께 필살의 마크로스 어택을 퍼붓는다!"

msgid "sn_dsc_0740"
msgstr "첫 라이브 준비 중 우울한 표정을 짓고 있어 나나세에게 걱정을 산 란카.\\n라이브 전의 긴장 때문일까, 아니면 다른 무언가 때문일까. 그 마음은 그녀의 가슴속에 있다."

msgid "sn_dsc_0741"
msgstr "그리피스 파크 언덕에서 알토에게 속마음을 털어놓는 란카.\\n알토는 주머니에서 종이를 꺼내더니 익숙한 손놀림으로 종이비행기를 만들어 보였다."

msgid "sn_dsc_0742"
msgstr "프론티어 선단에서 개발된 시작기.\\n이것은 실제 기체가 아니라 정교하게 만들어진 모형이다."

msgid "sn_dsc_0743"
msgstr "병원 옥상에서 마주 보고 있는 셰릴과 알토. 그곳에 우연히 란카가 찾아온다.\\n석양에 비춰진 세 사람의 관계는 조금씩 변하기 시작했다."

msgid "sn_dsc_0744"
msgstr "충전 스탠드 위에서 쉬고 있는 큰도롱뇽 씨.\\n그 뛰어난 신축성을 한껏 발휘한 늘어진 모습이다."

msgid "sn_dsc_0745"
msgstr "윤기 나는 검은 날개를 가진 까마귀는 호기심이 많고, 때로는 예상 밖의 행동을 하는 새다.\\n대담한 행동력을 지닌 셰릴 때문에 팬들과 주변 사람들은 언제나 놀라고 있다."

msgid "sn_dsc_0746"
msgstr "때로는 바다를 넘어 수천 킬로미터를 날아가는 제비의 앞을 가로막을 것은 아무것도 없다.\\n자신에게 솔직하고 곧은 밀레느 역시 어디까지나 자유롭게 날아갈 것이다."

msgid "sn_dsc_0747"
msgstr "하얀 날개를 퍼덕이며 하늘을 나는 비둘기는 사람들에게 평화의 이미지를 떠올리게 한다.\\n서로 다른 종족을 아름다운 노랫소리로 화해시킨 민메이 역시 평화의 상징이라 할 수 있을 것이다."

msgid "sn_dsc_0748"
msgstr "큰 눈과 사랑스러운 이미지가 있는 부엉이는 뛰어난 사냥꾼이라는 면도 함께 지니고 있다.\\n란카에게도 친근한 귀여움과 강한 심지, 끈기 있는 면이 있을지도 모른다."

msgid "sn_dsc_0749"
msgstr "상승 기류를 능숙하게 타고 하늘 높이 날아오르는 솔개는 무혈 승리를 상징하는 새다.\\n하늘 높이 울려 퍼지는 바사라의 뜨거운 노랫소리는 전쟁을 멈추고 모두를 승리로 이끌 것이다."

msgid "sn_dsc_0750"
msgstr "다채로운 깃털 색과 다양한 모습을 가진 앵무새는 존재만으로도 주변을 밝게 물들인다.\\n언제나 밝고 활기찬 프레이아는 라이브뿐 아니라 항상 사람들에게 웃음을 전해준다."

msgid "sn_dsc_0751"
msgstr "물고기 떼의 위치를 알려주는 괭이갈매기는 어부들에게 신의 사자로 소중히 여겨진다.\\n멤버들을 하나로 모아 이끄는 카나메는 사람들의 길잡이라고 해도 과언이 아닐 것이다."

msgid "sn_dsc_0752"
msgstr "화려한 깃털을 우아하게 펼치는 공작은 아름다우면서도 어딘가 환상적인 새다.\\n미쿠모의 세속을 벗어난 듯한 분위기 역시 그녀의 매력을 더욱 돋보이게 하는 것 같다."

msgid "sn_dsc_0753"
msgstr "하늘이 아닌 바닷속을 자유롭게 누비는 펭귄은 조류 중에서도 특이한 존재다.\\n천재 해커 레이나를 정보의 바다에서 헤엄치게 한다면, 그녀를 따라올 자는 없을 것이다."

msgid "sn_dsc_0754"
msgstr "플라밍고는 평온을 위해 특별한 환경의 물가에 사는 선명한 분홍색의 새다.\\n온화한 분위기와 성격으로 주변을 감싸는 마키나가 원하는 것은 평온한 세계일지도 모른다."

msgid "sn_dsc_0756"
msgstr "맑은 공기를 가슴 가득 느끼며 사이좋게 첫 참배를 하러 온 셰릴과 란카.\\n첫 해돋이를 맞이하고 참배를 마치면 새로운 한 해를 축하하는 스페셜 라이브의 시작이다!"

msgid "sn_dsc_0757"
msgstr "톱 아이돌로서 마크로스 함내에서 큰 인기를 누리는 민메이. 촬영과 라이브로\\n바쁜 나날을 보내던 어느 날, 그녀는 이치조 히카리와 운명적인 만남을 하게 된다."

msgid "sn_dsc_0759"
msgstr "전투 소동으로 폐쇄 구역에 갇혀버린 히카리와 민메이.\\n이런 상황에서도 히카리는 자신이 이전부터 민메이의 팬이었다고 밝혔다."

msgid "sn_dsc_0760"
msgstr "젠트라디군의 공격으로 마크로스 내부의 중력 제어 시스템이 정지한다.\\n무중력 공간을 떠도는 민메이. 그것을 발견한 히카리는 즉시 발키리를 타고 구조하러 향했다."

msgid "sn_dsc_0761"
msgstr "지구 귀환을 목표로 하는 마크로스에 젠트라디군 전투 부대가 습격해 온다.\\n서로의 거리가 가까워지고, 적과 아군이 뒤섞인 난전이 시작되려 하고 있었다."

msgid "sn_dsc_0762"
msgstr "구조가 올 때까지 두 사람은 함께 시간을 보내게 된 히카리와 민메이.\\n남녀가 단둘이 있는 상황인데도 민메이는 그다지 신경 쓰지 않는 듯하다."

msgid "sn_dsc_0763"
msgstr "러브신 연기를 해보겠다며 히카리에게 다가가는 민메이.\\n연기라는 것을 알고 있으면서도 분위기에 휩쓸린 히카리는 당황한 기색을 감추지 못한다."

msgid "sn_dsc_0764"
msgstr "폐쇄 구역에서 구조된 히카리에게 동료 카키자키 일행이 달려온다.\\n모두가 히카리와 민메이의 관계에 큰 관심을 보이며 연달아 질문을 던졌다."

msgid "sn_dsc_0765"
msgstr "자신에게 맡겨진 임무를 무시하고 마크로스 방어로 향한 히카리.\\n명령을 듣지 않는 히카리 때문에 하야세 미사도 골머리를 앓는 듯하다."

msgid "sn_dsc_0766"
msgstr "추가 장비인 아머드 팩을 장착한 VF-1J.\\n막강한 화력과 장갑을 자랑하지만, 장착한 상태로 변형할 수 없다는 단점이 있다."

msgid "sn_dsc_0767"
msgstr "마크로스에서 회수한 민메이 인형을 조심스럽게 만지는 젠트라디 병사.\\n그들은 지구인을 마이크론이라고 부르며, 그 존재를 두려워하는 듯하다."

msgid "sn_dsc_0768"
msgstr "무사히 폐쇄 구역에서 구조된 히카리와 민메이.\\n하지만 우연히 키스하고 있던 모습이 사진에 찍히고 말았다."

msgid "sn_dsc_0769"
msgstr "특수 작전 수행을 중점으로 스텔스 성능이 중시된 최신예 가변 전투기.\\n마크로스 7 선단에서도 정예 부대인 다이아몬드 포스에 배치되어 있다."

msgid "sn_dsc_0771"
msgstr "처음 만났을 때는 바사라의 파격적인 성격을 이해하지 못하고 반발하는 일이 많았던 감린.\\n하지만 밀레느의 도움도 있어 조금씩 감린의 마음은 변해간다."

msgid "sn_dsc_0772"
msgstr "결혼한 지 시간이 흐르고, 이제는 완전히 식어버린 부부 사이.\\n하지만 그것은 어른이 되어서도 솔직해지지 못하는 부분이 있을 뿐이다."

msgid "sn_dsc_0773"
msgstr "혼수상태에 빠진 바사라 앞에서 Fire Bomber의 노래를 부르는 감린.\\n마침내 바사라는 눈을 뜨고, 감린 역시 기쁜 듯 미소를 지었다."

msgid "sn_dsc_0774"
msgstr "자신의 전용기를 타고 미리아와 함께 전장으로 돌아온 맥스.\\n한때 천재라 불렸던 그의 기술은 여전히 녹슬지 않았고, 몰려드는 적을 농락한다."

msgid "sn_dsc_0775"
msgstr "아무리 말려도 전장에 가겠다는 밀레느에게 바사라는 목소리를 높였다.\\n「내가 발키리에서 끌어내릴 테니까!」―바사라"

msgid "sn_dsc_0776"
msgstr "출격 전, 사운드 포스의 호위를 할 여유가 없다고 말했던 감린.\\n그럼에도 마지막 순간 믿어야 할 것은 역시 바사라의 노랫소리라고 느끼고 있었다."

msgid "sn_dsc_0777"
msgstr "만약 전장에서 목숨을 잃는다면 이 야경도 마지막이 되어버린다.\\n이미 익숙해졌을 터인 야경을 바라보며 바사라는 노래하기 시작했다."

msgid "sn_dsc_0778"
msgstr "출격 직전, 누가 먼저 도착할지를 이야기하는 바사라와 감린.\\n두 사람 사이에 끼어 있던 밀레느는 어딘가 안심한 듯 미소를 지었다."

msgid "sn_dsc_0779"
msgstr "프로토 데빌룬이 거점으로 삼고 있는 행성으로 향한 마크로스 7 선단의 공격 부대.\\n지표면에는 무수한 적들이 기다리고 있었다."

msgid "sn_dsc_0780"
msgstr "프로토 데빌룬에 대한 공격을 시작하는 발키리 부대.\\n격렬한 저항을 피하며 지상으로 접근해 간다."

msgid "sn_dsc_0781"
msgstr "도쿄 스카이트리를 방문하게 된 발키리의 다섯 명.\\n최고의 관광 날씨다."

msgid "sn_dsc_0783"
msgstr "도쿄 스카이트리를 방문하게 된 셰릴.\\n하지만 약속 장소에서 기다리던 상대는 아무래도 늦게 온 모양인데…"

msgid "sn_dsc_0784"
msgstr "도쿄 스카이트리를 방문하게 된 란카.\\n약속 시간보다 일찍 와버린 란카가 기다리고 있던 것은…"

msgid "sn_dsc_0785"
msgstr "레슨 중 하야테가 최종 시험을 치르고 있다는 사실을 알게 된 프레이아.\\n곁으로 갈 수는 없어도, 그녀는 소중한 동료를 위해 노래하기 시작했다."

msgid "sn_dsc_0786"
msgstr "새해를 맞이하기에 어울리는 화려한 옷차림으로 첫 참배를 온 미쿠모와 카나메, 그리고 메서.\\n새해 하늘에 울려 퍼지는 방울 소리는 분명 은하의 모든 신들에게도 소원을 전해줄 것이다."

msgid "sn_dsc_0789"
msgstr "인류가 우주로 날아오른 지 약 반세기, 시대를 넘어 여전히 사람들의 마음속에 살아 숨 쉬는 노래가 있다.\\n그리고 각 시대를 상징하는 가희들의 노랫소리는 종족을 넘어 지금도 계속 사랑받고 있다."

msgid "sn_dsc_0790"
msgstr "여러분의 성원에 힘입어, 「노래 마크로스」도 2주년을 맞이할 수 있었습니다.\\n「노래 마크로스」는 앞으로도 여러분과 함께 마크로스피드로 계속 달려가겠습니다!"

msgid "sn_dsc_0791"
msgstr "알토의 뒤로 몰래 다가가 손가락으로 등을 찔러 놀라게 하는 셰릴.\\n예상대로 반응하는 알토를 보고 셰릴의 표정도 만족스러워 보인다."

msgid "sn_dsc_0792"
msgstr "전투 중 피격되어 발키리를 대파시키면서도 어떻게든 첫 출격을 마친 카키자키.\\n히카리 일행과 가볍게 웃으며 이야기하면서도 머릿속은 발키리 변상 생각으로 가득했다."

msgid "sn_dsc_0794"
msgstr "여러분의 성원에 힘입어, 「노래 마크로스」도 1주년을 맞이할 수 있었습니다.\\n셰릴과 란카도 드레스를 입고 축하해 주는 것 같습니다!"

msgid "sn_dsc_0795"
msgstr "은하를 대표하는 가희 민메이와, 발키리를 동경해 변경 행성을 뛰쳐나온 프레이아.\\n시공을 초월한 두 사람의 만남은 사라져버린 세계의 기억을 다시 되살려줄 것이다."

msgid "sn_dsc_0796"
msgstr "『초시공 신데렐라』 란카와 발키리의 포근한 분위기 메이커 마키나.\\n소중한 사람들을 생각하는 두 사람의 노랫소리에는 분명 멋진 소원이 담겨 있을 것이다."

msgid "sn_dsc_0797"
msgstr "Fire Bomber의 베이시스트 밀레느와 발키리의 천재 해커 레이나.\\n두 사람의 신선한 발상과 기술로 은하 곳곳에 장난기와 놀라움을 퍼뜨려 줄 것 같다."

msgid "sn_dsc_0798"
msgstr "전자 가희 샤론과 나이부터 경력까지 모두 불명인 발키리의 에이스 미쿠모.\\n블랙박스에 싸인 두 사람이지만, 노래를 향한 마음만큼은 순수한 진실이다."

msgid "sn_dsc_0799"
msgstr "Fire Bomber의 메인 보컬 바사라와 발키리의 리더 카나메.\\n앞으로 나아가기만 하는 두 사람의 노랫소리는 더욱 높은 곳을 향해 동료들을 이끌어 간다."

msgid "sn_dsc_0800"
msgstr "과거에서 미래로 가희들의 영향을 이어받아 온 『은하의 요정』 셰릴.\\n사랑으로 가득한 그녀의 노랫소리 역시 은하에서 태어나는 새로운 노랫소리와 함께 계속 이어져 갈 것이다."

msgid "sn_dsc_0801"
msgstr "특제 생일 케이크에 꽂힌 촛불을 바라보며 기분 좋은 표정을 짓는 셰릴.\\n파티에 초대한 사람들이 아직 오지도 않았는데도 참지 못했던 모양이다."

msgid "sn_dsc_0802"
msgstr "더 이상 노래하지 않아도 된다는 알토의 말에 거부 의사를 보이는 셰릴.\\n설령 목숨을 깎아내는 일이 되더라도, 그녀에게 노래야말로 살아있었다는 증거다."

msgid "sn_dsc_0803"
msgstr "은하를 뒤흔든다는 말을 듣고, 과거 셰릴과 만났던 일을 떠올리는 알토.\\n한편 셰릴은 처음 만났을 때부터 알토를 기억하고 있었다."

msgid "sn_dsc_0804"
msgstr "아일랜드 1 상공에 설치된 스카이 라운지에서 바라본 풍경에 감탄하는 셰릴.\\n알토에게는 평범한 돔형 도시선이지만, 셰릴에게는 특별한 것으로 보였던 모양이다."

msgid "sn_dsc_0805"
msgstr "수많은 위기를 함께 극복해 온 발키리의 다섯 명. 한때 외롭고\\n제멋대로였던 뛰어난 해커 레이나 프라우러는 이제 어디에도 없다."

msgid "sn_dsc_0807"
msgstr "미쿠모를 위해 프레이아, 카나메, 레이나 세 사람은 필사적으로 계속 노래했다.\\n그리고 부상으로 이탈해 있던 마키나도 고통을 참으며 일어섰다."

msgid "sn_dsc_0808"
msgstr "어린 시절 미라쥬의 기억.\\n전투기의 콕핏에 타고 기뻐하는 모습은 그녀 안에 흐르는 에이스의 혈통을 느끼게 한다."

msgid "sn_dsc_0809"
msgstr "하야테의 어머니에게서 온 소포 안에는 어린 시절 하야테와 아버지의 사진이 들어 있었다.\\n그 사진을 본 프레이아는 무언가 떠올린 듯 웃기 시작했다."

msgid "sn_dsc_0810"
msgstr "최종 결전을 앞두고 하야테와 이야기하려는 프레이아.\\n아무리 연락해도 받지 않았던 것은 아무래도 휴대전화 전원이 꺼져 있었기 때문인 듯하다."

msgid "sn_dsc_0811"
msgstr "격렬한 전투 중 하야테를 지원하는 미라쥬.\\n하야테에게 고맙다는 말을 듣자 무심코 얼굴을 붉히며 시선을 돌려버린다."

msgid "sn_dsc_0812"
msgstr "언제나 식사 시간이 되면 모습을 감춰버리는 미쿠모.\\n가끔은 함께 먹자며 마키나와 레이나가 웃는 얼굴로 붙잡는다."

msgid "sn_dsc_0813"
msgstr "미쿠모 긴누메르의 정체는 별의 가희라 불리는 존재였다.\\n왕족의 혈통인 하인츠에게는 그것을 알 수 있다고 한다."

msgid "sn_dsc_0814"
msgstr "하야테가 아버지에게 받은 펜던트.\\n특무 첩보원으로 임무를 수행하던 중 어딘가에서 얻은 물건일까."

msgid "sn_dsc_0815"
msgstr "가족에게 받은 도시락을 보고 새로운 결의를 다지는 척.\\n「라그나도 마리안느도, 반드시 되찾아 올 테니까」―척"

msgid "sn_dsc_0816"
msgstr "윈더미어 병사들이 장비하는 날다람쥐 같은 슈트.\\n높은 신체 능력을 활용해 자유롭게 바람을 탈 수 있다."

msgid "sn_dsc_0817"
msgstr "수많은 위기를 함께 극복해 온 발키리의 다섯 명.\\n신비로운 가희, 미스테리어스 비너스의 마음속에도 유대는 분명 존재하고 있다."

msgid "sn_dsc_0819"
msgstr "프레이아와 동료들의 목소리를 듣고 미쿠모는 마침내 자신을 되찾았다.\\n자신의 깊은 곳에 잠들어 있던 솔직하고 순수한 소망을 되찾은 것이다."

msgid "sn_dsc_0820"
msgstr "망설임에 사로잡힌 미쿠모에게 프레이아가 묻는다.\\n그것은 과거 발키리에 막 들어온 자신에게 미쿠모가 물었던 말이었다."

msgid "sn_dsc_0821"
msgstr "별의 가희 미쿠모의 노랫소리가 라그나에 울려 퍼진다.\\n그 목소리에 담긴 막대한 생체 폴드파가 행성을 뒤흔들었다."

msgid "sn_dsc_0822"
msgstr "성의 정원에서 노래하는 하인츠에게 용조 한 마리가 날아 내려온다.\\n예전부터 아무리 사나운 동물이라도 하인츠에게는 금세 따르게 된다고 한다."

msgid "sn_dsc_0823"
msgstr "누군가와 함께 식사하는 것에 부끄러움을 보이는 미쿠모.\\n그 사랑스러운 모습을 본 마키나는 참지 못하고 환하게 웃었다."

msgid "sn_dsc_0824"
msgstr "강력한 폴드파의 폭풍에 시달리면서도 발키리는 다시 일어섰다.\\n리더 카나메를 중심으로 모두가 하나 되어 미쿠모를 되찾으려 하고 있었다."

msgid "sn_dsc_0825"
msgstr "최종 결전을 앞두고 하야테에게 맡겨진 새로운 기체.\\n그 등에는 사신의 바람을 이어받은 엠블럼이 새겨져 있었다."

msgid "sn_dsc_0826"
msgstr "하야테의 아버지 사진을 보고 프레이아는 떠올렸다.\\n어린 시절의 자신에게 지구의 노래가 담긴 음악 플레이어를 건네준 사람을."

msgid "sn_dsc_0827"
msgstr "윈더미어에 잠입해 있던 중 병사에게 붙잡힌 하야테.\\n변장을 위해 붙이고 있던 가짜 룬을 뜯겨 버린다."

msgid "sn_dsc_0828"
msgstr "과거 윈더미어 땅에 차원병기를 투하했던 VF-22.\\n하야테의 아버지 라이트가 탔던 기체는 악마의 날개라 불리며 보관되어 있었다."

msgid "sn_dsc_0829"
msgstr "인간의 일생에는 다양한 만남과 이별이 존재하고, 추억은 노래로 물들어 간다.\\n민메이의 노래는 시대와 장소를 넘어 지금도 수많은 사람들의 추억과 함께하고 있다."

msgid "sn_dsc_0830"
msgstr "민메이는 다시 가수로 살아가기로 선택했다.\\n히카리와의 이별을 아쉬워하듯 입맞춤한 뒤, 그녀는 황폐한 거리 속으로 걸어갔다."

msgid "sn_dsc_0831"
msgstr "전쟁이 끝나고 히카리는 미사와 함께 살아가기로 선택했다.\\n하지만 떠나가는 민메이의 노랫소리는 언제까지나 두 사람 곁에 남아 있었다."

msgid "sn_dsc_0832"
msgstr "인류의 우주 이민 계획이 결정되고, 첫 번째 함선의 함장으로 임명된 미사.\\n그녀는 마지막으로 마음속에 품고 있던 히카리를 향한 마음을 털어놓았다."

msgid "sn_dsc_0833"
msgstr "잠시 찾아온 평화를 깨뜨리듯 젠트라디군의 습격이 발생했다.\\n군인인 히카리는 즉시 출격하려 하지만, 민메이는 필사적으로 그를 붙잡았다."

msgid "sn_dsc_0834"
msgstr "미사는 군에서 은퇴하고 어딘가 먼 도시로 떠날 생각이라고 한다.\\n자신이 군인이기에 민메이와의 차이를 느끼고, 히카리를 향한 마음을 전하지 못하고 있는 것이다."

msgid "sn_dsc_0835"
msgstr "글로벌은 미사를 마크로스의 브리지로 불러냈다.\\n이제 총사령이라 불리는 남자의 눈은 인류의 미래를 조용히 바라보고 있었다."

msgid "sn_dsc_0836"
msgstr "민메이는 옛 추억 이야기를 하며 계속 그 시절로 돌아가고 싶다고 말했다.\\n즐거웠던 과거와 불확실한 미래. 언젠가는 히카리도 선택해야만 한다."

msgid "sn_dsc_0837"
msgstr "젠트라디군의 습격을 받아 과거의 승무원들이 마크로스에 집결한다.\\n잠시뿐이지만 마크로스는 다시 힘을 되찾았다."

msgid "sn_dsc_0838"
msgstr "민메이의 만류를 뿌리치고 히카리는 전장으로 향했다.\\n이때부터 히카리와 민메이의 미래는 서로 다른 방향으로 향하기 시작했다."

msgid "sn_dsc_0839"
msgstr "지상에 숨어 있던 젠트라디군 잔당이 마크로스에 공격을 개시했다.\\n전력은 결코 많지 않았지만 이미 시가지 넓은 범위에 피해가 발생하고 있었다."

msgid "sn_dsc_0840"
msgstr "적함의 주포가 명중하면서 마크로스가 균형을 잃는다.\\n갑작스러운 상황에 시민들은 멍하니 서 있을 수밖에 없었다."

msgid "sn_dsc_0841"
msgstr "물속을 비추는 듯한 심상 풍경 속에서 카나메는 하나의 빛을 두 손으로 부드럽게 감싼다.\\n그리고 그 빛 너머에 미래가 있음을 믿으며, 카나메 역시 미래를 향해 걸어가기 시작한다."

msgid "sn_dsc_0842"
msgstr "새해를 축하하는 린 민메이의 부름에 응해, 시공을 넘어 모인 은하의 가희들.\\n화려한 동양풍 의상을 걸친 가희들의 모습에 머나먼 은하마저 선명한 색채로 물든다."

msgid "sn_dsc_0843"
msgstr "노래로 마음을 전함으로써 날뛰는 원주 생물을 진정시킬 수 있었던 밀레느.\\n이 일을 통해 밀레느는 어렴풋하게나마 노래가 가진 힘을 느끼게 되었다."

msgid "sn_dsc_0844"
msgstr "따스한 햇살이 내리쬐는 가운데 풀밭에 누워 자유로운 하루를 온몸으로 만끽하는 밀레느.\\n바쁜 일상에서 벗어나 이렇게 느긋하게 보내는 시간도 중요할지도 모른다."

msgid "sn_dsc_0845"
msgstr "휴일을 이용해 히카리의 방을 정리하던 중 앨범 한 권을 발견한 미사.\\n앨범 속 히카리와 민메이의 사진을 보고 미사는 쓸쓸함을 더해 갔다."

msgid "sn_dsc_0846"
msgstr "비욘 시티의 폭동을 진압하고 기지로 돌아왔을 때, 미사에게 봉투를 건네받는 히카리.\\n안에 들어 있던 미사의 사진에 놀란 히카리를 뒤로하고, 미사는 아무 말 없이 달려가 버렸다."

msgid "sn_dsc_0847"
msgstr "올해 여름을 더욱 뜨겁게 만들기 위해 여신들이 특별 디자인 수영복을 입고 강림!\\n더 높은 곳을 향해 계속 날아오르는 발키리의 새로운 스테이지를 기대해 주세요!"

msgid "sn_dsc_0848"
msgstr "기타를 한 손에 들고 자신의 방을 나가려는 바사라.\\n긴 이별이 될 것을 눈치챈 것인지, 구바바는 슬픈 듯 울었다."

msgid "sn_dsc_0849"
msgstr "흰 은하 고래에게 무모한 싸움을 반복하는 아버지의 모습을 계속 지켜봐 온 라이자.\\n그 때문인지 비슷하게 무모한 행동을 하는 바사라에게는 불평하지 않을 수 없었다."

msgid "sn_dsc_0853"
msgstr "과거의 기억을 갖고 있지 않은 란카는 언제나 마음 한구석에서 불안과 고독을 느끼고 있었다.\\n어둡고 어두운 마음의 바다. 하지만 지금, 엮여진 희망의 빛이 그녀의 손을 잡으려 하고 있다."

msgid "sn_dsc_0854"
msgstr "석양이 점점 짙은 푸른빛으로 물들어 가는 가운데, 홀로 하늘을 향해 계속 노래하는 란카.\\n그 상냥한 노랫소리는 유구한 시간을 넘어 은하에 펼쳐진 수많은 별들에게 닿을 것이다."

msgid "sn_dsc_0855"
msgstr "알토의 활약으로 바주라에게 끌려간 란카는 무사히 구출되었다.\\n눈이 내리는 가운데 란카에게 다정하게 말을 거는 알토. 그러자 란카의 뺨이 붉게 물들었다."

msgid "sn_dsc_0856"
msgstr "자신이 할 수 있는 일을 했을 뿐이다. 바주라와의 싸움 후 셰릴은 그렇게 말했다.\\n그녀의 노래는 사람들에게 희망을 주었고, 동료들의 유대를 더욱 굳건하게 만들었다."

msgid "sn_dsc_0857"
msgstr "습격해 온 바주라를 물리치고 프론티어 선단의 위기는 사라졌다.\\n함내에는 인공 눈이 내려, 전투 속에서 흩어진 이들의 영혼을 위로하고 있었다."

msgid "sn_dsc_0858"
msgstr "바주라와의 치열한 전투 중 일시적으로 브레라의 지원을 받은 알토.\\n전투가 끝난 뒤, 어딘가 서로 통하는 것을 느꼈는지 알토는 미소를 지어 보였다."

msgid "sn_dsc_0859"
msgstr "바주라에게 납치된 란카를 구하기 위해 알토를 지원한 브레라.\\n전투 후 그가 보여준 미소는 냉혹한 임플란트 병사의 것이 아니었다."

msgid "sn_dsc_0860"
msgstr "자신의 소중한 귀걸이를 전투에 나서는 알토에게 맡겼던 셰릴.\\n자신들을 지켜준 보답이라며 조금은 억지스럽게 그것을 넘겨주었다."

msgid "sn_dsc_0861"
msgstr "마크로스 쿼터의 조타수인 보비 마르고.\\n그가 가진 대담한 조타 기술은 수없이 S.M.S의 위기를 구해 왔다."

msgid "sn_dsc_0862"
msgstr "마크로스 쿼터는 「마크로스」라는 이름을 가진 함선 중에서는 소형이다.\\n기존형과 비교해도 약 4분의 1 크기지만, 그만큼 높은 기동성을 자랑한다."

msgid "sn_dsc_0863"
msgstr "숫자의 힘으로 적에게 덤벼드는 바주라.\\nVF-25의 최신 화기 관제 시스템으로도 모두 쓰러뜨리기는 어렵다."

msgid "sn_dsc_0864"
msgstr "배틀 프론티어가 발사하는 필살의 마크로스 캐논.\\n은하를 꿰뚫을 듯한 그 일격은 어떤 적이라도 순식간에 쓰러뜨린다."

msgid "sn_dsc_0865"
msgstr "보는 모든 이를 두근거리게 만드는, 강렬하고 대담한 셰릴의 무대.\\n사랑하는 것도 사랑받는 것도, 그녀는 언제나 전력을 다한다."

msgid "sn_dsc_0867"
msgstr "당당한 걸음으로 거리를 걷는 셰릴.\\n그녀가 하면 선글라스를 벗고 시선을 보내는 행동조차도 한 폭의 그림이 된다."

msgid "sn_dsc_0868"
msgstr "병원 로비에서 알토를 사이에 두고 노래하기 시작한 셰릴과 란카.\\n셰릴의 대담한 어필 앞에서 알토도 쩔쩔매는 모습이다."

msgid "sn_dsc_0869"
msgstr "셰릴의 병문안을 위해 병원을 찾은 알토와 란카.\\n그때 란카의 데뷔 전 영상이 모니터에 비춰졌다."

msgid "sn_dsc_0870"
msgstr "학원에서 물건을 찾던 중 학생들에게 들키지 않기 위해 사물함에 들어간 두 사람.\\n조금 과격한 사건에 휘말리면서, 셰릴조차 얼굴을 붉히고 말았다."

msgid "sn_dsc_0871"
msgstr "자신의 몸을 좀먹는 병의 정체가 밝혀지고 깊은 슬픔에 잠긴 셰릴.\\n그럼에도 계속 노래하고 싶다며, 그녀는 사랑하는 사람에게 마음을 맡겼다."

msgid "sn_dsc_0872"
msgstr "알토 일행이 다니는 미호시 학원에 뜻밖의 전학생이 찾아왔다.\\n그 이름은 셰릴 놈. 그녀가 나타나는 곳에는 언제나 소동이 일어난다."

msgid "sn_dsc_0873"
msgstr "몸 상태가 좋지 않은 셰릴을 S.M.S의 개인실에서 쉬게 해주던 알토.\\n그곳에 끼어든 긴급 통신. 어째서인지 그 자리에 있던 미셸까지 당황하고 있었다."

msgid "sn_dsc_0874"
msgstr "작전 중 여자 문제로 사람을 놀리면 갑자기 격추당한다.\\n그런 징크스를 이야기하는 알토를 향해, 셰릴은 밝게 손을 흔들고 있었다."

msgid "sn_dsc_0875"
msgstr "거리에서 쓰러진 셰릴은 우연히 사오토메 저택에서 보호받고 있었다.\\n그녀를 만나러 온 알토 앞에는 다시는 넘지 않겠다고 맹세했던 문이 가로막고 있었다."

msgid "sn_dsc_0876"
msgstr "V형 감염증이라는 병에 대해 과거 자료를 조사하던 미셸과 클랑.\\n그곳에는 셰릴의 할머니와 함께 사진에 찍힌 그레이스의 모습이 있었다."

msgid "sn_dsc_0877"
msgstr "보는 모든 이를 반짝이게 만드는, 활기 넘치는 란카의 무대.\\n사랑도 노래도 전력인 그녀의 모습에 누구나 분명 사랑에 빠질 것이다."

msgid "sn_dsc_0879"
msgstr "경쾌한 걸음으로 거리를 나아가는 란카.\\n미래의 톱 아이돌도 이때만큼은 평범한 소녀의 미소를 짓고 있다."

msgid "sn_dsc_0880"
msgstr "병원 로비에서 알토를 사이에 두고 노래하기 시작한 셰릴과 란카.\\n란카의 대담한 어필 앞에서 알토는 조금 의외라는 표정을 보였다."

msgid "sn_dsc_0881"
msgstr "노래를 흥얼거리며 섹시한 어필로 알토에게 다가가는 셰릴.\\n그 모습을 란카는 부러움과 부끄러움이 섞인 시선으로 바라보고 있었다."

msgid "sn_dsc_0882"
msgstr "행성 갈리아 4에서 귀환한 란카는 병원에서 긴 정밀 검사를 받고 있었다.\\n그리고 오랜만에 알토와 재회하자 기쁜 나머지 안기려 했다."

msgid "sn_dsc_0883"
msgstr "마얀 섬에서의 영화 촬영도 막바지, 여주인공을 맡은 란카는 키스 장면에 도전한다.\\n주연 배우의 대역인 알토를 바라보는 그 눈동자에는 연기 이상의 무언가가 담겨 있었다."

msgid "sn_dsc_0884"
msgstr "미호시 학원의 예능 코스로 전학 온 란카.\\n일을 시작하게 된 사정 때문에 이전 학교에 다닐 수 없게 된 모양이다."

msgid "sn_dsc_0885"
msgstr "알토의 생일 선물로 쿠키를 구운 란카.\\n하지만 알토가 임무 때문에 선단을 떠나게 되어 직접 전해주지는 못했다."

msgid "sn_dsc_0886"
msgstr "란카의 데뷔곡 프로모션에 협력하고 있던 보비.\\n란카를 소홀히 대하면 용서하지 않겠다고 매니저 엘모에게 단단히 경고했다."

msgid "sn_dsc_0887"
msgstr "란카는 브레라와 함께 바주라의 고향으로 향하고 말았다.\\n만약 란카가 적이 된다면 그때는 자신이 란카를 쏘겠다고 알토는 각오했다."

msgid "sn_dsc_0888"
msgstr "바주라와의 싸움으로 황폐해진 프론티어 선단.\\n잔해 속에는 선단을 떠나버린 란카의 인형이 떨어져 있었다."

msgid "sn_dsc_0889"
msgstr "S.M.S 대원이면서 동시에 대기업 L.A.I의 기술 개발부 특별 고문이라는 얼굴도 가진 루카.\\n하지만 일상으로 돌아오면 그의 모습은 어디에나 있을 법한 남자 고등학생과 다르지 않다."

msgid "sn_dsc_0890"
msgstr "S.M.S 소속 파일럿. 전자전 및 정보 지원을 담당하고 있다.\\n나이에 걸맞은 어린 면이 남아 있지만, 전자기기 다루는 솜씨만큼은 전문가라 할 수 있다."

msgid "sn_dsc_0891"
msgstr "여러 얼굴을 가진 루카에게 미호시 학원에서의 일상은 무엇과도 바꿀 수 없는 소중한 것이었다.\\n그리고 그것은 점차 소년에게 지켜야 할 강함을 안겨주었다."

msgid "sn_dsc_0892"
msgstr "쪼그려 앉아 쓸쓸한 표정을 짓는 알토.\\n그가 그곳에 있는 것만으로 평범한 풍경도 덧없는 아름다움으로 가득 차게 된다."

msgid "sn_dsc_0893"
msgstr "란카의 첫 라이브를 기대하고 있는 듯한 루카.\\n평온한 점심시간, 맛있게 점심을 먹고 있다."

msgid "sn_dsc_0896"
msgstr "최종 결전을 앞두고 루카는 자신의 안에 있던 망설임을 떨쳐냈다.\\n지키고 싶은 것을 위해 싸우겠다고 소년은 각오를 다진 것이다."

msgid "sn_dsc_0901"
msgstr "인간 소녀와 비슷한 모습을 한 프로토 데빌룬, 그 이름은 시빌.\\n각성한 그녀는 마크로스 7 선단에 접근했고, 그곳에서 넥키 바사라와 조우하게 된다."

msgid "sn_dsc_0902"
msgstr "바사라와의 접촉으로 생명 에너지 「스피리치아」를 잃어버린 시빌.\\n푸른빛으로 빛나는 구체에 몸을 감싼 채 숲 깊은 곳에서 깊은 잠에 빠졌다."

msgid "sn_dsc_0903"
msgstr "언제 어느 때나 한결같이 노래를 불러온 바사라.\\n그가 노래했던 장소, 노래했던 순간, 노래 그 자체가 수많은 기억으로 살아 숨 쉬고 있다."

msgid "sn_dsc_0904"
msgstr "아무리 바사라가 노래해도 잠든 시빌은 전혀 깨어날 기색을 보이지 않는다.\\n이를 참지 못한 기길은 더 힘차게 노래하라며 바사라를 향해 주먹을 들어 올렸다."

msgid "sn_dsc_0905"
msgstr "바사라를 쫓아 식물 플랜트로 찾아온 밀레느.\\n그곳에서 얼마 전 미리아를 습격했던 시빌과 홀로 계속 노래하는 바사라의 모습을 목격한다."

msgid "sn_dsc_0906"
msgstr "스피리치아를 찾아 미리아의 사무실을 습격한 시빌.\\n밀레느와 감린이 달려오지만, 그 압도적인 힘 앞에서는 총조차 무력하다."

msgid "sn_dsc_0907"
msgstr "갑자기 잡지에 실린 바사라와 렉스의 열애 기사. 물론 내용은 조작이다.\\n렉스는 신경 쓰는 듯했지만, 정작 바사라는 평소와 다름없는 모습이었다."

msgid "sn_dsc_0908"
msgstr "가십지 「은스포」의 기자인 자넷.\\n바사라에 관한 스캔들 기사를 조작해 이번 소동을 일으킨 장본인이다."

msgid "sn_dsc_0909"
msgstr "밤마다 어딘가로 나가는 바사라를 몰래 미행하는 밀레느와 구바바.\\n같은 선글라스로 변장도 완벽하다."

msgid "sn_dsc_0910"
msgstr "마크로스 7 선단에 새롭게 창설된 정예 부대. 대장은 도커 대위.\\n최신예 기체 VF-19가 배치되어 있으며, 그 평가는 높다."

msgid "sn_dsc_0911"
msgstr "무언가의 기척을 느꼈는지 갑자기 울음소리를 낸 구바바.\\n바사라에게 들킬 뻔했다며 밀레느에게 혼나고 풀이 죽어버렸다."

msgid "sn_dsc_0912"
msgstr "바사라에 관한 수많은 스캔들 기사에 세간의 관심이 높아지고 있었다.\\n마침내 바사라의 집 앞까지 언론이 몰려들 정도였다."

msgid "sn_dsc_0913"
msgstr "란카와 함께 노래함으로써 셰릴의 노래의 힘은 더욱 강해져 간다.\\n생명의 불꽃을 태우는 듯한 강력한 노랫소리가 듣는 모든 이의 마음을 뜨겁게 만든다."

msgid "sn_dsc_0915"
msgstr "라이브 연출에 섞여 감옥 잠입에 성공한 알토.\\n무사히 셰릴을 감옥에서 데리고 나와 란카가 있는 라이브 무대로 보내주었다."

msgid "sn_dsc_0916"
msgstr "어둡고 차가운 감옥 벽에 무심히 가사를 써 내려가는 셰릴.\\n어떤 상황에서도 그녀는 가희로서의 자신을 버리지 않았다."

msgid "sn_dsc_0917"
msgstr "알토에게 구출된 셰릴은 무대 위에서 란카와 재회한다.\\n건네받은 마이크를 들고 그녀는 다시 노래하기로 결심했다."

msgid "sn_dsc_0918"
msgstr "감옥 침대에 누워 있던 셰릴.\\n하지만 밖에서 들려오는 노랫소리를 듣자 그녀도 조용히 따라 부르기 시작했다."

msgid "sn_dsc_0919"
msgstr "「Lovely Bomber」의 댄서로 라이브에 참가한 알토.\\n이 완벽한 여장 모습을 보면 누구도 그가 남자라는 것을 눈치채지 못할 것이다."

msgid "sn_dsc_0920"
msgstr "분위기는 최고조, 그곳에 있던 모든 사람들이 란카의 라이브에 시선을 빼앗겼다.\\n그리고 지금이야말로 감옥에 갇힌 셰릴을 구해낼 때다."

msgid "sn_dsc_0921"
msgstr "「Lovely Bomber」의 드러머로 라이브에 참가한 카나리아.\\n익숙한 솜씨로 스틱을 다루며 힘차게 연주를 이어가고 있다."

msgid "sn_dsc_0922"
msgstr "면회를 온 란카와 이야기를 나누는 셰릴.\\n하지만 그녀의 모습은 어두웠고, 시선 역시 어딘가 슬퍼 보였다."

msgid "sn_dsc_0923"
msgstr "음향 스태프로 변장한 루카가 셰릴 구출 타이밍을 엿보고 있다.\\n라이브가 최고조로 달아오르는 순간이 바로 결행의 때다."

msgid "sn_dsc_0924"
msgstr "모든 죄수가 란카의 위문 라이브를 볼 수 있는 것은 아니다.\\n보지 못하는 이들은 노래에 맞춰 숟가락을 두드리기 시작했다."

msgid "sn_dsc_0925"
msgstr "셰릴과 함께 노래함으로써 란카의 노래의 힘은 더욱 강해진다.\\n마치 마법이 깃든 듯한 귀여운 노랫소리가 듣는 모든 이의 마음을 환하게 만든다."

msgid "sn_dsc_0927"
msgstr "란카와 셰릴이 펼치는 하룻밤뿐인 특별 감옥 라이브.\\n죄수들은 크게 열광했고, 그 열기는 마침내 감옥 밖으로까지 넘쳐흘렀다."

msgid "sn_dsc_0928"
msgstr "반짝이고 눈부신 라이브 연출이 란카의 노래를 장식한다.\\n이렇게 모두의 시선을 사로잡는 것이 셰릴 구출 작전의 제1단계였다."

msgid "sn_dsc_0929"
msgstr "알토에게 구출된 셰릴과 무대 위에서 재회한 란카.\\n안심한 듯 미소 지으며, 함께 노래하기 위한 마이크를 내밀었다."

msgid "sn_dsc_0930"
msgstr "위문 라이브를 위해 알카트라즈를 찾은 란카.\\n엄청난 환호성으로 보아 그녀의 인기는 이 감옥 안까지 퍼진 듯하다."

msgid "sn_dsc_0931"
msgstr "「Lovely Bomber」의 기타리스트로 라이브에 참가한 미셸.\\n연주 실력도 그렇지만, 그 인물을 연상시키는 헤어스타일이 훌륭하다."

msgid "sn_dsc_0932"
msgstr "「Lovely Bomber」의 베이시스트로 라이브에 참가한 클랑.\\n외모는 어린아이지만, 커다란 베이스를 능숙하게 다루는 모습은 역시 대단하다."

msgid "sn_dsc_0933"
msgstr "「Lovely Bomber」의 키보디스트로 라이브에 참가한 미나.\\n뛰어난 두뇌로 알려진 그녀지만, 키보드 연주 역시 막힘없이 해낸다."

msgid "sn_dsc_0934"
msgstr "자신의 노래와 감정이 신비한 힘을 발현시킨다는 것을 이해한 란카.\\n그녀는 자신만의 방식으로 그 힘을 무언가에 도움이 되고 싶다고 생각했다."

msgid "sn_dsc_0935"
msgstr "라이브를 보고 있는 두 명의 젠트라디.\\n아무래도 뒤쪽에 있는 남자는 란카에 대해 자세히 알고 있는 모양이다."

msgid "sn_dsc_0936"
msgstr "셰릴이 갇혀 있는 감옥.\\n바다로 둘러싸인 섬이기 때문에 절대 탈옥할 수 없다고 알려져 있다."

msgid "sn_dsc_0937"
msgstr "퍼스널 컬러의 웨딩드레스를 입고 교회에서 조용히 때를 기다리는 카나메.\\n살짝 붉어진 뺨으로 미소 짓는 그녀의 손을 잡는 사람은 과연 누구일까."

msgid "sn_dsc_0939"
msgstr "카나메의 노래를 듣고 바르의 위협을 억제할 수 있었던 메서.\\n훗날 사신이라 불리게 될 남자는 자신의 안에 잠든 죽음의 공포에 맞서기로 결심했다."

msgid "sn_dsc_0940"
msgstr "어느 날 갑자기 나타난 미쿠모는 신비로운 노랫소리로 발키리의 에이스가 되었다.\\n그때 카나메의 마음속에는 아쉬움과 함께 리더로서의 기쁨이 싹트기 시작했다."

msgid "sn_dsc_0941"
msgstr "미쿠모를 구하기 위한 행동을 질책받고 근신 처분을 받은 발키리 멤버들.\\n초기 멤버인 카나메, 마키나, 레이나 세 사람은 그리운 과거의 기억을 이야기하기 시작한다."

msgid "sn_dsc_0942"
msgstr "미쿠모를 구하기 위한 행동을 질책받고 근신 처분을 받은 발키리 멤버들.\\n초기 멤버인 카나메, 마키나, 레이나 세 사람은 그리운 과거의 기억을 이야기하기 시작한다."

msgid "sn_dsc_0943"
msgstr "미쿠모를 구하기 위한 행동을 질책받고 근신 처분을 받은 발키리 멤버들.\\n초기 멤버인 카나메, 마키나, 레이나 세 사람은 그리운 과거의 기억을 이야기하기 시작한다."

msgid "sn_dsc_0944"
msgstr "제1회 오디션에 합격해 발키리에 합류한 두 사람.\\n함께 초기 발키리를 지탱했지만, 미쿠모가 합류하기 전에 탈퇴했다."

msgid "sn_dsc_0945"
msgstr "행성 알브헤임에서의 라이브를 마친 발키리.\\n전장을 바라보던 카나메의 눈앞을 부상을 입은 병사 한 명이 고통스러운 표정으로 지나갔다."

msgid "sn_dsc_0946"
msgstr "자신보다 몇 배나 큰 적이 다가오는 상황. 카나메는 아무것도 하지 못한 채 죽음을 각오한다.\\n하지만 이 상황은 훗날 델타 소대가 창설되는 계기가 된다."

msgid "sn_dsc_0947"
msgstr "근신 중인 카나메 일행에게 제공된 형편없는 식사.\\n한 사람이 먹는 양이라고 해도 결코 만족할 수 있는 수준은 아닐 것이다."

msgid "sn_dsc_0948"
msgstr "포기하지 않고 계속 노래한 보람이 있었는지, 마침내 발키리의 노래가 효과를 발휘하기 시작했다.\\n이것이 바르에 맞서기 위한 역사적인 첫걸음이 된 것이다."

msgid "sn_dsc_0949"
msgstr "퍼스널 컬러의 웨딩드레스를 입고 평소와 다른 모습을 보여주는 레이나.\\n격렬한 폭발과 신성한 빛이 쿨하기만 한 것이 아닌 그녀의 매력을 비춘다."

msgid "sn_dsc_0951"
msgstr "발키리는 창설 이후 여러 번 전장에 나가 활동 데이터를 축적해 왔다.\\n몇 번 적에게 습격당해도, 몇 번 격렬한 폭발에 휘말려도 그녀들은 계속 노래한다."

msgid "sn_dsc_0952"
msgstr "전장에서의 목숨을 건 활동은 어느새 발키리 안에 확고한 유대를 만들어냈다.\\n마키나와 레이나, 두 사람의 관계도 이때부터 가까워지기 시작한다."

msgid "sn_dsc_0953"
msgstr "원래 해커로 활동하던 레이나는 노래도 춤도 관심이 없었다.\\n당연히 레슨도 자주 빠졌고, 열성적인 마키나와는 도무지 맞지 않는 듯했다."

msgid "sn_dsc_0954"
msgstr "제1회 오디션 결과 리셉터 적성을 인정받아 발키리에 합류했다.\\n전장에서도 화려한 의상으로 노래하는 발키리의 스타일은 그녀의 손에서 탄생했다."

msgid "sn_dsc_0955"
msgstr "제1회 오디션 결과 리셉터 적성을 인정받아 발키리에 합류했다.\\n멤버 중 유일한 라그나인으로, 갈색 피부가 특징이다."

msgid "sn_dsc_0956"
msgstr "제1회 오디션 결과 리셉터 적성을 인정받아 발키리에 합류했다.\\n전장과는 어울리지 않는 아름다운 금발이 눈길을 끈다."

msgid "sn_dsc_0957"
msgstr "발키리가 노래를 마쳤을 때, 눈앞은 언제나 잔해의 산으로 변해 있었다.\\n그 풍경은 그녀들에게 자신들이 무력하다는 현실을 인정하지 않을 수 없게 만들었다."

msgid "sn_dsc_0958"
msgstr "전장의 굉음과 폭발의 불길은 아직 어린 그녀들에게 견디기 힘든 공포일 뿐이었다.\\n하지만 시시각각 변하는 상황은 귀를 막는 것조차 허락하지 않았다."

msgid "sn_dsc_0959"
msgstr "발키리가 실제로 진행했던 훈련 중 하나.\\n마치 강인한 병사들이 받는 것 같은 혹독한 내용이다."

msgid "sn_dsc_0960"
msgstr "전장에서 강대한 적과 맞설 때, 발키리는 결코 혼자가 아니다.\\n고난을 함께 극복할 때마다 그녀들은 조금씩 강해져 간다."

msgid "sn_dsc_0961"
msgstr "윈더미어의 정예 부대인 공중 기사단에는 젊고 뛰어난 파일럿들도 소속되어 있다.\\n정신적으로 미숙한 부분도 많지만, 그 젊음이 미래의 윈더미어를 지탱하는 힘이 될 것이다."

msgid "sn_dsc_0962"
msgstr "윈더미어 왕국 공중 기사단의 파일럿.\\n기사단 내에서 가장 어리며, 때때로 기세에 맡겨 행동하는 것이 단점이다."

msgid "sn_dsc_0963"
msgstr "과거 윈더미어에 투하된 차원 병기는 그곳에 사는 사람들을 대지와 함께 사라지게 만들었다.\\n보그는 그때 가족을 잃었기에 지구인에 대한 증오는 누구보다 강하다."

msgid "sn_dsc_0964"
msgstr "아버지 그라미아에게서 왕위를 이어받은 하인츠.\\n하지만 많은 국민들 앞에서 노래를 선보이는 그의 모습은 아직 왕이라 부르기에는 너무 어리다."

msgid "sn_dsc_0967"
msgstr "공중 기사단에서도 손꼽히는 거구의 소유자.\\n과거에는 사과 농사를 짓고 있었지만, 독립 전쟁 당시 그 밭을 잃었다."

msgid "sn_dsc_0968"
msgstr "공중 기사단의 일원이자 과거 보그의 스승이기도 했다.\\n노화가 진행되어 한때 은퇴했지만, 다시 최전선으로 복귀했다."

msgid "sn_dsc_0973"
msgstr "자극적인 간호사 의상과 의미심장한 연출로 관객을 매료시키는 셰릴.\\n그녀의 위험한 매력이 있기에 이 신비롭고 요염한 세계가 완성되는 것이다."

msgid "sn_dsc_0974"
msgstr "때로는 상냥하게, 때로는 도발적인 미소를 지으며 춤추는 간호사 차림의 셰릴.\\n어느 모습이 진짜 그녀인지 아는 사람은 아무도 없다."

msgid "sn_dsc_0975"
msgstr "이번 라이브에서는 간호사 의상과 웨딩드레스를 입은 셰릴이 등장한다.\\n성스러운 신부와 요염하게 미소 짓는 간호사. 서로 상반된 아름다움이 그곳에 있었다."

msgid "sn_dsc_0976"
msgstr "셰릴의 움직임에 맞춰 순백의 베일이 하늘하늘 춤춘다.\\n심플한 흰색 드레스가 은하의 요정의 매력을 한층 더 돋보이게 한다."

msgid "sn_dsc_0977"
msgstr "남장을 한 셰릴이 웨딩드레스를 입은 셰릴을 밀어 넘어뜨린다.\\n그 아름다움과 위험한 분위기에 많은 팬들이 매료될 것이다."

msgid "sn_dsc_0978"
msgstr "두 명의 셰릴이 서로 맞닿을 때마다 가시가 조금씩 부드러운 피부를 파고든다.\\n마침내 온몸을 휘감으면 유혹에서 벗어날 수 없게 된다."

msgid "sn_dsc_0979"
msgstr "간호사 의상을 입은 셰릴은 무대 위에서 화려한 춤을 선보인다.\\n결코 움직이기 편한 복장은 아닐 텐데도, 그녀의 움직임은 매우 매끄럽다."

msgid "sn_dsc_0980"
msgstr "가시에 묶인 신부가 무언가의 자극을 느끼고 뺨을 붉힌다.\\n그녀의 몸을 꿰뚫은 것은 고통일까, 아니면 쾌감일까. 상상력을 자극하지 않을 수 없다."

msgid "sn_dsc_0981"
msgstr "VF-25 시리즈에 장착할 수 있는 옵션 팩.\\nYF-29의 장비와 공통점이 많으며, 실제로 데이터 수집 등의 목적으로도 운용되고 있는 모양이다."

msgid "sn_dsc_0982"
msgstr "바주라의 체내에서 채취한 폴드 쿼츠.\\n셰릴의 노랫소리에 반응해 계속해서 명멸하고 있는 듯하다."

msgid "sn_dsc_0983"
msgstr "셰릴의 라이브를 위해 준비된 교회 스테이지.\\n아름다운 내부 장식까지 완벽하게 만들어져 있다."

msgid "sn_dsc_0984"
msgstr "이번 라이브에서 선보인 안무 중 하나.\\n손가락으로 프레임을 만드는 듯한 동작을 한 뒤, 그 손을 가슴 쪽으로 가져간다."

msgid "sn_dsc_0985"
msgstr "수많은 위기를 함께 극복해 온 발키리 5명.\\n프레이야의 마음이 만들어내는 따뜻한 룬의 빛이 그녀들을 희망찬 미래로 이끌어 간다."

msgid "sn_dsc_0986"
msgstr "성실한 성격 때문에 이런저런 걱정이 끊이지 않는 듯한 미라쥬.\\n그런 그녀의 은밀한 위안은 여자 기숙사의 애완동물인 큐루루와 교감하는 시간인 모양이다."

msgid "sn_dsc_0987"
msgstr "우연한 만남에 이끌리듯 델타 소대에 입대하게 된 하야테.\\n두 사람과 함께 만들어갈 미래 속에서 자신의 바람을 찾을 수 있을까."

msgid "sn_dsc_0988"
msgstr "훈련을 빼먹고 있는 하야테를 발견한 프레이야는 머리 위에서 그의 얼굴을 내려다본다.\\n맑은 하늘을 배경으로 한 그 미소는 마치 눈부시게 빛나는 태양처럼 보였다."

msgid "sn_dsc_0989"
msgstr "프레이야의 노래에 솔직한 감상을 말하는 하야테와 옆에서 쑥스러운 듯 웃는 프레이야.\\n「너, 웃으면 좀 기분 나쁘더라」―하야테"

msgid "sn_dsc_0990"
msgstr "반응탄 폭발에 휘말린 하야테를 미라쥬가 순간적인 판단으로 구해냈다.\\n솔직한 태도로 감사를 전하는 하야테. 뜻하지 않게 두 사람의 거리는 가까워지기 시작했다."

msgid "sn_dsc_0991"
msgstr "전쟁의 불길에 휩싸인 라그나를 보며 표정을 굳히는 프레이야.\\n하지만 생환한 하야테를 앞에 둔 때문인지, 그녀의 룬은 확실한 빛을 발하고 있었다."

msgid "sn_dsc_0992"
msgstr "델타 소대에 스카우트된 하야테의 능력에 대해 미라쥬에게 묻는 프레이야.\\n하야테에게 휘둘리기만 하던 미라쥬는 드물게 목소리를 높이며 대답했다."

msgid "sn_dsc_0993"
msgstr "마크로스 엘리시온의 머리 부분.\\n이곳이 사령실이며, 겉보기에는 노출된 것 같지만 강력한 배리어로 보호되고 있다."

msgid "sn_dsc_0994"
msgstr "여자 기숙사에서 키우는 갈매기.\\n야생 갈매기와는 달리, 어딘가 느긋한 표정이 특징이다."

msgid "sn_dsc_0995"
msgstr "행성 알 샤할에서 하야테는 처음으로 하늘을 날았다.\\n그때 그는 프레이야의 노래를 듣고, 분명히 불어오는 「바람」을 느끼고 있었다."

msgid "sn_dsc_0996"
msgstr "윈더미어의 침공이 행성 라그나까지 이어지고, 나아가 신통합군의 개입도 시작되었다.\\n이제 전장이 되어버린 라그나. 주민들의 신속한 대피가 시작된다."

msgid "sn_dsc_0997"
msgstr "수많은 위기를 함께 극복해 온 발키리 5명.\\n누구보다 동료를 생각하는 마키나가 있었기에 5명의 유대는 흔들리지 않는 것이 되었다."

msgid "sn_dsc_0999"
msgstr "처음에는 사이가 나빴던 레이나와 마키나도 지금은 발키리의 명콤비.\\n조금 지나치게 친밀한 것 아닌가 싶은 두 사람의 모습에 힘을 얻는 팬도 있다나 없다나…"

msgid "sn_dsc_1000"
msgstr "어두운 방 안에서 디스플레이의 빛을 받는 레이나.\\n천재 해커인 그녀에게는 이것이 마음 편하게 작업할 수 있는 환경일 것이다."

msgid "sn_dsc_1001"
msgstr "전장에서 위기에 빠진 마키나와 레이나를 순간적인 판단으로 구해낸 보그.\\n거친 말투로 본심을 숨기려 했지만, 룬의 빛까지 억누르지는 못한 모양이다."

msgid "sn_dsc_1002"
msgstr "최종 결전 중 마침내 마주하게 된 키스와 로이드.\\n어느새 서로 다른 길을 걷게 된 두 사람의 마음에 룬의 빛이 먼 옛날의 기억을 비춘다."

msgid "sn_dsc_1003"
msgstr "최종 결전 중 마침내 마주하게 된 키스와 로이드.\\n어느새 서로 다른 길을 걷게 된 두 사람의 마음에 룬의 빛이 먼 옛날의 기억을 비춘다."

msgid "sn_dsc_1004"
msgstr "격렬한 전투 속에서 형 키스의 존재를 느낀 하인츠.\\n어딘가 미묘한 거리를 두고 있던 형제의 마음도 룬의 빛이 이어준다."

msgid "sn_dsc_1005"
msgstr "윈더미어와의 최종 결전, 그 작전명은 라그나로크.\\n델타 소대원들도 가진 힘을 모두 쏟아부으며 싸우고 있다."

msgid "sn_dsc_1006"
msgstr "위기의 순간 보그에게 구출된 마키나와 레이나.\\n두 사람은 감사의 뜻을 전한 뒤 그대로 힘차게 노래를 이어갔다."

msgid "sn_dsc_1007"
msgstr "폭발에 휘말리기 직전, 키스와 로이드의 룬은 분명히 공명했다.\\n마지막 순간에 두 절친했던 남자는 진정으로 서로를 이해할 수 있었던 것인지도 모른다."

msgid "sn_dsc_1008"
msgstr "로이드의 지배 아래 놓인 Sv-262는 기체 색상이 흰색으로 변경되어 있었다.\\n하지만 그 흰색에는 어딘가 불길한 기운이 깃들어 있었고, 무기질적인 적의를 주변에 흩뿌리고 있었다."

msgid "sn_dsc_1009"
msgstr "석양을 배경으로 초원에 누운 바사라는 말을 거는 듯 구바바를 바라본다.\\n그 눈빛은 평온하지만, 그 안에 숨겨진 열정은 활활 타오르고 있었다."

msgid "sn_dsc_1011"
msgstr "우주선이라고 해도 마크로스 7의 시민들은 지구에서의 생활과 다르지 않은 나날을 보내고 있다.\\n날이 밝아오는 시티 7을 올려다보는 바사라. 눈부신 아침 햇살 속에서 그는 무엇을 생각하고 있을까."

msgid "sn_dsc_1012"
msgstr "황야를 조용히 걷는 바사라. 기타를 팔에 메고, 모래만 흩날리는 땅을\\n그저 곧게 계속 걸어간다. 그의 앞에 무엇이 있는지는 그 자신도 모를 것이다."

msgid "sn_dsc_1013"
msgstr "바사라와 비히다. 얼핏 보면 공통점이 없어 보이는 두 사람.\\n하지만 서로 쓸데없는 말은 하지 않는다는 점에서는 닮았을지도 모른다."

msgid "sn_dsc_1014"
msgstr "진정한 명곡이란 나이와 성별, 나아가 시대마저 넘어 계속 불려진다.\\n자신들이 연주하는 사운드도 그런 명곡이 되었으면 한다고 바사라는 말했다."

msgid "sn_dsc_1015"
msgstr "바사라의 생각을 모르는 밀레느는 발키리는 병기이며 싸우기 위한 것이라고 말한다.\\n그 말에 마침내 참을 수 없게 된 바사라는 분노를 숨기지 못했다."

msgid "sn_dsc_1016"
msgstr "세 번째 출격에서도 또 노래 도중 적이 도망쳐 만족하지 못하는 바사라.\\n하지만 그래도 바사라는 포기하지 않고, 다음에는 더 뜨거운 노래를 들려주겠다고 결심한다."

msgid "sn_dsc_1017"
msgstr "혼수상태에서 깨어난 바사라는 조명을 받은 파이어 발키리와\\n그 주변을 둘러싼 수많은 팬들에게 부활의 신호를 보냈다."

msgid "sn_dsc_1018"
msgstr "행성 락스의 석양을 바라보며 렉스와 단둘이 이야기를 나누는 바사라.\\n차분한 분위기에 조금 의식하는 렉스였지만, 바사라는 별다른 생각이 없는 듯하다."

msgid "sn_dsc_1019"
msgstr "일방적으로 공격받고 있는 감린을 구하기 위해 적과 맞서는 바사라.\\n하지만 갈등에 흔들리는 바사라의 손은 떨리고 있었다."

msgid "sn_dsc_1020"
msgstr "Fire Bomber의 신곡을 구상하는 바사라.\\n그 독특한 악보 작성 방식에 밀레느는 놀라움을 감추지 못했다."

msgid "sn_dsc_1021"
msgstr "석양을 배경으로 초원에 누운 밀레느는 말을 거는 듯 구바바를 바라본다.\\n아직 어린 티가 남은 눈빛 속에는 강렬하게 빛나는 열정이 배어 있다."

msgid "sn_dsc_1023"
msgstr "무대 위에서 바라보는 풍경에 생각에 잠기는 밀레느.\\n아직 14살의 어린 나이지만, 음악에 대해서만큼은 누구보다 진지한 자세로 임하고 있다."

msgid "sn_dsc_1024"
msgstr "사랑하는 딸을 전장에 보내지 않기 위해 사운드 포스에서 제외하라고 명령하는 맥스.\\n하지만 레이는 밀레느를 부대에 합류시켜야 한다고 주장했다."

msgid "sn_dsc_1025"
msgstr "어릴 때부터 언제나 함께해 온 밀레느와 구바바.\\n처음에는 좀처럼 마음을 열지 않았던 구바바도 이제는 감정을 공유할 정도로 가까운 사이가 되었다."

msgid "sn_dsc_1026"
msgstr "자신의 팬을 소중히 여기겠다고 다짐하며, 밀레느는 구바바 인형을 전해주러 갔다.\\n「앞으로도 내… 아니, Fire Bomber의 팬으로 있어줘」―밀레느"

msgid "sn_dsc_1027"
msgstr "빌리의 집에 있는 밀레느의 사진. 그것은 밀레느의 데뷔 라이브 사진이었다.\\n「내 사진… 이렇게 예쁘게 찍어줬구나」―밀레느"

msgid "sn_dsc_1028"
msgstr "거울을 본 밀레느는 문득 구바바에게 물었다.\\n「있잖아 구바바, 나 아빠랑 엄마 중 누구를 닮았다고 생각해?」―밀레느"

msgid "sn_dsc_1029"
msgstr "노래에는 숨겨진 힘이 있다고 믿으며 노래 연구를 하고 있는 닥터 치바.\\n그 실험 대상이 될 감린을 의자에 묶어두고 음흉한 미소를 짓고 있다."

msgid "sn_dsc_1030"
msgstr "한때 슬럼프에 빠졌던 그녀는 밀레느와 바사라의 노래를 듣고 컨디션을 되찾았다.\\n무대에 울려 퍼지는 노랫소리에는 이전보다 더욱 뜨거운 마음이 담겨 있었다."

msgid "sn_dsc_1031"
msgstr "납치된 밀레느를 찾던 중 갑자기 구바바의 눈이 빛나기 시작했다.\\n감각을 공유하는 구바바가 밀레느의 기척을 감지할 수 있는 모양이다."

msgid "sn_dsc_1032"
msgstr "팬 소년 빌리가 만든 손수 만든 구바바 인형.\\n특징을 잘 살렸지만, 구바바는 마음에 들지 않는 모양이다."

msgid "sn_dsc_1033"
msgstr "강제적인 맞선에서 시작했지만, 점차 가까워지는 밀레느와 감린.\\n하지만 여러모로 충돌하기 쉬운 바사라에 대해서도 그녀는 이해를 보이기 시작했다."

msgid "sn_dsc_1034"
msgstr "지너스 가문의 막내딸이자 사운드 포스의 일원. 부모에게 물려받은 조종 기술을 가지고 있다.\\n전용 발키리를 타고 노래하는 그 모습은 결코 바사라에게 뒤지지 않는다."

msgid "sn_dsc_1035"
msgstr "첫 전투에서 고민하고 있던 밀레느는 감정을 정리하지 못하는 듯했다.\\n그런 그녀에게 감린은 부적을 보여주며 미소 지었다."

msgid "sn_dsc_1036"
msgstr "밤거리를 걷는 두 남자. 그 이름은 넥키 바사라와 감린 키자키.\\n전혀 다른 삶을 살아온 두 사람이지만, 기묘한 운명이 그들의 시선을 마주치게 한다."

msgid "sn_dsc_1037"
msgstr "밀레느가 힘들게 구해 온 일에 납득하지 못하는 듯한 바사라.\\n그에 격렬하게 달려드는 밀레느. 그녀의 에너지 역시 상당하다."

msgid "sn_dsc_1040"
msgstr "바사라가 매번 전투 중에 노래하는 이유를 묻는 밀레느.\\n관객도 없는데 왜 노래하는지, 그녀에게는 그것이 의문인 듯하다."

msgid "sn_dsc_1045"
msgstr "미스 마크로스 우승 후 인기 아이돌이 된 민메이는 신곡 이미지 의상을\\n입고 노래한다. 군복 차림의 그녀는 평소와 달리 늠름한 분위기를 풍겼다."

msgid "sn_dsc_1046"
msgstr "특대 서로인 스테이크를 앞에 두고 환한 미소를 짓는 카키자키.\\n크게 입을 벌린 다음 순간, 무정하게도 스크램블 경보가 울려 퍼졌다."

msgid "sn_dsc_1047"
msgstr "조용히 앞으로 나아갈 곳을 바라보는 히카리. 그 눈에는 전장으로 향하는 자의 강한 의지가 깃들어 있었다.\\n「발키리 스컬 대대 23번기, 이치조 히카리, 출격합니다!」―히카리"

msgid "sn_dsc_1048"
msgstr "독단적으로 임무를 잠시 포기한 히카리는 미사에게 엄중한 주의를 받는다.\\n하지만 어떤 말도 지금의 히카리에게는 닿지 않는 듯하다."

msgid "sn_dsc_1049"
msgstr "군대에 들어가고 포커는 변해버렸다… 그렇게 생각하던 순간, 앞서 가는 여자아이에게\\n시선을 빼앗긴 그의 모습을 보고 히카리는 그런 부분은 변하지 않았다고 어이없어했다."

msgid "sn_dsc_1050"
msgstr "예정된 진로를 바꾸고 아직 테스트도 끝나지 않은 폴드 시스템을 사용하라고\\n명령하는 함장. 이 판단은 마크로스의 미래를 크게 바꾸게 된다."

msgid "sn_dsc_1051"
msgstr "포커와 함께 아침까지 있었다는 것을 지적받지만, 전혀 신경 쓰지 않는 듯한 클로디아.\\n「아침 귀가? 임무에는 전혀 영향 없답니다!」―클로디아"

msgid "sn_dsc_1052"
msgstr "브리지 오퍼레이터인 바네사, 킴, 샤미.\\n수다를 많이 떠는 세 사람이지만, 마크로스의 제어에는 그녀들의 힘이 반드시 필요하다."

msgid "sn_dsc_1053"
msgstr "우연히 발견한 에너지로 개발된 핀포인트 배리어.\\n그 힘은 막강하지만 범위가 좁아 조종사의 실력이 시험받는 긴장된 순간이다."

msgid "sn_dsc_1054"
msgstr "최신형 전투기 발키리를 앞에 두고 대화하는 히카리와 포커.\\n그 후 기다리고 있을 운명을 지금은 아무도 알지 못한다."

msgid "sn_dsc_1055"
msgstr "외계인과의 전투를 끝내고 마침내 휴식 시간이 찾아왔다.\\n브리지에서도 커피는 역시 휴식의 단골 메뉴다."

msgid "sn_dsc_1056"
msgstr "발키리를 변형시켜 포커와의 충돌 회피를 시도하는 히카리.\\n하지만 첫 조종으로는 추락을 피할 수 없는 듯하다."

msgid "sn_dsc_1057"
msgstr "때로 란카에게 엄격하게 대하는 것도 그녀의 가슴속에 프로로서의 혼이 있기 때문이다.\\n그런 그녀이기에 은하를 뒤흔드는 노래를 만들어낼 수 있는지도 모른다."

msgid "sn_dsc_1058"
msgstr "신통합정부의 움직임에 기대할 수 없는 지금, 그레이스 일행의 계획을 막기 위해 각오를 다진다.\\n「우리가 할 수밖에 없네. 따라와 주겠나, 모니카 군?」―제프리"

msgid "sn_dsc_1059"
msgstr "『은하의 요정』셰릴과 『초시공 신데렐라』란카.\\n정반대인 두 사람이지만 마음은 하나. 그녀들의 노랫소리는 머지않아 은하를 구할 힘이 된다."

msgid "sn_dsc_1060"
msgstr "어쩌다 보니 「라이온」을 부르게 된 클랑. 노래에는 마음을 전하는 힘이 있다고\\n하며, 클랑도 마음을 담아 노래하기 시작한다. 전하고 싶은 상대는 물론…"

msgid "sn_dsc_1061"
msgstr "이제 미련은 없다. 셰릴의 시선은 곧장 자신의 전장으로 향하고 있었다.\\n은하의 요정이 부르는 결의의 노래는 바주라에게, 은하에게 닿을 수 있을까."

msgid "sn_dsc_1062"
msgstr "부적으로 자신의 귀걸이를 알토에게 맡기며, 돌아오겠다는 약속을 하는 셰릴.\\n「반드시 돌아와. 알겠지? 알토」―셰릴"

msgid "sn_dsc_1063"
msgstr "최종 결전의 전장. 그곳이야말로 셰릴의 마지막 무대였다.\\n「지금 내게 있는 건 음악과, 그리고 나 자신. 그러니 내 노래를 들어라ー!」―셰릴"

msgid "sn_dsc_1064"
msgstr "기체를 잃은 알토에게 VF-25F를 가져다주는 클랑과 루카.\\n아머드 팩을 장착하고 돌아온 알토의 날개는 인류의 희망이 될 것이다."

msgid "sn_dsc_1065"
msgstr "지금까지 일어난 사건의 진상을 이야기하는 함장에게 동요를 감추지 못하는 레온.\\n「우리는 춤춰지고 있었던 거다. 놈들의 음모와 거기에 가담한 자들에 의해서!」―제프리"

msgid "sn_dsc_1066"
msgstr "제117차 대규모 조사 선단에 남겨진 사진.\\n그것은 셰릴의 어머니가 할머니 마오 놈에게 보낸 것이었다."

msgid "sn_dsc_1067"
msgstr "갤럭시 함대에 점령당한 바즈라 여왕의 모습. 그 강력한 네트워크는\\n전 우주의 바즈라를 팔다리로 삼아 은하계 전역의 행성을 공격했다."

msgid "sn_dsc_1068"
msgstr "V형 감염증의 증상이 적힌 진료 기록.\\n셰릴에게 그것은 자신의 죽음이 가까워졌다는 선고에 불과했다."

msgid "sn_dsc_1069"
msgstr "셰릴에게 이끌려 『초시공 신데렐라』로 향하는 계단을 올라가는 란카.\\n그녀의 노래는 아직 미숙하지만 힘과 빛이 있다. 그것이 바로 그녀의 매력이다."

msgid "sn_dsc_1070"
msgstr "동경과 노래에 대한 마음을 원동력으로 삼아 톱 아이돌을 목표로 꿈을 쫓아온 란카.\\n넘치는 에너지는 꿈을 이룬 뒤에도 다하지 않고 새로운 세계로 계속 퍼져 나가고 있다."

msgid "sn_dsc_1071"
msgstr "절망적인 상황 속에서도 계속 노래하는 셰릴과 란카. 가슴 깊은 곳에 있는 것은 노래를 전하고 싶다는\\n마음. 포기하지 않고 희망을 믿는 두 사람의 노래는 은하를 구할 수 있을까."

msgid "sn_dsc_1072"
msgstr "바주라를 장악한 그레이스의 위치를 알려주는 브레라.\\n「알토, 머리를 노려라. 바주라의 심장은 머리가 아니라 배에 있다」―브레라"

msgid "sn_dsc_1073"
msgstr "힘이 다해 모든 것을 포기하려는 셰릴의 뺨을 때린 란카.\\n셰릴이 없었다면 지금의 자신은 없었다. 그 마음을 전하기 위해서였다."

msgid "sn_dsc_1074"
msgstr "자신이 누구를 위해 노래하고 싶은 것인지 깨달은 란카는 모두가 아닌,\\n단 한 사람, 알토를 향해 노래하기로 결심했다."

msgid "sn_dsc_1075"
msgstr "달려오는 아이 군에게 노래가 전해졌다고 알려주는 란카.\\n바주라에게도 마음이 있고, 서로의 마음이 통했다는 사실을 기쁜 듯 이야기했다."

msgid "sn_dsc_1076"
msgstr "스컬 소대로 돌아온 오즈마. 그가 없으면 작전은 시작할 수 없다.\\n「전 기체 간다. 돌격 러브하트!」―오즈마"

msgid "sn_dsc_1077"
msgstr "어머니 란셰 메이에게 배운 『아이모』를 부르는 란카.\\n그녀의 눈앞에 바주라들이 나타났다. 모든 이야기는 여기서부터 시작되었다."

msgid "sn_dsc_1078"
msgstr "클랑과 루카가 가져다준 자신의 기체―VF-25F.\\n다시 돌아온 날개를 두르고, 알토는 최종 결전의 전장으로 달려간다."

msgid "sn_dsc_1079"
msgstr "갤럭시의 공격으로부터 프론티어 선단을 지켜준 바주라들.\\n그 행동은 란카와 셰릴의 노래가 전해졌다는 증거였다."

msgid "sn_dsc_1080"
msgstr "아이 군을 바주라의 모성으로 돌려보내기 위해 떠나는 란카와 브레라.\\n하지만 란카의 마음과는 달리 바주라들은 공격 태세에 들어갔다."

msgid "sn_dsc_1081"
msgstr "평소에는 발키리의 리더로서 모두를 챙기고 이끄느라 고생하는 그녀도\\n바다에 가면 천진난만하게 들뜬다. 태양 아래 빛나는 모습은 마치 두 번째 태양과 같다."

msgid "sn_dsc_1083"
msgstr "점점 성과를 내기 시작한 발키리에게 앞으로의 방침을 제안하는 아라드 대장. 델타 소대\\n와의 연계 등, 발키리를 진지하게 생각하는 그의 모습에서 희망의 빛을 본다."

msgid "sn_dsc_1084"
msgstr "귀여운 수영복의 영향으로 평소보다 더욱 빛나는 룬. 지금이라면 더욱 강력한 빔…\\n더욱 강력한 룬피카 빔・서머 버전을 발사할 수 있을지도 모른다."

msgid "sn_dsc_1085"
msgstr "하야테와 프레이야의 환영회에서 건배하는 메서. 어울려 노는 것을 좋아하지 않는 듯한\\n메서지만, 특별히 싫어하는 모습은 아닌 듯하다."

msgid "sn_dsc_1086"
msgstr "하야테와 프레이야의 환영회에서 건배 전에 인사하는 어네스트 함장.\\n그의 이야기는 너무 길어서, 모인 사람들은 질린 표정을 짓고 있다."

msgid "sn_dsc_1087"
msgstr "하야테는 축제에 연인끼리 온 사람들이 많다는 것을 깨닫고 척에게 시선을 돌렸다.\\n「해파리 축제는 연인들의 축제라는 거지」―척"

msgid "sn_dsc_1088"
msgstr "델타 소대에 입대한 하야테와 발키리가 된 프레이야.\\n아직 미숙한 두 사람은 이상과 현실의 차이에 고전하고 있는 듯하다."

msgid "sn_dsc_1089"
msgstr "라그나의 대규모 이벤트, 해파리 축제.\\n많은 사람들로 붐비는 이 축제에는 다양한 노점들이 늘어서 있다."

msgid "sn_dsc_1090"
msgstr "카나메가 카페에서 마시던 주스.\\n무엇이 들어 있었는지는 수수께끼다."

msgid "sn_dsc_1091"
msgstr "인기 요리점・라쿠구 냥냥이 드디어 출장 영업을 개시했다!\\n명물・해파리 만두를 판매하고 있다."

msgid "sn_dsc_1092"
msgstr "하야테를 도발하는 갈매기.\\n바닷속으로 재빠르게 도망치는 움직임은 하야테뿐만 아니라 라그나인인 척 형제들까지 애를 먹을 정도다."

msgid "sn_dsc_1093"
msgstr "발키리 멤버들과 함께 바다에서 노는 미쿠모. 『동료와 함께 논다』는 경험이\\n거의 없었던 그녀는 어딘가 천진난만한 미소를 짓고 있었다."

msgid "sn_dsc_1095"
msgstr "갈매기를 잡으려는 하야테. 하지만 그는 고양이 알레르기가 있어서,\\n재채기로 틈을 보이는 바람에 이번에도 농락당하고 말았다."

msgid "sn_dsc_1096"
msgstr "비치볼을 들고 있는 메서. 아무래도 파일럿들에게 권유받은 모양이다.\\n처음에는 내키지 않아 했지만, 해 질 무렵에는 부드러운 미소를 띠고 있었다."

msgid "sn_dsc_1097"
msgstr "아라드와 업무 보고를 하는 카나메지만, 이야기를 듣지 못하는 제3자에게는\\n왠지 사적인 대화처럼 보인다. 이렇게 소문은 퍼져 나간다…"

msgid "sn_dsc_1098"
msgstr "드디어 델타 소대의 기대받는 신입으로 입대한 하야테. 아직 미숙한 언행도 있지만,\\n근본적으로 올곧은 점은 진짜이며 앞으로의 성장이 기대된다."

msgid "sn_dsc_1099"
msgstr "레이나의 어른스러운 발언을 듣고 얼굴을 붉히는 프레이야.\\n프레이야는 어른스러운 이야기에 익숙하지 않은 것을 보면 아직 정신적으로는 어린아이 같은 모양이다."

msgid "sn_dsc_1100"
msgstr "음식값을 내지 않고 도망친 갈매기가 하야테에게 날린 강력한 일격.\\n델타 소대에 들어오자마자 운이 따라주지 않는 하야테였다."

msgid "sn_dsc_1101"
msgstr "프레이야가 오디션에서 떨어지는 모습을 보러 왔다고 놀리는 하야테.\\n그 말에 분함을 느낀 프레이야는 더욱 힘을 내기로 한다."

msgid "sn_dsc_1102"
msgstr "해파리 축제에서는 어디를 봐도 커플들이 걸어 다닌다.\\n그럴 만도 한 것이, 해파리 축제에는 사랑이 이루어진다는 전설이 있기 때문이다."

msgid "sn_dsc_1103"
msgstr "라그나의 문화에는 해파리와 바다를 상징하는 것이 많다.\\n악기에 조개껍데기 등이 사용되는 것도 숭배의 표현일지도 모른다."

msgid "sn_dsc_1104"
msgstr "라그나 명물인 해파리. 회나 말린 해파리 등 다양한 요리에 사용된다.\\n델타 소대의 아라드는 해파리 안주를 가지고 다니는 모양이다."

msgid "sn_dsc_1105"
msgstr "여성진에 맞서 수영복으로 갈아입은 파일럿들. 남자들끼리 노는 모습에는 화려함은 없지만,\\n평소 전투로 바쁜 소대원들도 이번만큼은 휴식을 만끽하는 듯하다."

msgid "sn_dsc_1106"
msgstr "팀의 분위기 메이커이자 익살꾼. 평소에는 라쿠구 냥냥의 요리사를 하고 있다.\\n소대에서는 조기경계관제・전자전을 담당하며 델타 소대를 지원하는 것이 임무다."

msgid "sn_dsc_1107"
msgstr "오늘이야말로! 라며 갈매기 포획에 힘쓰는 척 일행. 하지만 영리한 갈매기는\\n틈을 노려 백턴으로 피해버린다. 잡을 수 있는 날은 아직 멀어 보인다…"

msgid "sn_dsc_1108"
msgstr "척의 동생들인 핵과 잭, 엘리자베스. 머리를 하나로 묶은 아이가 핵,\\n그렇지 않은 아이가 잭이며, 앞쪽에 있는 엘리자베스는 「키랏」을 좋아하는 모양이다."

msgid "sn_dsc_1110"
msgstr "하야테와 프레이야의 환영회에서 요리를 나르는 척과 핵.\\n요리 내용은 맡겨져 있으며, 시험 제작 중인 요리가 나오는 경우도 있는 모양이다."

msgid "sn_dsc_1111"
msgstr "갈매기 포획에 실패하고 저녁 식사를 빼앗긴 것을 한탄하는 마키나.\\n「아앙! 내 디너가ー」―마키나"

msgid "sn_dsc_1117"
msgstr "조개껍데기를 모티브로 한 귀여운 수영복을 입은 민메이. 사랑에 빠지고 싶은 나이의 그녀는,\\n특별한 사람에게 시선을 향한다. 그 눈동자는 무언가를 기대하는 듯 보였다."

msgid "sn_dsc_1118"
msgstr "토성에 가보고 싶다는 민메이의 소원을 이루어준 히카리. 최근 스캔들로\\n힘들어하던 그녀에게 히카리는 어둠 속에서 구해준 왕자님처럼 보였다."

msgid "sn_dsc_1119"
msgstr "순백의 수영복을 입고 바닷속에서 노래하는 민메이. 그 노랫소리는 바다 전체에 울려 퍼져,\\n생물들까지 매료시킨다. 다가온 물고기와 교감하는 모습은 마치 인어와 같다."

msgid "sn_dsc_1120"
msgstr "발키리와 같은 붉은 수영복을 입은 미리아. 여름 바다에 설레는 모습은\\n평소 그녀에게서는 상상하기 어렵지만, 옆의 맥스는 놓칠 생각이 없는 듯하다."

msgid "sn_dsc_1121"
msgstr "피곤하다는 민메이에게 눈앞의 호텔에서 쉬자고 제안하는 히카리.\\n호텔 이름을 본 민메이는 히카리를 의심스러운 눈으로 바라보지만, 그는 눈치채지 못한 듯하다."

msgid "sn_dsc_1122"
msgstr "미사와 카이훈에게 발키리를 무단으로 사용한 것이 들켜 비난받는 히카리.\\n하지만 벌을 받을 각오를 하고 있었기 때문인지, 순순히 귀환 명령에 따랐다."

msgid "sn_dsc_1123"
msgstr "창문에 비친 토성을 보고 감탄하는 민메이. 그녀의 눈동자는 반짝반짝 빛났고,\\n히카리는 토성에 가고 싶다는 그녀의 소원을 이루어주기로 결심했다."

msgid "sn_dsc_1124"
msgstr "토성 데이트 중 히카리는 민메이를 위해 특별한 풍경을 보여주었다.\\n「와, 멋지다」 「토성의 무지개야」―민메이, 히카리"

msgid "sn_dsc_1125"
msgstr "데이트 중 민메이에게 휘둘리는 히카리.\\n힘들어 보이지만, 그 자신도 싫지는 않은 듯하다."

msgid "sn_dsc_1126"
msgstr "히카리가 민메이와 토성 데이트를 하기 위해 무단 사용한 기체.\\n훈련용 발키리라서 무기 등은 탑재되어 있지 않다."

msgid "sn_dsc_1127"
msgstr "히카리와 민메이가 데이트 중 보게 된 공연 예술.\\n일본도로 종이를 순간적으로 베는 모습은 그야말로 전통 예술이라 부르기에 어울린다."

msgid "sn_dsc_1128"
msgstr "지구로 돌아온 마크로스.\\n바다에서 바라본 석양은 마치 「어서 와」라고 말하는 듯 빛나고 있었다."

msgid "sn_dsc_1129"
msgstr "평소에는 어른스러운 척하는 밀레느도 바다에 오면 나이에 맞게 들뜨기 시작한다.\\n그 활기는 라이브에도 영향을 주어, 평소보다 더욱 빛나는 노랫소리가 울려 퍼질 것이다."

msgid "sn_dsc_1130"
msgstr "마크로스 7 선단을 무사히 도망치게 하기 위해 스스로 적 전함에 특공해 희생한 킨류 대위.\\n상관이자 전우였던 대위를 생각하며 감린은 미리아와 함께 경례를 보냈다."

msgid "sn_dsc_1131"
msgstr "영하의 공간에 갇힌 바사라와 밀레느는 갇히게 된 원인에 대해\\n말다툼을 시작한다. 하지만 그 사이에도 기온은 계속 내려가고 있었고, 싸울 시간이 없다는 것을 깨닫는다."

msgid "sn_dsc_1132"
msgstr "감린과 밀레느의 첫 데이트를 지켜보는 마이클. 시선은 밀레느의 수영복에 고정되어 있다.\\n「이야ー아가씨의 수영복 차림이 또 정말 말로 표현할 수 없을 만큼…」―마이클"

msgid "sn_dsc_1133"
msgstr "영하의 공간에서 탈출한 바사라와 밀레느.\\n갇혔던 일을 웃음거리로 이야기하는 두 사람을 보며 레이의 표정도 온화해졌다."

msgid "sn_dsc_1134"
msgstr "감린이 말한 전투에서 방해되는 녀석이 바사라라는 것을 알아챈 밀레느.\\n평소 쌓여 있던 바사라에 대한 불만을 폭발시켰다."

msgid "sn_dsc_1135"
msgstr "전투에서 다친 팔을 걱정하는 밀레느에게 감린은 부드럽게 미소 지었다.\\n「이 정도는 다쳤다고 할 수도 없습니다」―감린"

msgid "sn_dsc_1136"
msgstr "대피 시간에 맞추지 못한 바사라와 밀레느는 영하의 공간에 갇혀버린다.\\n「안 돼, 갇혀버렸잖아」―바사라"

msgid "sn_dsc_1137"
msgstr "바로타 군의 습격으로 긴급 대피 경보가 울려 퍼진다.\\n관광객으로 붐비던 해변은 순식간에 지옥으로 변했다."

msgid "sn_dsc_1138"
msgstr "수상 스키를 즐기는 밀레느.\\n그 미소는 지금까지의 피로가 모두 날아간 듯 상쾌했다."

msgid "sn_dsc_1139"
msgstr "리비에라에서 휴가를 만끽하는 사람들.\\n리조트 함선답게 휴일을 보내는 관광객들로 붐비고 있다."

msgid "sn_dsc_1140"
msgstr "공간 장치가 파괴되어 영하 4℃ 이하의 세계가 되어버린 리비에라.\\n리조트 함선이었던 흔적은 사라지고, 주변은 온통 얼어붙어 있다."

msgid "sn_dsc_1141"
msgstr "바다에서도 쿨한 레이나지만, 오늘은 어딘가 즐거워 보이는 표정을 짓고 있다.\\n마키나와 함께라서인지, 휴가를 즐기고 있어서인지… 분명 둘 다일 것이다."

msgid "sn_dsc_1143"
msgstr "처음에는 비치발리볼에 당황하던 감린이었지만, 해 질 때까지 열심히 계속하고 있다.\\n놀이일지라도 진지하게 임하는 모습은 정말 그다운 모습이라 할 수 있다."

msgid "sn_dsc_1144"
msgstr "해변에 누워 있는 렉스. 뛰어난 몸매를 가진 그녀는 수많은 남자들을 매료시킨다.\\n어른의 매력으로 유혹하는 그녀의 눈빛은 강렬하게 빛나고 있다."

msgid "sn_dsc_1145"
msgstr "하야테와 프레이야의 환영회에서 건배하는 카나메와 아라드.\\n신입의 입대는 물론이고, 두 사람은 분명 연회 자체도 기대하고 있었을 것이다."

msgid "sn_dsc_1146"
msgstr "하야테와 프레이야의 환영회에서 건배하는 레이나와 미라쥬.\\n평소 표정 변화가 없는 레이나는 그렇다 쳐도, 오늘 밤 미라쥬도 험한 표정을 짓고 있다."

msgid "sn_dsc_1147"
msgstr "휴가에 관심 없는 바사라는 구바바와 함께 낮잠 시간.\\n모두가 바다를 즐기는 가운데 혼자 방에서 편히 쉬는 모습은 그야말로 자유인이다."

msgid "sn_dsc_1148"
msgstr "휴가 중에도 마이클과 함께 행동해야 한다는 것에 불만인 밀레느.\\n「알겠어? 경비를 핑계로 나를 감시하기만 해봐, 가만 안 둘 거니까!」―밀레느"

msgid "sn_dsc_1149"
msgstr "오늘도 역시 갈매기와의 싸움에서 패배한 하야테와 척.\\n지쳐 쓰러진 두 사람을 옆에 두고 핵과 잭은 신나게 놀고 있다."

msgid "sn_dsc_1150"
msgstr "Fire Bomber를 기다리고 있던 것은 미리아의 비서 마이클.\\n그럴 만도 한 것이, 이번 일은 미리아가 소개한 일이기 때문이다."

msgid "sn_dsc_1151"
msgstr "라그나라고 하면 명물 해파리!\\n말린 해파리, 절인 해파리, 생 해파리… 모두 맛있어 보인다."

msgid "sn_dsc_1152"
msgstr "인공이라 해도 바다는 바다. 반짝이는 바다를 눈앞에 두면\\n저절로 들뜨는 것도 어쩔 수 없는 일일 것이다."

msgid "sn_dsc_1153"
msgstr "란카와 같은 작업복풍 의상을 입은 셰릴. 작업복풍이라고 해도,\\n가슴을 강조하는 디자인인 것은 매력적인 그녀만의 고집이다."

msgid "sn_dsc_1155"
msgstr "무대에 선 셰릴은 관객은 물론 라이브 세트까지 매료시킨다.\\n그녀가 만지자 하트가 튀어나오는 모습은 마치 그녀에게 사랑에 빠진 것 같다."

msgid "sn_dsc_1156"
msgstr "우뚝 솟은 무대 위에서 공구를 손에 든 셰릴은 목표를 겨눈다.\\n그녀가 날리는 일격으로 꿰뚫리는 것은 심장이 아니라 사람들의 마음이다."

msgid "sn_dsc_1157"
msgstr "크레인에 올라탄 셰릴은 무대 위로 올라간다.\\n수많은 무대를 경험한 그녀는 두려워하지 않고 당당한 모습을 보인다."

msgid "sn_dsc_1158"
msgstr "라이브 중 셰릴은 살며시 눈을 감고 귀를 기울였다.\\n모두의 생명이 만들어내는 음악을 듣기 위해서."

msgid "sn_dsc_1159"
msgstr "전장에서 노랫소리를 들었다고 말하는 알토. 그리고 자신의 곡을 부르는 란카.\\n두 사람을 향해 셰릴의 입에서 흘러나온 것은 말이 아니라 경쾌한 듯한 노랫소리였다."

msgid "sn_dsc_1160"
msgstr "셰릴의 압도적인 무대에 무대 뒤에서 지켜보던 알토 일행도 감탄의 목소리를 흘린다.\\n「대단해…」 「은하의 요정…」─루카, 미셸"

msgid "sn_dsc_1161"
msgstr "셰릴과 란카, 두 명의 가희는 서로의 노력을 칭찬한 뒤,\\n어깨를 나란히 하고 새로운 무대를 향해 나아간다."

msgid "sn_dsc_1162"
msgstr "바주라가 몰려드는 가운데 전 함선 라이브 중계를 강행하는 스태프들.\\n셰릴이 목숨을 걸고 노래하듯, 그들도 일에 목숨을 걸고 있다."

msgid "sn_dsc_1163"
msgstr "수면 위로 떠오른 배 모양의 무대.\\n여러 겹의 서치라이트가 비추는 환상적인 라이브 장소다."

msgid "sn_dsc_1164"
msgstr "아일랜드 1 최대의 콘서트홀, 성도관.\\n객석은 셰릴의 라이브를 기다리는 관객들로 가장 위층까지 가득 차 있다."

msgid "sn_dsc_1165"
msgstr "셰릴과 같은 작업복풍 의상을 입은 란카. 과감하게 열린 상의 사이로 보이는\\n건강한 피부가 눈부신 그녀는 오늘도 활기차게 무대를 누빈다."

msgid "sn_dsc_1167"
msgstr "모두에게 미소를 전하기 위해 무대 위에서도 활기 넘치는 란카.\\n밤하늘에 빛나는 샛별 같은 미소를 보여주는 그녀에게 빠지지 않을 사람은 없다."

msgid "sn_dsc_1168"
msgstr "신곡에 사용할 라이브 무대를 설치하는 란카.\\n마스크와 고글을 착용한 그녀에게는 평소와 다른 늠름한 매력이 풍긴다."

msgid "sn_dsc_1169"
msgstr "작업을 마치고 그 장소를 떠나는 란카. 팬들의 응원에 답하면서도\\n빠르고 정확한 움직임으로 다음 장소로 향하는 모습은 일류 장인을 떠올리게 한다."

msgid "sn_dsc_1170"
msgstr "높이 세워진 난간 없는 발판 위에서 가볍게 노래하고 춤추는 란카.\\n그녀들에게 높은 곳에서 노래하는 것은 특기 중 하나다."

msgid "sn_dsc_1171"
msgstr "노래와 춤으로 알토에게 다가가는 셰릴에 맞서 란카도 지지 않고 노래하기 시작한다.\\n소심했던 그녀의 모습은 이미 그곳에 없었다."

msgid "sn_dsc_1172"
msgstr "레온의 음모로 생명줄이 끊겨 우주 공간으로 내던져진 루카.\\n그 위기에 달려와 루카를 구한 것은 EX-기어를 입은 미셸이었다."

msgid "sn_dsc_1173"
msgstr "습격해 오는 바주라와 싸우는 S.M.S 소대.\\n평소 온화한 보비도 승리를 위해 분투하며 적을 격침시킨다."

msgid "sn_dsc_1174"
msgstr "알카트라즈에서 위문 라이브가 개최되었을 때, 란카의 친필 사인을 받은 소장 일행.\\n평소에는 강인한 죄수들을 상대하는 그들도, 이 순간만큼은 미소를 지었다."

msgid "sn_dsc_1175"
msgstr "아틀란티스 돔에서 열린 란카의 첫 라이브.\\n관객들의 대합창도 라이브 연출로 더해져, 꿈과 마법의 무대가 만들어져 간다."

msgid "sn_dsc_1176"
msgstr "알카트라즈에서 급하게 개최된 란카의 위문 라이브.\\n뜻밖의 가희 방문에 죄수들은 열광했다."

msgid "sn_dsc_1177"
msgstr "알록달록한 페인트를 들고 미소 짓는 셰릴과 란카.\\n반짝반짝 빛나는 발키리 VF-25F를 뒤로하고 무언가를 꾸미고 있는 듯한데…"

msgid "sn_dsc_1178"
msgstr "VF-25F에 『은하의 요정』셰릴 놈과 『초시공 신데렐라』란카 리의\\n그림을 입힌 기체. 두 가희를 태운 날개는 은하 끝까지 닿을 듯하다."

msgid "sn_dsc_1179"
msgstr "딥 아키바 캠페인에서 발키리로 분장해 노래하는 란카.\\n관객들의 열기에 당황하면서도 미소를 보내는 모습에서 프로로서의 면모가 보인다."

msgid "sn_dsc_1180"
msgstr "빛나는 땀은 노력의 증거, 한 걸음씩 스타를 향한 길을 걸어가는 란카.\\n같은 소속사 선배인 도쿠가와 키이치로의 주먹에도 힘이 들어간다."

msgid "sn_dsc_1183"
msgstr "종이비행기가 날아오르는 것을 지켜본 알토는 재빨리 바람을 읽는다.\\n「…북북서풍, 초속 4미터…」─알토"

msgid "sn_dsc_1184"
msgstr "알토와 미셸은 여전히 사소한 일로 말다툼을 시작한다.\\n「성장하지 않는 꼬맹이들 같으니」─클랑"

msgid "sn_dsc_1189"
msgstr "나비처럼 요염한 춤과 별가루를 날개에 두른 듯한 빛으로 그녀는 세상을 매료시킨다.\\n이 세상의 빛나는 모든 것, 나아가 별들조차 그녀의 포로가 된 듯하다."

msgid "sn_dsc_1191"
msgstr "그녀가 아무렇지 않게 뒤돌아보았을 때 보인 입술에, 수많은 관객은 숨을 삼킨다.\\n요염함을 두른 작은 악마 같은 몸짓에 넋을 잃는 순간, 이미 그녀의 포로가 되어버린 것이다."

msgid "sn_dsc_1192"
msgstr "푸른 하늘 아래 쏟아지는 햇살 속에서 이쪽을 바라보는 그녀의 눈동자는,\\n태양보다 눈부시게 반짝인다. 그 빛 앞에서는 누구라도 눈이 멀고 말 것이다."

msgid "sn_dsc_1193"
msgstr "설령 모든 것을 바친다고 해도 그녀를 만족시킬 수는 없을 것이다.\\n끝없이 반복되는 그녀의 욕망에 계속 응해줄 수 있는 사람이 과연 존재할까."

msgid "sn_dsc_1194"
msgstr "유혹하는 그녀의 손끝에 이끌려 그녀를 원하게 된다면, 그녀는\\n그 이상의 것을 요구할 것이다. 그리고 그것은 점점 더 심해져 갈 것이다."

msgid "sn_dsc_1195"
msgstr "라이브 중 한순간 비춰진 셰릴의 영상. 짧은 순간이었지만,\\n향기가 피어오르는 듯한 아름다움과 빛이 관객들에게 그녀의 이미지를 강렬하게 새겼다."

msgid "sn_dsc_1196"
msgstr "셰릴의 이어링에 닿은 순간, 그녀의 마음을 엿본 알토.\\n자신의 잘못을 깨달은 알토는 그 마음을 전하기 위해 다시 셰릴 앞에 나타났다."

msgid "sn_dsc_1197"
msgstr "노래하기 위해 살아간다는 셰릴은 자신을 무대라는 마물에 사로잡힌 포로라고 말한다.\\n열광하는 관객과 그 거대한 흐름에 취함으로써, 그녀의 정신은 은하 저편으로 날아오른다."

msgid "sn_dsc_1198"
msgstr "셰릴이 머무는 호텔의 욕실.\\n넓은 실내에는 관엽식물도 놓여 있어, 호화로운 인테리어의 일부를 엿볼 수 있다."

msgid "sn_dsc_1199"
msgstr "셰릴의 라이브가 고조될수록 시시각각 변화하는 무대.\\n수많은 톱니바퀴로 구성된 그것은 마치 작은 우주와 같다."

msgid "sn_dsc_1200"
msgstr "해 질 무렵 비춰지는 셰릴의 프로모션 영상.\\n덧없고 슬픈 피아노 선율 뒤에서, 이야기는 크게 움직이기 시작한다."

msgid "sn_dsc_1201"
msgstr "짙은 보랏빛 의상을 입은 마키나. 평소의 밝고 부드러운 인상은 완전히 뒤바뀌어,\\n보는 이 모두를 유혹하는 그 몸짓은 달빛 아래 춤추는 요염한 나비 그 자체다."

msgid "sn_dsc_1203"
msgstr "소문 그대로의 미모를 가진 그녀를 볼 수 있다면 값으로 따질 수 없을 만큼 귀하다.\\n하룻밤을 함께 보낼 수 있다면 그 이상의 가치는 없을 것이다."

msgid "sn_dsc_1204"
msgstr "자신의 아름다움을 과시하듯 궁전을 거니는 그녀. 그 화려한 걸음걸이는\\n보는 모든 이를 매료시키지만, 동시에 결코 손에 넣을 수 없는 존재임을 깨닫게 한다."

msgid "sn_dsc_1205"
msgstr "너무나 아름다운 그녀의 몸짓은 때로는 위압적으로 느껴지기까지 한다.\\n한번 주도권을 빼앗기면 누구도 그녀의 욕망을 막을 수 없다."

msgid "sn_dsc_1206"
msgstr "그녀를 원해 부와 권력을 바칠수록, 그녀 자신의 욕망 또한 끝없이 커져만 간다.\\n수많은 집착 어린 사랑을 받아온 그녀의 미모는 그야말로 매혹적이라 할 만하다."

msgid "sn_dsc_1207"
msgstr "잠입 조사 중 샤하르 시티의 오픈 카페에서 혼자 쉬고 있는 마키나.\\n한눈에는 한가로워 보이지만, 시티 주변의 감시는 게을리하지 않는 듯하다."

msgid "sn_dsc_1208"
msgstr "은하 전역에 방송된 라이브에서 메인으로 한 곡을 열창한 마키나.\\n그 달콤하고 귀여운 노랫소리는 남녀를 가리지 않고 매료시켜 간다."

msgid "sn_dsc_1209"
msgstr "란카 리와 셰릴 놈, 두 거성과 같은 시대를 살아간 수많은 별들.\\n미란다 메린 역시 그 별들 중 하나였다."

msgid "sn_dsc_1210"
msgstr "샤하르 시티에서 잠입 조사를 수행하는 발키리들.\\n미쿠모는 미라쥬에게서 일부러 떨어져 단독으로 잠입 조사를 시작했다."

msgid "sn_dsc_1211"
msgstr "S.M.S의 오너인 리처드 빌러가 세운 궁전.\\n그는 승진한 알토를 이곳으로 초대해 자신의 꿈에 대해 이야기한다."

msgid "sn_dsc_1212"
msgstr "행성 알 샤하르의 항구에 설치된 대형 모니터.\\n알 샤하르를 방문하는 사람들에게 다양한 언어로 환영의 말을 전하고 있다."

msgid "sn_dsc_1213"
msgstr "푹신한 의상을 입고 아이 군과 함께 쉬는 시간.\\n별똥별에 비는 소원은 마시멜로처럼 부드럽게 녹아내리는 달콤한 꿈일까. 아니면…"

msgid "sn_dsc_1215"
msgstr "부두 위에서 갑작스러운 바람에 날아간 란카의 모자. 그것을 잡으려 알토가 손을 뻗다가,\\n결국 란카를 껴안는 형태가 되어버렸다. 갑작스러운 거리 접근에 두 사람은 두근거린다."

msgid "sn_dsc_1216"
msgstr "노래로 바주라를 억제하는 실험에 불안을 느끼고 있던 란카. 그런 그녀에게\\n알토는 종이비행기를 접으며 자신만의 방식으로 그녀를 격려했다."

msgid "sn_dsc_1217"
msgstr "귀엽고 살짝 섹시한 의상을 입고 사진 촬영에 도전하는 란카.\\n평소와는 전혀 다른 표정에 보는 사람은 저도 모르게 두근거리게 될 것이다."

msgid "sn_dsc_1218"
msgstr "일이 순조롭게 풀리며 바쁜 나날을 보내는 란카. 그래도 이동 중 짧은 시간을\\n찾아 알토나 학교 친구들과의 메일 연락을 빠뜨리지 않는다."

msgid "sn_dsc_1219"
msgstr "자신이 용기를 낼 수 있게 된 것은 알토 덕분이라고 털어놓는 란카.\\n행성 갈리아 4의 물가에서 둘만 남은 채, 서로 잠시 바라보고 있었다."

msgid "sn_dsc_1220"
msgstr "란카는 마음을 굳히고 알토에게 셰릴을 어떻게 생각하는지 물었다.\\n노면전차에 흔들리며 알토는 말을 고르면서도 셰릴에 대한 마음을 이야기하기 시작했다."

msgid "sn_dsc_1221"
msgstr "알토를 남겨두고 방을 나서며, 부끄러워하면서도 못을 박는 란카.\\n믿고 있다고 해도 역시 사춘기 소녀인 만큼, 신경 쓰일 수밖에 없는 모양이다."

msgid "sn_dsc_1222"
msgstr "아이 군의 방을 무심코 들여다본 결과, 되려 당하고 만 알토.\\n알토가 뒤집어졌을 때의 충격은 란카가 있는 부엌까지 울려 퍼졌다."

msgid "sn_dsc_1223"
msgstr "분홍색에 금색 테두리가 들어간 귀여운 컵과 다과.\\n컵에는 란카가 타준 커피가 들어 있다."

msgid "sn_dsc_1224"
msgstr "인형이 장식되어 있고 깔끔하게 정돈된 란카의 방.\\n인형 디자인에서는 주인의 독특한 감성이 배어 나온다."

msgid "sn_dsc_1225"
msgstr "프레이야의 노래의 힘을 믿는 하야테와 미라쥬.\\n신뢰하는 두 사람의 결의와 마음이 공포에 사로잡혀 있던 프레이야의 마음을 해방시킨다."

msgid "sn_dsc_1226"
msgstr "【마음을 잇는 노랫소리】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1227"
msgstr "다른 멤버들이 프레이야를 위로하려 하는 가운데, 미쿠모는 프레이야의 뺨을 때린다.\\n절대 노래를 멈추지 않는 미쿠모의 강한 마음이 프레이야의 마음에도 전해진다."

msgid "sn_dsc_1228"
msgstr "라이브 도중 프레이야를 노리는 레이저 조준을 알아챈 마키나.\\n절체절명의 순간, 마키나는 몸을 던져 프레이야에게 달려간다."

msgid "sn_dsc_1229"
msgstr "자신의 노래가 하야테를 폭주시켰다는 이유로 노래하는 것에 두려움을 갖게 된 프레이야.\\n필사적으로 노래하려 하지만 목소리가 떨리고 생체 폴드파가 안정되지 않는다."

msgid "sn_dsc_1230"
msgstr "뜻대로 노래하지 못하는 프레이야에게 말을 거는 하야테.\\n하지만 하야테 한 사람의 말만으로는 프레이야의 불안을 떨쳐낼 수 없었다."

msgid "sn_dsc_1231"
msgstr "라이브 도중 갑자기 마키나에게 밀쳐진 프레이야.\\n그 직후 프레이야가 본 것은 총탄을 맞고 쓰러지는 마키나의 모습이었다."

msgid "sn_dsc_1232"
msgstr "프레이야의 노랫소리를 듣고 고통스러운 표정을 짓는 하야테.\\n동료를 위해, 프레이야를 위해 폭주하려는 자신을 마지막 순간까지 억누르고 있었다."

msgid "sn_dsc_1233"
msgstr "힘을 되찾은 프레이야의 노랫소리를 듣고 다시 폭주해버린 하야테.\\n그것은 첫 번째 폭주보다 더욱 격렬했고, 적과 아군을 구별하지 못하게 되었다."

msgid "sn_dsc_1234"
msgstr "절체절명의 위기에 달려온 척과 볼도르 방면군.\\n작전이 실패해 철수가 불가피해졌을 때, 척은 최후미를 맡아 임무를 수행했다."

msgid "sn_dsc_1235"
msgstr "총을 겨누고 레이저식 조준으로 목표를 잡는 윈더미어 병사.\\n이렇게 가까이 접근해 있었음에도, 총격 직전까지 아무도 눈치채지 못했다."

msgid "sn_dsc_1236"
msgstr "행성 알브헤임에 존재하는 프로토컬처의 유적.\\n시스템을 이용하면 폴드 게이트를 출현시킬 수 있다."

msgid "sn_dsc_1237"
msgstr "행성 알브헤임에서의 전술 라이브는 카나메와 아라드에게 특별한 의미를 지녔다.\\n이 땅에서 만나 뜻을 이루지 못한 채 쓰러진 메서를 떠올리며, 두 사람은 전장으로 향한다."

msgid "sn_dsc_1238"
msgstr "서로를 호적수로 인정하며 수차례 격렬한 일기토를 펼친 메서와 키스.\\n하늘을 향한 남다른 마음을 가진 두 사람의 날개는 어디까지나 아름답고 긍지 높은 바람을 두르고 있었다."

msgid "sn_dsc_1239"
msgstr "델타 소대의 에이스로서, 그리고 숨겨진 팬 중 한 명으로서 지지해준 메서.\\n이제는 세상을 떠난 그를 생각하며 카나메는 눈물을 머금고도 힘차게 노래를 이어갔다."

msgid "sn_dsc_1240"
msgstr "마키나는 피를 흘리고 고통을 참으면서도 노래를 멈추지 말아 달라고 바랐다.\\n「모두… 노래해…」─마키나"

msgid "sn_dsc_1241"
msgstr "프레이야의 부진으로 동요가 퍼지는 가운데, 카나메는 프레이야에게 말을 건넨다.\\n발키리의 리더로서 때로는 엄격한 태도를 취하는 것도 필요한 것이다."

msgid "sn_dsc_1242"
msgstr "추억의 장소에서 열린 라이브에서 카나메와 아라드는 고인이 된 메서를 떠올렸다.\\n「우리를 이끌어주는 걸지도 몰라요… 그 녀석이」─아라드"

msgid "sn_dsc_1243"
msgstr "라이브를 중단하고 부상당한 마키나에게 달려가는 발키리.\\n그 상황은 상공에서 지원하던 미라쥬 일행의 눈에도 들어왔다."

msgid "sn_dsc_1244"
msgstr "총격으로 쓰러진 마키나를 보고 망연자실한 프레이야와 레이나.\\n그때 카나메는 즉시 달려가 응급 키트로 신속한 처치를 실시했다."

msgid "sn_dsc_1245"
msgstr "한 명씩, 또 한 명씩 빠져나가는 발키리 멤버들.\\n그런 상황에서도 그녀들은 쓰러진 동료들의 마음을 이어받아 계속 노래한다."

msgid "sn_dsc_1246"
msgstr "하야테와의 싸움 속에서 카심은 룬의 힘을 해방하고, 목숨을 불태우며 계속 날아간다.\\n『백기사』를 떠올리게 하는 살벌한 전투에 테오와 자오는 아군이면서도 경악한다."

msgid "sn_dsc_1247"
msgstr "라이브로 인해 행성 알브헤임 유적 상공에 폴드 게이트가 열린다.\\n그 너머는 적의 본거지인 행성 윈더미어로 이어져 있었다."

msgid "sn_dsc_1248"
msgstr "시스템을 파괴하기 위해 윈더미어의 유적에 내려선 발키리.\\n뿔뿔이 흩어진 미쿠모와의 합류를 믿으며, 그녀들은 4명으로 전술 라이브에 도전한다."

msgid "sn_dsc_1249"
msgstr "윈더미어 왕국 공중기사단을 이끄는 존재로서 성기사단장을 맡고 있는 로이드.\\n기사의 긍지를 중시하는 『백기사』와는 대조적으로, 그의 눈은 먼 곳을 바라보고 있다."

msgid "sn_dsc_1250"
msgstr "이미 하늘을 내려놓았다고 말하는 로이드지만, 한때 『백기사』를 능가한다고 평가받던 실력은 여전하다.\\n그 순백의 날개는 그의 이상을 향한 마음을 이야기하는 듯하다."

msgid "sn_dsc_1251"
msgstr "별의 신전과 별의 노랫소리에 의해 로이드를 중심으로 한 시스템이 은하에 퍼져 나간다.\\n「오오…! 폴드 뉴로 네트워크가 연결되고 있어…!」─로이드"

msgid "sn_dsc_1252"
msgstr "로이드와 함께 찾아온 유적의 제단에서, 미쿠모는 고대 벽화를 보고 경악한다.\\n기억하고 있지 않더라도 미쿠모의 깊은 곳에는 별의 가수의 기억이 새겨져 있었던 것이다."

msgid "sn_dsc_1253"
msgstr "영원한 생명과 은하의 평화를 원하는 로이드에 맞서, 은하도 자신의 목숨도 원하지 않는다고 말하는 키스.\\n윈더미어를 위해 싸우는 두 사람이지만, 그 마음 깊은 곳에는 큰 차이가 존재했다."

msgid "sn_dsc_1256"
msgstr "별의 노래로 이끌린 정신세계에서 그 효과를 확신하는 로이드.\\n별의 가희인 미쿠모를 손에 넣음으로써 그의 계획은 최종 단계로 나아간다."

msgid "sn_dsc_1261"
msgstr "높고 맑은 가을 하늘 아래, 부드러운 표정으로 앨범 페이지를 넘기는 민메이.\\n추억의 앨범 속에는 그녀에게 소중한 기억들이 가득 담겨 있다."

msgid "sn_dsc_1262"
msgstr "푸르게 펼쳐진 가을 하늘과 붉게 물든 나무들 사이에서 평온한 시간을 보내는 민메이.\\n잠깐의 휴식을 마친 뒤에는 분명 맑고 투명한 노랫소리로 무대를 가득 채워줄 것이다."

msgid "sn_dsc_1263"
msgstr "첫 출격을 앞두고 불안해진 히카리는 민메이를 밤의 공원으로 불러낸다.\\n불안을 털어놓지는 못했지만, 그때 찍은 사진은 추억의 한 장이 되었다."

msgid "sn_dsc_1264"
msgstr "적에게 붙잡힌 히카리는 민메이와 나눈 약속을 떠올리고 있었다.\\n「결국 약속은 지키지 못한다는 건가…」─히카리"

msgid "sn_dsc_1265"
msgstr "원피스 자락을 펼쳐 히카리에게 감상을 묻는 민메이.\\n솔직한 감상을 말한 히카리였지만, 민메이에게는 그다지 와닿지 않았다."

msgid "sn_dsc_1266"
msgstr "히카리를 데리고 들어간 부티크에서 마음에 드는 옷을 집어 드는 민메이.\\n또래 여자아이답게 패션에 대해서는 상당히 신경 쓰는 모양이다."

msgid "sn_dsc_1267"
msgstr "가수 데뷔를 목표로 레슨에 힘쓰는 민메이.\\n일과 레슨으로 바쁜 와중에도 충실한 매일을 보내고 있는 듯하다."

msgid "sn_dsc_1268"
msgstr "기대받는 신인 가수로 쇼에 출연한 민메이.\\n많은 관객 앞에서 「나의 그이는 파일럿」을 열창하며 강렬한 데뷔를 장식했다."

msgid "sn_dsc_1269"
msgstr "고른 옷을 들고 탈의실로 들어가는 민메이.\\n히카리와의 풋풋한 대화에 함께 있던 점원도 자신도 모르게 미소를 지었다."

msgid "sn_dsc_1270"
msgstr "바쁜 일 틈틈이 연락을 주고받는 히카리와 민메이.\\n오랜만에 휴가를 낼 수 있을 것 같던 히카리였지만, 바쁜 민메이는 일정이 맞지 않는 듯하다."

msgid "sn_dsc_1271"
msgstr "마크로스 함내 공원에 설치된 자동 사진기.\\n「카메라」라고 편하게 부르면 어디선가 나타나 준다."

msgid "sn_dsc_1272"
msgstr "마크로스 함내에서 방송되는 와이드쇼.\\n프로그램에 출연한 민메이는 가수에 대한 자신의 생각을 이야기했다."

msgid "sn_dsc_1273"
msgstr "섹시한 서큐버스풍 의상을 입고 몽마의 세계에 내려온 마키나.\\n두근거림이 넘치는 멋진 꿈속 세계에, 자신도 모르게 깨어나고 싶지 않을지도 모른다."

msgid "sn_dsc_1274"
msgstr "해적 선장으로 변장하고 배까지 준비해 어른다운 장난기를 보여주는 아라드.\\n개성 넘치는 유령들을 이끌고 보물 가득한 바다로 나아간다."

msgid "sn_dsc_1275"
msgstr "망자들의 떠들썩한 축제에 이끌려, 신출귀몰한 여신도 불쑥 모습을 드러낸다.\\n오늘 밤은 할로윈… 요염하게 빛나는 달 아래 신비로운 무대가 막을 올린다."

msgid "sn_dsc_1276"
msgstr "마녀 소녀 의상을 입고 과자를 손에 든 채 다음 목표를 찾는 프레이야.\\n그녀에게 장난을 당하지 않으려면 과자를 많이 준비해 두는 편이 좋을 것이다."

msgid "sn_dsc_1277"
msgstr "작전 재검토가 필요하다고 진언하는 로이드에게 그라미아는 엄숙하게 타이른다.\\n「걱정하지 마라, 바람은 반드시 분다」─그라미아"

msgid "sn_dsc_1278"
msgstr "하인츠는 차원 병기가 일으킨 참상을 직접 보고 크게 동요한다.\\n「눈을 돌려서는 안 됩니다. 보십시오… 우리가 입은 상처를… 굴욕의 증표를!」─키스"

msgid "sn_dsc_1279"
msgstr "반응 병기 사용 허가를 요구받지만 이를 거부하는 하워드 대통령.\\n전면전을 피하려는 그에게 대기하고 있던 레온이 속삭인다."

msgid "sn_dsc_1280"
msgstr "잘라냈다고 생각했던 셰릴이 살아 돌아온 것에, 그레이스는 비웃음 섞인 미소를 짓는다.\\n깔보는 듯한 그 시선에는 동정이나 정 따위는 전혀 느껴지지 않는다."

msgid "sn_dsc_1281"
msgstr "바르에 의해 흉포화된 병사들도 발키리의 노래로 제정신을 되찾고 눈을 빛낸다.\\n「데…컬처…!」─젠트라디 병사"

msgid "sn_dsc_1282"
msgstr "바주라에게 붙잡힌 란카를 구출하고 프론티어 전군에 통신을 보내는 브레라.\\n갤럭시 선단에 생존자가 있었다는 사실을 알게 된 신통합군 사령부는 놀라움을 금치 못했다."

msgid "sn_dsc_1283"
msgstr "행성 볼도르의 파라나걸 유적에 다수 배치된 경계 드론.\\n…이었지만, 마키나와 레이나에 의해 순식간에 장악되어 버렸다."

msgid "sn_dsc_1284"
msgstr "사라진 아이 군의 특징을 알려주기 위해 나나세가 그린 일러스트.\\n그것을 본 루카는 함내에서 바주라 유생이 활동하고 있다는 사실을 깨닫는다."

msgid "sn_dsc_1285"
msgstr "늑대인간을 이미지한 의상과 익숙하지 않은 행사 때문에 조금 언짢아 보이는 바사라.\\n하지만 라이브가 시작되자 완전히 돌변해, 달빛 아래 뜨거운 샤우트를 울려 퍼뜨린다."

msgid "sn_dsc_1287"
msgstr "귀여운 의상을 입은 민메이. 그녀의 키스에 유령들조차 푹 빠져버린다.\\n과자나 장난은 제쳐두고 그녀에게 정신을 빼앗길 것 같다."

msgid "sn_dsc_1288"
msgstr "신비롭고 위험한 매력을 지닌 시빌. 요염한 할로윈 밤에\\n우연히 그녀를 만나버린다면 마지막에는 순식간에 넋을 잃고 말 것이다."

msgid "sn_dsc_1289"
msgstr "정글에 추락한 구 보돌 기함대의 전함을 수리하는 카무진 일행.\\n그들에게 문화를 가르친 것이 아이러니하게도 새로운 위협을 만들어내고 말았다."

msgid "sn_dsc_1290"
msgstr "직속 부하로 「에이스의 미리아」를 둔 젠트라디군 직위 함대 사령관.\\n보돌자의 명령에 따라 브리타이의 후임으로 마크로스 내부 정찰 작전을 수행했다."

msgid "sn_dsc_1291"
msgstr "하얀 깃털로 뒤덮이고 등에 날개를 가진 소년 같은 모습의 프로토 데빌룬.\\n모든 것에서 아름다움을 찾으려 하는 독특한 미의식을 가진 존재다."

msgid "sn_dsc_1292"
msgstr "맥스 일행의 목숨을 건 작전도 게페르니치의 힘에 의해 실패로 끝나고 말았다.\\n돌아갈 방법을 잃은 그들에게 게페르니치는 항복을 권고했다."

msgid "sn_dsc_1293"
msgstr "압도적인 힘으로 발키리의 장갑을 벗겨내고 틈 사이로 콕핏을 들여다보는 브리타이.\\n너무나 큰 공포에 히카리는 비명을 지르며 긴급 탈출 장치를 작동시켰다."

msgid "sn_dsc_1294"
msgstr "가빌과 그라빌이 합체한 모습으로, 높은 지능과 강력한 전투력을 겸비하고 있다.\\n그들에게 합체는 「궁극의 수단」이며, 그 모습은 「완성된 아름다움」이라 불렸다."

msgid "sn_dsc_1295"
msgstr "시티 7에 잠입해 시민들을 습격하고 스피리티아를 빼앗는 바로타군 병사들.\\n그 범행 내용 때문에 시티 7 사람들은 그들을 뱀파이어라 부르며 두려워했다."

msgid "sn_dsc_1296"
msgstr "와레라 일행 「푸른 바람」이 마크로스에서 가져온 물품 중 하나.\\n하급 병사들은 처음 듣는 노래라는 문화에 강한 관심을 보였다."

msgid "sn_dsc_1297"
msgstr "평소와 다른 제복을 입고 신곡 프로모션을 하는 란카.\\n빛나는 방과 후의 노을과 부드러운 멜로디가 있는 그대로의 그녀의 매력을 끌어낸다."

msgid "sn_dsc_1299"
msgstr "신곡을 위해 준비한 의상을 알토에게 보여주는 란카.\\n그리고 고개를 숙인 채 부끄러워하며 신곡과 알토에 대한 마음을 털어놓았다."

msgid "sn_dsc_1300"
msgstr "결전의 장소에서 노래하게 된 란카. 부를 곡은 그녀가 처음으로 작사한 노래였다.\\n마음을 담은 노래를 알토, 그리고 바주라에게 전하기 위해 란카는 전장에 노래를 울려 퍼뜨린다."

msgid "sn_dsc_1301"
msgstr "용기를 쥐어짜 마침내 알토를 향한 마음을 고백한 란카.\\n직후 부끄러움에 눈시울을 붉히며, 자조 섞인 말을 작게 중얼거렸다."

msgid "sn_dsc_1302"
msgstr "평범했던 나날 속에서도 특별했던 알토와의 추억.\\n다시는 만나지 못할지도 모른다는 마음을 견디며, 전장에서 란카는 계속 노래했다."

msgid "sn_dsc_1303"
msgstr "어린 시절의 기억을 잃은 란카가 유일하게 기억하고 있던 노래 아이모.\\n그녀에게 그 노래는 희망이자 소중한 추억이 되었다."

msgid "sn_dsc_1304"
msgstr "종이 한 장이 하늘을 나는 비행기로 변하는 것을 즐겁게 이야기하는 알토.\\n알토는 종이비행기에 남다른 애착을 가지고 있었다."

msgid "sn_dsc_1305"
msgstr "석양이 비추는 가운데 란카의 노랫소리에 귀를 기울이는 알토.\\n란카가 노래에 품은 마음에 자신의 마음을 겹쳐, 알토 역시 하늘을 나는 것에 대한 마음을 전했다."

msgid "sn_dsc_1306"
msgstr "VF-25를 기반으로 개발 중인 바주라와의 결전을 위한 시작기.\\n현재는 아직 마크로스 쿼터의 격납고에서 완성을 기다리고 있는 상태다."

msgid "sn_dsc_1307"
msgstr "미호시 학원 근처의 높은 언덕에 있는 공원.\\n시가지를 내려다볼 수 있으며, 인공적인 것이지만 아름다운 석양을 바라볼 수 있다."

msgid "sn_dsc_1308"
msgstr "미호시 학원 외곽에 설치된 펜스.\\n다른 학교 학생이었던 란카는 펜스 너머로 알토가 있을 학원을 바라보고 있었다."

msgid "sn_dsc_1309"
msgstr "붉은 칼라 세일러복을 입고 석양이 비치는 교실에 서 있는 프레이야.\\n근심 어린 표정을 짓고 있지만, 그녀의 마음은 새로운 내일에 대한 기대감으로 가득 차 있다."

msgid "sn_dsc_1311"
msgstr "처음 하늘을 날았을 때, 프레이야의 노래 덕분에 기분 좋게 날 수 있었다고 이야기하는 하야테.\\n그 말을 들은 프레이야는 룬을 빛내며 기쁜 듯 미소를 지었다."

msgid "sn_dsc_1312"
msgstr "미라쥬를 구하기 위해서였다고 해도, 처음으로 적을 격추한 일을 마음에 담아두는 하야테.\\n이에 미라쥬는 감사를 전하는 동시에 전사로서의 책임을 일깨워 주었다."

msgid "sn_dsc_1313"
msgstr "매일 레슨이 즐겁다는 프레이야에게 하야테는 부럽다고 답했다.\\n그리고 아버지의 유품인 펜던트를 바라보며 훈련에 대한 불만을 털어놓았다."

msgid "sn_dsc_1314"
msgstr "오디션에 합격한 기쁨을 감추지 못하는 프레이야.\\n하야테는 그런 모습을 놀리면서도 다시 함께 있을 수 있다는 사실을 기뻐하는 듯했다."

msgid "sn_dsc_1315"
msgstr "좋아하는 사과 주스를 마시며 기분 좋은 프레이야.\\n이마의 룬도 프레이야의 감정에 맞춰 반짝반짝 빛나고 있다."

msgid "sn_dsc_1316"
msgstr "하야테와 미라쥬의 투샷 사진과 여러 증언을 통해 무언가를 눈치챈 마키나를 보며,\\n하야테 이야기에 프레이야는 크게 동요하고 만다."

msgid "sn_dsc_1317"
msgstr "긴급한 사안을 두고 논의를 깊게 하기 위해 카페에 모인 카오스의 여자 멤버들.\\n화제는 유행 패션부터 인기 디저트, 치정 관계의 갈등까지 다양하다…"

msgid "sn_dsc_1318"
msgstr "VF-1을 최신 기술로 개량한 기체로, 엘리시온에는 훈련기로 배치되어 있다.\\n형식 번호는 VF-1EX. 콕핏에 도입된 「EX-기어」에서 유래했다고 한다."

msgid "sn_dsc_1319"
msgstr "행성 라그나에 입점한 버섯을 모티브로 한 카페.\\n발키리와 카오스 직원들도 자주 이용하는 듯하다."

msgid "sn_dsc_1320"
msgstr "라그나의 거리와 바다를 한눈에 볼 수 있는 높은 언덕.\\n바다에서 불어오는 바람이 기분 좋고, 괭이갈매기 보스도 마음에 들어 하는 장소인 듯하다."

msgid "sn_dsc_1321"
msgstr "프론티어군의 계획을 저지하고 아이랜드 1에 남겨진 사람들을 구하기 위해,\\n그리고 바주라와 대화하여 무의미한 싸움에 종지부를 찍기 위한 싸움이 시작되었다."

msgid "sn_dsc_1322"
msgstr "은하의 운명을 건 싸움에 종지부를 찍기 위해 돌격을 감행하는 마크로스 쿼터.\\n필살의 마크로스 캐논으로 적을 쓸어버리며 그 기동력을 유감없이 발휘한다."

msgid "sn_dsc_1323"
msgstr "캐터펄트 위에 나타난 YF-29SP의 콕핏에서 란카에게 경례를 보내는 알토.\\n란카는 무대 위에서 사인을 돌려준 뒤, 노래와 함께 출격하는 알토를 배웅했다."

msgid "sn_dsc_1324"
msgstr "마지막 결전을 앞두고 제프리는 함내 방송을 통해 전원에게 연설을 했다.\\n절망적인 상황 속에서도 강한 의지가 가득 담긴 연설이었다."

msgid "sn_dsc_1325"
msgstr "컨트롤 웨이브로 인한 란카의 노래 방해를 막기 위해,\\n제프리는 아이랜드 1 돌입과 폴드 발신 스테이션 제압을 시도한다."

msgid "sn_dsc_1327"
msgstr "적진 돌격을 앞두고 대G 시트에 몸을 고정하는 보비.\\n특징적인 헤어스타일을 정돈한 뒤, 오퍼레이션 빅 웬즈데이를 실행했다."

msgid "sn_dsc_1333"
msgstr "수많은 위기를 함께 헤쳐 온 발키리의 다섯 멤버.\\n개성 넘치는 멤버들을 지탱하고 이어주는 그녀야말로 발키리의 리더다."

msgid "sn_dsc_1334"
msgstr "델타 소대로 복귀한 메서를 아라드와 카나메가 따뜻하게 맞이한다.\\n「메서 이레펠트 중위, 지금부터 임무에 복귀합니다!」─메서"

msgid "sn_dsc_1335"
msgstr "지금까지 한 발 물러선 위치에서 멤버들을 지켜봐 온 카나메였지만, 오늘부터는 다르다.\\n자신의 노래를 소중히 여겨준 사람을 위해, 누구보다 강하게 계속 노래하겠다고 맹세했다."

msgid "sn_dsc_1336"
msgstr "메서의 팔찌형 플레이어에 유일하게 들어 있던 카나메의 노래.\\n그녀의 노래가 있었기에 메서는 자아를 잃지 않을 수 있었다."

msgid "sn_dsc_1337"
msgstr "아라드가 해파리 보내기 연회용으로 가져온 오래된 바나나 술.\\n엄청난 보물이라고 할 만큼 귀한 물건으로, 애주가라면 꼭 맛보고 싶어 할 명품이다."

msgid "sn_dsc_1338"
msgstr "델타 소대장으로서 언제나 최선을 다해온 아라드.\\n그런 그조차 이날만큼은 풀 곳 없는 후회를 품고 있었다."

msgid "sn_dsc_1339"
msgstr "너무 가까워지면 폭주했을 때 마지막 일격을 가하지 못할지도 모른다.\\n그런 메서의 마음을 알게 된 하야테의 가슴에는 견딜 수 없는 감정이 차올랐다."

msgid "sn_dsc_1340"
msgstr "해파리를 산 채로 통째로 삼키는 것을 좋아했던 레이나.\\n「해파리… 이제 통째로 못 먹어… 메서일지도 모르니까」─레이나"

msgid "sn_dsc_1341"
msgstr "해파리 보내기를 위해 만들어진, 메서의 기체를 본떠 만든 배.\\n「조금 못생겼지만, 귀여워!」─마키나"

msgid "sn_dsc_1342"
msgstr "VF-31을 본뜬 배를 바다에 띄우는 하야테 일행.\\n메서의 영혼이 빛나는 해파리가 되어 다시 하늘로 돌아가기를 믿으며…"

msgid "sn_dsc_1343"
msgstr "메서의 기체에서 발견된 델타 소대의 비행 로그가 남겨진 단말기.\\n기체 상태부터 성격, 주로 사용하는 발까지 세세한 지적과 분석이 기록되어 있었다."

msgid "sn_dsc_1344"
msgstr "늦은 밤까지 델타 소대의 비행 로그를 작성하고 있던 메서.\\n동료들과 거리를 두면서도 그는 마지막까지 동료들을 생각하고 있었다."

msgid "sn_dsc_1345"
msgstr "화려한 장식과 선명한 붉은색으로 꾸며진 의상을 입은 셰릴.\\n찬란하고 호화로운 그 모습은 특별한 기념일을 축하하기에 어울리는 의상이다."

msgid "sn_dsc_1346"
msgstr "장미처럼 아름답고 고귀한 마음을 지니며, 누구에게나 차별 없는 사랑을 베푸는 셰릴.\\n그 행복한 순간은 시간을 넘어도 빛바래지 않는 한 폭의 그림 같은 아름다움을 보여준다."

msgid "sn_dsc_1347"
msgstr "지금 노래하면 이 몸은 끝나버릴지도 모른다. 그래도 그녀는 마이크를 들었다.\\n「설령 내가 죽더라도… 노래는 죽지 않아!」─셰릴"

msgid "sn_dsc_1348"
msgstr "스스로 결정한다는 것은 누구의 탓도 할 수 없는 일이라고 말하는 오즈마.\\n「그러니 잘 자신에게 물어봐라! 앞으로 어떤, 어떤 역할을 연기할 것인지 말이다!」─오즈마"

msgid "sn_dsc_1349"
msgstr "알토가 아직 아역 배우였을 무렵, 공연 후 한 소녀에게 꽃다발을 받은 적이 있었다.\\n알토에게는 먼 과거의 기억이지만, 소녀는 그때의 일을 계속 기억하고 있었다."

msgid "sn_dsc_1350"
msgstr "반짝이는 불꽃 홀로그램을 비추며 무대로 걸어가는 셰릴.\\n몸을 감싼 빛은 생명을 불태우며 노래하는 셰릴에게 호응하는 듯했다."

msgid "sn_dsc_1351"
msgstr "목숨을 걸고 노래하겠다는 셰릴의 각오와 노랫소리에 압도되는 오즈마.\\n오즈마의 눈에 비친 그 모습은 그야말로 『은하의 요정』 그 자체였다."

msgid "sn_dsc_1352"
msgstr "바주라와의 싸움에서 승리하고 사람들을 구하기 위해, 다시 가희로 돌아온 셰릴.\\n무대 위에서 보여준 그 표정에는 마지막까지 노래하겠다는 각오가 가득했다."

msgid "sn_dsc_1353"
msgstr "셰릴과 오즈마를 구출하기 위해 두 사람에게 기체를 접근시키는 알토.\\n셰릴의 노랫소리가 흐릿해진 알토의 의식을 깨우고 이곳까지 이끌어 왔다."

msgid "sn_dsc_1354"
msgstr "통합군 병사로서 오즈마와 일기토에 도전하는 알토.\\n엇갈리는 순간, 두 사람은 캐노피 너머로 서로의 모습을 확인했다."

msgid "sn_dsc_1355"
msgstr "폴드 재밍파의 영향을 받아 괴로운 듯 몸을 움츠리는 아이 군.\\n주변으로 새어나오는 미약한 빛은 재밍파에 반응하듯 깜빡임을 반복했다."

msgid "sn_dsc_1356"
msgstr "사오토메 가문의 저택 안에 조성된 일본 정원.\\n지금은 희미한 빛에 비춰져 숨이 막힐 듯한 정적에 휩싸여 있다."

msgid "sn_dsc_1357"
msgstr "발키리의 에이스로서 압도적인 노랫소리로 무대를 매료시키는 미쿠모.\\n가슴을 꿰뚫는 듯한 그 노랫소리는 관객뿐만 아니라 발키리 멤버들까지도 일으켜 세운다."

msgid "sn_dsc_1359"
msgstr "미쿠모의 합류를 계기로 발키리를 최고의 유닛으로 만들겠다고 맹세한 카나메 일행.\\n독방에 울려 퍼진 미쿠모의 노랫소리는 그런 동료들의 마음에 보답하듯 했다."

msgid "sn_dsc_1360"
msgstr "전술 음악 유닛 설립과 함께 교육 담당 겸 매니저로 발탁된 카나메. 그녀가\\n리셉터 보유자이자 전직 솔로 아이돌이었기에 창설 멤버 중 한 명이 되었다."

msgid "sn_dsc_1361"
msgstr "작전 회의에서 제시된 유적 전함에서 무언가를 느낀 미쿠모.\\n그것이 무엇인지 답을 찾지 못한 미쿠모는 해저 유적이 존재하는 바다를 바라보고 있었다."

msgid "sn_dsc_1362"
msgstr "이상한 광경을 꿈꾸고, 어디인지도 모를 방에서 눈을 뜬 미쿠모.\\n꿈속에서는 자신과 닮은 여성이 고대 유적에 노래를 바치는 것처럼 보였는데…?"

msgid "sn_dsc_1363"
msgstr "미쿠모의 노래로 유적의 시스템이 기동한 것에 동요하는 공중기사단의 젊은 기사들.\\n온갖 추측을 늘어놓으며 불안해하는 모습에 보그는 진심으로 질린 표정을 짓는다."

msgid "sn_dsc_1364"
msgstr "노래를 부르며 카나메 일행이 수감된 독방에 나타난 미쿠모.\\n평소와 다를 바 없는 미쿠모의 모습에 카나메 일행은 자신도 모르게 당황한다."

msgid "sn_dsc_1365"
msgstr "형 테오에 비해 호전적인 성격에다 가벼운 면까지 있는 동생 자오.\\n동생의 지나친 행동과 태도를 바로잡는 것은 착실한 형 테오의 역할이다."

msgid "sn_dsc_1366"
msgstr "전술 라이브를 위해 방문한 거리에서 폭주한 콰드란에게 몰리는 카나메.\\n당시에는 전술 음악 유닛으로서 진가를 발휘하지 못해 위기에 처하는 일도 많았다."

msgid "sn_dsc_1367"
msgstr "아이테르 갑판 위에서 바라보는 라그나의 석양.\\n카오스 크루만 볼 수 있는 절경으로, 감상적인 기분일 때에도 딱 어울리는 장소다."

msgid "sn_dsc_1368"
msgstr "집무실에서 하인츠의 노랫소리에 무엇이 부족한지 고민하는 로이드.\\n그 손에 든 단말기에는 볼도르 유적에서의 미쿠모 모습이 비춰지고 있었다."

msgid "sn_dsc_1369"
msgstr "사랑스러운 행동과 부드러운 프로포션으로 남녀 모두에게 인기를 자랑하는 마키나.\\n또한 그녀의 아이돌에 대한 열정이 지금의 발키리를 만들어냈다고 할 수 있을지도 모른다."

msgid "sn_dsc_1371"
msgstr "아직 전혀 끝내지 못했다며, 이대로 끝낼 수 없다며 손수 만든 의상을 나눠주는 마키나.\\n포기하려던 멤버들도 의상을 받으며 다시 의욕을 되찾아갔다."

msgid "sn_dsc_1372"
msgstr "의료선의 ID 보안이 변경되어 급히 프로그램 수정을 진행하는 레이나.\\n어려운 프로그램을 만날수록 기뻐하는 모습은 그야말로 천재 해커다."

msgid "sn_dsc_1373"
msgstr "코드 인증에 실패해 어쩔 수 없이 강행 돌파를 시도하는 카나메 일행.\\n카나메의 돌입을 지원하기 위해 마키나는 몸을 던져 경비원에게 달려들었다."

msgid "sn_dsc_1374"
msgstr "공명 실험 당시 카나메에게서 프레이야가 노래하지 못했다는 이야기를 들은 하야테.\\n깊이 가라앉은 프레이야의 모습을 보고 하야테는 말을 걸 수 없었다."

msgid "sn_dsc_1375"
msgstr "하인츠를 배신하는 일이 있다면 용서하지 않겠다고 잘라 말한 키스.\\n로이드는 친구로서 키스 역시 같은 길을 걸어주기를 바랄 수밖에 없었다."

msgid "sn_dsc_1376"
msgstr "세포에 미리 폴드 리셉터 인자를 심어 만든 클론으로 태어난 미쿠모.\\n미쿠모는 자신의 탄생 비밀을 알고도 계속 노래하겠다고 동료들 앞에서 맹세했다."

msgid "sn_dsc_1377"
msgstr "의료선 해킹을 발각당해 경비원들에게 포위된 레이나.\\n레이나는 뒤로 손을 돌려 키를 입력하며 마지막 순간까지 카나메를 지원한 뒤 투항했다."

msgid "sn_dsc_1378"
msgstr "창설된 지 얼마 되지 않은 발키리를 구한 아라드의 VF-31A.\\n기체의 「카이로스」라는 이름은 기회의 신에서 따온 것이다."

msgid "sn_dsc_1379"
msgstr "레이나가 의료선에 투입한 마지막 해킹 프로그램.\\n미쿠모가 있다고 추정되는 방의 문을 열고, 그 너머로 카나메를 이끌었다."

msgid "sn_dsc_1380"
msgstr "성간 복합 기업체인 카오스 라그나 지부의 기지.\\n항구 도시 바레타 시티의 언덕 마을에 함께 자리하고 있다."

msgid "sn_dsc_1381"
msgstr "고지식한 교관과 자유분방한 후보생으로서 반발과 충돌을 반복해 온 두 사람.\\n동료들과의 교류와 수많은 시련을 넘은 지금, 두 사람의 마음은 강한 신뢰로 이어져 있다."

msgid "sn_dsc_1382"
msgstr "등 뒤에 『Anniversary』 문자를 새긴 특별한 컬러링의 VF-31J.\\n온몸으로 기념일을 축하하는 듯한 멋진 모습에 하야테도 기분이 좋은 듯하다."

msgid "sn_dsc_1383"
msgstr "프레이야의 노래로 냉정을 되찾은 하야테는 기체를 바로잡고 다시 하늘로 날아올랐다.\\n「아직 시험은 끝나지 않았다고, 교관님!」─하야테"

msgid "sn_dsc_1384"
msgstr "뜻밖의 패배를 당하고 콕핏 안에서 고개를 숙인 채 움직이지 못하는 미라쥬.\\n그런 그녀에게 하야테는 우울한 분위기를 날려버릴 듯한 미소로 말을 걸었다."

msgid "sn_dsc_1385"
msgstr "오디션 합격 당시 하야테에게 놀림받았던 일을 기억하고 있던 프레이야.\\n최종 시험에 합격한 하야테에게 보답이라도 하듯 똑같은 말을 돌려주었다."

msgid "sn_dsc_1387"
msgstr "승리의 여운에 빠져 있던 하야테에게 가차 없이 페인트탄을 날리는 메서.\\n「죽고 싶지 않다면 싸우는 방법을 익혀라」─메서"

msgid "sn_dsc_1393"
msgstr "개성 넘치는 두 마리 비둘기를 파트너로 삼아, 마술사로 변신한 밀레느의 무대가 막을 올린다.\\n꿈과 마법으로 가득한 노랫소리는 반짝이며 빛나고, 끝없이 이어지는 별하늘처럼 퍼져나간다."

msgid "sn_dsc_1395"
msgstr "잠시 쉬고 있는 순간에도 무심코 눈길이 따라가는 그 녀석의 뒷모습.\\n무슨 생각을 하는지는 모르지만, 왠지 신경 쓰이는 밀레느였다."

msgid "sn_dsc_1396"
msgstr "목욕 후 바스타월 한 장만 두른 조금 섹시한 모습의 밀레느.\\n상기되어 분홍빛으로 물든 입술은 코케틱한 매력으로 가득하다."

msgid "sn_dsc_1397"
msgstr "놀리는 듯한 표정으로 힘차게 가방을 휘두르는 밀레느.\\n그 천진난만한 행동 때문에 여러모로 애를 먹는 일도 많을 것이다."

msgid "sn_dsc_1398"
msgstr "함께 걷는 상대의 팔에 안기듯 몸을 밀착하는 밀레느.\\n고양이 같은 순수한 미소는 소녀다운 어린 느낌을 자아낸다."

msgid "sn_dsc_1399"
msgstr "평범한 데이트 중에도 평소와는 또 다른 인상을 보여주는 밀레느.\\n또래 소녀다운 면과 여성으로서의 매력이 공존하는 것이 그녀의 매력이다."

msgid "sn_dsc_1400"
msgstr "모처럼의 기념 촬영이라며 바사라와 밀레느를 배려하는 레이.\\n하지만 셔터 순간 서로 반대 방향을 보고 있다면 역시 어쩔 수 없다."

msgid "sn_dsc_1401"
msgstr "일정 문제로 미뤄졌던 밀레느의 환영 파티.\\n곧바로 다음 일 이야기가 정해지는 등, 새 멤버 합류 후 출발은 순조로운 듯하지만…"

msgid "sn_dsc_1402"
msgstr "음료를 목으로 넘기며 참을 수 없다는 표정을 짓는 레이.\\n차갑게 식지 않았더라도 해가 떠 있는 동안 밖에서 마시는 것은 각별한 모양이다."

msgid "sn_dsc_1403"
msgstr "밀레느의 환영 파티에서 준비된 바비큐.\\n연기가 많이 나와도 야외라면 신경 쓰지 않아도 된다."

msgid "sn_dsc_1404"
msgstr "음료를 식히고 있던 쿨러 박스.\\n얼음은 가득 들어 있었지만, 정작 음료는 그다지 차갑지 않았던 듯하다."

msgid "sn_dsc_1405"
msgstr "성탄절 밤을 화려하게 축하하기 위해 크리스마스 의상을 섹시하게 소화한 셰릴.\\n저절로 시선을 빼앗기는 그 빛나는 모습은 잊지 못할 추억을 선물해 줄 것이다."

msgid "sn_dsc_1406"
msgstr "갑자기 골목에서 뻗어 나온 다리에 걸려 알토는 그만 넘어지고 만다.\\n「갑자기 뭐 하는 거야!」「하이~☆」─알토, 셰릴"

msgid "sn_dsc_1407"
msgstr "화려한 크리스마스 밤에 나타난 귀엽고 섹시한 성야의 요정.\\n그 아름답고 풍성한 스타일 앞에서는 거리의 일루미네이션조차 빛을 잃는다."

msgid "sn_dsc_1408"
msgstr "긴 자락의 원피스 의상을 입고 차분하게 기도하듯 노래하는 셰릴.\\n그 모습은 고향 갤럭시와 출격한 알토의 무사를 기원하는 듯했다."

msgid "sn_dsc_1409"
msgstr "작전이 끝나면 돌려주겠다는 약속의 이어링을 그대로 알토에게 맡긴 셰릴.\\n「가지고 있어. 그건 우리를 지켜준 보너스니까」─셰릴"

msgid "sn_dsc_1410"
msgstr "죽은 사람들을 애도하듯 프론티어에 내리기 시작한 눈.\\n그 광경에 셰릴과 란카는 잠시 넋을 잃고 바라보았다."

msgid "sn_dsc_1411"
msgstr "작별 라이브의 한 장면에서 프론티어 사람들에게 감사의 말을 전하는 셰릴.\\n점점 분위기를 끌어올리며, 언제나처럼 라이브를 뜨겁게 만들겠다고 선언했다."

msgid "sn_dsc_1412"
msgstr "평소와 전혀 다른 미소로 다가오는 캐시에게 저도 모르게 당황하는 오즈마였지만…?\\n「어, 어이!」「11시 방향. 빌딩 모퉁이」─오즈마, 캐시"

msgid "sn_dsc_1413"
msgstr "바주라 습격 속에서 프론티어 전 함선에 중계된 셰릴의 라이브 영상.\\n힘차게 노래하는 셰릴의 모습에 사람들도 희망을 되찾아갔다."

msgid "sn_dsc_1414"
msgstr "그레이스의 기지와 스태프들의 노력으로 다시 움직이기 시작한 라이브 무대.\\n셰릴의 노래와 영상은 무인 카메라를 통해 전 함선에 중계되었다."

msgid "sn_dsc_1415"
msgstr "외벽 손상으로 인한 감압으로 구름이 생기고 눈이 내리기 시작한 프론티어.\\n노출이 많은 의상을 입고 있던 셰릴은 자신도 모르게 귀여운 재채기를 하고 말았다."

msgid "sn_dsc_1416"
msgstr "옅은 푸른 조명에 비춰진 작별 라이브의 셰릴.\\n흩뿌려진 빛의 입자가 다이아몬드 더스트처럼 반짝이고 있다."

msgid "sn_dsc_1417"
msgstr "조금 미니 사이즈의 크리스마스 의상을 입고 트리를 꾸미는 란카.\\n그 사랑스러운 모습 자체가 무엇보다 최고의 선물이 될 것 같다."

msgid "sn_dsc_1419"
msgstr "화려한 크리스마스 밤, 선물을 품에 안고 누군가를 기다리는 란카.\\n선물 속에는 소중한 사람을 향한 마음이 별빛처럼 반짝이고 있을 것이다."

msgid "sn_dsc_1420"
msgstr "미호시 학원 근처의 카페에서 비밀 회의를 하는 란카와 나나세.\\n내용은 비밀이라 알려주지 않는 것 같지만, 대체 어떤 이야기를 나누고 있는 걸까?"

msgid "sn_dsc_1421"
msgstr "홀로 먼 곳을 바라보는 셰릴. 그리고 그런 모습을 지켜보는 란카와 알토.\\n알토는 받은 이어링을 손에 쥔 채 셰릴의 말을 되새기고 있었다."

msgid "sn_dsc_1422"
msgstr "걱정으로 당황하는 오즈마에게 쓴웃음을 지으면서도 어딘가 쑥스러운 표정의 란카.\\n아직 앳된 면이 남아 있지만, 셰릴과의 라이브를 통해 란카는 크게 성장하고 있었다."

msgid "sn_dsc_1423"
msgstr "알토를 예로 들며 미셸을 믿을 수 없는 녀석이라고 말하는 클란.\\n한편 미셸은 시선을 피하면서도 의미심장한 웃음으로 답했다."

msgid "sn_dsc_1424"
msgstr "감시를 눈치챈 오즈마는 일부러 뜨거운 커플을 연기하기 시작했다.\\n「아~앙!…오, 맵다!」「에~? 정말~?」─오즈마, 캐시"

msgid "sn_dsc_1425"
msgstr "주저앉아 버린 란카를 보고, 황급히 발키리 위에서 몸을 내미는 오즈마.\\n어떤 순간에도 란카의 안위를 걱정하지 않을 수 없는 그였다."

msgid "sn_dsc_1426"
msgstr "오즈마와 알토, 그리고 의문의 지원기 안타레스1에 의한 포메이션.\\n셰릴과 란카의 무대를 지키기 위해 바주라를 맞아 싸웠다."

msgid "sn_dsc_1427"
msgstr "브리지에 테이블을 가져와 잠시나마 휴식을 즐기는 여성 크루들.\\n피자 같은 간단한 음식을 먹으며 연애 이야기에 꽃을 피우고 있다."

msgid "sn_dsc_1428"
msgstr "란카의 학원 라이브 연출로 행사장에 흩뿌려진 빛의 입자.\\n열광하던 관객들도 그 빛에 자신도 모르게 넋을 잃고 바라본다."

msgid "sn_dsc_1429"
msgstr "눈부신 미소를 뿌리며 힘차게 새해 놀이와 문화를 즐기는 프레이야.\\n화려한 기모노를 입은 그녀의 룬도 새해를 축하하는 마음으로 반짝반짝 빛난다."

msgid "sn_dsc_1430"
msgstr "【새해를 축하하는 빛】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1431"
msgstr "지구 문화를 따라 새해 첫 붓글씨에 도전하는 마키나.\\n훌륭한 결과물은 손재주뿐만 아니라 그녀만의 감각도 한몫한 것일지도?"

msgid "sn_dsc_1432"
msgstr "지구 문화를 따라 설날답게 떡국을 먹는 레이나.\\n잘 늘어나는 떡이라고 장난치다가는 곧 마키나에게 혼날 것 같다."

msgid "sn_dsc_1433"
msgstr "라이브가 시작되고 수많은 환호가 울려 퍼지는 가운데 당당히 센터에 선 카나메.\\n풍부한 실적과 경험이 빛나는 노래와 춤으로 앞장서서 발키리를 이끌어 간다."

msgid "sn_dsc_1434"
msgstr "연보랏빛 꽃 사이에서 나비와 함께 졸고 있는 미쿠모.\\n미쿠모의 신비로움과 몽환적인 광경이 어우러져 절묘한 아름다움을 만들어낸다."

msgid "sn_dsc_1435"
msgstr "하트 모양 포즈를 완벽하게 취하는 마키나와 레이나.\\n수많은 고난을 넘어 강한 유대를 맺은 두 사람만의 호흡이다."

msgid "sn_dsc_1436"
msgstr "눈부시게 변화하는 무대 위를 자유자재로 날아다니는 발키리.\\n마치 놀이기구 같은 연출과 춤에 관객들은 눈을 뗄 수 없다."

msgid "sn_dsc_1437"
msgstr "무대 위에 홀로그램이 투영되고 빛으로 물드는 발키리.\\n생동감 넘치는 그 연출은 보는 이들을 결코 지루하게 만들지 않는다."

msgid "sn_dsc_1438"
msgstr "라이브 연출 속에 자연스럽게 만들어진 발키리 사인.\\n수수하지만 그 안에는 영혼이 담겨 있었다."

msgid "sn_dsc_1439"
msgstr "프레이야가 발산한 분홍색 파동이 관객석을 가로질러 퍼진다.\\n그리고 그 파동은 행사장 경계를 맡고 있던 하야테 일행의 발키리까지 닿았다."

msgid "sn_dsc_1440"
msgstr "갑자기 라이브 행사장 상공에 나타난 의문의 입방체.\\n이 입방체야말로 이번 발키리의 라이브 스테이지다."

msgid "sn_dsc_1441"
msgstr "1년의 길흉을 점치는 제비뽑기에서 멋지게 대길을 뽑고 기뻐하는 민메이.\\n우아한 기모노를 화려하게 소화하며 새로운 한 해의 시작에 가슴을 설레고 있다."

msgid "sn_dsc_1442"
msgstr "【초봄에 가슴 설레며】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1443"
msgstr "초봄의 따스한 날씨 속에서 진홍색 후리소데를 우아하게 차려입은 밀리아.\\n새해를 축하하는 문화에도 훌륭히 적응했지만, 기모노 입는 법은 대체 누구에게 배운 걸까?"

msgid "sn_dsc_1444"
msgstr "높고 맑게 갠 하늘 아래 멍하니 바라보던 곳에서 매 한 마리를 발견한 바사라.\\n첫 꿈의 연속인가 생각하면서도, 날개를 펼친 그 모습에서 바사라는 확실한 생명력을 느꼈다."

msgid "sn_dsc_1445"
msgstr "폭신한 의상과 머리카락을 흔들며 통통 튀듯 노래하고 춤추는 마키나.\\n녹아내릴 듯 달콤한 노랫소리와 눈빛은 관객을 매료시키고 그 마음을 녹여간다."

msgid "sn_dsc_1446"
msgstr "형형색색의 빛줄기를 끌며 별의 소용돌이 속으로 떨어지는 카나메.\\n떨어지는 듯하면서도 빨려 들어가는 듯한 그 광경은 어딘가 도취적이다."

msgid "sn_dsc_1447"
msgstr "환각 같은 광경의 중심에서 격렬하게 흔들리며 춤추는 미쿠모.\\n혼란스러운 세계 속에서도 미쿠모의 존재감은 전혀 흔들리지 않는다."

msgid "sn_dsc_1448"
msgstr "새로운 계절을 찾아 지구형 행성의 표면을 달리는 프레이야.\\n내민 손과 힘차게 하이파이브를 나누면 그녀의 넘치는 활력이 전해질 것 같다."

msgid "sn_dsc_1449"
msgstr "무대 위를 분홍빛으로 비추며 나타난 홀로그램의 마키나.\\n눈앞에 펼쳐진 역동적인 모습에 닿고 싶어 무심코 손을 뻗게 될 것 같다."

msgid "sn_dsc_1450"
msgstr "무대 연출에서 흐르듯 표현된 춘하추동의 풍경.\\n벚꽃과 푸른 잎, 단풍, 눈 효과가 흩날리며 사계절을 물들이고 있다."

msgid "sn_dsc_1451"
msgstr "불타오르듯 관객석으로 퍼져나가는 불꽃 효과.\\n관객들의 열광까지 더해져 그 기세는 마치 하늘을 태울 듯하다."

msgid "sn_dsc_1452"
msgstr "전개된 멀티 드론에서 투영된 홀로그램 론도.\\n한 치의 오차도 없는 움직임은 높은 기술력과 뛰어난 프로그래밍의 산물이다."

msgid "sn_dsc_1453"
msgstr "철저한 사전 조사와 예습으로 새해 첫날부터 성과를 보여주는 미라쥬.\\n새해의 빛을 받은 그 모습에서는 은은한 자신감과 긍지가 느껴진다."

msgid "sn_dsc_1454"
msgstr "식별 코드에 의해 미라쥬의 퍼스널 컬러인 적자색으로 변화한 Sv-262Ba.\\n탈취한 적기를 즉시 조종하는 모습에서 미라쥬의 뛰어난 조종 실력을 엿볼 수 있다."

msgid "sn_dsc_1455"
msgstr "델타 소대를 이끄는 존재답게, 일본식 의상을 입어도 차분한 멋을 보여주는 아라드.\\n신뢰하는 부하들과 함께 새로운 출발을 준비할 만반의 태세를 갖춘 모습이다."

msgid "sn_dsc_1456"
msgstr "중위로 승진해 과거 메서가 맡았던 델타2 포지션에 오른 미라쥬.\\n작전 전체를 봐야 하는 아라드를 대신해 델타 소대를 맡게 되었다."

msgid "sn_dsc_1457"
msgstr "어깨를 감싸고 몸을 기댄 듯한 모습으로 황홀한 눈길을 보내는 프레이야.\\n넘쳐나는 하트 효과까지 더해져 가슴이 찡해질 것만 같다."

msgid "sn_dsc_1458"
msgstr "무너져 내리는 듯한 무대 위에서 도발적으로 손끝으로 유혹하는 미쿠모.\\n압도적인 자신감이 느껴지는 태도와 눈빛에 관객도 무대도 그대로 휘둘린다."

msgid "sn_dsc_1465"
msgstr "지구의 오래된 문헌에 남아 있는 게이샤의 최고위 계급 『다유』 같은 화려함을 보여주는 셰릴.\\n요염하면서도 품격이 느껴지는 차림새가 셰릴의 미모를 더욱 돋보이게 한다."

msgid "sn_dsc_1466"
msgstr "같은 소속사의 선배인 도쿠가와 키이치로와 함께 프로모션 활동에 힘쓰는 란카.\\n영양 만점 당근을 한 손에 들고, 젠트라디 사이즈의 꿈을 이루기 위해 오늘도 노력한다."

msgid "sn_dsc_1467"
msgstr "넘치는 마음에 몸을 맡기고, 멀리 흐르는 은하를 배경으로 영혼을 담아 열창하는 셰릴.\\n꺾어 부르는 창법과 비브라토는 2만 광년 너머의 은하까지 울려 퍼질 것 같다."

msgid "sn_dsc_1468"
msgstr "사오토메 일문의 형제 제자로 함께 기예를 갈고닦아 온 알토와 야사부로.\\n배우로서 두 사람의 재능은 연습 장면조차 강렬한 무대의 한 장면처럼 보일 정도다."

msgid "sn_dsc_1469"
msgstr "란조의 지시에 따라 본보기를 보여주는 야사부로. 그의 마음속은 알토에 대한 걱정으로 가득했다.\\n「사람은 이루지 못하기에 꿈을 꾸는 것인가, 이루지 못하기에 꿈인 것인가」─야사부로"

msgid "sn_dsc_1470"
msgstr "미호시 학원에 나타난 야사부로를 알토가 「형님」이라고 부른 것에 놀라는 미셸과 루카.\\n알토에게는 형제 제자에 해당하는 사람이지만, 두 사람은 그런 사실을 알 리 없었다."

msgid "sn_dsc_1471"
msgstr "낮에 야사부로와 나눈 대화를 떠올리며 부적을 바라보던 알토.\\n진지하게 생각에 잠겨 있었던 탓인지, 등에 손가락이 찔리자 깜짝 놀라고 말았다."

msgid "sn_dsc_1472"
msgstr "자신감은 어디서 나오는 거냐는 알토의 질문에 당연하다는 듯 대답하는 셰릴.\\n그녀가 셰릴 놈이기에 가능한, 단순명료한 정체성이다."

msgid "sn_dsc_1473"
msgstr "루카의 컴퓨터 모니터에 표시된 가부키 배우로서의 야사부로 정보.\\n알토가 집을 나가버린 탓인지 차기 종가의 가장 유력한 후보가 되어 있었다."

msgid "sn_dsc_1474"
msgstr "위문 라이브를 위해 행성 갈리아4로 향하는 셰릴과 그녀를 호위하는 알토.\\n기존 폴드 기술로 항행한다면 도착까지 7일이 걸리는 긴 여행이다."

msgid "sn_dsc_1475"
msgstr "아이랜드3의 젠트라디 몰 『포르모』 입구 부근.\\n마이크론용 통로도 정비되어 있으며, 한편에는 무명 가수의 모습도 보인다."

msgid "sn_dsc_1476"
msgstr "아이랜드1 천개 내부에 홀로그램으로 재현된 아침 해.\\n낮과 밤이 없는 우주 공간에서 이민선의 사람들은 이 인공적인 빛으로 새벽을 맞이한다."

msgid "sn_dsc_1477"
msgstr "민메이 구출 장면을 재현하는 촬영에 도전하는 두 사람. 밀레느는 익숙하지 않은 공중 연기에\\n당황해 바사라의 손을 제대로 잡지 못했지만, 바사라는 평소와 다름없는 모습이었다."

msgid "sn_dsc_1479"
msgstr "전장에서 적이 철수하고 다시 노래를 들려주지 못했다며 풀이 죽은 바사라.\\n한편 밀레느는 전장에서 노래하는 것을 통해 이야기의 한 가지 답을 찾아내고 있었다."

msgid "sn_dsc_1480"
msgstr "드라마 내용은 군과 시티 오피스의 홍보 영상으로 꾸며져 있었다.\\n바사라는 그 의도를 알고, 너무나도 시원하게 촬영을 내팽개쳤다."

msgid "sn_dsc_1481"
msgstr "대역 보비가 출연할 수 없게 되자 마지못해 이치조 히카루 역을 맡은 바사라.\\n원래 내키지 않았던 탓에 촬영이 시작된 뒤에도 자신도 모르게 불평이 흘러나왔다."

msgid "sn_dsc_1482"
msgstr "드라마 제작 발표회에 스페셜 게스트로 초대된 밀리아와 맥스.\\n세상에 좋은 관계임을 어필하면서도 어색함은 감추지 못하는 듯하다."

msgid "sn_dsc_1483"
msgstr "마크로스 시민들의 비판을 피하기 위한 영상 제작을 교활한 수단이라며 일축하는 밀리아.\\n그럼에도 출연을 받아들인 배경에는 정체불명의 적에 대한 초조함도 있었을 것이다."

msgid "sn_dsc_1484"
msgstr "찰나의 순간 밀레느에게 달려드는 흡혈귀 사이에 끼어들고, 덤으로 보비까지 구해낸 바사라.\\n험한 말을 하면서도 누구도 버리지 않는 점은 역시 바사라답다고 할 수 있다."

msgid "sn_dsc_1485"
msgstr "촬영용으로 VF-1J처럼 꾸며진 바사라의 발키리.\\n장식이라고 해도 거의 허수아비 수준이라, 바사라에게는 마음에 들지 않는 모습이다."

msgid "sn_dsc_1486"
msgstr "대기실 소파에 앉아 한숨 섞인 말을 중얼거리는 맥스.\\n함장인 이상 익숙하지 않은 역할을 연기해야 할 때도 있는 모양이다."

msgid "sn_dsc_1487"
msgstr "린 민메이의 업적을 기리는 스페셜 드라마의 대본.\\n실제 내용은 군과 시티 오피스의 홍보 영상이라는 의미가 강한 것이었다."

msgid "sn_dsc_1488"
msgstr "촬영이 시작되고 봉쇄된 촬영장 게이트.\\n역시 안으로 들어갈 수 없었던 것인지, 꽃다발의 소녀가 밖에서 쓸쓸히 상황을 지켜보고 있다."

msgid "sn_dsc_1489"
msgstr "드라마 촬영에서 린 민메이 역을 연기하기 위해 진지하게 역할 준비에 힘쓰는 밀레느.\\n당시를 재현한 의상을 입고 민메이에 대한 동경을 품은 채 무대로 내려섰다."

msgid "sn_dsc_1491"
msgstr "전장에서 노래하는 바사라에게 린 민메이의 모습을 겹쳐 보고, 자신도 마이크를 든 밀레느.\\n섬광과 충격을 견디며 밀레느 역시 이야기 속 가희처럼 노래를 울려 퍼뜨린다."

msgid "sn_dsc_1492"
msgstr "드라마 제작 발표회에 스페셜 게스트로 초대된 밀리아.\\n단상 스크린에는 붉은 콰드란을 타던 과거의 밀리아 모습이 비춰지고 있었다."

msgid "sn_dsc_1493"
msgstr "진짜 목적을 눈치챈 밀레느를 붙잡아 말리려는 보비.\\n몇 차례 실랑이 끝에 보비는 밀레느에게 금기어를 입에 담고 만다."

msgid "sn_dsc_1494"
msgstr "순조롭게 보였던 드라마 촬영이었지만, 정체불명의 부대가 나타남과 동시에 상황은 완전히 바뀐다.\\n「저건 촬영용 머신이 아니야, 진짜 적이다!」「거짓말~!?」─바사라, 밀레느"

msgid "sn_dsc_1495"
msgstr "다이아몬드 포스 대원인 감린도 요격을 위해 같은 우주 영역으로 출격해 있었다.\\n감린은 전장에 울려 퍼지는 노랫소리에서 희미하게나마 밀레느의 목소리를 느꼈다."

msgid "sn_dsc_1496"
msgstr "흡혈귀에게 습격당한 보비를 곁눈질하며 밀레느의 부주의함을 꾸짖는 바사라.\\n밀레느도 반성할 점이 있었는지 바사라의 말에 풀이 죽은 표정을 지었다."

msgid "sn_dsc_1497"
msgstr "정체불명의 부대 출현에 당황하는 프로듀서에게 냉정하게 상황을 분석하는 밀리아.\\n그 침착한 모습은 그녀가 아직 전사로서 건재하다는 것을 보여주는 듯했다."

msgid "sn_dsc_1498"
msgstr "맥스의 내레이션과 함께 비춰진 젠트라디군 소속 시절의 밀리아.\\n한때 수많은 발키리를 격추하며 통합군에서도 두려워하던 존재였다."

msgid "sn_dsc_1499"
msgstr "드라마 제작 발표회 현장에 있던 젠트라디 출연진들.\\n역할 준비 때문인지 거인의 모습 그대로 다른 출연자들에게 인사를 하고 있는 듯하다."

msgid "sn_dsc_1500"
msgstr "무인 카메라 제어와 감독이 촬영 지휘를 하기 위해 사용하던 중계함.\\n촬영 우주 영역에서 전투가 시작된 뒤에도 몰래 카메라를 계속 돌리고 있었다."

msgid "sn_dsc_1501"
msgstr "성간 대전 종결 30주년 기념식에서 마크로스 시티 상공을 춤추는 샤론의 홀로그램.\\n폭주한 샤론에게 지배된 이곳에서 사랑과 증오가 뒤섞인 이야기는 클라이맥스를 맞이한다."

msgid "sn_dsc_1503"
msgstr "콘서트 중 얀의 해킹으로 관객석으로 끌려온 샤론.\\n하지만 샤론은 얀의 앞이 아닌, 옆에 있던 이사무 앞에 서서 입을 맞췄다."

msgid "sn_dsc_1504"
msgstr "하늘을 나는 것을 무엇보다 좋아하고, 파일럿으로서도 천재적인 조종 감각을 가진 이사무.\\n하지만 3번이나 받은 「로이 포커 훈장」을 3번 모두 박탈당한 문제아라는 면도 있다."

msgid "sn_dsc_1505"
msgstr "지구에서 쌓이고 쌓인 울분을 풀기라도 하듯 서로 부딪히는 이사무와 갈드.\\n격렬한 도그파이트와 난전, 말싸움의 연속은 그야말로 팽팽한 공방전을 보여준다."

msgid "sn_dsc_1506"
msgstr "오퍼레이터 루시를 오토바이 뒷좌석에 태우고 고속도로를 달리는 이사무.\\n스릴을 마음껏 즐기는 이사무의 모습에 굳어 있던 루시의 표정도 저절로 풀렸다."

msgid "sn_dsc_1507"
msgstr "YF-19의 수석 설계자인 얀과 이사무는 기체 취급 문제로 끊임없이 말다툼을 벌인다.\\n그럼에도 YF-19의 평가를 순조롭게 만회해 가는 것을 보면 의외로 좋은 콤비일지도 모른다."

msgid "sn_dsc_1508"
msgstr "곡에 맞춰 노랫소리와 외모를 요염한 소녀의 모습으로 변화시킨 샤론.\\n대중이 원하는 모습을 자유롭게 연기할 수 있다는 것은 버추얼 아이돌만의 매력이라 할 수 있다."

msgid "sn_dsc_1509"
msgstr "샤론의 실체인 인공지능이 담긴 금속제 블랙 BOX.\\n많은 관객에게 열광적인 환영을 받은 그 모습은 아이돌의 새로운 시대를 느끼게 했다."

msgid "sn_dsc_1510"
msgstr "통합 우주군의 차기 주력 가변 전투기를 결정하는 경쟁 「슈퍼 노바 계획」.\\n고성능 YF-19와 최신 기술의 집약체인 YF-21이 치열한 채용 경쟁을 벌였다."

msgid "sn_dsc_1511"
msgstr "평가 시험 내용을 완전히 무시하고 이사무가 YF-19로 하늘에 그려낸 용새.\\n천재적인 조종 감각이 만들어낸 기술이지만, 이후 이사무는 3일간 탑승 금지 처분을 받았다."

msgid "sn_dsc_1512"
msgstr "풍력 발전용 풍차가 늘어서 있는 행성 에덴의 별 언덕.\\n이사무와 갈드, 그리고 뮤른 세 사람에게도 추억이 깃든 장소다."

msgid "sn_dsc_1513"
msgstr "7년 전의 기억을 되찾은 갈드는 진정한 의미에서 이사무와 재회했다.\\n두 사람의 미소와 따뜻한 석양이 얼어붙었던 갈드의 앙금을 천천히 녹여간다."

msgid "sn_dsc_1514"
msgstr "샤론의 라이브를 위해 고향인 행성 에덴으로 돌아온 뮤른.\\n공교롭게도 같은 시기에 이사무와 갈드 두 사람도 행성 에덴으로 돌아오게 되었다."

msgid "sn_dsc_1515"
msgstr "7년 전 일어난 사건을 계기로 이사무와 갈라서게 된 갈드.\\n재회한 뒤에도 뮤른과 프로젝트를 둘러싸고 두 사람의 대립은 더욱 깊어져 간다."

msgid "sn_dsc_1516"
msgstr "한때 가수가 되기를 꿈꾸며 고등학교 시절에는 직접 작곡도 했던 뮤른.\\n한 번 버렸던 노래를 다시 듣게 된 뮤른의 눈에서는 수많은 눈물이 흘러내렸다."

msgid "sn_dsc_1517"
msgstr "YF-21 개발 주임 겸 테스트 파일럿을 맡으며 프로젝트에 절대적인 자신감을 가진 갈드.\\nYF-19에 새로운 테스트 파일럿이 온다는 말을 들었을 때도 여유로운 표정으로 대답할 정도였다."

msgid "sn_dsc_1518"
msgstr "7년 전 일을 회상하는 이사무에게 마치 미련을 털어낸 듯한 표정으로 농담을 던지는 갈드.\\n그 목소리에는 분노나 원망은 없고, 과거와 친구를 되찾은 안도감이 배어 있었다."

msgid "sn_dsc_1525"
msgstr "세련된 분위기를 풍기며 발키리 안에서도 유난히 가볍게 춤추는 레이나.\\n장난을 좋아하는 그녀의 성격까지 더해져 그 모습은 마치 바람에 춤추는 요정 같다."

msgid "sn_dsc_1526"
msgstr "행성 볼도르에서의 전술 라이브 중 유적과 공명한 노랫소리에서 불길한 기운을 느끼는 레이나.\\n「답답해, 둥둥 울려… 노래가 무거워…?」─레이나"

msgid "sn_dsc_1527"
msgstr "분투하는 하야테와 계속 노래하는 미쿠모의 모습에 감동받아 다시 노래하기 시작하는 프레이야.\\n레이나가 리셉터 수치를 확인하자 그곳에는 빛나는 액티브 반응이 나타나 있었다."

msgid "sn_dsc_1528"
msgstr "첫 무대에서 당당히 센터에 서서 빛을 발하는 프레이야.\\n사과 행성이 떠 있는 환상적인 무대에서 새 멤버다운 힘찬 모습을 보여주었다."

msgid "sn_dsc_1529"
msgstr "무대 위를 자유롭게 날아다니며 관객들과 하이파이브를 나누는 발키리.\\n팬들뿐만 아니라 첫 무대를 선 프레이야에게도 잊지 못할 멋진 경험이다."

msgid "sn_dsc_1530"
msgstr "곡이 간주에 들어간 틈을 타 관객을 포함한 각종 수치를 측정하는 발키리.\\n프레이야의 리셉터 수치에 관해서는 안타깝게도 논액티브인 듯하다."

msgid "sn_dsc_1531"
msgstr "첫 무대를 앞두고 긴장으로 불안을 키워가는 프레이야.\\n그에 대해 하야테는 프레이야의 말을 빌리는 형태로 밝게 격려했다."

msgid "sn_dsc_1532"
msgstr "일부러 하야테가 마음껏 날도록 두고, 쇼가 성공한 것에 만족스러운 표정을 짓는 아라드.\\n개성 강한 델타 소대를 통솔하는 넓은 도량과 책략가로서의 면모가 드러나는 순간이다."

msgid "sn_dsc_1533"
msgstr "발키리의 노랫소리에 맞춰 자유롭게 무대 위에서 춤추는 하야테의 VF-31.\\n눈앞에서 펼쳐지는 역동적인 춤에 관객들도 크게 열광하고 있다."

msgid "sn_dsc_1534"
msgstr "바르화한 통합군 VF-171을 향해 배리어를 전개하고 돌진하는 하야테의 VF-31.\\n아슬아슬한 순간에 프레이야를 위기에서 구해내는 데 성공했다."

msgid "sn_dsc_1535"
msgstr "발키리의 신입 멤버인 프레이야에게 응원을 보내는 관객들.\\n가끔 웃음소리도 들려오지만, 따뜻하게 받아들여지고 있는 듯하다."

msgid "sn_dsc_1536"
msgstr "발키리의 백신 라이브 모습을 지켜보는 로이드.\\n때가 되자 대기시키고 있던 전군에게 명령을 내렸다."

msgid "sn_dsc_1537"
msgstr "어둠에 녹아들 듯 새까만 의상을 걸치고, 형형색색의 디저트에 둘러싸인 미쿠모.\\n쓴맛과 떫은맛마저 감춰버릴 듯한 신비로운 달콤함에 몸과 마음이 녹아내릴 것 같다."

msgid "sn_dsc_1539"
msgstr "장을 보던 중 갑자기 초콜릿을 꺼내 건네려 하는 미라쥬.\\n돌아다니는 동안 사뒀다고 하지만, 그런 기색은 전혀 보이지 않았는데… 설마 직접 만든 것일까?"

msgid "sn_dsc_1540"
msgstr "초콜릿을 건네려 하지만 좀처럼 결심하지 못하는 듯한 클란.\\n계속 빤히 바라보고 있으면, 어느 순간 초콜릿을 집어 던질지도 모른다."

msgid "sn_dsc_1541"
msgstr "하야테와의 만남부터 생일 선물을 계기로 점점 성장해 가는 프레이야의 노랫소리.\\n솔로로 무대에 선 프레이야의 모습을 미쿠모는 무대 뒤에서 뜨거운 시선으로 바라보고 있었다."

msgid "sn_dsc_1542"
msgstr "스페셜 라이브 홍보 영상의 마지막을 장식하며 강렬한 말을 던지는 미쿠모.\\n그 말에는 윈더미어의 지배에는 절대 굴복하지 않겠다는 강한 의지가 담겨 있었다."

msgid "sn_dsc_1543"
msgstr "스페셜 라이브를 통해 모두에게 힘을 전하고 싶다는 마음을 전하는 프레이야.\\n그 마음은 은하 네트워크를 보고 있던 윈더미어 병사들에게도 전해졌다."

msgid "sn_dsc_1544"
msgstr "바이러스 침식률 100%를 눈앞에 둔 순간, 멤버들에게 기합을 불어넣는 카나메.\\n스페셜 라이브도 드디어 막바지, 작전 성공을 건 마지막 질주다."

msgid "sn_dsc_1545"
msgstr "은하 네트워크에 대한 바이러스 침식 작전을 지휘하는 어니스트.\\n에리시온의 크루들도 스페셜 라이브 뒤에서 작전의 진행 상황을 지켜보고 있었다."

msgid "sn_dsc_1546"
msgstr "라이브 영상과 함께 바이러스 침식률을 보고하는 에리시온의 크루들.\\n레이나가 직접 만든 바이러스는 엄청난 속도로 은하 네트워크를 침식해 나갔다."

msgid "sn_dsc_1547"
msgstr "윈더미어의 지배에 맞서 노래로 대항하는 발키리.\\n라이브 영상은 은하 네트워크를 통해 구상성단 전역으로 전달되었다."

msgid "sn_dsc_1548"
msgstr "힘껏 내디딘 충격으로 산산이 부서진 발키리의 각반.\\n지면에 생긴 수많은 균열은 그녀들의 강한 의지를 나타내는 듯하다."

msgid "sn_dsc_1549"
msgstr "희미한 푸른빛이 감도는 의상에 감싸인 채, 정적과 슬픔이 지배하는 세계에 갇힌 란카.\\n지금은 움직일 수 없더라도, 분명 소중한 동료들이 내미는 손이 그녀에게 용기를 줄 것이다."

msgid "sn_dsc_1551"
msgstr "우주 공간에 울려 퍼지는 노랫소리에 이끌리듯 란카의 환영에게 모여드는 바주라들.\\n그리고 손을 뻗는 란카의 움직임에 호응하듯 바주라들은 일제히 포격을 퍼부었다."

msgid "sn_dsc_1552"
msgstr "란카와 상담하던 중 갑자기 나타난 바주라를 보고 반사적으로 총을 겨누는 알토.\\n하지만 다음 순간 눈앞에 들어온 것은 몸을 던져 바주라를 감싸는 란카의 모습이었다."

msgid "sn_dsc_1553"
msgstr "어머니에게 들었던 진짜 하늘에 대한 이야기를 마치 동화처럼 느꼈던 알토.\\n그리고 그 하늘은 이민선에서 태어나고 자란 알토에게 동경의 대상이 되어갔다."

msgid "sn_dsc_1554"
msgstr "란카의 환영 주변에서 방어 태세를 갖추듯 진형을 이루는 바주라들.\\n완벽하게 통제된 그 움직임은 마치 공주를 지키는 기사와 같았다."

msgid "sn_dsc_1555"
msgstr "바주라의 행성을 침략자로부터 지키는 것이 자신들 남매의 사명이라고 말하는 브레라.\\n그 살기 어린 움직임은 알토와 클란을 동시에 상대하며 압도할 정도였다."

msgid "sn_dsc_1556"
msgstr "통제된 바주라의 일제 포격을 받아 폭발하며 불타오르는 프론티어 선단의 콜로니.\\n포격을 피한 알토는 그 참혹한 광경을 보고 한동안 멍하니 서 있었다."

msgid "sn_dsc_1557"
msgstr "그리피스 파크 언덕에 원격 조작으로 나타난 브레라의 VF-27γ.\\n시제형 폴드 부스터를 통해 폴드 단층을 넘어 폴드가 가능하다."

msgid "sn_dsc_1558"
msgstr "반지에 들어 있는 사진을 향해 혼잣말하듯 말을 거는 리처드 빌러.\\n바주라를 둘러싸고 암약하는 자들의 뒤편에서, 그 역시 다른 목적을 품고 움직이고 있었다."

msgid "sn_dsc_1559"
msgstr "알토에게 종이비행기 접는 법을 배우는 란카.\\n조금 서툰 손놀림이지만 알토의 접는 방식을 따라 종이비행기를 완성했다."

msgid "sn_dsc_1560"
msgstr "리처드 빌러의 손가락에 끼워져 있던 로켓 장치를 가진 반지.\\n그 안에는 그가 존경하는 가희의 사진이 들어 있었다."

msgid "sn_dsc_1561"
msgstr "얇고 투명한 듯한 의상을 입고, 슬픔이 담긴 노랫소리를 따라가는 프레이야.\\n그리고 슬픔 속에서 떨고 있는 하나의 빛에 다다르자, 조용히 손을 내밀었다."

msgid "sn_dsc_1563"
msgstr "윈더미어 스파이 의혹에 맞서 신뢰를 얻기 위해 더욱 노력하겠다고 다짐하는 프레이야.\\n미쿠모는 순간 어안이 벙벙했지만, 이내 평소와 같은 자신만만한 미소를 지었다."

msgid "sn_dsc_1564"
msgstr "룬을 창백하게 빛내면서도 평소처럼 태연하게 행동하는 프레이야.\\n그런 프레이야의 모습에 하야테는 말로 표현할 수 없는 답답함과 안타까움을 느끼고 있었다."

msgid "sn_dsc_1565"
msgstr "프레이야를 정면으로 공격하기 위해 나체먹낭낭에 찾아온 언론을 비난하는 마키나와 레이나.\\n그 결과 언론의 관심은 프레이야뿐만 아니라 마키나와 레이나에게도 향하게 되었다."

msgid "sn_dsc_1566"
msgstr "의심의 시선을 받으면서도 그래도 발키리에 남고 싶다고 털어놓는 프레이야.\\n계속 노래하고 싶지만, 폐를 끼치고 싶지는 않다는 갈등이 프레이야 안에서 소용돌이치고 있었다."

msgid "sn_dsc_1567"
msgstr "무단으로 발키리를 출격시킨 하야테에게 반란 혐의에 의한 격추를 암시하는 메서.\\n콕핏에 울려 퍼지는 록온 경보에 하야테와 프레이야는 당황할 수밖에 없었다."

msgid "sn_dsc_1568"
msgstr "프레이야의 경솔한 행동을 꾸짖은 뒤 카나메에게 보고하는 것까지 언급하는 메서.\\n한편 하야테의 행동은 논외라며, 설교할 가치조차 없다고 단정했다."

msgid "sn_dsc_1569"
msgstr "식감이 끝내주는 해파리 칩스는 한번 손대면 멈출 수 없을 것이다.\\n「기간 한정, 마요 칠미 맛」─레이나"

msgid "sn_dsc_1570"
msgstr "풀이 죽은 프레이야를 기운 내게 하려고 야간 자율 훈련이라는 명목으로 데리고 나간 하야테.\\n물론 허가가 없다면 중대한 군 규율 위반이며, 반란을 의심받아도 할 말 없는 행동이지만…?"

msgid "sn_dsc_1571"
msgstr "그럴듯하게 퍼지고 있는 프레이야의 스파이 의혹.\\n은하 네트워크에서도 토론 프로그램이 방송될 정도로 과열되고 있다."

msgid "sn_dsc_1572"
msgstr "해가 진 해안가 바위 위에서 쉬고 있는 갈매기들.\\n몸을 둥글게 말고 잠드는 모습도 지구의 고양이와 똑같다."

msgid "sn_dsc_1573"
msgstr "과거와 미래를 이어 학원 라이브에 나타난 바사라가 교복 차림으로 관객들을 열광시킨다.\\n초시공 네트워크가 만들어낸 기적의 컬래버레이션에 관객들의 열기도 최고조에 달했다."

msgid "sn_dsc_1574"
msgstr "바사라의 VF-19改에 「은하의 요정」 셰릴 놈의 도색을 입힌 기체.\\n불타오르는 사운드와 열정의 이미지는 은하의 별들을 뜨겁게 뒤흔들 것이다."

msgid "sn_dsc_1575"
msgstr "혼수상태에서 부활해 스피리치아 넘치는 노랫소리와 함께 전장으로 돌아온 바사라.\\n그리고 게페르니치에게 노래를 들려주기 위해 충격파의 폭풍 속으로 돌진해 갔다."

msgid "sn_dsc_1576"
msgstr "바사라의 의식이 끊어지려던 순간, 어린 시절의 결의와 노랫소리가 다시 노래할 힘을 되찾게 했다.\\n「산이여! 은하여!! 내 노래를 들어라!!!」─바사라"

msgid "sn_dsc_1577"
msgstr "이민선 천장에 매달린 채 무언가를 기다리며 가만히 있던 바사라.\\n그리고 이민선의 천개에 달이 떠오르는 것을 확인한 뒤, 자신만만한 미소를 지었다."

msgid "sn_dsc_1579"
msgstr "라이브에 지각하고도 미안한 기색조차 보이지 않는 바사라에게 입을 삐죽이는 밀레느.\\n한편 바사라는 싱긋 웃어 보일 뿐, 전혀 신경 쓰지 않는 모습이었다."

msgid "sn_dsc_1585"
msgstr "때와 장소가 달랐다면 가능했을지도 모를, 학생으로서 평범한 학원 생활을 보내는 바사라.\\n함께 등하교를 하거나, 갑자기 벽에 손을 짚는 듯한 사고가 있었을지도…?"

msgid "sn_dsc_1587"
msgstr "열차 위에 올라탄 채 홀로 목적지 없는 방랑 여행을 계속하는 바사라.\\n하늘을 올려다보는 표정에는 자유를 향한 기쁨과 새로운 세계에 대한 기대가 가득했다."

msgid "sn_dsc_1588"
msgstr "바사라의 몫까지 분위기를 띄우려 했지만, 결국 노래를 이어가지 못하게 된 밀레느.\\n노래가 끊긴 것을 웃는 얼굴로 얼버무리는 밀레느의 모습은 어딘가 안쓰러움을 느끼게 했다."

msgid "sn_dsc_1589"
msgstr "감린의 아무렇지 않은 배려의 말에 무언가 고민하는 듯한 표정을 짓는 밀레느.\\n평소처럼 행동하고 있었지만, 바사라의 부재는 밀레느에게 영향을 주고 있었다."

msgid "sn_dsc_1590"
msgstr "밀레느를 걱정해 바사라를 데려오기로 결심하는 감린.\\n하지만 밀레느와의 관계를 걱정받자 자신도 모르게 당황하고 말았다."

msgid "sn_dsc_1591"
msgstr "행성 졸라를 방랑하던 중 무장 집단과 순찰대의 총격전에 휘말린 바사라.\\n서로의 말을 들으려 하지 않는 두 세력을 향해 바사라는 기타를 치며 노래하기 시작했다."

msgid "sn_dsc_1592"
msgstr "방랑 여행 도중 눈을 뜰 수 없을 정도의 강풍 속을 나아가는 바사라.\\n거친 대자연의 시련을 받으면서도 아직 보지 못한 새로운 땅을 향해 계속 나아간다."

msgid "sn_dsc_1593"
msgstr "화물을 운반하는 카트 짐칸에서 시작된 즉흥 미니 라이브.\\n사람과 화물의 흐름을 타고 울려 퍼지는 자유로운 노랫소리는 운전자들에게도 호평인 듯하다."

msgid "sn_dsc_1594"
msgstr "바사라와 밀레느의 입간판을 나란히 세워 어떻게든 분위기를 띄우려 하는 레이.\\n「저 녀석들이라고 생각하고 응원해 줘.」─레이"

msgid "sn_dsc_1595"
msgstr "Fire Bomber 라이브에 몰려든 행사장 가득한 관객들.\\n바사라의 부재를 밀레느가 알렸지만, 관객들의 열기는 식지 않았다."

msgid "sn_dsc_1596"
msgstr "보컬이 사라져 버렸기에 라디오카세트로 노래를 틀어주는 레이.\\n바사라와 밀레느의 부재를 지탱하는 레이의 고생이 느껴진다."

msgid "sn_dsc_1597"
msgstr "Fire Bomber의 열혈 가수 바사라가 가진 노래에 대한 열정에 셰릴은 강한 공감을 느끼고 있었다.\\n특별히 준비한 의상은 섹시한 매력과 함께 바사라를 향한 넘치는 오마주가 폭발하고 있었다."

msgid "sn_dsc_1599"
msgstr "엘리베이터 위 차량 안에서 조용히 눈을 내리깔고, 자신이 싸우는 의미를 다시 한번 마음에 새기는 오즈마.\\n「너도, 네 꿈도 내가 지킨다!」─오즈마"

msgid "sn_dsc_1600"
msgstr "기체 피격을 생채기라고 넘기며 자신을 말리는 캐시에게 미소로 답하는 오즈마.\\n「여동생도, 사랑하는 여자도!! 지키지 못하면서 뭐가 남자냐!!」─오즈마"

msgid "sn_dsc_1601"
msgstr "페널티 중 뒷담화를 한 결과, 주행 횟수가 추가되어 버린 알토와 미셸.\\n그 무자비한 통보에 알토도 거부감을 숨기지 못하고 있는 힘껏 얼굴을 찡그렸다."

msgid "sn_dsc_1602"
msgstr "전투 중 입은 부상으로 한때 의식을 잃었지만, 놀라운 회복력을 보여준 오즈마.\\nS.M.S 대원들과 캐시는 어이없어하면서도 모두 안도의 표정을 지었다."

msgid "sn_dsc_1603"
msgstr "Fire Bomber의 열렬한 팬이며, 그 사운드로 파워업한다고까지 말하는 오즈마.\\n작전 중에도 구호처럼 Fire Bomber의 곡 제목을 외치는 등, 그의 애정은 진심이다."

msgid "sn_dsc_1604"
msgstr "캐시와 헤어지는 순간, 개인적으로 추억이 담긴 파인애플 케이크를 부탁하는 오즈마.\\n그 옆모습에는 옛날을 그리워하는 듯 부드러운 표정이 떠올라 있었다."

msgid "sn_dsc_1605"
msgstr "란카를 민메이에 비유하는 람 일행에게 너무 오래됐다며 바사라를 예로 드는 보비.\\n「(작게) 그래도 너무 오래됐어요…」─람"

msgid "sn_dsc_1606"
msgstr "나이프 하나로 바주라와 격렬한 근접전을 벌이는 오즈마의 VF-25S.\\n오즈마의 의지를 담은 날카로운 일격은 바주라의 장갑을 꿰뚫고 팔을 잘라냈다."

msgid "sn_dsc_1607"
msgstr "오즈마의 애마에 장착되어 있던 카 내비게이션.\\n은하 네트워크에도 접속되어 있어 각종 콘텐츠 확인도 가능한 듯하다."

msgid "sn_dsc_1608"
msgstr "예전에 오즈마가 캐시에게 만드는 법을 배워 란카를 위해 만든 파인애플 케이크.\\n오즈마와 란카 남매에게는 추억의 맛이다."

msgid "sn_dsc_1609"
msgstr "만개한 벚꽃 아래, 화사한 햇살과 흩날리는 꽃잎의 배웅을 받으며 교정을 걷는 민메이.\\n그 눈에는 지금까지의 감사와 떠나는 기쁨, 그리고 아주 조금의 쓸쓸함이 배어 있었다."

msgid "sn_dsc_1610"
msgstr "미사를 구해내기 위해서였다고는 해도, 또다시 명령을 무시하게 된 히카루.\\n난처한 표정을 짓는 히카루에게 미사는 다정한 미소로 답했다."

msgid "sn_dsc_1611"
msgstr "기지에 남겨진 미사를 구하기 위해 히카루는 미사의 제지를 듣지 않고 기지로 향했다.\\n「그런 명령, 지금까지 지킨 적 없잖아요」─히카루"

msgid "sn_dsc_1612"
msgstr "결전을 앞두고 다시 한번 노래를 들려달라는 엑세돌의 부탁에 응하는 민메이.\\n그 자리에 있던 히카루 역시 마지막이 될지도 모를 노랫소리에 조용히 귀를 기울였다."

msgid "sn_dsc_1613"
msgstr "출격 준비를 마친 히카루 앞에 결연한 표정으로 나타난 민메이.\\n히카루의 갑작스러운 고백과 목숨을 건 각오를 한 모습에 놀라움과 당혹감을 감추지 못했다."

msgid "sn_dsc_1614"
msgstr "보돌 기간 함대의 포격으로 불타 사라지는 지구를 눈앞에서 바라보는 히카루와 민메이.\\n그 광경에 좌절하면서도 히카루는 지구에 남은 미사의 안위를 걱정하고 있었다."

msgid "sn_dsc_1615"
msgstr "아침 햇살을 받으며 지상으로 내려오는 마크로스와 그 위용을 바라보는 히카루와 미사.\\n미래로 이어진 희망에 기뻐하며 두 사람은 조용히 서로에게 기대었다."

msgid "sn_dsc_1616"
msgstr "보돌 기간 함대의 습격을 받고 즉시 출격 준비에 나서는 맥스와 밀리아.\\n부부가 모두 에이스 파일럿인 만큼, 그야말로 환상의 호흡을 보여준다."

msgid "sn_dsc_1617"
msgstr "미사를 구하기 위해 머리 부분 4문의 레이저를 집중시켜 격벽을 녹여내는 히카루의 VF-1S.\\n건포드보다는 위력이 떨어지지만, 사용법에 따라 이런 일도 가능하다."

msgid "sn_dsc_1618"
msgstr "전군용 주파수로 전장에 울려 퍼지는 민메이의 노래에 귀를 기울이는 카무진 일행.\\n승산이 없다고 생각했던 카무진을 다시 전장으로 향하게 만든 것은 그 노랫소리였다."

msgid "sn_dsc_1619"
msgstr "히카루가 가지고 있던 헬멧에 비쳐 보이는 민메이의 모습.\\n마치 두 사람이 살아가는 세계의 간극을 나타내는 듯하다."

msgid "sn_dsc_1620"
msgstr "알래스카 기지에서 발사된 그랜드 캐논의 거대한 포격선.\\n비틀듯 발사된 일격은 보돌 기간 함대를 쓸어버리고 수많은 전함을 격침시켰다."

msgid "sn_dsc_1621"
msgstr "우주처럼 깊은 푸른색 의상을 입고 별빛 무대에 내려선 프레이야.\\n별들이 비추는 은하의 빛에 뒤지지 않을 만큼 생생한 빛을 발하고 있다."

msgid "sn_dsc_1623"
msgstr "나체먹낭낭의 방 안에서 무릎을 끌어안고 홀로 깊은 생각에 잠긴 표정을 짓는 프레이야.\\n아직 의식을 되찾지 못한 하야테를 향한 마음이 커져만 가고 있었다."

msgid "sn_dsc_1624"
msgstr "노래를 병기라고 말하는 벨거의 오만한 태도에 분노가 치미는 미라쥬.\\n하지만 동시에 프레이야에게 해줄 말이 아무것도 없는 자신을 깨닫고 말았다."

msgid "sn_dsc_1625"
msgstr "노래는 병기가 아니라고 목소리를 높이지만, 벨거의 가설에 반박하지 못하는 프레이야.\\n「당신의 노래에 공명한 하야테 임멜만은 엄청난 힘을 발휘했다」─벨거"

msgid "sn_dsc_1626"
msgstr "의식을 되찾고 침대에서 일어나려는 하야테를 황급히 막는 미라쥬.\\n하야테는 걱정을 끼친 것에 사과하며 솔직한 감사의 마음을 전했다."

msgid "sn_dsc_1627"
msgstr "두 번째 폭주를 극복하고 멋지게 포메이션을 성공시키는 하야테와 미라쥬.\\n「음, 이제야 한 단계 성장했나!」─아라드"

msgid "sn_dsc_1628"
msgstr "바람의 기사로서 윈더미어 왕의 명이라면 언제든 검이 되겠다고 맹세하는 키스.\\n그리고 하인츠가 자신의 의지로 「진정한 바람」을 일으키기를 바라고 있었다."

msgid "sn_dsc_1629"
msgstr "벨거의 오만한 태도와 윈더미어와 내통하고 있었다는 사실에 격노하는 척.\\n게다가 통합 정부까지 뒤를 봐주고 있었다는 사실을 알고 분노를 숨기지 못했다."

msgid "sn_dsc_1630"
msgstr "볼도르 잠입 작전을 성공시키기 위한 양동 작전으로 랜돌에 나타난 에리시온.\\n마크로스급의 압도적인 화력으로 함께 싸우는 볼도르 방면군을 지원했다."

msgid "sn_dsc_1631"
msgstr "분노한 케이오스 일원들에게 통합 정부의 허가증을 내미는 벨거.\\n그의 약삭빠름과 윈더미어에 대한 통합 정부의 낮은 관심이 드러나는 순간이다."

msgid "sn_dsc_1632"
msgstr "폭주 후 의식을 잃은 하야테가 수용된 의무실.\\n의료선만큼은 아니지만 일정 수준의 치료가 가능한 설비가 있는 듯하다."

msgid "sn_dsc_1633"
msgstr "우주 공간에서도 짙게 돋보일 듯한 깊은 보랏빛으로 만들어진 의상을 입은 미쿠모.\\n신비롭게 빛나는 별가루 무대에서도 그 별처럼 찬란한 빛은 전혀 바래지 않는다."

msgid "sn_dsc_1635"
msgstr "행성 볼도르의 전술 라이브에서 유적과 공명하며 의문의 기억이 되살아난 미쿠모.\\n신비로운 빛을 발하며 공허한 눈으로 노래하는 미쿠모의 노랫소리에 유적은 전에 없던 반응을 보이기 시작했다."

msgid "sn_dsc_1636"
msgstr "프레이야와의 공명을 신기하게 여기는 미쿠모에게, 유적과 연결되는 미쿠모 쪽이 더 대단하다고 답하는 하야테.\\n그러자 미쿠모는 장난스러운 행동과 함께 유적과 연결되는 이미지를 솔직한 말로 이야기했다."

msgid "sn_dsc_1637"
msgstr "하야테와 미라쥬, 멤버들의 질책과 격려를 받아 노래할 의지를 되찾은 프레이야.\\n미쿠모는 그 모습을 지켜본 뒤 프레이야를 재촉하듯 한 손의 사인을 하늘로 들어 올렸다."

msgid "sn_dsc_1638"
msgstr "아이테르 전망 덱에서 서로 할 수 있는 일밖에 할 수 없다고 미쿠모에게 말하는 하야테.\\n그 말에는 다시 날 수 있다는 안도감과 함께 미쿠모의 처지에 대한 배려가 배어 있는 듯했다."

msgid "sn_dsc_1639"
msgstr "미쿠모가 격리된 의료선을 불안한 표정으로 멀리서 바라보는 마키나와 레이나.\\n알려지지 않은 사실이 너무나 많지만, 미쿠모를 걱정하는 두 사람의 마음은 진심이다."

msgid "sn_dsc_1640"
msgstr "숲에 돌입하면 불시착할 수 있었음에도 기수를 내린 추락을 선택한 카심.\\n하야테가 달려가자 흐릿한 의식 속에서도 사과밭을 걱정하는 말을 남겼다."

msgid "sn_dsc_1641"
msgstr "케이오스 본부에서 파견된 직원들에 의해 의료선에 격리되는 미쿠모.\\n미쿠모에 대한 이 조치에 관해서도 레이디 M은 침묵을 지켰다."

msgid "sn_dsc_1642"
msgstr "룬과 생명의 빛을 불태우는 듯한 움직임으로 하야테를 압도하는 카심.\\n그 날카로운 바람은 마치 『백기사』라고 착각할 만큼 날카롭게 벼려진 것이었다."

msgid "sn_dsc_1643"
msgstr "밭으로 옮겨 심을 수 있을 만큼 훌륭하게 자란 사과 묘목.\\n카심의 아들 알렉에게 괭이와 지주대, 비료와 함께 전달되었다."

msgid "sn_dsc_1644"
msgstr "항공모함 아이테르에 탑재된 알파, 베타 소대의 VF-31A.\\n항공모함 헤메라에는 데스트로이드 부대가 반입되어 출격 준비가 착착 진행되고 있었다."

msgid "sn_dsc_1645"
msgstr "발키리의 리더를 맡으며 전술 라이브에서도 멤버들을 이끄는 카나메.\\n멤버들의 신뢰와 함께 설렘으로 가슴을 뛰게 하며 모든 장애물을 넘어간다."

msgid "sn_dsc_1647"
msgstr "의료선의 예상보다 강력한 보안에 백업을 시도하지만 고전을 면치 못하는 레이나.\\n레이나의 강행 돌파 지시에 카나메는 연기를 멈추고 침대에서 뛰어내려 달려 나갔다."

msgid "sn_dsc_1648"
msgstr "리셉터 보유자로 선정되었을 때 특별히 깊게 생각하지 않았다고 답하는 카나메.\\n다시 노래할 수 있을지도 모른다는 순수한 마음이 카나메를 움직였던 것이다."

msgid "sn_dsc_1649"
msgstr "공명으로 인해 하야테가 바르화할 수도 있다는 사실을 알게 된 프레이야.\\n바르화, 그것도 하야테라는 사실에 프레이야는 큰 충격을 받는다."

msgid "sn_dsc_1650"
msgstr "생체 폴드파의 이상으로 환자로 위장해 의료선으로 이송되는 카나메.\\n실제로는 레이나가 조작한 진료 기록을 이용해 의료선 내부로 잠입하는 작전이었다."

msgid "sn_dsc_1651"
msgstr "경비원들에게 둘러싸여 벽에 손을 짚은 자세로 무력화되는 마키나.\\n마키나는 구속되어 처벌받을 자신의 처지보다 미쿠모의 안위를 걱정하고 있었다."

msgid "sn_dsc_1652"
msgstr "윈더미어에 직접 진입하는 작전의 무대로 선택된 행성 알브헤임.\\n공교롭게도 그곳은 메서와 처음 만났던 장소이기도 했다."

msgid "sn_dsc_1653"
msgstr "모니터에 표시된 볼도르에서 하야테와 프레이야의 공명을 기록한 영상.\\n그곳에는 기묘한 움직임으로 적기를 맹렬히 추격하는 하야테의 VF-31F가 비춰지고 있었다."

msgid "sn_dsc_1654"
msgstr "성과가 나오지 않아 고민하던 카나메에게 협력을 제안했던 과거의 아라드.\\n그리고 해파리에 빗댄 속담으로 서두르지 않아도 된다며 카나메를 격려했다."

msgid "sn_dsc_1655"
msgstr "행성 라그나를 떠난 뒤에도 발키리의 숙소 역할을 하고 있는 나체먹낭낭.\\n아무래도 마키나와 레이나의 모습은 보이지 않는 것 같은데…?"

msgid "sn_dsc_1656"
msgstr "케이오스 본부에서 파견된 의료선의 직원.\\n자세한 내용은 알 수 없지만, 미쿠모와 깊은 관련이 있는 듯하다."

msgid "sn_dsc_1657"
msgstr "그동안 발키리 멤버 중에서도 손꼽힐 만큼 크게 마음의 성장을 이뤄온 레이나.\\n동료들과 쌓아온 유대를 가슴에 품고, 아무리 견고한 장벽이라도 가볍게 풀어헤쳐 나갈 것이다."

msgid "sn_dsc_1658"
msgstr "해킹과 바이러스를 자유자재로 다루며 네트워크의 파도를 뛰어넘는 레이나.\\n그 능력은 평소의 차가운 표정 뒤에 숨겨진 불타는 듯한 열정이 있기에 가능한 것이라 할 수 있다."

msgid "sn_dsc_1659"
msgstr "가슴 깊이 파고드는 듯한 미쿠모의 노랫소리에 마키나와 레이나는 강하게 마음이 흔들렸다.\\n그리고 어느새 포개져 있던 레이나의 손을 마키나는 조용히 맞잡아 주었다."

msgid "sn_dsc_1660"
msgstr "미라쥬가 하야테의 방을 드나든다는 소문에 레이나의 날카로운 추리가 빛난다!\\n「……드나드는 아내」「드, 드나드는 아내~!?」─레이나, 프레이야"

msgid "sn_dsc_1661"
msgstr "공명 실험에서 단 한 번도 노래하지 못했던 프레이야를 걱정해 상태를 보러 온 하야테.\\n마음의 문을 닫은 프레이야를 보고 하야테는 가만히 있을 수 없어 이야기를 꺼내기 시작했다."

msgid "sn_dsc_1662"
msgstr "하야테에게 노래에 대한 마음을 의심받고, 노래를 정말 좋아하는 마음은 변하지 않는다고 답하는 프레이야.\\n그럼에도 노래하는 것보다 더 소중할지도 모를 마음이 프레이야 안에서 싹트기 시작했다."

msgid "sn_dsc_1663"
msgstr "경비원들에게 완전히 포위되어 거의 투항하는 형태로 신병을 확보당한 레이나.\\n레이나 역시 마키나와 마찬가지로 자신의 처지보다 미쿠모의 안위를 걱정하고 있었다."

msgid "sn_dsc_1664"
msgstr "레이나가 해킹을 했다면 아무런 정보도 얻지 못했을 리 없다고 말하는 미쿠모.\\n카나메와 마키나가 한결같이 입을 다무는 가운데, 레이나는 망설이며 대답했다."

msgid "sn_dsc_1665"
msgstr "하야테에 대한 프레이야의 노래 영향을 조사하기 위해 진행된 공명 실험.\\n프레이야가 다른 스튜디오에서 노래하는 것 외에도 녹음된 노래와 전환하는 것도 가능했다."

msgid "sn_dsc_1666"
msgstr "폭주와 관련해 프레이야의 노래는 관계없다는 하야테를 날카롭게 꾸짖는 어니스트.\\n앞으로의 작전에도 영향을 미치는 만큼, 그냥 넘길 수 없는 상황인 듯하다."

msgid "sn_dsc_1667"
msgstr "하야테와 프레이야의 공명 실험을 지켜보던 발키리와 델타 소대원들.\\n며칠에 걸쳐 진행된 실험이었지만, 결국 결과는 나오지 않았다."

msgid "sn_dsc_1668"
msgstr "진실을 밝혀내기 위해 의료선 해킹을 진행하는 레이나와 마키나.\\n그 보안은 레이나의 기술로도 상당히 철저한 듯하다."

msgid "sn_dsc_1669"
msgstr "하인츠의 즉위식을 앞두고 새로운 각오를 다지기 위해 차원 병기의 상흔을 찾은 보그.\\n조국이 받은 굴욕과 죽은 가족들의 한을 풀기 위해, 그의 바람은 뜨겁고 날카롭게 벼려져 있었다."

msgid "sn_dsc_1670"
msgstr "젊은 기사 보그가 전장에서 조종하는 기체로, 소형 지원기 「릴 드라켄」 2기를 탑재한 기체.\\n대 VF전을 염두에 둔 SV 시리즈의 후계기로, 이름에 걸맞은 성능을 자랑한다."

msgid "sn_dsc_1671"
msgstr "하늘의 기사를 모욕한 대가를 치르게 하겠다며 레이나에게 유난히 강한 적의를 드러내는 보그.\\n그가 퍼부은 공격은 집요하고 격렬했지만, 어째서인지 볼이 붉어지고 말았다."

msgid "sn_dsc_1672"
msgstr "메서를 주제도 모르는 자라고 욕하며, 반격당하는 것이 당연하다고 말했던 보그였지만…\\n「네가 저 정도의 바람을 일으킬 수 있겠느냐」─키스"

msgid "sn_dsc_1673"
msgstr "다른 공중 기사단이 차원 병기의 상흔을 찾는 동안, 죽은 가족을 만나기 위해 고향 집으로 돌아간 보그.\\n그리고 가족 모두가 잠든 묘비 앞에서 우세로 향하고 있는 전황을 보고했다."

msgid "sn_dsc_1674"
msgstr "석양 하늘을 나는 두 마리의 용새에게 자신과 로이드의 모습을 겹쳐 보며 옛날을 떠올리는 키스.\\n한때 같은 하늘을 날았던 친구의 진의를 알 수 없는 행동에 홀로 고민하고 있었다."

msgid "sn_dsc_1681"
msgstr "흰 원피스를 입고 촬영하던 중, 불어오는 바람 속에서 종이비행기를 발견한 란카.\\n하늘 높이 날아오른 종이비행기의 끝에는, 계속 바라왔던 광경이 펼쳐져 있을 것이다."

msgid "sn_dsc_1683"
msgstr "맑고 푸른 하늘 아래 동료들이 지켜보는 가운데, 기도하듯 노래하는 란카.\\n자애와 마음이 가득 담긴 그 노랫소리는 바람과 함께 사람들의 마음을 치유하고 감싸 안는다."

msgid "sn_dsc_1684"
msgstr "역할에 사로잡혀 자신의 존재가 사라질까 두려워하는 알토에게 란카는 조용히 손을 얹는다.\\n「무슨 일이 있어도… 언제라도, 알토 군은 알토 군이야…」─란카"

msgid "sn_dsc_1685"
msgstr "작은 언덕 가득 펼쳐진 꽃밭에서 별을 떠난 바주라들을 떠올리는 란카.\\n이 별을 아름답게 지켜나간다면 바주라와의 공존이 이루어질 수 있기를 바라며…"

msgid "sn_dsc_1686"
msgstr "알토가 과거 사오토메 일좌의 천재 아역 배우로 이름을 날렸다는 이야기를 꺼내는 란카.\\n란카에게 알토는 셰릴과 마찬가지로 프로의 세계에서 살아가는 사람으로 보이고 있었다."

msgid "sn_dsc_1687"
msgstr "훈련을 마치고 돌아오는 길, 가로등 아래 홀로 기다리고 있던 란카를 발견한 알토 일행.\\n미셸의 자연스러운 배려가 알토와 란카에게 대화할 기회를 만들어 주었다."

msgid "sn_dsc_1688"
msgstr "혼란스러운 전황 속에서 란카의 노랫소리를 느끼고 잠시 정신을 되찾는 브레라.\\n브레라의 머릿속에는 어린 란카의 모습과, 그것을 지키던 오빠로서의 기억이 되살아났다."

msgid "sn_dsc_1689"
msgstr "임플란트의 속박을 풀고 원로원이 조종하는 바주라 퀸에게 특공을 감행하는 VF-27.\\n「더 이상 너희들의 꼭두각시가 아니다!」─브레라"

msgid "sn_dsc_1690"
msgstr "어린 란카가 갈리아4에서 어머니와 오빠와 함께 지내던 시절의 기억.\\n끔찍한 과거의 기억 속에서도 그곳에는 평온한 시간이 흐르고 있었다."

msgid "sn_dsc_1691"
msgstr "수면에 비치는 보름달과 해협 위에 놓인 다리를 건너는 케이블카.\\n그 풍경은 이곳이 이민선 내부라는 사실을 느끼지 못할 만큼 환상적이다."

msgid "sn_dsc_1692"
msgstr "바주라 본성으로 이주하기 위한 시설을 건설하는 프론티어 선단의 사람들.\\n은하의 운명을 건 싸움이 끝난 지 한 달이 지나며, 사람들도 생활을 되찾기 시작했다."

msgid "sn_dsc_1693"
msgstr "하얗게 빛나는 동양풍 치파오를 입고 나른한 표정을 짓는 민메이.\\n눈 아래 펼쳐진 거리의 불빛을 바라보며, 그녀의 마음은 먼 고향을 향한 그리움으로 가득했다."

msgid "sn_dsc_1694"
msgstr "마크로스가 지구에서 쫓겨날 것이라는 소문을 듣고 석양 앞에서 침통한 표정을 짓는 맥스.\\n다시는 보지 못할지도 모를 지구의 석양을 바라보며, 히카루와 함께 감상에 잠겼다."

msgid "sn_dsc_1695"
msgstr "마크로스의 배리어 폭주 사고에서 벗어나지 못한 카키자키의 한을 생각하는 히카루.\\n카키자키 부모와 함께 찍은 사진을 손에 들고, 입술을 깨물며 솟구치는 슬픔을 참았다."

msgid "sn_dsc_1696"
msgstr "마크로스 내부 스튜디오에서 멀어져 가는 지구를 배경으로 마음을 담아 노래하는 민메이.\\n고향의 무사함과 귀환을 바라는 노랫소리는 방송을 통해 지구에도 송출되고 있었다."

msgid "sn_dsc_1697"
msgstr "민간인들의 거처가 정해진 것을 기뻐하는 히카루와 맥스, 카키자키 세 사람.\\n그리고 아직 거리가 활기를 띠고 있을 때라며 히카루의 한턱으로 거리로 놀러 나갔다."

msgid "sn_dsc_1698"
msgstr "라플라미즈의 반대를 무릅쓰고 마이크론 스파이를 자원한 밀리아.\\n그 마음속에는 자신에게 쓰라린 패배를 안겨준 파일럿을 만나보고 싶다는 생각이 있었다."

msgid "sn_dsc_1699"
msgstr "글로벌은 체념이 묻어나는 말투로 통합 정부의 통보를 미사에게 전했다.\\n「…하야세 대위, 역시 지구 외 출격 명령이 내려왔어」─글로벌"

msgid "sn_dsc_1700"
msgstr "마크로스 시민들에게 격려와 협력을 호소한 민메이는 그대로 무대로 향한다.\\n노래가 시작되는 순간 그녀의 표정에는 고향을 아끼는 듯한 애수가 가득했다."

msgid "sn_dsc_1701"
msgstr "밀리아가 들어간 캡슐을 들고 마크로스에 접근하는 콰드란 로.\\n카무진의 공격을 틈타 전투 지역을 우회하는 형태로 마크로스에 접근한 듯하다."

msgid "sn_dsc_1702"
msgstr "시민들에게 보고하는 자리에서 말을 잇지 못하는 글로벌 대신 카메라 앞에 선 민메이.\\n마크로스를 사랑하고 격려하는 그녀의 수많은 말은 사람들의 마음에 공감으로 전해졌다."

msgid "sn_dsc_1703"
msgstr "다시 지구권으로 돌아온 것에 감회 어린 말을 흘리는 브리타이.\\n그 뜻밖의 말에 엑세돌도 무심코 되물을 정도였다."

msgid "sn_dsc_1704"
msgstr "어린 카키자키가 부모와 함께 찍은 사진.\\n곁에는 부모와 주고받았던 것으로 보이는 편지가 놓여 있었다."

msgid "sn_dsc_1705"
msgstr "검은색의 아름다운 동양풍 치파오를 입고 애수 어린 표정을 짓는 셰릴.\\n그 모습은 마치 꽃처럼, 과거 고향에서의 처지를 느낄 수 없을 만큼 아름답게 피어나고 있었다."

msgid "sn_dsc_1707"
msgstr "소동을 눈치챈 셰릴이 뒤돌아보자, 스태프들에게 둘러싸인 알토의 모습이 있었다.\\n그리고 알토의 간절한 목소리에 셰릴은 데이트했을 때의 약속을 떠올렸다."

msgid "sn_dsc_1708"
msgstr "대통령의 긴급 성명이 발표되는 가운데, 오즈마에게 특례 조항 B 발동을 전달받는 미셸.\\n통화를 끝내고 단말기를 내린 뒤 하늘을 바라보며 이 사태를 비꼬는 말을 중얼거렸다."

msgid "sn_dsc_1709"
msgstr "기자회견장에서 라이브 중지를 암시한 기자를 격렬한 말투로 몰아붙이는 셰릴.\\n그리고 마이크를 빼앗아 카메라를 향한 뒤, 라이브 강행과 함께 고향 귀환을 선언했다."

msgid "sn_dsc_1710"
msgstr "신통합군에서 인원이 파견되어 온다는 일을 고양이 방울에 빗대어 이야기하는 제프리.\\n마크로스 쿼터 운용에 관한 협의는 그것으로 마무리되었다고 한다."

msgid "sn_dsc_1711"
msgstr "완전히 잊고 있던 셰릴에게 난처한 표정으로 이어링을 내미는 알토.\\n반드시 찾아서 가져가겠다는 약속을 알토는 성실하게 지켜냈다."

msgid "sn_dsc_1712"
msgstr "콘서트 투어 마지막을 장식할 라이브 리허설을 착실히 진행하는 셰릴.\\n투어를 성공시키고 고향 갤럭시로 돌아가기 위해 무대 조정에도 열을 올리고 있다."

msgid "sn_dsc_1713"
msgstr "평시에는 위생병으로 근무하는 카나리아에게 만일의 상황을 부탁하는 오즈마.\\n「──맞지 마. 그렇다면」「그래──」─카나리아, 오즈마"

msgid "sn_dsc_1714"
msgstr "양쪽 날개에 폴드 부스터를 하나씩 장착하고 장거리 정찰에 대응한 RVF-171.\\n여러 겹의 폴드 단층을 넘어 갤럭시 선단의 상황을 확인하는 임무에 투입되었다."

msgid "sn_dsc_1715"
msgstr "수많은 바주라의 습격을 받는 갤럭시 선단.\\n공개된 영상은 5일 전의 것으로, 상황은 절망적으로 보였다."

msgid "sn_dsc_1716"
msgstr "사요나라 라이브 행사장에 걸린 스크린 현수막.\\n그곳에는 갤럭시 선단을 고향으로 둔 셰릴을 격려하는 말이 적혀 있었다."

msgid "sn_dsc_1717"
msgstr "멤버 중에서도 손꼽히는 프로포션을 아낌없이 선보이며 관객을 매료시키는 마키나.\\n흔한 포즈 요청조차 분명 소악마적인 매력으로 예상 밖의 모습을 보여줄 것이다."

msgid "sn_dsc_1719"
msgstr "바르 진압 작전 중 발키리 이외의 노랫소리를 느낀 마키나와 레이나.\\n「노래?」「가슴이 따끔따끔…」─마키나, 레이나"

msgid "sn_dsc_1720"
msgstr "행성 라그나까지 데려다주고, 발키리가 될 기회까지 만들어 준 하야테.\\n프레이야는 깊이 감사하고 있었지만, 하야테는 그다지 실감하지 못하는 모습이었다."

msgid "sn_dsc_1721"
msgstr "윈더미어인 특유의 신체 능력으로 표지판을 가볍게 뛰어넘는 프레이야.\\n그리고 에리시온을 올려다보며 온몸으로 발키리를 향한 마음을 표현했다."

msgid "sn_dsc_1722"
msgstr "날아오르는 프레이야를 곁눈질하며 부드럽게 충고하는 듯한 말을 건네는 하야테.\\n델타 소대로서 발키리의 호위를 맡고 있는 만큼, 그 혹독함은 누구보다 잘 알고 있었다."

msgid "sn_dsc_1723"
msgstr "카나메 일행이 부르는 「눈물 눈 폭발음」에 감동해 프레이야는 모두를 따라 노래하기 시작했다.\\n「와! 프레프레 노래할 수 있구나, 눈물눈물」「울먹울먹, 두근두근」─마키나, 레이나"

msgid "sn_dsc_1724"
msgstr "「눈물 눈 폭발음」의 가사에 맞춰 손을 뻗어 먼 곳을 가리키는 프레이야.\\n그 손끝이 향한 곳에는 프레이야가 동경하던 발키리가 미소로 답하고 있었다."

msgid "sn_dsc_1725"
msgstr "발키리식 신입 환영회에서 과거 무명 시절 이야기를 들려주는 마키나.\\n혹독한 훈련과 임무를 견디지 못하고 떠나간 멤버들도 있었다."

msgid "sn_dsc_1726"
msgstr "발키리를 습격하는 언노운을 향해 요격 태세를 취하는 알파 소대의 VF-31A.\\n전투에 특화된 기체인 만큼, 미사일 포화로 훌륭하게 적을 격퇴했다."

msgid "sn_dsc_1727"
msgstr "행성 라그나의 케이오스 지부에서 개최된 발키리 오디션.\\n참고로 개최 장소나 날짜를 잘못 알아보고 오지 못한 덜렁이도 있었다고…?"

msgid "sn_dsc_1728"
msgstr "발키리 여자 기숙사 테라스에 설치된 노천탕.\\n라그나의 바다와 하늘을 한눈에 볼 수 있는 절경 명소이기도 한 듯하다."

msgid "sn_dsc_1729"
msgstr "1분 1초도 후회하지 않기 위해 마음이 이끄는 대로 온 힘을 다해 지금을 달려가는 프레이야.\\n그 한결같고 올곧은 모습은 관객들의 마음에도 힘을 전해줄 것이다."

msgid "sn_dsc_1731"
msgstr "바르 진압 작전 중 발키리 이외의 노랫소리를 느낀 미쿠모와 카나메.\\n「이 노래…」「우리 말고도 누군가 있어?」─미쿠모, 카나메"

msgid "sn_dsc_1732"
msgstr "어떻게든 위기를 벗어나 지쳐 주저앉은 프레이야에게 한 청년이 손을 내민다.\\n「안심해. 나는 케이오스 델타 소대 소속 하야테 임멜만 준위야」─하야테"

msgid "sn_dsc_1733"
msgstr "쌓인 눈을 밟으며 숨을 헐떡이고 눈보라 속을 계속 걸어가는 프레이야.\\n반드시 발키리가 되겠다는 마음을 품고, 똑바로 앞을 바라보고 있었다."

msgid "sn_dsc_1734"
msgstr "프레이야가 노래의 힘으로 바르를 진정시키는 순간을 목격하는 하야테.\\n발키리에 버금가는 노래와 그 광경에 하야테는 눈을 뗄 수 없었다."

msgid "sn_dsc_1735"
msgstr "바르를 진압하고 안심한 탓인지 그 자리에서 무너지듯 쓰러지는 프레이야.\\n순간 하야테가 받아냈지만, 직후 들려온 것은 커다란 배꼽시계 소리였다."

msgid "sn_dsc_1736"
msgstr "노래하면서 하야테에게 마이크를 건네달라는 듯한 제스처를 하는 프레이야.\\n조금 망설이면서도 하야테는 제대로 응해주었다."

msgid "sn_dsc_1737"
msgstr "습격한 것에 대한 사과라며 오니기리를 대접받는 하야테와 프레이야.\\n마침 배가 고팠던 프레이야는 정신없이 오니기리를 먹어 치웠다."

msgid "sn_dsc_1738"
msgstr "발키리를 습격하는 언노운을 쓸어버리는 메서의 VF-31F.\\n죽음을 부르는 사신의 엠블럼이 그 어느 때보다 든든하게 보인다."

msgid "sn_dsc_1739"
msgstr "프레이야가 밀항했던 화물선의 선원들.\\n전투 구역 근처를 지나던 탓에 바르가 발병하고 말았다."

msgid "sn_dsc_1740"
msgstr "눈이 계속 내리는 행성 윈더미어의 우주항.\\n계속 내리는 눈이 소리를 감춰준다면 화물 속에 숨어드는 것도 쉬울지도 모른다…?"

msgid "sn_dsc_1741"
msgstr "미라쥬의 파일럿 슈트를 손에 들고 왠지 들뜬 듯 즐거워하는 마키나.\\n타고난 영감을 발휘해 기분만큼은 완전히 뛰어난 파일럿이 된 듯하다."

msgid "sn_dsc_1742"
msgstr "마키나와 미라쥬가 페어를 이루어 탑승하는 마키나 나카지마 컬러의 VF-31C.\\n핑크와 라이트 블루로 물든 날개가 라이브 관객들에게 희망의 노래를 전한다."

msgid "sn_dsc_1743"
msgstr "「가자고 엘리트 아가씨, 저 사신 녀석에게 본때를 보여주자!」\\n「흥, 풋내기 주제에…」─하야테, 미라쥬"

msgid "sn_dsc_1744"
msgstr "여자 기숙사 노천탕에서 목욕 수건 한 장만 두른 채 꼭 붙어 있는 마키나와 레이나.\\n살짝 물든 볼과 지나치게 다정한 광경은 팬들에게 조금 자극이 강할지도…?"

msgid "sn_dsc_1747"
msgstr "파일럿이 의식을 잃고 추락하는 Sv-262Ba에 노랫소리를 전하는 마키나와 레이나.\\n발키리에게 눈앞의 생명을 구하는 데 적인지 아닌지는 중요하지 않다."

msgid "sn_dsc_1748"
msgstr "의식을 되찾은 보그는 자신에게 노래를 전하는 발키리의 모습을 목격한다.\\n그토록 싫어하던 노랫소리였음에도, 그 광경에 한동안 멍하니 있을 수밖에 없었다."

msgid "sn_dsc_1753"
msgstr "부드러운 햇살과 반짝이는 소품으로 꾸며진 창가에서 느긋하게 일광욕을 즐기는 란카.\\n고양이 장식물을 바라보며 꿈이 넘치는 상상의 세계를 떠올리고 있는지도 모른다."

msgid "sn_dsc_1755"
msgstr "수영복 차림으로 거리에 서서 데뷔곡 「고양이 일기」의 프로모션을 진행하는 란카.\\n사람들이 오가는 거리 한편에는 최근 란카 주변에서 자주 보이는 한 청년의 모습도 있었다."

msgid "sn_dsc_1756"
msgstr "미셸에게서 퍼스트 라이브까지 란카를 데려다주는 역할을 맡은 알토.\\n이는 란카와 알토를 둘만 있게 해주려는 미셸의 배려이기도 했다."

msgid "sn_dsc_1757"
msgstr "【하늘빛 무늬의 교환일기】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1761"
msgstr "【하늘빛 무늬의 교환일기】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1762"
msgstr "【하늘빛 무늬의 교환일기】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1765"
msgstr "결혼식장에서 연주하게 되어 드레스 코드에 맞춰 턱시도를 입은 바사라.\\n본인은 그다지 내키지 않는 듯하지만, 멋을 낸 그 모습은 제법 잘 어울리는 듯하다."

msgid "sn_dsc_1767"
msgstr "기체를 잃었음에도 감린의 도움을 받아 바사라에게 노래를 전달한 밀레느.\\n그 노랫소리는 빛나는 에너지로 변해 바사라의 목소리를 회복시키는 힘이 되어 흘러들었다."

msgid "sn_dsc_1768"
msgstr "게페르니치의 수수께끼 같은 힘으로 목소리를 낼 수 없게 된 바사라.\\n홀로 해변에서 필사적으로 목소리를 내보려 했지만, 주변에 울린 것은 허무한 파도 소리뿐이었다."

msgid "sn_dsc_1769"
msgstr "바위 위에서 몸을 젖히다가 그대로 균형을 잃고 넘어지는 바사라.\\n목소리 상태가 좋지 않은 탓인지 평소보다 더욱 폼이 나지 않는 모습이 되어버렸다."

msgid "sn_dsc_1770"
msgstr "밀레느를 프로토데빌룬의 공격으로부터 지키면서도 필사적으로 노래하려 하는 바사라.\\n온몸을 떨며 목소리 없는 외침을 반복하는 바사라의 모습에 밀레느의 마음은 크게 흔들렸다."

msgid "sn_dsc_1771"
msgstr "레이 일행의 VF-17T 개조기에 기체 뒤를 맡긴 채 계속 노래하는 밀레느와 바사라.\\n그리고 노래하면서도 그 시선은 믿고 있는 동료들에게 향해 있었다."

msgid "sn_dsc_1772"
msgstr "전투 중 밀레느가 발산한 노래 에너지 덕분에 목소리를 되찾은 바사라.\\n그리고 노래하지 못했던 답답함을 풀어내듯, 떠오르는 아침 해를 바라보며 마음껏 노래했다."

msgid "sn_dsc_1773"
msgstr "균형을 잃을 것 같은 VF-19 개조기를 등 뒤에서 받쳐주는 레이와 비히다.\\n등을 맡길 수 있는 동료들이 있기에 바사라 일행도 온 힘을 다해 노래할 수 있는 것이다."

msgid "sn_dsc_1774"
msgstr "밀레느와 겹치듯 사운드 웨이브를 발사하는 바사라의 VF-19 개조기.\\n그 에너지는 프로토데빌룬이 발산한 에너지파를 압도할 정도였다."

msgid "sn_dsc_1775"
msgstr "목소리를 내지 못해 괴로워하는 바사라를 걱정스러운 눈으로 바라보는 구바바.\\n바사라의 상태가 신경 쓰여 뒤를 따라온 듯하다."

msgid "sn_dsc_1776"
msgstr "바사라의 기타에 장착된 조작용 레버.\\n튀어나온 날개 같은 디자인이 특징이다."

msgid "sn_dsc_1777"
msgstr "부모님의 부부 관계를 보며 자라서인지 행복한 결혼을 좀처럼 상상하지 못하는 밀레느.\\n이미 관심은 커다란 웨딩 케이크와 라이브 연출로 옮겨간 듯하다."

msgid "sn_dsc_1779"
msgstr "라이브 출연을 마치고 철수하는 바사라 일행을 태운 밴과 스쳐 지나가는 소녀.\\n과연 소녀가 손에 든 커다란 꽃다발을 건넬 날이 올까…?"

msgid "sn_dsc_1780"
msgstr "바사라의 노랫소리를 되찾고 프로토데빌룬을 물리치는 데 성공한 밀레느 일행.\\n밤이 지나고 아침 해가 떠오르자, 그곳에는 아침 햇살보다 더욱 빛나는 미소가 있었다."

msgid "sn_dsc_1781"
msgstr "사운드 장치를 장착하고 노래 에너지를 발생시키는 데 성공한 밀레느.\\n밀레느가 마음껏 노래하는 한편, 바사라는 그 모습을 어딘가 먼 곳을 바라보듯 지켜보고 있었다."

msgid "sn_dsc_1782"
msgstr "노래 에너지의 진정한 힘을 발휘하려면 바사라가 아니면 어렵다고 말하는 Dr. 치바.\\n이에 밀레느는 자신도 할 수 있다며 실험을 계속해 달라고 간청했다."

msgid "sn_dsc_1783"
msgstr "노래 에너지 실험 라이브 중, 관객석에서 밀레느에게 웃으며 손을 흔드는 감린.\\n바사라가 돌아오지 않아 풀이 죽어 있던 밀레느도 그 미소를 보고 다시 힘을 되찾았다."

msgid "sn_dsc_1784"
msgstr "다시 노래할 수 있게 된 것에 감사하는 바사라에게, 밀레느는 비꼬는 말도 섞어 웃으며 답했다.\\n「흥, 노래하지 못하게 된 카나리아는 바다에 떠내려가 버릴 테니까」─밀레느"

msgid "sn_dsc_1785"
msgstr "바사라와 감린 사이에서 흔들리는 밀레느의 오라에 일희일비하는 아키코와 Dr. 치바.\\n「완벽한 삼각관계네」「아, 확실히 좀 해!」─아키코, Dr. 치바"

msgid "sn_dsc_1786"
msgstr "프로토데빌룬에게 접근하는 밀레느를 지원하러 나선 다이아몬드 포스.\\n섣불리 공격하지 않는 신중함 역시 사운드 포스를 돕는 요소가 된 듯하다."

msgid "sn_dsc_1787"
msgstr "감린의 응원을 받아 분홍색으로 변한 밀레느의 오라.\\n물결치는 듯한 움직임과 색깔이 어우러져 마치 하트처럼 보인다."

msgid "sn_dsc_1788"
msgstr "바사라와 감린 사이에서 완전히 둘로 갈라진 밀레느의 오라.\\n말 그대로 밀레느가 두 사람에게 품은 감정이 형태로 드러난 모습이다."

msgid "sn_dsc_1789"
msgstr "깃털처럼 포근하고 부드러운 스텝으로 라이브 무대 위를 날아다니듯 춤추는 마키나.\\n오늘도 그 스타일과 존재감 넘치는 움직임으로 관객들의 마음을 설레게 해줄 것이다."

msgid "sn_dsc_1791"
msgstr "평소에는 변형되어 토끼 귀 같은 머리띠가 되는 마키나의 고글.\\n필요할 때 고글 형태로 되돌리면 다양한 수치를 확인할 수 있다."

msgid "sn_dsc_1792"
msgstr "유사시에 대비해 멀티 드론을 개량하는 레이나와 마키나.\\n이 두 사람에게 맡기면 아무리 어려운 조정이라도 완벽하게 마무리해 줄 것이다."

msgid "sn_dsc_1793"
msgstr "백신 라이브로 향하는 셔틀 안에서 라이브 전의 구호를 외치는 발키리.\\n노래를 기다리는 사람들을 위해 마음을 하나로 모으고 라이브에 임하기 위한 중요한 의식이다."

msgid "sn_dsc_1794"
msgstr "발키리 정비사인 가이에게서 입대 축하 선물이라며 정보 단말기를 받은 하야테.\\n그곳에 기록된 영상은 신입인 하야테를 향한 배려가 가득 담겨 있었다."

msgid "sn_dsc_1795"
msgstr "튜닝 덕분에 헬멧 없이도 자유롭게 비행할 수 있게 된 VF-31J.\\n에어쇼에서 처음 탑승한 하야테도 완벽하게 완성된 상태에 크게 기뻐했다."

msgid "sn_dsc_1796"
msgstr "지원군이라고 생각했던 신통합군의 예상 밖 습격으로 단숨에 위기에 빠진 발키리.\\n마키나는 레이나를 안고 제트를 분사하며 폭발 속을 뚫고 탈출했다."

msgid "sn_dsc_1797"
msgstr "마키나와 레이나의 기술 콤비, 그리고 정비사들의 손으로 튜닝된 VF-31J.\\nAI 지원을 싫어하는 하야테에 맞춰 다양한 개수가 이루어진 듯하다."

msgid "sn_dsc_1798"
msgstr "적의 재밍 공격으로 인한 피해 상황을 분석하는 마키나와 레이나.\\n계기를 노려보는 레이나와 달리 마키나는 고글로 주변 경계를 강화하고 있었다."

msgid "sn_dsc_1799"
msgstr "백신 라이브 습격 소식을 받고 출동한 것으로 보이는 신통합군 소속 VF-171.\\n「오오, 우리의 사랑스러운 지원군씨!」─척"

msgid "sn_dsc_1800"
msgstr "나체먹낭낭의 특제 메뉴인 바다거미 통조림 요리.\\n상당히 아슬아슬한 생김새지만, 통조림으로 만들 정도로 맛은 좋은 모양이다."

msgid "sn_dsc_1801"
msgstr "순백의 웨딩드레스를 입고 교회를 무대로 순결한 신부를 연기하는 셰릴.\\n천사처럼 곁에 서 있는 모습은 연기를 넘어 사랑에 빠질 것처럼 아름답다."

msgid "sn_dsc_1803"
msgstr "그레이스에게 이끌려 갤럭시 선단에서 열린 사오토메 일좌의 공연을 보게 된 셰릴.\\n처음 접한 가부키와 천재 아역 배우 알토의 연기에 셰릴은 작은 가슴을 두근거리게 했다."

msgid "sn_dsc_1804"
msgstr "셰릴이 미인이고 좋은 비율과 성숙한 분위기를 모두 갖췄다고 인정하는 클란.\\n그럼에도 젠트라화했을 때라면…이라며 경쟁심을 불태우지 않을 수 없었다."

msgid "sn_dsc_1805"
msgstr "매혹적인 입술로 키스를 날리면서도 티 없는 눈동자로 똑바로 바라보는 셰릴.\\n그 입술과 눈동자 앞에서는 어떤 맹세의 말도 흐릿하게 들릴 것만 같다."

msgid "sn_dsc_1806"
msgstr "순백의 베일에 가려진 채 눈을 감고 얌전히 고개를 숙인 셰릴의 옆모습.\\n연출상의 한 장면일 뿐이지만, 그 표정은 순결함을 표현하듯 아름다움으로 가득했다."

msgid "sn_dsc_1807"
msgstr "초원에서 몸을 일으키며 알토가 몸을 던져 자신을 구해줬다는 사실을 깨닫는 셰릴.\\n그리고 바주라 습격 당시를 떠올리며 애틋한 마음을 담아 속삭였다."

msgid "sn_dsc_1808"
msgstr "데이트가 끝날 무렵 반드시 이어링을 찾아서 가져다주겠다고 약속한 알토.\\n셰릴은 차오르는 감정을 억누르고 한마디만 건넨 뒤, 알토의 뺨에 키스했다."

msgid "sn_dsc_1809"
msgstr "반짝이는 스테인드글라스 아래 교회에서 신랑을 기다리는 신부.\\n마치 떠오르는 듯한 순백의 드레스가 신성한 분위기를 자아낸다."

msgid "sn_dsc_1810"
msgstr "바주라를 요격하면서도 누구보다 빨리 셰릴에게 달려간 알토의 VF-25F.\\n바주라의 폴드에 휘말린 것이 결과적으로는 좋은 방향으로 작용했다."

msgid "sn_dsc_1811"
msgstr "진짜 하늘에 대한 동경을 이야기하며 손으로 만든 비행기를 태양에 비춰보는 알토.\\n그 모습에 영향을 받은 듯 셰릴도 손을 뻗어 햇살 위에 손을 겹쳤다."

msgid "sn_dsc_1812"
msgstr "연출을 위해 무대 위 교회에 설치된 종.\\n묵직한 그 음색은 듣는 이에게 엄숙한 마음을 품게 한다."

msgid "sn_dsc_1813"
msgstr "옅은 보랏빛 천으로 만든 웨딩드레스를 입고 빛을 받으며 서 있는 미쿠모.\\n꽃향기가 감도는 그 모습은 마치 축복을 내려주는 여신의 모습을 나타내는 듯하다."

msgid "sn_dsc_1815"
msgstr "프레이야의 노래가 변화한 계기를 알아보기 위해 하야테의 영상을 보여주며 묻는 미쿠모.\\n너무나 직설적인 말에 프레이야는 얼굴을 붉히며 당황했다."

msgid "sn_dsc_1816"
msgstr "프레이야에게 노래의 변화를 지적받은 것을 진지한 표정으로 생각하는 미쿠모.\\n그런 두 사람의 대화를 카나메는 조금 떨어진 곳에서 걱정스럽게 지켜보고 있었다."

msgid "sn_dsc_1817"
msgstr "유적과의 공명에서 엿본 윈더미어의 모습에 미쿠모는 어딘가 그리운 감정을 드러낸다.\\n「선율은 바람을 타고 어디까지나 날아간다. 노래는 별을 누비며, 그리고 승화한다」─미쿠모"

msgid "sn_dsc_1818"
msgstr "생일 축하를 받아본 기억이 없다는 미쿠모의 이야기를 들은 카나메.\\n그리고 이어진 미쿠모의 이야기는 카나메의 상상을 크게 뛰어넘는 것이었다."

msgid "sn_dsc_1819"
msgstr "노래를 마치고 무대를 떠나면서도 석연치 않은 표정을 짓는 마키나와 레이나.\\n말로 표현하기는 어렵지만, 두 사람 모두 미쿠모에게 일어난 작은 변화를 신경 쓰고 있었다."

msgid "sn_dsc_1820"
msgstr "은하 네트워크 라이브의 대기실에서 프레이야의 노래가 변했다고 말하는 미쿠모.\\n한편 프레이야는 그 말의 의미를 이해하지 못해 어리둥절한 표정을 짓고 있었다."

msgid "sn_dsc_1821"
msgstr "지크프리드의 등에 가느다란 와이어 하나만으로 올라탄 미쿠모.\\n위험천만한 행동처럼 보이지만 시선을 끌면서 노래를 전달한다는 효과는 매우 컸다."

msgid "sn_dsc_1822"
msgstr "척의 방을 방문했을 때 방 안에 욕실이 있는 것을 보고 놀라는 프레이야.\\n「아니야, 라그나인의 침대야」─하야테"

msgid "sn_dsc_1823"
msgstr "유적과 공명했을 때 얻은 정보를 바탕으로 작전을 제안하는 미쿠모.\\n그것은 막혀 있던 구상 성단 탈환 작전의 실마리가 되었다."

msgid "sn_dsc_1824"
msgstr "행성 라그나에서 철수할 때 가게째로 대피해 온 나체먹낭낭.\\n주변에는 같은 방식으로 대피해 온 함선들도 보인다."

msgid "sn_dsc_1825"
msgstr "프로모션 촬영 틈에 장미가 만발한 정원에서 어딘가 먼 곳을 바라보는 미셸.\\n결의를 품은 그 눈빛은 서로 의지하는 동료들과 함께 쟁취해야 할 미래를 향하고 있었다."

msgid "sn_dsc_1826"
msgstr "스나이퍼 팩을 기본 장비로 장착한 VF-25G에 슈퍼 팩까지 추가 장비한 기체.\\n대기권 밖 활동에 맞춘 구성으로, 화력과 장갑이 강화되어 더욱 안정적인 성능을 발휘한다."

msgid "sn_dsc_1827"
msgstr "코드 VICTOR 발령을 받고 오즈마의 지시에 경례로 답하는 미셸과 루카.\\n학원에서의 모습과는 달리, 규율을 중시하는 전사로서의 모습이 그곳에 있었다."

msgid "sn_dsc_1828"
msgstr "입대 의지를 보이는 알토에게 다시 도망치려는 것이냐고 묻고 충고하는 미셸.\\n「지금 상태로는 언젠가 네가 죽거나… 누군가를 죽이게 돼」─미셸"

msgid "sn_dsc_1829"
msgstr "전망대에서 알토와 만나기로 한 동안 계속 별을 세고 있었다는 미셸.\\n그 비범한 시력은 뛰어난 스나이퍼로서 유감없이 발휘되고 있다."

msgid "sn_dsc_1831"
msgstr "혼자 행동을 시작한 루카를 발견한 미셸은 순간 클란을 끌어당겨 몸을 숨긴다.\\n한편 클란은 그런 사실도 모른 채 지나치게 가까운 거리에 당황하고 있었다."

msgid "sn_dsc_1837"
msgstr "마크로스급 함장을 이미지한 듯한 특제 함장복을 입은 프레이야.\\n격식 있는 복장에 차가운 표정을 짓고, 포즈도 어딘가 도전적이다."

msgid "sn_dsc_1839"
msgstr "다음 출연 전 휴식 시간, 단둘이 노래에 대한 감상을 이야기하는 프레이야와 하야테.\\n프레이야는 아직도 두근거린다며 룬을 빛내고 하야테를 가만히 바라보고 있었다."

msgid "sn_dsc_1840"
msgstr "바르화한 파일럿이 탑승한 콕핏에 다가가 노랫소리를 전하는 미쿠모.\\n숨결이 닿을 정도로 가까운 거리에서 울려 퍼지는 노래에 파일럿은 순식간에 이성을 되찾았다."

msgid "sn_dsc_1841"
msgstr "【고리 고리 출항 준비!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1845"
msgstr "【고리 고리 출항 준비!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1847"
msgstr "【고리 고리 출항 준비!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1849"
msgstr "밤하늘을 연상시키는 날카로운 의상을 입고 별빛 무대에 선 레이나.\\n경쾌한 리듬과 풋워크로 별들의 빛을 이어 붙이듯 무대를 누빈다."

msgid "sn_dsc_1851"
msgstr "프레이야의 자질을 확인하기 위해 변장하고 일반인으로 위장한 발키리 멤버들.\\n홀로그램으로 의상을 투영하는 기술 덕분에 그야말로 자유자재에 가까운 변장이 가능하다."

msgid "sn_dsc_1852"
msgstr "오디션에서 좋지 않은 프레이야의 수치를 보고 미쿠모는 납득하지 못한 표정을 짓는다.\\n「긴장했나 봐?」「………」마키나, 미쿠모"

msgid "sn_dsc_1853"
msgstr "발레타 시티에서 발생한 바르 증후군 중계에 술렁이는 모노레일 승객들.\\n라그나에 거점을 둔 발키리가 이 사태를 그냥 내버려 둘 리는 없겠지만…"

msgid "sn_dsc_1854"
msgstr "행성 알 샤할의 위성 궤도에서 각종 센서 수치를 감시하는 레이나.\\nVF-31E의 탐색 능력까지 활용해 상당히 넓은 범위를 지원하고 있는 듯하다."

msgid "sn_dsc_1855"
msgstr "언노운에게 필살기라며 잠수함 어택을 시도하는 척.\\n하지만 상대의 예상을 뛰어넘는 기동성 때문에 뒤를 잡고도 놓치고 말았다."

msgid "sn_dsc_1856"
msgstr "합격자 없음이라는 결과를 받고 실의에 빠진 채 돌아가는 모노레일을 기다리는 프레이야.\\n부족했던 것은 실력이었을까, 마음의 강함이었을까.──지금의 프레이야에게는 답이 없었다."

msgid "sn_dsc_1857"
msgstr "해파리를 이용한 신상품을 소재로 레이나의 관심을 끌려 하는 척.\\n참고로 해파리는 생으로 먹는 것을 좋아하는 레이나에게는 단칼에 거절당한 듯하다."

msgid "sn_dsc_1858"
msgstr "항공모함에 바짝 접근해 발진 카타펄트에서 직접 내부를 공격하는 키스의 Sv-262Hs.\\n수많은 미사일이 내부에 퍼부어진 항공모함은 연쇄 폭발을 일으키며 산산조각 나고 말았다."

msgid "sn_dsc_1859"
msgstr "바르로 인해 폭도로 변한 시민들의 모습을 중계하는 리포터.\\n하지만 다음 순간 발생한 폭발로 영상은 끊기고 말았다."

msgid "sn_dsc_1860"
msgstr "행성 라그나의 바다 쪽 구역과 언덕 위 구역을 연결하는 모노레일.\\n개방적인 차량 내부에서 보이는 경치 역시 관광 포인트 중 하나인 듯하다."

msgid "sn_dsc_1861"
msgstr "물속을 연상시키는 색감의 의상을 입고 별이 반짝이는 무대에 내려선 마키나.\\n부드러운 노랫소리와 스텝은 흐르는 물처럼 은하의 별들에게 치유를 전할 것이다."

msgid "sn_dsc_1863"
msgstr "오디션 참가자들을 무대 뒤에서 몰래 관찰하는 레이나와 마키나.\\n새로운 멤버를 맞이하기 위해 후보자의 적성과 자질 확인에 여념이 없는 듯하다."

msgid "sn_dsc_1864"
msgstr "목적은 달성했다고 말하는 로이드에게 지금 칠 수 있을 때 쳐야 한다고 몰아붙이는 키스.\\n적극성이 부족한 방침에 키스뿐만 아니라 공중 기사단원들도 답답함을 느끼고 있었다."

msgid "sn_dsc_1865"
msgstr "행성 알 샤할에서의 프레이야 노랫소리에 각자의 감상을 전하는 발키리 멤버들.\\n「완전 귀여운 노래였어!」「따끔따끔해서 기분 좋았어」─마키나, 레이나"

msgid "sn_dsc_1866"
msgstr "놀랍게도 최종 오디션의 내용은 프레이야의 자질을 확인하기 위한 거대한 몰래카메라였다.\\n특수 분장에 근육 보정복, 가짜 피까지 준비한 치밀함에 프레이야는 완전히 속아 넘어갔다."

msgid "sn_dsc_1867"
msgstr "내던져진 음악 플레이어를 주워 프레이야에게 말을 거는 승객 중 한 여성.\\n프레이야는 상황을 제대로 이해하지 못했지만, 그 목소리는 분명 익숙하게 느껴졌다."

msgid "sn_dsc_1868"
msgstr "갑작스러운 귀환 명령에 승산이 있었던 싸움이었다며 불만을 터뜨리는 공중 기사단원들.\\n노련한 헬만조차 이 순간만큼은 납득하지 못하는 모습이었다."

msgid "sn_dsc_1869"
msgstr "대기실 상황을 지켜보던 마키나가 가리킨 모니터에 비친 프레이야.\\n자신이 보고 있다는 사실도 모른 채 머리띠를 매고 의욕이 넘치는 모습이었다."

msgid "sn_dsc_1870"
msgstr "뒤에서 접근하는 메서의 VF-31F로부터 날카로운 바람을 느낀 테오와 자오.\\n여유 있던 태도는 순식간에 사라지고, 그 날카로움에 긴장감이 감돌았다."

msgid "sn_dsc_1871"
msgstr "발키리 오디션 참가자들에게 지급된 리스트 밴드.\\n노래를 정확히 기록하기 위한 것이라고 하지만, 실제로는 다른 목적도 있는 듯하다."

msgid "sn_dsc_1872"
msgstr "Sv-262에 탑재된 강력한 전자 재밍 기능.\\n대책이 부족하면 기체가 분신하는 것처럼 보일 것이다."

msgid "sn_dsc_1873"
msgstr "마크로스급 함장을 이미지한 듯한 특제 함장복을 입은 카나메.\\n늠름하면서도 매력적인 그 모습은 듬직함과 매력으로 가득하다."

msgid "sn_dsc_1875"
msgstr "볼도르 유적에서의 전술 라이브 중 폴드파의 변화를 감지하는 발키리 멤버들.\\n카나메는 측정한 수치로 유적이 노래에 반응하고 있다는 사실을 누구보다 빨리 밝혀냈다."

msgid "sn_dsc_1876"
msgstr "해파리 라멘에 라그나 새우까지 얹어 사주겠다는 약속으로 소대원들을 독려하는 아라드.\\n「알겠습니다!」「게코 아와비도요!」「잘 먹겠습니다!」─미라쥬, 하야테, 척"

msgid "sn_dsc_1877"
msgstr "【조타도 OK, 내가 함장!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1881"
msgstr "【조타도 OK, 내가 함장!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1883"
msgstr "【조타도 OK, 내가 함장!】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1885"
msgstr "진홍빛 의상을 입고 머나먼 우주의 끝을 향해 기도하듯 노래하는 셰릴.\\n고귀함과 무한한 사랑이 담긴 그 노랫소리는 소중한 사람들을 향한 마음으로 이어져 간다."

msgid "sn_dsc_1887"
msgstr "멀리 떨어진 프론티어 무대에서 이어링을 통해 전해진 셰릴 일행의 노랫소리.\\n절망적인 상황 속에서 알토는 영혼을 북돋우는 듯한 힘찬 노랫소리에 다시 힘을 냈다."

msgid "sn_dsc_1888"
msgstr "전장의 상황을 바라보면서도 알토 이야기가 나오면 그만 발끈하는 셰릴.\\n「오해하지 마! 내가 걱정하는 건 갤럭시야!」─셰릴"

msgid "sn_dsc_1889"
msgstr "진홍빛 의상을 입고 사요나라 라이브를 마무리할 마지막 곡을 부르기 시작하는 셰릴.\\n그 노래와 마음은 머나먼 은하에서 목숨을 걸고 싸우는 알토 일행에게 향하고 있었다."

msgid "sn_dsc_1890"
msgstr "이제 마지막 한 곡만을 남겨둔 셰릴의 사요나라 라이브.\\n셰릴은 다시 한번 프론티어 사람들에게 감사의 마음을 전했다."

msgid "sn_dsc_1891"
msgstr "셰릴과 헤어지며 이어링을 「행운의 부적」으로 빌린 알토.\\n알토는 VF-25F 콕핏에 이어링을 장식하고 첫 전장으로 향했다."

msgid "sn_dsc_1892"
msgstr "카이토스를 호위하면서 주변 우주에 펼쳐진 폴드 단층에 불평을 터뜨리는 루카.\\n단층으로 인해 발생하는 시간 지연이 구조를 더욱 어렵게 만들고 있었다."

msgid "sn_dsc_1893"
msgstr "아무도 예상하지 못한 바주라 모함의 등장에 경악하는 S.M.S 대원들.\\n「폴드 단층을 직접 넘어왔다고…?」─람"

msgid "sn_dsc_1894"
msgstr "동료들의 활약과 케니히 몬스터의 화력 앞에 압도되는 알토.\\n무심코 멍하니 있던 알토에게 오즈마가 곧바로 호통을 날렸다."

msgid "sn_dsc_1895"
msgstr "폴드 단층을 넘어 갑자기 나타난 나이트급 바주라.\\n그 위용은 도망치는 카이토스를 향해 가차 없이 이빨을 드러냈다."

msgid "sn_dsc_1896"
msgstr "나이트급 바주라에게서 검출된 이상한 폴드 에너지 반응.\\n「설마, 폴드 리액터!?」─루카"

msgid "sn_dsc_1897"
msgstr "진홍빛 의상을 입고 머나먼 우주 끝을 향해 기도하듯 노래하는 란카.\\n상냥한 마음과 한없이 순수한 그 노랫소리는 소중한 사람들과의 인연으로 이어져 간다."

msgid "sn_dsc_1899"
msgstr "오즈마가 남긴 메시지를 통해 출격 사실을 알고 불안한 마음에 고개를 숙이는 란카.\\n「그럴 수가!! 그럼 알토 군도!?」─란카"

msgid "sn_dsc_1900"
msgstr "하나의 마음을 통해 이어진 정신세계에서 란카와 셰릴은 서로의 마음을 나눈다.\\n그리고 셰릴의 함께 노래해 달라는 부탁에 란카는 조용히 고개를 끄덕였다."

msgid "sn_dsc_1901"
msgstr "먼 곳에서 싸우는 알토 일행을 생각하며 관객석에서 셰릴과 함께 노래하는 란카.\\n힘찬 선율에 마음을 실어, 머나먼 우주 끝까지 닿을 듯 노랫소리를 울려 퍼뜨렸다."

msgid "sn_dsc_1902"
msgstr "오즈마의 만류에도 데이터 수집을 위해 바주라 모함에 접근하는 루카.\\n바주라의 데이터 채취에 집중한 나머지 주변 경계가 소홀해지고 만다."

msgid "sn_dsc_1903"
msgstr "돌격하는 알토를 지원하던 미셸의 눈에 미확인 기체가 들어온다.\\n의아해하는 미셸을 뒤로한 채 기체는 붉은 궤적을 그리며 전장을 질주해 갔다."

msgid "sn_dsc_1904"
msgstr "셰릴의 이어링을 통해 바주라의 몸속에 울려 퍼지는 란카와 셰릴의 노랫소리.\\n그 노랫소리는 숨어서 알토의 움직임을 감시하던 브레라에게도 닿고 있었다."

msgid "sn_dsc_1905"
msgstr "바주라 모함 근처에서 데이터를 수집하던 중 갑자기 반응이 끊긴 루카의 RVF-25.\\n평소라면 격추를 의심할 상황이었지만, 오즈마의 보고 내용은 믿기 어려운 것이었다."

msgid "sn_dsc_1906"
msgstr "바주라에게 포획되어 나이트급 바주라의 내부에 갇힌 RVF-25.\\n포획에 이른 이유는 밝혀지지 않았지만, 바주라의 습성과 관련이 있을지도 모른다."

msgid "sn_dsc_1907"
msgstr "소형 바주라를 발진시키면서 무수한 대공포화를 퍼붓는 나이트급 바주라.\\n그 모습은 그야말로 고슴도치라고 할 만하다."

msgid "sn_dsc_1908"
msgstr "란카가 애용하는 발키리를 본뜬 형태의 배낭.\\n사요나라 라이브에서 알토가 앉았어야 할 자리로 보이는 좌석에 놓여 있었다."

msgid "sn_dsc_1909"
msgstr "셰릴과 란카의 노래를 등 뒤에 받으며 머나먼 하늘 너머를 바라보는 알토.\\n고결한 영혼과 끝없는 하늘에 대한 동경은 소중한 사람들과의 운명으로 이어져 간다."

msgid "sn_dsc_1910"
msgstr "프론티어 선단 일반기의 표준 장비인 슈퍼 팩 장착 VF-25F.\\n알토 역시 S.M.S 대원으로서 이 기체를 타고 수많은 전장에 출격하며 바주라 전쟁을 헤쳐 나갔다."

msgid "sn_dsc_1911"
msgstr "플라이트 데크에서 출격 준비를 마친 알토에게 브리지에서 출격 신호를 보낸다.\\n「행운을 빌게, 스컬 4」「고마워!」─람, 알토"

msgid "sn_dsc_1912"
msgstr "물러서지 않고 앞으로 나아갈 의지를 보인 알토에게 오즈마는 놀리면서도 만족스러운 표정을 지었다.\\n「그럼 내 엉덩이 냄새를 맡을 수 있는 위치에서 절대 떨어지지 마라」─오즈마"

msgid "sn_dsc_1915"
msgstr "전선으로 나가는 것은 위험하다고 진언하는 캐시에게 다시 한번 대통령의 명령을 묻는 제프리.\\n그리고 명령을 완수할 방법이 아직 남아 있다고 당당히 말했다."

msgid "sn_dsc_1916"
msgstr "바주라의 몸속에서 기체가 중파된 데다 소형 바주라에게 붙잡힌 알토.\\n절체절명의 순간, 셰릴의 이어링이 빛나며 노랫소리가 울려 퍼진다."

msgid "sn_dsc_1921"
msgstr "세련되고 귀여운 꽃무늬 모티브 비키니를 입고 여름 바다를 마음껏 즐기는 마키나.\\n여름 햇살을 받아 반짝이는 물보라가 포근한 몸매의 매력을 한층 더 돋보이게 한다."

msgid "sn_dsc_1922"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1923"
msgstr "마키나에게 중요한 임무라며 메서를 해파리 축제에 데려가는 역할을 맡은 하야테.\\n주변과 거리를 두는 메서의 태도 때문에 어려운 임무로 여겨졌지만…?"

msgid "sn_dsc_1924"
msgstr "해파리 축제의 밤, 자신들도 언제 어떻게 될지 모른다며 쓸쓸하게 이야기하는 마키나.\\n「그러니까 즐기는 거야. 지금을, 온 힘을 다해서」「──응」─레이나, 마키나"

msgid "sn_dsc_1925"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1926"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1927"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1929"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1931"
msgstr "【매혹의 서머 밸류】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1933"
msgstr "이번에 민메이가 연기하는 역할은 무예를 익혀 병든 도시를 구하기 위해 일어선 아름다운 공주다.\\n유연한 춤사위와 노랫소리로 어떤 역경의 이야기라도 해피엔딩으로 이끌어 줄 것이다."

msgid "sn_dsc_1935"
msgstr "마크로스 함내에서 제작 중인 쿵푸 영화 「소백룡」의 주연으로 발탁된 민메이.\\n영화 의상의 권법복과 땋아 묶은 머리가 꽤 귀엽다는 평을 받고 있다고 한다."

msgid "sn_dsc_1936"
msgstr "브리지로 돌아갈 수 없게 되어 대신 지휘를 맡고 있을 것으로 보이는 샤미를 걱정하는 미사.\\n「아~앙! 하야세 대위님, 빨리 와주세요…」─샤미"

msgid "sn_dsc_1937"
msgstr "포커에게서 히카루가 전투 부상으로 입원했다는 소식을 들은 민메이.\\n병문안을 가서 힘을 북돋아 달라는 부탁을 민메이는 흔쾌히 받아들였다."

msgid "sn_dsc_1938"
msgstr "영화 마지막 장면에서 주인공 카이훈에게 안겨 일어나는 히로인 역의 민메이.\\n이후 입을 맞추는 두 사람의 모습을 차마 볼 수 없었던 히카루는 도망치듯 극장을 빠져나왔다."

msgid "sn_dsc_1939"
msgstr "엇갈린 탓에 민메이가 준비한 특별석이 아닌 입석으로 영화를 관람하게 된 히카루.\\n연기라는 것을 알면서도 카이훈에게 기대는 민메이의 모습을 히카루는 복잡한 마음으로 바라보았다."

msgid "sn_dsc_1940"
msgstr "마크로스의 트랜스포메이션으로 열린 낭떠러지에 발을 헛디디는 민메이.\\n아슬아슬하게 카이훈에게 구출되지만, 민메이는 그 모습에서 순간 히카루의 환영을 보았다."

msgid "sn_dsc_1941"
msgstr "민메이의 인기 덕분인지 「소백룡」을 상영하는 극장은 만석이 되었다.\\n「아침 일찍부터 줄 선 보람이 있었네」─맥스"

msgid "sn_dsc_1942"
msgstr "콜라 자판기 앞에서 미사 몫의 콜라도 사려고 하는 히카루.\\n미사는 그것을 막으며 상관이라는 이유로 히카루에게 콜라를 사주었다."

msgid "sn_dsc_1943"
msgstr "「소백룡」이 개봉된 극장에 걸려 있던 영화 간판.\\n히로인을 연기한 민메이와 주인공을 연기한 카이훈이 각각 그려져 있다."

msgid "sn_dsc_1944"
msgstr "「소백룡」의 극중에서 카이훈이 연기한 소백룡이 발사한 광선.\\n이 장면은 전투 기록 영상으로 지켜보던 젠트라디들에게 엄청난 충격을 주었다."

msgid "sn_dsc_1945"
msgstr "지구의 중화 문화를 본뜬 무대에서 쌍절곤을 들고 무예가를 연기하는 프레이야.\\n높은 신체 능력을 살린 스턴트까지 완벽하게 소화하며, 기분은 완전히 쿵푸 스타?"

msgid "sn_dsc_1947"
msgstr "접객용으로 보이는 붉은 치파오 차림 그대로 신나게 포즈를 취하는 프레이야.\\n그 행동에는 한때 지구에서 크게 유행했던 쿵푸 영화의 영향도 어느 정도 있을지도 모른다."

msgid "sn_dsc_1948"
msgstr "행성 라그나에서 하야테에게 격추당했을 때 오른쪽 눈을 잃을 정도의 중상을 입은 키스.\\n얼굴 절반을 가리는 안대를 하고도 긍지 높은 신념에는 조금의 흔들림도 없다."

msgid "sn_dsc_1949"
msgstr "나체먹낭낭에서 식사를 마친 손님들을 힘차게 배웅하는 프레이야.\\n이렇게 밝게 응대해 주는 직원이 있다면 다음에도 방문하고 싶어질 것이다."

msgid "sn_dsc_1950"
msgstr "손님에게 주문을 받으며 여전히 미소를 짓는 프레이야.\\n사실은 고향의 상황에 대해 고민하고 있었지만, 티 내지 않기 위해 최선을 다하고 있었다."

msgid "sn_dsc_1951"
msgstr "오른쪽 눈을 잃은 뒤 처음 치르는 전투임에도 차례차례 적을 격추하는 키스.\\n「눈 하나를 잃고 룬이 더욱 날카로워진 것인가. 아니, 저 비행은…」─헬만"

msgid "sn_dsc_1952"
msgstr "중화냄비를 휘두르며 능숙한 손놀림으로 볶음밥을 볶아내는 척.\\n가게 이름에 그 유명한 「냥냥」의 이름을 빌린 만큼, 요리 솜씨도 일품이다."

msgid "sn_dsc_1953"
msgstr "프레이야가 홀에서 접객을 도와주는 것에 감사하는 하크 일행.\\n프레이야 역시 엘리자베스에게 간판 아가씨라는 말을 듣고 싫지는 않은 듯하다."

msgid "sn_dsc_1954"
msgstr "신통합군의 강행 정찰 함대를 단 한 기로 쓸어버린 키스의 Sv-262Hs.\\n머리 부분의 조형까지 더해져 그 모습은 그야말로 명계의 문지기라 할 만하다."

msgid "sn_dsc_1955"
msgstr "평소보다 많은 손님으로 북적이는 나체먹낭낭의 내부.\\n홀 쪽은 주문을 처리하느라 매우 바쁜 상황이다."

msgid "sn_dsc_1956"
msgstr "프레이야와 하야테에게 자신의 가게인 나체먹낭낭을 소개하는 척.\\n하야테도 델타 소대의 대원으로서 이곳에 입주하게 되었다."

msgid "sn_dsc_1957"
msgstr "세련되고 귀여운 꽃무늬 모티브 비키니를 입고 여름 바다를 마음껏 즐기는 레이나.\\n지금 레이나의 머릿속에는 이번 여름을 즐겁고 편안하게 보내기 위한 계획이 가득한 듯하다."

msgid "sn_dsc_1958"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1959"
msgstr "행성 볼도르 유적 지하에서 노래와 환영으로 공중 기사단을 농락하는 발키리.\\n숙련된 상대에게는 불리하지만, 경험이 부족한 젊은 상대라면 그 효과는 확실하다."

msgid "sn_dsc_1960"
msgstr "어릴 때부터 형인 키스가 하늘을 나는 모습을 좋아했고, 그것은 하인츠에게도 버팀목이었다.\\n왕과 신하가 아닌 키스와 형제로 함께 살아가는 것을 하인츠는 바라고 있었다."

msgid "sn_dsc_1961"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1962"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1963"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1965"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1967"
msgstr "【지글지글 서머 데이】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1969"
msgstr "세련되고 귀여운 꽃무늬 모티브 비키니를 입고 여름 바다를 마음껏 즐기는 미쿠모.\\n한여름의 여신이라 부를 수 있는 아름다움도, 미쿠모의 비밀을 아는 사람들에게는 금단의 아름다움이라 할 수 있을 것이다."

msgid "sn_dsc_1970"
msgstr "【순정 서머 브레이크】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1971"
msgstr "비키니 차림으로 해변에 나와 있던 것을 들켜 무심코 목소리를 높이는 미라쥬.\\n모처럼의 바다이니 어쩔 수 없다는 생각도 들지만, 아직은 조금 부끄러운 모양이다."

msgid "sn_dsc_1972"
msgstr "프레이야에게 있어 전장이 무엇인지 되물으며 마음의 갈등을 없애주는 미쿠모.\\n그리고 노래를 시작한 프레이야의 등을 발키리의 사인이 힘차게 밀어주었다."

msgid "sn_dsc_1973"
msgstr "행성 라그나의 고대 유적이 노래에 반응하는지 실험하게 된 발키리.\\n유적의 반응을 주시하는 가운데, 미쿠모는 혼자 눈을 감고 그저 노래를 울려 퍼뜨리고 있었다."

msgid "sn_dsc_1974"
msgstr "너무 긴장한 나머지 춤에 집중하지 못해 레슨을 중단시키고 만 프레이야.\\n「처음부터 다시, 쓸데없는 생각은 하지 마!」「…흥」─카나메, 미쿠모"

msgid "sn_dsc_1975"
msgstr "하야테에게 현실을 깨닫게 해주려다 그 자리의 분위기에 휩쓸려 훈련 교관이 되어버린 미라쥬.\\n한 달 안에 쓸 수 있게 만들라는 아라드의 무리한 요구에 당황하고 말았다."

msgid "sn_dsc_1976"
msgstr "매번 이론 수업을 빼먹는 하야테를 보며 그야말로 분노한 표정을 짓는 미라쥬.\\n미간에 잡힌 깊은 주름은 하야테의 수업 태도에 대한 불만을 보여주는 듯하다."

msgid "sn_dsc_1977"
msgstr "행성 라그나의 고대 유적 앞에서 노래 실험을 진행하는 발키리.\\n물속에서도 활동할 수 있도록 파일럿 슈트를 착용한 채 라이브를 진행했다."

msgid "sn_dsc_1978"
msgstr "입대 시험에서 AI 개입으로 원하는 대로 기체를 조종하지 못하는 하야테.\\n휘청거리며 불안정하게 나는 기체를 미라쥬는 시험관으로서 가차 없이 몰아붙였다."

msgid "sn_dsc_1979"
msgstr "행성 라그나 바닷속에 자리 잡은 프로토컬처의 유적.\\n주변에는 해파리가 떠다니며 신비로운 고요함을 품고 있다."

msgid "sn_dsc_1980"
msgstr "바닷속에서 힘차게 하늘로 뛰어오르는 하크.\\n그 놀라운 점프력은 수중 생활에 적응한 라그나인만이 보여줄 수 있는 것이다."

msgid "sn_dsc_1981"
msgstr "세련되고 귀여운 꽃무늬 모티브 비키니를 입고 여름 바다를 마음껏 즐기는 카나메.\\n평소에는 팀을 든든하게 이끄는 그녀도 여름 태양 아래에서는 조금 대담해지는 걸지도?"

msgid "sn_dsc_1982"
msgstr "【어른의 여름 즐기기】의 에피소드 포인트를 올릴 수 있는 플레이트."

msgid "sn_dsc_1983"
msgstr "푸른 대양을 바라보며 무언가 떠올린 듯한 해파리 애호가 아라드 대장.\\n뜰채를 한 손에 들고, 최고급 진미들과의 만남에 마음이 부풀어 있다."

msgid "sn_dsc_1984"
msgstr "물결 사이에서 둥실둥실 흔들리며 올려다보는 여름 하늘은 특별히 상쾌할 것이다.\\n다만 방심하면 괭이갈매기들의 딱 좋은 휴식 장소가 되어버릴지도 모른다."

msgid "sn_dsc_1985"
msgstr "괭이갈매기 보스를 거의 몰아붙였지만 결국 놓치고 만 하야테 일행.\\n분해하는 하야테였지만, 이때 본 괭이갈매기의 움직임은 이후 시험에서의 역전에 이어졌다."

msgid "sn_dsc_1986"
msgstr "제대로 힘을 내지 못하는 프레이야를 위해 입대 시험 중 하야테의 영상을 보여주는 카나메.\\n카나메와 미쿠모의 의도대로 프레이야는 다시 컨디션을 되찾고 힘차게 노래하기 시작했다."

msgid "sn_dsc_1987"
msgstr "삐끼에게 붙잡힌 프레이야의 손을 잡고 전력으로 달리기 시작하는 하야테.\\n행성 알 샤할에서 있었던 일처럼, 이런 상황에는 익숙한 모양이다."

msgid "sn_dsc_1988"
msgstr "시그르 발렌스의 포격으로 바닷속에 가라앉은 듯 보였던 마크로스 엘리시온은,\\n부상했을 때는 이미 변형을 끝낸 상태였고 즉시 반격에 나서 적의 허를 찔렀다."

msgid "sn_dsc_1989"
msgstr "보스를 쫓아 물속으로 뛰어들었지만 잡기는커녕 얼굴에 한 방 맞고 마는 하야테.\\n역시 평범한 인간이 물속에서 괭이갈매기를 상대하는 것은 너무 불리했다고 할 수 있다."

msgid "sn_dsc_1990"
msgstr "바닷속에서 떠올라 마크로스 캐논을 발사한 마크로스 엘리시온.\\n선체를 폭포처럼 흘러내리는 막대한 바닷물이 장관을 만들어낸다."

msgid "sn_dsc_1991"
msgstr "행성 라그나의 해안가에 만들어진 거리 풍경.\\n곳곳에 수로가 흐르는 그 모습은 어느 부분을 잘라내도 그림이 될 것 같다."

msgid "sn_dsc_1992"
msgstr "괭이갈매기를 쫓아 바다에 뛰어들 때 하야테가 벗어 던진 티셔츠.\\n끝없이 푸른 라그나의 하늘 아래 티셔츠의 흰색이 선명하게 빛난다."

msgid "sn_dsc_1993"
msgstr "델타 소대의 일원으로서 휴일에도 발키리 경호를 빠뜨리지 않는 미라쥬.\\n좋아하는 수영복을 입고 튜브를 든 채 여름 바다를 즐기는 것 역시 임무의 일부일 것이다."

msgid "sn_dsc_1994"
msgstr "소형 지원기 「릴 드라켄」을 장착해 항속거리와 성능을 강화한 Sv-262Hs.\\n그 성능은 백기사 키스의 손에서 유감없이 발휘되어 델타 소대를 괴롭혔다."

msgid "sn_dsc_1995"
msgstr "윈더미어를 지키는 기사인 키스에게 여름 바람은 어울리지 않을지도 모른다.\\n하지만 그가 만약 여름 모래사장에 나타난다면, 어딘가 기분 좋은 시원한 바람을 가져다줄 것 같다."

msgid "sn_dsc_1996"
msgstr "우연한 만남과 잠시의 대화를 거친 두 사람은 서로를 깎아내리며 다시 전장에서 마주한다.\\n「카심 에벨하르트!」「하야테 임멜만!」─하야테, 카심"

msgid "sn_dsc_1997"
msgstr "「바람의 노래」 실험으로 혼란에 빠진 공중 기사단 속에서도 기체 제어를 계속하는 키스.\\n키스는 하인츠의 생체 폴드파 이상을 룬으로 분명하게 느끼고 있었다."

msgid "sn_dsc_1998"
msgstr "프레이야가 발산하는 생체 폴드파와 공명해 엄청난 전투 능력을 발휘하는 하야테.\\n하지만 그것은 정상적인 상태라고 할 수 없었고, 오히려 폭주라고 해도 될 정도였다."

