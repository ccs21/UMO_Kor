msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "talk_time_01"
msgstr "수고했어!\n오늘도 열심히 했네!"

msgid "talk_time_02"
msgstr "영차!\n...조금 과로한 건가"

msgid "talk_time_03"
msgstr "건강 관리에 만전을 기해야지.\n모든 것은 몸이 자본이야"

msgid "talk_time_04"
msgstr "다음 스테이지는...\n스케줄 관리도 내 일이야"

msgid "talk_time_05"
msgstr "왈큐레의 리더로서\n모두를 이끌어야 해"

msgid "talk_time_06"
msgstr "어라?\n어디로 간 걸까…"

msgid "talk_time_07"
msgstr ""

msgid "talk_time_08"
msgstr "음, 다음 라이브까지\n개선해야 할 부분은…"

msgid "talk_login_01"
msgstr "좋은 아침.\n먼저 스트레칭부터 하자"

msgid "talk_login_02"
msgstr "점심이네... 뭔가 먹을래?"

msgid "talk_login_03"
msgstr "어두워졌네.\n조금만 더 힘내자"

msgid "talk_login_04"
msgstr "수고했어.\n푹 쉬고 내일을 준비하자"

msgid "talk_login_05"
msgstr "너무 늦게까지 안 자고 있으면,\n내일 힘들어져?"

msgid "talk_comeback_01"
msgstr "오랜만이네. 나를 만나러 온 거야?\n…농담이야"

msgid "talk_comeback_02"
msgstr "오늘도 힘내보자!"

msgid "talk_birthday_01"
msgstr "어머? 내 생일을 축하해 주는 거야?\n후후, 기뻐. 고마워!"

msgid "talk_event_01"
msgstr "올해의 포부? 글쎄...\n왈큐레를 은하 최고의\n유닛으로 만드는 것!"

msgid "talk_event_02"
msgstr "으음.\n대장이랑 멧서 군에게 줄 초콜릿,\n어떤 걸로 할까…"

msgid "talk_event_03"
msgstr "콩 뿌리기, 다들 즐거워하는 것 같아!\n아라드 대장에게 제안하길 잘했어"

msgid "talk_event_04"
msgstr "호화로운 히나인형도 좋지만,\n작은 인형도 귀엽네.\n계속 봐도 질리지 않아!"

msgid "talk_event_05"
msgstr "보답이라니, 센스 있네.\n고마워"

msgid "talk_event_06"
msgstr "올해야말로 깜짝 놀랄 만한\n거짓말을 하고 싶은데…\n좀처럼 떠오르질 않네"

msgid "talk_event_07"
msgstr "모처럼 쉬는 날이니까,\n쇼핑하러 갈까"

msgid "talk_event_08"
msgstr "결혼이라… 아직은 별로 실감이\n안 나지만, 언젠가는 웨딩드레스를\n입어보고 싶네…"

msgid "talk_event_09"
msgstr "별이 아름답네…\n너는 무슨 소원을 빌었어?"

msgid "talk_event_10"
msgstr "선크림 제대로 바르고 나서\n놀아야 해"

msgid "talk_event_11"
msgstr "축제라고 하면,\n역시 해파리 축제지!\n올해도 기대돼"

msgid "talk_event_12"
msgstr "지구에서는 지역에 따라\n달맞이를 즐기는 방법이 다르대"

msgid "talk_event_13"
msgstr "과자를 가지고 있지 않아서,\n레이나한테 장난당해버렸어.\n할로윈은 무섭네…"

msgid "talk_event_14"
msgstr "문화제라…\n조금 그리운 기분이 드네"

msgid "talk_event_15"
msgstr "케이오스의 크리스마스\n파티는 매년 활기차.\n너도 올래?"

msgid "talk_event_16"
msgstr "얘들아, 새해맞이 준비는 됐어?\n내년도 좋은 한 해로 만들자!"

msgid "talk_event_17"
msgstr "항상 고마워!\n앞으로도 더 많은 사람에게\n노래를 전할 수 있도록 힘낼게!"

msgid "talk_event_18"
msgstr "대단해!\n이렇게 많은 사람들이 우리의\n노래를 들어주고 있다니!"

msgid "talk_event_19"
msgstr "200만 다운로드,\n고마워!"

msgid "talk_event_20"
msgstr "1주년이네! 항상 응원해줘서 고마워!"

msgid "touch_reaction_01"
msgstr "뭔가 신경 쓰이는 거라도 있어?"

msgid "touch_reaction_02"
msgstr "이봐~,\n너무 장난치면 화낼 거야?"

msgid "touch_reaction_03"
msgstr "정말! 너무 만지작거리잖아!\n…적당히 해, 알겠지?"

msgid "touch_reaction_04"
msgstr "수고했어!\n오늘도 열심히 하고 있네!"

msgid "touch_reaction_05"
msgstr "영차!\n…조금 너무 일했나"

msgid "touch_reaction_06"
msgstr "컨디션 관리는 철저히 해야지.\n무슨 일이든 몸이 자산이니까"

msgid "touch_reaction_07"
msgstr "꺅! 정말, 놀라게 하지 마!"

msgid "touch_reaction_08"
msgstr "어른이 되어도,\n쓰다듬어지는 건 기쁜 거구나…"

msgid "login_reaction_01"
msgstr "자, 여기.\n오늘도 같이 힘내자"

msgid "login_reaction_02"
msgstr "꾸준함이 힘이 된다는 거지"

msgid "simulation_result_01"
msgstr "들어줘서 고마워.\n시뮬레이션뿐만 아니라,\n백신 라이브도 보러 와줘!"

msgid "go_diva_result_01"
msgstr "기쁜 마음은\n함께 나누자!"

msgid "go_diva_result_02"
msgstr "성장한 내 노래,\n더 들어줄래?"

msgid "go_diva_result_03"
msgstr "다음 라이브는 특별한 무대가 될 것 같아.\n너도 기대해줘"

msgid "intimacy_pointup_01"
msgstr "멋지네"

msgid "intimacy_pointup_02"
msgstr "완벽해"

msgid "intimacy_pointup_03"
msgstr "후후훗"

msgid "present_01"
msgstr "고마워!"

msgid "present_02"
msgstr "후우…\n왠지 배가 고파졌네"

msgid "present_03"
msgstr "라그나에는\n여러 가지 먹거리가 있어.\n특히 어패류가 풍부해"

msgid "present_04"
msgstr "벌써 시간이 이렇게 됐네…\n다 같이 나체냥냥에 갈까"

msgid "present_05"
msgstr "하아…\n막혀버렸네…"

msgid "present_06"
msgstr "시간이 조금 생겼네…\n뭔가 재미있는 일 없을까?"

msgid "present_07"
msgstr "기분을 전환해서\n좀 더 즐거운 마음으로 노래하고 싶네…"

msgid "present_08"
msgstr "멋진 건 좋아해.\n역시 기분이 좋아지니까!"

msgid "present_09"
msgstr "레슨도 끝났고,\n잠깐 쇼핑하러 가는 것도 좋겠네"

msgid "present_10"
msgstr "장식품이나 잡화 같은 건,\n나도 모르게 사게 되지 않아?"

msgid "present_11"
msgstr "완벽해"

msgid "cs_touch_reaction_01"
msgstr "응, 무슨 일이야?"

msgid "cs_touch_reaction_02"
msgstr "후훗, 왜 그래?"

msgid "cs_touch_reaction_03"
msgstr "악수?\n응, 물론 괜찮아!"

msgid "cs_touch_reaction_04"
msgstr "노래는 생명!\n오늘도 기합 넣고 가자!"

msgid "cs_touch_reaction_05"
msgstr "뭔가 곤란한 일이 있으면\n언제든지 의지해줘"

msgid "cs_touch_reaction_06"
msgstr "전술 음악 유닛, 왈큐레!"

msgid "cs_touch_reaction_07"
msgstr "역시 다섯이 함께 노래할 때가\n제일 즐겁네"

msgid "cs_touch_reaction_08"
msgstr "너는 왈큐레의\n어떤 곡을 좋아해?\n참고할게"

msgid "cs_touch_reaction_09"
msgstr "이 의상, 어때?\n마음에 들어?"

msgid "cs_touch_reaction_10"
msgstr "요즘 컨디션은 어때?\n무리는 하지 마"

msgid "talk_event_21"
msgstr "프레이아의 생일 파티에\n미쿠모도 와주는 모양이야.\n변했네, 그 아이도…"

msgid "talk_event_22"
msgstr "미쿠모의 생일 파티를\n열어주려고 해. 놀라는 얼굴이\n보고 싶으니까… 아직 그 아이한테는 비밀이야?"

msgid "talk_event_23"
msgstr "카나메"

msgid "talk_event_24"
msgstr "마키나, 생일 축하해!\n항상 정말 많은 도움을 받고 있어,\n고마워"

msgid "talk_event_25"
msgstr "레이나도 참, 선물로 준 해파리를\n눈 깜짝할 사이에 먹어버렸어.\n정말 해파리를 좋아하네!"

msgid "talk_event_26"
msgstr "란카 씨,\n생일 축하드립니다!\n오늘은 푹 쉬면서 보내세요."

msgid "talk_event_27"
msgstr "생일 축하로 셰릴 씨의\n노래를 부르게 됐어.\n긴장되네…!"

msgid "talk_event_28"
msgstr "레이나가 밀레느 씨에게 줄\n선물을 고민하고 있더라. 저 둘,\n언제 그렇게 친해진 걸까?"

msgid "talk_event_29"
msgstr "노래를 향해 한결같이\n살아가는 바사라 씨…\n정말 본받고 싶어져"

msgid "talk_event_30"
msgstr "전설의 가희에게 직접\n『생일 축하해요』라고 말할 수\n있다니… 후훗, 왠지 신기하네!"

msgid "talk_event_31"
msgstr "하야테"

msgid "talk_event_32"
msgstr "미라쥬"

msgid "talk_event_33"
msgstr "메서 군한테 생일 선물로\n뭐가 좋냐고 물어봤더니…\n필요 없다고 하더라"

msgid "talk_event_34"
msgstr "후훗.\n아라드 대장님 생일 선물로,\n비장의 별미를 준비하길 잘했어"

msgid "talk_event_35"
msgstr "척"

msgid "talk_event_36"
msgstr "알토"

msgid "talk_event_37"
msgstr "오즈마"

msgid "talk_event_38"
msgstr "레이"

msgid "talk_event_39"
msgstr "히카루"

msgid "talk_event_40"
msgstr "감린"

msgid "talk_event_41"
msgstr "미사"

msgid "talk_event_42"
msgstr "우리 영화가 나온대!\n정말 기대되네!"

msgid "talk_event_43"
msgstr "전해지고 있었어, 우리 노래를\n소중히 여겨주는 네 마음.\n정말 고마워, 잊지 않을게…!"

msgid "talk_event_44"
msgstr "언젠가 다시 만날 수 있으면 좋겠네.\n너라면 카오스나\n나체냥냥의 모두도 대환영이야!"

msgid "talk_event_45"
msgstr "나, 정말 란카 씨와 함께\n노래하고 이야기했던 거지…\n지금도 꿈처럼 느껴져!"

msgid "talk_event_46"
msgstr "바사라 씨와 밀레느 씨, 두 분 다\n정말 멋진 사람들이었어. 우리\n시공에서도 만나보고 싶어졌어"

msgid "talk_event_47"
msgstr "민메이 씨와 시공을 넘어 함께\n노래했던 것… 기록에는 남지\n않더라도, 우리 마음속에는… 영원히!"
